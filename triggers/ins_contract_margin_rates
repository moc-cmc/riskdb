if object_id("ins_contract_margin_rates") != NULL
    drop trigger
        ins_contract_margin_rates
go

create trigger
    ins_contract_margin_rates
on
    contract_margin_rates
for
    insert
as

declare @result int

select
    @result = syb_sendmsg("localhost", 9999,
        "Notify /topic/Store.Notify." + @@servername + "." + db_name() + ".contract_margin_rates: insert "
        + convert(varchar(10), a.prime_broker_id) + " "
        + convert(varchar(50), a.contract_id) + " "
        + convert(varchar(10), a.margin)
    )
from
    inserted a

go
