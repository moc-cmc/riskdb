
create or replace procedure
	r_setsetupfeesbilled
			@login varchar(25),
			@request_id int,
			@setup_fees_billed varchar(4),
			@setup_billing_date datetime
as

if (@setup_fees_billed = "No")
begin
	select @setup_billing_date = NULL
end

begin tran
	update
		work_order_reqs
	set
		setup_fees_billed=@setup_fees_billed,
		setup_billing_date=@setup_billing_date
	where
		work_order_req_id=@request_id

	if @@rowcount !=1
	begin
		select
			status="Error",
			msg="Could not set setup_fee_billed",
			request_id="REQ" + convert(varchar(5), @request_id)

		rollback tran
		exec r_getworkorders @login
		return
	end

commit tran

exec
	r_getworkorders @login

go
	
