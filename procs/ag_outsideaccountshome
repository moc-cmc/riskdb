use
	risk_sjmdemo
go

drop procedure
	ag_outsideaccountshome
go

create procedure
	ag_outsideaccountshome
		@login varchar(50)
as

declare @fund_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"add_outside_account",
	"Add Outside Account",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

select
	style = @style,
	add_outside_account = "Add New Outside Account"

select
	style = @style,
	a.outside_account_id,
	a.name,
	outside_account_type = b.name,
	legal_entity = c.name,
	provider = d.name
from
	outside_accounts a,
	outside_account_types b,
	legal_entities c,
	providers d
where
	a.outside_account_type_id = b.outside_account_type_id
and
	a.legal_entity_id = c.legal_entity_id
and
	a.provider_id = d.provider_id
order by
	a.name

	


go

