create or replace procedure
	cbo_settleextaccounttrades
                @login varchar(50),
                @trade_date datetime


as

declare @external_account varchar(50)
declare @id int
declare @ids int

create table
	#settle_accounts(
		id int identity,
		external_account_id int,
		external_account varchar(100)
)
	


insert into
	#settle_accounts(
		external_account_id,
		external_account)
select
	external_account_id,
	symbol
from
	external_accounts 


select
	@id = 0
select
	@ids = count(*)
from
	#settle_accounts
where
	id > @id

while @ids > 0
begin

	select
		@id = min(id)
	from
		#settle_accounts
	where
		id > @id

        select
                @external_account = NULL

	select
		@external_account = external_account
	from
		#settle_accounts
	where
		id = @id

	exec
        	bn_settleextaccounttrades
                	@login=@login,
                	@external_account=@external_account,
                	@trade_date=@trade_date			

	select
		@ids = count(*)
	from
		#settle_accounts
	where
		id > @id
end

go	
