drop procedure cbo_xferfxtrades
go

create procedure
	cbo_xferfxtrades
		@login varchar(50),
		@commit_date datetime
as

declare @currency_id int
declare @net_equiv float
declare @fx_settlement_type_id int
declare @fxtrades_type_id int
declare @account_transaction_id int
declare @saved_amount float
declare @saved_currency_id int
declare @currency varchar(50)

select
	@fx_settlement_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @fx_settlement_type_id = NULL
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end

select
	@fxtrades_type_id = transaction_type_id
from
	transaction_types
where
	name = "FXTrades Settlement"
if @fxtrades_type_id = NULL
begin
	select
		status = "Error",
		message = "FXTrades Settlement transaction type not found"
	return
end

exec
	ag_desksettlementsfordate
		@login,
		"CITI FXPB",
		"FX Trades",
		@commit_date,
		@net_equiv output,
		@currency_id output

select
	@account_transaction_id = account_transaction_id,
	@saved_amount = amount,
	@saved_currency_id = currency_id
from
	account_transactions
where
	transaction_type_id = @fxtrades_type_id
and
	convert(date, transaction_date) = convert(date, @commit_date)
if @account_transaction_id != NULL
begin
	if @saved_currency_id != @currency_id
	begin
		select
			status = "Error",
			message = "Found existing settlement in wrong currency"
		return
	end

	if convert(numeric(30,2), @saved_amount) != convert(numeric(30,2), @net_equiv)
	begin
		select
			status = "Error",
			message = "Found existing settlement in wrong amount"
		return
	end

	select
		status = "Dupe",
		message = "Settlement already done and verified"
	return
end

select
	@currency = symbol
from
	products
where
	product_id = @currency_id
if @currency = NULL
begin
	select
		status = "Error",
		message = "Unknown currency specified by identifier",
		identifier = @currency_id

	return
end

exec
	ag_transactiontypetransfer
		@login = @login,
		@account = "CITI FXPB",
		@transaction_date = @commit_date,
		@from_type = "FX Settlement",
		@to_type = "FXTrades Settlement",
		@amount = @net_equiv,
		@currency = @currency

go
