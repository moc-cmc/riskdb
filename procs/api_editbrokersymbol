
drop procedure
	api_editbrokersymbol
go

create procedure
	api_editbrokersymbol
			@login varchar(25),
			@name varchar(50),
			@source_name varchar(100),
			@mapping varchar(50),
			@new_mapping varchar(50)

as

declare @broker_id int
declare @source_id int

select
	@broker_id = broker_id
from
	brokers
where
	symbol=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Cannot find Broker",
		broker=@name
	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source_name
	return
end

begin tran
	update
		broker_symbols
	set
		symbol=@new_mapping
	where
		broker_id=@broker_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount !=1)
	begin
		select
			status="Error",
			msg="Could not edit Broker Mapping",
			mapping=@mapping
	
		rollback tran

		return
	end

commit tran

select
	status="Success",
	msg="Broker Symbol Edited",
	name=@name

exec
	r_mappingoverview2 @login

return

go
		
