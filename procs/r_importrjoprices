use
	risk_rcm
go

drop procedure
	r_importrjoprices
go

create procedure
	r_importrjoprices
		@login varchar(50),
		@contract varchar(50),
		@price varchar(30),
		@row_date datetime
as


declare @rjo_source_id int
declare @contract_id int
declare @symbol varchar(50)
declare @price_factor float
declare @future_id int
declare @price_format varchar(50)
declare @settle float


select
	@rjo_source_id = source_id
from
	sources
where
	name = "RJO"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "RJO source not found"
	return
end

select
	@contract_id = contract_id
from
	contract_symbols
where
	symbol = @contract
and
	source_id = @rjo_source_id

if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Mapping for contract not found",
		contract = @contract
	return
end

select
	@future_id = future_id
from
	future_contracts
where
	contract_id = @contract_id
if @future_id = NULL
begin
	select
		@future_id = a.future_id
	from
		future_contracts a,
		options b,
		option_expirations c,
		option_contracts d
	where
		a.contract_id = b.underlying_contract_id
	and
		b.option_id = c.option_id
	and
		c.option_expiration_id = d.option_expiration_id
	and
		d.contract_id = @contract_id
end
		


select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

select
	@price_factor = a.factor,
	@price_format = b.name
from
	future_price_factors a,
	price_formats b
where
	a.future_id = @future_id
and
	a.price_format_id = b.price_format_id
and
	a.source_id = @rjo_source_id
if @price_factor = NULL
	select
		@price_factor = 1.0

if @price_format = "32nds"
begin
	exec
		r_pricefromdashbond
			@contract_id,
			@price,
			@settle output

end
else
begin
	select
		@settle = convert(float, @price)
end
		


exec
	r_editsettle
		@symbol,
		@row_date,
		@settle



go


