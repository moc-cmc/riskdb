use
	risk_jeff
go

drop procedure
	ag_accountmargins
go

create procedure
	ag_accountmargins
		@login varchar(50),
		@account varchar(50)
as

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @external_account_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"add_override",
	"Add Account Margin Override",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"margin_schedule",
	"Margin Schedule",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"edit_margin",
	"Edit Product Margin",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"accounts",
	"Prime Broker Accounts",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end


create table
	#output(
		id int identity,
		style varchar(250) NULL,
		external_account_id int,
		account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		margin float NULL)

insert into
	#output(
		style,
		external_account_id,
		account,
		product_id,
		product)
select
	style = @style,
	external_account_id = @external_account_id,
	account = @account,
	a.product_id,
	a.symbol
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"
order by
	a.symbol

update
	#output
set
	a.margin = b.margin
from
	#output a,
	account_product_margins b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id


select
	style,
	account,
	product,
	margin,
	add_override = "EDIT"
from
	#output
order by
	id


go
