
if object_id("cm_editbroker") != NULL
    drop procedure
        cm_editbroker
go

create procedure
	cm_editbroker
		@login varchar(30),
		@broker varchar(30),
		@new_name varchar(30)
as

declare @broker_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)


select
	@broker_id = broker_id
from
	brokers
where
	symbol = @new_name
if @broker_id != NULL
begin
	select
		status = "Error",
		message = "New broker name already exists",
		new_name = @new_name
	return
end

update
	brokers
set
	symbol = @new_name
where
	symbol = @broker


select
        @tico_server = tico_server,
        @tico_database = tico_database
from
        funds

select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string


exec
	cm_brokers
		@login

go
