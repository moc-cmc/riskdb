
if object_id("r_pricechange") != NULL
    drop procedure
        r_pricechange
go
 
create procedure
	r_pricechange
		@contract_id int,
		@trade_date datetime,
		@price_change float output
as

declare @close_price_type_id int
declare @prev_date datetime
declare @prev_close float
declare @current_price float
declare @instrument char(50)

select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @contract_id

if @instrument = "Option"
begin
	exec
		r_optionpricechange
			@contract_id,
			@trade_date,
			@price_change output
	return
end

