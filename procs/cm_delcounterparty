
if object_id("cm_delcounterparty") != NULL
    drop procedure
        cm_delcounterparty
go

create procedure
	cm_delcounterparty
		@login varchar(30),
		@counterparty varchar(100)

as

declare @counterparty_id int
declare @total_trades int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)


select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @counterparty_id = NULL
begin
	select
		status = "Error",
		message = "Counterparty not found",
		counterparty = @counterparty
	return
end

select
	@total_trades = count(*)
from
	trades
where
	counterparty_id = @counterparty_id
if @total_trades != 0
begin
	select
		status = "Error",
		message = "Non-zero number of trades found for this counterparty. Not Deleted",
		counterparty = @counterparty
	return
end

delete

from
	counterparties
where
	counterparty_id = @counterparty_id


select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds


select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string



exec
	cm_counterparties
		@login

go
