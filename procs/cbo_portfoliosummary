	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@ledger_style = "background:#FFFFFF;border: 1px solid white",
	@futures_style = "background:#FFFFFF;border: 1px solid white",
	@fwd_style = "background:#FFFFFF;border: 1px solid white",
	@fwd_opt_style = "background:#FFFFFF;border: 1px solid white"


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @date = NULL
	select
		@date = getdate()

exec
	r_daterangefordate
		@date,
		@begin_date output,
		@end_date output

select
	@year = convert(varchar(4), datepart(year, @date)),
	@month = convert(varchar(2), datepart(month, @date))

select
	@ytd_begin = convert(datetime, "1/1/" + @year),
	@mtd_begin = convert(datetime, @month + "/1/" + @year)

select
	@end_date = convert(datetime, convert(date, @end_date)),
	@begin_date = convert(datetime, convert(date, @begin_date))

select
	@external_account_id = external_account_id,
	@account_name = name
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

