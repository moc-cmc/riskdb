create table
	#transactions(
		account_transaction_id int,
		external_account_id int,
		transaction_date datetime,
		transaction_type_id int,
		currency_id int,
		amount float,
		evaluation_currency_id int NULL,
		equiv float NULL)
insert into
	#transactions(
		account_transaction_id,
		external_account_id,
		transaction_date,
		transaction_type_id,
		currency_id,
		amount)
select
	account_transaction_id,
	external_account_id,
	transaction_date,
	transaction_type_id,
	currency_id,
	amount
from
	account_transactions
where
	external_account_id = @external_account_id
and
	convert(date, transaction_date) <= convert(date, @end_date)

update
	#transactions
set
	evaluation_currency_id = @evaluation_currency_id

update
	#transactions
set
	equiv = amount
where
	currency_id = @evaluation_currency_id

update
	#transactions
set
	a.equiv = a.amount * c.price
from
	#transactions a,
	forwards b,
	bo_prices c
where
	a.currency_id = b.product_id
and
	a.evaluation_currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#transactions
set
	a.equiv = a.amount * (1.0 / c.price)
from
	#transactions a,
	forwards b,
	bo_prices c
where
	a.currency_id = b.currency_id
and
	a.evaluation_currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.equiv = NULL


