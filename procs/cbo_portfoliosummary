create table
	#conversion_rates(
		product_id int,
		currency_id int NULL,
		date datetime,
		rate float NULL)


create table
	#open_futures_prev(
		currency_id int,
		unrealized_pl float)
create table
	#open_futures(
		currency_id int,
		unrealized_pl float)

create table
	#open_unrealized_pl(
		currency_id int,
		begin_value float NULL,
		end_value float NULL,
		unrealized_pl float NULL,
		equiv float NULL)

select
	@id = 0
select
	@ids = count(*)
from
	#dates
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#dates
	where
		id > @id

	select
		@open_fx_fwd_value = NULL,
		@prev_open_fx_fwd_value = NULL,
		@open_futures_value = NULL,
		@prev_open_futures_value = NULL,
		@futures_realized = NULL,
		@forwards_realized = NULL,
		@fwd_opts_realized = NULL,
		@fut_unrealized_change = NULL,
		@opt_market_value = NULL,
		@opt_realized_pl = NULL,
		@opt_unrealized_pl = NULL,
		@opt_unrealized_change = NULL,
		@unsettled_premium = NULL,
		@settled_premium = NULL,
		@maturing_premium = NULL,
		@ledgers = NULL,
		@ledger_value = NULL

	select
		@range_date = date,
		@label = label
	from
		#dates
	where
		id = @id

	exec
		r_prevbusinessday
			@range_date,
			@range_begin output

	truncate table
		#conversion_rates

	insert into
		#conversion_rates(
			product_id,
			date)
	select
		a.product_id,
		date = @range_date
	from
		products a,
		product_types b
	where
		a.product_type_id = b.product_type_id
	and
		b.name = "Currency"

	update
		#conversion_rates
	set
		currency_id = @evaluation_currency_id

	update
		#conversion_rates
	set
		rate = 1.0
	where
		product_id = currency_id

	update
		#conversion_rates
	set
		a.rate = c.price
	from
		#conversion_rates a,
		forwards b,
		bo_spot_settles c
	where
		a.product_id = b.product_id
	and
		a.currency_id = b.currency_id
	and
		b.contract_id = c.contract_id
	and
		convert(date, c.price_date) = convert(date, @end_date)


	update
		#conversion_rates
	set
		a.rate = (1.0 / c.price)
	from
		#conversion_rates a,
		forwards b,
		bo_spot_settles c
	where
		a.product_id = b.currency_id
	and
		a.currency_id = b.product_id
	and
		b.contract_id = c.contract_id
	and
		convert(date, c.price_date) = convert(date, @end_date)

	update
		#transactions
	set
		a.equiv = a.amount * b.rate
	from
		#transactions a,
		#conversion_rates b
	where
		a.currency_id = b.product_id
		
	select
		@futures_realized = sum(a.equiv)
	from
		#transactions a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.external_account_id = @external_account_id
	and
		b.name = "Futures Realized P&L"
	and
		convert(date, a.transaction_date) > convert(date, @range_begin)
	and
		convert(date, a.transaction_date) <= convert(date, @end_date)
	if @futures_realized = NULL
		select
			@futures_realized = 0.0

		
	truncate table
		#open_futures_prev
	truncate table
		#open_futures
	truncate table
		#open_unrealized_pl

	insert into
		#open_futures_prev(
			currency_id,
			unrealized_pl)
	select
		e.currency_id,
		sum(a.unrealized_pl)
	from
		open_futures a,
		trades b,
		future_contracts c,
		futures d,
		forwards e
	where
		a.trade_id = b.trade_id
	and
		b.contract_id = c.contract_id
	and
		c.future_id = d.future_id
	and
		d.forward_id = e.contract_id
	and
		b.external_account_id = @external_account_id
	and
		convert(date, a.settle_date) = convert(date, @range_begin)
	group by
		e.currency_id
	
	insert into
		#open_futures(
			currency_id,
			unrealized_pl)
	select
		e.currency_id,
		sum(a.unrealized_pl)
	from
		open_futures a,
		trades b,
		future_contracts c,
		futures d,
		forwards e
	where
		a.trade_id = b.trade_id
	and
		b.contract_id = c.contract_id
	and
		c.future_id = d.future_id
	and
		d.forward_id = e.contract_id
	and
		b.external_account_id = @external_account_id
	and
		convert(date, a.settle_date) = convert(date, @end_date)
	group by
		e.currency_id

	insert into
		#open_unrealized_pl(
			currency_id)
	select
		distinct(currency_id)
	from
		#open_futures_prev
	insert into
		#open_unrealized_pl(
			currency_id)
	select
		distinct(currency_id)
	from
		#open_futures
	where
		currency_id not in(
			select
				currency_id
			from
				#open_unrealized_pl)

	update
		#open_unrealized_pl
	set
		begin_value = 0.0,
		end_value = 0.0

	update
		#open_unrealized_pl
	set
		a.begin_value = b.unrealized_pl
	from
		#open_unrealized_pl a,
		#open_futures_prev b
	where
		a.currency_id = b.currency_id

	update
		#open_unrealized_pl
	set
		a.end_value = b.unrealized_pl
	from
		#open_unrealized_pl a,
		#open_futures b
	where
		a.currency_id = b.currency_id

	update
		#open_unrealized_pl
	set
		unrealized_pl = end_value - begin_value

	update
		#open_unrealized_pl
	set
		a.equiv = a.unrealized_pl * b.rate
	from
		#open_unrealized_pl a,
		#conversion_rates b
	where
		a.currency_id = b.product_id
	and
		b.currency_id = @evaluation_currency_id
	and
		b.date = @range_date

	/* select
		@fut_unrealized_change = sum(equiv)
	from
		#open_unrealized_pl
	if @fut_unrealized_change = NULL
		select
			@fut_unrealized_change = 0.0 */

	select
		@prev_open_futures_equiv = sum(a.equiv)
	from
		open_futures a,
		trades b
	where
		a.trade_id = b.trade_id
	and
		b.external_account_id = @external_account_id
	and
		convert(date, a.settle_date) = convert(date, @range_begin)
	if @prev_open_futures_equiv = NULL
		select
			@prev_open_futures_equiv = 0.0

	select
		@open_futures_equiv = sum(a.equiv)
	from
		open_futures a,
		trades b
	where
		a.trade_id = b.trade_id
	and
		b.external_account_id = @external_account_id
	and
		convert(date, a.settle_date) = convert(date, @end_date)
	if @open_futures_equiv = NULL
		select
			@open_futures_equiv = 0.0

	select
		@fut_unrealized_change = @open_futures_equiv - @prev_open_futures_equiv /* MARKR */

	select
		@forwards_realized = sum(a.equiv)
	from
		#transactions a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		b.name = "FX Settlement"
	and
		a.external_account_id = @external_account_id
	and
		convert(date, a.transaction_date) > convert(date, @range_begin)
	and
		convert(date, a.transaction_date) <= convert(date, @end_date)
	if @forwards_realized = NULL
		select
			@forwards_realized = 0.0


		
	select
		@prev_open_fx_fwd_value = sum(a.unrealized_pl_to_date)
	from
		committed_daily_revals a,
		trades b,
		forwards c
	where
		a.trade_id = b.trade_id
	and
		a.contract_id = c.contract_id
	and
		b.external_account_id = @external_account_id 
	and
		convert(date, a.reval_date) = convert(date, @range_begin)
	if @prev_open_fx_fwd_value = NULL
		select
			@prev_open_fx_fwd_value = 0.0

	
	select
		@open_fx_fwd_value = sum(a.unrealized_pl_to_date)
	from
		committed_daily_revals a,
		trades b,
		forwards c
	where
		a.trade_id = b.trade_id
	and
		a.contract_id = c.contract_id
	and
		b.external_account_id = @external_account_id 
	and
		convert(date, a.reval_date) = convert(date, @end_date)
	if @open_fx_fwd_value = NULL
		select
			@open_fx_fwd_value = 0.0

	exec
		cbo_accountoptplforrange
			@login = @login,
			@account = @account,
			@begin_date = @range_begin,
			@end_date = @end_date,
			@maturing_premium = @maturing_premium output,
			@settled_premium = @settled_premium output,
			@unsettled_premium = @unsettled_premium output,
			@market_value = @opt_market_value output,
			@realized_pl = @opt_realized_pl output,
			@unrealized_pl = @opt_unrealized_pl output,
			@unrealized_change = @opt_unrealized_change output

	
	select
		@ledger_value = sum(equiv)
	from
		#transactions a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.external_account_id = @external_account_id
	and
		b.name = "FX Settlement"
	if @ledger_value = NULL
		select
			@ledger_value = 0.0

	select
		@ledgers = sum(equiv)
	from
		#transactions a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.external_account_id = @external_account_id
	and
		convert(date, a.transaction_date) >= convert(date, @range_begin)
	and
		convert(date, a.transaction_date) <= convert(date, @end_date)
	and
		b.name = "FX Settlement"
	if @ledgers = NULL
		select
			@ledgers = 0.0


	if @label = "Daily"
	begin
		update
			#pl_summary
		set
			daily = @futures_realized
		where
			instrument = "Futures"
		and
			description = "Realized P&L"

		update
			#pl_summary
		set
			daily = @fut_unrealized_change
		where
			instrument = "Futures"
		and
			description = "Change In Unrealized P&L"

		update
			#pl_summary
		set
			daily = @futures_realized + @fut_unrealized_change
		where
			instrument = "Futures"
		and
			description = "Total P&L"

		update
			#pl_summary
		set
			daily = @forwards_realized
		where
			instrument = "Forwards"
		and
			description = "Realized P&L"

		update
			#pl_summary
		set
			daily = @open_fx_fwd_value - @prev_open_fx_fwd_value
		where
			instrument = "Forwards"
		and
			description = "Change In Unrealized P&L"


		update
			#pl_summary
		set
			daily = @forwards_realized + (@open_fx_fwd_value - @prev_open_fx_fwd_value)
		where
			instrument = "Forwards"
		and
			description = "Total P&L"


		insert into
			#portfolio_summary(
				style,
				description,
				value,
				ordering)
		values(
			@style,
			"Open Futures Market Value",
			@open_futures_equiv,
			100)

		insert into
			#portfolio_summary(
				style,
				description,
				value,
				ordering)
		values(
			@style,
			"Open FX Spot/Forward Market Value",
			@open_fx_fwd_value,
			200)

		insert into
			#portfolio_summary(
				style,
				description,
				value,
				ordering)
		values(
			@style,
			"Option Market Value",
			@opt_market_value,
			300)


		update
			#pl_summary
		set
			daily =  @opt_unrealized_change
		where
			instrument = "Options"
		and
			description = "Change In Unrealized P&L"
		update
			#pl_summary
		set
			daily =  @opt_unrealized_change + @opt_realized_pl
		where
			instrument = "Options"
		and
			description = "Total P&L"

		update
