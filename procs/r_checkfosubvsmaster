create or replace procedure
	r_checkfosubvsmaster
		@fo_sub_account varchar(100),
		@bo_master_account varchar(100),
		@is_valid_fo_sub char(1) output

as


declare @bo_master_account_id int
declare @bo_external_account_id int
declare @fo_sub_account_id int
declare @fo_external_account_id int
declare @fo_bo_master_account_id int
declare @legal_entity_id int

select
	@is_valid_fo_sub = "N"

select
	@bo_master_account_id = b.bo_master_account_id,
	@bo_external_account_id = a.external_account_id,
	@legal_entity_id = b.legal_entity_id
from
        external_accounts a,
        bo_master_accounts b
where
        a.external_account_id = b.external_account_id
and
        a.symbol = @bo_master_account

if @bo_master_account_id = NULL
begin
        select
                status = "Error",
                message = "Could not find bo master account",
                bo_master_account = @bo_master_account
        return
end


select
	@fo_sub_account_id = b.fo_sub_account_id,
	@fo_external_account_id = b.external_account_id,
	@fo_bo_master_account_id = b.bo_master_account_id
from
	external_accounts a,
	fo_sub_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.symbol = @fo_sub_account
if @fo_sub_account_id = NULL
begin
        select
                status = "Error",
                message = "Could not find fo sub account",
                fo_sub_account = @fo_sub_account
        return
end

if @fo_bo_master_account_id = @bo_master_account_id
begin
	select
		@is_valid_fo_sub = "Y"
end

go
