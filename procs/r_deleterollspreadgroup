drop procedure
	r_deleterollspreadgroup
go

create procedure
	r_deleterollspreadgroup
		@login varchar(50),
		@name varchar(50)
		
as


declare @roll_spread_group_id int

select
	@roll_spread_group_id = roll_spread_group_id
from
	roll_spread_groups
where
	name = @name
if @roll_spread_group_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding group for name",
		name = @name

	exec
        	r_managerollspreadgroups
                	@login

	return
end

create table
	#accounts
(	
	external_account_id int
)

insert into
	#accounts
select
	external_account_id 
from
	account_roll_spread_groups
where
	roll_spread_group_id = @roll_spread_group_id
if @@rowcount > 0
begin
        select
                status = "Error",
                msg = "Can not delete spread group that has been assigned to an account",
                name = @name
	select
		accounts=a.symbol
	from
		external_accounts a,
		#accounts b
	where
		a.external_account_id = b.external_account_id

        exec
                r_managerollspreadgroups
                        @login

	return
end

insert into
	deleted_roll_spread_groups
select
	roll_spread_group_id,
	name,
	getdate()
from
	roll_spread_groups
where
	roll_spread_group_id = @roll_spread_group_id
if @@rowcount = 1
begin
	delete from
		roll_spread_groups
	where
		roll_spread_group_id = @roll_spread_group_id

	insert into
		deleted_contract_roll_spreads
	select
                roll_spread_group_id,
                contract_id,
                spread,
		getdate()
	from
		contract_roll_spreads
	where
		roll_spread_group_id = @roll_spread_group_id
	if @@rowcount > 0
	begin
		delete from
                	contract_roll_spreads
        	where
                	roll_spread_group_id = @roll_spread_group_id
	end
end

	
exec
	r_managerollspreadgroups
		@login


go
