
drop procedure
	xag_addpbwiresignoff
go

create procedure
	xag_addpbwiresignoff
		@login varchar(50),
		@account varchar(50),
		@product varchar(50),
		@confirmation_type varchar(50),
		@value_date datetime,
		@amount numeric(30,4),
		@note varchar(200)=NULL
as

declare @tico_account_id int
declare @product_id int
declare @pb_wire_signoff_id int
declare @external_account_id int
declare @confirmation_type_id int
declare @status_id int
declare @sub_accounts int

if @confirmation_type = "Total"
begin
	select
		status = "Error",
		message = "Total confirmations not allowed"
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "Pending"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Pending status not found"
	return
end


select
	@confirmation_type_id = confirmation_type_id
from
	confirmation_types
where
	name = @confirmation_type
if @confirmation_type_id = NULL
begin
	select
		status = "Error",
		message = "Confirmation type not found",
		confirmation_type = @confirmation_type
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

	
select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

exec
	j_nextkey
		"pb_wire_signoffs",
		@pb_wire_signoff_id output


begin tran
	insert into
		pb_wire_signoffs(
			pb_wire_signoff_id,
			tico_account_id,
			timestamp,
			external_account_id,
			confirmation_type_id,
			product_id,
			value_date,
			amount,
			status_id,
			note)
	values(
		@pb_wire_signoff_id,
		@tico_account_id,
		getdate(),
		@external_account_id,
		@confirmation_type_id,
		@product_id,
		@value_date,
		@amount,
		@status_id,
		@note)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add wire signoff"
		rollback tran
		return
	end

	insert into
		wire_allocations(
			pb_wire_signoff_id,
			external_account_id,
			confirmation_type_id,
			amount)
	select
		pb_wire_signoff_id = @pb_wire_signoff_id,
		external_account_id,
		confirmation_type_id,
		amount
	from
		queued_wire_allocations
	where
		wire_net_account_id = @external_account_id
	and
		product_id = @product_id
	and
		value_date = @value_date
	and
		confirmation_type_id = @confirmation_type_id
	and
		amount != 0.0
	if @@rowcount = 0
	begin
		select
			@sub_accounts = count(*)
		from
			wire_net_accounts
		where
			wire_net_account_id = @external_account_id
		if @sub_accounts = 0
		begin
			insert into
				wire_allocations(
					pb_wire_signoff_id,
					external_account_id,
					confirmation_type_id,
					amount)
			values(
				@pb_wire_signoff_id,
				@external_account_id,
				@confirmation_type_id,
				@amount)
			if @@rowcount != 1
			begin
				select
					status = "Error",
					message = "Unable to add wire allocation"
				rollback tran
				return
			end
		end
	end
commit tran

exec
	ag_confirmsettlements
		@login = @login,
		@value_date = @value_date,
		@account = NULL,
		@product = NULL



go
