drop procedure
	ag_togglepbdeliverable
go

create procedure
	ag_togglepbdeliverable
		@login varchar(50),
		@prime_broker varchar(50),
		@product varchar(50)
as

declare @product_id int
declare @prime_broker_id int

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@prime_broker_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = @prime_broker
if @prime_broker_id = NULL
begin
	select
		status = "Error",
		message = "Prime Broker not found",
		prime_broker = @prime_broker
	return
end

delete

from
	pb_deliverable_products
where
	prime_broker_id = @prime_broker_id
and
	product_id = @product_id
if @@rowcount = 0
begin
	insert into
		pb_deliverable_products(
				prime_broker_id,
				product_id)
	values(
		@prime_broker_id,
		@product_id)
end

exec
	ag_pbproducts
		@login = @login,
		@prime_broker = @prime_broker

go
