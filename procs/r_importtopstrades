create or replace procedure
	r_importtopstrades
		@login varchar(50),
		@dmloperation varchar(50),
		@tradereference varchar(150),
		@party varchar(50),
		@counterparty varchar(50),
		@buysell varchar(10),
		@quantity varchar(50),
		@price varchar(50),
		@currency varchar(10),
		@productcode varchar(10),
		@exchangecode varchar(50),
		@tradedatetimeutc varchar(50),
		@valuationdateutc varchar(50),
		@fixingdateutc varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@source varchar(50)=NULL

as

declare @value_date datetime
declare @trade_date datetime
declare @trade_price float
declare @qty float

declare @client_or_market char(1)
declare @platform_identifier varchar(100)
declare @far_platform_identifier varchar(100)
declare @deal_exec_symbol varchar(100)

declare @broker_id int
declare @source_id int
declare @trade_id int
declare @deal_id int

declare @fund_agency_lookup varchar(30)
