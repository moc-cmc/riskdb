
drop procedure
	ag_edtiextacctdets
go

create procedure
	ag_edtiextacctdets
		@login varchar(50),
		@account varchar(50),
		@account_type varchar(100),
		@base_ccy varchar(50),
		@agg_style varchar(50),
		@settlement varchar(50),
		@lp_trans varchar(5),
		@max_mtd_trades int,
		@margin_mult numeric(30,8),
		@wire_source varchar(50)=NULL,
		@pip_spread varchar(50)=NULL,
		@nop_type varchar(50)=NULL,
		@collateral varchar(50)=NULL
as


declare @external_account_id int
declare @external_account_type_id int
declare @aggregation_style_id int
declare @evaluation_currency_id int
declare @settlement_method_id int
declare @wire_source_id int
declare @pip_spread_id int
declare @nop_type_id int
declare @collateral_product_id int


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "External account not found",
		account = @account
	return
end

select
	@external_account_type_id = external_account_type_id
from
	external_account_types
where
	name = @account_type
if @external_account_type_id = NULL
begin
	select
		status = "Error",
		message = "External account type not found",
		account_type = @account_type
	return
end

select
	@aggregation_style_id = aggregation_style_id
from
	aggregation_styles
where
	name = @agg_style
if @aggregation_style_id = NULL
begin
	select
		status = "Error",
		message = "Aggregation style not found",
		aggregation_style = @agg_style
	return
end


select
	@evaluation_currency_id = product_id
from
	products
where
	symbol = @base_ccy
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Base currency not found",
		base_currency = @base_ccy
	return
end


select
	@settlement_method_id = settlement_method_id
from
	settlement_methods
where
	name = @settlement
if @settlement_method_id = NULL
begin
	select
		status = "Error",
		message = "Settlement method not found",
		settlement_method = @settlement
	return
end

if @wire_source != NULL
begin
	select
		@wire_source_id = source_id
	from
		sources
	where
		name = @wire_source
	if @wire_source_id = NULL
	begin
		select
			status = "Error",
			message = "Wire source not found",
			wire_source = @wire_source
		return
	end
end

if @pip_spread != NULL
begin
	select
		@pip_spread_id = pip_spread_id
	from
		pip_spreads
	where
		name = @pip_spread
	if @pip_spread_id = NULL
	begin
		select
			status = "Error",
			message = "Pip spread not found",
			pip_spread = @pip_spread
		return
	end
end

if @nop_type != NULL
begin
	select
		@nop_type_id = nop_type_id
	from
		nop_types
	where
		name = @nop_type
	if @nop_type_id = NULL
	begin
		select
			status = "Error",
			message = "NOP Type not found",
			nop_type = @nop_type
		return
	end
end


if @collateral != NULL
begin
	select
		@collateral_product_id = product_id
	from
		products
	where
		symbol = @collateral
	if @collateral_product_id = NULL
	begin
		select
			status = "Error",
			message = "Collateral product not found",
			product = @collateral
		return
	end
end


update
	external_accounts
set
	external_account_type_id = @external_account_type_id,
	evaluation_currency_id = @evaluation_currency_id,
	aggregation_style_id = @aggregation_style_id,
	settlement_method_id = @settlement_method_id,
	lp_transparency = @lp_trans,
	max_mtd_statement_trades = @max_mtd_trades,
	margin_multiplier = @margin_mult,
	wire_source_id = @wire_source_id,
	pip_spread_id = @pip_spread_id,
	nop_type_id = @nop_type_id,
	collateral_product_id = @collateral_product_id
where
	external_account_id = @external_account_id


exec
	ag_extaccountdetails
		@login = @login,
		@account = @account




go
