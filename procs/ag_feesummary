create table
	#dealt_rates(
		product_id int,
		rate float NULL)
insert into
	#dealt_rates(
		product_id)
select
	product_id
from
	#conversion_rates

update
	#dealt_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#dealt_rates
set
	a.rate = c.price
from
	#dealt_rates a,
	forwards b,
	fee_conversion_rates c
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.trade_date) = convert(date, @end_date)

update
	#dealt_rates
set
	a.rate = 1.0 / c.price
from
	#dealt_rates a,
	forwards b,
	fee_conversion_rates c
where
	b.contract_id = c.contract_id
and
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	convert(date, c.trade_date) = convert(date, @end_date)
and
	a.rate = NULL


create table
	#fees(
		id int identity,
		scheduled_fee_id int NULL,
		fee_schedule_id int NULL,
		fee_schedule varchar(100) NULL,
		fee_schedule_type_id int NULL,
		fee_schedule_type varchar(100) NULL,
		trade_date datetime NULL,
		account_transaction_id int NULL,
		entered_by int NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(50) NULL,
		transaction_type_id int NULL,
		transaction_type varchar(50) NULL,
		transaction_date datetime NULL,
		currency_id int NULL,
		currency varchar(50) NULL,
		amount numeric(30,4) NULL,
		note varchar(250) NULL,
		client_account varchar(50) NULL,
		trader varchar(50) NULL,
		equiv float NULL)
insert into
	#fees(
		scheduled_fee_id,
		fee_schedule_id,
		trade_date,
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount,
		note)
select
	a.scheduled_fee_id,
	a.fee_schedule_id,
	a.trade_date,
	c.account_transaction_id,
	c.entered_by,
	c.external_account_id,
	c.transaction_type_id,
	c.transaction_date,
	c.currency_id,
	c.amount,
	c.note
from
	scheduled_fees a,
	scheduled_fee_transactions b,
	account_transactions c
where
	a.scheduled_fee_id = b.scheduled_fee_id
and
	b.account_transaction_id = c.account_transaction_id
and
	convert(date, a.trade_date) > @begin_date
and
	convert(date, a.trade_date) <= @end_date


update
	#fees
set
	a.currency = b.symbol
from
	#fees a,
	products b
where
	a.currency_id = b.product_id

update
	#fees
set
	a.fee_schedule = b.name
from
	#fees a,
	fee_schedules b
where
	a.fee_schedule_id = b.fee_schedule_id

update
	#fees
set
	a.equiv = a.amount * b.rate
from
	#fees a,
	#conversion_rates b
where
	a.currency_id = b.product_id

update
	#fees
set
	a.external_account = b.symbol,
	a.external_account_type_id = b.external_account_type_id
from
	#fees a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#fees
set
	a.external_account_type = b.name
from
	#fees a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id


update
	#fees
set
	a.fee_schedule_type_id = b.fee_schedule_type_id
from
	#fees a,
	fee_schedules b
where
	a.fee_schedule_id = b.fee_schedule_id

update
	#fees
set
	a.fee_schedule_type = b.name
from
	#fees a,
	fee_schedule_types b
where
	a.fee_schedule_type_id = b.fee_schedule_type_id

update
	#fees
set
	a.client_account = c.symbol,
	a.trader = d.symbol
from
	#fees a,
	trades b,
	external_accounts c,
	traders d
where
	convert(int, a.note) = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.trader_id = d.trader_id
	
update
	#fees
set
	a.client_account = c.symbol
from
	#fees a,
	fee_schedules b,
	external_accounts c
where
	a.fee_schedule_id = b.fee_schedule_id
and
	b.external_account_id = c.external_account_id
and
	a.client_account = NULL

update
	#fees
set
	a.trader = c.symbol
from
	#fees a,
	fee_schedules b,
	traders c
where
	a.fee_schedule_id = b.fee_schedule_id
and
	b.trader_id = c.trader_id
and
	a.trader = NULL


update
	#fees
set
	a.transaction_type = b.name
from
	#fees a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id

update
	#fees
set
	client_account = external_account
where
	client_account = NULL


create table
	#product_volumes(
		trader_id int,
		product_id int,
		quantity numeric(30,4))


insert into
	#product_volumes(
		trader_id,
		product_id,
		quantity)
select
	a.trader_id,
	b.currency_id,
	sum(a.volume)
from
	daily_trade_nets a,
	forwards b
where
	a.contract_id = b.contract_id
and
	convert(date, a.trade_date) > convert(date,  @begin_date)
and
	convert(date, a.trade_date) <= convert(date, @end_date)
group by
	a.trader_id,
	b.currency_id

create table
	#net_volumes(
		trader_id int,
		product_id int,
		quantity numeric(30,4))
insert into
	#net_volumes(
		trader_id,
		product_id,
		quantity)
select
	trader_id,
	product_id,
	sum(quantity)
from
	#product_volumes
group by
	trader_id,
	product_id


create table
	#non_spread(
		trader varchar(50) NULL,
		equiv float NULL)
insert into
	#non_spread(
		trader,
		equiv)
select
        trader,
        sum(abs(equiv))
from
        #fees
where
	external_account like "IB%"
and
        amount < 0.0
group by
        trader

create table
	#nets_sum(
		id int identity,
		style varchar(250) NULL,
		trader_id int NULL,
		trader varchar(50) NULL,
		product_id int NULL,
		currency varchar(50) NULL,
		traded_amount float NULL,
		amount float NULL,
		equiv float NULL,
		converted_equiv float NULL,
		conversion_rate float NULL,
		evaluation_currency_id int NULL,
		market_rate float NULL,
		conv_contract_id int NULL,
		conv_pair varchar(50) NULL,
		inverted_conv_contract_id int NULL,
		inverted_conv_pair varchar(50) NULL,
		conv_price_style varchar(50) NULL,
		conversion_contract_id int NULL,
		pair varchar(50) NULL,
		display_conversion float NULL,
		display_market float NULL,
		commission float NULL,
		net float NULL,
		set_rate varchar(50) NULL
		)

insert into
	#nets_sum(
		trader,
		currency,
		amount,
		equiv)
select
        trader,
        currency,
        sum(abs(amount)),
        sum(abs(equiv))
from
        #fees
where
	amount > 0.0
and
	transaction_type = "Spread Payout" 
and
	external_account like "IB%"
group by
        trader,
        currency
order by
	trader,
	currency

update
	#nets_sum
set
	style = @style,
	evaluation_currency_id = @evaluation_currency_id,
	commission = 0.0

update
	#nets_sum
set
	a.product_id = b.product_id
from
	#nets_sum a,
	products b
where
	a.currency = b.symbol

update
	#nets_sum
set
	set_rate = "Set Rate"
where
	product_id != @evaluation_currency_id

update
	#nets_sum
set
	a.conv_contract_id = b.contract_id
from
	#nets_sum a,
	forwards b
where
	a.product_id = b.product_id
and
	a.evaluation_currency_id = b.currency_id

update
	#nets_sum
set
	a.conv_pair = b.symbol
from
	#nets_sum a,
	contracts b
where
	a.conv_contract_id = b.contract_id

update
	#nets_sum
set
	a.inverted_conv_contract_id = b.contract_id
from
	#nets_sum a,
	forwards b
where
	a.evaluation_currency_id = b.product_id
and
	a.product_id = b.currency_id

update
	#nets_sum
set
	a.inverted_conv_pair = b.symbol
from
	#nets_sum a,
	contracts b
where
	a.inverted_conv_contract_id = b.contract_id

update
	#nets_sum
set
	a.conv_price_style = c.name
from
	#nets_sum a,
	contract_price_styles b,
	price_styles c
where
	a.conv_contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id

update
	#nets_sum
set
	conversion_contract_id = conv_contract_id,
	pair = conv_pair

update
	#nets_sum
set
	conversion_contract_id = inverted_conv_contract_id,
	pair = inverted_conv_pair
where
	conv_price_style = "Inverted"


update
	#nets_sum
set
	a.market_rate = b.rate
from
	#nets_sum a,
	#conversion_rates b
where
	a.product_id = b.product_id


update
	#nets_sum
set
	a.conversion_rate = b.rate,
	a.converted_equiv = b.rate * a.amount
from
	#nets_sum a,
	#dealt_rates b
where
	a.product_id = b.product_id	


update
	#nets_sum
set
	a.trader_id = b.trader_id
from
	#nets_sum a,
	traders b
where
	a.trader = b.symbol


update
	#nets_sum
set
	a.traded_amount = b.quantity
from
	#nets_sum a,
	#net_volumes b
where
	a.product_id = b.product_id
and
	a.trader_id = b.trader_id

update
	#nets_sum
set
	display_conversion = conversion_rate,
	display_market = market_rate

update
	#nets_sum
set
	display_conversion = 1.0 / display_conversion,
	display_market = 1.0 / display_market

create table
	#min_ids(
		trader varchar(50),
		min_id int)
insert into
	#min_ids(
		trader,
		min_id)
select
	trader,
	min(id)
from
	#nets_sum
group by
	trader

update
        #nets_sum
set
        a.commission = b.equiv
from
        #nets_sum a,
        #non_spread b,
	#min_ids c
where
        a.trader = b.trader
and
	a.trader = c.trader
and
	b.trader = c.trader
and
	a.id = c.min_id


