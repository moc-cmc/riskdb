create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	a.product_id
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"

update
	#conversion_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

