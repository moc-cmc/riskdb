create table
	#accounts(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		sub_account_id int NULL,
		sub_account varchar(50) NULL,
		trader_id int NULL,
		trader varchar(50) NULL,
