		transaction_type varchar(50) NULL,
		currency_id int NULL,
		currency varchar(50) NULL,
		amount numeric(30,4) NULL,
		equiv numeric(30,4) NULL)
select
	@id = 0
select
	@ids = count(*)
from
	#accts
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#accts
	where
		id > @id

	select
		@external_account_id = NULL,
		@account = NULL,
		@net_equiv = NULL

	select
		@external_account_id = external_account_id,
		@account = account
	from
		#accts
	where
		id = @id

	insert into
		#accounts(
			style,
			external_account_id,
			account)
	values(
		@client_style,
		@external_account_id,
		@account)

	insert into
		#accounts(
			style,
			external_account_id,
			sub_account_id,
			sub_account,
			trader_id,
			trader,
			transaction_type_id,
			transaction_type,
			currency_id,
			currency,
			amount,
			equiv)
	select
		style = @style,
		external_account_id,
		client_account_id,
		client_account,
		trader_id,
		trader,
		transaction_type_id,
		transaction_type,
		currency_id,
		currency,
		amount,
		equiv
	from
		#fee_sum
	where
		external_account_id = @external_account_id
	order by
		client_account,
		currency,
		amount

	select
		@net_equiv = sum(equiv)
	from
		#fee_sum
	where
		external_account_id = @external_account_id
	if @net_equiv = NULL
		select
			@net_equiv = 0.0

	insert into
		#accounts(
			style,
			external_account_id,
			equiv)
	values(
		@style,
		@external_account_id,
		@net_equiv)
	

	select
		@ids = count(*)
	from
		#accts
	where
		id > @id
end

create table
	#ccy_sum(
		id int identity,
		style varchar(250) NULL,
		product_id int NULL,
		currency varchar(50) NULL,
		long numeric(30,4) NULL,
		short numeric(30,4) NULL,
		net numeric(30,4) NULL)

insert into
	#ccy_sum(
		currency)
select
	distinct(currency)
from
	#fees
update
	#ccy_sum
set
	style = @style,
	a.product_id = b.product_id,
	long = 0,
	short = 0,
	net = 0
from
	#ccy_sum a,
	products b
where
	a.currency = b.symbol

select
	@id = 0
select
	@ids = count(*)
from
	#ccy_sum
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#ccy_sum
	where
		id > @id

	select
		@long = NULL,
		@short = NULL,
		@net = NULL

	select
		@currency_id = product_id
	from
		#ccy_sum
	where
		id = @id

	select
		@long = sum(amount)
	from
		#fees
	where
		currency_id = @currency_id
	and
		amount > 0.0
	if @long = NULL
		select
			@long = 0.0

	select
		@short = sum(amount)
	from
		#fees
	where
		currency_id = @currency_id
	and
		amount < 0.0
	if @short = NULL
		select
			@short = 0.0

	select
		@net = @long + @short

	update
		#ccy_sum
	set
		long = @long,
		short = @short,
		net = @net
	where
		id = @id
	

	select
		@ids = count(*)
	from
		#ccy_sum
	where
		id > @id
end

select
	@long = sum(long),
	@short = sum(short),
	@net = sum(net)
from
	#ccy_sum

if @net != NULL
begin
	insert into
		#ccy_sum(
			style,
			long,
			short,
			net)
	values(
		@total_style,
		@long,
		@short,
		@net)
end

update
	#nets_sum
set
	net = converted_equiv - commission

select
	@total = NULL
select
	@total = sum(net)
from
	#nets_sum
where
	net != NULL
insert into
	#nets_sum(
		style,
		net)
values(
	@total_style,
	@total)

