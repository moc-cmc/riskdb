insert into
	#scheduled_fees(
		scheduled_fee_id)
select
	distinct(
		scheduled_fee_id)
from
	#fees

select
	@id = 0
select
	@ids = count(*)
from
	#scheduled_fees
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#scheduled_fees
	where
		id > @id

	select
		@scheduled_fee_id = scheduled_fee_id
	from
		#scheduled_fees
	where
		id = @id

	select
		@debit_transaction_id = NULL,
		@credit_transaction_id = NULL,
		@transaction_type= NULL



	select
		@debit_transaction_id = account_transaction_id,
		@transaction_type = transaction_type 
	from
		#fees
	where
		scheduled_fee_id = @scheduled_fee_id
	and
		amount < 0.0
	if @@rowcount > 1
	begin
		select
			status = "Error",
			message = "More than one debit transaction found for scheduled fee",
			scheduled_fee_id = @scheduled_fee_id
	end

	select
		@credit_transaction_id = account_transaction_id
	from
		#fees
	where
		scheduled_fee_id = @scheduled_fee_id 
	and
		amount > 0.0
	if @@rowcount > 1
	begin
		select
			status = "Error",
			message = "More than one credit transaction found for scheduled fee",
			scheduled_fee_id = @scheduled_fee_id
	end

	update
		#scheduled_fees
	set
		debit_transaction_id = @debit_transaction_id,
		credit_transaction_id = @credit_transaction_id,
		transaction_type = @transaction_type
	where
		scheduled_fee_id = @scheduled_fee_id


	select
		@ids = count(*)
	from
		#scheduled_fees
	where
		id > @id
end

update
	#scheduled_fees
set
	a.fee_schedule_id = b.fee_schedule_id,
	a.fee_schedule = c.name,
	a.transaction_date = b.trade_date,
	a.fee_schedule_type = d.name
from
	#scheduled_fees a,
	scheduled_fees b,
	fee_schedules c,
	fee_schedule_types d
where
	a.scheduled_fee_id = b.scheduled_fee_id
and
	b.fee_schedule_id = c.fee_schedule_id
and
	c.fee_schedule_type_id = d.fee_schedule_type_id
	
update
	#scheduled_fees
set
	a.debit_account = c.symbol,
	a.debit_account_id = b.external_account_id,
	a.debit_amount = b.amount,
	a.debit_currency_id = b.currency_id,
	a.debit_currency = d.symbol
from
	#scheduled_fees a,
	account_transactions b,
	external_accounts c,
	products d
where
	a.debit_transaction_id = b.account_transaction_id
and
	b.external_account_id = c.external_account_id
and
	b.currency_id = d.product_id

update
	#scheduled_fees
set
	a.credit_account = c.symbol,
	a.credit_account_id = b.external_account_id,
	a.credit_amount = b.amount,
	a.credit_currency_id = b.currency_id,
	a.credit_currency = d.symbol
from
	#scheduled_fees a,
	account_transactions b,
	external_accounts c,
	products d
where
	a.credit_transaction_id = b.account_transaction_id
and
	b.external_account_id = c.external_account_id
and
	b.currency_id = d.product_id

update
	#scheduled_fees
set
	a.debit_equiv = a.debit_amount * b.rate
from
	#scheduled_fees a,
	#conversion_rates b
where
	a.debit_currency_id = b.product_id

update
	#scheduled_fees
set
	a.credit_equiv = a.credit_amount * b.rate
from
	#scheduled_fees a,
	#conversion_rates b
where
	a.credit_currency_id = b.product_id

update
	#scheduled_fees
set
	net_equiv = debit_equiv + credit_equiv

create table
	#client_credit_fees(
		external_account_id int,
		client_account varchar(50),
		equiv float)

insert into
	#client_credit_fees(
		external_account_id,
