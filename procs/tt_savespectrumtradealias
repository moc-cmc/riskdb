create or replace procedure
	tt_savespectrumtradealias
		@ext_tnum varchar(50),
		@tnum varchar(50),
		@snum varchar(10),
		@source varchar(50)=NULL

as

declare @trade_id int
declare @source_id int
declare @tnum_snum varchar(100)
declare @trade_exists char(1)
declare @prefix varchar(10)
declare @idlink_status_id int
declare @pending_affirm_status_id int
declare @status varchar(50)
declare @swap_symbol_id int
declare	@far_trade_id int


if @source = NULL
begin
	select
		@source = "Spectrum"
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source",
		source = @source
	return
end

select
	@pending_affirm_status_id = status_id
from
	statuses
where
	name = "Pending Affirmation"
if @pending_affirm_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding status 'Pending Affirmation'"
	return
end

select
	@idlink_status_id = status_id
from
	statuses
where
	name = "Pending ID Link"
if @idlink_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding status 'Pending ID Link'"
	return
end



/* --------------------------------------------------------------------------
 * STEP: Manage the identifier formatting
 *
 * We save down the format of snum tnum as one identifier with a hyphen to
 * concatenate the two
 *
 * Spectrum provides us our identifer back in @ext_tnum but it is prefixed with
 * "ETG_" so we need to format that into our trade_id
 */

select
	@prefix = substring(@ext_tnum, 1, 4)

if @prefix != "ETG_"
begin
	select
		status = "Error",
		message = "Identifer must begin with ETG_  ...not processing",
                ext_tnum = @ext_tnum
	return
end

select
	@tnum_snum = rtrim(@tnum)+"-"+rtrim(@snum),
	@trade_id = convert(int, ltrim(rtrim(str_replace(@ext_tnum, "ETG_", ""))))


select
	@trade_exists = "Y"
from
	trades
where
	trade_id = @trade_id
if @trade_exists != "Y"
begin
	select
		status = "Error",
		message = "Can not find trade from formatted ext_tnum",
		ext_tnum = @ext_tnum,
		trade_id = @trade_id
	return
end

if @snum in("F1", "FW")
begin
	select
		@swap_symbol_id = swap_symbol_id
	from
		swap_symbol_trades
	where
		trade_id = @trade_id	
	if @swap_symbol_id = NULL
	begin
		select
			status = "Error",
			message = "Problem finding swap symbol id for trade",
			trade_id = @trade_id
		return
	end
	select
		@far_trade_id = trade_id
	from	
		swap_symbol_trades
	where
		swap_symbol_id = @swap_symbol_id
	and
		trade_id != @trade_id
	if @far_trade_id = NULL
	begin
		select
			status = "Error",
			message = "Problem finding far leg trade_id from swap symbol",
			swap_symbol_id = @swap_symbol_id
		return
	end
end

if @far_trade_id != NULL
begin
	select
		@trade_id = @far_trade_id
end

exec
	api_savetradealias
		@trade_id = @trade_id,
		@source = @source,
		@alias = @tnum_snum,	
		@status = @status output

if @status = "Success" 
begin
	begin tran
		update
			trades
		set
			status_id = @pending_affirm_status_id
		where
			trade_id = @trade_id
		and
			status_id = @idlink_status_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem updating status from Pending ID Link to Pending Affirmation"
			rollback tran
			return
		end
	commit tran
end


go
