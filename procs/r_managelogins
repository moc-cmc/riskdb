
drop procedure
	r_managelogins
go

create procedure
	r_managelogins 
		@login varchar(50),
		@user_login varchar(50)=NULL
as

declare @tico_account_id int
declare @has_permission  char(1)
declare @login_name varchar(25)
declare @random_password varchar(20)
declare @standard_login int
declare @client_login int
declare @disabled_login int
declare @elysium_login_id int
declare @login_status varchar(20)

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into 
	#meta
values(
	"Column Link",
	"Reset Password",
	"Reset Password",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"Change Login Status",
	"Change Login Status",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"Disable Login",
	"Disable Login",
	NULL)

insert into 
	#meta
values(
	"Column Link",
	"Client Access",
	"Client Access",
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"Old Password",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Hidden",
        "New Password",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "show_password",
        "Manage Logins",
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "user_login",
        NULL,
        NULL)


insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Link",
        "add_login",
        "Add New Login",
        NULL)

select * from #meta

select
	@has_permission = "N"

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login

select
	@has_permission = "Y"
FROm
	access_groups a,
	access_group_accounts b
where
	a.access_group_id = b.access_group_id
and
	a.name = "Login Admin"
and
	b.tico_account_id = @tico_account_id
	

if @has_permission != "Y"
begin
	select
		status = "Error",
		message = "<b>Permission Denied</b>" + " - User must be configured as 'Login Admin' to view and set passwords"
	return
end

select 
	@standard_login = login_type_id
from
	login_types
where
	name="Standard"

if @@rowcount < 1
begin
	select
		status="Error",
		message= "Standard login type does not exist."
	return
end

select
	@client_login = login_type_id
from
	login_types
where
	name="Client"

if @@rowcount < 1
begin
	select
		status="Error",
		message="Client login type does not exist."
	return
end

select
	@disabled_login = login_type_id
from
	login_types
where
	name="Disabled"

if @@rowcount < 1
begin
	select
		status="Error",
		message="Disabled login type does not exist."
	return
end

select
        @elysium_login_id = a.login_type_id
from
        login_types a,
	tico_account_types b
where
        a.name="Elysium"
and
	a.login_type_id = b.login_type_id
and
	b.tico_account_id = @tico_account_id
	
	
if @elysium_login_id != NULL
begin
	select
		add_login = "Add New Login"
end


declare @total_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)

select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
        @selected_trade_style = "background:#F7F4C1;border: 1px solid white"

create table
	#login_types(
		login_type_id int
	)

insert into 
	#login_types(
		login_type_id
	)
select
	login_type_id
from
	login_types
where
	name not in("Elysium")
	
	
create table
	#output(
		login_name  varchar(25),
		password varchar(20),
		old_password varchar(20),
		new_password varchar(20),
		reset_password  varchar(15),
		login_status varchar(20),
		disable_login varchar(20),
		change_login_status varchar(20),
		user_login varchar(50) NULL,
		show_password varchar(15) NULL,
		style varchar(100) NULL)
insert into
	#output
select
	a.login,
	"", /* default is to not show password */
	a.password,
	" ",
	"Reset Password",
	c.name,
	"Disable Login",
	"Change Login Status",
	a.login,
	"Show Password",
	@style
from
	tico_accounts a,
	tico_account_types b,
	login_types c,
	#login_types d
where
	a.account_id=b.tico_account_id
and
	b.login_type_id=c.login_type_id
and
	c.login_type_id = d.login_type_id
	

/* set the password and style for a login if it was selected */
if @user_login != NULL
begin
	update
		#output
	set
		style = @selected_style,
		password = old_password,
		show_password = NULL
	where
		login_name = @user_login
end

declare
	password_cursor
cursor for
	select
		login_name, login_status
	from
		#output
	order by
		login_name

open 
	password_cursor
fetch  
	password_cursor
into
	@login_name, @login_status

while @@sqlstatus = 0
begin
	exec
		r_genrandompassword 7, @random_password output
	update
		#output
	set
		new_password=@random_password
	where
		login_name=@login_name

	if @login_status="Disabled"
	begin
		update
			#output
		set
			show_password="",
			reset_password="",
			change_login_status="",
			disable_login=""
		where
			login_name=@login_name
	end
	
	fetch 
		password_cursor
	into
		@login_name, @login_status
end
close password_cursor
deallocate password_cursor

select 
	section = "Manage User Passwords",
	login_name,
	password,
	old_password,
	new_password,
        show_password,
	reset_password,
	login_status,
	change_login_status,
	disable_login,
	user_login,
	style
from
	#output
order by
	login_status,
	login_name


select
	section = "Addional Login Tools",
	client_access="Client Acess"
go


