
if object_id("r_getnormalizedaterange") != NULL
    drop procedure
        r_getnormalizedaterange
go

create procedure
	r_getnormalizedaterange
		@begin_date datetime out,
        @end_date datetime out
as

/* Default @begin_date to today */
if @begin_date = NULL
    select
        @begin_date = getdate()
if datepart(hour, @begin_date) < 17
    exec
        r_prevbusinessday
            @begin_date,
            @begin_date output
select
    @begin_date = convert(datetime, convert(varchar(10), @begin_date, 101) + " 17:00:00")

/* Default @end_date to 1 day after @begin_date */
if @end_date = NULL
begin
    exec
        r_nextbusinessday
            @begin_date,
            @end_date output
end
if datepart(hour, @end_date) >= 17
    exec
        r_nextbusinessday
            @begin_date,
            @end_date output
select
    @end_date = convert(datetime, convert(varchar(10), @end_date, 101) + " 17:00:00")
    
go
