create table
	#globals(
		forward_contract_id int,
		perspective_contract_id int NULL)
insert into
	#globals
select
	a.contract_id,
	NULL
from
	contracts a,
	forwards b
where
	a.contract_id = b.contract_id
	
update
	#globals
set
	a.perspective_contract_id =  b.perspective_contract_id
from
	#globals a,
	def_perspective_contracts b
where
	a.forward_contract_id = b.contract_id

create table
	#globals_output(
		run_name varchar(50),
		forward_symbol varchar(50),
		perspective_contract varchar(50) NULL,
		remove_contract varchar(25) NULL,
		set_def_contract varchar(25) NULL)
insert into
	#globals_output
select
	run_name = "Default",
	forward_symbol = a.symbol,
	perspective_contract = b.symbol,
	remove_contract = "REMOVE",
	set_def_contract = "SET"
from
	contracts a,
	contracts b,
	#globals c
where
	a.contract_id = c.forward_contract_id
and
	b.contract_id =* c.perspective_contract_id
	
update
	#globals_output
set
	remove_contract = NULL
where
	perspective_contract = NULL

