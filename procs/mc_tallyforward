 NULL,
 NULL)
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem adding trade notification"
		rollback tran
	return
end

*/

commit tran

insert into
	trade_value_dates
values(
	@trade_id,
	@value_date)

insert into
	trade_prices
values(
	@trade_id,
	@market_rate,
	getdate())

insert into
       trade_spot_references
values(
	@trade_id,
	@trade_spot_price
	)

insert into
	deal_notifications
	(source_id,
	 deal_id,
	 status_id,
 	 capture_date,
	 notify_date,
	 error)
values
	(1,
	 @deal_id,
	 @active_status_id,
	 getdate(),
	 getdate(),
	 "")

exec
	r_inspectdealtrades
		@login,
		@deal_id

exec
	r_intradaypl
		@login
	
 
go
