use
	risk_sales
go

drop procedure
	r_servicecontracts
go



create procedure
	r_servicecontracts
		@login char(30),
		@service_name char(50)=NULL
as


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Column Link",
	"remove_contract",
	"Remove Service Contract",
	"suppressAutoexecute=YES",
	NULL)

insert into
	#links
values(
	"Column Link",
	"add_contract",
	"Add Service Contract",
	"suppressAutoexecute=YES",
	NULL)

select * from #links

select
	add_contract = "ADD SERVICE CONTRACT"

if @service_name != NULL and @service_name != ""
begin
	select
		a.service_contract_id,
		external_process = c.name,
		b.symbol,
		instrument = d.name,
		a.price_scale,
		price_tick_size = convert(char(30), convert(numeric(30,6), a.price_tick_size)),
		remove_contract = "REMOVE"
	from
		service_contracts a,
		contracts b,
		external_processes c,
		instruments d
	where
		a.contract_id = b.contract_id
	and
		a.external_process_id = c.external_process_id
	and
		b.instrument_id = d.instrument_id
	and
		c.name = @service_name
end
else
begin
	select
		a.service_contract_id,
		external_process = c.name,
		b.symbol,
		instrument = d.name,
		a.price_scale,
		price_tick_size = convert(char(30), convert(numeric(30,6), a.price_tick_size)),
		remove_contract = "REMOVE"
	from
		service_contracts a,
		contracts b,
		external_processes c,
		instruments d
	where
		a.contract_id = b.contract_id
	and
		b.instrument_id = d.instrument_id
	and
		a.external_process_id = c.external_process_id
end
	
	

go
