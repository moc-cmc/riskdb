	#credit(
		section varchar(50),
		external_account_id int,
		ext_account varchar(50),
		currency varchar(50),
		nop_type varchar(50),
		nop_limit float,
		dsl_type varchar(50),
		dsl_limit float,
		notice_level float,
		warning_level float,
		blocked_level float,
		edit_limits varchar(50)
	)

