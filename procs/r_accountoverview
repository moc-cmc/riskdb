	section = "Credit Summary",
	b.external_account_id,
	ext_account = b.symbol,
	currency = c.symbol,
	nop_type = d.name,
	a.nop_limit,
	dsl_type = e.name,
	a.dsl_limit,
	a.notice_level,
	a.warning_level,
	a.blocked_level,
	edit_limits = "EDIT"
from
	ext_account_limits a,
	external_accounts b,
	products c,
	nop_types d,
	dsl_types e
