where
        end_reval_date >= "Nov 30 2012  5:00PM"

/*
select begin_reval_date=@begin_reval_date
select end_reval_date=@end_reval_date
*/

declare revals cursor for

        select
                reval_archive_level_id,
                begin_reval_date,
                end_reval_date
        from
                reval_archive_levels
        where
                begin_reval_date >= @begin_reval_date and
                end_reval_date <= @end_reval_date
        order by
                reval_archive_level_id

open revals
fetch revals into @reval_archive_level_id, @level_begin_date, @level_end_date

while (@@sqlstatus = 0)
begin
/*
        select @reval_archive_level_id
*/
        select 
                @table_name = table_name
        from
                reval_table_map
        where
                reval_archive_level_id = @reval_archive_level_id
/*
        select
                @table_name
*/
        if(@@rowcount != 1)
        begin
                select
                        status="Error",
                        msg="Could not find table for reval archive level id ", @reval_archive_level_id
                return
        end

		select
			@insertsql = "insert into #committed_revals select trade_id, bo_trade_date, reval_date, value_date, close_price, source_id, status_id, contract_id, premium, premium_ccy_id, premium_settle_date, evaluation_currency_id, evaluation_value, evaluation_premium, evaluation_notional, realized_pl_to_date, unrealized_pl_to_date from " + @table_name + " where reval_archive_level_id = " + rtrim(convert(varchar(10), @reval_archive_level_id))
/*
        select @insertsql
*/
        exec(@insertsql)
/*
        select "count"=count(*) from #committed_revals
*/
        fetch revals into @reval_archive_level_id, @level_begin_date, @level_end_date
        
end
close revals
deallocate revals

