drop procedure
	fxa_suppresstrade
go

create procedure
	fxa_suppresstrade
		@login char(25),
		@source varchar(50),
		@suppressed_trade_id int output,
		@deal_id int output,
		@deal_identifier varchar(100)=NULL, 
		@deal_alias varchar(100)=NULL,
		@tally_type varchar(25),
		@deal_type varchar(50),
		@trade_type varchar(25),
		@internal_account varchar(50)=NULL,
		@external_account varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@quantity numeric(30,4),
		@symbol varchar(50),
		@value_date datetime,
		@price float,
		@trade_date datetime,
		@trader varchar(25)=NULL,
		@strategy varchar(50)=NULL,
		@status varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@identifier varchar(100)=NULL,
		@sales_code varchar(25)=NULL,
		@premium float=NULL,
		@premium_currency varchar(25)=NULL,
		@prem_settle_date datetime=NULL,
		@pct_price float=NULL,
		@spot_reference float=NULL,
		@fixing_date datetime=NULL
as

declare @source_id int
declare @tico_account_id int
declare @fund_id int
declare @tally_type_id int
declare @deal_type_id int
declare @trade_type_id int
declare @internal_account_id int
declare @external_account_id int
declare @counterparty_id int
declare @contract_id int 
declare @trader_id int
declare @strategy_id int
declare @broker_id int
declare @status_id int
declare @deal_status_id int
declare @price_style varchar(40)
declare @premium_currency_id int
declare @premium_transaction_type_id int
declare @account_transaction_id int
declare @quantity_sign float
declare @trades int
declare @sales_code_id int
declare @default_sales_code_id int
declare @client_user_id int
declare @aggregation_style varchar(25)

select
    @deal_status_id = status_id
from
    statuses
where
    name = "User Review"

if @deal_status_id = NULL
begin
    select
        status = "Error",
        message = "No status found named, 'User Review'"
    return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login, '" + @login + "'",
        login = @login
	return
end

select
	@tally_type_id = tally_type_id
from
	tally_types
where
	name = @tally_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Tally type not found",
		tally_type = @tally_type
	return
end


select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = @deal_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Deal type not found",
		deal_type = @deal_type
	return
end

select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = @trade_type
if @@rowcount != 1
begin
	insert into
		trade_types(
			name)
	values(
		@trade_type)
	select
		@trade_type_id = @@identity
end


if @trader != NULL
begin
	select
		@client_user_id = tico_account_id,
		@trader_id = trader_id,
		@default_sales_code_id = sales_code_id
	from
		traders
	where
		symbol = @trader
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end
end

if @client_user_id = NULL
	select
		@client_user_id = @tico_account_id

select
	@internal_account_id = internal_account_id,
	@external_account_id = external_account_id,
	@trader_id = trader_id,
	@strategy_id = strategy_id,
	@broker_id = broker_id,
	@status_id = status_id,
	@counterparty_id = counterparty_id
from
	default_tally_accounts
where
	tico_account_id = @client_user_id
and
	tally_type_id = @tally_type_id
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Trader has no tally defaults"
	return
end

if @broker != NULL
begin
	select
		@broker_id = broker_id
	from
		brokers
	where
		symbol = @broker
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Broker not found",
			broker = @broker
		return
	end
end

if @identifier != NULL
begin
	if @suppressed_trade_id = NULL
	begin
		select
			@suppressed_trade_id = trade_id
		from
			suppressed_trades
		where
			broker_id = @broker_id
		and
			identifier = @identifier

		if @suppressed_trade_id != NULL
		begin
			select
				status = "Dupe",
				messsage = "Trade is already tallied",
				identifier = @identifier,
				suppressed_trade_id = @suppressed_trade_id
			return
		end
	end
end
	

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end

if @strategy != NULL
begin
	select
		@strategy_id = strategy_id
	from
		strategies
	where
		name = @strategy
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Strategy not found",
			strategy = @strategy
		return
	end
end

if @trader != NULL
begin
	select
		@trader_id = trader_id,
		@default_sales_code_id = sales_code_id
	from
		traders
	where
		symbol = @trader
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end
end

if @sales_code != NULL
begin
	select
		@sales_code_id = sales_code_id
	from
		sales_codes
	where
		name = @sales_code
	if @@rowcount != 1
	begin
		exec
			j_nextkey
				"sales_codes",
				@sales_code_id output
		insert into
			sales_codes
		values(
			@sales_code_id,
			@sales_code)
	end
end
else
begin
	select
		@sales_code_id = @default_sales_code_id
end

if @counterparty != NULL
begin
	select
		@counterparty_id = counterparty_id
	from
		counterparties
	where
		name = @counterparty
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Counterparty not found",
			counterparty = @counterparty
		return
	end
end

if @external_account != NULL
begin
	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @external_account
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "External account not found",
			external_account = @external_account
		return
	end
end

if @internal_account != NULL
begin
	select
		@internal_account_id = internal_account_id
	from
		internal_accounts
	where
		symbol = @internal_account
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Internal account not found",
			internal_account = @internal_account
		return
	end
end

/* Check the aggregation style. If the aggregation style is not "None", then
 * override the @status_id of the trade to "Unaggregated". This can be
 * overridden by the @status parameter. */
select
    @aggregation_style = b.name
from
    external_accounts a,
    aggregation_styles b
where
    a.aggregation_style_id = b.aggregation_style_id
and
    a.external_account_id = @external_account_id
    
if @aggregation_style != "None"
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name = "Unaggregated"
    
    if @status_id = NULL
    begin
		select
			status = "Error",
			message = "Status, 'Unaggregated', not found",
			status_name = "Unaggregated"
		return
    end
end

if @status != NULL
begin
	select
		@status_id = status_id
	from
		statuses
	where
		name = @status
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Status not found",
			status_name = @status
		return
	end
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

if @deal_type = "Option"
	exec
		r_contractvaluedate
			@contract_id,
			@trade_date,
			@value_date output


select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id

if @price_style = "Inverted"
	select
		@price = 1.0 / @price

if @suppressed_trade_id = NULL
begin
    exec
        j_nextkey
            "suppressed_trades",
            @suppressed_trade_id output
    
    if @identifier = NULL
        select
            @identifier = rtrim(@source) + " " + rtrim(convert(varchar(20), @suppressed_trade_id))

end

if @deal_id = NULL
begin

	exec
		j_nextkey
			"suppressed_deals",
			@deal_id output

	if @deal_identifier = NULL
	begin
		select 
			@deal_identifier = "Suppressed:"+rtrim(convert(varchar(15), @deal_id))
	end

	insert into
            suppressed_deals (
            deal_id,
            deal_type_id,
	    symbol,
            timestamp,
            status_id)
	values(
        	@deal_id,
		@deal_type_id,
		@deal_identifier,
		getdate(),
        	@deal_status_id)
	
	if @deal_alias != NULL
	begin
	
		insert into
			suppressed_deal_aliases
		values(
			@deal_id,
			@source_id,
			@deal_alias
			)
	end
end
    

select
	@premium_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Option Premium"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"transaction_types",
			@premium_transaction_type_id output

	insert into
		transaction_types
	values(
		@premium_transaction_type_id,
		"Option Premium",
		1)
end

if @premium != NULL
begin
	select
		@premium_currency_id = product_id
	from
		products
	where
		symbol = @premium_currency
	if @premium_currency_id = NULL
	begin
		select
			@premium_currency_id = evaluation_currency_id
		from
			funds
		where
			fund_id = @fund_id
		if @premium_currency_id = NULL
		begin
			select
				status = "Error",
				message = "Unable to resolve premium currency"
			return
		end
	end

	exec
		j_nextkey
			"account_transactions",
			@account_transaction_id output

	select
		@quantity_sign = sign(@quantity)

	select
		@premium = abs(@premium) * @quantity_sign * -1.0
end

begin tran

	insert into
		suppressed_trades(
            trade_id,
            deal_id,
            user_id,
            trade_type_id,
            internal_account_id,
            external_account_id,
            counterparty_id,
            quantity,
            contract_id,
            value_date,
            fixing_date,
            price,
            trade_date,
            trader_id,
            strategy_id,
            status_id,
            broker_id,
            sales_code_id,
            identifier,
            pct_price,
            spot_reference
        )
	values(
                @suppressed_trade_id,
		@deal_id,
		@tico_account_id,
		@trade_type_id,
		@internal_account_id,
		@external_account_id,
		@counterparty_id,
		@quantity,
		@contract_id,
		@value_date,
		@fixing_date,
		@price,
		@trade_date,
		@trader_id,
		@strategy_id,
		@status_id,
		@broker_id,
		@sales_code_id,
		@identifier,
		@pct_price,
		@spot_reference)
        
    if @@rowcount != 1
    begin
        rollback
		select
			status = "Error",
			message = "Failed to tally trade",
			status_name = "Unaggregated",
            		suppressed_trade_id = @suppressed_trade_id,
            deal_id = @deal_id,
            trade_type_id = @trade_type_id,
            internal_account_id = @internal_account_id,
            external_account_id = @external_account_id,
            counterparty_id = @counterparty_id,
            quantity = @quantity,
            contract_id = @contract_id,
            value_date = @value_date,
            fixing_date = @fixing_date,
            price = @price,
            trade_date = @trade_date,
            trader_id = @trader_id,
            strategy_id = @strategy_id,
            status_id = @status_id,
            broker_id = @broker_id,
            sales_code_id = @sales_code_id,
            identifier = @identifier,
            pct_price = @pct_price,
            spot_reference = @spot_reference
        return
    end


    /* ---------Suppressed Option Trades not supported 
    if @premium != NULL
	begin
			
		insert into
			account_transactions (
            	account_transaction_id,
                entered_by,
                external_account_id,
                transaction_type_id,
                transaction_date,
                currency_id,
                amount,
                note
            )
		values(
			@account_transaction_id,
			@tico_account_id,
			@external_account_id,
			@premium_transaction_type_id,
			@prem_settle_date,
            @premium_currency_id,
			@premium,
			NULL)

		insert into
			account_transaction_trades (
            	account_transaction_id,
                trade_id,
                conversion_rate
            )
		values(
			@account_transaction_id,
			@trade_id,
			1)
        
	end
     ------------End suppressed option trades comment */
    
    /*
    insert into
        trade_matches (
            trade_id
        )
    values (
        @trade_id
    )
    if @@rowcount != 1
    begin
        rollback
        select
            status = "Error",
            message = "Failed to insert into trade matches. Rolling back trade."
        return
    end
     */

commit tran

go
