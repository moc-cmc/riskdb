
drop procedure
	api_addextaccountsymbol
go

create procedure
	api_addextaccountsymbol 
			@login varchar(25),
			@name varchar(150),
			@symbol varchar(100),
			@source varchar(100)
as

declare @external_account_id int
declare @source_id int
declare @source_type_id int
declare @source_type varchar(50)

select 
	@symbol = ltrim(rtrim(@symbol))

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol=@name

if (@@rowcount !=1)
begin

	select 
		status="Error",
		msg="External Account symbol does not exist",
		external_account=@symbol

	return
end

select
	@source_id = source_id,
	@source_type_id = source_type_id
from
	sources
where
	name=@source

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source

	return
end

select
	@source_type=name
from
	source_types
where
	source_type_id=@source_type_id

if (@source_type="Outbound")
begin
	if exists (select 
			external_account_id
		   from
			external_account_symbols
		   where
			source_id=@source_id
	           and
			external_account_id=@external_account_id)

	begin
		select
			status="Error",
			msg="External account already has an Outbound Source",
			name=@name

		return
	end
end
	
insert into
	external_account_symbols (
		external_account_id,
		source_id,
		symbol )
values (
	@external_account_id,
	@source_id,
	@symbol )

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Problem adding account symbol",
		account_symbol=@symbol
	return
end

select
	status="OK",
	msg="Successfully added account symbol",
	account_symbol=@symbol

return

go

