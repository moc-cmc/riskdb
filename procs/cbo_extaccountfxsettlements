drop procedure cbo_extaccountfxsettlements
go

create procedure
	cbo_extaccountfxsettlements
		@login varchar(50),
		@external_account varchar(50),
		@trade_date datetime,
		@fx_settlement_amount float=NULL output

as

declare @run_id int
declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @evaluation_currency_id int
declare @fund_id int
declare @max_commit_date datetime

declare @external_account_id int
declare @begin_date datetime
declare @end_date datetime

declare @debug char(1)
select @debug = "N"

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id


exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

if @debug = "Y"
	select	debug="dates",trade_date=@trade_date,begin_date=@begin_date,end_date=@end_date

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		error="Error",
		msg="Problem determining external account",
		external_account=@external_account
	return
end

create table 
	#trades
(
	trade_id int,
	external_account_id int
)
insert into
	#trades
select
	trade_id,
	external_account_id
from
	trades
where
	convert(date, value_date) >= convert(date, @trade_date)
and
	external_account_id = @external_account_id


create table
	#committed_daily_revals(
		trade_daily_reval_id int,
		trade_id int,
		bo_trade_date datetime,
		value_date datetime,
		reval_date datetime,
		realized_pl_to_date float NULL,
		external_account_id int NULL
	)

insert into
	#committed_daily_revals(
                trade_daily_reval_id,
                trade_id,
                bo_trade_date,
                value_date,
                reval_date,
                realized_pl_to_date
	)
select
	trade_daily_reval_id,
	trade_id,
	bo_trade_date,
	value_date,
	reval_date,
	realized_pl_to_date
from
	committed_daily_revals
where
	convert(date,reval_date) = convert(date, @trade_date)

update
	#committed_daily_revals
set
	external_account_id = b.external_account_id
from
	#committed_daily_revals a,
	#trades b
where
	a.trade_id = b.trade_id

	

if @debug = "Y"
	select debug="#committed_daily_revals", * from #committed_daily_revals

select
	@fx_settlement_amount = sum(realized_pl_to_date)
from
	#committed_daily_revals
group by
	external_account_id

go
