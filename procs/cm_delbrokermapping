
if object_id("cm_delbrokermapping") != NULL
    drop procedure
        cm_delbrokermapping
go

create procedure
	cm_delbrokermapping
		@login varchar(50),
		@broker varchar(50),
		@source varchar(50),
		@mapping varchar(50)
as


declare @broker_id int
declare @source_id int

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Broker not found",
		broker = @broker
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

delete

from
	broker_symbols
where
	broker_id = @broker_id
and
	source_id = @source_id
and
	symbol = @mapping

exec
	cm_brokermappings
		@login,
		@broker

go
