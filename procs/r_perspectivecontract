
if object_id("r_perspectivecontract") != NULL
    drop procedure
        r_perspectivecontract
go
 
create procedure
	r_perspectivecontract
		@run_id int,
		@contract_id int,
		@perspective_contract_id int output
as


declare @forward_id int
declare @underlying_contract_id int


/* if @contract_id = 2510
begin
