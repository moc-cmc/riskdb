create table
	#trade_revals(
		trade_id int,
		trade_date char(11),
		contract_id int,
		underlying_forward_id int NULL,
		perspective_contract_id int NULL,
		symbol varchar(50),
		quantity numeric(30,4),
		price float,
		value_date varchar(11),
		premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized float NULL,
		end_realized float NULL,
		begin_unrealized float NULL,
		end_unrealized float NULL,
		realized_range float NULL,
		unrealized_range float NULL,
		ending_valuation float NULL,
		settle_price float NULL)
insert into
	#trade_revals
select
	a.trade_id,
	trade_date = convert(char(11), b.trade_date, 1),
	a.contract_id,
	underlying_forward_id = NULL,
	perspective_contract_id = NULL,
	c.symbol,
	b.quantity,
	b.price,
	value_date = convert(char(11), (select max(d.value_date) from trade_daily_revals d where a.trade_id = d.trade_id), 1),
	premium = a.total_premium,
	a.premium_settle_date,
	begin_realized = a.begin_realized_pl_to_date,
	end_realized = a.end_realized_pl_to_date,
	begin_unrealized = a.begin_unrealized_pl_to_date,
	end_unrealized = a.end_unrealized_pl_to_date,
	realized_range = a.realized_range_pl,
	unrealized_range = a.unrealized_range_pl,
	ending_valuation = a.end_evaluation_value,
	settle_price = a.settle_price
from
	#trades a,
	trades b,
	contracts c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id


update
	#trade_revals
set
	a.underlying_forward_id = a.contract_id
from
	#trade_revals a,
	forwards b
where
	a.contract_id = b.contract_id


update
	#trade_revals
set
	a.underlying_forward_id = c.forward_id
from
	#trade_revals a,
	future_contracts b,
	futures c
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id

update
	#trade_revals
set
	a.underlying_forward_id = f.forward_id
from
	#trade_revals a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.future_id = f.future_id


update
	#trade_revals
set
	a.underlying_forward_id = e.contract_id
from
	#trade_revals a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id

update
	#trade_revals
set
	a.underlying_forward_id = e.contract_id
from
	#trade_revals a,
	exotic_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id


update
	#trade_revals
set
	perspective_contract_id = underlying_forward_id

update
	#trade_revals
set
	a.perspective_contract_id = b.perspective_contract_id
from
	#trade_revals a,
	run_perspective_contracts b
where
	a.underlying_forward_id = b.contract_id
and
	b.run_id = @run_id
if @@rowcount = 0
begin
	update
		#trade_revals
	set
		a.perspective_contract_id = b.perspective_contract_id
	from
		#trade_revals a,
		def_perspective_contracts b
	where
		a.underlying_forward_id = b.contract_id
end

create table
	#summary(
		contract_id int,
		settled_premium float,
		unsettled_premium float,
		realized_pl float,
		fwd_unrealized_pl float,
		opt_unrealized_pl float,
		fwd_ending_value float,
		opt_ending_value float)
		
create table
	#contracts(
		id int identity,
		contract_id int NULL,
		symbol varchar(50))
insert into
	#contracts(
		symbol)
select
	distinct(a.symbol)
from
	contracts a,
	#trade_revals b
where
	a.contract_id = b.perspective_contract_id
order by
	a.symbol

update
	#contracts
set
	a.contract_id = b.contract_id
from
	#contracts a,
	contracts b
where
	a.symbol = b.symbol

		
select
	@id = 0
select
	@contracts = count(*)
from
	#contracts
where
	id > @id

while @contracts > 0
begin
	select
		@id = min(id)
	from
		#contracts
	where
		id > @id

	select
		@contract_id = contract_id
	from
		#contracts
	where
		id = @id

	select
		@total_begin_unrealized = NULL,
		@total_end_unrealized = NULL,
		@total_settled_premium = NULL,
		@total_unsettled_premium = NULL,
		@total_premium = NULL,
		@total_realized = NULL,
		@total_fwd_realized = NULL,
		@total_fwd_unrealized = NULL,
		@total_end_fwd_unrealized = NULL,
		@total_fwd_value = NULL,
		@total_opt_value = NULL


	select
		@total_settled_premium = sum(premium)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	and
		premium_settle_date <= @stop_date
	and
		premium_settle_date >= @start_date
	if @total_settled_premium = NULL
		select
			@total_settled_premium = 0.0

	select
		@total_unsettled_premium = sum(premium)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	and
		premium_settle_date >= @stop_date
	if @total_unsettled_premium = NULL
		select
			@total_unsettled_premium = 0.0


	select
		@total_premium = sum(premium)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	if @total_premium = NULL
		select
			@total_premium = 0.0
		

	select
		@total_fwd_unrealized = sum(a.unrealized_range),
		@total_fwd_value = sum(a.ending_valuation),
		@total_end_fwd_unrealized = sum(a.end_unrealized)
	from
		#trade_revals a,
		forwards b
	where
		a.contract_id = b.contract_id
	and
		perspective_contract_id = @contract_id
	if @total_fwd_unrealized = NULL
		select
			@total_fwd_unrealized = 0.0,
			@total_fwd_value = 0.0,
			@total_end_fwd_unrealized = 0.0

	select
		@total_opt_unrealized = sum(a.unrealized_range),
		@total_opt_value = sum(a.ending_valuation)
	from
		#trade_revals a,
		option_contracts b
	where
		a.contract_id = b.contract_id
	and
		a.perspective_contract_id = @contract_id
	if @total_opt_unrealized = NULL
		select
			@total_opt_unrealized = 0.0,
			@total_opt_value = 0.0

	select
		@total_realized = sum(realized_range),
		@total_end_unrealized = sum(end_unrealized),
		@total_begin_unrealized = sum(begin_unrealized)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id


	insert into
		#summary
	values(
		@contract_id,
		@total_settled_premium,
		@total_unsettled_premium,
		@total_realized,
		@total_fwd_unrealized,
		@total_opt_unrealized,
		@total_end_fwd_unrealized,
		/* @total_fwd_value, TEST */
		@total_opt_value)

	insert into
		#reval_output(
			trade_id,
			trade_date, 
			contract_id,
			underlying_forward_id,
			perspective_contract_id,
			symbol,
			quantity,
			price,
			value_date,
			premium,
			begin_realized,
			end_realized,
			begin_unrealized,
			end_unrealized,
			realized_range,
			unrealized_range,
			ending_valuation,
			settle_price,
			total_pl)
	select
		trade_id,
		trade_date,
		contract_id,
		underlying_forward_id,
		perspective_contract_id,
		symbol,
		quantity,
		price,
		value_date,
		premium,
		begin_realized,
		end_realized,
		begin_unrealized,
		end_unrealized,
		realized_range,
		unrealized_range,
		ending_valuation,
		settle_price,
		realized_range + unrealized_range
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	order by
		symbol,
		value_date,
		trade_date

	select
		@total_pl = sum(realized_range + unrealized_range)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id

	select
		@symbol = symbol
	from
		contracts
	where
		contract_id = @contract_id

	select
		@symbol = "<b>" + rtrim(@symbol) + " Total</b>"

	insert into
		#reval_output(
			symbol,
			premium,
			realized_range,
			begin_unrealized,
			end_unrealized,
			unrealized_range,
			ending_valuation,
			total_pl)
	values(
		@symbol,
		@total_premium,
		@total_realized,
		@total_begin_unrealized,
		@total_end_unrealized,
		/* @total_end_fwd_unrealized, */
		@total_fwd_unrealized + @total_opt_unrealized,
		@total_fwd_value + @total_opt_value,
		@total_pl)
		

	select
		@contracts = count(*)
	from
		#contracts
	where
		id > @id
end
	
create table
	#summary_output(
		id int identity,
		symbol varchar(50),
		settled_premium float,
		unsettled_premium float,
		realized_pl float,
		fwd_unrealized_pl float,
		opt_unrealized_pl float,
		fwd_ending_value float,
		opt_ending_value float)
insert into
	#summary_output(
		symbol,
		settled_premium,
		unsettled_premium,
		realized_pl,
		fwd_unrealized_pl,
		opt_unrealized_pl,
		fwd_ending_value,
		opt_ending_value)
select
	a.symbol,
	b.settled_premium,
	b.unsettled_premium,
	b.realized_pl,
	b.fwd_unrealized_pl,
	b.opt_unrealized_pl,
	b.fwd_ending_value,
	b.opt_ending_value
from
	contracts a,
	#summary b
where
	a.contract_id = b.contract_id
order by
	a.symbol

select
	@total_settled_premium = sum(settled_premium),
	@total_unsettled_premium = sum(unsettled_premium),
	@total_realized = sum(realized_pl),
	@total_fwd_unrealized = sum(fwd_unrealized_pl),
	@total_opt_unrealized = sum(opt_unrealized_pl),
	@total_opt_value = sum(opt_ending_value),
	@total_fwd_value = sum(fwd_ending_value)
from
	#summary
if @total_settled_premium = NULL
	select
		@total_settled_premium = 0.0
if @total_unsettled_premium = NULL
	select
		@total_unsettled_premium = 0.0
if @total_realized = NULL
	select
		@total_realized = 0.0
if @total_fwd_unrealized = NULL
	select
		@total_fwd_unrealized = 0.0
if @total_opt_unrealized = NULL
	select
		@total_opt_unrealized = 0.0
if @total_opt_value = NULL
	select
		@total_opt_value = 0.0
if @total_fwd_value = NULL
	select
		@total_fwd_value = 0.0


insert into
	#summary_output(
		symbol,
		settled_premium,
		unsettled_premium,
		realized_pl,
		fwd_unrealized_pl,
		opt_unrealized_pl,
		fwd_ending_value,
		opt_ending_value)
values(
	"<b>Total</b>",
	@total_settled_premium,
	@total_unsettled_premium,
	@total_realized,
	@total_fwd_unrealized,
	@total_opt_unrealized,
	@total_fwd_value,
	@total_opt_value)

if lower(convert(char(1), @display_output)) = "y"
	select
		symbol,
		settled_premium,
		realized_pl,
		unsettled_premium,
		fwd_unrealized_pl,
		opt_unrealized_pl,
		fwd_end_value = fwd_ending_value,
		opt_end_value = opt_ending_value,
		total_pl = realized_pl + fwd_unrealized_pl + opt_unrealized_pl
	from
		#summary_output
	order by
		id


if lower(convert(char(1), @display_output)) = "y"
	select
		trade_id,
		trade_date,
		symbol,
		quantity,
		exp_date = value_date,
		price,
		settle_price,
		premium,
		realized_pl = realized_range,
		begin_unrealized,
		end_unrealized,
		unrealized_range,
		ending_valuation,
		total_pl
	from
		#reval_output
	order by
		id

select
	@total_pl = sum(realized_range_pl + unrealized_range_pl)
from
	#trades

if lower(convert(char(1), @display_output)) = "y"
	select
		total_pl = @total_pl

