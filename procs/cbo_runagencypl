
if object_id("cbo_runagencypl") != NULL
    drop procedure
        cbo_runagencypl
go

create procedure
	cbo_runagencypl
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@total_pl float output,
		@display_output varchar(10)=NULL
as


declare @start_date datetime
declare @stop_date datetime
declare @evaluation_currency_id int
declare @source_id int
declare @run_id int
declare @fund_id int
declare @total_realized_pl float
declare @fx_realized_pl float
declare @options_realized_pl float
declare @fx_unrealized_pl float
declare @options_unrealized_pl float
declare @pos_pl float
declare @pos_end_evaluation_total float
declare @trades_end_evaluation_total float
declare @trades_pl float
declare @evaluation_currency varchar(20)
declare @source varchar(30)

declare @id int
declare @contract_id int
declare @contracts int
declare @symbol varchar(50)
declare @total_begin_unrealized float
declare @total_end_unrealized float
declare @total_settled_premium float
declare @total_unsettled_premium float
declare @total_premium float
declare @total_realized float
declare @total_fwd_unrealized float
declare @total_end_fwd_unrealized float
declare @total_fwd_realized float
declare @total_opt_unrealized float
declare @total_opt_value float
declare @total_fwd_value float
declare @unrevalued_trades float

if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output

	select
		@start_date = @begin_date,
		@stop_date = @end_date
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@start_date output,
			@stop_date output

	exec
		r_daterangefordate
			@end_date,
			@begin_date output,
			@stop_date output
end


/* This check makes sure all trades are revalued on their trade date */
create table
	#unrevalued_trades(
		status varchar(40) NULL,
		trade_id int,
		bo_trade_date datetime,
		reval_date datetime)
insert into
	#unrevalued_trades(
		trade_id,
		bo_trade_date,
		reval_date)
select
	trade_id,
	min(bo_trade_date),
	min(reval_date)
from
	trade_daily_revals
group by
	trade_id
having
	 convert(date, min(bo_trade_date)) != convert(date, min(reval_date))

select
	@unrevalued_trades = count(*)
from
	#unrevalued_trades
if @unrevalued_trades != 0
begin
	update
		#unrevalued_trades
	set
		status = "Missing Reval"
	
--Adaptive Server has expanded all '*' elements in the following statement
select
		#unrevalued_trades.status, #unrevalued_trades.trade_id, #unrevalued_trades.bo_trade_date, #unrevalued_trades.reval_date
	from
		#unrevalued_trades

	return
end

/*
 * This check makes sure every trade is included in the back office
 */
select
	@unrevalued_trades = count(*)
from
	trades
where
	trade_date >= @start_date
and
	trade_date <= @stop_date
and
	trade_id not in(
		select
			distinct(trade_id)
		from
			trade_daily_revals)
if @unrevalued_trades != 0
begin
	select
		status = "Error",
		message = "Not all trades for this date range have been revalued",
		begin_date = @start_date,
		end_date = @stop_date
	return
end


		


if lower(convert(char(1), @display_output)) = "y"
	exec
		cbo_plstatementlinks
			@login
exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

select
	@evaluation_currency_id = evaluation_currency_id,
	@source_id = source_id
from
	run_defaults
where
	run_id = @run_id
if @evaluation_currency_id = NULL
begin
	select
		@evaluation_currency_id = evaluation_currency_id,
		@source_id = source_id
	from
		fund_run_defaults
	where
		fund_id = @fund_id

	if @evaluation_currency_id = NULL
	begin
		select
			id = -1,
			error = "Unable to determine default run settings"
		return
	end
end


