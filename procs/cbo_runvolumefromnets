drop procedure
	cbo_runvolumefromnets
go

create procedure
	cbo_runvolumefromnets
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @start_date datetime
declare @stop_date datetime
declare @evaluation_currency_id int
declare @fund_id int
declare @run_id int
declare @source_id int
declare @total_volume float
declare @trade_count float
declare @avg_ticket_size float

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"trades_file",
	"Run Trades File",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"volume",
	"Number",
	"#,##0.00")
insert into
        #meta
values(
        "Column Format",
        "avg_ticket_size",
        "Number",
        "#,##0.00")

insert into
        #meta
values(
        "Column Format",
        "native_volume",
        "Number",
        "#,##0.00")


select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id,
	@source_id = source_id
from
	fund_run_defaults
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end



create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id 
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties


create table
	#daily_trade_nets(
		daily_trade_net_id int,
		trade_date datetime,
		trade_type_id int,
 		internal_account_id int,
 		external_account_id int,
 		counterparty_id int,
 		contract_id int,
 		value_date datetime,
 		fixing_date datetime NULL,
 		trader_id int,
 		strategy_id int,
 		broker_id int,
 		sales_code_id int,
		direction int,
		quantity numeric(30, 4),
		avg_price float,
		trade_count int,
		volume numeric(30, 4) NULL,
                volume_adjustment numeric(30, 4) NULL,
		adjusted_count int NULL
)

insert into
	#daily_trade_nets(
		daily_trade_net_id,
		trade_date,
		trade_type_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		contract_id,
		value_date,
		fixing_date,
		trader_id,
		strategy_id,
		broker_id,
		sales_code_id,
		direction,
		quantity,
		avg_price,
		trade_count,
		volume,
		volume_adjustment,
		adjusted_count)
select
        b.daily_trade_net_id,
        b.trade_date,
        b.trade_type_id,
        b.internal_account_id,
        b.external_account_id,
        b.counterparty_id,
        b.contract_id,
        b.value_date,
        b.fixing_date,
        b.trader_id,
        b.strategy_id,
        b.broker_id,
        b.sales_code_id,
        b.direction,
        b.quantity,
        b.avg_price,
        b.trade_count,
        b.volume,
        b.volume_adjustment,
        b.adjusted_count
from
	daily_trade_nets b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g,
	#counterparties h
where
	b.trade_date >= @begin_date
and
	b.trade_date <= @end_date
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.broker_id = g.broker_id
and
	b.counterparty_id = h.counterparty_id


create table
	#contract(
		symbol varchar(50),
		trade_count float NULL,
	 	native_volume float NULL,	
		volume float NULL)


insert into
	#contract
select
	a.symbol,
	trade_count = sum(b.trade_count),
	native_volume=sum(abs(b.quantity)),
	volume = sum(b.volume)
from
	contracts a,
	#daily_trade_nets b
where
	a.contract_id = b.contract_id
group by
	a.symbol
order by
	a.symbol

declare @total_notional_volume float

select
	@total_volume = sum(volume),
	@total_notional_volume = sum(native_volume),
	@trade_count = sum(trade_count)
from
	#contract

insert into
	#contract
values(
	"Total",
	@trade_count,
	@total_notional_volume,
	@total_volume)

select * from #contract

create table
	#broker(
		broker varchar(50),
		trade_count float NULL,
		volume float NULL)
insert into
	#broker
select
	a.symbol,
	trade_count = sum(b.trade_count),
	volume = sum(b.volume)
from
	brokers a,
	#daily_trade_nets b
where
	a.broker_id = b.broker_id
group by
	a.symbol
order by
	a.symbol

select
	@total_volume = sum(volume),
	@trade_count = sum(trade_count)
from
	#broker
insert into
	#broker
values(
	"Total",
	@trade_count,
	@total_volume)

select * from #broker


create table
	#external_account(
		external_account varchar(50),
		trade_count float NULL,
		avg_ticket_size float NULL,
		volume float NULL)
insert into
	#external_account
select
	external_account=a.symbol,
	trade_count = sum(b.trade_count),
	NULL,
	volume = sum(b.volume)
from
	external_accounts a,
	#daily_trade_nets b
where
	a.external_account_id = b.external_account_id
group by
	a.symbol
order by
	a.symbol

update
	#external_account
set
	avg_ticket_size =  (volume/trade_count)
from
	#external_account

select 
	@total_volume = sum(volume),
	@trade_count = sum(trade_count)
from
	#external_account

select
	@avg_ticket_size = @total_volume/@trade_count
insert into
	#external_account
values(
        "Total",
	@trade_count,
	@avg_ticket_size,
        @total_volume)

select * from #external_account
	

create table
	#counterparty(
		counterparty varchar(50),
		trade_count float NULL,
		avg_ticket_size float NULL,
		volume float NULL)
insert into
	#counterparty
select
	a.name,
	trade_count = sum(b.trade_count),
	NULL,
	volume = sum(b.volume)
from
	counterparties a,
	#daily_trade_nets b
where
	a.counterparty_id = b.counterparty_id
group by
	a.name
order by
	a.name

update
        #counterparty
set
        avg_ticket_size =  (volume/trade_count)
from
        #counterparty


select
	@total_volume = sum(volume),
	@trade_count = sum(trade_count)
from
	#counterparty

select
        @avg_ticket_size = @total_volume/@trade_count


insert into
	#counterparty
values(
	"Total",
	@trade_count,
	@avg_ticket_size,
	@total_volume)

select * from #counterparty

create table
        #trader(
                trader varchar(50),
		trade_count float NULL,
		avg_ticket_size float NULL,
                volume float NULL)
insert into
        #trader
select
        trader=a.symbol,
	trade_count = sum(b.trade_count),
	NULL,
        volume = sum(b.volume)
from
        traders a,
        #daily_trade_nets b
where
        a.trader_id = b.trader_id
group by
        a.symbol
order by
	a.symbol

update
        #trader
set
        avg_ticket_size =  (volume/trade_count)
from
        #trader


select
        @total_volume = sum(volume),
	@trade_count = sum(trade_count)
from
	#trader

select
        @avg_ticket_size = @total_volume/@trade_count

insert into
	#trader
values(
        "Total",
	@trade_count,
	@avg_ticket_size,
        @total_volume)

select * from #trader

create table
	#trade_type(
		trade_type varchar(50),
		trade_count float NULL,
		volume float NULL)
insert into
	#trade_type
select
	a.name,
	trade_count = sum(b.trade_count),
	volume = sum(b.volume)
from
	trade_types a,
	#daily_trade_nets b
where
	a.trade_type_id = b.trade_type_id
group by
	a.name
order by
	a.name

select
	@total_volume = sum(volume),
	@trade_count = sum(trade_count)
from
	#trade_type
insert into
	#trade_type
values(
	"Total",
	@trade_count,
	@total_volume)

select * from #trade_type


