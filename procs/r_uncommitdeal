use
	risk_cfe
go

drop procedure
	r_uncommitdeal
go

create procedure
	r_uncommitdeal
		@login varchar(50),
		@deal_id int
as


declare @status_id int
declare @user_review_status_id int
declare @begin_date datetime
declare @end_date datetime
declare @timestamp datetime

select
	@user_review_status_id = status_id
from
	statuses
where
	name = "User Review"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "User Review status not found"
	return
end


select
	@status_id = a.status_id,
	@timestamp = a.timestamp
from
	deals a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Committed"
and
	a.deal_id = @deal_id
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Deal status is not committed. Cannot uncommit deal"
	return
end

exec
	r_daterangefordate
		@timestamp,
		@begin_date output,
		@end_date output

select
	@end_date = convert(datetime, convert(char(11), @end_date, 1))

update
	deals
set
	status_id = @user_review_status_id
where
	deal_id = @deal_id

exec
	r_assigntrades
		@login = @login,
		@trade_date = @end_date,
		@deal_status = "Committed"

go
