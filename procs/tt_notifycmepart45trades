create or replace procedure
	tt_notifycmepart45trades
		@mtm_source varchar(50),
		@intraday_source varchar(50),
		@source varchar(50),
		@trade_date datetime=NULL,
		@query_options char(1)=NULL,
		@query_exotics char(1)=NULL,
		@query_futures char(1)=NULL,
		@format_swaps char(1)=NULL,
		@format_ndf_swaps char(1)=NULL,
		@mark_to_market char(1)=NULL
as



declare @source_id int
declare @cancelled_count int
declare @traiana_id_prefix varchar(15)
declare @netlink_broker_id int
declare @boa_pb_id int
declare @manual_tally_broker_id int
declare @usi_lookup varchar(25)
declare @min_trade_id int

declare @ruble_conversion varchar(10)
declare @update_ruble_trades varchar(10)
declare @intraday_source_id int
declare @mtm_source_id int
declare @valuation_date datetime

declare @begin_date datetime
declare @end_date datetime




if @trade_date = NULL
	select
		@trade_date = getdate()

select
	@trade_date = convert(date, @trade_date)
exec 
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output
select
	@valuation_date = convert(char(8), @trade_date, 112) +' 17:00'



select
	@usi_lookup = usi_prefix
from
	usi_lookup

select
        @netlink_broker_id = broker_id
from
        brokers
where
        symbol = "Netlink"

select
        @manual_tally_broker_id = broker_id
from
        brokers
where
        symbol = "MPT Tally"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

select
        @intraday_source_id = source_id
from
        sources
where
        name = @intraday_source
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Intraday Source not found",
                source = @intraday_source
        return
end

select
        @mtm_source_id = source_id
from
        sources
where
        name = @mtm_source
if @@rowcount != 1
begin
        select
                id = -1,
                error = "MTM Source not found",
                source = @mtm_source
        return
end

