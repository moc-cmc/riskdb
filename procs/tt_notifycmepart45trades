create table
	#trade_notifications(
		trade_notification_id int,
		trade_id int,
		source_id int,
		status_id int,
		capture_date datetime
		)


declare @active_status_id int
declare @edit_status_id int
declare @cancelled_status_id int
declare @cancelling_src_status_id int

select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
select
        @edit_status_id = status_id
from
        statuses 
where
        name = "Edit"
select
        @cancelled_status_id = status_id
from
        statuses 
where
        name = "Cancelled"

select
	@min_trade_id = min(trade_id)
from
	trades
where
	value_date >= @trade_date
and 
	trade_date >= @begin_date
and
	trade_date < @end_date
/*
| Insert into #trade_notifications anything with status_id "Active", "Edit", "Cancelled"
*/
insert into
        #trade_notifications
select
        a.trade_notification_id,
        a.trade_id,
        a.source_id,
        a.status_id,
	a.capture_date
from
        trade_notifications a,
        statuses b
where
        a.status_id = b.status_id
and
        b.name in("Sent")
and
        a.source_id = @intraday_source_id
and
	a.trade_id >= @min_trade_id


/*
| Insert *_ids into #trades that need to be notified 
*/
insert into
	#trades
(
	trade_id,
	deal_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	trader_id,
	counterparty_id,
	fund_agency_trade,
	contract_id,
	broker_id,
	quantity,
	trade_date,
	value_date,
	fixing_date,
	db_price,
	std_price,
	spot_reference,
	sales_code_id,
	strategy_id,
	identifier,
	trade_status_id,
	trade_notification_id,
	notification_status_id,
	notification_source_id,
	notification_source,
	abs_qty,
	cl_or_lp,
	abs_counter_qty,
        user_id,
	capture_date
)
select 
	trade_id = a.trade_id,
	deal_id = a.deal_id,
	trade_type_id = a.trade_type_id,
	internal_account_id = a.internal_account_id,
	external_account_id = a.external_account_id,
	trader_id = a.trader_id,
	counterparty_id = a.counterparty_id,
        fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	quantity = a.quantity,
	trade_date = a.trade_date,
	value_date = convert(varchar(12), a.value_date, 112),
	fixing_date = convert(varchar(12), a.fixing_date, 112),
	db_price = a.price,
	std_price = a.price,
	spot_reference = a.spot_reference,
	sales_code_id = a.sales_code_id,
	strategy_id = a.strategy_id,
	identifier = a.identifier,
	trade_status_id = a.status_id,
	trade_notification_id = b.trade_notification_id,
	notification_status_id = b.status_id,
	notification_source_id = @source_id,
	notification_source = @source,
	abs_qty = abs(a.quantity),
	cl_or_lp = "LP",
	abs_counter_qty = round(abs(a.quantity) * a.price, 2),
        user_id = a.user_id,
	capture_date = b.capture_date
from
	trades a,
	#trade_notifications b
where
	a.trade_id=b.trade_id
and
	a.price != 0
and
	a.trade_id >= @min_trade_id
and
	a.value_date >= @trade_date
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

create unique nonclustered index
        tmp_tid
on
        #trades(trade_id)

update
	#trades
set
	mtm = b.mtm,
	mtm_identifier = b.identifier
from
	#trades a,
	trade_mtms b
where
	a.trade_id = b.trade_id
and
	b.trade_id >= @min_trade_id
and
	b.source_id = @mtm_source_id
and
	b.trade_date = @valuation_date /* must be a 5pm timestamp on trade_date mtm */



create table 
	#trade_edits
(
	trade_id int,
	quantity numeric(30, 2),
        price float,
	timestamp datetime
)
insert into
	#trade_edits
select
	b.trade_id,
	b.quantity,
	b.price,
	b.timestamp
from
	#trades a,
	trade_edits b
where
	a.trade_id = b.trade_id
and
	a.notification_status_id = @cancelled_status_id
and
	b.trade_id >= @min_trade_id
if @@rowcount > 0
begin
	/* chriso: on cancel, this allows us to get the qty prior to edit. there may have been multiple edits
		   to avoid a loop, doing the below subquery */
	update
		#trades
	set
		quantity = b.quantity,
		abs_qty = abs(b.quantity),
		abs_counter_qty = abs(b.quantity) * b.price
	from
		#trades a,
		#trade_edits b
	where
		a.trade_id = b.trade_id
	and
		b.timestamp = (select max(c.timestamp) from #trade_edits c where c.trade_id = b.trade_id)
end


/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    std_price = case 
        when d.name = "Inverted" and c.factor != NULL and a.db_price != 0 then
            (1 / a.db_price) * c.factor * d.factor
        when d.name = "Inverted" and a.db_price != 0 then
            (1 / a.db_price) * d.factor
        when c.factor != NULL then
            a.db_price * c.factor * d.factor
        else
            a.db_price * d.factor
    end
from
    #trades a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id

if @format_swaps = "Y"
begin

	create table
		#swap_symbol_trades(
			trade_id int,
			swap_symbol varchar(50))
	insert into
		#swap_symbol_trades
	select
		a.trade_id,
		c.symbol
	from
		#trades a,
		swap_symbol_trades b,
		swap_symbols c
	where
		a.trade_id = b.trade_id
	and
		b.swap_symbol_id = c.swap_symbol_id
	and
		b.trade_id >= @min_trade_id
        

        /* chriso: citibank can not process NDF swaps, so if a swap has a fixing date, dont handle as a formatted swap */
	if @format_ndf_swaps = "N"
        begin
		create table
			#remove_swaps(
				swap_symbol varchar(50)
			)
		insert into
			#remove_swaps
		select
			a.swap_symbol 
		from
			#swap_symbol_trades a,
			#trades b
		where
			a.trade_id = b.trade_id
		and
			b.fixing_date != NULL

		/* Join on swap symbol to ensure both legs are removed if 1 does not have a fixing date */
		delete from
			#swap_symbol_trades
		where
			swap_symbol in(select swap_symbol from #remove_swaps)
		
	end

	create table
        	#near_swap_trades(
                	trade_id int,
                	swap_symbol varchar(50))
	create table
        	#far_swap_trades(
                	trade_id int,
                	swap_symbol varchar(50),
                	far_quantity float,
			far_price float,
			far_value_date datetime,
			far_fixing_date datetime NULL,
			trade_notification_id int NULL,
			near_trade_id int NULL,
			far_tr_usi varchar(40) NULL,
			external_account_id int,
			far_db_price float)
	insert into
        	#near_swap_trades
	select
        	a.trade_id,
        	c.symbol
	from
        	#trades a,
        	#swap_symbol_trades b,
        	swap_symbols c,
        	trade_types d
	where
        	a.trade_id = b.trade_id
	and
        	b.swap_symbol = c.symbol
	and
		a.trade_type_id = d.trade_type_id
	and
        	d.name = "Swap Near"

	
	insert into
        	#far_swap_trades
	select
        	a.trade_id,
        	c.symbol,
		a.abs_qty,
		a.std_price,
		a.value_date,
		a.fixing_date,
		a.trade_notification_id,
		NULL,
		NULL,
		a.external_account_id,
		a.db_price
	from
        	#trades a,
        	#swap_symbol_trades b,
        	swap_symbols c,
		trade_types d
	where
        	a.trade_id = b.trade_id
	and
        	b.swap_symbol = c.symbol
	and
		a.trade_type_id = d.trade_type_id
	and
        	d.name = "Swap Far"

        update
		#far_swap_trades
	set
		far_tr_usi = rtrim(@usi_lookup)+rtrim(convert(varchar(15), a.trade_id))
	from
		#far_swap_trades a,
		reg_reporting_ext_accounts b
	where
		a.external_account_id = b.external_account_id

	update
		#far_swap_trades
	set
		near_trade_id = a.trade_id
	from
		#near_swap_trades a,
		#far_swap_trades b
	where
		a.swap_symbol = b.swap_symbol


	
	update
        	#trades
	set
        	far_quantity = a.far_quantity,
        	far_price = a.far_price,
        	far_value_date = a.far_value_date,
        	far_fixing_date = a.far_fixing_date,
		far_trade_notification_id = a.trade_notification_id,
		far_tr_usi = a.far_tr_usi,
        	abs_far_qty = abs(a.far_quantity),
                abs_far_counter_qty = round((abs(a.far_quantity) * a.far_db_price), 2)
	from
        	#far_swap_trades a,
        	#trades c
	where
        	a.near_trade_id = c.trade_id
	
	
	delete from
        	#trades
	from
        	#trades a,
        	#far_swap_trades b
	where
        	a.trade_id = b.trade_id

	/* TRML Spec says no fixing date to report on swaps */
	if @source like "%Traiana FTP%"
	begin
        	update
			#trades
		set
			fixing_date = NULL,
			far_fixing_date = NULL
		from
			#trades a,
			#swap_symbol_trades b
		where
			a.trade_id = b.trade_id
	end

end
else
begin
	update 
		#trades
	set
		swap_symbol = c.symbol
        from
                #trades a,
                swap_symbol_trades b,
                swap_symbols c
        where
                a.trade_id = b.trade_id
        and
                b.swap_symbol_id = c.swap_symbol_id
	and
                b.trade_id >= @min_trade_id
end
	
