
create or replace procedure
	api_resendnotification
		@login varchar(50),
		@trade_id int,
		@source varchar(50),
		@send_as varchar(40)
as


declare @source_id int
declare @status_id int
declare @status varchar(50)
declare @message varchar(100)
declare @trade_notification_id int


select
	@source_id = source_id
from	
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source for notification"
	return
end

if @send_as = "NEW"
	select
		@status_id = status_id
	from		
		statuses
	where
		name = "Active"

if @send_as = "MODIFY"
        select
                @status_id = status_id
        from    
                statuses
        where
                name = "Edit"

if @send_as = "DELETE"
        select
                @status_id = status_id
        from    
                statuses
        where
                name = "Cancelled"

select
	@trade_notification_id = trade_notification_id
from
	trade_notifications
where
	trade_id = @trade_id
and
	source_id = @source_id


if @trade_notification_id = NULL
begin
	exec
		r_inserttradenotification
			@trade_id = @trade_id
	select
		@status = "Success",
		@message = "Added new notification for trade "+ convert(varchar(40), @trade_id) + "and disregarded 'send as'"
end
else
begin
	begin tran
		update
			trade_notifications
		set
			status_id = @status_id,
			error = "Resend "+ rtrim(@login)+" "+rtrim(NEWID())
		where
			trade_id = @trade_id 
		and
			source_id = @source_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				messasge = "Problem updating notification for trade ID " +  convert(varchar(40), @trade_id) + " for source " + @source
			rollback tran
			return
		end
	commit tran

	select
		@status = "Success",
		@message = "Queued trade ID  " +  convert(varchar(40), @trade_id) + " to be sent as " + @send_as + " for source " + @source
end

select
	status = @status,
	message = @message


go 

