create or replace procedure
	ag_legalentitieshome
		@login varchar(50),
		@legal_entity varchar(255)=NULL
as

declare @fund_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @legal_entity_id int
declare @default_user_pool varchar(100)
declare @legal_entity_status varchar(50)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"add_legal_entity",
	"Add Legal Entity",
	NULL) 

insert into
        #meta
values(
        "Column Link",
        "add_outside_account",
        "Add Outside Account",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "add_provider",
        "Add Provider",
        NULL)

insert into
        #meta
values( 
        "Column Link",
        "add_bo_account",
        "Add BO Account",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "add_fo_sub_account",
        "Add FO Sub Account",
        NULL)

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"leid",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Link",
        "view_entity",
        "Legal Entities Home",
        NULL)

insert into
	#meta
values( 
        "Column Hidden",
        "legal_entity",
	NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "user_pool",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "mfa_login",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "add_user",
        "Add Legal Entity User",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "remove_user",
        "Remove Legal Entity User",
        NULL)

insert into
        #meta
values( 
        "Column Link",
        "permissions",
        "View User Permissions",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "enable_login",
        "Enable MFA Access",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "disable_login",
        "Disable MFA Access",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "approve_setup",
        "Approve Legal Entity Setup",
        NULL)



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

select
	style = @style,
	legal_entity = @legal_entity,
	add_legal_entity = "Add Legal Entity",
	add_provider = "Add Provider" /*,
	add_user = "Add Legal Entity User"
	add_outside_account = "Add Outside Account",
	add_bo_account = "Add BO Account",
	add_fo_sub_account = "Add FO Sub Account" */


create table
	#legal_entities(
		legal_entity_id int,
		name varchar(255),
		lei varchar(100) NULL,
		approval_count int NULL,
		approve_setup varchar(10) NULL,
		status_id int NULL,
		status varchar(50) NULL,
		section varchar(50) NULL,
		style varchar(50) NULL)

insert into
	#legal_entities(
		legal_entity_id,
		name,
		lei,
		approve_setup,
		status_id,
		section,
		style)
select
	legal_entity_id,
	name,
	lei,
	NULL,
	status_id,	
	section = "Legal Entities",
	style = @style
from
	legal_entities
order by
	name


update
	#legal_entities
set
	status = b.name
from
	#legal_entities a,
	statuses b
where
	a.status_id = b.status_id


update
	#legal_entities
set
	style = @selected_style,
	approve_setup = "Approve"
where
	name = @legal_entity

create table
	#le_approvals(
		legal_entity_id int,
		approval_count int NULL
)
insert into
	#le_approvals(
		legal_entity_id,
		approval_count)
select
	legal_entity_id,
	count(*)
from
	legal_entity_approvals
group by
	legal_entity_id

update
        #legal_entities
set
        approval_count = b.approval_count
from
        #legal_entities a,
        #le_approvals b
where
	a.legal_entity_id = b.legal_entity_id

update
	#legal_entities
set
	approve_setup = NULL
where
	status = "Approved"


select
	section,
	style,
	legal_entity = name,
	entity = name,
	approval_count = approval_count,
	approve_setup = approve_setup,
	status = status,
	lei = lei,
	add_outside_account = "Add Outside Account",
        add_bo_account = "Add BO Account",
	add_user = "Add User",
	view_entity = "VIEW"
from
	#legal_entities


if @legal_entity_id = NULL
begin
	/* 
         * EXIT THE PROC SINCE WE DO NOT NEED TO SHOW ANY DETAIL
         * ---------------------------------------------------------*/
	return
end


select
	@legal_entity_status = status
from
	#legal_entities
where
	legal_entity_id = @legal_entity_id

	
select
	style = @style,
	section = "Outside Accounts",
	"outside_account" = a.name,
	outside_account_type = b.name,
	legal_entity = c.name,
	provider = d.name,
	account_instructions = "VIEW"
from
	outside_accounts a,
	outside_account_types b,
	legal_entities c,
	providers d
where
	a.outside_account_type_id = b.outside_account_type_id
and
	a.legal_entity_id = c.legal_entity_id
and
	a.provider_id = d.provider_id
and
	a.legal_entity_id = @legal_entity_id
order by
	a.name
	
select
	style = @style,
	section = "Back Office Master Accounts",
	b.symbol,
	b.name,
	legal_entity = c.name,
	add_fo_sub_account = "Add FO Sub Account"
from
	bo_master_accounts a,
	external_accounts b,
	legal_entities c
where
	a.external_account_id =  b.external_account_id
and
	a.legal_entity_id = c.legal_entity_id
and
	c.legal_entity_id = @legal_entity_id

select
	style = @style,
	section = "Front Office Sub Accounts",
	master_account = d.symbol,
	b.symbol,
	b.name
from
	fo_sub_accounts a,
	external_accounts b,
	bo_master_accounts c,
	external_accounts d
where
	a.external_account_id = b.external_account_id
and
	a.bo_master_account_id = c.bo_master_account_id
and
	c.external_account_id = d.external_account_id
and
	c.legal_entity_id = @legal_entity_id


select
	@default_user_pool = a.name
from
	cognito_user_pools a,
	cognito_settings b
where
	a.cognito_user_pool_id = b.default_user_pool_id

create table
	#le_users(
		legal_entity_id int,
		tico_account_id int,
		first_name varchar(50),
		last_name varchar(50),
		user_name varchar(100),
		login_status varchar(50) NULL,
		enable_login varchar(50) NULL,
		disable_login varchar(50) NULL,
		create_date datetime NULL,
		last_updated datetime NULL
)

insert into 
	#le_users
select
	a.legal_entity_id,
	c.account_id,	
	c.surname,
	c.given_names,
	c.login,
	login_status = "Pending",
	enable_login = "ENABLE ACCESS",
	disable_login = NULL,
	create_date = NULL,
	last_updated = NULL
from
	legal_entities a,
	legal_entity_tico_accounts b,
	tico_accounts c
where
	a.legal_entity_id = b.legal_entity_id
and
	b.tico_account_id = c.account_id
and
	a.legal_entity_id = @legal_entity_id 

update
	#le_users
set
	login_status = c.name,
	enable_login = NULL,
	disable_login = "DISABLE ACCESS",
	create_date = b.create_date,
	last_updated = b.last_modify_date
from
	#le_users a,
	cognito_users b,
	cognito_user_statuses c
where
	a.tico_account_id = b.tico_account_id
and
	b.cognito_user_status_id = c.cognito_user_status_id

if @legal_entity_status != "Approved"
begin
	update
		#le_users
	set
		enable_login = NULL,
		disable_login = NULL
end


select
	style = @style,
	section = "Users",
	legal_entity = @legal_entity,
	first_name,
	last_name,
	user_name,
	login_status,
	enable_login,
	disable_login,
	create_date,	
	last_updated,
	permissions = "VIEW",
	mfa_login = user_name,
	user_pool = @default_user_pool
from
	#le_users



go
