use
	risk_sjmdemo
go

drop procedure
	api_clientdepositreq
go

create procedure
	api_clientdepositreq
		@login varchar(50),
		@product varchar(50),
		@amount float,
		@for_date datetime,
		@from_account varchar(50), /* Outside account */
		@to_account varchar(50), /* BO Master account */
		@to_custodian varchar(50), /* Custodial account (external account type = Counterparty */
		@ledger_request_id int output
as

declare @tico_account_id int
declare @product_id int
declare @outside_account_id int
declare @bo_master_account_id int
declare @custodial_account_id int
declare @ledger_request_type_id int

declare @ledger_request_log_id int
declare @status_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@outside_account_id = outside_account_id
from
	outside_accounts
where
	name = @from_account
if @outside_account_id = NULL
begin
	select
		status = "Error",
		message = "Outside account not found",
		outside_account = @from_account
	return
end

select
	@bo_master_account_id = a.bo_master_account_id
from
	bo_master_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @to_account
if @bo_master_account_id = NULL
begin
	select
		status = "Error",
		message = "BO Master account not found",
		bo_master_account = @to_account
	return
end


select
	@custodial_account_id = a.external_account_id
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Custody"
and
	a.symbol = @to_custodian
if @custodial_account_id = NULL
begin
	select
		status = "Error",
		message = "Custodial account not found",
		custodial_account = @to_custodian
	return
end

select
	@ledger_request_type_id = ledger_request_type_id
from
	ledger_request_types
where
	name = "Deposit"
if @ledger_request_type_id = NULL
begin
	select
		status = "Error",
		message = "Deposit ledger request type not found"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "New"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "New status not found"
	return
end

exec
	j_nextkey
		"ledger_requests",
		@ledger_request_id output
exec
	j_nextkey
		"ledger_request_logs",
		@ledger_request_log_id output

begin tran

	insert into
		ledger_requests(
			ledger_request_id,
			requestor_id,
			outside_account_id,
			bo_master_account_id,
			custodial_account_id,
			ledger_request_type_id,
			product_id,
			amount,
			transaction_date,
			request_date,
			status_id)
	values(
		@ledger_request_id,
		@tico_account_id,
		@outside_account_id,
		@bo_master_account_id,
		@custodial_account_id,
		@ledger_request_type_id,
		@product_id,
		@amount,
		@for_date,
		getdate(),
		@status_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add ledger request",
			product = @product,
			amount = @amount,
			for_date = @for_date,
			from_account = @from_account,
			to_account = @to_account,
			to_custodian = @to_custodian
		rollback tran
		return
	end

	insert into
		ledger_request_logs(
			ledger_request_log_id,
			ledger_request_id,
			user_id,
			timestamp,
			status_id)
	values(
		@ledger_request_log_id,
		@ledger_request_id,
		@tico_account_id,
		getdate(),
		@status_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add ledger request log. Request not tallied",
			product = @product,
			amount = @amount,
			for_date = @for_date,
			from_account = @from_account,
			to_account = @to_account,
			to_custodian = @to_custodian
		rollback tran
		return
	end

commit tran

exec
	r_processledgerrequest
		@login = @login,
		@ledger_request_id = @ledger_request_id


go
