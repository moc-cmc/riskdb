
if object_id("cm_addbrokersymbol") != NULL
    drop procedure
        cm_addbrokersymbol
go

create procedure
	cm_addbrokersymbol
		@login varchar(50),
		@broker varchar(50),
		@source varchar(50),
		@mapping varchar(100)
as


declare @source_id int
declare @broker_id int
declare @mappings int

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Broker not found",
		broker = @broker
	return
end

select
	@mappings = count(*)
from
	broker_symbols
where
	broker_id = @broker_id
and
	source_id = @source_id

if @mappings > 0
begin
	select
		status = "Error",
		message = "Broker is already mapped for mapping source",
		broker= @broker,
		source = @source
	return
end

insert into
	broker_symbols
values(
	@broker_id,
	@source_id,
	@mapping)

exec
	cm_brokermappings
		@login,
		@broker

go
