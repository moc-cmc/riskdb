
if object_id("r_expireoption") != NULL
    drop procedure
        r_expireoption
go

create procedure
	r_expireoption
		@symbol char(100)
as

declare @contract_id int
declare @date datetime
declare @expiration datetime

select
	@date = getdate(),
	@expiration = NULL


exec
	j_contract
		@symbol,
		@contract_id output

select
	@expiration = a.expiration
from
	option_expirations a,
	option_contracts b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.contract_id = @contract_id
if @expiration = NULL
begin
	select
		id = -1,
		error = "Problem finding expiration for contract",
		symbol = @symbol
	return
end

/* if @date < @expiration
begin
	select
		id = -1,
		error = "Option is not expired yet",
		symbol = @symbol,
		expiration = @expiration
	return
end  */

exec
	r_editsettle
		@symbol,
		@expiration,
		0

	
delete

from
	contract_eval_methods
where
	contract_id = @contract_id

delete

from
	current_contract_tvs
where
	contract_id = @contract_id


select
	id = 0,
	msg = "Sucessfully expired option",
	symbol = @symbol

go
