
drop procedure
	r_verifyrunsforallaccts
go

create procedure
	r_verifyrunsforallaccts 
			@account_name varchar(50)

as

create table
	#meta(
        	meta_type char(200),
                name char(30),
                action char(200) NULL,
                value char(255) NULL

)

insert into 
	#meta
values(
	"Column Hidden",
        "account_name",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "grant_access",
        "Grant All Runs For Account",
        NULL
)


select #meta.meta_type, #meta.name,
  #meta.action, #meta.value from #meta


select 
	account_name = @account_name, 
	msg = "Granting access to all runs for account "+ rtrim(@account_name) + " . Are you sure you want to continue?",
	grant_access = "CONTINUE"

go
 
