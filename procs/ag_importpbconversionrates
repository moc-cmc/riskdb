drop procedure
	ag_importpbconversionrates
go

create procedure
	ag_importpbconversionrates
		@login varchar(100),
		@date varchar(50)=NULL,
		@currency1 varchar(50)=NULL,
		@currency2 varchar(50)=NULL,
		@conversion_rate varchar(50)=NULL,
		@prime_broker varchar(50)=NULL,
		@row_index int,
		@row_count int
as

declare @contract_id int
declare @price float
declare @symbol varchar(50)
declare @price_date datetime
declare @bo_spot_settle_id int
declare @source_id int
declare @price_style varchar(50)
declare @inverted_contract_id int
declare @inverted_price float
declare @tico_account_id int
declare @style varchar(250)



if @conversion_rate like "%rate%"
	return

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Format",
	"previous_price",
	"Number",
	 "#,##0.000000000")

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	 "#,##0.000000000")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta


select
	@style = "background:#FFFFFF;border: 1px solid white"

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@source_id = source_id
from
	sources
where
	name = "MPT"
if @source_id = NULL
begin
	select
		status = "Error",
		message = "MPT Source not found"
	return
end

select
	@symbol = rtrim(@currency1) + rtrim(@currency2)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end


select
	@price = convert(float, @conversion_rate),
	@price_date = convert(datetime, convert(date, @date))

select
	@price_date = dateadd(hour, 17, @price_date)

/* MARK: CHECK that this trade date is not being moved back prior to an already committed date */
declare @max_commit_date datetime

select 
	@max_commit_date = max(commit_date) 
from 
	daily_commits a, 
	commit_statuses b 
where 
	a.commit_status_id = b.commit_status_id 
and 
	b.name in("Commit Complete", "Commit Pending", "Commit Requested")


/* CHECK that this trade is not already committed*/
if (@price_date <= convert(datetime, convert(varchar(8),  @max_commit_date, 112)+" 17:00"))
begin
	select
		status = "Error",
		error = "Can not edit or add a conversion rate for a date that is already committed",
		price_date = @price_date,
                max_commit_date = @max_commit_date
                
	return
end

if convert(numeric(30,5), @price) = 0.0
	return

/* r_editpbconversionrate needs standard pairs, so if pair is inverted, reverse the ccys and inverst the price they provided */

declare @is_inverted char(1)

select
	@is_inverted = "Y"
from
	contract_price_styles a,
	price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.name = "Inverted"
and
	a.contract_id = @contract_id

if @is_inverted = "Y"
begin
	select
        	@symbol = rtrim(@currency2) + rtrim(@currency1)

	select
        	@contract_id = contract_id
	from
        	contracts
	where
        	symbol = @symbol
	if @contract_id = NULL
	begin
        	select
                	status = "Error",
                	message = "Standard contract not found",
                	symbol = @symbol
        	return
	end

	select
		@price = 1/@price
end	

exec
        r_editpbconversionrate
                @prime_broker = @prime_broker,
                @symbol = @symbol,
                @price_date = @price_date,
                @price = @price


		
