create or replace procedure
	api_initproduct
		@login varchar(50),
		@symbol varchar(50),
		@name varchar(50),
		@product_id int output
as


declare @product_type_id int
declare @origination_type_id int
declare @decimal_precision int
declare @product_rate_id int
declare @settlement_product_id int
declare @settlement_product varchar(50)
declare @settlement_symbol varchar(50)
declare @contract_id int
declare @instrument_id int
declare @exchange_id int
declare @fund_id int

exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output

select
	@settlement_product_id = settlement_product_id
from
	funds
where
	fund_id = @fund_id
if @settlement_product_id = NULL
begin
	select
		status = "Error",
		message = "Settlement product not found"
	return
end

select
 
	@settlement_product = symbol
from
	products
where
	product_id = @settlement_product_id

select
	@settlement_symbol = rtrim(@settlement_product) + rtrim(@symbol)

select
	@exchange_id = exchange_id
from
	exchanges
where
	name = "OTC"
if @exchange_id = NULL
begin
	select
		status = "Error",
		message = "OTC Exchange not found"
	return
end

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Forward"
if @instrument_id = NULL
begin
	select
		status = "Error",
		message = "Forward instrument not found"
	return
end

exec
	j_nextkey
		"contracts",
		@contract_id output

select
	@product_id = product_id
from
	products
where
	symbol = @symbol
if @product_id != NULL
begin
	select
		status = "Error",
		message = "Symbol already exists",
		symbol = @symbol
	return
end

select
	@product_type_id = product_type_id
from
	product_types 
where
	name = "Currency"
if @product_type_id = NULL
begin
	select
		status = "Error",
		message = "Currency product type not found"
	return
end

select
	@origination_type_id = origination_type_id
from
	origination_types
where
	name = "Digital"
if @origination_type_id = NULL
begin
	select
		status = "Error",
		message = "Digital origination type not found"
	return
end

select
	@decimal_precision = 8

exec
	j_nextkey "products",@product_id output
		
exec
	j_nextkey
		"product_rates",
		@product_rate_id output

begin tran
	insert into
		products(
			product_id,
			product_type_id,
			symbol,
			name,
			decimal_precision,
			origination_type_id)
	values(
		@product_id,
		@product_type_id,
		@symbol,
		@name,
		@decimal_precision,
		@origination_type_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding product",
			symbol = @symbol,
			name = @name
		rollback tran
		return
	end

	insert into
		product_rates(
			product_rate_id,
			product_id,
			rate_date)
	values(
		@product_rate_id,
		@product_id,
		"8/8/88")
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add product rate",
			symbol = @symbol,
 			name = @name
		rollback tran
		return
	end

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
		@product_rate_id,
		0,
		0.0)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add product rate point",
			symbol = @symbol,
			name = @name
		rollback tran
		return
	end

	insert into
		contracts(
			contract_id,
			symbol,
			instrument_id)
	values(
		@contract_id,
		@settlement_symbol,
		@instrument_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add contract",
			settlement_symbol = @settlement_symbol
		rollback tran
		return
	end

	insert into
		forwards(
			contract_id,
			currency_id,
			product_id,
			quantity,
			exchange_id)
	values(
		@contract_id,
 		@product_id,
		@settlement_product_id,
		1,
		@exchange_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add forward",
			settlement_symbol = @settlement_symbol
		rollback tran
		return
	end

commit tran

go

