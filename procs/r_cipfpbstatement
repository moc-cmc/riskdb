create table
	#conversion_rates(
		product_id int,
		evaluation_currency_id int NULL,
		begin_rate float NULL,
		end_rate float NULL,
		contract_id int NULL,
		inverted_contract_id int NULL,
		begin_display_rate float NULL,
		end_display_rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	distinct(product_id)
from
	#all_products 

update
	#conversion_rates
set
	evaluation_currency_id = @evaluation_currency_id

update
	#conversion_rates
set
	begin_rate = 1.0,
	end_rate = 1.0
where
	product_id = evaluation_currency_id

update
	#conversion_rates
set
	a.begin_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	a.evaluation_currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @begin_date)

update
	#conversion_rates
set
	a.begin_rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	a.evaluation_currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @begin_date)
and
	a.begin_rate = NULL

update
	#conversion_rates
set
	a.end_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	a.evaluation_currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#conversion_rates
set
	a.end_rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	a.evaluation_currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.end_rate = NULL

update
	#conversion_rates
set
	a.contract_id = b.contract_id
from
	#conversion_rates a,
	forwards b
where
	a.product_id = b.product_id
and
	a.evaluation_currency_id = b.currency_id

update
	#conversion_rates
set
	a.inverted_contract_id = b.contract_id
from
	#conversion_rates a,
	forwards b
where
	a.product_id = b.currency_id
and
	a.evaluation_currency_id = b.product_id

update
	#conversion_rates
set
	begin_display_rate = begin_rate,
	end_display_rate = end_rate

update
	#conversion_rates
set
	a.begin_display_rate = 1.0 / a.begin_display_rate,
	a.end_display_rate = 1.0 / a.end_display_rate
from
	#conversion_rates a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"



/* Calc our begin balance equivs */

update
	#begin_balances
set
	equiv = a.balance * b.end_rate
from
	#begin_balances a,
	#conversion_rates b
where
	a.product_id = b.product_id

	
/* Fetch all the trades */



update
	#trades
set
	a.display_price = 1.0 / a.display_price
from
	#trades a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
and
	a.display_price != 0.0

update
	#trades
set
	product_qty = a.quantity,
	currency_qty = a.quantity * a.price * -1.0 * b.quantity
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#trades
set
	a.symbol = b.symbol
from
	#trades a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#trades
set
	a.product_equiv = a.product_qty * b.end_rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id


update
	#trades
set
	a.currency_equiv = a.currency_qty * b.end_rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id


create table
	#pair_balances(
		id int identity,
		ordering int,
		style varchar(100),
                contract_id int NULL,
                quantity float NULL,
                symbol varchar(50) NULL,
                product_id int NULL,
                currency_id int NULL,
                price float NULL,
                value_date datetime NULL,
                product_qty float NULL,
                product_equiv float NULL,
                currency_qty float NULL,
                currency_equiv float NULL,
                display_price float NULL,
                mtm float NULL
                )

insert into
	#pair_balances(
		ordering,
		style,
		contract_id,
		product_id,
		currency_id,
		value_date,
		quantity,
		product_qty,
		currency_qty,
		product_equiv,
		currency_equiv)
select
	1,
	@style,
        a.contract_id,
        a.product_id,
        a.currency_id,
        a.value_date,
	sum(a.product_qty),
	sum(a.product_qty),
	sum(a.currency_qty),
	sum(a.product_equiv),
	sum(a.currency_equiv)
from
	#trades a
where
	a.value_date > @end_date
group by
	a.contract_id,
        a.product_id,
        a.currency_id,
        a.value_date

update
	#pair_balances
set
	symbol = a.symbol
from
	contracts a,
	#pair_balances b
where
	a.contract_id = b.contract_id

update
	#pair_balances
set
	price = currency_qty/product_qty
where
	product_qty != 0

update
	#pair_balances
set
	mtm = product_equiv + currency_equiv

insert into
	#pair_balances(
		ordering,
		style,
		symbol,
		mtm)
select
	2,
	@total_style,
	"Total",
	sum(mtm)
from
	#pair_balances





