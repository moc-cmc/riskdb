create table
	#begin_balances(
		product_id int,
		balance numeric(30, 8) NULL,
		equiv numeric(30, 8) NULL)
insert into
	#begin_balances(
		product_id,
		balance)
select
	a.currency_id,
	sum(convert(numeric(30, 8), floor(abs(a.amount) * 100000000) / 100000000 ) * sign(a.amount))
from
	account_transactions a,
	products b,
	#external_accounts c
where
	a.currency_id = b.product_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_date < @begin_date
group by
	a.currency_id


create table
	#account_transactions(
		account_transaction_id int,
		entered_by int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		currency_id int,
		amount numeric(30,8),
		note varchar(250) NULL)
insert into
	#account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount,
		note)
select
	a.account_transaction_id,
	a.entered_by,
	a.external_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.currency_id,
	convert(numeric(30, 8), floor(abs(a.amount) * 100000000) / 100000000 ) * sign(a.amount),
	a.note
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	transaction_date >= @begin_date
and
	transaction_date < @end_date



/* Get transaction data */

update
	#account_transactions
set
	a.amount = convert(numeric(30, 2), floor(abs(a.amount) * 100) / 100 ) * sign(a.amount)
from
	#account_transactions a,
	products b
where
	a.currency_id = b.product_id


create table
	#trades(
		trade_id int,
