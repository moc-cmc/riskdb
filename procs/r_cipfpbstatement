		external_account_id int,
		prime_broker_id int NULL,
		margin_multiplier float NULL,
		quantity float,
		contract_id int,
		symbol varchar(50) NULL,
		product_id int,
		currency_id int,
		price float,
		value_date datetime,
		fixing_date datetime NULL,
		counterparty_id int, 
 		lp_transparency varchar(5) NULL,
		counterparty varchar(50) NULL,
		margin float NULL,
		product_qty float NULL,
		product_equiv float NULL,
		currency_qty float NULL,
		currency_equiv float NULL,
		buy_sell varchar(5) NULL, 
 		display_price float NULL,
		reval_counter_qty float NULL,
		reval_price_db float NULL,
		reval_price_std float NULL,
		discount_factor float NULL,
		mtm float NULL,
		entry_type char(1) NULL /* G for giveup, O for offset*/
		)
insert into
	#trades(
		trade_id,
		deal_id, 
 		trade_type_id,
		trade_date,
		external_account_id,
		quantity,
		contract_id,
		product_id,
		currency_id,
		price,
		value_date,
		fixing_date,
		counterparty_id,
		display_price,
		entry_type)
select
	a.trade_id,
	a.deal_id,
	a.trade_type_id,
	a.trade_date,
	a.external_account_id,
	a.quantity,
	a.contract_id,
	b.product_id,
	b.currency_id,
	a.price,
	a.value_date,
	a.fixing_date,
	a.counterparty_id, 
	a.price,
        "G"
from
	trades a,
	forwards b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g,
	#counterparties h
where
	a.external_account_id = c.external_account_id
and
	a.internal_account_id = d.internal_account_id
and
	a.trader_id = e.trader_id
and
	a.strategy_id = f.strategy_id
and
	a.broker_id = g.broker_id
and
	a.counterparty_id = h.counterparty_id
and
	a.contract_id = b.contract_id
and
	a.value_date >= @begin_date
and
	a.trade_date < @end_date


