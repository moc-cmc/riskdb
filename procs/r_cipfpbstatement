		transaction_date datetime NULL,
		amount numeric(30, 8) NULL,
		balance numeric(30,8) NULL)
select
	@id = 0
select
	@ids = count(*)
from
	#ordered_products
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ordered_products
	where
		id > @id

	select
		@product_id = NULL,
		@product = NULL,
		@begin_balance = NULL,
		@end_balance = NULL
	
	select
		@product_id = product_id
	from
		#ordered_products
	where
		id = @id

	select
		@product = symbol
	from
		products
	where
		product_id = @product_id

	select
		@begin_balance = balance
	from
		#begin_balances
	where
		product_id = @product_id
	if @begin_balance = NULL
		select
			@begin_balance = 0.0

	insert into
		#ledger(
			style,
			prod)
	values(
		@total_style,
		@product)

	insert into
		#ledger(
			style,
			transaction_type,
			transaction_date,
			product,
			balance)
	values(
		@total_style,
		"Beginning balance",
		@begin_date,
		@product,
		@begin_balance)

	insert into
		#ledger(
			style,
			external_account_id,
			account,
			product_id,
			product,
			account_transaction_id,
			transaction_type_id,
			transaction_type,
			transaction_date,
			amount,
			balance)
	select
		style = @style,
		external_account_id = c.external_account_id,
		account = c.symbol,
		a.currency_id,
		product = @product,
		a.account_transaction_id,
		a.transaction_type_id,
		b.name,
		a.transaction_date,
		a.amount,
		balance = 0.0
	from
		#account_transactions a,
		transaction_types b,
		#external_accounts c
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.external_account_id = c.external_account_id
	and
		a.currency_id = @product_id
	order by
		a.transaction_date,
		a.account_transaction_id

	select
		@xact_id = 0
	select
		@xacts = count(*)
	from
		#ledger
	where
		product_id = @product_id
	and
		id > @xact_id

	select
		@running_balance = @begin_balance

	while @xacts > 0
	begin
		select
			@xact_id = min(id)
		from
			#ledger
		where
			product_id = @product_id
		and
			id > @xact_id

		select
			@amount = NULL
		select
			@amount = amount
		from
			#ledger
		where
			id = @xact_id
		
		select
			@running_balance = @running_balance + @amount

		update
			#ledger
		set
			balance = @running_balance
		where 
			id = @xact_id

		select
			@xacts = count(*)
		from
			#ledger
		where
			product_id = @product_id
		and
			id > @xact_id
	end
		
        insert into
                #ledger(
                        style,
                        transaction_type,
                        transaction_date,
                        product_id,
                        product,
                        balance)
        values(
                @total_style,
                "Ending balance",
                @end_date,
                @product_id,
                @product,
		@running_balance)	

	select
		@ids = count(*)
	from
		#ordered_products
	where
		id > @id
end		

create table
	#realized_equivs(
		id int identity,
		value_date datetime,
		equiv numeric(30, 4) NULL
)

insert into
	#realized_equivs(
		value_date,
		equiv)
select
	a.value_date,
	sum(a.currency_equiv + a.product_equiv)
from
	#trades a
where
	a.value_date >= @begin_date
and
	a.value_date <= @end_date
group by
	a.value_date

	

create table
	#summary(
		id int identity,
		name varchar(50) NULL,
		value numeric(30,8) NULL
)

select
	@opening_balance = sum(equiv)
from
	#begin_balances

select
	@opening_unrealized = sum(a.product_equiv + a.currency_equiv)
from
	#trades a
where
        a.value_date >= @begin_date
and
	a.trade_date < @begin_date

select
	@opening_nav = @opening_balance + @opening_unrealized

select
	@realized_profit =  sum(equiv)
from
	#realized_equivs
where
	equiv > 0

select
        @realized_loss =  sum(equiv)
from
        #realized_equivs
where
        equiv < 0

if @realized_profit = NULL
	select
		@realized_profit = 0

if @realized_loss = NULL
	select
		@realized_loss = 0

select
	@net_realized = @realized_profit + @realized_loss


create table
	#transaction_type_summary(
		id int identity,
		transaction_type_id int,
		product_id int,
		amount numeric(30, 4),
		equiv numeric(30, 4) NULL
)

insert into
	#transaction_type_summary(
		transaction_type_id,
		product_id,
		amount)
select
	transaction_type_id,
	currency_id,
	sum(amount)
from
	#account_transactions
group by
	transaction_type_id,
	currency_id

update
        #transaction_type_summary
set
        a.equiv = a.amount * b.end_rate
from
        #transaction_type_summary a,
        #conversion_rates b
where
        a.product_id = b.product_id

select
	@withdrawals = sum(a.equiv)
from
	#transaction_type_summary a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
	b.name in("Withdrawal")

select
        @deposits = sum(a.equiv)
from
        #transaction_type_summary a,
        transaction_types b
where
        a.transaction_type_id = b.transaction_type_id
and
        b.name in("Deposit")

select
        @financing = sum(a.equiv)
from
        #transaction_type_summary a,
        transaction_types b
where
        a.transaction_type_id = b.transaction_type_id
and
        b.name in("Interest", "Interest Accrual")

select
        @commissions = sum(a.equiv)
from
        #transaction_type_summary a,
        transaction_types b
where
        a.transaction_type_id = b.transaction_type_id
and
        b.name in("Commission", "Markup", "Fees/Commissions/Brokerage", "Management Fee", "Incentive Fee", "Prime Brokerage Fee", "Execution Fee")

select
        @adjustments = sum(a.equiv)
from
        #transaction_type_summary a,
        transaction_types b
where
        a.transaction_type_id = b.transaction_type_id
and
        b.name in("Adjustment")


if @opening_unrealized = NULL
	select
		@opening_unrealized = 0
if @opening_nav = NULL
	select
		@opening_nav = 0
	
if @withdrawals = NULL
	select
		@withdrawals = 0
if @deposits = NULL
	select
		@deposits = 0
if @financing = NULL
	select
		@financing = 0
if @commissions = NULL
	select
		@commissions = 0
if @adjustments = NULL
	select
		@adjustments = 0


