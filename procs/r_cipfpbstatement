insert into #summary values("Opening Unrealized P/L", @opening_unrealized)
insert into #summary values("Opening NAV", @opening_nav)
insert into #summary values(NULL, NULL)
insert into #summary values("Realized Profit", @realized_profit)
insert into #summary values("Realized Loss", @realized_loss)
insert into #summary values("Net Realized P/L", @net_realized)
insert into #summary values(NULL, NULL)
