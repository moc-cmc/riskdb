drop procedure
	tt_markpendingnetsfordate
go

create procedure
	tt_markpendingnetsfordate
		@source varchar(50),
		@trade_date datetime

as

declare @begin_date datetime
declare @end_date datetime
declare @source_id int
declare @sent_status_id int

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


select
	@sent_status_id = status_id
from
	statuses
where
	name = "Sent"
if @sent_status_id = NULL
begin
	select
		error = "Status not found",
		status = "Sent"
	return
end


select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL 
begin
	select
		error = "Source not found",
		source = @source
	return
end



update
	trade_notifications
set
	status_id = @sent_status_id
from	
	trades a,
	trade_notifications b,
	statuses c
where
	a.trade_id = b.trade_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	b.status_id = c.status_id
and
	b.source_id = @source_id
and
	c.name = "Pending Net"




go

