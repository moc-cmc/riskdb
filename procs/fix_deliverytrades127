	opt_quantity float NULL,
	opt_tick_size float NULL,
	/*- Exotic Info -*/
        /*  n/a */

	
    )

/* @MARK: INSERT #notify_trades from trades
 */
insert into
    #notify_trades (
        trade_notification_id,
	notification_status_id,
        notify_date,
        deal_id,
        order_id,
        trade_id,
	trade_status_id,
        exec_id,
        secondary_exec_id,
        trade_date,
	trade_type_id,
        contract_id,
        inverted,
        value_date,
	fixing_date,
        side,
        quantity,
        price,
        spot_reference,
        external_account_id,
        trader_id,
        counterparty_id,
        broker_id,
        settl_curr_amt
    )
select
    a.trade_notification_id,
    a.status_id, 
    a.notify_date,
    b.deal_id,
    order_id = convert(varchar(30), b.deal_id),
    b.trade_id,
    b.status_id,
    exec_id = convert(varchar(30), b.trade_id),
    b.identifier,
    b.trade_date,
    b.trade_type_id,
    b.contract_id,
    inverted = "N",
    b.value_date,
    b.fixing_date,
    side = "Sell",
    b.quantity,
    b.price,
    b.spot_reference,
    b.external_account_id,
    b.trader_id,
    b.counterparty_id,
    b.broker_id,
    settl_curr_amt = -b.quantity * b.price
from
    #trade_notifications a,
    trades b
where
    a.trade_id = b.trade_id
and
    b.trade_type_id in(	@spot_trade_type_id,
			@forward_trade_type_id,
			@swap_n_trade_type_id,
			@swap_f_trade_type_id,
			@opt_trade_type_id
			)


