	#notify_trades
set
	option_premium = b.amount,
	option_premium_ccy_id = b.currency_id,
	premium_settle_date = b.transaction_date
from
	#notify_trades a,
	account_transactions b,
	account_transaction_trades c
where
	a.trade_id = c.trade_id
and
	c.account_transaction_id = b.account_transaction_id

update
	#notify_trades
set
	option_premium_ccy = b.symbol
from
	#notify_trades a,
	products b
where
	a.option_premium_ccy_id = b.product_id

update
	#notify_trades
set
	option_settle_date = b.settledate
from
	#notify_trades a,
	option_settledates b
where
	a.contract_id = b.contract_id

