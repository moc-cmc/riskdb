    #notify_trades
set
    notification_status = a.name
from
    statuses a,
    #notify_trades b
where
    a.status_id = b.notification_status_id

update
    #notify_trades
set
    notification_status = "Rebook"
where
    trade_status_id = @rebook_status_id
and
    notification_status_id = @active_status_id
 

