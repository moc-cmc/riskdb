/* @MARK: UPDATE #notify_trades: trade_day */
update
    #notify_trades
set
    trade_day = case datepart(weekday, dateadd(hour, 7, trade_date))
        when 7 then
            dateadd(day, 2, dateadd(hour, 7, trade_date))
        when 1 then 
            dateadd(day, 1, dateadd(hour, 7, trade_date))
        else
            dateadd(hour, 7, trade_date)
    end

    
/* @MARK: UPDATE #notify_trades: executing_firm, account = external_account by symbol */
update
    #notify_trades
set
    executing_firm = b.symbol,
    account = b.symbol
from
    #notify_trades a,
    external_accounts b
where
    a.external_account_id = b.external_account_id
    

/* @MARK: UPDATE #notify_trades: executing_firm, account = external_account by @source_id */
update
    #notify_trades
set
    executing_firm = b.symbol,
    account = b.symbol
from
    #notify_trades a,
    external_account_symbols b
where
    a.external_account_id = b.external_account_id
and
    b.source_id = @source_id


    
/* @MARK: UPDATE #notify_trades: executing_trader = trader by symbol */
update
    #notify_trades
set
