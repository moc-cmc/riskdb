set
	prime_broker_id = b.prime_broker_id
from
	external_account_prime_brokers b,
	#notify_trades c
where
	c.external_account_id = b.external_account_id

update
	#notify_trades
set
	clearing_firm = c.name
from
	#notify_trades a,
	prime_brokers b,
	sources c
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = c.source_id
	
update
	#notify_trades
set
	clearing_firm = b.symbol
from
	#notify_trades a,
	prime_broker_symbols b
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = @source_id
    
    
/* @MARK: UPDATE #notify_trades: executing_system = broker  by symbol */
update
    #notify_trades
set
    executing_system = b.symbol
from
    #notify_trades a,
    brokers b
where
    a.broker_id = b.broker_id

/* @MARK: UPDATE #notify_trades: executing_system = broker by @source_id */
update
    #notify_trades
set
    executing_system = b.symbol
from
    #notify_trades a,
    broker_symbols b
where
    a.broker_id = b.broker_id
and
    b.source_id = @source_id

    
/* @MARK: UPDATE #notify_trades: currency, settl_currency */
update
    #notify_trades
set
    symbol = rtrim(ba.symbol) + "/" + rtrim(bb.symbol),
    currency = ba.symbol,
    settl_currency = bb.symbol
from
    #notify_trades a,
    forwards b,
    products ba,
    products bb
where
    a.contract_id = b.contract_id
and
    b.product_id = ba.product_id
and
    b.currency_id = bb.product_id

/* @MARK: UPDATE #notify_trades: forward_points, trim for non-Forwards */
update
    #notify_trades
set
    forward_points = price - spot_reference
where
    trade_type = "Forward"



/* @MARK: UPDATE #notify_trades: inverted contracts as necesary */
update
    #notify_trades
set
    inverted = "Y",
    symbol = rtrim(ea.symbol) + "/" + rtrim(eb.symbol),
    currency = eb.symbol,
    settl_currency = ea.symbol,
    price = 1 / a.price,
    quantity = a.settl_curr_amt,
    settl_curr_amt = a.quantity
from
    #notify_trades a,
    contract_price_styles b,
    price_styles c,
    forwards d,
    forwards e,
    products ea,
    products eb
where
    a.contract_id = b.contract_id
and
    b.price_style_id = c.price_style_id
and
    a.contract_id = d.contract_id
and
    d.product_id = e.currency_id
and
    d.currency_id = e.product_id
and
    e.product_id = ea.product_id
and
    e.currency_id = eb.product_id
and
    c.name = "Inverted"
    
/* @MARK: UPDATE #notify_trades: side */
update
    #notify_trades
set
    side = "Buy"
where
    quantity < 0

/* @MARK: UPDATE #notify_trades: abs(quantity), abs(settl_curr_amt) */
update
    #notify_trades
set
    quantity = abs(quantity),
    settl_curr_amt = abs(settl_curr_amt)

/* @MARK: UPDATE #notify_trades: swap_symbol */
update
    #notify_trades
set
    swap_symbol = c.symbol
from
    #notify_trades a,
    swap_symbol_trades b,
    swap_symbols c
where
    a.trade_id = b.trade_id
and
    b.swap_symbol_id = c.swap_symbol_id
and
    a.trade_type_id in(@swap_n_trade_type_id, @swap_f_trade_type_id)

update
	#notify_trades
set
	rebook_link_id = b.rebook_trade_id
from
	#notify_trades a,
	cancel_rebook_trades b
where
	a.trade_id = b.cancel_trade_id


/*
| Query option details
*/
update
	#notify_trades
set
	optcon_exercise_style_id = b.exercise_style_id,
	optcon_exercise_style = c.name,
	optcon_strike = b.strike,
	optcon_put_call = b.put_call,
	option_expiration_id = b.option_expiration_id
from
	#notify_trades a,
	option_contracts b,
	exercise_styles c
where
        a.contract_id = b.contract_id

update
	#notify_trades
set
	option_id = b.option_id,
	optexp_symbol = b.symbol,
	optexp_expiration = b.expiration,
	optexp_timezone_id = b.timezone_id
from
        #notify_trades a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id

update
	#notify_trades
set
	value_date = optexp_expiration
where
	trade_type_id = @opt_trade_type_id

update 
	#notify_trades
set
	optexp_time_zone = b.timezone,
	optexp_tz_symbol = b.symbol,
	optexp_tz_expiration_time = b.expiration_time,
	optexp_tz_display_value = b.display_value,
	optexp_tz_status = b.status
from
	#notify_trades a,
	timezones b
where
	a.optexp_timezone_id = b.timezone_id

update
	#notify_trades
set
	opt_underlying_contract_id = b.underlying_contract_id,
	opt_exchange_id = b.exchange_id,
	opt_exchange = c.name,
	opt_def_exercise_style_id = b.def_exercise_style_id,
	opt_def_exercise_style = d.name,
	opt_quantity = b.quantity,
	opt_tick_size = b.tick_size
from
	#notify_trades a,
	options b,
	exchanges c,
	exercise_styles d
where
	a.option_id = b.option_id
and
	b.exchange_id = c.exchange_id
and
	b.def_exercise_style_id = d.exercise_style_id

update
	#notify_trades 
set
	opt_underlying_contract = b.symbol
from
	#notify_trades a,
	contracts b
where
	a.opt_underlying_contract_id = b.contract_id

update
        #notify_trades
set
        symbol = rtrim(g.symbol) + "/" + rtrim(f.symbol), /* WD 8/11/14 */
        currency = g.symbol,
        settl_currency = f.symbol
from
        #notify_trades a,
        contracts b,
        forwards e,
        products f,
        products g
where
        a.opt_underlying_contract_id = b.contract_id
and
        b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id


