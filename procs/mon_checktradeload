
drop procedure mon_checktradeload 
go

create procedure
	mon_checktradeload	

as

declare @weekday varchar(12)
declare @today datetime
declare @max_trade_date datetime


select
        @weekday = datename(weekday, getdate())

if (@weekday = 'Saturday' or @weekday = 'Sunday')
begin
        return

end

select
	@today = getdate()

select
	@max_trade_date = max(trade_date)
from
	trades

if (convert(date, @today) != convert(date, @max_trade_date)) 
begin
	select
		Status = "Failed",
		msg = "Trades not loaded"

	return
end

select
	Status = "Ok",
	msg = "Trades loadedd"

go

