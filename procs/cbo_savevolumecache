create procedure
	cbo_savevolumecache
		@login varchar(50),
		@trade_date datetime

as

declare @begin_date datetime
declare @end_date datetime
declare @fund_id int
declare @evaluation_ccy_id int
declare @min_ticket_size numeric(30, 4)

select
	@fund_id = fund_id,
	@evaluation_ccy_id = evaluation_currency_id,
	@min_ticket_size = min_ticket_size
from
	funds
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "More than 1 fund exists. Logic not supported"
	return
end

select
	@trade_date = convert(date, @trade_date)

exec
	r_daterangefordate 
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#trades
(
	trade_id int,
	trade_type_id int,
 	external_account_id int,
	counterparty_id int,
	contract_id int,
	trader_id int,
	strategy_id int,
	broker_id int,
	sales_code_id int
)

insert into
	#trades(
		trade_id,
		trade_type_id,
		external_account_id,
		counterparty_id,
		contract_id,
		trader_id,
		strategy_id,
		broker_id,
		sales_code_id)
select
	trade_id,
	trade_type_id,
	external_account_id,
	counterparty_id,
	contract_id,
	trader_id,
	strategy_id,
	broker_id,
	sales_code_id
from
	trades
where
	trade_date >= @begin_date
and
	trade_date < @end_date

/* doing multiple joins on trade_id, so add index */
create nonclustered index
	utmp
on
	#trades(trade_id)
	
	

create table
	#adj_trade_type_volumes(
		trade_type_id int,
		product_id int,
		volume_date datetime,
		volume numeric(30, 4),
		trade_count int
)

if @min_ticket_size != 0 or @min_ticket_size !=NULL
begin
	insert into
        	#adj_trade_type_volumes(
                	trade_type_id,
                	product_id,
                	volume_date,
                	volume,
                	trade_count
        	)
	select
        	a.trade_type_id,
        	b.product_id,
        	@trade_date,
        	sum(@min_ticket_size - b.volume),
        	count(a.trade_id)
	from
        	#trades a,
        	trade_volumes b
	where
        	a.trade_id = b.trade_id
	and
        	b.volume_date = @trade_date
	and
		b.volume < @min_ticket_size
	group by
        	a.trade_type_id,
        	b.product_id
end

insert into
	trade_type_volumes(
		trade_type_id,
		product_id,
		volume_date,
		volume,
		trade_count
	)
select
	a.trade_type_id,
	b.product_id,
	@trade_date,
	sum(b.volume),
	count(a.trade_id)
from
	#trades a,
	trade_volumes b
where
	a.trade_id = b.trade_id
and
	b.volume_date = @trade_date
group by
	a.trade_type_id,
	b.product_id

update
	trade_type_volumes
set
	volume_adj = b.volume,
	adj_count = b.trade_count
from
	trade_type_volumes a,
	#adj_trade_type_volumes b
where
	a.trade_type_id = b.trade_type_id
and
	a.product_id = b.product_id
and
	a.volume_date = b.volume_date


