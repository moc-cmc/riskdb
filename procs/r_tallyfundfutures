
if object_id("r_tallyfundfutures") != NULL
    drop procedure
        r_tallyfundfutures
go

create procedure
	r_tallyfundfutures
		@login char(25),
		@buy_sell varchar(10),
		@quantity int,
		@symbol char(25),
		@price float


as

declare @deal_id int
declare @trade_id int

exec
	api_tallymarketfuture
		@login = @login,
		@buy_sell = @buy_sell,
		@symbol = @symbol,
		@quantity = @quantity,
		@price = @price,
		@deal_id = @deal_id output,
		@trade_id = @trade_id output




exec
	r_inspectdealtrades
		@login,
		@deal_id

exec
	r_intradayfwdpl
		@login

go
