drop procedure r_postuncommitrange
go

create procedure 
	r_postuncommitrange
		@begin_date datetime,
		@end_date datetime
as

declare @working_date datetime


select
	@begin_date = convert(char(8), @begin_date, 112)+" 17:00",
	@end_date = convert(char(8), @end_date, 112)+" 17:00"

select
	@working_date = @begin_date

select
	msg = "Uncommitting range",
	working_date = @working_date,
	end_date = @end_date

while @working_date <= @end_date
begin
	exec
		r_postuncommit
			@trade_date=@working_date

	exec
		r_nextbusinessday
			@working_date,
			@working_date output
end



go
