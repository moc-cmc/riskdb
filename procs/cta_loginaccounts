
if object_id("cta_loginaccounts") != null
    drop procedure
        cta_loginaccounts
go

create procedure
	cta_loginaccounts
		@login char(30)
as

select
	a.external_account_id,
	a.symbol,
	a.name,
	a.internal_account_id,
	internal_account_symbol = bb.symbol,
	internal_account_name = bb.name,
	c.ib_broker_id,
	ib_broker_symbol = c.symbol
from
	external_accounts a,
	internal_account_users b,
	tico_accounts ba,
	internal_accounts bb,
	ib_brokers c
where
	a.internal_account_id = b.internal_account_id
and
	b.account_id = ba.account_id
and
	b.internal_account_id = bb.internal_account_id
and
	a.ib_broker_id *= c.ib_broker_id
and
	ba.login = @login
and (
		lower(a.name) not like "closed%"
	or
		lower(a.name) not like "%closed"
	)
order by
	c.symbol,
	bb.name,
	a.symbol


go
