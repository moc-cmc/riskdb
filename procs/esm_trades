use
	risk_cfe
go

drop procedure
	esm_trades
go

create procedure
	esm_trades
		@trade_date datetime=NULL,
		@trade_id int=NULL
as

declare @db_name varchar(40)

select
	@db_name = db_name()
if @db_name = "risk_cantor"
begin
	exec
		esm_cantortrades
			@trade_date,
			@trade_id

	return
end

if @db_name = "risk_faros"
begin
	exec
		esm_farostrades
			@trade_date,
			@trade_id
	return
end

if @db_name = "risk_vscap"
begin
	exec
		esm_vscaptrades
			@trade_date,
			@trade_id
	return
end

if @db_name = "risk_seb"
begin
	exec
		esm_sebtrades
			@trade_date,
			@trade_id
	return
end

if @db_name = "risk_buttonwood"
begin
	exec
		esm_buttonwoodtrades
			@trade_date,
			@trade_id
	return
end

if @db_name = "risk_cfe"
begin

	exec
		esm_cfetrades
			@trade_date,
			@trade_id
	return
end


go
