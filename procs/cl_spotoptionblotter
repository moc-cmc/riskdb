
drop procedure cl_spotoptionblotter
go


create procedure
	cl_spotoptionblotter
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@trade_id int=NULL

as

declare @run_id int
declare @tico_account_id int
declare @source_id int
declare @date datetime
declare @trade_date datetime

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "login not found"
	return
end

select 
	@source_id=source_id
from
	sources
where
	name="Agency Client"

select
	@run_id = a.run_id
from
	user_runs a,
	runs b
where
	a.run_id = b.run_id
and
	b.name = @run_name
and
	a.tico_account_id = @tico_account_id
if @run_id = NULL
begin
	select
		id = -1,
		error = "No run configured for user"
	return
end


exec
    r_normalizedaterange
	@begin_date out,
	@end_date out


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#traders
	select
		trader_id
	from
		traders

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select  
	internal_account_id
from    
	run_internal_accounts
where   
	run_id = @run_id 
if @@rowcount = 0
	insert into
		#internal_accounts
	select  
		internal_account_id
	from    
		internal_accounts

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#strategies
	select
		strategy_id
	from
		strategies


create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers


create table
	#trades(
		trade_id int,
		trade_date datetime,
		external_account_id int,
		client varchar(150) NULL,
		contract_id int,
		product varchar(50) NULL,
		buy_sell varchar(50) NULL,
		ccy_pair varchar(50) NULL,
		strike float NULL,
		expiration datetime NULL,
        time_zone varchar(25) NULL,
		settledate datetime NULL,
		quantity numeric(30,4),
		put_call varchar(10) NULL,
		premium_paid float NULL,
		premium_ccy varchar(50) NULL,
        premium_val_date datetime NULL)

if @trade_id = NULL
begin
	insert into
		#trades(
			trade_id,
			trade_date,
			external_account_id,
			contract_id,
			strike,
			settledate,
			quantity,
			put_call)
	select
		a.trade_id,
		a.trade_date,
		a.external_account_id,
		a.contract_id,
		g.strike,
		a.value_date,
		a.quantity,
		g.put_call
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
		option_contracts g
	where
		a.contract_id = g.contract_id
	and
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
	and
		a.quantity != 0
end
else   /* Identical to above query with @trade_id qualifier, and dateranges for trade_id */
begin
	insert into
		#trades(
			trade_id,
			trade_date,
			external_account_id,
			contract_id,
			strike,
 			settledate,
			quantity,
			put_call)
	select
		a.trade_id,
		a.trade_date,
		a.external_account_id,
		a.contract_id,
		g.strike,
		a.value_date,
		a.quantity,
		g.put_call
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
		option_contracts g
	where   
		a.contract_id = g.contract_id
	and
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
/*	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date */
	and
		a.quantity != 0
	and
		a.trade_id = @trade_id
end

delete
	#trades
from
	#trades a,
	exotic_contracts b
where
	a.contract_id = b.contract_id

update
	#trades
set
	buy_sell = "CLIENT BUY"
where
	quantity < 0

update
	#trades
set
	buy_sell = "CLIENT SELL"
where
	quantity > 0
	
update
	#trades
set
	quantity = abs(quantity)

update
	#trades
set
	put_call = "PUT"
where
	upper(put_call) = "P"

update
	#trades
set
	put_call = "CALL"
where
	upper(put_call) = "C"


update
	#trades
set
	a.ccy_pair = e.symbol,
	a.expiration = c.expiration,
	a.time_zone = f.timezone
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	contracts e,
	timezones f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	c.timezone_id  = f.timezone_id
	
update
	#trades
set
	a.product = f.symbol
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e,
	products f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.product_id = f.product_id

update
	#trades
set
	a.premium_paid = c.amount * -1.0,
	a.premium_ccy = d.symbol,
    a.premium_val_date = c.transaction_date
from
	#trades a,
	account_transaction_trades b,
	account_transactions c,
	products d
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.currency_id = d.product_id

update
	#trades
set
	a.client=b.name
from
	#trades a,
	external_accounts b
where
	a.external_account_id=b.external_account_id

update
	#trades
set
	a.client=b.symbol
from
	#trades a,
	external_account_symbols b
where
	a.external_account_id=b.external_account_id and
	b.source_id=@source_id

select
	a.trade_id,
	"trade_date"=convert(char(11), a.trade_date),
	a.client,
	"give_up_to"=rtrim(h.name),
	a.buy_sell,
	a.put_call,
	a.ccy_pair,
	a.product,
	"quantity"=convert(numeric(30,2),a.quantity),
	a.strike,
	"expiration" = rtrim(convert(varchar(15), a.expiration, 107)),
    a.time_zone,
	"settledate"=convert(char(11), a.settledate),
	"premium"=a.premium_paid,
	a.premium_ccy,
	"premium_val_date"=convert(char(11), a.premium_val_date)
from
	#trades a,
	trade_notifications b,
	sources c,
	trades d,
	external_accounts e,
	external_account_prime_brokers f,
	prime_brokers g,
	sources h
where
	a.trade_id = b.trade_id
and
	b.source_id = c.source_id
and
	c.source_id=@source_id
and
	a.trade_id=d.trade_id
and
	d.external_account_id=e.external_account_id
and
	d.external_account_id=f.external_account_id
and
	f.prime_broker_id=g.prime_broker_id
and
	g.source_id=h.source_id


go

                                                                                                                                                  
