    case when @forward_exchange != null then ", @forward_exchange = '" + @forward_exchange + "'" else "" end,
    case when @forward_symbol != null then ", @forward_symbol = '" + @forward_symbol + "'" else "" end,
    case when @future_id != null then ", @future_id = " + convert(varchar(50), @future_id) else "" end,
    case when @future_symbol != null then ", @future_symbol = '" + @future_symbol + "'" else "" end,
    case when @future_exchange != null then ", @future_exchange = '" + @future_exchange + "'" else "" end,
    case when @future_quantity != null then ", @future_quantity = " + convert(varchar(50), @future_quantity) else "" end,
    case when @future_tick_size != null then ", @future_tick_size = " + convert(varchar(50), @future_tick_size) else "" end,
    case when @future_price_scale != null then ", @future_price_scale = " + convert(varchar(50), @future_price_scale) else "" end,
    case when @future_contract_id != null then ", @future_contract_id = " + convert(varchar(50), @future_contract_id) else "" end,
    case when @future_expiration != null then ", @future_expiration = '" + convert(varchar(50), @future_expiration) + "'" else "" end,
    case when @future_contract_symbol != null then ", @future_contract_symbol = '" + @future_contract_symbol + "'" else "" end,
    case when @option_id != null then ", @option_id = " + convert(varchar(50), @option_id) else "" end,
    case when @option_underlying_contract != null then ", @option_underlying_contract = '" + @option_underlying_contract + "'" else "" end,
    case when @option_underlying_contract_id != null then ", @option_underlying_contract_id = " + convert(varchar(50), @option_underlying_contract_id) else "" end,
    case when @option_underlying_instrument != null then ", @option_underlying_instrument = '" + @option_underlying_instrument + "'" else "" end,
    case when @option_exchange != null then ", @option_exchange = '" + @option_exchange + "'" else "" end,
    case when @option_exercise_style != null then ", @option_exercise_style = '" + @option_exercise_style + "'" else "" end,
    case when @option_quantity != null then ", @option_quantity = " + convert(varchar(50), @option_quantity) else "" end,
    case when @option_tick_size != null then ", @option_tick_size = " + convert(varchar(50), @option_tick_size) else "" end,
    case when @option_expiration_id != null then ", @option_expiration_id = " + convert(varchar(50), @option_expiration_id) else "" end,
    case when @option_expiration_symbol != null then ", @option_expiration_symbol = '" + @option_expiration_symbol + "'" else "" end,
    case when @option_expiration != null then ", @option_expiration = '" + convert(varchar(50), @option_expiration) + "'" else "" end,
    case when @option_contract_id != null then ", @option_contract_id = " + convert(varchar(50), @option_contract_id) else "" end,
    case when @option_strike != null then ", @option_strike = " + convert(varchar(50), @option_strike) else "" end,
    case when @option_put_call != null then ", @option_put_call = '" + @option_put_call + "'" else "" end,
    case when @option_contract_symbol != null then ", @option_contract_symbol = '" + @option_contract_symbol + "'" else "" end
return
*/

begin tran

/* 
 * If we're using a source, then query it
 */
if @source != null
begin
    select
        @source_id = source_id
    from
        sources
    where
        name = @source
    if @source_id = null
    begin
        exec
            j_nextkey
                "sources",
                @source_id out
        insert into
            sources
        values (
            @source_id,
            @source,
            1 /* FEATURE: sources.status_id */
        )
    end
end
if @source_symbol = null and @symbol != null
    select
        @source_symbol = @symbol

/* 
 * If a contract_id is provided, then use it to override everything else. That
 * allows the caller to pass in a @contract_id (or @symbol) to look up all other
 * information regarding that contract.
 */
if @contract_id = null
begin
    if @source_id != null and @source_symbol != null
        select
            @contract_id = contract_id
        from
            contract_symbols
        where
            source_id = @source_id
        and 
            symbol = @source_symbol

    if @contract_id = null and @symbol != null
        select
            @contract_id = contract_id
        from
            contracts
        where
            symbol = @symbol

end

if @contract_id != null
begin
    select
        @symbol = a.symbol,
        @instrument = b.name
    from
        contracts a,
        instruments b
    where
        a.instrument_id = b.instrument_id
    and
        a.contract_id = @contract_id
    if @instrument = "Forward"
        select
            @forward_id = @contract_id
    else if @instrument = "Future"
        select
            @future_contract_id = @contract_id
    else if @instrument = "Option"
        select
            @option_contract_id = @contract_id
    else if @instrument = "Exotic"
    begin
        rollback
        raiserror 91017, "Exotics not currently supported"
        return
    end
    else
    begin
        select
            id = -1,
            err = "Instrument, " + @instrument + ", not supported"
        rollback
        raiserror 91020, "Instrument not supported"
        return
    end
end

/* 
 * CURRENCY
 * 
 * Resolve the currency. We will not be creating currencies. If no currency is
 * provided, then no forward can be created.
 */
if @currency != null
begin
    select
        @currency_id = product_id
    from
        products
    where
        symbol = @currency
    if @currency_id = null
    begin
        /* -------------------- MARK: Create the currency ------------------- */

        select
            @product_type_id = product_type_id
        from
            product_types
        where
            name = "Currency"
        if @product_type_id = null
        begin
            /* Not enabled for non-CTA databases */
            if object_id("r_manageproducttypes") != NULL
            begin
                select @exec_sql = '
                    exec
                        r_manageproducttypes
                            "add",
                            @product_type_id out
                '
                exec (@exec_sql)
            end
            
            if @product_type_id != null
            begin
                update
                    product_types
                set
                    name = "Currency"
                where
                    product_type_id = @product_type_id
            end
            else
            begin
                rollback
                raiserror 91001, "No currency product type and couldn't create the product type"
                return
            end
        end
        
        if @parameters like "%create-currencies%"
        begin
        
            if @currency_name = null
                select
                    @currency_name = @currency
            
            exec
                j_nextkey
                    "products",
                    @currency_id out
            insert into
                products
            values (
                @currency_id,
                @product_type_id,
                @currency,
                @currency_name
            )
        
        end
        else if @source_id != null
        begin
            
            /* If we're not creating products, then populate the
             * product_symbols table and return. */
            if object_id("product_symbols") != NULL
            begin
                select @exec_sql = '
                if not exists( select * from product_symbols where source_id = @source_id and symbol = @currency ) 
                    insert into
                        product_symbols
                    values (
                        NULL,
                        @source_id,
                        @currency
                    )
                '
                exec (@exec_sql)
            end
            
            select
                @error = @symbol + ": Cannot resolve currency for source_id=" + convert(varchar(10), @source_id) + ", currency=" + @currency
            /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "product_symbols", @error) */
            
        end
        else
        begin
            rollback
            raiserror 91025, "Cannot find currency, @parameters does not include 'create-products', @source was not provided so no product_symbols could be created"
            return
        end
            
    end
end

/* 
 * PRODUCT
 * 
 * Resolve the product, create it couldn't be found only if @product and
 * @product_type are provided. If no @product_id exists after this "if"
 * statement, then no product is necessary, which means that no forward can be
 * created.
 */
if @contract_id = null and @product_id = null
begin

    if @product != null
    begin
        select
            @product_id = product_id
        from
            products
        where
            lower(symbol) = lower(@product)
    end
    
    if object_id("product_symbols") != NULL
    begin
        select @exec_sql = '
            if @product_id = null and @product != null and @source_id != null
            begin
                select
                    @product_id = product_id
                from
                    product_symbols
                where
                    source_id = @source_id
                and
                    symbol = @product
            end
        '
        exec (@exec_sql)
    end
    
    if @product_id = null
    begin
        /* If we couldn't find the product, then see if we need to create
         * the product. */
        if @product_type = null
            select
                @product_type = "Unassigned"
        
        select
            @product_type_id = product_type_id
        from
            product_types
        where
            name = @product_type
        if @product_type_id = null
        begin
            if object_id("r_manageproducttypes") != NULL
            begin
                select @exec_sql = '
                    exec
                        r_manageproducttypes
                            "add",
                            @product_type_id out
                '
                exec (@exec_sql)
            end
            if @product_type_id != null
            begin
                update
                    product_types
                set
                    name = @product_type
                where
                    product_type_id = @product_type_id
            end
            else
            begin
                rollback
                raiserror 91003, "No product type as specified and couldn't create the product type"
                return
            end
        end
        
        if @parameters like "%create-products%"
        begin
        
            /* Default a reasonable product name */
            if @product_name = null
                select
                    @product_name = @product
            
            /* -------------------- Create product -------------------- */

            exec
                j_nextkey
                    "products",
                    @product_id out
            insert into
                products
            values (
                @product_id,
                @product_type_id,
                @product,
                @product_name
            )
    
        end
        else if @source_id != null
        begin
        
            if @product = null
                select
                    @product = @product_name
            if @product = null
            begin
                rollback
                select
                    @error = @symbol + ": Cannot resolve product for source=" + @source + ", product=" + @product + ", product_name=" + @product_name
                /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "product_symbols", @error) */
                raiserror 91026, "No product found and no @product nor @product_name provided to create a product_symbol for source"
                return
            end
            
            /* If we're not creating products, then populate the
             * product_symbols table and return. */
            if object_id("product_symbols") != NULL
            begin
                select @exec_sql = '
                    if not exists( select * from product_symbols where source_id = @source_id and symbol = @product ) 
                        insert into
                            product_symbols
                        values (
                            NULL,
                            @source_id,
                            @product
                        )
                '
                exec (@exec_sql)
            end
            commit
            select
                @error = @symbol + ": Cannot resolve product for source=" + @source+ ", product=" + @product
            /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "product_symbols", @error) */
            return
            
        end
        else
        begin
            rollback
            raiserror 91025, "Cannot find product, @parameters does not include 'create-products', @source was not provided so no product_symbols could be created"
            return
        end
            
    end /* if @product_id != null */
    
end  /* if @product_id != null */



/*+---------------------------------------------------------------------------* 
 |                                  Upstream                                  | 
 *----------------------------------------------------------------------------*/

/* 
 * FORWARDS
 * 
 * Look up the forward if necessary. If no @forward_id is provided, then look up
 * based on (@forward_symbol), (@product_id, @currency_id[, @forward_exchange]).
 * If none was found and @forward_exchange is provided, then create a new
 * forward. If no forward could be resolved, then neither a future or spot
 * option can be created.
 */
if @contract_id = null and @forward_id = null
begin

    /* Find the forward by symbol. But if we can't find the forward, continue on
     * looking by other other means and use @forward_symbol to create the
     * forward if necessary. */
    if @forward_symbol != null
    begin
        select
            @forward_id = a.contract_id
        from
            forwards a,
            contracts b
        where
            a.contract_id = b.contract_id
        and
            b.symbol = @forward_symbol
        if @forward_id = null
        begin
			rollback
            raiserror 91004, "No forward contract found for @forward_symbol"
            return
        end
    end
    
    /* If we still don't have a forward, then look up the forward by @product_id
     * and @currency_id and optionally @forward_exchange */
    if @forward_id = null and @product_id != null and @currency_id != null
    begin

        /* Look up the exchange */
        if @forward_exchange != null 
        begin
            exec
                r_resolveexchange
                    @login = @login,
                    @source = @source,
                    @exchange_id = @forward_exchange_id out,
                    @name = @forward_exchange,
                    @source_symbol = @forward_exchange,
                    @create = "Y",
                    @report = @report
            if @forward_exchange_id = null
            begin
                rollback
                raiserror 91005, "No exchange for @forward_exchange"
                return
            end
        end

        /* Look up the forward */
        select
            @forward_id = contract_id
        from
            forwards
        where
            product_id = @product_id
        and
            currency_id = @currency_id
        and (
                @forward_exchange_id = null
            or
                exchange_id = @forward_exchange_id
            )
        if @forward_id = null and @forward_exchange_id != null
        begin
            /* If we couldn't find the forward, but we have enough info to
             * create the forward. */
             
            if @forward_symbol = null
            begin
                if @product != null
                    select
                        @forward_symbol = @product
                else
                    select
                        @forward_symbol = name
                    from
                        products
                    where
                        product_id = @product_id
                if @forward_symbol = null
                begin
                    rollback
                    raiserror 91006, "Couldn't create a forward without either @forward_symbol, or a valid @product or @product_id"
                    return
                end
                
            end
            
            if @forward_id = null and @forward_symbol != null
            begin
                select
                    @forward_id = a.contract_id
                from
                    forwards a,
                    contracts b
                where
                    a.contract_id = b.contract_id
                and
                    b.symbol = @forward_symbol
            end

            if object_id("forward_symbols") != NULL
            begin
                select @exec_sql = '
                    if @forward_id = null and @forward_symbol != null and @source_id != null
                    begin
                        select
                            @forward_id = a.forward_id
                        from
                            forward_symbols a
                        where
                            source_id = @source_id
                        and
                            symbol = @forward_symbol
                        and
                            currency_symbol = @currency
                    end
                '
                exec (@exec_sql)
            end

            if @forward_id = null
            begin
                select
                    @forward_instrument_id = instrument_id
                from
                    instruments
                where
                    name = "Forward"
                if @forward_instrument_id = null
                begin
                    rollback
                    raiserror 91007, "'Forward' instrument not found"
                    return
                end
                    
                
                /* -------------------- Create forward -------------------- */
                
                select
                    @error = @symbol + ": Inserting forward for contract '" + @symbol + "'  with symbol = '" + @forward_symbol + "', instrument = " + convert(varchar(10), @forward_instrument_id)
                /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "contracts", @error) */
                /* select * from audit_logs */

                if @forward_symbol = null or @forward_instrument_id = null or @currency_id = null or @product_id = null or @forward_quantity = null or @forward_exchange_id = null
                begin
                    select
                        id = 91024,
                        error = "Incomplete information for forward",
                        forward_symbol = @forward_symbol,
                        forward_instrument_id = @forward_instrument_id,
                        product_id = @product_id,
                        currency_id = @currency_id,
                        forward_quantity = @forward_quantity,
                        forward_exchange_id = @forward_exchange_id
                    rollback
                    raiserror 91024, "Incomplete information for forward"
                    return
                end

                if @parameters like "%create-forwards%"
                begin
                
                    exec
                        j_nextkey
                            "contracts",
                            @forward_id out
                    
                    insert into
                        contracts
                    values (
                        @forward_id,
                        @forward_symbol,
                        @forward_instrument_id
                    )
                    if @@rowcount != 1
                    begin
                        rollback
                        raiserror 91022, "Failed to insert contract for forward"
                        return
                    end
                    
                    insert into
                        forwards
                    values (
                        @forward_id,
                        @currency_id,
                        @product_id,
                        @forward_quantity,
                        @forward_exchange_id
                    )
                    if @@rowcount != 1
                    begin
                        rollback
                        raiserror 91023, "Failed to insert forward"
                        return
                    end
                    
                end
                else if @source_id != null
                begin
                    
                    /* If we're not creating products, then populate the
                     * product_symbols table and return. */
                    rollback
                    
                    if object_id("forward_symbols") != NULL
                    begin
                        select @exec_sql = '
                            if not exists( select * from forward_symbols where source_id = @source_id and symbol = @forward_symbol and currency_symbol = @currency ) 
                                insert into
                                    forward_symbols
                                values (
                                    NULL,
                                    @source_id,
                                    @forward_symbol,
                                    @currency
                                )
                        '
                        exec (@exec_sql)
                    end

                    select
                        @error = @symbol + ": Cannot resolve forward for source_id=" + convert(varchar(10), @source_id) + ", forward_symbol=" + @forward_symbol + ", currency=" + @currency
                    /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "forward_symbols", @error) */
                    return
                    
                end
                else
                begin
                    rollback
                    select
                        @error = @symbol + ": Cannot find product, @parameters does not include 'create-products', @source was not provided so no product_symbols could be created"
                    /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "forwards", @error) */
                    raiserror 91025, "Cannot find product, @parameters does not include 'create-products', @source was not provided so no product_symbols could be created"
                    return
                end
        
            end
            
        end
    
    end
    
end

if @contract_id = null and @forward_id = null
begin
    select
        @error = @symbol + ": No forward found for @forward_symbol=" + @forward_symbol + ", @product=" + @product + ", @forward_exchange=" + @forward_exchange + ", @currency=" + @currency
    /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "forwards", @error) */
end

/* 
 * FUTURE CONTRACTS
 * 
 * Look up a future if necessary. If no @future_contract_id is provided, then
 * look up based on (@future_contract_symbol), (@future_id, @future_expiration),
 * (@forward_id[, @future_exchange?], @future_expiration). If none was found but
 * @forward_id was resolved and @future_exchange, @future_expiration are
 * provided, then a future and future contract will be created. Otherwise,
 * future options cannot be created.
 */
if @contract_id = null and @future_contract_id = null
begin

    /* Find the future contract by symbol. But if we can't find the future
     * contract, continue on looking by other other means and use
     * @future_contract_symbol to create the future contract if necessary. */
    if @future_contract_symbol != null
    begin
        select
            @future_contract_id = a.contract_id
        from
            future_contracts a,
            contracts b
        where
            a.contract_id = b.contract_id
        and
            b.symbol = @future_contract_symbol
    end
    
    /* Decode a future expiration code, such as "..U9" into "2009-09-20". */
    if @future_contract_symbol != null and len(@future_contract_symbol) > 2
    begin
        select
            @month_code = substring(@future_contract_symbol, len(@future_contract_symbol) - 1, 1),
            @year_code = substring(@future_contract_symbol, len(@future_contract_symbol), 1)
        if charindex(@month_code, "FGHJKMNQUVXZ") > 0 and charindex(@year_code, "0123456789") > 0
        begin
            /* Find the next future year, backdating 1 year. So, let's say it's
             * 2009 and the @future_year is '8', then 2008 is okay, but '7' will
             * be 2017. */
            select
                @future_year = 2000 + convert(int, @year_code)
            while @future_year <= datepart(year, getdate()) - 1
            begin
                select
                    @future_year = @future_year + 10
            end
            select
                @buf = convert(varchar(50), @future_year) + "-"
            
            select
                @symbol_future_expiration = case 
                    when @month_code = "F" then convert(datetime, @buf+"01-20")
                    when @month_code = "G" then convert(datetime, @buf+"02-20")
                    when @month_code = "H" then convert(datetime, @buf+"03-20")
                    when @month_code = "J" then convert(datetime, @buf+"04-20")
                    when @month_code = "K" then convert(datetime, @buf+"05-20")
                    when @month_code = "M" then convert(datetime, @buf+"06-20")
                    when @month_code = "N" then convert(datetime, @buf+"07-20")
                    when @month_code = "Q" then convert(datetime, @buf+"08-20")
                    when @month_code = "U" then convert(datetime, @buf+"09-20")
                    when @month_code = "V" then convert(datetime, @buf+"10-20")
                    when @month_code = "X" then convert(datetime, @buf+"11-20")
                    when @month_code = "Z" then convert(datetime, @buf+"12-20")
                    else null
                end
        end
    end
    if @future_expiration = null and @symbol_future_expiration != null
        select
            @future_expiration = @symbol_future_expiration
    
    /* We require @future_expiration to be provided if
     * @future_contract_id/@future_contract_symbol cannot be provided. */
    if @future_contract_id = null and @future_expiration != null
    begin
    
        /* 
         * FUTURE
         * 
         * Resolve the future. If the future doesn't yet exist, it will be
         * created here. If we can't resolve the @future_id, then raiserror.
         */
    
        /* All subsequent steps to try to resolve the future requires a
         * @future_symbol which is currently derived from the @forward. If
         * we don't have a @future_symbol, then use the forward symbol. */
        if @future_symbol = null
            select
                @future_symbol = symbol
            from
                contracts b
            where
                contract_id = @forward_id
        if @future_symbol = null
        begin
            rollback
            raiserror 91010, "No @future_symbol and no default symbol could be found"
            return
        end
        
        /* Look up the exchange */
        if @future_id = null and @future_exchange_id = null and @future_exchange != null 
        begin
            exec
                r_resolveexchange
                    @future_exchange_id out,
                    @future_exchange,
                    @source,
                    @future_exchange,
                    @created out
            if @future_exchange_id = null
            begin
                rollback
                raiserror 91010, "No exchange for @future_exchange"
                return
            end
        end

        /* Find the future by symbol. But if we can't find the
         * future, continue on looking by other other means and use
         * @future_symbol to create the future if
         * necessary. */
        if @future_id = null and @future_symbol != null
        begin
            select
                @future_id = future_id
            from
                futures
            where
                /* FEATURE: futures.symbol
                symbol = @future_symbol */
                root_symbol = @future_symbol                
        end
    
        if object_id("future_symbols") != NULL
        begin
            select @exec_sql = '
            if @future_id = null and @future_symbol != null and @source_id != null
            begin
                
                select
                    @future_id = a.future_id
                from
                    future_symbols a
                where
                    a.source_id = @source_id
                and
                    a.symbol = @future_symbol
                and (
                        @future_exchange_id = null
                    or
                        a.exchange_id = @future_exchange_id
                    )
                    
            end
            '
            exec (@exec_sql)
        end
            
        /* We'll need to find the @future_id first, but need a forward */
        if @future_id = null and @forward_id != null
        begin
        
            /* We can't do without a @forward_id */
            if object_id("forward_symbols") != NULL
            begin
                select @exec_sql = '
                    if @forward_id = null
                    begin
                        select
                            id = 91009,
                            error = "Cannot resolve a future without having resolved a forward",
                            forward_id = @forward_id,
                            forward_symbol = @forward_symbol,
                            product_id = @product_id,
                            currency_id = @currency_id,
                            forward_exchange_id = @forward_exchange_id
                        rollback
                        raiserror 91009, "Cannot resolve a future without having resolved a forward"
                        return
                    end
                '
                exec (@exec_sql)
            end

            select
                @future_id = future_id
            from
                futures
            where
                forward_id = @forward_id
            and (
                    @future_exchange_id = null
                or
                    exchange_id = @future_exchange_id
                )
            
        end
                
        if @future_id = null
        begin
            /* If we couldn't find the future, but have enough info to
             * create the future... */
            
            if @parameters like "%create-futures%"
            begin
            
                /* ------------------- Create future ------------------ */
                
                if @future_quantity = null
                    select
                        @future_quantity = 1
                
                exec
                    j_nextkey
                        "futures",
                        @future_id out
                
                insert into
                    futures (
                        future_id,
                        forward_id,
                        name,
                        /* FEATURE: futures.symbol: symbol, */
                        root_symbol,
                        exchange_id,
                        quantity,
                        tick_size
                    )
                values (
                    @future_id,
                    @forward_id,
                    @future_symbol,
                    @future_symbol,
                    @future_exchange_id,
                    @future_quantity,
                    @future_tick_size /* FEATURE: futures.price_scale,
                    @future_price_scale */
                )
                 
            end
            else if @source_id != null
            begin
                
                /* If we're not creating futures, then populate the
                 * future_symbols table and return. */
                if object_id("future_symbols") != NULL
                begin
                    select @exec_sql = '
                    if not exists( select * from future_symbols where source_id = @source_id and symbol = @future_symbol ) 
                        insert into
                            future_symbols
                        values (
                            NULL,
                            @source_id,
                            @future_symbol,
                            @future_quantity,
                            @future_exchange_id
                        )
                    '
                    exec (@exec_sql)
                end
                commit
                select
                    @error = @symbol + ": Cannot resolve future for source_id=" + convert(varchar(10), @source_id) + ", future_symbol=" + @future_symbol + ", future_quantity=" + convert(varchar(10), @future_quantity) + ", future_exchange_id=" + convert(varchar(10), @future_exchange_id)
                /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "future_symbols", @error) */
                return
                
            end
            else
            begin
                rollback
                raiserror 91025, "Cannot find future, @parameters does not include 'create-futures', @source was not provided so no future_symbols could be created"
                return
            end
        
            
        end /* if @future_id = null */
        
        if @future_id != null
        begin
            /* Default @future_expiration to the end of the month if the
             * day-of-month is the first. */
            if datepart(day, @future_expiration) = 1
                select
                    @future_expiration = dateadd(day, -1, dateadd(month, 1, @future_expiration))
            
            /* FUTURE CONTRACT: Resolve the future contract. */
            select
                @future_contract_id = contract_id
            from
                future_contracts a
            where
                future_id = @future_id
            and
                expiration = @future_expiration
                
            if @future_contract_id = null
            begin
                /* If we still have no @future_contract_id, then create one. */
                
                if @future_contract_symbol = null
                begin
                    select
                        @future_contract_symbol = case 
                            when @symbol_future_expiration != null then
                                /* FEATURE: symbol*/root_symbol
                            else
                                rtrim(convert(varchar(50), /* FEATURE: symbol*/root_symbol)) + " " + substring(upper(convert(varchar(9), @future_expiration, 6)), 4, 6) /*convert(varchar(8), @future_expiration, 1)*/
                        end
                    from
                        futures
                    where
                        future_id = @future_id

                    select
                        @future_contract_id = a.contract_id
                    from
                        future_contracts a,
                        contracts b
                    where
                        a.contract_id = b.contract_id
                    and
                        b.symbol = @future_contract_symbol
                end /* if @future_contract_symbol = null */
                    
                if @future_contract_id = null
                begin
                    
                    select
                        @future_instrument_id = instrument_id
                    from
                        instruments
                    where
                        name = "Future"
                    if @future_instrument_id = null
                    begin
                        rollback
                        raiserror 91011, "'Future' instrument not found"
                        return
                    end
                        
                    /* ---------------- Create future contract -------------- */
                    
                    exec
                        j_nextkey
                            "contracts",
                            @future_contract_id out
                    insert into 
                        contracts
                    values (
                        @future_contract_id,
                        @future_contract_symbol,
                        @future_instrument_id
                    )
                    
                    insert into
                        future_contracts
                    values (
                        @future_contract_id,
                        @future_id,
                        @future_expiration
                    )
                    
                end /* if @future_contract_id = null */
            
            end /* if @future_id != null */
        
        end /* if @future_contract_id = null */
    
    end /* if @future_contract_id = null and @future_expiration != null */

end /* if @future_contract_id = null */

/* 
 * OPTION CONTRACTS
 * 
 * Look up the option if necessary. If no @option_contract is provided, then
 * look up based on (@option_expiration_id, @option_strike, @option_put_call) 
 */
if @contract_id = null and @option_contract_id = null
begin

    /* Look up the option contract by symbol. If we don't find it, continue,
     * using @option_contract_symbol to create the contract. */
    if @option_contract_symbol != null
    begin
        select
            @option_contract_id = a.contract_id
        from
            option_contracts a,
            contracts b
        where
            a.contract_id = b.contract_id
        and
            b.symbol = @option_contract_symbol
    end
    
    /* If we didn't find the option contract, then resolve it, if any option
     * information is specified. */
    if @option_contract_id = null and (@option_strike != null or @option_put_call != null or @option_contract_symbol != null)
    begin
        if @option_strike = null or @option_put_call = null
        begin
            rollback
            raiserror 91019, "Both @option_strike and @option_put_call are required"
            return
        end
        
        if @option_put_call != "P" and @option_put_call != "C"
        begin
            rollback
            raiserror 91008, "@option_put_call must be either 'P' or 'C'"
            return
        end
        
        select
            @exercise_style_id = exercise_style_id
        from
            exercise_styles
        where
            name = @option_exercise_style
        if @exercise_style_id = null
        begin
            rollback
            raiserror 91014, "Couldn't find exercise style for @option_exercise_style"
            return
        end
                        
        /* Resolve the option expiration */
        if @option_expiration_id = null
        begin
            
            if @option_expiration_symbol != null
            begin
                select
                    @option_expiration_id = option_expiration_id
                from
                    option_expirations
                where
                    symbol = @option_expiration_symbol
            end
            
            if @option_expiration_id = null
            begin
                /* Check inputs needed to find an option expiration */
                if @option_expiration = null
                begin
                    rollback
                    raiserror 91012, "Can't resolve an option expiration without @option_expiration"
                    return
                end
                
                /* Default @future_expiration to the end of the month if the
                 * day-of-month is the first. */
                if datepart(day, @option_expiration) = 1
                    select
                        @option_expiration = dateadd(day, -1, dateadd(month, 1, @option_expiration))
                
                /* Resolve the option */
                if @option_id = null
                begin
                
                    /* Find the underlying. If the underlying contract is
                     * specified, then use neither @forward_id nor
                     * @future_contract_id */
                    if @option_underlying_contract_id = null and @option_underlying_contract != null
                        select
                            @option_underlying_contract_id = contract_id
                        from
                            contracts
                        where
                            symbol = @option_underlying_contract
                    
                    if @option_underlying_contract_id = null
                        select
                            @option_underlying_contract_id = case 
                                when @future_contract_id != null then @future_contract_id
                                else @forward_id
                            end
                    if @option_underlying_contract_id = null
                    begin
                        rollback
                        raiserror 91013, "Can't resolve an option: neither @future_contract_id nor @forward_id were either provided or could be resolved"
                        return
                    end
                    
                    /* Find the exchange if provided */
                    if @option_exchange != null
                    begin
                        exec
                            r_resolveexchange
                                @option_exchange_id out,
                                @option_exchange,
                                @source,
                                @option_exchange,
                                @created out
                        if @option_exchange_id = null
                        begin
                            rollback
                            raiserror 91018, "No option exchange, @option_exchange"
                            return
                        end
                    end
                    
                    /* See if this option exists. If it doesn't, then create the
                     * option */
                    select
                        @option_id = option_id
                    from
                        options
                    where
                        underlying_contract_id = @option_underlying_contract_id
                    and (
                            @option_exchange_id = null
                        or
                            exchange_id = @option_exchange_id
                        )
                    if @option_id = null
                    begin
                        
                        /* --------------- Create option -------------- */
                        
                        exec
                            j_nextkey
                                "options",
                                @option_id out
                        insert into
                            options
                        values (
                            @option_id,
                            @option_underlying_contract_id,
                            @option_exchange_id,
                            @exercise_style_id,
                            @option_quantity,
                            @option_tick_size
                        )
                        
                    end
                    
                end /* if @option_id = null */
                
                /* Now that we have an @option_id, find the
                 * @option_expiration_id. */
                select
                    @option_expiration_id = option_expiration_id
                from
                    option_expirations
                where
                    option_id = @option_id
                and
                    expiration = @option_expiration
                    
            end /* if @option_expiration_id = null */
                
            if @option_expiration_id = null and @option_expiration_symbol = null
            begin
                /* If no symbol was provided, then calculate a symbol */
                if @option_expiration_symbol = null
                begin
                    select
                        @expiration_text = substring(upper(convert(varchar(9), @option_expiration, 6)), 4, 6)
                    select
                        @option_expiration_symbol = case when charindex(@expiration_text, symbol) > 0 then symbol else symbol + " " + @expiration_text end
                    from
                        contracts
                    where
                        contract_id = @option_underlying_contract_id
                    
                end
            end
                
            /* Look up the option expiration by symbol */
            if @option_expiration_id = null and @option_expiration_symbol != null
            begin
                select
                    @option_expiration_id = option_expiration_id
                from
                    option_expirations
                where
                    symbol = @option_expiration_symbol
            end
                    
            /* Look up the option expiration by symbol */
            if @option_expiration_id = null and @option_expiration_symbol != null and @source_id != null
            begin
                select
                    @option_expiration_id = option_expiration_id
                from
                    option_expiration_symbols
                where
                    source_id = @source_id
                and
                    symbol = @option_expiration_symbol
            end
                    
            if @option_expiration_id = null
            begin

                /* ------------- MARK: Create option expiration ------------- */
                
                if @future_expiration = @option_expiration
                begin
                    rollback
                    
                    if not exists ( select * from option_expiration_symbols where source_id = @source_id and symbol = @option_expiration_symbol )
                    begin
                        if object_id("option_expiration_symbols") != NULL
                        begin
                            select @exec_sql = '
                                insert into
                                    option_expiration_symbols (
                                        source_id,
                                        /* expiration,
                                        exchange_id, */
                                        symbol
                                    )
                                    values (
                                        @source_id,
                                        /* @option_expiration,
                                        @option_exchange_id, */
                                        @option_expiration_symbol
                                    )
                                if @@rowcount != 1
                                begin
                                    raiserror 91021, "Failed to add option expiration symbol"
                                end
                            '
                            exec (@exec_sql)
                        end

                        select
                            @error = @symbol + ": Added option_expiration_symbol for @option_expiration " + @option_expiration_symbol
                        /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "option_expiration_symbols", @error) */
                    end
                    else
                    begin
                        select
                            @error = @symbol + ": An option_expiration_symbol for @option_expiration " + @option_expiration_symbol + " already exists"
                        /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "option_expiration_symbols", @error) */
                    end
                    
                    /* Also populate known_option_attributes: Currency,
                     * Exchange, Multiplier, Product */
                    if object_id("known_option_attributes") != NULL
                    begin
                        select @exec_sql = '
                        if @source_id != null and @currency != null and not exists( select * from known_option_attributes where source_id = @source_id and option_expiration_symbol = @option_expiration_symbol and attribute = "Currency" )
                        begin
                            insert into 
                                known_option_attributes
                            values (
                                @source_id,
                                @option_expiration_symbol,
                                "Currency",
                                @currency
                            )
                        end

                        if @source_id != null and @product != null and not exists( select * from known_option_attributes where source_id = @source_id and option_expiration_symbol = @option_expiration_symbol and attribute = "Product" )
                        begin
                            insert into 
                                known_option_attributes
                            values (
                                @source_id,
                                @option_expiration_symbol,
                                "Product",
                                @product
                            )
                            select
                                @error = @symbol + ": Added Product attribute for symbol: " + @option_expiration_symbol + ", product: " + @product
                        end
                        '
                        exec (@exec_sql)
                        /* insert into audit_logs(target, subject, note) values(object_name(@@procid), "option_expiration_symbols", @error) */

                    end
                    
                    return
                end

                exec
                    j_nextkey
                        "option_expirations",
                        @option_expiration_id out
                insert into
                    option_expirations
                values (
                    @option_expiration_id,
                    @option_id,
                    @option_expiration_symbol,
                    @option_expiration
                )
                
            end /* if @option_expiration_id = null */
            
        end /* if @option_expiration_id = null */
        
        /* Now that we have an @option_expiration_id, find the contract. */
        select
            @option_contract_id = contract_id
        from
            option_contracts
        where
            option_expiration_id = @option_expiration_id
        and
            strike = @option_strike
        and
            put_call = @option_put_call
        if @option_contract_id = null
        begin
            /* If we couldn't find the option contract, then create it */
            
            if @option_contract_symbol = null
            begin
            
                /* Get the @tick_scale, the number of decimal places, calculated
                 * based off the options.tick_size. This will raiserror if
                 * options.tick_size is zero. */
                select
                    @tick_scale = - convert(int, round(log(a.tick_size) / log(10), 0))
                from
                    options a,
                    option_expirations b
                where
                    a.option_id = b.option_id
                and
                    b.option_expiration_id = @option_expiration_id
                /* Calculate the strike price text based on tick size */
                select
                    @option_strike = round(@option_strike, @tick_scale)
                select
                    @strike_text = case 
                        when @tick_scale = 6 then
                            convert(varchar(20), convert(numeric(30,6), @option_strike))
                        when @tick_scale = 5 then
                            convert(varchar(20), convert(numeric(30,5), @option_strike))
                        when @tick_scale = 4 then
                            convert(varchar(20), convert(numeric(30,4), @option_strike))
                        when @tick_scale = 3 then
                            convert(varchar(20), convert(numeric(30,3), @option_strike))
                        when @tick_scale = 2 then
                            convert(varchar(20), convert(numeric(30,2), @option_strike))
                        when @tick_scale = 1 then
                            convert(varchar(20), convert(numeric(30,1), @option_strike))
                        else
                            convert(varchar(20), convert(numeric(30,0), @option_strike))
                        end
                        
                /* Append a decimal if there isn't one already. */
                /*
                if charindex(".", @strike_text) = 0
                    select
                        @strike_text = @strike_text + "."
                /* Keep adding zeros until we have enough */
                while len(@strike_text) - charindex(".", @strike_text) <= @tick_scale
                    select
                        @strike_text = @strike_text + "0"
                */
                
                select
                    @option_contract_symbol = rtrim(convert(varchar(50), symbol)) + " " + @strike_text + " " + @option_put_call
                from
                    option_expirations
                where
                    option_expiration_id = @option_expiration_id
            end /* @option_contract_symbol = null */
            
            select
                @option_instrument_id = instrument_id
            from
                instruments
            where
                name = "Option"
            if @option_instrument_id = null
            begin
                rollback
                raiserror 91015, "'Option' instrument not found"
                return
            end
            
            /* ---------------- Create option contract ---------------- */
                
            exec 
                j_nextkey
                    "contracts",
                    @option_contract_id out
            
            insert into
                contracts
            values (
                @option_contract_id,
                @option_contract_symbol,
                @option_instrument_id
            )
            
            insert into
                option_contracts
            values (
                @option_contract_id,
                @option_expiration_id,
                @exercise_style_id,
                @option_strike,
                @option_put_call
            )
                
        end /* @option_contract_id = null */
    
    end /* no option but requested */
    
end /* @option_contract_id = null */



/*+---------------------------------------------------------------------------* 
 |                                 Downstream                                 | 
 *----------------------------------------------------------------------------*/

if @option_contract_id != null
begin
    if @instrument = null
        select
            @contract_id = a.contract_id,
            @instrument = b.name,
            @symbol = a.symbol
        from
            contracts a,
            instruments b
        where
            a.instrument_id = b.instrument_id
        and
            a.contract_id = @option_contract_id

    select
        @option_contract_symbol = b.symbol,
        @option_strike = a.strike,
        @option_put_call = a.put_call,
        @option_exercise_style = e.name,
        @option_expiration_id = a.option_expiration_id,
        @option_expiration = c.expiration,
        @option_expiration_symbol = c.symbol,
        @option_exchange = f.name,
        @option_quantity = d.quantity,
        @option_tick_size = d.tick_size,
        @option_id = d.option_id,
        @option_underlying_contract_id = d.underlying_contract_id,
        @option_underlying_contract = g.symbol,
        @option_underlying_instrument = h.name
    from
        option_contracts a,
        contracts b,
        option_expirations c,
        options d,
        exercise_styles e,
        exchanges f,
        contracts g,
        instruments h
    where
        a.contract_id = b.contract_id
    and
        a.option_expiration_id = c.option_expiration_id
    and
        c.option_id = d.option_id
    and
        a.exercise_style_id = e.exercise_style_id
    and
        d.exchange_id = f.exchange_id
    and
        d.underlying_contract_id = g.contract_id
    and
        g.instrument_id = h.instrument_id
    and
        a.contract_id = @option_contract_id
    
    if @option_underlying_instrument = "Forward"
        select
            @forward_id = @option_underlying_contract_id,
            @future_id = null
            
    else if @option_underlying_instrument = "Future"
        select
            @future_contract_id = @option_underlying_contract_id
            
    else
    begin
        rollback
        raiserror 91016, "Option's underlying is neither a Forward nor Future"
        return
    end
    
end

if @future_contract_id != null
begin
    if @instrument = null
        select
            @contract_id = a.contract_id,
            @instrument = b.name,
            @symbol = a.symbol
        from
            contracts a,
            instruments b
        where
            a.instrument_id = b.instrument_id
        and
            a.contract_id = @future_contract_id
            
    select
        @future_id = a.future_id,
        @future_expiration = a.expiration,
        @future_contract_symbol = b.symbol,
        @forward_id = c.forward_id,
        @future_symbol = /* FEATURE: futures.symbol: c.symbol */c.root_symbol,
        @future_exchange_id = c.exchange_id,
        @future_exchange = d.name,
        @future_quantity = c.quantity,
        @future_tick_size = c.tick_size /* FEATURE: futures.price_scale,
        @future_price_scale = c.price_scale */
    from
        future_contracts a,
        contracts b,
        futures c,
        exchanges d
    where
        a.contract_id = b.contract_id
    and
        a.future_id = c.future_id
    and
        c.exchange_id = d.exchange_id
    and
        a.contract_id = @future_contract_id
end

if @forward_id != null
begin
    if @instrument = null
        select
            @contract_id = a.contract_id,
            @instrument = b.name,
            @symbol = a.symbol
        from
            contracts a,
            instruments b
        where
            a.instrument_id = b.instrument_id
        and
            a.contract_id = @forward_id
            
    select
        @forward_symbol = b.symbol,
        @forward_exchange = c.name,
        @currency_id = a.currency_id,
        @currency = d.symbol,
        @product_id = a.product_id,
        @product = e.symbol,
        @product_name = e.name,
        @product_type = f.name
    from
        forwards a,
        contracts b,
        exchanges c,
        products d,
        products e,
        product_types f
    where
        a.contract_id = b.contract_id
    and
        a.exchange_id = c.exchange_id
    and
        a.currency_id = d.product_id
    and
        a.product_id = e.product_id
    and
        e.product_type_id = f.product_type_id
    and
        a.contract_id = @forward_id
end

