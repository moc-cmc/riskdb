/* 
 * Ensure that if we have a @source_id that we store the symbol
 */
if @source_id != null and @source_symbol != null
begin
    if not exists (
            select 
                *
            from
                contract_symbols
            where
                contract_id = @contract_id 
            and
                source_id = @source_id
        )
    begin
        insert into
            contract_symbols
        values (
            @contract_id,
            @source_id,
            @source_symbol
        )
    end
    else if not exists (
            select 
                *
            from
                contract_symbols
            where
                contract_id = @contract_id 
            and
                source_id = @source_id
            and 
                symbol = @source_symbol
        )
    begin
        update 
            contract_symbols
        set
            symbol = @source_symbol
        where
            contract_id = @contract_id
        and
            source_id = @source_id
    end
end

