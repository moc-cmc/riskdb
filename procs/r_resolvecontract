
if object_id("r_resolvecontract") != NULL
    drop procedure
        r_resolvecontract
go

create procedure
	r_resolvecontract
        @login varchar(50) = NULL,
        @source varchar(50) = NULL,
        
        @contract_id int = null out,
        @symbol varchar(50) = null out,
        @instrument varchar(35) = null out,
        @source_symbol varchar(50) = null out,
        
        /* Product */
        @currency_id int = null out,
        @currency varchar(20) = null out,
        @product_id int = null out,
        @product varchar(20) = null out,
        @product_name varchar(100) = null out,
        @product_type varchar(25) = null out,
        
        /* Forwards: */
        @forward_id int = null out,
        @forward_quantity int = 1 out,
        @forward_exchange varchar(50) = null out,
        @forward_symbol varchar(50) = null out,
        
        /* Futures: */
        @future_id int = null out,
        @future_symbol varchar(50) = null out,
        @future_exchange varchar(50) = null,
        @future_quantity int = 1 out,
        @future_tick_size float = 0.01 out,
        @future_price_scale float = 2.0 out,
        @future_contract_id int = null out,
        @future_expiration datetime = null out,
        @future_contract_symbol varchar(50) = null out,
        
        /* Options: */
        @option_id int = null out,
        @option_underlying_contract varchar(50) = null out,
        @option_underlying_contract_id int = null out,
        @option_underlying_instrument varchar(25) = null out,
        @option_exchange varchar(50) = null out,
        @option_exercise_style varchar(50) = "European" out,
        @option_quantity int = 1 out,
        @option_tick_size float = 0.01 out,
        @option_expiration_id int = null out,
        @option_expiration_symbol varchar(50) = null out,
        @option_expiration datetime = null out,
        @option_contract_id int = null out,
        @option_strike float = null out,
        @option_put_call char(1) = null out,
        @option_contract_symbol varchar(50) = null out,
        
        /* All contracts: */
        @price_factor float = null out,
        @price_style varchar(25) = null out,
        
        @parameters varchar(150) = null,
        @error varchar(150) = null out,
        
        @create char(1) = NULL out,
        @report char(1) = NULL
as

declare @source_id int
declare @currency_name varchar(100)
declare @forward_instrument_id int
declare @future_instrument_id int
declare @option_instrument_id int
declare @product_type_id int
declare @forward_exchange_id int
declare @future_exchange_id int
declare @option_exchange_id int
declare @exercise_style_id int
declare @buf varchar(50)
declare @month_code char(1)
declare @year_code char(1)
declare @symbol_future_expiration datetime
declare @future_year int
declare @tick_scale int
declare @strike_text varchar(20)
declare @expiration_text varchar(10)
declare @is_option bit
declare @audit_log_id numeric(10,0)
declare @note varchar(250)
declare @created bit

declare @exec_sql varchar(1024)

/*
select
    "declare @contract_id int exec r_resolvecontract @contract_id out",
    case when @symbol != null then ", @symbol = '" + @symbol + "'" else "" end,
    case when @instrument != null then ", @instrument = '" + @instrument + "'" else "" end,
    case when @source != null then ", @source = '" + @source + "'" else "" end,
    case when @source_symbol != null then ", @source_symbol = '" + @source_symbol + "'" else "" end,
    case when @currency_id != null then ", @currency_id = " + convert(varchar(50), @currency_id) else "" end,
    case when @currency != null then ", @currency = '" + @currency + "'" else "" end,
    case when @product_id != null then ", @product_id = " + convert(varchar(50), @product_id) else "" end,
    case when @product != null then ", @product = '" + @product + "'" else "" end,
    case when @product_name != null then ", @product_name = '" + @product_name + "'" else "" end,
    case when @product_type != null then ", @product_type = '" + @product_type + "'" else "" end,
    case when @forward_id != null then ", @forward_id = " + convert(varchar(50), @forward_id) else "" end,
