drop procedure
	r_addemail
go

create procedure
	r_addemail
		@login varchar(50),
		@email varchar(50)

as

declare @tico_account_id int
declare @email_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = -1,
		error = "Problem deterimining login"
	return
end

exec
	j_nextkey
		"emails",
		@email_id output

insert into 
emails
	(email_id, email)
values	(
	@email_id,
	@email
	)

if @@rowcount != 1
begin
        select
                id = -1,
                msg = "Problem creating email",
                email = @email
        return
end

