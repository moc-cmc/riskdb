
if object_id("mc_tallyswap") != NULL
    drop procedure
        mc_tallyswap
go

create procedure
	mc_tallyswap
		@login char(25),
		@trader varchar(10),
		@strategy varchar(100),
		@broker varchar(100),
		@biproduct  char(25),
		@quantity numeric(30,6),
		@near_date	datetime = NULL,
		@near_price float,	
		@far_date	datetime = NULL,
		@far_price	float,
		@trade_date datetime
/*


		@login char(25),
		@symbol char(25),
		@quantity numeric(30,6),
		/*  @externalaccount char(25), */
		@strategy varchar(100),
		@trader varchar(10),
		@near_price float,
		@near_date datetime = NULL,
		@far_date datetime = NULL,
		@far_price float,
		@trade_date datetime

*/

as

declare @account_id int
declare @contract_id int
declare @internal_account_id int
declare @external_account_id int
declare @closing_trade_id int
declare @roll_trade_id int
declare @deal_id int
declare @trade_quantity numeric(30,0)
declare @price_style char(100)
/* declare @trade_date datetime */
declare @strategy_id int
declare @trader_id int
declare @internal_account char(50)
declare @fund_id int
declare @active_status_id int
declare @remainder_quantity numeric(30,0)
declare @allocation	float
declare @ext_spot_allocation_id int
declare @broker_id int
declare @symbol varchar(25)

select @symbol=@biproduct

exec
    r_defaultfundforlogin
        @login,
        @fund_id output

if @fund_id = NULL
begin
    select
        id = -1,
        error = "Problem finding default fund for user"
    return
end

select
	@broker_id=broker_id
from
	brokers
where
	symbol=@broker
if @@rowcount != 1
begin
	select  
		id = -1,
		error = "Problem finding broker id for broker ",
		broker = @broker
	return
end

select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy 
if @@rowcount != 1
	raiserror 999999 "Problem finding the currency rollover trade strategy"

select
	@trade_quantity = convert(numeric(30,0), @quantity)

select
	@trade_date = convert(char(2), datepart(month, @trade_date)) + "/" +
		convert(char(2), datepart(day, @trade_date)) + "/" +
		convert(char(4), datepart(year, @trade_date))

/* select  
	@trade_date = dateadd(hour, 16, @trade_date) */

select
	@account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select 	
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol=@trader
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding trader"
	return
end

/*
	
select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @externalaccount
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding external account with symbol", 
		symbol = @externalaccount
	return
end

*/

select
	@internal_account_id = a.internal_account_id
from
	internal_accounts a,
	funds b
where
	a.symbol=b.name

if @@rowcount != 1
begin
	select 
		id=-1,
		error="Problem finding internal account"
	return
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract with symbol",
		symbol = @symbol
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id

if @price_style = "Inverted"
begin
	select
		@near_price = 1 / @near_price,
		@far_price = 1 / @far_price
end

select
        @active_status_id=status_id
from
        statuses
where
        name="Active"
if @@rowcount < 1
begin
        select
                id = -1,
                error = "Could not find Active Status"
        return
end

/* select
	@trade_date = getdate() */

if @near_date = NULL
begin
	exec
		r_nextbusinessday
			@trade_date,
			@near_date output
	if @symbol != "CADUSD" and @symbol != "USDCAD"
	exec
		r_nextbusinessday
			@near_date,
			@near_date output
end

select
	@near_date = convert(char(2), datepart(month, @near_date)) + "/" +
		convert(char(2), datepart(day, @near_date)) + "/" +
		convert(char(4), datepart(year, @near_date))

select
	@far_date = convert(char(2), datepart(month, @far_date)) + "/" +
		convert(char(2), datepart(day, @far_date)) + "/" +
		convert(char(4), datepart(year, @far_date))
begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "deals"

	select
		@deal_id = last_id
	from
		keys
	where
		relation = "deals"


	insert into
		deals
	values(
		@deal_id,
		getdate())
commit tran

select
    @remainder_quantity = @quantity

declare allocations cursor for
	select
		ext_spot_allocation_id,
		external_account_id,
		internal_account_id,
		percentage
	from
		external_spot_allocations
	where
		fund_id=@fund_id
	order by
		ext_spot_allocation_id

open allocations

fetch allocations into @ext_spot_allocation_id, @external_account_id, @internal_account_id, @allocation

while @@sqlstatus = 0
begin

	select
		@trade_quantity = @quantity * @allocation

	select @remainder_quantity = @remainder_quantity - @trade_quantity
		
	begin tran

		begin tran
	
			update 
				keys
			set
				last_id=last_id + 2
			where
				relation="trades"
			select
				@roll_trade_id=last_id
			from
				keys
			where
				relation="trades"

			select @closing_trade_id=@roll_trade_id - 1

		commit tran

		insert into
			trades
		values(
			@closing_trade_id,
			@deal_id,
			@account_id,
			@internal_account_id,
			@external_account_id,
			@trade_quantity,
			@contract_id,
			@near_price,
			@trade_date,
			@trader_id,
			@strategy_id,
			@active_status_id,
			@broker_id)
		if @@rowcount != 1
		begin
			select
				id = -1,
				error = "Problem adding closing trade"
			rollback tran
			return
		end

		insert into
			trade_value_dates
		values(
			@closing_trade_id,
			@near_date)

		insert into
			trade_types
		values(
			@closing_trade_id,
			"1") 				/* 1 is for type Swap first leg */

		insert into
			trades
		values(
			@roll_trade_id,
			@deal_id,
			@account_id,
			@internal_account_id,
			@external_account_id,
			-@trade_quantity,
			@contract_id,
			@far_price,
			@trade_date,
			@trader_id,
			@strategy_id,
			@active_status_id,
			@broker_id)
		if @@rowcount != 1
		begin
			select
				id = -1,
				error = "Problem adding roll trade"
			rollback tran
			return
		end

		insert into
			trade_value_dates
		values(
			@roll_trade_id,
			@far_date)

		insert into
			trade_types
		values(
			@roll_trade_id,
			"2")			/* 2 is for type Swap second leg */

	
commit tran

fetch allocations into @ext_spot_allocation_id, @external_account_id, @internal_account_id, @allocation

end

close allocations
deallocate allocations

select
    @internal_account_id = remainder_int_account_id,
    @external_account_id = remainder_ext_account_id
from
    external_spot_allocations
where
    ext_spot_allocation_id = @ext_spot_allocation_id
if @@rowcount != 1
begin
    select
        @internal_account_id = spot_internal_account_id,
        @external_account_id = spot_external_account_id
    from
        default_accounts
    where
        tico_account_id = @account_id
end

begin tran
    update
        keys
    set
        last_id = last_id + 2 
    where
        relation = "trades"
    select
        @roll_trade_id = last_id
    from
        keys
    where
        relation = "trades"

	select
		@closing_trade_id = @roll_trade_id - 1

commit tran

begin tran

		insert into
            trades
        values(
            @closing_trade_id,
            @deal_id,
            @account_id,
            @internal_account_id,
            @external_account_id,
            @remainder_quantity,
            @contract_id,
            @near_price,
            @trade_date,
            @trader_id,
            @strategy_id,
            @active_status_id,
            @broker_id)
        if @@rowcount != 1
        begin
            select
                id = -1,
                error = "Problem adding closing trade"
            rollback tran
            return
        end

        insert into
            trade_value_dates
        values(
            @closing_trade_id,
            @near_date)

        insert into
            trade_types
        values(
            @closing_trade_id,
            "1")                /* 1 is for type Swap 1st leg */

		
		insert into
            trades
        values(
            @roll_trade_id,
            @deal_id,
            @account_id,
            @internal_account_id,
            @external_account_id,
            -@remainder_quantity,
            @contract_id,
            @far_price,
            @trade_date,
            @trader_id,
            @strategy_id,
            @active_status_id,
            @broker_id)
        if @@rowcount != 1
        begin
            select
                id = -1,
                error = "Problem adding roll trade"
            rollback tran
            return
        end

        insert into
            trade_value_dates
        values(
            @roll_trade_id,
            @far_date)

        insert into
            trade_types
        values(
            @roll_trade_id,
            "2")   				/* 2 is for type Swap 2nd leg */

commit tran

insert into
    deal_notifications
    (source_id,
     deal_id,
     status_id,
     capture_date,
     notify_date,
     error)
values
    (1,
     @deal_id,
     @active_status_id,
     getdate(),
     getdate(),
     "")

exec
	r_inspectdeal
			@deal_id

/*
exec
	r_inspecttrade
		@closing_trade_id

exec
	r_inspecttrade
		@roll_trade_id	
*/

go
