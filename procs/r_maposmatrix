use
	risk_ram
go

drop procedure
	r_maposmatrix
go


create procedure
	r_maposmatrix
		@login varchar(50),
		@trade_date datetime=NULL
as


declare @begin_date datetime
declare @end_date datetime 
declare @run_id int
declare @sql varchar(500)
declare @ext_account varchar(50)
declare @external_account_id int
declare @external_accounts int
declare @fund_name varchar(50)
declare @fund_id int
declare @final_select varchar(500)
declare @previous_day datetime

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)


insert into
	#meta
values(
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"trade_date",
	"Position Matrix",
	NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)


select * from #meta


exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@fund_name = name
from
	funds
where
	fund_id = @fund_id

if @fund_name = NULL
begin
	select
		status = "Error",
		message = "No default fund found"
	return
end

if @trade_date = NULL
	select
		@trade_date = getdate()


exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


select
	@previous_day = convert(datetime, convert(date, @begin_date))

select
	msg = "Run Previous Day",
	trade_date = convert(varchar(11), @previous_day)


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders	
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies	
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts	
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts	

create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers	

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#positions(
		external_account_id int,
		contract_id int,
		quantity numeric(30,4),
		contract_total numeric(30,4) NULL,
		pct float NULL)


insert into
	#positions(
		external_account_id,
		contract_id,
		quantity)
select
	a.external_account_id,
	a.contract_id,
	sum(a.quantity)
from
	trades a,
	#traders b,
	#strategies c,
	#external_accounts d,
	#internal_accounts e,
	#brokers f,
	#counterparties g
where
	a.trader_id = b.trader_id
and
	a.strategy_id = c.strategy_id
and
	a.external_account_id = d.external_account_id
and
	a.internal_account_id = e.internal_account_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date < @end_date
and
	a.value_date >= @begin_date
group by
	a.external_account_id,
	a.contract_id

create table
	#contract_totals(
		contract_id int,
		contract_total numeric(30,4))
insert into
	#contract_totals
select
	contract_id,
	sum(quantity)
from
	#positions
group by
	contract_id

update
	#positions
set
	a.contract_total = b.contract_total
from
	#positions a,
	#contract_totals b
where
	a.contract_id = b.contract_id

update
	#positions
set
	pct = quantity / contract_total
where
	contract_total != 0.0




create table
	#matrix(
		style varchar(255) NULL,
		contract_id int,
		symbol varchar(50) NULL,
		underlying_contract_id int NULL,
		underlying varchar(50) NULL,
		expiration datetime NULL)

insert into
	#matrix(
		contract_id)
select
	distinct(contract_id)
from
	#positions

update
	#matrix
set
	a.symbol = b.symbol
from
	#matrix a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#matrix
set
	style = "background:#fff;border: 1px solid white"

update
	#matrix
set
	a.underlying_contract_id = b.contract_id,
	a.expiration = @end_date
from
	#matrix a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#matrix
set
	a.underlying_contract_id = b.contract_id,
	a.expiration = b.expiration
from
	#matrix a,
	future_contracts b
where
	a.contract_id = b.contract_id


update
	#matrix
set
	a.underlying_contract_id = d.underlying_contract_id,
	a.expiration = c.expiration
from
	#matrix a,
	option_contracts b,
	option_expirations c,
	options d
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id

update
	#matrix
set
	a.underlying = b.symbol
from
	#matrix a,
	contracts b
where
	a.underlying_contract_id = b.contract_id


select
	@final_select = "select style, symbol, "

create table
	#ext_accounts(
		external_account_id int)
insert into
	#ext_accounts
select
	distinct(external_account_id)
from
	#positions


select
	@external_account_id = 0
select
	@external_accounts = count(*)
from
	#ext_accounts
where
	external_account_id > @external_account_id

while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		#ext_accounts
	where
		external_account_id > @external_account_id


	select
		@ext_account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id


	select
		@ext_account = convert(char(1), @fund_name) + rtrim(@ext_account)
	select
		@sql = "alter table #matrix add " + rtrim(@ext_account) + " float NULL"

	select
		@final_select = rtrim(@final_select) + rtrim(@ext_account)

	if @external_accounts != 1
		select
			@final_select = @final_select + ",  "
			
	exec(@sql)

	select
		@sql = "update #matrix set a." + rtrim(@ext_account) + " = " + "convert(numeric(30,0), b.quantity) from #matrix a, #positions b where a.contract_id = b.contract_id and b.external_account_id = " + rtrim(convert(varchar(30), @external_account_id)) 


	exec(@sql)


	select
		@external_accounts = count(*)
	from
		#ext_accounts
	where
		external_account_id > @external_account_id

end

select
	@final_select = @final_select + " from #matrix order by underlying, expiration, symbol"


exec(@final_select)


go

