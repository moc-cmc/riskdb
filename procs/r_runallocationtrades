drop procedure r_runallocationtrades
go

create procedure
        r_runallocationtrades
                @login varchar(50),
                @run_name varchar(25)=NULL,
                @begin_date datetime=NULL,
                @end_date datetime=NULL

as

/* META information */
create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)

insert into
        #links
values(
        "Column Hidden",
        "begin_date",
        NULL,
        NULL,
        NULL)

insert into
        #links
values(
        "Column Hidden",
        "end_date",
        NULL,
        NULL,
        NULL)

insert into
        #links
values(
        "Column Link",
        "run_name",
        "Allocation Trades",
        NULL,
        NULL)

select * from #links
select
	run_name = a.name,
	begin_date = @begin_date,
	end_date = @end_date
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
if @@rowcount = 0
begin
	select
		"error"="No run(s) defined for user",
		"user"=@login
	return
end

go
