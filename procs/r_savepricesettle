drop procedure
	r_savepricesettle

go

create procedure
	r_savepricesettle
		@settle_date datetime=NULL

as

declare @contract_id int
declare @price float
declare @price_id int
declare @date datetime
declare @day char(2)
declare @month char(2)
declare @year char(4)
declare @datestring char(22)

if @settle_date = NULL
begin

select
	@day = convert(char(2), datepart(day, getdate())),	
	@month = convert(char(2), datepart(month, getdate())),	
	@year = convert(char(4), datepart(year, getdate()))
select
	@datestring = @month + "/" + @day + "/" + @year + " 17:00"
select
	@settle_date = convert(datetime, @datestring)
end


create table
	#contract_prices(
		contract_id int,
		price float
)

create table
	#inverted_contracts(
		contract_id int
)

create table
	#usd_products(
		symbol varchar(50),
		contract_id int,
		product_id int,
		currency_id int,
		price float
)

create table
        #usd_currencies(
		symbol varchar(50),
                contract_id int,
                product_id int,
                currency_id int,
		price float
)

create table
	#cross_currencies(
                symbol varchar(50),
                contract_id int,
                product_id int,
                currency_id int,
		price float NULL,
)


insert into 
	#contract_prices
select
	contract_id,
	price
from
	prices
where
	price_date = @settle_date


insert into
	#inverted_contracts
select
	a.contract_id 
from
	contract_price_styles a,
	price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.name = "Inverted"


insert into
	#usd_products
select
	a.symbol,
	a.contract_id,
	b.product_id,
	b.currency_id,
	d.price
from
	contracts a,
	forwards b,
	products c,
	#contract_prices d
where
	a.contract_id = b.contract_id
and
	a.contract_id = d.contract_id
and
	b.product_id = c.product_id
and
	c.symbol = "USD"
and
	a.contract_id not in(
		select
			contract_id
		from	
			#inverted_contracts)

insert into
        #usd_currencies
select
	a.symbol,
        a.contract_id,
        b.product_id,
        b.currency_id,
	d.price
from
        contracts a,
        forwards b,
        products c,
	#contract_prices d
where
        a.contract_id = b.contract_id
and
	a.contract_id = d.contract_id
and
        b.currency_id = c.product_id
and
        c.symbol = "USD"
and
        a.contract_id not in(
                select
                        contract_id
                from
                        #inverted_contracts)

insert into
        #cross_currencies
select
        a.symbol,
        a.contract_id,
        b.product_id,
        b.currency_id,
        NULL
from
        contracts a,
        forwards b,
        products c,
	products e
where
        a.contract_id = b.contract_id
and
	b.product_id = c.product_id
and
	b.currency_id = e.product_id
and
        c.symbol != "USD"
and
	e.symbol != "USD"
and
        a.contract_id not in(
                select
                        contract_id
                from
                        #inverted_contracts)


insert into
	#usd_products
select
	b.symbol,
	a.contract_id,
	a.product_id,
	a.currency_id,
	1/c.price
from
	forwards a,
	contracts b,
	#usd_currencies c
where
	a.product_id = c.currency_id
and
	a.currency_id = c.product_id
and
	a.contract_id = b.contract_id


update 
	#cross_currencies
set
	price = c.price/b.price
from
	#cross_currencies a,
	#usd_products b,
	#usd_products c
where
	a.product_id = b.currency_id
and
	a.currency_id = c.currency_id

create table
	#prices(
		contract_id int,
		symbol varchar(50),
		price float NULL
)


insert into 
	#prices
select
	contract_id,
	symbol,
	price
from
	#usd_products
where
	price != NULL
and
        contract_id not in(
                select
                        contract_id
                from
                        #inverted_contracts)

insert into
	#prices
select
        contract_id,
        symbol,
        price
from
	#usd_currencies
where
	price != NULL
and
        contract_id not in(
                select
                        contract_id
                from
                        #inverted_contracts)


insert into 
        #prices
select
        contract_id,
        symbol,
        price
from
        #cross_currencies
where
	price != NULL
and
        contract_id not in(
                select
                        contract_id
                from
                        #inverted_contracts)
	

select * from #prices
select * From #cross_currencies


