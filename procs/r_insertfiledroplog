create or replace procedure
	r_insertfiledroplog
		@run varchar(50),
		@destination varchar(50),
		@report varchar(50),
		@filename varchar(100)

as

declare @run_id int
declare @filedrop_destination_id int
declare @filedrop_report_id int
declare @already_reported varchar(1)

select
	@filedrop_destination_id = filedrop_destination_id
from
	filedrop_destinations
where
	name = @destination
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "Could not find destination",
		destination = @destination
	return
end

select
	@filedrop_report_id = filedrop_report_id
from

	filedrop_reports
where
	name = @report
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "Could not find report",
		report = @report
	return
end

select
	@run_id = run_id
from
	runs
where
	name = @run
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "Could not find run",
		run = @run
	return
end

select
	@already_reported = "Y"
from
	filedrop_report_logs
where
	run_id = @run_id
and
	filedrop_report_id = filedrop_report_id
and
	filedrop_destination_id = @filedrop_destination_id
and
	filename = @filename

if @already_reported = "Y"
begin
	select
		status = "Error",
		msg = "Filedrop log has already been saved",
		run_id = @run_id,	
		filedrop_report_id = @filedrop_report_id,
		filedrop_destination_id = @filedrop_destination_id,
		filename = @filename
	return
end
else
begin
	insert into
		filedrop_report_logs(
			filedrop_report_id,
			run_id,
			filedrop_destination_id,
			capture_date,
			filename)
	select
		@filedrop_report_id,
		@run_id,
		@filedrop_destination_id,
		getdate(),
		@filename
end


go
		
		
