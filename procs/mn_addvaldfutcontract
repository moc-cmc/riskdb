use
	risk_cc
go

drop procedure
	mn_addvaldfutcontract
go

create procedure
	mn_addvaldfutcontract
		@login varchar(50),
		@name varchar(50),
		@expiration_date datetime,
		@yymmdd_code varchar(6)=NULL
as

if @yymmdd_code = NULL
begin
	select
		section = "Error", 
		message = "Must provide yymmdd_code. Suggested formaty is YYMMDD. This code will be appended to the end of the root symbol to identify the contract."

exec
        mn_futuremonths
                @login,
                @name

return
end

declare @future_id int
declare @contract_id int
declare @instrument_id int
declare @symbol varchar(50)
declare @root_symbol varchar(50)
declare @year varchar(2)

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Future"
if @instrument_id = NULL
begin
	select
		status = "Error",
		message = "Future instrument not found"
	return
end


select
	@future_id = future_id,
	@root_symbol = root_symbol
from
	futures
where
	name = @name
if @future_id = NULL
begin
	select
		status = "Error",
		message = "Future not found",
		name = @name
	return
end

select
	@symbol = rtrim(@root_symbol) + rtrim(@yymmdd_code)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id != NULL
begin
	select
		status = "Error",
		message = "Contract already exists",
		symbol = @symbol
	return
end

exec
	j_nextkey
		"contracts",
		@contract_id output

begin tran
	insert into
		future_contracts
	values(
		@contract_id,
		@future_id,
		@expiration_date)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add future contract",
			name = @name,
			symbol = @symbol
		rollback tran
		return
	end

	insert into
		contracts
	values(
		@contract_id,
		@symbol,
		@instrument_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add contract",
			name = @name,
			symbol = @symbol
		rollback tran
		return
	end
commit tran


exec
	mn_futuremonths
		@login,
		@name
	


go


	

