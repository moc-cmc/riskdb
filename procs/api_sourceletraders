create or replace procedure
	api_sourceletraders
		@legal_entity varchar(150),
		@source varchar(50)
		

as

declare @legal_entity_id int
declare @source_id int

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @legal_entity_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding legal entity provided"
	return	
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source provided"
	return	
end

select
	a.legal_entity_id,
	c.account_id,	
	c.given_names,
	c.surname,
	c.login,
	email = j.email,
	phone = k.phone_number,
	trader_id = f.trader_id,
	trader_name = f.symbol,
	trader_symbol = g.symbol,
	section = "Client Users"
from
	legal_entities a,
	legal_entity_tico_accounts b,
	tico_accounts c,
	tico_account_types d,
	login_types e,
	traders f,
	trader_symbols g,
	statuses h,
	user_emails i,
	emails j,
	cognito_users  k
where
	a.legal_entity_id = b.legal_entity_id
and
	a.status_id = h.status_id
and
	b.tico_account_id = c.account_id
and
	a.legal_entity_id = @legal_entity_id 
and
	c.account_id = d.tico_account_id
and
	d.login_type_id = e.login_type_id
and
	f.tico_account_id = c.account_id
and
	f.trader_id = g.trader_id
and
	i.tico_account_id = c.account_id
and
	i.email_id = j.email_id
and
	k.tico_account_id = c.account_id	
and
	g.source_id = @source_id
and
	a.legal_entity_id = @legal_entity_id
and
	h.name = "Approved"
and
	e.name = "Client"



go
