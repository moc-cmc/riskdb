drop procedure
	ag_editpipspreadoverrides
go

create procedure
	ag_editpipspreadoverrides
		@login varchar(50),
		@account varchar(200)=NULL
as

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)



create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_spread",
	"Edit Account Contract Spread Override",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"back_to_manager",
	"Pip Spread Manager",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"spread",
	"Number",
	"#,##0.000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"template_spread",
	"Number",
	"#,##0.000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"override_diff",
	"Number",
	"#,##0.000000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


create table
	#output(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		pip_spread_id int NULL,
		account varchar(200) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		spread numeric(30,10) NULL,
		edit_spread varchar(50) NULL,
		template_spread numeric(30,10) NULL)
insert into
	#output(
		contract_id,
		symbol)
select
	a.contract_id,
	a.symbol
from
	contracts a,
	forwards b,
	products c,
	product_types d
where
	a.contract_id = b.contract_id
and
	b.product_id = c.product_id
and
	c.product_type_id = d.product_type_id
and
	d.name = "Currency"
order by
	a.symbol

/* MARKR disabled in favor of allowing schedules for inverted pairs 
delete
	#output
from
	#output a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted" */

update
	#output
set
	style = @style,
	account = @account,
	edit_spread = "Edit"

update
	#output
set
	a.external_account_id = b.external_account_id,
	a.pip_spread_id = b.pip_spread_id
from
	#output a,
	external_accounts b
where
	a.account = b.symbol
		

update
	#output
set
	a.template_spread = b.pip_spread
from
	#output a,
	pip_spread_contracts b
where
	a.pip_spread_id = b.pip_spread_id
and
	a.contract_id = b.contract_id

update
	#output
set
	a.spread = b.pip_spread
from
	#output a,
	pip_spread_overrides b
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = b.contract_id

select
	style = @style,
	back_to_manager = "Back To Pip Spread Manager"

select
	section = "Overrides",
	style,
	account,
	symbol,
	template_spread,
	spread,
	edit_spread,
	override_diff = spread - template_spread
from
	#output
order by
	id


go
