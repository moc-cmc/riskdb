use
	risk_elad2
go

drop procedure
	r_importeladforwards
go

create procedure
	r_importeladforwards
		@login varchar(50),
		@username varchar(50)=NULL,
		@deal_type varchar(50)=NULL,
		@value_date varchar(50)=NULL,
		@buy_ccy varchar(50)=NULL,
		@buy_amount varchar(50)=NULL,
		@sell_ccy varchar(50)=NULL,
		@sell_amount varchar(50)=NULL,
		@spot varchar(50)=NULL,
		@pips varchar(50)=NULL,
		@final_rate varchar(50)=NULL,
		@market_rate varchar(50)=NULL,
		@p_l varchar(50)=NULL,
		@trade_date varchar(50)=NULL,
		@deal_no varchar(50)=NULL,
		@enter_date varchar(50)=NULL,
		@bank varchar(50)=NULL,
		@lock_no varchar(50)=NULL,
		@delta_amount_major varchar(50)=NULL,
		@delta_amount_minor varchar(50)=NULL,
		@major_ccy varchar(50)=NULL
as

declare @symbol varchar(50)
declare @trade_id int
declare @deal_id int
declare @dealt_ccy varchar(50)
declare @counter_ccy varchar(50)
declare @buy_sell varchar(50)
declare @quantity_string varchar(50)
declare @counter_quantity_string varchar(50)
declare @quantity numeric(30,4)
declare @counter_quantity numeric(30,4)
declare @buy_amount_string varchar(50)
declare @sell_amount_string varchar(50)
declare @price float
declare @val_date datetime
declare @traded_date datetime
declare @source_id int
declare @external_account varchar(50)


if @sell_ccy = NULL or @sell_ccy = ""
	return

select
	@source_id = source_id
from
	sources
where
	name = "Elad"
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Elad source not found"
	return
end

select
	@external_account = b.symbol
from
	external_account_symbols a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.source_id = @source_id
and
	a.symbol = @username
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @username
	return
end


select
	@val_date = convert(datetime, @value_date),
	@traded_date = convert(datetime, @trade_date)

exec
	u_stripcommas
		@buy_amount,
		@buy_amount_string output

exec
	u_stripcommas
		@sell_amount,
		@sell_amount_string output


if @major_ccy = @buy_ccy
	select
		@dealt_ccy = @buy_ccy,
		@counter_ccy = @sell_ccy,
		@buy_sell = "Buy",
		@quantity_string = @buy_amount_string,
		@counter_quantity_string = @sell_amount_string

if @major_ccy = @sell_ccy
	select
		@dealt_ccy = @sell_ccy,
		@counter_ccy = @buy_ccy,
		@buy_sell = "Sell",
		@quantity_string = @sell_amount_string,
		@counter_quantity_string = @buy_amount_string
	

select
	@quantity = convert(numeric(30,4), @quantity_string),
	@counter_quantity = convert(numeric(30,4), @counter_quantity_string)

select
	@price = @counter_quantity / @quantity

if @buy_sell = "Sell"
	select
		@quantity = @quantity * -1

select
	@symbol = rtrim(@dealt_ccy) + rtrim(@counter_ccy)

select
	buy_sell = @buy_sell,
	symbol = @symbol,
	quantity = @quantity,
	val_date = @val_date



exec
	fxa_tallytrade
		@login = "akahanov@eladgroup",
		@source = "Elad",
		@identifier = @deal_no,
		@trade_id = @trade_id output,
		@external_account = @external_account,
		@deal_id = @deal_id output,
		@tally_type = "Forward",
		@deal_type = "Market Forward",
		@trade_type = "Forward",
		@strategy = "SPEC",
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @val_date,
		@price = @price,
		@trade_date = @traded_date,
		@sales_code = "None"



go
