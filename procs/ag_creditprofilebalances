drop procedure ag_creditprofilebalances
go

create procedure
	ag_creditprofilebalances
		@login varchar(50),
		@trade_date datetime=NULL,
		@source varchar(50)=NULL
as

declare @begin_date datetime
declare @end_date datetime
declare @usd_product_id int
declare @max_dsl float
declare @dsl_credit_profile int
declare @fund_id int
declare @source_id int


exec
	r_defaultfundforlogin
		@login,
		@fund_id output


/* chriso: Exclude trades from today's trade date. The credit file should
   be used to generate the start of day positions as of the given trade
   date. Therefore, if we pass in "2015/07/23", we only want trades that
   occurred before "2015/07/22 5:00PM"

   this can be achieved by calling previous business day on the end date
   since end_date corresponds with trade date in the query 
*/
if @trade_date = NULL
	select
		@trade_date = getdate()

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

exec
	r_prevbusinessday
		@end_date,
		@end_date output

select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"
	

create table
	#trades(
		credit_profile_id int,
		trade_id int,
		external_account_id int,
		product_amount numeric(30,4),
		currency_amount numeric(30,4),
		contract_id int,
		product_id int NULL,
		currency_id int NULL,
		price float)
insert into
	#trades (
		credit_profile_id,
		trade_id,
		external_account_id,
		product_amount,
		currency_amount,
		contract_id,
		product_id,
		currency_id,
		price)
select
	b.credit_profile_id,
	a.trade_id,
	a.external_account_id,
	a.quantity,
	a.quantity * a.price * -1.0,
	a.contract_id,
	c.product_id,
	c.currency_id,
	a.price
from
	trades a,
	credit_profile_accounts b,
	forwards c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.value_date > @begin_date
and
	a.trade_date <= @end_date 

insert into
	#trades (
		credit_profile_id,
		trade_id,
		external_account_id,
		product_amount,
		currency_amount,
		contract_id,
		product_id,
		currency_id,
		price)
select
	b.credit_profile_id,
	a.trade_id,
	a.external_account_id,
	a.quantity,
	a.quantity * a.price * -1.0,
	a.contract_id,
	c.product_id,
	c.currency_id,
	a.price
from
	trades a,
	credit_profile_counterparties b,
	forwards c
where
	a.counterparty_id = b.counterparty_id
and
	a.contract_id = c.contract_id
and
	a.value_date > @begin_date
and
	a.trade_date <= @end_date 

create table
	#balances(
		credit_profile_id int,
		product_id int,
		amount float NULL)
insert into
	#balances(
		credit_profile_id,
		product_id,
		amount)
select
	credit_profile_id,
	product_id,
	product_amount
from
	#trades
group by
	credit_profile_id,
	product_id

insert into
	#balances(
		credit_profile_id,
		product_id,
		amount)
select
	credit_profile_id,
	currency_id,
	currency_amount
from
	#trades
group by
	credit_profile_id,
	currency_id


create table
	#credit_profile_balances(
		credit_profile_id int,
		product_id int,
		amount float)
insert into
	#credit_profile_balances(
		credit_profile_id,
		product_id,
		amount)
select
	credit_profile_id,
	product_id,
	sum(amount)
from
	#balances
group by
	credit_profile_id,
	product_id

create table
	#output(
		credit_profile_id int,
		account varchar(50),
		product varchar(10),
		balance numeric(30, 2))

insert into
	#output
select
	credit_profile_id = a.credit_profile_id,	
	account = c.name,
	product = b.symbol,
	balance = a.amount
from
	#credit_profile_balances a,
	products b,
	credit_profiles c
where
	a.product_id = b.product_id
and
	a.credit_profile_id = c.credit_profile_id

if @source != NULL
begin
	select
		@source_id = source_id
	from
		sources
	where
		name = @source
	if @source_id = NULL
	begin
		select
			status = "Error",
			msg = "Source provided but source not found",
			source = @source
		return
	end
	update
		#output
	set
		account = b.symbol
	from
		#output a,
		credit_profile_symbols b
	where
		a.credit_profile_id = b.credit_profile_id
	and
		b.source_id = @source_id
	
	/* Do not include credit profiles in export that are listed as excluded for this source */
	delete
		#output
	from
		#output a,
		credit_profile_source_hacks b
	where
		a.credit_profile_id = b.credit_profile_id
	and
		b.source_id = @source_id
	and
		exclude_from_export = "Y"

	/* Override the true balance with whatever is listed in the hacks table for this source */
	/* This is for a request from ITG to always have 1 client show 0 NOP to start each day */
        update
		#output
	set
		balance = b.balance_override
	from
		#output a,
		credit_profile_source_hacks b
	where
		a.credit_profile_id = b.credit_profile_id
	and
		b.source_id = @source_id
		
end

select
	account,
	product,
	balance
from
	#output
order by
	account,
	product


select
	"EOF"

go
