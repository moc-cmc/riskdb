
if object_id("r_contractforward") != NULL
    drop procedure
        r_contractforward
go
 
create procedure
	r_contractforward
		@contract_id int,
		@forward_id int output
as


select
	@forward_id = NULL

select
	@forward_id = contract_id
from
	forwards
where
	contract_id = @contract_id

if @forward_id != NULL
	return

select
	@forward_id = a.forward_id
from
	futures a,
	future_contracts b
where
	a.future_id = b.future_id
and
	b.contract_id = @contract_id
if @forward_id != NULL
	return


select
	@forward_id = a.contract_id
from
	forwards a,
	options b,
	option_expirations c,
	option_contracts d
where
	a.contract_id = b.underlying_contract_id
and
	b.option_id = c.option_id
and
	c.option_expiration_id = d.option_expiration_id
and
	d.contract_id = @contract_id
if @forward_id != NULL
	return


select
	@forward_id = a.contract_id
from
	forwards a,
	futures b,
	future_contracts c,
	options d,
	option_expirations e,
	option_contracts f
where
	a.contract_id = b.forward_id
and
	b.future_id = c.future_id
and
	c.contract_id = d.underlying_contract_id
and
	d.option_id = e.option_id
and
	e.option_expiration_id = f.option_expiration_id
and
	f.contract_id = @contract_id

go
