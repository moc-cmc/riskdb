
create or replace procedure
	cm_primebrokers
			@login varchar(50)
as

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)
declare @pb_id int
declare @bo_ext_acct_id int
declare @trades int
declare @account_transactions int
declare @external_accounts int
declare @del varchar(10)

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
   @client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "edit_pb",
        "Edit PB",
        NULL)

insert into     
        #meta
values(
        "Column Link",
        "delete_pb",
        "Delete PB",
        NULL)

insert into
	#meta
values(
	"Column Link",
	"new_pb",
	"Add PB",
	NULL)

select * from #meta

create table
	#add_pb (
	new_pb varchar(20)
)

insert into
	#add_pb (
	new_pb)
values(
	"Add Prime Broker"
)

create table
	#primes (
		name varchar(100),
		bo_external_account varchar(50) NULL,
		run varchar(200) NULL,
		mkt_external_account varchar(50) NULL,
		trades int,
		account_transactions int,
		external_accounts int,
		delete_pb varchar(10) NULL,
		pb_id int NULL,
		bo_ext_acct_id int NULL,
		style varchar(200) NULL
)

insert into
	#primes
	(
	name,
	trades,
	account_transactions,
	external_accounts,
	delete_pb,
	pb_id,
	bo_ext_acct_id,
	style
)
select
	a.name,
	0,
	0,
	0,
	"delete",
	b.prime_broker_id,
	b.bo_external_account_id,
	@style
from
	sources a,
	prime_brokers b 
where
	b.source_id=a.source_id

update
	#primes
set
	a.bo_external_account=d.symbol
from
	#primes a,
	sources b,
	prime_brokers c,
	external_accounts d 
where
	a.name=b.name
and
	b.source_id=c.source_id
and
	c.bo_external_account_id=d.external_account_id

update
	#primes
set
	a.run=d.name
from 
	#primes a,
	sources b,
	prime_brokers c,
	runs d	
where
	a.name=b.name
and
	b.source_id=c.source_id
and
	c.run_id=d.run_id

update
	#primes
set
	a.mkt_external_account=d.symbol
from
	#primes a,
	sources b,
	prime_brokers c,
	external_accounts d
where
	a.name=b.name
and
	b.source_id=c.source_id
and
	c.mkt_ext_account_id=d.external_account_id

