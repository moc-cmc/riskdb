drop procedure r_allocatetradetoextacct
go

create procedure
	r_allocatetradetoextacct
		@login varchar(50),
		@run varchar(50)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@trade_id int,
		@account varchar(50),
		@symbol varchar(50),
		@quantity numeric(30,2),
		@trade_price float,
		@value_date datetime,
		@status varchar(50)

as

declare @external_account_id int
declare @status_id int

select
	@status_id = status_id
from
	statuses
where
	name = "Allocated"

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @@rowcount != 1
begin	
	select
		status = "Error",
		msg = "Account " + @account + " not found"
	return
end

begin tran
	update 
		trades
	set
		external_account_id = @external_account_id,
		status_id = @status_id
	where
		trade_id = @trade_id
commit tran


if @status = "Unallocated"
begin

	select
		"status"="Trade Allocated",
		"msg"= "Succesfully allocated to account",
		"account"=@account,
		"symbol"=@symbol,
		"quantity"=@quantity,
		"trade_price"=@trade_price

	exec
		r_inserttradenotification
			@trade_id
end

if @status = "Allocated"
begin

        select
                "status"="Trade Re-Allocated",
                "msg"= "Succesfully re-allocated to account",
                "account"=@account,
                "symbol"=@symbol,
                "quantity"=@quantity,
                "trade_price"=@trade_price


	exec
		r_updatetradenotification
			@trade_id,
			"Edit"
end


exec
	r_allocationtrades
		@login=@login,
		@run=@run,
		@begin_date=@begin_date,
		@end_date=@end_date


go

