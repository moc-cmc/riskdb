
if object_id("cbo_foforwardprice") != NULL
    drop procedure
        cbo_foforwardprice
go

create procedure
	cbo_foforwardprice
		@login varchar(30),
		@symbol varchar(50),
		@price_date datetime,
		@value_date datetime,
		@source varchar(50)
as

declare @contract_id int
declare @days float
declare @spot_price float
declare @forward_price float
declare @give_product_rate float
declare @get_product_rate float
declare @instrument varchar(50)
declare @price float

declare @tv float
declare @delta float
declare @gamma float
declare @theta float
declare @tau float


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"save_fo_price",
	"Save FO Price To BO",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	@contract_id = a.contract_id,
	@instrument = b.name
from
	contracts a,
	instruments b
where
	a.instrument_id = b.instrument_id
and
	a.symbol = @symbol

	

if @instrument = "Forward"
begin
	exec
		r_forwardpriceasof
			@contract_id,
			@price_date,
			@value_date,
			@days output,
			@spot_price output,
			@forward_price output,
			@give_product_rate output,
			@get_product_rate output
	select
		symbol = @symbol,
		price_date = @price_date,
		value_date = @value_date,
		forward_price = @forward_price,
		source = @source,
		save_fo_price = "SAVE AS BO"

end
if @instrument = "Option"
begin
	exec
		r_contracttheoasof
			@contract_id,
			@price_date,
			@tv output,
			@delta output,
			@gamma output,
			@theta output,
			@tau output
	
	select
		symbol = @symbol,
		price_date = @price_date,
		value_date = @value_date,
		forward_price = @tv,
		source = @source,
		save_fo_price = "SAVE AS BO"
end
if @instrument = "Future"
begin
	exec
		r_priceasof
			@contract_id,
			@price_date,
			@price output
	select
		symbol = @symbol,
		price_date = @price_date,
		value_date = @value_date,
		forward_price = @price,
		source = @source,
		save_fo_price = "SAVE AS BO"
end

go
