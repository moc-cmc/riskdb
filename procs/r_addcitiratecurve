
if object_id("r_addcitiratecurve") != NULL
    drop procedure
        r_addcitiratecurve
go
create procedure
	r_addcitiratecurve
	        @login char(50),		
		@currency char(50),
		@one_week float,
		@one_month float,
		@two_month float,
		@three_month float,
		@six_month float,
		@nine_month float,
		@one_year float,
		@eighteen_month float,
		@two_year float,
		@three_year float,
		@four_year float,
		@as_of_date datetime

as

declare @product_rate_id int
declare @days numeric(30,4)
declare @product_id int
declare @curve_count int

if @as_of_date = NULL
	select
		@as_of_date = getdate()

select
	@product_id = product_id
from
	products
where
	symbol = @currency
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding product with symbol",
		symbol = @currency
	return
end

select
	@curve_count = count(*)
from
	product_rates
where
	product_id = @product_id
and
	rate_date = @as_of_date

if
	@curve_count > 0
begin
	select 
		id = -1,
		error = "Rate curve already exists for",
		symbol = @currency,
		as_of = @as_of_date
	return
	
end
begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "product_rates"
	select
		@product_rate_id = last_id
	from
		keys
	where
		relation = "product_rates"
commit tran

begin tran
	insert into
		product_rates
	values(
		@product_rate_id,
		@product_id,
		@as_of_date)

	if @one_week != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		7.0,
		@one_week / 100.00)

	if @one_month != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		31.0,
		@one_month / 100.00)

	if @two_month != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		61.0,
		@two_month / 100.00)

	if @three_month != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		92.0,
		@three_month / 100.00)

	if @six_month != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		184.0,
		@six_month / 100.00)

	if @nine_month != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		275.0,
		@nine_month / 100.00)

	if @one_year != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		366.0,
		@one_year / 100.00)

	if @eighteen_month != NULL
	insert into
		product_rate_points
	values(
		@product_rate_id,
		550.0,
		@eighteen_month / 100.00)

	if @two_year != NULL
		insert into
			product_rate_points
		values(
			@product_rate_id,
			732.0,
			@two_year / 100.00)

	if @three_year != NULL
		insert into
			product_rate_points
		values(
			@product_rate_id,
			1098.0,
			@three_year / 100.00)

	if @four_year != NULL
		insert into
			product_rate_points
		values(
			@product_rate_id,
			1464.0,
			@four_year / 100.00)
commit tran


select
	id = 0,
	msg = "Successfully added rate curve",
	product = @currency

go
