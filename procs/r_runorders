
if object_id("r_runorders") != NULL
    drop procedure
        r_runorders
go
 
create procedure
	r_runorders
		@login char(30),
		@run_name char(200),
		@contract char(2)
as

declare @run_id int
declare @contract_id int
declare @product_id int
declare @symbol char(3)


select
	@run_id = run_id
from
	runs
where
	name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run_name = @run_name
	return
end

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)

insert into
	#links
values(
	"Column Link",
	"deal_id",
	"Inspect Deal",
	NULL)

insert into
	#links
values(
	"Column Link",
	"run_name",
	"Intraday P&L",
	NULL)

insert into
	#links
values(
	"Column Link",
	"edit",
	"Order Inspector",
	NULL)

insert into
	#links
values(
	"Column Link",
	"printable_view",
	"Printable Orders",
	NULL)

insert into
	#links
values(
	"Column Link",
	"tally",
	"Fill Order",
	"suppressAutoexecute=YES")
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments from #links


select
	run = "<font size=2><b>Orders</b></font>",
	run_name = @run_name,
	printable_view = "Printable View"


select
	@symbol = @contract + "%"

select
	@contract_id = max(contract_id)
from
	contracts
where
	symbol like @symbol

exec
	r_contractproduct
		@contract_id,
		@product_id output

insert into
	#links
values(
	"Column Link",
	"edit",
	"Order Inspector",
	NULL)


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders	
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts	
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts	

create table
	#contracts(
		contract_id int)
insert into
	#contracts
select
	contract_id
from
	forwards
where
	product_id = @product_id

insert into
	#contracts
select
	a.contract_id
from
	future_contracts a,
	futures b,
	forwards c
where
	a.future_id = b.future_id
and
	b.forward_id = c.contract_id
and
	c.product_id = @product_id

create table
	#orders(
		order_id int)


if @contract != NULL
begin
	insert into
		#orders
	select
		a.order_id
	from
		orders a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#contracts e
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.contract_id = e.contract_id
	and
		a.quantity != 0 
end
else
begin
	insert into
		#orders
	select
		a.order_id
	from
		orders a,
		#external_accounts b,
		#internal_accounts c,
		#traders d
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.quantity != 0
end


select
	a.deal_id,
	a.order_id,
	order_date = convert(char(11), a.order_date, 1),
	execution_date = convert(char(11), a.execution_date, 1),
	d.symbol,
	order_type = b.name,
	a.quantity,
	price = convert(char(30), convert(numeric(30,4), a.price)),
	current_price = convert(char(30), convert(numeric(30,4), i.price)),
	external_account = e.symbol,
	internal_account = f.symbol,
	trader = g.symbol,
	status = h.name,
	edit = "EDIT",
	tally = "FILL"
from
	orders a,
	order_types b,
	#orders c,
	contracts d,
	external_accounts e,
	internal_accounts f,
	traders g,
	statuses h,
	current_prices i
where
	a.order_id = c.order_id
and
	a.order_type_id = b.order_type_id
and
	a.contract_id = d.contract_id
and
	e.external_account_id = a.external_account_id
and
	f.internal_account_id = a.internal_account_id
and
	a.trader_id = g.trader_id
and
	a.status_id = h.status_id
and
	a.contract_id *= i.contract_id
and
	h.name in("Working", "Not Working")
order by
	d.symbol,
	convert(datetime, a.execution_date),
	convert(float, a.price) desc

exec
	r_orders
		@login
go
