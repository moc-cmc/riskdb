drop procedure
	mn_viewallocatedeal
go


create procedure
	mn_viewallocatedeal
		@login varchar(50),
		@deal_id int

as

declare @ma_version_id int
declare @external_account_id int
declare @allocation_mode int
declare @batch_id int
declare @account_id int
declare @trade_id int
declare @master_allocation_id int
declare @status varchar(50)



create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Column Link",
        "unallocate_deal",
        "Unallocate Deal",
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "ma_version_id",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "tally_allocations",
        "Tally Allocations",
        NULL)

select * from #meta

select
	@account_id = account_id
from
	tico_accounts
where
	login = @login


select
        @ma_version_id = b.ma_version_id
from
        master_allocations a,
        ma_versions b,
        contracts c,
        statuses d,
        trades e,
        external_accounts f,
        external_account_types g
where
        e.deal_id = @deal_id
and
        e.external_account_id = f.external_account_id
and
        f.external_account_type_id = g.external_account_type_id
and
        g.name = "Master"
and
        e.contract_id = c.contract_id
and
        c.instrument_id = a.instrument_id
and
        a.master_allocation_id = b.master_allocation_id
and
        b.status_id = d.status_id
and
        d.name = "Active"

select
	@status = b.name
from
	deals a,
	statuses b
where
	a.status_id = b.status_id
and
	a.deal_id = @deal_id

create table
	#allocation_info(
		external_account_id int,
		allocation numeric(30,6))

insert into 
	#allocation_info
select
	external_account_id,
	allocation
from
	sub_accounts
where
	ma_version_id = @ma_version_id
	

if @status not in("Allocated")
begin

create table
	#unallocated_trades(
		trade_date datetime,
		value_date datetime,
		contract_id int,
		symbol varchar(50),
		internal_account_id int,
		external_account_id int,
		external_account varchar(50),
		trader_id int,
		trader varchar(50),
		counterparty_id int,
		counterparty varchar(50),
		quantity int,
		price numeric(30,6),
		broker_id int,
		broker varchar(50) NULL,
		sales_code_id int,
		sales_code varchar(50) NULL
		
)


declare allocations_cursor cursor for
	select 
		external_account_id
	from
		#allocation_info

open allocations_cursor
fetch allocations_cursor into @external_account_id

while @@sqlstatus = 0
begin


insert into	
	#unallocated_trades
select
        getdate(),
        a.value_date,
        a.contract_id,
        b.symbol,
        a.internal_account_id,
        @external_account_id,
        c.symbol,
        a.trader_id,
        d.symbol,
        a.counterparty_id,
        e.name,
        quantity = round(a.quantity * f.allocation, 0),
        a.price,
        a.broker_id,
        NULL,
        a.sales_code_id,
        NULL
from
	trades a,
	contracts b,
	external_accounts c,
	traders d,
	counterparties e,
	#allocation_info f

where
	a.contract_id = b.contract_id
and
	c.external_account_id = @external_account_id
and
	a.trader_id = d.trader_id
and
	a.counterparty_id = e.counterparty_id
and
	a.deal_id = @deal_id
and
	f.external_account_id = c.external_account_id

update
	#unallocated_trades
set
	a.broker = b.symbol,
	a.sales_code = c.name
from
	#unallocated_trades a,
	brokers b,
	sales_codes c,
	trades d
where
	d.broker_id = b.broker_id
and
	d.sales_code_id = c.sales_code_id
and
	d.deal_id = @deal_id


		
	fetch allocations_cursor into @external_account_id
end


close allocations_cursor
deallocate allocations_cursor





select
	"user" = @login,
	deal_id = @deal_id,
        trade_date,
        value_date,
        symbol,
        quantity,
	price,
        trader,
        external_account,
        counterparty,
        broker,
        sales_code
from
	#unallocated_trades

        
select
 	ma_version_id = @ma_version_id,
 	deal_id = @deal_id,
 	"tally_allocations"="TALLY ALLOCATIONS"

end


if @status in("Allocated")
begin

create table
	#allocated_trades(
		trade_date datetime,
		value_date datetime,
		contract_id int,
		symbol varchar(50),
		internal_account_id int,
		external_account_id int,
		external_account varchar(50),
		trader_id int,
		trader varchar(50),
		counterparty_id int,
		counterparty varchar(50),
		quantity int,
		price numeric(30,6),
		broker_id int,
		broker varchar(50) NULL,
		sales_code_id int,
		sales_code varchar(50) NULL
		
)


declare allocations_cursor cursor for
	select 
		external_account_id
	from
		#allocation_info

open allocations_cursor
fetch allocations_cursor into @external_account_id

while @@sqlstatus = 0
begin


insert into	
	#allocated_trades
select
        getdate(),
        a.value_date,
        a.contract_id,
        b.symbol,
        a.internal_account_id,
        @external_account_id,
        c.symbol,
        a.trader_id,
        d.symbol,
        a.counterparty_id,
        e.name,
        quantity = a.quantity,
        a.price,
        a.broker_id,
        NULL,
        a.sales_code_id,
        NULL
from
	trades a,
	contracts b,
	external_accounts c,
	traders d,
	counterparties e,
	#allocation_info f

where
	a.contract_id = b.contract_id
and
	c.external_account_id = @external_account_id
and
	a.trader_id = d.trader_id
and
	a.counterparty_id = e.counterparty_id
and
	a.deal_id = @deal_id
and
	f.external_account_id = c.external_account_id

update
	#allocated_trades
set
	a.broker = b.symbol,
	a.sales_code = c.name
from
	#allocated_trades a,
	brokers b,
	sales_codes c,
	trades d
where
	d.broker_id = b.broker_id
and
	d.sales_code_id = c.sales_code_id
and
	d.deal_id = @deal_id


		
	fetch allocations_cursor into @external_account_id
end


close allocations_cursor
deallocate allocations_cursor





select
	"user" = @login,
	deal_id = @deal_id,
        trade_date,
        value_date,
        symbol,
        quantity,
	price,
        trader,
        external_account,
        counterparty,
        broker,
        sales_code
from
	#allocated_trades


select
	ma_version_id = @ma_version_id,
	deal_id = @deal_id,
	"unallocate_deal"="UNALLOCATE DEAL"



end




go
