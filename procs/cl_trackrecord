
if object_id("cl_trackrecord") != NULL
    drop procedure
        cl_trackrecord
go

create procedure
	cl_trackrecord
		@login char(50)
as

declare @fund_id int
declare @tico_account_id int


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)

insert into
        #links
values(
        "Column Link",
        "portfolio",
        "Historical Performance",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments from #links

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@fund_id = NULL

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

if @fund_id = NULL
begin
	select
		id = -1,
		error = "Problem finding default fund for user"
	return
end


select
	portfolio = a.name
from
	runs a,
	user_runs b
where
	a.run_id = b.run_id
and
	b.tico_account_id = @tico_account_id
order by
	a.name

go
