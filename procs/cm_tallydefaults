
if object_id("cm_tallydefaults") != NULL
    drop procedure
        cm_tallydefaults
go

create procedure
	cm_tallydefaults
		@login varchar(50),
		@user_name varchar(50)
as

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"del_default",
	"Delete Tally Default",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"add_new_default",
	"Add Tally Defaults",
	NULL,
	NULL)


insert into
	#links
values(
	"Column Link",
	"edit_values",
	"Edit Tally Defaults",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links


select
	add_new_default = "ADD TALLY DEFAULT",
	user_name = @user_name



select
	user_name = a.login,
	tally_type = e.name,
	internal_account = c.symbol,	
	external_account = d.symbol,
	trader= f.symbol,
	strategy = g.name,
	broker = h.symbol,
	counterparty = i.name,
	edit_values = "EDIT",
	del_default = "DELETE"
from
	tico_accounts a,
	default_tally_accounts b,
	internal_accounts c,
	external_accounts d,
	tally_types e,
	traders f,
	strategies g,
	brokers h,
	counterparties i
where
	a.account_id = b.tico_account_id
and
	b.tally_type_id = e.tally_type_id
and
	b.internal_account_id = c.internal_account_id
and
	b.external_account_id = d.external_account_id
and
	b.trader_id = f.trader_id
and
	b.strategy_id = g.strategy_id
and
	b.broker_id = h.broker_id
and
	b.counterparty_id = i.counterparty_id
and
	a.login = @user_name

go
