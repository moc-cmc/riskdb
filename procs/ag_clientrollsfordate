create table
	#closing_trades(
		trade_id int,
		external_account_id int,
		contract_id int,
		product_id int NULL,
		currency_id int NULL,
		product_quantity float,
		currency_quantity float,
		price float,
		value_date datetime)
insert into
	#closing_trades(
		trade_id,
		external_account_id,
		contract_id,
		product_quantity,
		currency_quantity,
		price,
		value_date)
select
	a.trade_id,
	a.external_account_id,
	a.contract_id,
	a.quantity,
	a.quantity * a.price * -1.0,
	a.price,
	a.value_date
from
	trades a,
	#spot_value_dates b,
	trade_types c
where
	a.contract_id = b.contract_id
and
	a.value_date = b.closing_date
and
	a.trade_type_id = c.trade_type_id
and
	c.name = "Swap Near"

update
	#closing_trades
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#closing_trades a,
	forwards b
where
	a.contract_id = b.contract_id

