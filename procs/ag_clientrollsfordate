create table
	#resid_pair_positions(
		external_account_id int,
		contract_id int,
		value_date datetime,
		quantity float)
insert into
	#resid_pair_positions(
		external_account_id,
		contract_id,
		value_date,
		quantity)
select
	external_account_id,
	contract_id,
	value_date,
	sum(product_quantity)
from
	#resid_trades
group by
	external_account_id,
	contract_id,
	value_date

select
	@id = 0
select
	@ids = count(*)
from
	#external_accounts
where
	batch_transaction_id = NULL
and
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#external_accounts
	where
		batch_transaction_id = NULL
	and
		id > @id

	select
		@external_account_id = NULL,
		@batch_transaction_id = NULL,
		@account = NULL,
		@account_roll_config = NULL,
		@settlement_method = NULL,
		@evaluation_currency_id = NULL,
		@evaluation_currency = NULL

	select
		@external_account_id = external_account_id,
		@account = symbol
	from
		#external_accounts
	where
		id = @id

	select
		@evaluation_currency_id = a.evaluation_currency_id,
		@evaluation_currency = b.symbol,
		@settlement_method = c.name
	from
		external_accounts a,
		products b,
		settlement_methods c
	where
		a.settlement_method_id = c.settlement_method_id
	and
		a.evaluation_currency_id = b.product_id
	and
		a.external_account_id = @external_account_id

	if @settlement_method = "Roll To Eval Currency"
	begin
		insert into
			#calculated_output(
				style,
				external_account_id,
				account,
				account_roll_config,
				trade_date)
		values(
			@client_style,
			@external_account_id,
			@account,
			"Roll balances to " + rtrim(@evaluation_currency),
			@trade_date)

		truncate table
			#positions
		truncate table
			#balances

		insert into
			#positions(
				product_id,
				value_date,
				quantity)
		select
			b.product_id,
			a.value_date,
			sum(a.quantity * -1.0) /* reverse sign to match client perspective */
		from
			trades a,
			#spot_value_dates b
		where
			a.contract_id = b.contract_id
		and
			a.external_account_id = @external_account_id
		and
			a.value_date >= @trade_date
		group by
			b.product_id, 
 			a.value_date

		insert into
			#positions(
				product_id,
				value_date,
				quantity)
		select
			b.currency_id,
			a.value_date,
			sum(a.quantity * a.price) /* reverse sign to match client perspective */
		from
			trades a,
			#spot_value_dates b
		where
			a.contract_id = b.contract_id 
 		and
			a.external_account_id = @external_account_id
		and
			a.value_date >= @trade_date
		group by
			b.currency_id,
			a.value_date

		insert into
			#balances(
				product_id,
				value_date,
				quantity)
		select
			product_id,
			value_date,
			sum(quantity)
		from
			#positions
		group by
			product_id,
			value_date


		/* MARKR */
		/* This was for parallel testing to match positions. Remove when in production 
		update
			#balances
		set
			a.quantity = a.quantity + b.balance
		from
			#balances a,
			#closing_balances b
		where
			b.external_account_id = @external_account_id
		and
			a.product_id = b.product_id
		and
			a.value_date = b.value_date

		update
			#balances
		set
			a.quantity = a.quantity + b.quantity
		from
			#balances a,
			#resid_balances b
		where
			b.external_account_id = @external_account_id
		and
			a.product_id = b.product_id
		and
			a.value_date = b.value_date MARKR */
		
		delete

		from
			#balances
		where
			quantity = 0.0

		update
			#balances
		set
			currency_id = @evaluation_currency_id

		update
			#balances
		set
			a.contract_id = b.contract_id
		from
			#balances a,
			forwards b
		where
			a.product_id = b.product_id
		and
			a.currency_id = b.currency_id


		update
			#balances
		set
			a.symbol = b.symbol
		from
			#balances a,
			contracts b
		where
			a.contract_id = b.contract_id

	
 		update
			#balances
		set
			a.closing_date = b.closing_date,
			a.roll_date = b.spot_date
		from
			#balances a,
			#spot_value_dates b
		where
			a.contract_id = b.contract_id
		and
			convert(date, b.trade_date) = @trade_date
		and
			convert(date, a.value_date) = convert(date, b.closing_date)
		insert into
			#calculated_output(
				style,
				external_account_id,
				account,
				trade_date,
				contract_id,
				symbol,
				product_id,
				evaluation_currency_id,
				position,
				closing_date, 
 				roll_to_date)
		select
			style = @style,
			external_account_id = @external_account_id,
			account = @account,
			trade_date = @trade_date,
			contract_id,
			symbol,
			product_id,
			currency_id,
			quantity,
			closing_date,
			roll_date
		from
			#balances
		where
			closing_date != NULL
		and
			product_id != @evaluation_currency_id
		order by
			symbol
			
	end

	if @settlement_method = "Roll By Pair"
	begin
		insert into
			#calculated_output(
				style,
				external_account_id,
				account,
				account_roll_config,
				trade_date)
		values(
			@client_style,
			@external_account_id,
			@account,
			"Roll pair positions",
			@trade_date)

		truncate table
			#pair_positions

		insert into
			#pair_positions(
				contract_id,
				value_date,
				quantity)
		select
			a.contract_id,
			a.value_date,
			sum(a.quantity * -1.0) /* reverse perspective to clients*/
		from
			trades a,
			#spot_value_dates b
		where
			a.external_account_id = @external_account_id
		and
			a.contract_id = b.contract_id
		and
			convert(date, a.value_date) >= convert(date, @trade_date)
		and
			convert(date, a.value_date) = convert(date, b.closing_date)
		group by
			a.contract_id,
			a.value_date

		/* MARKR */
		/* Comment this out now that they're live. this code was to prevent roll and resid trades from being included so we could match balances while they were in parallel 
		update
			#pair_positions
		set
			a.quantity = a.quantity + b.quantity
		from
			#pair_positions a,
			#closing_pair_positions b
		where
			b.external_account_id = @external_account_id
		and
			a.contract_id = b.contract_id
		and
			a.value_date = b.value_date

		update
			#pair_positions
		set
			a.quantity = a.quantity + b.quantity
		from
			#pair_positions a,
			#resid_pair_positions b
		where
			b.external_account_id = @external_account_id
		and
			a.contract_id = b.contract_id
		and
			a.value_date = b.value_date */


		delete

		from
			#pair_positions
		where
			quantity = 0.0


		insert into
			#calculated_output(
				style,
				external_account_id,
				account,
				trade_date,
				contract_id,
				symbol,
				product_id,
				position,
				closing_date,
				roll_to_date)
		select
			style = @style,
			external_account_id = @external_account_id,
			account = @account,
			trade_date = @trade_date,
			a.contract_id,
			b.symbol,
			b.product_id,
			a.quantity,
			b.closing_date,
			b.spot_date
		from
			#pair_positions a,
			#spot_value_dates b
		where
			a.contract_id = b.contract_id
		and
			abs(a.quantity) >= 1.0
		order by
			b.symbol

	end

	exec
		j_nextkey
			"batch_transactions",
			@batch_transaction_id output

	select
		@prb_id = NULL
	exec
		j_nextkey
			"proposed_roll_batches",
			@prb_id output
	begin tran
		insert into
			batch_transactions(
				batch_transaction_id,
				batched_by,
				trade_date,
				external_account_id,
				batched_date)
		values(
			@batch_transaction_id,
			@tico_account_id,
			@trade_date,
			@external_account_id,
			getdate())
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to create batch transactions"
				rollback tran
				return
		end

		insert into
			proposed_roll_batches(
				prb_id,
				batch_transaction_id,
				contract_id,
				position,
				closing_date,
				roll_date,
				timestamp)
		select
			prb_id = id + @prb_id,
			batch_transaction_id = @batch_transaction_id,
			contract_id,
			convert(numeric(30,2), position), 
 			closing_date,
			roll_to_date,
			timestamp = getdate()
		from
			#calculated_output
		where
			external_account_id = @external_account_id 
		and
			contract_id != NULL
		and
			abs(position) >= 1.0
		if @@rowcount = 0
		begin
			delete

			from
				batch_transactions
			where
				batch_transaction_id = @batch_transaction_id

			delete

			from
				#calculated_output
			where
				external_account_id = @external_account_id
		end

		update
			proposed_roll_batches
		set
			a.position = convert(numeric(30,0), a.position)
		from
			proposed_roll_batches a,
			contracts b
		where
			a.contract_id = b.contract_id
		and
			b.symbol = "JPYUSD"
		
		select
			@prb_id = max(prb_id)
		from
			proposed_roll_batches

		update
			keys
		set
			last_id = @prb_id
		where
			relation = "proposed_roll_batches"

	commit tran

	update
		#calculated_output
	set
		batch_transaction_id = @batch_transaction_id
	where
		external_account_id = @external_account_id
	and
		account_roll_config != NULL

	select
		@ids = count(*)
	from
		#external_accounts
	where
		batch_transaction_id = NULL
	and
		id > @id
end

update
	#calculated_output
set
	a.batch_transaction_id = b.batch_transaction_id
from
	#calculated_output a,
	batch_transactions b
where
	a.external_account_id = b.external_account_id
and
	b.trade_date = @trade_date
and
	a.style = @client_style


exec
