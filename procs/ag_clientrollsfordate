create table
	#inverted_contracts(
		contract_id int,
		product_id int, 
		currency_id int,
		inverted_contract_id int NULL)
insert into
	#inverted_contracts(
		contract_id,
		product_id,
		currency_id)
select
	a.contract_id,
	b.product_id,
	b.currency_id
from
	#spot_value_dates a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#inverted_contracts
set
	a.inverted_contract_id = b.contract_id
from
	#inverted_contracts a,
	forwards b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id

delete

from
	#inverted_contracts
where
	inverted_contract_id = NULL

insert into
	#spot_value_dates(
		contract_id,
		trade_date,
		closing_date,
		spot_date,
		includes_holiday)
select
	a.inverted_contract_id,
	b.trade_date,
	b.closing_date,
	b.spot_date,
	b.includes_holiday
from
	#inverted_contracts a,
	#spot_value_dates b
where
	a.contract_id = b.contract_id

update
	#spot_value_dates
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#spot_value_dates a,

 	forwards b
where
	a.contract_id = b.contract_id

update
	#spot_value_dates
set
	a.symbol = b.symbol
from
	#spot_value_dates a,
	contracts b
where
	a.contract_id = b.contract_id

