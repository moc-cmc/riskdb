select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@deficit_style = "background:#F5F3CE;color:#FF0000;border: 1px solid white",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold", 
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@selected_trade_style = "background:#F7F4C1;border: 1px solid white"


select
	@validated_by = validated_by,
	@validation = timestamp
from
	roll_trade_dates
where
	trade_date = @trade_date
if @validation = NULL
begin
	select
		status = "Error",
		message = "Dates not validated for trade date",	
		trade_date = @trade_date,
		date = @trade_date
	return
end

select
	@trade_date = convert(datetime, convert(date, @trade_date))

if @trade_date > getdate()
begin
	select
		message = "Balances cannot be queued for a trade date in the future"
	return
end

begin tran
	delete
		proposed_roll_batches
	from
		proposed_roll_batches a,
		batch_transactions b
	where
		a.batch_transaction_id = b.batch_transaction_id
	and
		b.trade_date = @trade_date
	and
		b.confirmation_date = NULL

	delete
		batch_transactions
	from
		batch_transactions
	where
		trade_date = @trade_date
	and
		confirmation_date = NULL
commit tran



