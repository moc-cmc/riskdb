use
	risk_elys
go

drop procedure
	cbo_setdefinedrollratestd
go

create procedure
	cbo_setdefinedrollratestd
		@login varchar(50),
		@trade_date datetime=NULL
as


declare @tico_account_id int
declare @fund_id int
declare @fund varchar(100)
declare @roll_trader_id int
declare @roll_trader varchar(50)
declare @roll_trader_login varchar(50)
declare @roll_trader_account_id int

declare @defined_roll_rate_id int
declare @contract_id int
declare @value_date datetime
declare @closing_date datetime
declare @closing_quantity numeric(30,4)
declare @net_closing_long numeric(30,4)
declare @closing_long_pbs int
declare @closing_rate_long float
declare @net_closing_short numeric(30,4)
declare @closing_short_pbs int
declare @closing_rate_short float
declare @roll_date datetime
declare @roll_rate_long float
declare @roll_rate_short float
declare @begin_date datetime
declare @end_date datetime


declare @id int
declare @ids int


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Could not resolve login"
	return
end

select
	@fund = name
from
	funds
where
	fund_id = @fund_id

select	
	@roll_trader_id = roll_trader_id
from
	fund_roll_traders
where
	fund_id = @fund_id


select
	@roll_trader = symbol,
	@roll_trader_account_id = tico_account_id
from
	traders
where
	trader_id = @roll_trader_id
if @roll_trader = NULL
begin
	select
		status = "Error",
		message = "Roll trader not found"
	return
end

select
	@roll_trader_login = login
from
	tico_accounts
where
	account_id = @roll_trader_account_id

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output


create table
	#market_rolls(
		style varchar(250) NULL,
		deal_id int,
		trade_date datetime NULL,
		external_account_id int,
		account_type varchar(50) NULL,
		closing_trade_id int,
		closing_quantity numeric(30,4),
		contract_id int,
		closing_rate float,
		closing_date datetime,
		roll_trade_id int NULL,
		roll_quantity numeric(30,4) NULL,
		roll_rate float NULL,
		roll_date datetime NULL)

insert into
	#market_rolls(
		deal_id,
		trade_date,
		external_account_id,
		account_type,
		closing_trade_id,
		contract_id,
		closing_quantity,
		closing_rate,
		closing_date)
select
	a.deal_id,
	a.trade_date,
	a.external_account_id,
	c.name,
	a.trade_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.value_date
from
	trades a,
	external_accounts b,
	external_account_types c,
	trade_types d
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	a.trade_type_id = d.trade_type_id
and
	c.name = "Counterparty"
and
	d.name = "Swap Near"
and
	a.trader_id = @roll_trader_id
and
        a.trade_date >= @begin_date
and
        a.trade_date < @end_date



create table
	#roll_legs(
		deal_id int,
		trade_id int)
insert into
	#roll_legs
select
	a.deal_id,
	a.trade_id
from
	trades a,
	#market_rolls b
where
	a.deal_id = b.deal_id

delete
	#roll_legs
from
	#roll_legs a,
	#market_rolls b
where
	a.trade_id = b.closing_trade_id

update
	#market_rolls
set
	a.roll_trade_id = b.trade_id
from
	#market_rolls a,
	#roll_legs b
where
	a.deal_id = b.deal_id

update
	#market_rolls
set
	a.roll_date = b.value_date,
	a.roll_rate = b.price,
	a.roll_quantity = b.quantity
from
	#market_rolls a,
	trades b
where
	a.roll_trade_id = b.trade_id

create table
	#contracts(
		id int identity,
		contract_id int)
insert into
	#contracts(
		contract_id)
select
	distinct(contract_id)
from
	#market_rolls


select
	@id = 0
select
	@ids = count(*)
from
	#contracts
where
	id > @id


/* Logic below for @does_existt */
declare @does_exist char(1)

while @ids > 0
begin
	select
		@id = min(id)
	from
		#contracts
	where
		id > @id

	select
		@contract_id = NULL,
		@trade_date = NULL,
		@closing_date = NULL,
		@closing_quantity = NULL,
		@closing_rate_long = NULL,
		@closing_rate_short = NULL,
		@roll_date = NULL,
		@roll_rate_long = NULL,
		@roll_rate_short = NULL,
		@net_closing_long = NULL,
		@closing_long_pbs = NULL

	select
		@contract_id = contract_id
	from
		#contracts
	where
		id = @id

	select
		@trade_date = trade_date,
		@closing_date = closing_date,
		@roll_date = roll_date
	from
		#market_rolls
	where
		contract_id = @contract_id


	select
		@net_closing_long = sum(closing_quantity),
		@closing_long_pbs = count(contract_id),
		@closing_rate_long = sum(closing_quantity * closing_rate) / sum(closing_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(closing_quantity) > 0.0

	select
		@roll_rate_short = sum(roll_quantity * roll_rate) / sum(roll_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(roll_quantity) < 0.0

	select
		@net_closing_short = sum(closing_quantity),
		@closing_short_pbs = count(contract_id),
		@closing_rate_short = sum(closing_quantity * closing_rate) / sum(closing_quantity),
		@roll_rate_long = sum(closing_quantity * roll_rate) / sum(roll_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(closing_quantity) < 0.0

	select
		@roll_rate_long = sum(roll_quantity * roll_rate) / sum(roll_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(roll_quantity) > 0.0
	


	 update
		defined_roll_rates
	set
		tico_account_id = @tico_account_id,
		closing_date = @closing_date,
		net_long = @net_closing_long,
		long_pbs = @closing_long_pbs,
		closing_rate_long = @closing_rate_long,
		net_short = @net_closing_short,
		short_pbs = @closing_short_pbs,
		closing_rate_short = @closing_rate_short,
		roll_date = @roll_date,
		roll_rate_long = @roll_rate_long,
		roll_rate_short = @roll_rate_short,
		timestamp = getdate()
	where
		contract_id = @contract_id
	and
		convert(date, trade_date) = convert(date, @trade_date)
	if @@rowcount = 0
	begin
		/* chriso: we are violating the contract_id, closing_date index here. 
			so check if there are already rated for that contract_id and trade date, 
			and if so, dont try and insert */
                select @does_exist = NULL

		select 
			@does_exist = "Y"
		from 
			defined_roll_rates 
		where 
			contract_id = @contract_id 
		and 
			convert(date, trade_date) = convert(date, @trade_date)
		if @does_exist != "Y"
		begin

			exec
				j_nextkey
					"defined_roll_rates",
					@defined_roll_rate_id output
	
			insert into
				defined_roll_rates(
					defined_roll_rate_id,
					tico_account_id,
					contract_id,
					trade_date,
					closing_date,
					net_long,
					long_pbs,
					closing_rate_long,
					net_short,
					short_pbs,
					closing_rate_short,
					roll_date,
					roll_rate_long,
					roll_rate_short,
					timestamp)
			values(
				@defined_roll_rate_id,
				@tico_account_id,
				@contract_id,
				@trade_date,
				@closing_date,
				@net_closing_long,
				@closing_long_pbs,
				@closing_rate_long,
				@net_closing_short,
				@closing_short_pbs,
				@closing_rate_short,
				@roll_date,
				@roll_rate_long,
				@roll_rate_short,
				getdate())
		end
	end	
	

	select
		@ids = count(*)
	from
		#contracts
	where
		id > @id
end


go
