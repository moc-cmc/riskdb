
if object_id("cl_editfutaccountalloc") != NULL
    drop procedure
        cl_editfutaccountalloc
go

create procedure
	cl_editfutaccountalloc
		@login varchar(50),
		@account varchar(50),
		@remainder_account varchar(50),
		@allocation varchar(30)
as

declare @external_account varchar(50)
declare @internal_account varchar(50)
declare @remainder_external_account varchar(50)
declare @remainder_internal_account varchar(50)
declare @fund_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@internal_account = name
from
	funds
where
	fund_id = @fund_id

select
	@remainder_external_account = @remainder_account,
	@remainder_internal_account = @internal_account,
	@external_account = @account


exec
	r_editfutureallocation
		@login,
		@external_account,
		@internal_account,
		@remainder_external_account,
		@remainder_internal_account,
		@allocation


go
