
drop procedure
	ag_bookcfdsettlements
go

create procedure
	ag_bookcfdsettlements
		@login varchar(50),
		@trade_date datetime
as


declare @id int
declare @ids int 
declare @round_turn_id int
declare @contract_id int
declare @external_account_id int
declare @total float

declare @cfd_roll_trade_type_id int
declare @cfd_settlement_type_id int
declare @evaluation_currency_id int
declare @evaluation_currency varchar(50)
declare @equiv float
declare @note varchar(100)

declare @forward_id int
declare @inverted_forward_id int

select
	@cfd_roll_trade_type_id = trade_type_id
from
	trade_types
where
	name = "CFD Roll"

select
	@cfd_settlement_type_id = transaction_type_id
from
	transaction_types
where
	name = "CFD Settlement"

create table
	#round_turns(
		id int identity,
		round_turn_id int NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		entry_id int NULL,
		entry_date datetime NULL,
		entry_qty numeric(30,4) NULL,
		entry_price float NULL,
		exit_id int NULL,
		exit_date datetime NULL,
		exit_qty numeric(30,4) NULL,
		exit_price float NULL,
		currency_id int NULL,
		realized_pl float NULL,
		currency varchar(50) NULL)
create table
	#rt_ids(
		id int identity,
		round_turn_id int,
		contract_id int,
		external_account_id int)
insert into
	#rt_ids(
		round_turn_id,
		contract_id,
		external_account_id)
select
	a.round_turn_id,
	a.contract_id,
	a.external_account_id
from
	round_turns a,
	contracts b,
	products c,
	external_accounts d
where
	a.contract_id = b.contract_id
and
	a.currency_id = c.product_id
and
	a.external_account_id = d.external_account_id
and
	convert(date, a.trade_date) = convert(date, @trade_date)
order by
	d.symbol,
	b.symbol,	
	a.round_turn_id


select
	@id = 0
select
	@ids = count(*)
from
	#rt_ids
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#rt_ids
	where
		id > @id


	select
		@round_turn_id = round_turn_id,
		@contract_id = contract_id,
		@external_account_id = external_account_id
	from
		#rt_ids
	where
		id = @id

	insert into
		#round_turns(
			round_turn_id,
			contract_id,
			external_account_id,
			entry_id,
			entry_date,
			entry_qty,
			entry_price,
			exit_id,
			exit_date,
			exit_qty,
			exit_price,
			currency_id,
			realized_pl)
	select
		round_turn_id,
		contract_id,
		external_account_id,
		entry_trade_id,
		entry_date,
		entry_quantity,
		entry_price,
		exit_trade_id,
		exit_date,
		exit_quantity,
		exit_price,
		currency_id,
		realized_pl
	from
		round_turns 
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id
	and
		convert(date, trade_date) = convert(date, @trade_date)

		
	delete

	from
		#rt_ids
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id

	

	select
		@ids = count(*)
	from
		#rt_ids
	where
		id > @id
end


update
	#round_turns
set
	a.account = b.symbol,
	a.symbol = c.symbol,
	a.currency = d.symbol
from
	#round_turns a,
	external_accounts b,
	contracts c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.currency_id = d.product_id

create table
	#account_transactions(
		external_account_id int,
		currency_id int,
		realized_pl numeric(30,4))
insert into
	#account_transactions(
		external_account_id,
		currency_id,
		realized_pl)
select
	external_account_id,
	currency_id,
	sum(realized_pl)
from
	#round_turns
group by
	external_account_id,
	currency_id

create table	
	#realized_transactions(
		id int identity,
		external_account_id int,
		external_account_type_id int,
		account varchar(50) NULL,
		currency_id int,
		currency varchar(50) NULL,
		realized_pl numeric(30,4) NULL)
insert into
	#realized_transactions(
		external_account_id,
		external_account_type_id,
		account,
		currency_id,
		currency,
		realized_pl)
select
	a.external_account_id,
	b.external_account_type_id,
	b.symbol,
	a.currency_id,
	c.symbol,
	a.realized_pl
from
	#account_transactions a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
order by
	b.symbol,
	c.symbol

/* REVERSE realized pl since the trades are in the fino perspective */
update
	#realized_transactions
set
	realized_pl = a.realized_pl * -1
from
	#realized_transactions a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Client"

declare @book_login char(50)
declare @book_account varchar(50)
declare @book_account_id int
declare @book_category char(100)
declare @book_date datetime
declare @book_amount float
declare @book_product varchar(50)
declare @book_product_id int
declare @book_note char(255)
declare @cfd_settlement_exists char(1)

select * from #realized_transactions

select 
	@book_login=@login,
	@book_date=convert(date, @trade_date),
	@book_category="CFD Settlement",
	@book_note = NULL

select
	@id = 0
select
	@ids = count(*)
from
	#realized_transactions
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#realized_transactions
	where
		id > @id

	select
		@book_account = NULL,
		@book_amount = NULL,
		@book_product = NULL,
		@cfd_settlement_exists = NULL,
		@book_product_id = NULL,
		@book_account_id = NULL,
		@evaluation_currency_id = NULL,
		@evaluation_currency = NULL,
		@forward_id = NULL,
		@inverted_forward_id = NULL,
		@equiv = NULL,
		@note = NULL
	
	select
		@book_account = account,
		@book_account_id = external_account_id,
		@book_amount = realized_pl,
		@book_product = currency,
		@book_product_id = currency_id
	from
		#realized_transactions
	where
		id = @id

	select
		@evaluation_currency_id = evaluation_currency_id
	from
		external_accounts
	where
		external_account_id = @book_account_id
	if @evaluation_currency_id = NULL
	begin
		select
			status = "Error",
			message = "Evaluationc urrency not found for account",
			account = @book_account
		return
	end

	select
		@evaluation_currency = symbol
	from
		products
	where
		product_id = @evaluation_currency_id


	select
		@forward_id = contract_id
	from
		forwards
	where
		product_id = @book_product_id
	and
		currency_id = @evaluation_currency_id

	select
		@inverted_forward_id = contract_id
	from
		forwards
	where
		currency_id = @book_product_id
	and
		product_id = @evaluation_currency_id

	select
		@equiv = @book_amount * price
	from
		bo_spot_settles
	where
		contract_id = @forward_id
	and
		convert(date, price_date) = convert(date, @trade_date)
	if @equiv = NULL
	begin
		select
			@equiv = @book_amount * (1.0 / price)
		from
			bo_spot_settles
		where
			contract_id = @inverted_forward_id
		and
			convert(date, price_date) = convert(date, @trade_date)
	end

	if @book_product_id = @evaluation_currency_id
		select
			@equiv = @book_amount
	select
		@note = rtrim(@book_product) + " " + rtrim(convert(varchar(30), convert(numeric(30,4), @book_amount)))

	select
		@cfd_settlement_exists = "Y"
	from
		account_transactions
	where
		transaction_date = @book_date
	and
		currency_id = @book_product_id
	and
		external_account_id = @book_account_id
	and
		transaction_type_id = @cfd_settlement_type_id
	and
		note = @note
	if @cfd_settlement_exists != "Y"
	begin	
		exec
			s_addaccounttransaction
				@login = @book_login,
				@account = @book_account,
				@category = @book_category,
				@date = @book_date,
				@amount = @equiv,
                		@product = @evaluation_currency,
				@note = @note
	end
	else
	begin
		select
			status = "Error",
			msg = "Problem saving down CFD settlement. CFD settlement already exists for date",
			account=@book_account,
			category=@book_category,
			transaction_date=@book_date,
			currency = @book_product
	end

	select
		@ids = count(*)
	from
		#realized_transactions
	where
		id > @id
end



go
