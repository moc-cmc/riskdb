
drop procedure
	cl_productblotter
go

create procedure
	cl_productblotter
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@trade_id int=NULL

as



declare @run_id int
declare @tico_account_id int

declare @date datetime


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Format Number",
	"price",
	NULL,
	NULL,
	"#,##0.000000")


select * from #links

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "login not found"
	return
end

select
	@run_id = a.run_id
from
	user_runs a,
	runs b
where
	a.run_id = b.run_id
and
	b.name = @run_name
and
	a.tico_account_id = @tico_account_id
if @run_id = NULL
begin
	select
		id = -1,
		error = "No run configured for user"
	return
end
	


if @begin_date = NULL
	select
		@begin_date = convert(datetime, convert(char(11), getdate(), 1))


if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output
else
begin
	exec
		r_daterangefordate
			@end_date,
			@date output,
			@end_date output
end


	
create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#traders
	select
		trader_id
	from
		traders

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select  
	internal_account_id
from    
	run_internal_accounts
where   
	run_id = @run_id 
if @@rowcount = 0
	insert into
		#internal_accounts
	select  
		internal_account_id
	from    
		internal_accounts

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#strategies
	select
		strategy_id
	from
		strategies


create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers


create table
	#trades(
		trade_id int,
		ccy_pair varchar(50) NULL,
		instrument varchar(30) NULL,
		l_s varchar(15) NULL,
		position varchar(50) NULL,
		dealt_amount numeric(30,4) NULL,
		dealt_product varchar(25) NULL,
		contra_amount numeric(30,4) NULL,
		contra_product varchar(25) NULL,
		strike float NULL,
		expiration varchar(11) NULL,
		cut varchar(15) NULL,
		settlement varchar(15) NULL,
		fixing_date varchar(15) NULL,
		trade_date varchar(15) NULL,
		account varchar(100) NULL,
		broker varchar(50) NULL	
		)


if @trade_id = NULL
begin
	insert into
		#trades(
			trade_id,
			dealt_amount,
			contra_amount,
			strike,
			expiration,
			settlement,
			fixing_date,
			trade_date)
	select
		a.trade_id,
		a.quantity,
		a.quantity * a.price * -1.0,
		a.price,
		expiration = convert(varchar(11), a.value_date, 1),
		settlement = convert(varchar(11), a.value_date, 1),
		fixing_date = convert(varchar(11), a.fixing_date, 1),
		trade_date = convert(varchar(11), a.trade_date, 1)
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
	and
		a.quantity != 0
end
else /* Identical to above query with @trade_id qualifier */
begin
	insert into
		#trades(
			trade_id,
			dealt_amount,
			contra_amount,
			strike,
			expiration,
			settlement,
			fixing_date,
			trade_date)
	select
		a.trade_id,
		a.quantity,
		a.quantity * a.price * -1.0,
		a.price,
		expiration = convert(varchar(11), a.value_date, 1),
		settlement = convert(varchar(11), a.value_date, 1),
		fixing_date = convert(varchar(11), a.fixing_date, 1),
		trade_date = convert(varchar(11), a.trade_date, 1)
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
	and
		a.trade_id = @trade_id
	and
		a.quantity != 0
end

update
	#trades
set
	a.ccy_pair = c.symbol
from
	#trades a,
	trades b,
	contracts c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id


update
	#trades
set
	a.instrument = c.name
from
	#trades a,
	trades b,
	trade_types c
where
	a.trade_id = b.trade_id
and
	b.trade_type_id = c.trade_type_id

update
	#trades
set
	dealt_product = d.symbol
from
	#trades a,
	trades b,
	forwards c,
	products d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.product_id = d.product_id


update
	#trades
set
	contra_product = d.symbol
from
	#trades a,
	trades b,
	forwards c,
	products d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.currency_id = d.product_id

update
	#trades
set
	position = "Buy " + rtrim(dealt_product) + "/" + "Sell " + rtrim(contra_product)
where
	dealt_amount >= 0

update
	#trades
set
	position = "Sell " + rtrim(dealt_product) + "/" + "Buy " + rtrim(contra_product)
where
	dealt_amount < 0


update
	#trades
set
	a.account = c.symbol
from
	#trades a,
	trades b,
	external_accounts c
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id

update
	#trades
set
	a.broker = c.name
from
	#trades a,
	trades b,
	counterparties c
where
	a.trade_id = b.trade_id
and
	b.counterparty_id = c.counterparty_id
	

select * from #trades order by trade_id

go
