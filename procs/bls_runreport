/*
 | Trade level attribution
 */ 
update 
	#trades
set
	/* delta percentage */
	taker_attribution = a.taker_delta / b.total_taker_delta,
	maker_attribution = a.maker_delta / b.total_maker_delta,
	sales_code_attribution = a.sales_code_delta / b.total_sales_code_delta,
        /* trade pl */
	taker_trade_pl = b.total_trade_pl * (a.taker_delta / b.total_taker_delta),
	maker_trade_pl = b.total_trade_pl * (a.maker_delta / b.total_maker_delta),
	sales_code_trade_pl = b.total_trade_pl * (a.sales_code_delta / b.total_sales_code_delta),
	/* pos pl */	
	taker_position_pl = b.total_position_pl * (a.taker_delta / b.total_taker_delta),
	maker_position_pl = b.total_position_pl * (a.maker_delta / b.total_maker_delta),
	sales_code_position_pl = b.total_position_pl * (a.sales_code_delta / b.total_sales_code_delta)
from
	#trades a,
	#deals b
where
	a.deal_id = b.deal_id

