/* pl_to_date = realized_pl_to_date + unrealized_pl_to_date 

 *  Cases:  . . . B . . . E . .
 *  1:      -___-_x_x_x            
 *                A   B              -> { trade_pl = 0, position_pl = B - A }
 *  2:      -___-_x_x_x_x_x____
 *                A       B          -> { trade_pl = 0, position_pl = B - A }
 *  3:              x_x_x
 *                  A   B            -> { trade_pl = A, position_pl = B - A }
 *  4:              x_x_x_x____
 *                  A     B          -> { trade_pl = A, position_pl = B - A }
 *  5:       
 */


/* Cases 3, 4: Calculate A */
update
	#trades
set
	begin_pl = realized_pl_to_date + unrealized_pl_to_date
from
	#trades a,
	#committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, b.bo_trade_date)
and
	b.bo_trade_date >= @bo_begin_date

/* Cases 1, 2: Calculate A */
update
	#trades
set
	begin_pl = realized_pl_to_date + unrealized_pl_to_date
from
	#trades a,
	#committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, @bo_begin_date)
and
	b.bo_trade_date < @bo_begin_date

/* Case 5: Use default begin_pl = 0 */


/* Cases 1, 3: Calculate B */

/* chriso: we only want position pl that was accrued during the range. let's
 * exclude position pl where the reval_date is not in te @bo_begin_date and
 * @bo_end date range */
update
	#trades
set
	end_pl = b.realized_pl_to_date + b.unrealized_pl_to_date
from
	#trades a,
	#committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, b.value_date)
and
	b.value_date <= @bo_end_date

/* Cases 2, 4: Calculate B */
update
	#trades
set
	end_pl = b.realized_pl_to_date + b.unrealized_pl_to_date
from
	#trades a,
	#committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, @bo_end_date)
and
	b.value_date > @bo_end_date


/* Case 5: Use default end_pl = 0 */

/* Calculate trade_pl and position_pl */
update
	#trades
set
	trade_pl = begin_pl
where
	/* chriso: i think this makes us miss 5pm-12am prev day
	trade_date >= @bo_begin_date*/
	trade_date >= @begin_date

update
	#trades
set
	position_pl = end_pl - begin_pl

