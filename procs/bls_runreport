
if object_id("bls_runreport") != NULL
	drop procedure bls_runreport
go

create procedure	
	bls_runreport
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@deal_id int=NULL

as

declare @start_bench datetime
declare @last_bench datetime
select
    @start_bench = getdate()

create table
	#meta (
		meta_type varchar(25),
		name varchar(50),
		action varchar(25) NULL,
		value varchar(100) NULL,
	)

create table
    #messages (
        id int identity,
        subject varchar(25),
        message varchar(125)
    )

/* BENCH */
insert into #messages select "BLS Run Report", "Starting " + convert(varchar(25), @start_bench )
select @last_bench = getdate()

declare @fo_commit_type_id int
declare @last_commit_date datetime
declare @bo_begin_date datetime
declare @bo_end_date datetime

declare @run_id int

select
	@fo_commit_type_id = transaction_type_id
from
	transaction_types
where
	name = "Front Office Commit"

select
	@last_commit_date = max(transaction_date)
from
	int_account_transactions
where
	transaction_type_id = @fo_commit_type_id

if @begin_date = NULL and @end_date = NULL and @deal_id != NULL
begin
	/* If only a @deal_id is provided, then default the @begin_date and 
         * @end_date to the entire range of the deal */
	select
		@begin_date = min(trade_date),
		@end_date = max(value_date)
	from
		trades
	where
		deal_id = @deal_id
	and
		quantity != 0
end

if @begin_date = NULL
begin
	select
		@begin_date = @last_commit_date,
		@end_date = @last_commit_date
end
if @end_date = NULL
	select
		@end_date = @begin_date

select
	@bo_begin_date = convert(date,  @begin_date),
	@bo_end_date = convert(date, @end_date)

select
	@bo_begin_date = dateadd(day, case datepart(weekday, @bo_begin_date)
		when 1 then 1 when 7 then 2 else 0 end, @bo_begin_date),
	@bo_end_date = dateadd(day, case datepart(weekday, @bo_end_date)
		when 1 then 1 when 7 then 2 else 0 end, @bo_end_date)

exec
	r_prevbusinessday
		@bo_begin_date,
		@begin_date output

select
	@begin_date = convert(char(8), @begin_date, 112)+" 17:00",
	@end_date = convert(char(8), @bo_end_date, 112)+" 17:00"

/* Date Debug
select
	bo_begin_date = @bo_begin_date,
	begin_date = @begin_date,
	bo_end_date = @bo_end_date,
	end_date = @end_date
*/

select
  @run_id = a.run_id
from
  runs a,
  user_runs b,
  tico_accounts c
where
  a.run_id = b.run_id
and
  b.tico_account_id = c.account_id
and
  c.login = @login
and
  a.name = @run_name
if @@rowcount != 1
begin
  select
    id = -1,
    error = "Problem finding run with name",
    run = @run_name
  return
end

