update
	#trades
set
	perspective_contract_delta = case
		when b.product_id = d.product_id and b.currency_id = d.currency_id then /* normal */
			abs(a.forward_delta * b.multiplier / d.multiplier * c.price / e.price)
		when b.product_id = d.currency_id and b.currency_id = d.product_id then /* inverted */
			abs(a.forward_delta * b.multiplier / d.multiplier * -1 / e.price)
	end
from
	#trades a,
        /* Forward */
	#contracts b,
	#settles c,
        /* Perspetive Contract */
	#contracts d,
	#settles e
where
	a.forward_id = b.contract_id
and
	a.forward_id = c.contract_id
and
	convert(date, a.bo_trade_date) = convert(date, c.price_date)
and
	a.perspective_contract_id = d.contract_id
and
	a.perspective_contract_id = e.contract_id
and
	convert(date, a.bo_trade_date) = convert(date, e.price_date)
and
	a.perspective_contract_delta = NULL



