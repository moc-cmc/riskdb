/*
 | Find spot option contracts
 */
update
	#contracts
set
	product_id = e.product_id,
	currency_id = e.currency_id,
	multiplier = d.quantity * e.quantity
from
	#contracts a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id

