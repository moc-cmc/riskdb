use
	risk_futdemo
go

drop procedure
	cm_evaluateindicators
go

create procedure
	cm_evaluateindicators
		@login varchar(50),
		@region varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as



declare @run_id int
declare @tico_account_id int
declare @date datetime

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"run_name",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"perspective_contract",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"evaluate",
	"Evaluate Indicators",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"create_grouping",
	"New Grouping",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"view_indicators",
	"Run Indicators",
	NULL)

insert into
	 #meta
values(
	 "Column Format",
	 "amount",
	 "Number",
	 "#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


select * from #meta

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @region
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @region
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date != NULL
begin
	exec
		r_daterangefordate
			@end_date,
			@date output,
			@end_date output
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output
end


create table
	#forwards(
		contract_id int)
insert into
	#forwards
select
	forward_id
from
	run_forwards
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#forwards
	select
		contract_id
	from
		forwards

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#trades(
		trade_id int)

insert into
	#trades
select
	a.trade_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	#forwards h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.contract_id = h.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date


create table
	#products(
		trade_id int,
		product_id int,
		currency_id int,
		date datetime,
		external_account_id int,
		quantity numeric(30,4))
insert into
	#products
select
	a.trade_id,
	c.product_id,
	c.currency_id,
	b.trade_date,
	b.external_account_id,
	b.quantity
from
	#trades a,
	trades b,
	forwards c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id


select
	section = a.name,
	style = "background:#FFFFFF;border: 1px solid white",
	region = c.symbol,
	b.quantity,
	units = d.symbol,
	b.date
from
	products a,
	#products b,
	external_accounts c,
	products d
where
	a.product_id = b.product_id
and
	b.external_account_id = c.external_account_id
and
	b.currency_id = d.product_id
order by
	a.name,
	b.date,
	c.symbol



go



go
