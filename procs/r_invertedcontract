
if object_id("r_invertedcontract") != NULL
    drop procedure
        r_invertedcontract
go
 
create procedure
	r_invertedcontract
		@contract_id int,
		@inverted_contract_id int output
as


declare @product_id int
declare @currency_id int

select
	@product_id = product_id,
	@currency_id = currency_id
from
	forwards
where
	contract_id = @contract_id


select
	@inverted_contract_id = contract_id
from
	forwards
where
	product_id = @currency_id
and
	currency_id = @product_id


go
