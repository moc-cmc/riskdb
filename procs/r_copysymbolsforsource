create procedure
    r_copysymbolsforsource
        @existing_source varchar(50),
        @new_source varchar(50)
as

declare @existing_source_id int
declare @new_source_id int 

select
    @new_source_id = source_id
from
    sources
where
    name = @new_source
if @@rowcount != 1
begin
    select
        id = -1,
        error = "New Source not found",
        source = @new_source
    return
end
select
    @existing_source_id = source_id
from
    sources
where
    name = @existing_source
if @@rowcount != 1
begin
    select
        id = -1,
        error = "existing source not found",
        source = @existing_source_id
    return
end


