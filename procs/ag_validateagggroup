drop procedure ag_validateagggroup
go

create procedure
	ag_validateagggroup
		@agg_group varchar(50),
		@validated char(1) output,
		@tally_user_id int output,
		@tally_trade_type_id int output,
		@tally_internal_account_id int output,
		@tally_external_account_id int output,
		@tally_counterparty_id int output,
		@tally_trader_id int output,
		@tally_strategy_id int output,
		@tally_status_id int output,
		@tally_broker_id int output,
		@tally_sales_code_id int output,
		@offset_ext_account_id int output,
		@offset_counterparty_id int output,
		@offset_trader_id int output

as

declare @does_exist int


select
	@validated = "Y"

select
	@tally_user_id = tally_user_id,
	@tally_trade_type_id = tally_trade_type_id,
	@tally_internal_account_id = tally_internal_account_id,
	@tally_external_account_id = tally_external_account_id,
	@tally_counterparty_id = tally_counterparty_id,
	@tally_trader_id = tally_trader_id,
	@tally_strategy_id = tally_strategy_id,
	@tally_status_id = tally_status_id,
	@tally_broker_id = tally_broker_id,
	@tally_sales_code_id = tally_sales_code_id,
	@offset_ext_account_id = offset_ext_account_id,
	@offset_counterparty_id = offset_counterparty_id,
	@offset_trader_id = offset_trader_id
from
	agg_groups
where
	name = @agg_group
if @@rowcount != 1
begin
	select
		status="Error",
		msg ="Could not find agg_group with name",
		agg_group = @agg_group
	select
		@validated = "N"
	return
end


select
	@does_exist = account_id
from
	tico_accounts
where
	account_id = @tally_user_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_user_id"
        select
                @validated = "N"
end

select
	@does_exist = trade_type_id
from
	trade_types
where
	trade_type_id = @tally_trade_type_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_trade_type_id"
        select
                @validated = "N"
end

select
	@does_exist = internal_account_id
from
	internal_accounts
where
	internal_account_id = @tally_internal_account_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_internal_account_id"
        select
                @validated = "N"
end

select
	@does_exist = external_account_id
from
	external_accounts
where
	external_account_id = @tally_external_account_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_external_account_id"
        select
                @validated = "N"
end

select
	@does_exist = counterparty_id
from
	counterparties
where
	counterparty_id = @tally_counterparty_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_counterparty_id"
        select
                @validated = "N"
end

select
	@does_exist = trader_id
from
	traders
where
	trader_id = @tally_trader_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_trader_id"
        select
                @validated = "N"
end
select
	@does_exist = strategy_id
from
	strategies
where
	strategy_id = @tally_strategy_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_strategy_id"
        select
                @validated = "N"
end
select
	@does_exist = broker_id
from
	brokers
where
	broker_id = @tally_broker_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_broker_id"
        select
                @validated = "N"
end
select
	@does_exist = sales_code_id
from
	sales_codes
where
	sales_code_id = @tally_sales_code_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_sales_code_id"
        select
                @validated = "N"
end
select
	@does_exist = status_id
from
	statuses
where
	status_id = @tally_status_id
if @@rowcount = 0
begin
	select
		status="Error",
		msg ="Could not find tally_status_id"
        select
                @validated = "N"
end


if @offset_ext_account_id != NULL
begin
	select
		@does_exist = external_account_id
	from
		external_accounts
	where
		external_account_id = @offset_ext_account_id
	if @@rowcount = 0
	begin
        	select
                	status="Error",
                	msg ="Could not find offset_ext_account_id"
        	select
                	@validated = "N"
	end
end
if @offset_counterparty_id != NULL
begin
	select
		@does_exist = counterparty_id
	from
		counterparties
	where
		counterparty_id = @offset_counterparty_id
	if @@rowcount = 0
	begin
        	select
                	status="Error",
                	msg ="Could not find offset_counterparty_id"
        	select
                	@validated = "N"
	end
end
if @offset_trader_id != NULL
begin
	select
		@does_exist = trader_id
	from
		traders
	where
		trader_id = @offset_trader_id
	if @@rowcount = 0
	begin
        	select
                	status="Error",
                	msg ="Could not find offset_trader_id"
        	select
                	@validated = "N"
	end
end




go



	
	
