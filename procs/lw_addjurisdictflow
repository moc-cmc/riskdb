use
	risk_firsel
go

drop procedure
	lw_addjurisdictflow
go

create procedure
	lw_addjurisdictflow
		@login varchar(50),
		@collection_model varchar(200),
		@jurisdiction varchar(100),
		@collection_event varchar(50),
		@days_offset int,
		@fixed_cost float,
		@settlement_offset int,
		@collection_rate float,
		@confidence_rating float
as

declare @tico_account_id int
declare @collection_model_id int
declare @jurisdiction_id int
declare @collection_event_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@collection_model_id = collection_model_id
from
	collection_models
where
	name = @collection_model
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Collection model not found",
		collection_model = @collection_model
	return
end

select
	@jurisdiction_id = jurisdiction_id
from
	jurisdictions
where
	name = @jurisdiction
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Jurisdiction not found",
		jurisdiction = @jurisdiction
	return
end

select
	@collection_event_id = strategy_id
from
	strategies
where
	name = @collection_event
if @@rowcount != 1
begin
	exec
		j_nextkey
			"strategies",
			@collection_event_id output

	insert into
		strategies(
			strategy_id,
			name)
	values(
		@collection_event_id,
		@collection_event)
end

insert into
	jurisdiction_flows(
		collection_model_id,
		jurisdiction_id,
		collection_event_id,
		offset_days,
		fixed_cost,
		settlement_offset,
		collection_rate,
		confidence)
values(
	@collection_model_id,
	@jurisdiction_id,
	@collection_event_id,
	@days_offset,
	@fixed_cost,
	@settlement_offset,
	@collection_rate,
	@confidence_rating)


exec
	lw_modelflows
		@login,
		@collection_model


go
