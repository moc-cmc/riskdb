create table
	#prices(
		id int identity,
		style varchar(250) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		current_price float NULL,
		override_price float NULL,
		price float NULL,
		set_override varchar(50) NULL,
		clear_override varchar(50) NULL,
		status varchar(100) NULL,
		expiration datetime NULL,
		expiration_name varchar(50) NULL,
		display_price varchar(10) NULL)
insert into
	#prices(
		symbol)
select
	distinct(a.symbol)
from
	contracts a,
	#trades b
where
	a.contract_id = b.underlying_contract_id
order by
	a.symbol

update
	#prices
set
	a.contract_id = b.contract_id
from
	#prices a,
	contracts b
where
	a.symbol = b.symbol

update
	#prices
set
	display_price = "No"


update
	#prices
set
	a.display_price = "Yes"
from
	#prices a,
	#expiring_underlyings b
where
	a.contract_id = b.contract_id

update
	#prices
set
	set_override = "Set Exp Price",
	expiration_name = @expiration_name

update
	#prices
set
	style = @style,
	a.current_price = b.price,
	a.price = b.price
from
	#prices a,
	current_prices b
where
	a.contract_id = b.contract_id

update
	#prices
set
	a.override_price = b.price,
	a.price = b.price,
	a.status = "Price Overridden",
	a.clear_override = "Clear Override"
from
	#prices a,
	expiration_prices b
where
	a.contract_id = b.contract_id
and
	b.expiration_name = @expiration_name


update
	#trades
set
	a.underlying = b.price
from
	#trades a,
	#prices b
where
	a.underlying_contract_id = b.contract_id
	
update
	#trades
set
	parity_value = 0.0

update
	#trades
set
	parity_value = (underlying - strike) * abs(quantity)
where
	put_call = "C"
and
	underlying > strike


update
	#trades
set
	parity_value = (strike - underlying) * abs(quantity)
where
	put_call = "P"
and
	strike > underlying


update
	#trades
set
	itm = 0

update
	#trades
set
	itm = 1
where
	parity_value > 0.0

update
	#trades
set
	a.premium = c.amount,
	a.premium_currency_id = c.currency_id
from
	#trades a,
	account_transaction_trades b,
	account_transactions c
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
	
update
	#trades
set
	a.premium_equiv = a.premium * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.premium_currency_id = b.product_id



create table
	#net_premiums(
		expiration_name varchar(50),
		prem_sign int,
		premium_equiv float NULL)
insert into
	#net_premiums
select
	expiration_name,
	sign(premium_equiv),
	sum(premium_equiv)
from
	#trades
where
	premium_equiv != NULL
group by
	expiration_name,
	sign(premium_equiv)



create table
	#exp_names(
		expiration_name varchar(50),
		expiration datetime)
insert into
	#exp_names(
		expiration_name,
		expiration)
select
	expiration_name,
	min(expiration)
from
	#trades
group by
	expiration_name

create table
	#output(
		id int identity,
		section varchar(250) NULL,
		style varchar(250) NULL,
		expiring varchar(25) NULL,
		expiration_name varchar(50) NULL,
		expiration datetime NULL,
		days int NULL,
		long_premium float NULL,
		short_premium float NULL,
		total_premium float NULL,
		ccy varchar(50) NULL)
insert into
	#output(
		expiration_name)
select
	distinct(expiration_name)
from
	#trades
order by
	expiration

update
	#output
set
	a.expiration = b.expiration
from
	#output a,
	#exp_names b
where
	a.expiration_name = b.expiration_name

update
	#output
set
	long_premium = 0.0,
	short_premium = 0.0,
	total_premium = 0.0

update
	#output
set
	a.short_premium = b.premium_equiv
from
	#output a,
	#net_premiums b
where
	a.expiration_name = b.expiration_name
and
	b.prem_sign < 0.0


update
	#output
set
	a.long_premium = b.premium_equiv
from
	#output a,
	#net_premiums b
where
	a.expiration_name = b.expiration_name
and
	b.prem_sign > 0.0

update
	#output
set
	total_premium = short_premium + long_premium


update
	#output
set
	style = @style,
	section = "Expirations",
	expiring = rtrim(datename(month, expiration)) + " " + rtrim(datename(year, expiration))

update
	#output
set
	style = @selected_style
where
	expiration_name = @expiration_name

update
	#output
set
	days = datediff(day, getdate(), expiration)

select
	@days = min(days)
from
	#output


update
	#output
set
	a.ccy = rtrim(b.symbol) + " (equiv)"
from
	#output a,
	products b
where
	b.product_id = @evaluation_currency_id

create table
	#trades_output(
		id int identity,
		style varchar(250) NULL,
		trade_id int NULL,
		contract_id int NULL,
		underlying_contract_id int NULL,
		strike numeric(30,6) NULL,
		put_call varchar(5) NULL,
		expiration datetime NULL,
		account varchar(50) NULL,
		counterparty varchar(50) NULL,
		symbol varchar(50) NULL,
		quantity numeric(30,4) NULL,
		parity_value float NULL,
		premium float NULL,
		premium_equiv float NULL,
		underlying float NULL,
		itm int NULL,
		exercise varchar(10) NULL,
		status varchar(50) NULL,
		override_yes varchar(50) NULL,
		override_no varchar(50) NULL,
		override_clear varchar(50) NULL)
insert into
	#trades_output(
		style,
		trade_id,
		contract_id,
		underlying_contract_id,
		strike,
		put_call,
		expiration,
		account,
		counterparty,
		symbol,
		quantity,
		parity_value,
		premium,
		premium_equiv,
		underlying,
		itm,
		override_yes,
		override_no,
		override_clear)
select
	style = @style,
	a.trade_id,
	a.contract_id,
	a.underlying_contract_id,
	a.strike,
	a.put_call,
	a.expiration,
	a.account,
	a.counterparty,
	b.symbol,
	a.quantity,
	a.parity_value,
	a.premium,
	a.premium_equiv,
	a.underlying,
	a.itm,
	override_yes = "Lock Exercise Yes",
	override_no = "Lock Exercise No",
	override_clear = "Clear Override"
from
	#trades a,
	contracts b
where
	a.contract_id = b.contract_id
and
	a.expiration_name = @expiration_name
order by
	b.symbol,
	a.strike

