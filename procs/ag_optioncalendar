create table
	#trades(
		trade_id int,
		contract_id int,
		external_account_id int NULL,
		account varchar(50) NULL,
		counterparty_id int NULL,
		counterparty varchar(50) NULL,
		expiration datetime NULL,
		timezone_id int NULL,
		expiration_name varchar(50) NULL,
		underlying_contract_id int NULL,
		strike float NULL,
		put_call varchar(5) NULL,
		underlying float NULL,
		quantity numeric(30,4),
		parity_value float NULL,
		premium float NULL,
		premium_currency_id int NULL,
		premium_equiv float NULL,
		itm int NULL,
		override_option varchar(50) NULL,
		clear_override varchar(50) NULL)

insert into
	#trades(
		trade_id,
		contract_id,
		external_account_id,
		counterparty_id,
		quantity,
		timezone_id)
select
	a.trade_id,
	a.contract_id,
	a.external_account_id,
	a.counterparty_id,
	a.quantity,
	c.timezone_id
from
	trades a,
	option_contracts b,
	option_expirations c,
	trade_types d
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	a.trade_type_id = d.trade_type_id
and
	d.name != "Option Exercise"
and
	c.expiration >= @begin_date
and
	a.trade_date < @end_date


insert into
	#trades(
		trade_id,
		contract_id,
		external_account_id,
		counterparty_id,
		quantity,
		timezone_id)
select
	a.trade_id,
	a.contract_id,
	a.external_account_id,
	a.counterparty_id,
	a.quantity,
	c.timezone_id
from
	trades a,
	exotic_contracts b,
	option_expirations c,
	trade_types d
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	a.trade_type_id = d.trade_type_id
and
	d.name != "Option Exercise"
and
	c.expiration >= @begin_date
and
	a.trade_date < @end_date




