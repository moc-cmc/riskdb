if @is_today = "Yes"
begin
	delete

	from
		queued_trades
	where
		batch_id != @batch_id

	select
		@trade_id = 0
	select
		@trades = count(*)
	from
		#trades_output
	where
		trade_id > @trade_id
	
	while @trades > 0
	begin
		select
			@trade_id = min(trade_id)
		from
			#trades_output
		where
			trade_id > @trade_id
	
		select
			@queued_underlying_trade_id = NULL,
			@queued_closing_trade_id = NULL,
			@queued_deal_id = NULL,
			@exercise = NULL,
			@user_id = NULL,
