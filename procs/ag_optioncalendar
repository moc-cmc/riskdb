			@strategy_id = NULL,
			@broker_id = NULL,
			@strike = NULL,
			@put_call = NULL
	
	
		select
			@exercise = exercise,
			@trade_date = expiration,
			@strike = strike,
			@put_call = put_call,
			@underlying_contract_id = underlying_contract_id
		from
			#trades_output
		where
			trade_id = @trade_id
	
		select
			@user_id = user_id,
			@contract_id = contract_id,
			@value_date = value_date,
			@quantity = quantity,
			@price = price,
			@external_account_id = external_account_id,
			@internal_account_id = internal_account_id,
			@counterparty_id = counterparty_id,
			@trader_id = trader_id,
			@strategy_id = strategy_id,
			@broker_id = broker_id
		from
			trades
		where
			trade_id = @trade_id
	
	
		exec
			j_nextkey
				"queued_deals",
				@queued_deal_id output
	
		insert into
			queued_deals(
				queued_deal_id,
				batch_id,
				deal_type_id,
				timestamp)
		values(
			@queued_deal_id,
			@batch_id,
			@deal_type_id,
			getdate())
	
		/* Close the option position first */
		exec
			j_nextkey
				"queued_trades",
				@queued_closing_trade_id output
	
			select
				@identifier = rtrim(@expiration_name) + "-" + convert(varchar(10), @queued_closing_trade_id)
	
		insert into
			queued_trades(
			queued_trade_id,
			queued_deal_id,
			batch_id,
			user_id,
			trade_date,
			tally_type_id,
			contract_id,
			value_date,
			quantity,
			price,
			external_account_id,
			internal_account_id,
			counterparty_id,
			trader_id,
			strategy_id,
			broker_id,
			identifier,
			trade_type_id)
		values(
			@queued_closing_trade_id,
			@queued_deal_id,
			@batch_id,
			@user_id,
			@trade_date,
			@option_tally_type_id,
			@contract_id,
			@value_date,
			@quantity * -1.0,
			0.0,
			@external_account_id,
			@internal_account_id,
			@counterparty_id,
			@trader_id,
			@strategy_id,
			@broker_id,
			@identifier,
			@op_close_trade_type_id)
	
		/* Tally the exercised underlying trade if in the money */
		if @exercise = "Yes"
		begin
			if @put_call = "Put"
				select
					@quantity = @quantity * -1.0
	
			exec
				j_nextkey
					"queued_trades",
					@queued_underlying_trade_id output
	
			select
				@identifier = rtrim(@expiration_name) + "-" + convert(varchar(10), @queued_underlying_trade_id)
	
			insert into
				queued_trades(
				queued_trade_id,
				queued_deal_id,
				batch_id,
				user_id,
				trade_date,
				tally_type_id,
				contract_id,
				value_date,
				quantity,
				price,
				external_account_id,
				internal_account_id,
				counterparty_id,
				trader_id,
				strategy_id,
				broker_id,
				identifier,
				trade_type_id)
			values(
				@queued_underlying_trade_id,
				@queued_deal_id,
				@batch_id,
				@user_id,
				@trade_date,
				@forward_tally_type_id,
				@underlying_contract_id,
				@value_date,
				@quantity,
				@strike,
				@external_account_id,
				@internal_account_id,
				@counterparty_id,
				@trader_id,
				@strategy_id,
				@broker_id,
				@identifier,
				@ex_trade_type_id)
		end
	
	
	
		select
			@trades = count(*)
		from
			#trades_output
		where
			trade_id > @trade_id
	end
end
	
create table
	#booked_trades(
		id int identity,
		style varchar(250) NULL,
		trade_id int NULL,
		account varchar(50) NULL,
		trade_type varchar(50) NULL,
		symbol varchar(50) NULL,
		value_date datetime NULL,
		quantity numeric(30,4) NULL,
		price float NULL)
insert into
	#booked_trades(
		style,
		trade_id,
		account,
		trade_type,
		symbol,
		value_date,
		quantity,
		price)
select
	style = @style,
	a.trade_id,
	account = b.symbol,
	trade_type = c.name,
	d.symbol,
	a.value_date,
	a.quantity,
	a.price
from
	trades a,
	external_accounts b,
	trade_types c,
	contracts d,
	deals e,
	deal_types f
where
	a.external_account_id = b.external_account_id
and
	a.trade_type_id = c.trade_type_id
and
	a.contract_id = d.contract_id
and
	a.deal_id = e.deal_id
and
	e.deal_type_id = f.deal_type_id
and
	f.name = "Option Exercise"
and
	a.trade_date = @expiration
select
	@tallied_trades = @@rowcount

if @tallied_trades > 0
begin
	update
		#prices
	set
		set_override = NULL,
		clear_override = NULL

	update
		#trades_output
	set
		override_yes = NULL,
		override_no = NULL,
		override_clear = NULL
end
	
if @days = NULL
begin
	select
		@message= "There are currently no upcoming option expirations"
end
else
begin
	if @is_today = "Yes"
	begin
		select
			@message = "There are expiring trades today"
	end
	else
	begin
		select
			@message = "The next expiration is in " + rtrim(convert(varchar(10), @days)) + " Days"
	end
end

if @message = NULL
begin
	select
		@message = "Expirations"
end

select
	section = @message,
	style = @style,
	as_of = "This report was run on " + convert(varchar(30), getdate())

select
	section,
	style,
	expiring,
	expiration_name,
	days,
	short_premium,
	long_premium,
	total_premium,
	ccy
from
	#output
order by
	id

if @is_today = "No"
begin
	update
		#trades_output
	set
		override_yes = NULL,
		override_no = NULL,
		override_clear = NULL
end

select
	section = "Vanilla Option Trades Expiring on  " + @expiration_name,
	a.style,
	a.trade_id,
	a.account,
	a.counterparty,
	a.symbol,
	a.quantity,
	a.underlying,
	a.exercise,
	a.status,
	a.override_yes,
	a.override_no,
	a.override_clear
from
	#trades_output a,
	option_contracts b
where
	a.contract_id = b.contract_id
order by
	id

select
	section = "Exotic Trades Expiring on  " + @expiration_name,
	a.style,
	a.trade_id,
	a.account,
	a.counterparty,
	a.symbol,
	a.quantity,
	a.underlying
from
	#trades_output a,
	exotic_contracts b
where
	a.contract_id = b.contract_id
order by
	id

if @is_today = "No"
begin
	update
		#prices
	set
		display_price = "No"
end

select
	section = "Expiration Prices",
	style,
	symbol,
	expiration_name,
	current_price,
	override_price,
	price,
	set_override,
	clear_override,
	status
from
	#prices
where
	display_price = "Yes"
and
	expiration_name != NULL
order by
	id
	

select
	@expiration = a.expiration
from
	option_expirations a,
	timezones b
where
	a.timezone_id = b.timezone_id
and
	convert(varchar(11), a.expiration) + " " + rtrim(b.timezone) = @expiration_name

select
	section = "Booked Expiration Trades",
	style,
	trade_id,
	account,
	trade_type,
	symbol,
	value_date,
	quantity,
	price
from
	#booked_trades
order by
	id


if @tallied_trades = 0
begin
	select
		section = "Suggested Trades",
		style = @style,
		account = d.symbol,
		counterparty = e.name,
		a.trade_date,
		trade_type = b.name,
		c.symbol,
		a.value_date,
		a.quantity,
		a.price
	from
		queued_trades a,
		trade_types b,
		contracts c,
		external_accounts d,
		counterparties e
	where
		a.trade_type_id = b.trade_type_id
	and
		a.contract_id = c.contract_id
	and
		a.external_account_id = d.external_account_id
	and
		a.counterparty_id = e.counterparty_id
	and
		a.batch_id = @batch_id
	if @@rowcount > 0
		select
			style = @style,
			tally_suggested_trades = "Tally Suggested Trades",
			batch_id = @batch_id
end
	
	
go
