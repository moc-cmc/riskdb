create table
	#contracts(
		contract_id int,
		symbol varchar(50),
		instrument_id int,
		exchange_id int,
		quantity int,
		product_id int,
		currency_id int,
		price_style_id int,
		factor float,
		forward_id int,
		forward_quantity int,
		forward_exchange_id int
)
insert into
	#contracts
select
	a.contract_id,
	a.symbol,
	a.instrument_id,
	c.exchange_id,
	c.quantity,
	d.product_id,
	e.product_id,
	f.price_style_id,
	f.factor,
	c.contract_id,
	c.quantity,
	c.exchange_id
from
	contracts a,
	#cts b,
	forwards c,
	products d,
	products e,
	price_styles f
where
	a.contract_id = b.contract_id
and
	a.contract_id = c.contract_id
and
	c.product_id = d.product_id
and
	c.currency_id = e.product_id
and
	f.name = "Standard"
/* no join on price_styles, insert all as Standard */
	
update
	#contracts
set
	price_style_id = b.price_style_id,
	factor = b.factor
from
	#contracts a,
	price_styles b,
	contract_price_styles c
where
	a.contract_id = c.contract_id
and
	b.price_style_id = c.price_style_id
and
	b.name = "Inverted"

select
	"type" = "ct",
	"id" = a.contract_id,
	"sy"  = a.symbol,
	"isid"= a.instrument_id,
	"egid"= a.exchange_id,
	"pdid"= a.product_id,
	"cyid"= a.currency_id,
	"qt"  = a.quantity,
	"pxseid" = a.price_style_id,
	"fc" = a.factor,
	"fwid" = a.forward_id,
	"fwqt" = a.forward_quantity,
	"fwegid" = a.forward_exchange_id
from
	#contracts a

select
	"type" = "ctsy",
	"id" = rtrim(convert(varchar(10), a.contract_id))+":"+rtrim(convert(varchar(10), a.source_id)),
	"ctid" = a.contract_id,
