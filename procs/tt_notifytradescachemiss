
create or replace procedure
	tt_notifytradescachemiss
		@source_id int,
		@start_notification_id int,
		@end_notification_id int=NULL,
		@max_notification_id int=NULL output

as

declare @source varchar(50)
declare @start_time datetime
declare @end_time datetime

select
	@start_time = getdate()

select
	@source = name
from
	sources
where
	source_id = @source_id
if @@rowcount != 1
begin
	select
		status = "error",
		message = "Source not found",
		source_id = @source_id,
		source = @source
	return
end


if @end_notification_id = NULL
begin
	select
		@end_notification_id = @start_notification_id
end

if @end_notification_id < @start_notification_id
begin
	select
		status = "error",
		message = "end notification id can not be less than start notification id. check your parameters",
		start_notification_id = @start_notification_id,
	        end_notification_id = @end_notification_id	

end

create table
	#trade_notifications(
		trade_notification_id int,
		trade_id int,
		source_id int,
		status_id int,
		capture_date datetime,
		notify_date datetime NULL,
		error varchar(255) NULL
)

insert into
	#trade_notifications
/*select top 500*/
select
	a.trade_notification_id,
	a.trade_id,
	a.source_id,
	a.status_id,
	a.capture_date,
	a.notify_date,
	a.error
from
	trade_notifications a,
	statuses b
where
	a.status_id = b.status_id
and
	a.trade_notification_id >= @start_notification_id
and
	a.trade_notification_id <= @end_notification_id
and
	source_id = @source_id
and
	b.name = "Active"
order by
	a.trade_notification_id 


/* select the max trade_notification_id from the list of notification
   we queried. this is because the above proc uses a select top x
   seo we need to let the app know what the last_id we processed is */
select
	@max_notification_id = max(trade_notification_id)
from
	#trade_notifications

if @max_notification_id = NULL
begin
	select
		@max_notification_id = @end_notification_id
end




