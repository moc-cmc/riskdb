
create or replace procedure
	tt_notifytractioncollateral
		@login varchar(25),
		@trade_date datetime=NULL
as

declare @fund_id int
declare @evaluation_currency_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @ids int
declare @external_account_id int

declare @account varchar(50)
declare @cash float 
declare @settlements float
declare @open_equity float
declare @total_equity float
declare @nop_short float
declare @margin_use float

declare @contract_id int
declare @value_date datetime
declare @days float
 
declare @spot_price float
declare @forward_price float
declare @give_product_rate float
declare @get_product_rate float
declare @missing_prices int
declare @fx_settlement_type_id int
declare @product_type_id int
declare @product_types int

declare @total_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)
declare @deficit_style varchar(250)
declare @client_style varchar(250)

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

exec
	r_daterangefordate
		@trade_date,
 	        @begin_date output,
		@end_date output


create table
	#external_accounts(
		id int identity,
		external_account_id int,
		symbol varchar(50),
		margin_multiplier float NULL)

insert into
	#external_accounts(
		external_account_id,
		symbol,
		margin_multiplier)

select
	a.external_account_id,
	a.symbol,
	a.margin_multiplier
from
	external_accounts a,
	fund_external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	a.external_account_type_id = c.external_account_type_id
and
	c.name in( "Client")
and
	a.symbol not in("INTERNAL", "FC FTPROA3900" )
order by
	a.symbol


create table
	#trades(
		trade_id int,
		prime_broker_id int NULL,
		external_account_id int,
		margin_multiplier float NULL,
		quantity float,
		contract_id int,
		product_id int,
		product_qty float,
		currency_id int,
		currency_qty float,
		price float,
		value_date datetime,
		status_id int,
		margin float NULL,
		product_type_id int NULL,
		product_equiv float NULL,
		currency_equiv float NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		margin_multiplier,
		quantity,
		contract_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		price,
		value_date,
		status_id,
		margin,
		product_type_id)
select
	a.trade_id,
	a.external_account_id,
	c.margin_multiplier,
	a.quantity,
	a.contract_id,
	b.product_id,
	a.quantity,
	b.currency_id,
	a.quantity * price * -1.0,
	a.price,
	a.value_date,
	a.status_id,
	margin = 0.0,
	d.product_type_id
from
	trades a,
	forwards b,
	#external_accounts c,
	products d
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	b.product_id = d.product_id
and
	a.value_date > @begin_date
and
	a.trade_date < @end_date
/* chriso: added since these
  accounts shouldnt have margin or open equity*/
and
	c.symbol not in("FC EDGEBOA", "FC INTERNAL")

update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.currency_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin

update
	#trades
set
	a.quantity = a.quantity * -1.0,
	a.product_qty = a.product_qty * -1.0,
	a.currency_qty = a.currency_qty * -1.0
from
	#trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"

create table
 #product_types(
		product_type_id int)
insert into
	#product_types(
		product_type_id)
select
	distinct(product_type_id)
from
	#trades

create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	distinct(product_id)
from
	#trades
insert into
	#conversion_rates(
		product_id)
select
	distinct(currency_id)
from
	#trades
where
	currency_id not in(select product_id from #conversion_rates)

update
	#conversion_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#trades
set
	a.product_equiv = a.product_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#trades
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id

select
	@fx_settlement_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end

create table
	#cash_balances(
		external_account_id int,
		product_id int NULL,
		quantity float NULL)
insert into
	#cash_balances(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	currency_id,
	sum(amount)
from
	account_transactions
where
	convert(date, transaction_date) < convert(date, @end_date)
and
	transaction_type_id = @fx_settlement_type_id
group by
	external_account_id,
	currency_id

insert into
	#cash_balances(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	currency_id,
	sum(amount)
from
	account_transactions
where
	transaction_type_id != @fx_settlement_type_id
and
	transaction_date <= @end_date
group by
	external_account_id,
	currency_id

create table
	#net_cash_balances(
		external_account_id int,
		product_id int,
		quantity float,
		equiv float NULL)
insert into
	#net_cash_balances(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	product_id,
	sum(quantity)
from
	#cash_balances
group by
	external_account_id,
	product_id

update
	#net_cash_balances
set
	a.equiv = a.quantity * b.rate
from
	#net_cash_balances a,
	#conversion_rates b
where
	a.product_id = b.product_id

create table
	#accounts(
		external_account_id int,
		cash float NULL)
insert into
	#accounts(
		external_account_id,
		cash)
select
	external_account_id,
	sum(equiv)
from
	#net_cash_balances
group by
	external_account_id

create table
	#settlements(
		external_account_id int,
		product_id int,
		product_type_id int,
		quantity float NULL)

insert into
	#settlements
select
	external_account_id,
	product_id,
	product_type_id,
	product_qty
from
	#trades
where
	value_date < @end_date

insert into
	#settlements
select
 
	external_account_id,
	currency_id,
	product_type_id,
	currency_qty
from
	#trades
where
	value_date < @end_date
	
create table
	#settling_balances(
		external_account_id int,
		product_id int,
		product_type_id int,
		quantity float,
		equiv float NULL)
 
insert into
	#settling_balances(
		external_account_id,
		product_id,
		product_type_id,
		quantity)
select
	external_account_id,
	product_id,
	product_type_id,
	sum(quantity)
from
	#settlements
group by
	external_account_id,
	product_id,
	product_type_id

delete

from
	#settling_balances
where
	quantity = 0.0


update
	#settling_balances
set
	a.equiv = a.quantity * b.rate
from
	#settling_balances a,
	#conversion_rates b
where
	a.product_id = b.product_id

create table
	#settlement_nets(
		external_account_id int,
		product_type_id int,
		equiv float NULL)
insert into
	#settlement_nets(
		external_account_id,
		product_type_id,
		equiv)
select
	external_account_id,
	product_type_id,
	sum(equiv)
from
	#settling_balances
group by
	external_account_id,
	product_type_id

create table
	#product_positions(
		external_account_id int,
		product_id int,
		product_type_id int,
		margin float,
		quantity float)
insert into
	#product_positions
select
	external_account_id,
	product_id,
	product_type_id,
	margin,	
	sum(product_qty)
from
	#trades
group by
	external_account_id,
	product_id,
	product_type_id,
	margin

insert into
	#product_positions
select
	external_account_id,
	currency_id,
	product_type_id,
	margin,
	sum(currency_qty)
from
	#trades
group by
	external_account_id,
	currency_id,
	product_type_id,
	margin

create table
	#margin_balances(
		external_account_id int,
		product_id int,
		product_type_id int,
		quantity float,
		margin float,
		equiv float NULL,
		usage float NULL)
insert into
	#margin_balances(
		external_account_id,
		product_id,
		product_type_id,
		margin,
		quantity)
select
	external_account_id,
	product_id,
	product_type_id,
	margin,
	sum(quantity)
from
	#product_positions
group by
	external_account_id,
	product_id,
	product_type_id,
	margin

update
	#margin_balances
set
	a.equiv = a.quantity * b.rate
from
	#margin_balances a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#margin_balances
set
	equiv = 0
where
	equiv >= 0.0

update
	#margin_balances
set
	usage = abs(equiv) * margin

create table
	#account_usage(
		external_account_id int,
		product_type_id int,
		nop_short float NULL,
		usage float NULL)
insert into
	#account_usage(
		external_account_id,
		product_type_id,
		nop_short,
		usage)
select
	external_account_id,
	product_type_id,
	sum(equiv),
	sum(usage)
from
	#margin_balances
group by
	external_account_id,
	product_type_id

create table
	#open_equity(
		external_account_id int,
		product_type_id int,
		open_equity float NULL)
insert into
	#open_equity(
		external_account_id,
		product_type_id,
		open_equity)
select
	external_account_id,
	product_type_id,
	sum(product_equiv + currency_equiv)
from
	#trades
where
	value_date > @end_date
group by
	external_account_id,
	product_type_id


create table
	#summary(
 	        external_account_id int,
		product_type_id int,
		settlements float NULL,
		open_equity float NULL,
		total_equity float NULL,
		nop_short float NULL,
		margin_use float NULL)
insert into
	#summary(
		external_account_id,
		product_type_id,
		settlements,
		open_equity,
		nop_short,
		margin_use)
select
	a.external_account_id,
	b.product_type_id,
	settlements = 0.0,
	open_equity = 0.0,
	nop_short = 0.0,
	margin_use = 0.0
from
	#external_accounts a,
	#product_types b

update
	#summary
set
	a.settlements = b.equiv
from
	#summary a,
	#settlement_nets b
where
	a.external_account_id = b.external_account_id
and
	a.product_type_id = b.product_type_id	

update
	#summary
set
	a.open_equity = b.open_equity
from
	#summary a,
	#open_equity b
where
	a.external_account_id = b.external_account_id
and
	a.product_type_id = b.product_type_id

update
	#summary
set
	total_equity = settlements + open_equity

update
	#summary
set
	a.nop_short = b.nop_short,
	a.margin_use = b.usage
from
	#summary a,
	#account_usage b
where
	a.external_account_id = b.external_account_id
and
	a.product_type_id = b.product_type_id

create table
	#sum_output(
		id int identity,
		row_type int,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		acct varchar(50) NULL,
		lei_number varchar(50) NULL,
		type varchar(250) NULL,
		product_type_id int NULL,
		product varchar(50) NULL,
		cash float NULL,
		settlements float NULL,
		open_eqty float NULL,
		total_equity float NULL,
		nop_short float NULL,
		margin_use float NULL,
		excess float NULL,
 		status varchar(50) NULL,
		currency varchar(5) NULL)

select
	@id = 0
select
	@ids = count(*)
from
	#external_accounts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#external_accounts
	where
		id > @id

	select
		@account = NULL,
		@cash = NULL,
		@settlements = NULL,
		@open_equity = NULL,
		@total_equity = NULL,
		@nop_short = NULL,
		@margin_use = NULL

	
	select
		@external_account_id = external_account_id,
		@account = symbol
	from
		#external_accounts
	where
		id = @id

	select
		@settlements = sum(settlements),
		@open_equity = sum(open_equity),
		@total_equity = sum(total_equity),
		@nop_short = sum(nop_short),
		@margin_use = sum(margin_use)
	from
		#summary
	where
		external_account_id = @external_account_id

	select
		@cash = cash
	from
		#accounts
	where
		external_account_id = @external_account_id

	insert into
		#sum_output(
			row_type,
			style,
			external_account_id,
			cash,
			settlements,
			open_eqty,
			total_equity,
			nop_short,
			margin_use)
	values(
		1,
		@total_style,
		@external_account_id,
		@cash,
		@settlements,
		@open_equity,
		@total_equity + @cash,
		@nop_short,
		@margin_use)

	insert into
		#sum_output(
			row_type,
			external_account_id,
			product_type_id,
			settlements,
			open_eqty,
			total_equity,
			nop_short,
			margin_use)
	select
		row_type = 0,
		external_account_id,
		product_type_id,
		settlements,
		open_equity,
		total_equity,
		nop_short,
		margin_use
	from
		#summary
	where
		external_account_id = @external_account_id
	order by
		product_type_id

	select
		@ids = count(*)
	from
		#external_accounts
	where
		id > @id
end

update
	#sum_output
set
	a.account = b.symbol
from
	#sum_output a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#sum_output
set
	a.lei_number = b.lei_number
from
	#sum_output a,
	account_regulatory_info b
where
	a.external_account_id=b.external_account_id

update
	#sum_output
set
	a.acct = b.symbol
from
	#sum_output a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.row_type = 1

update
	#sum_output
set
	style = @style
where
	style = NULL

update
	#sum_output
set
	a.product = b.name
from
	#sum_output a,
	product_types b
where
	a.product_type_id = b.product_type_id

update
	#sum_output
set
	a.type = c.name
from
	#sum_output a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
/* and
	row_type = 1 */

update
	#sum_output
set
	excess = total_equity - margin_use,
	status = "Excess"
where
	row_type = 1

update
	#sum_output
set
	style = @deficit_style,
	status = "Deficit"
where
	excess < 0.0

update
	#sum_output
set
	currency=c.symbol
from
	#sum_output a,
	external_accounts b,
	products c
where
	a.external_account_id=b.external_account_id
and
	b.evaluation_currency_id=c.product_id

