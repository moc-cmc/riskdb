
if object_id("cm_deltallydefaults") != NULL
    drop procedure
        cm_deltallydefaults
go

create procedure
	cm_deltallydefaults
		@login varchar(50),
		@tally_type varchar(50),
		@internal_account varchar(50),
		@external_account varchar(50),
		@trader varchar(25),
		@strategy varchar(50),
		@broker varchar(50)
as


declare @tico_account_id int
declare @tally_type_id int
declare @internal_account_id int
declare @external_account_id int
declare @trader_id int
declare @strategy_id int
declare @broker_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to determine logged in username"
	return
end

select
	@tally_type_id = tally_type_id
from
	tally_types
where
	name = @tally_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Tally type not found",
		tally_type = @tally_type
	return
end

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @internal_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Internal account not found",
		inernal_account = @internal_account
	return
end


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "External account not found",
		external_account = @external_account
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Trader not found",
		trader = @trader
	return
end

select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Strategy not found",
		strategy = @strategy
	return
end

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Broker not found",
		broker = @broker
	return
end


delete

from
	default_tally_accounts
where
	internal_account_id = @internal_account_id
and
	external_account_id = @external_account_id
and
	trader_id = @trader_id
and
	strategy_id = @strategy_id
and
	broker_id = @broker_id
and
	tico_account_id = @tico_account_id
and
	tally_type_id = @tally_type_id

exec
	cm_tallydefaults
		@login


go
