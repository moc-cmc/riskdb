drop procedure r_manageregulatoryinfo
go

create procedure
	r_manageregulatoryinfo
		@login varchar(50)

as

declare @fund_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL
)

insert into
	#meta
values(
	"Column Group",
	"section",
	NULL,
	NULL
)
insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)
insert into
        #meta
values(
        "Column Link",
        "edit_info",
        "Edit Regulatory Info",
        NULL
)
insert into
        #meta
values(
        "Column Link",
        "edit_fund",
        "Edit Regulatory Fund Info",
        NULL
)
insert into
        #meta
values(
        "Column Link",
        "gen_lei",
        "Generate LEI",
        NULL
)




select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

create table
        #funds(
                fund_id int,
                name varchar(50),
		legal_name varchar(50) NULL,
		shortcode varchar(10) NULL,
                country varchar(50) NULL,
                branch_location varchar(50) NULL,
                corporate_sector varchar(50) NULL,
                party_region varchar(10) NULL,
                financial_juristiction varchar(10) NULL,
                lei_number varchar(50) NULL,
		o_code varchar(10) NULL,
		style varchar(50) NULL
)

insert into
	#funds(
		fund_id,
		name
)
select
	fund_id,
	name
from
	funds
where
	fund_id = @fund_id

update
	#funds
set
	legal_name = a.legal_name,
	shortcode = a.shortcode,
	country = a.country,
	branch_location = a.branch_location,
	corporate_sector = a.corporate_sector,
	party_region = a.party_region,
	financial_juristiction = a.financial_juristiction,
	lei_number=a.lei_number,
	o_code = a.o_code
from
	fund_regulatory_info a,
	#funds b
where
	a.fund_id = b.fund_id


create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50),
                country varchar(50) NULL,
                branch_location varchar(50) NULL,
                corporate_sector varchar(50) NULL,
                party_region varchar(10) NULL,
                financial_juristiction varchar(10) NULL,
                lei_number varchar(50) NULL,
		lei_type varchar(10) NULL,
		style varchar(50) NULL
)

insert into
	#external_accounts(
		external_account_id,
		symbol)
select
	external_account_id,
	symbol
from
	external_accounts

update
	#external_accounts
set
	country = a.country,
	branch_location = a.branch_location,
	corporate_sector = a.corporate_sector,
	party_region = a.party_region,
	financial_juristiction = a.financial_juristiction,
	lei_number = a.lei_number,
	lei_type = a.lei_type
from
	account_regulatory_info a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#funds
set
	style = "background:#FFFFFF;border: 1px solid white"

update
	#external_accounts
set
	style = "background:#FFFFFF;border: 1px solid white"

update
	#external_accounts
set
	style = "background:#FFF942;border: 1px solid white;font-weight:bold"
from
	#external_accounts a,
	#funds b
where
	b.o_code = convert(varchar(4), a.lei_number)
and
	a.lei_type = "Issued"

update
	#external_accounts
set
        style = "background:#FFF942;border: 1px solid white;font-weight:bold"
from
        #external_accounts a,
        #funds b
where
	b.o_code != convert(varchar(4), a.lei_number)
and
	a.lei_type = "Internal"

/* OUTPUT */

select
        section = "Fund Regulatory Info",
	style,
        fund = name,
	legal_name = legal_name,
	shortcode = shortcode,
        country,
        branch_location,
        corporate_sector,
        party_region,
        financial_juristiction,
        lei_number,
	o_code,
        edit_fund = "EDIT"
from
        #funds
order by
        name


select
	section = "Account Regulatory Info",
	style,
	external_account = symbol,
	country,
	branch_location,
	corporate_sector,
	party_region,
	financial_juristiction,
	lei_type,
	lei_number,
	edit_info = "EDIT",
	gen_lei = case when lei_number = NULL then "Generate LEI" else "" end
from
	#external_accounts
order by
	symbol

go
	


		
