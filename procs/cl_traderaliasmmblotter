/*
|  Update trades to correct trade date if traded after 5:00PM
*/
update 
	#trades
set
	trade_date = dateadd(dd, 1, convert(char(12), trade_date, 112))
where
	trade_date >= convert(char(12), trade_date, 112) +" 17:00"

/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    price = case 
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.price) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.price) * d.factor
        when c.factor != NULL then
            a.price * c.factor * d.factor
        else
            a.price * d.factor
    end/*,
    min_scale = c.min_scale + 1,
    max_scale = c.max_scale*/
from
    #trades a,
    trades e,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.trade_id = e.trade_id
and
    e.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id

update
    #trades
set
    min_scale = 4,
    max_scale = 6
where
    min_scale = NULL
or
    max_scale = NULL

update
	#trades
set
	a.product = case
	    when a.fixing_date != NULL then
		"NDF"
	    else
		c.name
	end
from
	#trades a,
	trades b,
	trade_types c
where
	a.trade_id = b.trade_id
and
	b.trade_type_id = c.trade_type_id


update
	#trades
set
	dealt_currency = d.symbol
from
	#trades a,
	trades b,
	forwards c,
	products d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.product_id = d.product_id


update
	#trades
set
	contra_currency = d.symbol
from
	#trades a,
	trades b,
	forwards c,
	products d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.currency_id = d.product_id

	
update
	#trades
set
	a.provider_name = rtrim(c.symbol) +"-"+ rtrim(e.symbol)
from
	#trades a,
	trades b,
	internal_accounts c,
	external_account_prime_brokers d,
	prime_broker_symbols e
where
	a.trade_id = b.trade_id
and
	b.internal_account_id = c.internal_account_id
and
	b.external_account_id = d.external_account_id 
and
	d.prime_broker_id = e.prime_broker_id
	
update
	#trades
set
	a.customer_trader = c.symbol
from
	#trades a,
	trades b,
	traders c
where
	a.trade_id = b.trade_id
and
	b.trader_id = c.trader_id

/* Overwrite traders who have 'Agency Client' trader symbols */

update
        #trades
set
        a.customer_trader = c.symbol
from
        #trades a,
        trades b,
        trader_symbols c,
	sources d
where
        a.trade_id = b.trade_id
and
	b.trader_id = c.trader_id
and
	c.source_id = d.source_id
and
	d.name = "Agency Client"	

update
	#trades
set
	mid = b.mid_mark
from
	#trades a,
	trade_attributes b
where
	a.trade_id = b.trade_id

update 
	#trades
set
	buy_sell = "SELL"
where
	dealt_amount < 0
update 
	#trades
set
	buy_sell = "BUY"
where
	dealt_amount > 0

update 
	#trades
set
	dealt_amount = abs(dealt_amount),
	contra_amount = abs(contra_amount),
	currency_pair = rtrim(dealt_currency) + "-" + rtrim(contra_currency)
    
/* KLS: Fri Jun 17 10:17:08 CDT 2011 Per JC again, we're forcing all decimal
 * places to go out 8 places for all currency pairs. Then we disabled rounding
 * completely just to test. */

update
    #trades
set
    min_scale = 6,
    max_scale = 6

/* KLS: Per JC's request, we need the spot_rate to show the the spot rate for */
update
    #trades
set
	spot_rate = price
where
    spot_rate = NULL

update 
	#trades
set
	contra_amount = round(contra_amount, 0)
where
	contra_currency = "JPY"

update
	#trades
set
	spot_rate = round((floor(spot_rate * power(10, 7))/power(10, 7)), 6),
	price = round((floor(price * power(10, 7))/power(10, 7)), 6)

update 
	#trades
set 
        spot_rate = round((floor(spot_rate * power(10, 5))/power(10, 5)), 4),
        price = round((floor(price * power(10, 5))/power(10, 5)), 4)
where
        currency_pair like "%JPY%"
and
        currency_pair not like "%USD%"



/*
| Query option details
*/
update
	#trades
set
	optcon_exercise_style_id = b.exercise_style_id,
	optcon_exercise_style = c.name,
	optcon_strike = b.strike,
	optcon_put_call = b.put_call,
	option_expiration_id = b.option_expiration_id
from
	#trades a,
	option_contracts b,
	exercise_styles c
where
        a.contract_id = b.contract_id

update
	#trades
set
	optcon_put_call = "PUT"
where
	optcon_put_call = "P"

update 
        #trades
set
        optcon_put_call = "CALL"
where
        optcon_put_call = "C"

update
	#trades
set
	option_id = b.option_id,
	optexp_symbol = b.symbol,
	optexp_expiration = b.expiration,
	optexp_timezone_id = b.timezone_id
from
        #trades a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id

update 
	#trades
set
	optexp_time_zone = b.timezone,
	optexp_tz_symbol = b.symbol,
	optexp_tz_expiration_time = b.expiration_time,
	optexp_tz_display_value = b.display_value,
	optexp_tz_status = b.status
from
	#trades a,
	timezones b
where
	a.optexp_timezone_id = b.timezone_id

update
	#trades
set
	opt_underlying_contract_id = b.underlying_contract_id,
	opt_exchange_id = b.exchange_id,
	opt_exchange = c.name,
	opt_def_exercise_style_id = b.def_exercise_style_id,
	opt_def_exercise_style = d.name,
	opt_quantity = b.quantity,
	opt_tick_size = b.tick_size
from
	#trades a,
	options b,
	exchanges c,
	exercise_styles d
where
	a.option_id = b.option_id
and
	b.exchange_id = c.exchange_id
and
	b.def_exercise_style_id = d.exercise_style_id

update
	#trades
set
	opt_underlying_contract = b.symbol
from
	#trades a,
	contracts b
where
	a.opt_underlying_contract_id = b.contract_id	

update
	#trades
set
	option_premium = b.amount,
	option_premium_ccy_id = b.currency_id,
	premium_settle_date = b.transaction_date
from
	#trades a,
	account_transactions b,
	account_transaction_trades c
where
	a.trade_id = c.trade_id
and
	c.account_transaction_id = b.account_transaction_id

update
	#trades
set
	option_premium_ccy = b.symbol
from
	#trades a,
	products b
where
	a.option_premium_ccy_id = b.product_id

update
	#trades
set
	option_settle_date = b.settledate
from
	#trades a,
	option_settledates b
where
	a.contract_id = b.contract_id



if @trade_id != NULL 
begin
	select
		@trade_type_id = trade_type_id
	from
		#trades
	where
		trade_id = @trade_id
	select
		@trade_type = name
	from
		trade_types
	where
		trade_type_id = @trade_type_id
end


if @trade_id != NULL and @trade_type = "Option"
begin

	create table
		#output(
			attributes varchar(50) NULL,
			trade_values varchar(50) NULL
		)
	
	insert into #output select "trade id", convert(varchar(50), trade_id) from #trades
	insert into #output select "trade date", convert(varchar(11), trade_date) from #trades
	insert into #output select "give up to", provider_name from #trades
	insert into #output select "client", customer_trader from #trades
	insert into #output select "buy/sell", buy_sell from #trades
	insert into #output select "put/call", rtrim(substring(opt_underlying_contract, 1, 3))+ " "+ optcon_put_call from #trades
	insert into #output select "underlying", opt_underlying_contract from #trades
	/*insert into #output select "product", dealt_currency from #trades*/
	insert into #output select "quantity", convert(varchar(50), dealt_amount) from #trades
	insert into #output select "strike", convert(varchar(50), optcon_strike) from #trades
	insert into #output select "expiration", convert(varchar(11), optexp_expiration) from #trades
	insert into #output select "time zone", optexp_time_zone from #trades
	insert into #output select "settle date", convert(varchar(11), option_settle_date) from #trades
	insert into #output select "premium", convert(varchar(50),option_premium) from #trades
	insert into #output select "premium ccy", option_premium_ccy from #trades
	insert into #output select "premium val date", convert(varchar(11), premium_settle_date) from #trades
        insert into #output select "spot_ref", convert(varchar(10), convert(numeric(30, 6), spot_rate)) from #trades
        insert into #output select "mid_mark", "" from #trades

	select
		attributes,
		trade_values
	from 
		#output
end
else
begin

	select  
		trade_id,
		trade_date = convert(varchar(11), trade_date, 1),
		provider_name,
		customer_trader,
		currency_pair,
		buy_sell,
		dealt_currency,
		dealt_amount,
		contra_currency,
		contra_amount = contra_amount,
		/* Remove spot date
		spot_date, */
		/* No Price Improvement logic */
		/*
		spot_rate = case buy_sell
        	when "BUY" then
            	ceiling(spot_rate * power(10, max_scale)) / power(10, max_scale)
        	else
            	floor(spot_rate * power(10, max_scale)) / power(10, max_scale)
        	end,
		forward_points,
		price = case buy_sell
        	when "BUY" then
            	ceiling(convert(numeric(30, 7), price) * power(10, max_scale)) / power(10, max_scale)
        	else
            	floor(convert(numeric(30, 7), price) * power(10, max_scale)) / power(10, max_scale)
		end,
		*/
		/* Truncate the 8th+ decimals and round to 6 decimal off of the 7th decimal */
		/*
		spot_rate = round((floor(spot_rate * power(10, 7))/power(10, 7)), 6),
		price = round((floor(price * power(10, 7))/power(10, 7)), 6),
		*/
		/* spot_rate, */
		price,
		mid,
		fixing_date,
		value_date,
		product	
	from 
		#trades 
	order by 
		trade_id
end

