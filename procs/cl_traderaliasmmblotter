create table
	#trades(
		currency_pair varchar(20) NULL,
		trade_date datetime NULL,
		provider_name varchar(30) NULL,
		customer_trader varchar(30) NULL,
		trade_id int,
		value_date varchar(11) NULL,
		fixing_date varchar(11) NULL,
		product varchar(30) NULL,
		buy_sell varchar(10) NULL,
		dealt_currency varchar(20) NULL,
		dealt_amount numeric(30,2) NULL,
		contra_currency varchar(20) NULL,
		contra_amount numeric(30,2) NULL,
		spot_date varchar(11) NULL,
		spot_rate float NULL,
		forward_points float NULL,
		price float NULL,
		mid float NULL,
        	min_scale int NULL,
        	max_scale int NULL,
		contract_id int,
		trade_type_id int,
		/*- Option info -*/
		option_premium float NULL,
		option_premium_ccy_id int NULL,
		option_premium_ccy varchar(50) NULL,
                premium_settle_date datetime NULL,
		option_settle_date datetime NULL,
		optcon_exercise_style_id int NULL,
		optcon_exercise_style varchar(30) NULL,
		optcon_strike numeric(30, 6) NULL,
		optcon_put_call varchar(4) NULL,
                option_expiration_id int NULL,
		optexp_symbol varchar(30) NULL,
		optexp_expiration datetime NULL,
		optexp_timezone_id int NULL,
		optexp_time_zone varchar(30) NULL,
		optexp_tz_symbol varchar(30) NULL,
		optexp_tz_expiration_time varchar(30) NULL,
		optexp_tz_display_value varchar(25) NULL,
		optexp_tz_status int NULL,
		option_id int NULL,
		opt_underlying_contract_id int NULL,
		opt_underlying_contract varchar(50) NULL,
		opt_exchange_id int NULL,
		opt_exchange varchar(25) NULL,
		opt_def_exercise_style_id int NULL,
		opt_def_exercise_style varchar(30) NULL,
		opt_quantity float NULL,
		opt_tick_size float NULL,
		/*- Exotic Info -*/
                /*  n/a */
		)

if @trade_id = NULL
begin
	insert into
		#trades(
			trade_id,
			dealt_amount,
			contra_amount,
			price,
			value_date,
			trade_date,
			fixing_date,
			spot_rate,
			contract_id,
			trade_type_id)
	select
		a.trade_id,
		a.quantity * -1.0,     /* quantity goes in with client view and is updated to abs value with update */
		a.quantity * a.price,
		a.price,
		value_date = convert(varchar(11), a.value_date, 1),
		a.trade_date,
		fixing_date = convert(varchar(11), a.fixing_date, 1),
		a.spot_reference,
		a.contract_id,
		a.trade_type_id
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        	#trade_notifications h
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.trade_id = h.trade_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
	and
		a.quantity != 0
end
else   /* Identical to above query with @trade_id qualifier, and dateranges for trade_id */
begin
	select
		@trade_date = trade_date
	from
		trades
	where
		trade_id = @trade_id
        if @trade_date = NULL
	begin
		select
			"status" = "Error",
			"error" = "Trade ID does not exist"
		return
	end
			
	select
		@begin_date = convert(datetime, convert(char(11), @trade_date, 1))

	exec
		r_nextbusinessday
			@begin_date,
			@end_date output


	insert into
		#trades(
			trade_id,
			dealt_amount,
			contra_amount,
			price,
			value_date,
			trade_date,
			fixing_date,
			spot_rate,
			contract_id,
			trade_type_id)
	select
		a.trade_id,
		a.quantity * -1.0,     /* quantity goes in with client view and is updated to abs value with update */
		a.quantity * a.price,
		a.price,
		value_date = convert(varchar(11), a.value_date, 1),
		a.trade_date,
		fixing_date = convert(varchar(11), a.fixing_date, 1),
		a.spot_reference,
		a.contract_id,
		a.trade_type_id
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        	#trade_notifications h
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
    	and
		a.trade_id = h.trade_id
        /*
        and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
        */
	and
		a.trade_id = @trade_id
	and
		a.quantity != 0
end

