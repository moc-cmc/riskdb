drop procedure
	fxa_clientnotificationalias
go

create procedure
	fxa_clientnotificationalias
		@external_account varchar(50)

as


declare @external_account_id int
declare @agency_client_source_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where 
	symbol = @external_account
if @@rowcount != 1
begin
	select
		error = "Error",
		messasge = "Problem determining external account",
		external_account = @external_account
	return
end

select
	@agency_client_source_id = source_id
from
	sources
where
	name = "Agency Client"
if @@rowcount != 1
begin
	select
		error = "Error",
		message = "Problem finding source for 'Agency Client'"
	return
end

select
	symbol
from
	external_account_symbols
where
	source_id = @agency_client_source_id
and
	external_account_id = @external_account_id



go
