update
        #trade_notifiers
set
        external_account = b.symbol,
	aggregation_style_id = c.aggregation_style_id,
	aggregation_style = c.name
from
        #trade_notifiers a,
        external_accounts b,
	aggregation_styles c
where
        a.external_account_id = b.external_account_id
and
	b.aggregation_style_id = c.aggregation_style_id

update
        #trade_notifiers
set
        trader = b.symbol
