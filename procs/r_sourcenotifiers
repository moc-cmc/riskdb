create table
        #trade_notifiers(
                trade_notifier_id int NULL,
		source_id int NULL,
		source varchar(50) NULL,
                external_account_id int NULL,
		external_account varchar(50) NULL,
                counterparty_id int NULL,
		counterparty varchar(50) NULL,
                trader_id int NULL,
		trader varchar(50) NULL,
                status_id int NULL,
		status varchar(50) NULL,
		trade_type_id int NULL,
		trade_type varchar(50) NULL,
                broker_id int NULL,
		broker varchar(50) NULL,
		notifier_date datetime NULL,
		notification_status_id int NULL,
		notification_status varchar(50) NULL,
		edit_notifier varchar(50) NULL,
		delete_notifier varchar(50) NULL,
		aggregation_style_id int NULL,
		aggregation_style varchar(50) NULL
	)



insert into
       #trade_notifiers(
		trade_notifier_id,
		source_id,
		external_account_id,
		broker_id,
		trader_id,
		counterparty_id,
		status_id,
		trade_type_id,
		notification_status_id,
		notifier_date,
		edit_notifier,
		delete_notifier
       )
