	trade_notifier_id,
        source_id,
        external_account_id,
        broker_id,
        trader_id,
        counterparty_id,
        status_id,
	trade_type_id,
        notification_status_id,
        notifier_date,
        edit_notifier = "EDIT NOTIFIER",
        delete_notifier = "DELETE NOTIFIER"

from
	trade_notifiers

update
        #trade_notifiers
set
        external_account = b.symbol,
	aggregation_style_id = c.aggregation_style_id,
	aggregation_style = c.name
from
        #trade_notifiers a,
        external_accounts b,
	aggregation_styles c
where
        a.external_account_id = b.external_account_id
and
	b.aggregation_style_id = c.aggregation_style_id

update
        #trade_notifiers
set
        trader = b.symbol
from
        #trade_notifiers a,
        traders b
where
