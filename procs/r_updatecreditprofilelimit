create or replace procedure
	r_updatecreditprofilelimit
		@login varchar(50),
		@credit_profile_name varchar(50),
		@nop_limit numeric(30,4)=NULL,
		@dsl_limit numeric(30,4)=NULL,
		@timestamp datetime=NULL,
		@successful_update varchar(1) output

as

declare @tico_account_id int
declare @source_id int
declare @credit_profile_id int
declare @has_credit_profile_access varchar(1)

select
        @successful_update = "N"

if @nop_limit = NULL and @dsl_limit = NULL
begin
        select
                status = "Error",
                msg = "Must provide NOP or DSL limit"
        return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		msg = "Unable to resolve login",
                login = @login
	return
end

select
        @credit_profile_id = credit_profile_id
from
        credit_profiles
where
        name = @credit_profile_name
if @credit_profile_id = NULL
begin
        select
                status = "Error",
                msg = "Credit profile not found",
                credit_profile_name = @credit_profile_name
        return
end


select 
        @has_credit_profile_access = "Y"
from
        user_credit_profiles
where
        user_id = @tico_account_id
and
        credit_profile_id = @credit_profile_id
if @has_credit_profile_access != "Y"
begin
        select
                status = "Error",
                msg =  "No access to modify credit profile"
        return
end

if @timestamp = NULL
begin
        select
                @timestamp = getdate()
end

create table
        #credit_profiles(
                credit_profile_id int,
		name varchar(50),
		currency_id int,
		nop_type_id int,
		nop_limit float,
		dsl_type_id int,
		dsl_limit float,
		notice_level float,
		warning_level float,
		blocked_level float,
		edited_by int NULL,
		timestamp datetime NULL
        )

insert into
        #credit_profiles(
                credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level)

select
                credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level
from         
                credit_profiles
where
                credit_profile_id = @credit_profile_id

update
                #credit_profiles
set
                edited_by = @tico_account_id

update
                #credit_profiles
set
                timestamp = @timestamp

begin tran
insert into 
        archive_credit_profiles(
                credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level,
                edited_by,
                timestamp
)
select
        credit_profile_id,
        name,
        currency_id,
        nop_type_id,
        nop_limit,
        dsl_type_id,
        dsl_limit,
        notice_level,
        warning_level,
        blocked_level,
        edited_by,
        timestamp 

from
        #credit_profiles
where 
        credit_profile_id = @credit_profile_id
if @@rowcount != 1
begin
        select
                status = "Error",
                msg = "Problem archiving credit profile"
        rollback tran
        return
end

if @nop_limit != NULL
begin
        update 
                credit_profiles
        set
                nop_limit = @nop_limit
        where
                credit_profile_id = @credit_profile_id
        if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                msg = "Problem editing credit profile"
                rollback tran
                return
        end
end

if @dsl_limit != NULL
begin
        update
                credit_profiles
        set
                dsl_limit = @dsl_limit
        where
                credit_profile_id = @credit_profile_id
        if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                msg = "Problem editing credit profile"
                rollback tran
                return
        end             
end     

commit tran

select
        @successful_update="Y"

go

