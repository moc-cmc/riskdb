
if object_id("r_optionposplfordate") != NULL
    drop procedure
        r_optionposplfordate
go

  
create procedure
	r_optionposplfordate
		@contract_id int,
		@quantity numeric(30,2),
		@begin_date datetime,
		@end_date datetime,
		@open_price float output,
		@begin_value float output,
		@close_price float output,
		@end_value float output,
		@p_l float output
		
as

declare @multiplier float
declare @delta float
declare @gamma float
declare @theta float
declare @tau float
declare @eval_method char(200)

exec
	r_contractevalmethod
		@contract_id,
		@eval_method output


if @eval_method = "Internal Theo"
begin
	exec
		r_postheosasof
			@contract_id,
			@begin_date,
			@open_price output,
			@delta output,
			@gamma output,
			@theta output,
			@tau output

	exec
		r_postheosasof
			@contract_id,
			@end_date,
			@close_price output,
			@delta output,
			@gamma output,
			@theta output,
			@tau output 
end

if @eval_method = "External Mark"
begin
	exec
		r_priceasof
			@contract_id,
			@begin_date,
			@open_price output

	exec
		r_priceasof
			@contract_id,
			@end_date,
			@close_price output 
end


exec
	x_contractmultiplier
		@contract_id,
		@multiplier output


select
	@begin_value = @open_price * @quantity * @multiplier,
	@end_value = @close_price * @quantity * @multiplier

select
	@p_l = @end_value - @begin_value


return

go
