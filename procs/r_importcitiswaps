use
	risk_finotec
go

drop procedure
	r_importcitiswaps
go

create procedure
	r_importcitiswaps
		@login varchar(50),
		@purpose varchar(200)=NULL,
		@portfolio varchar(200)=NULL,
		@ccy1 varchar(50)=NULL,
		@ccy1_amount float=NULL,
		@ccy2 varchar(50)=NULL,
		@ccy2_amount float=NULL,
		@rate float=NULL,
		@far_rate float=NULL,
		@value_date datetime=NULL,
		@far_date datetime=NULL,
		@quote_id varchar(100)=NULL,
		@user_id varchar(100)=NULL,
		@update_time varchar(100)=NULL,
		@status varchar(200)=NULL,
		@row_count int,
		@row_index int,
		@session_id varchar(100)

as

declare @source varchar(50)
declare @source_id int
declare @lookup_counterparty varchar(50)
declare @lookup_trader varchar(50)
declare @trader_id int
declare @counterparty_id int
declare @identifier varchar(100)
declare @tally_type varchar(25)
declare @buy_sell varchar(5)
declare @fund_id int
declare @fund varchar(50)
declare @trader_login varchar(50)
declare @symbol varchar(50)
declare @price float
declare @val_date datetime
declare @trade_date datetime
declare @price_style varchar(50)
declare @contract_id int
declare @broker_id int
declare @external_account_id int
declare @account varchar(50)
declare @total int

declare @trader_tico_account_id int
declare @swap_symbol_id int
declare @swap_symbol varchar(50)
declare @near_identifier varchar(100)
declare @far_identifier varchar(100)
declare @far_price float
declare @far_val_date datetime
declare @far_quantity float
declare @trade_id int
declare @far_trade_id int
declare @deal_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@trade_date = convert(datetime, right(@update_time, char_length(@update_time) - 4))

select
	@trade_date = convert(datetime, convert(date, @trade_date))

select
	@val_date = convert(datetime, @value_date)


select
	@total = count(*)
from
	session_val_dates
where
	session_id = @session_id
and
	value_date = @val_date
if @total = 0
begin
	insert into
		session_val_dates
	values(
		@session_id,
		@val_date)
end


select
	@source = "Citi Rolls Import"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		error="Error",
		msg="Problem determining source",
		source=@source
	return
end


select
	@symbol = rtrim(@ccy1) + rtrim(@ccy2)
select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end


if abs(convert(float, @ccy1_amount)) != 0.0
begin
	select
		@price = abs(convert(float, @ccy2_amount) / convert(float, @ccy1_amount))
end
else
begin
	select
		status = "Error",
		message = "Ecountered zero quantity"
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id

if @price_style = "Inverted"
	select
		@price = 1.0 / @price



if (@purpose = "ROL" or @purpose = "EXC") and @far_date != NULL
begin
	select
		@trader_login = a.login,
		@trader_tico_account_id = a.account_id
	from
		tico_accounts a,
		fund_roll_traders b,
		traders c
	where
		b.roll_trader_id = c.trader_id
	and
		a.account_id = c.tico_account_id
	if @trader_login = NULL
	begin
		select
			status = "Error",
			message = "Roll trader not configured"
		return
	end

	select
		@broker_id = a.broker_id,
		@external_account_id = a.external_account_id
	from
		default_tally_accounts a,
		tally_types b
	where
		a.tico_account_id = @trader_tico_account_id
	and
		a.tally_type_id = b.tally_type_id
	and
		b.name = "Swap"
	if @broker_id = NULL
	begin
		select
			status = "Error",
			message = "Broker not found"
		return
	end

	select
		@account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	exec
		j_nextkey
			"swap_symbols",
			@swap_symbol_id output

	select
		@near_identifier = rtrim(@quote_id)+'.near',
		@far_identifier = rtrim(@quote_id)+'.far',
		@far_price = convert(float, @far_rate),
		@far_val_date = convert(datetime, @far_date)

	
	select
		@trade_id = trade_id
	from
		trades
	where
		identifier = @near_identifier
	and
		broker_id = @broker_id

	select
		trade_id = @trade_id
	if @trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @trader_login,
				@source = @source,
				@trade_id = @trade_id output,
				@deal_id = @deal_id output,
				@tally_type = "Swap",
				@deal_type = "Market Swap",
				@trade_type = "Swap Near",
				@symbol = @symbol,
				@quantity = @ccy1_amount,
				@price = @price,
				@trade_date = @trade_date,
				@value_date = @val_date,
				@identifier = @near_identifier,
				@sales_code = "None",
				@counterparty = "CITI-CITI"

		select
			@swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".M"
		insert into
			swap_symbols
		values(
			@swap_symbol_id,
			@swap_symbol,
			getdate())
		insert into
			swap_symbol_trades
		values(
			@swap_symbol_id,
			@trade_id)
	end

	select
		@far_quantity = @ccy1_amount * -1.0

	select
		@far_trade_id = trade_id
	from
		trades
	where
		identifier = @far_identifier
	and
		broker_id = @broker_id
	if @far_trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @trader_login,
				@source = @source,
				@trade_id = @far_trade_id output,
				@deal_id = @deal_id output,
				@tally_type = "Swap",
				@deal_type = "Market Swap",
				@trade_type = "Swap Far",
				@symbol = @symbol,
				@quantity = @far_quantity,
				@price = @far_price,
				@trade_date = @trade_date,
				@value_date = @far_val_date,
				@identifier = @far_identifier,
				@sales_code = "None",
				@counterparty = "CITI-CITI"

		insert into
			swap_symbol_trades
		values(
			@swap_symbol_id,
			@far_trade_id)
	end

	exec
		r_setextacctrollrates
			@login = @login,
			@symbol = @symbol,
			@closing_date = @val_date,
			@closing_rate = @price,
			@roll_date = @far_val_date,
			@roll_rate = @far_price


	update
		ext_account_biproduct_rates
	set
		closing_rate = @price,
		roll_date = @far_val_date,
		roll_rate = @far_price
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id
	and
		closing_date = @val_date
	if @@rowcount != 1
	begin
		insert into
			ext_account_biproduct_rates(
				external_account_id,
				contract_id,
				closing_date,
				closing_rate,
				roll_date,
				roll_rate)
		values(
			@external_account_id,
			@contract_id,
			@val_date,
			@price,
			@far_val_date,
			@far_price)
	end 
end

if @purpose = "CLO" and @far_date = NULL
begin
	select
		@trader_login = a.login,
		@trader_tico_account_id = a.account_id
	from
		tico_accounts a,
		fund_resid_traders b,
		traders c
	where
		b.resid_trader_id = c.trader_id
	and
		a.account_id = c.tico_account_id
	if @trader_login = NULL
	begin
		select
			status = "Error",
			message = "Resid trader not configured"
		return
	end

	select
		@broker_id = a.broker_id
	from
		default_tally_accounts a,
		tally_types b
	where
		a.tally_type_id = b.tally_type_id
	and
		b.name = "Spot"
	and
		a.tico_account_id = @trader_tico_account_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Spot resid broker not found"
		return
	end


	select
		@identifier = rtrim(@quote_id)

	select
		@trade_id = trade_id
	from
		trades
	where
		identifier = @identifier
	and
		broker_id = @broker_id
	if @trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @trader_login,
				@source = @source,
				@trade_id = @trade_id output,
				@deal_id = @deal_id output,
				@tally_type = "Spot",
				@deal_type = "Market Forward",
				@trade_type = "Spot",
				@symbol = @symbol,
				@quantity = @ccy1_amount,
				@price = @price,
				@trade_date = @trade_date, 
				@status = "Resid",
				@value_date = @val_date,
				@identifier = @identifier,
				@sales_code = "None"
	end

end

if @row_index = @row_count - 1
begin
	create table
		#meta(
			meta_type char(200),
			name char(50) NULL,
			action char(100) NULL,
			value char(200) NULL)

	insert into
		#meta
	values(
		"Column Link",
		"cash_settle",
		"Cash Settle Recon",
		NULL)


	select * from #meta

	select
		@fund = name
	from
		funds
	where 
		fund_id = @fund_id

	select
		run_name = @fund,
		value_date = convert(varchar(11), value_date, 1),
		cash_settle = "CASH SETTLE RECON"
	from
		session_val_dates
	where
		session_id = @session_id
	order by
		value_date

	delete

	from
		session_val_dates
	where
		session_id = @session_id
end


go
