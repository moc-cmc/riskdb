
if object_id("r_markettallytraders") != NULL
    drop procedure
        r_markettallytraders
go

create procedure 
		r_markettallytraders

as

declare @source_id int
declare @external_account_type_id int

select
        @source_id = source_id
from
        sources
where
        name = "MPT Pulldown"

select
        @external_account_type_id = external_account_type_id
from
        external_account_types
where
        name = "Counterparty"

select
        a.symbol
from
        trader_symbols a,
        traders b,
        external_accounts c
where
        a.trader_id = b.trader_id and
        b.external_account_id = c.external_account_id and
        c.external_account_type_id = @external_account_type_id and
        a.source_id = @source_id
order by
        a.symbol


go
