drop procedure ag_undoclosesettledbalscfd
go

create procedure
	ag_undoclosesettledbalscfd
		@login varchar(50),
		@account varchar(50),
		@settle_date datetime,
		@converted_amount numeric(30,2)
as


declare @tico_account_id int
declare @cfd_transaction_type_id int
declare @external_account_id int
declare @closed_account_transactions int
declare @account_transactions int
declare @account_transaction_id int
declare @last_id int
declare @sb_id int
declare @product_id int
declare @amount float
declare @transaction_date datetime
declare @converted_balance float
declare @conversion_rate float
declare @net_settlement float
declare @currency_id int
declare @new_account_transaction_id int
declare @balances int
declare @unconverted_status_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@cfd_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "CFD Settlement"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "CFD Settlement transaction type not found"
	return
end

select
	@unconverted_status_id = status_id
from
	statuses
where	
	name = "Undo Conversion"


select
	@external_account_id = external_account_id,
	@currency_id = evaluation_currency_id
from
	external_accounts
where
	symbol = @account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

select
	@balances = 0

select
	@balances = count(*)
from
	cfd_settlement_balances
where
	external_account_id = @external_account_id
and
	convert(date, transaction_date) = convert(date, @settle_date)
if @balances = 0
begin
	select
		status = "Error",
		message = "No CFD Settled balances found for account and settledate",
		account = @account,
		settle_date = @settle_date
	return
end


select
	@amount = amount
from
	account_transactions
where
        external_account_id = @external_account_id
and
        convert(date, transaction_date) = convert(date, @settle_date)
and
        transaction_type_id = @cfd_transaction_type_id

	

begin tran
	/* Delete the netted settlement */
	delete

	from
		account_transactions
	where
		external_account_id = @external_account_id
	and
		convert(date, transaction_date) = convert(date, @settle_date)
	and
		transaction_type_id = @cfd_transaction_type_id


	/* Delete settlement balances */

	delete

	from
		cfd_settlement_balances
	where
		external_account_id = @external_account_id
	and
		convert(date, transaction_date) = convert(date, @settle_date)


	/* Insert into account transactions */
	
	insert into
		account_transactions
	select
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount,
		note
	from
		closed_account_transactions
	where
		external_account_id = @external_account_id
	and
		convert(date, transaction_date) = convert(date, @settle_date)
	and
		transaction_type_id = @cfd_transaction_type_id


	/* Delete from closed account transactions */

	delete
		
	from
		closed_account_transactions
	where
		external_account_id = @external_account_id
	and
		convert(date, transaction_date) = convert(date, @settle_date)
	and
		transaction_type_id = @cfd_transaction_type_id

commit tran

insert into
        transaction_logs(
                settled_by,
                external_account_id,
                status_id,
                currency_id,
                amount,
                settle_date,
                timestamp)
values(
        @tico_account_id,
        @external_account_id,
        @unconverted_status_id,
        @currency_id,
        @amount,
        @settle_date,
        getdate())


exec
	ag_closesettlebalancescfd
		@login,
		@settle_date
	
go
