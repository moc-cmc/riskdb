
if object_id("api_addnewfuture") != NULL
    drop procedure
        api_addnewfuture
go

create procedure
	api_addnewfuture
		@login varchar(30),
		@forward_symbol varchar(50),
		@future_symbol varchar(50),
		@root_symbol varchar(20),
		@exchange varchar(50),
		@quantity int,
		@tick_size float,
		@future_type varchar(50),
		@future_id int output 
as

declare @status_id int
declare @instrument_id int
declare @exchange_id int
declare @forward_id int
declare @future_type_id int


if @future_type not in("Regular", "Val Date")
begin
	select
		status = "Error",
		message = "Must provide future_type as 'Regular' or 'Val Date'"
	return
end

select
	@future_type_id = future_type_id
from
	future_types
where
	name = @future_type
if @@rowcount != 1
begin
	if @future_type in("Regular", "Val Date")
	begin
		exec
			j_nextkey
				"future_types",
				@future_type_id output
		insert into
			future_types
		values(
			@future_type_id,
			@future_type)
	end
	else
	begin
		select
			status = "Error",
			message = "Problem determining future type"
		return
	end
end

select
	@forward_id = a.contract_id
from
	forwards a,
	contracts b
where
	a.contract_id = b.contract_id
and
	b.symbol = @forward_symbol
if @forward_id = NULL
begin
	select
		status = "Error",
		message = "Underlying Forward Does Not Exist",
		forward_symbol = @forward_symbol
	return
end

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Future"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"instruments",
			@instrument_id output

	insert into
		instruments
	values(
		@instrument_id,
		"Future")
end

select
	@exchange_id = exchange_id
from
	exchanges
where
	name = @exchange
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem finding exchange"
	return
end

select
	@future_id = future_id
from
	futures
where
	name = @future_symbol
if @future_id != NULL
begin
	select
		status = "Dupe",
		message = "Future already exists in local database",
		future_symbol = @future_symbol
	return
end

exec
	j_nextkey
		"futures",
		@future_id output

insert into
	futures(
		future_id,
		forward_id,
		name,
		root_symbol,
		exchange_id,
		quantity,
		tick_size,	
		future_type_id)
values(
	@future_id,
	@forward_id,
	@future_symbol,
	@root_symbol,
	@exchange_id,
	@quantity,
	@tick_size,
	@future_type_id)


go
