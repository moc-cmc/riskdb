drop procedure
	ag_processqueuedwire
go

create procedure
	ag_processqueuedwire
		@login varchar(50),
		@pb_wire_signoff_id int
as

declare @fund_id int
declare @status varchar(50)
declare @out_transaction_type_id int
declare @in_transaction_type_id int
declare @external_account_id int
declare @out_transaction_id int
declare @in_transaction_id int
declare @tico_account_id int
declare @payment_account_id int
declare @currency_id int
declare @payments_amount numeric(30,4)
declare @account_amount numeric(30,4)
declare @processed_status_id int
declare @value_date datetime
declare @transaction_type_id int
declare @is_net_account char(1)


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@processed_status_id = status_id
from
	statuses
where
	name = "Processed"
if @processed_status_id = NULL
begin
	exec
		j_nextkey
			"statuses",
			@processed_status_id output

	insert into
		statuses(
			status_id,
			name)
	values(
		@processed_status_id,
		"Processed")
end

select
	@out_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Wire Out"
if @out_transaction_type_id = NULL
begin
	exec
		j_nextkey
			"transaction_types",
			@out_transaction_type_id output

	insert into
		transaction_types(
			transaction_type_id,
			name,
			direction)
	values(
		@out_transaction_type_id,
		"Wire Out",
		-1)
end


select
	@in_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Wire In"
if @in_transaction_type_id = NULL
begin
	exec
		j_nextkey
			"transaction_types",
			@in_transaction_type_id output

	insert into
		transaction_types(
			transaction_type_id,
			name,
			direction)
	values(
		@in_transaction_type_id,
		"Wire In",
		1)
end

select
	@payment_account_id = payments_ext_account_id
from
	funds
where
	fund_id = @fund_id
if @payment_account_id = NULL
begin
	select
		status = "Error",
		message = "Payments account not found"
	return
end

select
	@account_amount = amount * -1.0,
	@payments_amount = amount,
	@external_account_id = external_account_id,
	@currency_id = product_id,
	@value_date = value_date
from
	pb_wire_signoffs
where
	pb_wire_signoff_id = @pb_wire_signoff_id
if @account_amount = NULL
begin
	select
		status = "Error",
		message = "Wire signoff not found",
		pb_wire_signoff_id = @pb_wire_signoff_id
	return
end

if @account_amount = 0
	return

select
	@account_amount = @account_amount * -1,
	@payments_amount = @payments_amount * -1
from
	external_account_directions
where
	external_account_id = @external_account_id
and
	direction = -1

exec
	j_nextkey
		"account_transactions",
		@out_transaction_id output
exec
	j_nextkey
		"account_transactions",
		@in_transaction_id output

select
        @is_net_account = "Y"
from
        wire_net_accounts
where
        wire_net_account_id = @external_account_id

/* process the wire allocations first if this is a net wire 
   this is not in the transaction because we dont want a proc call in the transaction
   but logically, this should be in the transaction
*/
if @is_net_account = "Y"
begin
	exec
		ag_allocatenetwires
			@login=@login,
			@pb_wire_signoff_id=@pb_wire_signoff_id
end


begin tran
	update
		pb_wire_signoffs
	set
		a.status_id = @processed_status_id
	from
		pb_wire_signoffs a,
		statuses b
	where
		a.status_id = b.status_id
	and
		a.pb_wire_signoff_id = @pb_wire_signoff_id
	and
		b.name = "Pending"
	if @@rowcount = 0
	begin
		select
			status = "Error",
			message = "Pending wire not found",
			pb_wire_signoff_id = @pb_wire_signoff_id
		rollback tran
		return
	end

	if @account_amount < 0
		select
			@transaction_type_id = @out_transaction_type_id

	if @account_amount > 0
		select
			@transaction_type_id = @in_transaction_type_id

	insert into
		account_transactions(
			account_transaction_id,
			entered_by,
			external_account_id,
			transaction_type_id,
			transaction_date,
			currency_id,
			amount,
			note)
	values(
		@out_transaction_id,
		@tico_account_id,
		@external_account_id,
		@transaction_type_id,
		@value_date,
		@currency_id,
		@account_amount,
		convert(varchar(30), @pb_wire_signoff_id))
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to book wire out transaction",
			pb_wire_signoff = @pb_wire_signoff_id
		rollback tran
		return
	end

	if @payments_amount < 0
		select
			@transaction_type_id = @out_transaction_type_id

	if @payments_amount > 0
		select
			@transaction_type_id = @in_transaction_type_id

	insert into
		account_transactions(
			account_transaction_id,
			entered_by,
			external_account_id,
			transaction_type_id,
			transaction_date,
			currency_id,
			amount,
			note)
	values(
		@in_transaction_id,
		@tico_account_id,
		@payment_account_id,
		@transaction_type_id,
		@value_date,
		@currency_id,
		@payments_amount,
		convert(varchar(30), @pb_wire_signoff_id))
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to book wire in transaction",
			pb_wire_signoff_id = @pb_wire_signoff_id
		rollback tran
		return
	end

commit tran

/* exec
	tt_insertaccounttransnotification
		@account_transaction_id = @out_transaction_id

exec
	tt_insertaccounttransnotification
		@account_transaction_id = @in_transaction_id */


go
