drop procedure
	api_tallymarketfutoption
go

create procedure
	api_tallymarketfutoption
		@login varchar(25),
		@trade_date datetime=NULL,
		@buy_sell varchar(5),
		@quantity numeric(30,2),
		@expiration_symbol varchar(50),
		@strike varchar(50),
		@put_call char(1),
		@price float,
		@vol float=NULL,
		@deal_id int output,
		@trade_id int output
as

declare @sales_code varchar(50)
declare @trade_type varchar(25)
declare @contract_id int
declare @value_date datetime
declare @premium_currency varchar(50)
declare @currency_id int
declare @premium float
declare @premium_settle_date datetime
declare @multiplier numeric(30,4)
declare @option_expiration_id int
declare @put_call_string char(5)
declare @symbol varchar(50)
declare @vol_begin_date datetime
declare @vol_end_date datetime
declare @total int
declare @contract_tv_id int

if @buy_sell = "Sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @buy_sell = "Buy"
begin
	select
		@quantity = abs(@quantity)
end

select
	@sales_code = "None"


if @trade_date = NULL
	select
		@trade_date = getdate()


select
	@option_expiration_id = option_expiration_id
from
	option_expirations
where
	symbol = @expiration_symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem finding expiration symbol",
		expiration_symbol = @expiration_symbol
	return
end    

if upper(@put_call) = "P"
	select
		@put_call_string = "P"
if upper(@put_call) = "C"
	select
		@put_call_string = "C"
if @put_call_string = NULL
begin
	select
		id = -1,
		error = "Unable to determine put call option type",
		put_call = @put_call
	return
end


exec
	r_optioncontract
		@expiration_symbol,
		@strike,
		@put_call_string,
		@contract_id output


if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Could not create contract for option",
		expiration_symbol = @expiration_symbol,
		strike = @strike,
		put_call = @put_call_string
	return
end

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

exec
	x_contractmultiplier
		@contract_id,
		@multiplier output

exec
	r_contractcurrency
		@contract_id,
		@currency_id output

select
	@premium = @quantity * @price * @multiplier * -1.0

select
	@premium_settle_date = @trade_date

select
	@premium_currency = symbol
from
	products
where
	product_id = @currency_id


if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Could not create contract for option",
		expiration_symbol = @expiration_symbol,
		strike = @strike,
		put_call = @put_call_string
	return
end

select
	@value_date = a.expiration
from
	option_expirations a,
	option_contracts b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.contract_id = @contract_id

exec
	r_daterangefordate
		@trade_date,
		@vol_begin_date output,
		@vol_end_date output

select
	@trade_type = "Futures Option"

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Future",
		@deal_type = "Market Future",
		@trade_type = @trade_type,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@sales_code = @sales_code,
		@premium = @premium,
		@premium_currency = @premium_currency,
		@prem_settle_date = @premium_settle_date


if @vol != NULL
begin
	select
		@vol = @vol / 100.00

	select
		@total = count(*)
	from
		contract_tvs
	where
		contract_id = @contract_id
	if @total = 0
	begin
		exec
			j_nextkey
				"contract_tvs",
				@contract_tv_id output
		insert into
			contract_tvs
		values(
			@contract_tv_id,
			@contract_id,
			@price,
			NULL,
			NULL,
			NULL,
			NULL,
			NULL,
			@vol,
			NULL,
			NULL,
			NULL,
			@vol_begin_date)
		if @@rowcount = 1
			exec
				r_initoptcontract
					@contract_id
	end

end


go
