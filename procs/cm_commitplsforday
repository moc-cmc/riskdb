
if object_id("cm_commitplsforday") != NULL
    drop procedure
	cm_commitplsforday
go

create procedure
	cm_commitplsforday
		@login varchar(30),
		@trade_date datetime=NULL
as

declare @run_id int
declare @runs int
declare @run_name varchar(30)
declare @total_pl float
declare @begin_date datetime
declare @end_date datetime
declare @session_id int
declare @fund_type varchar(50)
declare @fund_id int
declare @fund_name varchar(50)


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Format Number",
	"p_l",
	NULL,
	NULL,
	"#,##0.00")


select * from #links

if @trade_date = NULL
	select
		@trade_date = getdate()

select
	@trade_date = convert(char(11), @trade_date, 1)

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@fund_type = a.name,
	@fund_name = b.name
from
	fund_types a,
	funds b
where
	a.fund_type_id = b.fund_type_id
and
	b.fund_id = @fund_id

exec
	j_nextkey
		"sessions",
		@session_id output


if @fund_type = "FX Agency"
begin
	/* Only commit the top level run for the fund */
	insert into
		session_runs
	select
		session_id = @session_id,
		run_id,
		trade_date = @end_date,
		p_l = 0.0
	from
		runs
	where
		name = @fund_name
end
else
begin
	insert into
	        session_runs
	select
	        session_id = @session_id,
	        run_id,
	        trade_date = @end_date,
	        p_l = 0.0
	from
	        runs
end


select
	@run_id = 0
select
	@runs = count(*)
from
	session_runs
where
	session_id = @session_id
and
	run_id > @run_id

while @runs > 0
begin
	select
		@run_id = min(run_id)
	from
		session_runs
	where
		session_id = @session_id
	and
		run_id > @run_id

	select
		@run_name = name
	from
		runs
	where
		run_id = @run_id

	select
		@total_pl = NULL

	exec
		cbo_runpl
			@login,
			@run_name,
			@trade_date,
			NULL,
			@total_pl output,
			"N"


	if @total_pl = NULL
		select
			@total_pl = 0.0

	update
		session_runs
	set
		p_l = @total_pl
	where
		session_id = @session_id
	and
		run_id = @run_id
	

	select
		@runs = count(*)
	from
		session_runs
	where
		session_id = @session_id
	and
		run_id > @run_id
end
		
exec
	cm_displaysessionruns
		@session_id


go
