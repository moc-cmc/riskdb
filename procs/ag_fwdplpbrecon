drop procedure
	ag_fwdplpbrecon
go

create procedure
	ag_fwdplpbrecon
		@login varchar(50),
		@trade_date datetime=NULL
as

declare @begin_date datetime
declare @end_date datetime
declare @fund_id int
declare @evaluation_currency_id int
declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"as_of_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"include_starting_positions",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"run_name",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"balance",
	"Run Ladder Views",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"include_positions",
	"Run Ladder Views",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"settle_price",
	"Number",
	 "#,##0.00000")

insert into
	#meta
values(
	"Column Format",
	"dealt_equiv_rate",
	"Number",
	 "#,##0.00000")

insert into
	#meta
values(
	"Column Format",
	"counter_equiv_rate",
	"Number",
	 "#,##0.00000")

insert into
	#meta
values(
	"Column Format",
	"rate",
	"Number",
	 "#,##0.00000")

insert into
	#meta
values(
	"Column Format",
	"dealt_equiv",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"counter_equiv",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"pl",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"deal_pl",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"counter_amt",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"dealt_amt",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"total",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"premium",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


if @trade_date = NULL
	select
		@trade_date = convert(datetime, convert(date, getdate()))

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not configured for login",
		login = @login
	return
end


/**********************************************************************/
create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	product_id
from
	products

update
	#conversion_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

/**********************************************************************/

create table
	#trades(
		style varchar(250) NULL,
		trade_id int,
		deal_id int,
		external_account_id int,
		account varchar(50) NULL,
		counterparty_id int NULL,
		counterparty varchar(50) NULL,
		broker_id int NULL,
		broker varchar(50) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(100) NULL,
		trade_type_id int NULL,
		trade_type varchar(50) NULL,
		trade_date datetime NULL,
		value_date datetime NULL,
		contract_id int NULL,
		product_id int NULL,
		dealt_ccy varchar(50) NULL,
		dealt_amt float NULL,
		dealt_equiv float NULL,
		dealt_equiv_rate float NULL,
		currency_id int NULL,
		counter_ccy varchar(50) NULL,
		counter_amt float NULL,
		counter_equiv float NULL,
		counter_equiv_rate float NULL,
		trade_price float NULL,
		settle_price float NULL,
		settle_price_source varchar(50) NULL,
		mtm_pl float NULL,
		equiv_mtm_pl float NULL,
		deal_pl float NULL)

insert into
	#trades(
		style,
		trade_id,
		deal_id,
		external_account_id,
		counterparty_id,
		broker_id,
		trade_type_id,
		trade_date,
		value_date,
		contract_id,
		product_id,
		dealt_ccy,
		dealt_amt,
		currency_id,
		counter_ccy,
		counter_amt,
		trade_price)
select
	style = @style,
	a.trade_id,
	a.deal_id,
	a.external_account_id,
	a.counterparty_id,
	a.broker_id,
	a.trade_type_id,
	a.trade_date,
	a.value_date,
	a.contract_id,
	c.product_id,
	d.symbol,
	a.quantity,
	c.currency_id,
	e.symbol,
	a.quantity * a.price * -1.0,
	a.price
from
	trades a,
	fund_external_accounts b,
	forwards c,
	products d,
	products e
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	c.product_id = d.product_id
and
	c.currency_id = e.product_id
and
	b.fund_id = @fund_id
and
	a.trade_date < @end_date
and
	a.trade_date >= @begin_date
and
	a.value_date >= @begin_date


update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.prime_broker = c.name
from
	#trades a,
	prime_brokers b,
	sources c
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = c.source_id

update
	#trades
set
	a.account = b.symbol
from
	#trades a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.counterparty = b.name
from
	#trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#trades
set
	a.broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id

update
	#trades
set
	a.settle_price = b.price,
	a.settle_price_source = "MPT EOD Snapshot"
from
	#trades a,
	prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @end_date)

update
	#trades
set
	a.dealt_equiv = a.dealt_amt * b.rate,
	a.dealt_equiv_rate = b.rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#trades
set
	a.counter_equiv = a.counter_amt * b.rate,
	a.counter_equiv_rate = b.rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id
	
	
update
	#trades
set
	a.trade_type = b.name
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id

create table
	#deal_pls(
		deal_id int,
		pl float NULL)
insert into
	#deal_pls(
		deal_id,
		pl)
select
	deal_id,
	sum(dealt_equiv + counter_equiv)
from
	#trades
group by
	deal_id

update
	#trades
set
	a.deal_pl = b.pl
from
	#trades a,
	#deal_pls b
where
	a.deal_id = b.deal_id

select
	a.style,
	a.trade_id,
	a.deal_id,
	a.account,
	a.counterparty,
	a.broker,
	a.trade_type,
	a.trade_date,
	a.value_date,
	a.dealt_ccy,
	a.dealt_amt,
	a.dealt_equiv,
	a.dealt_equiv_rate,
	a.counter_ccy,
	a.counter_amt,
	a.counter_equiv,
	a.counter_equiv_rate,
	a.trade_price,
	pl = a.dealt_equiv + a.counter_equiv,
	a.deal_pl,
	a.settle_price,
	a.settle_price_source,
	b.note
from
	#trades a,
	trade_attributes b
where
	a.trade_id *= b.trade_id
order by
	a.deal_id



go
