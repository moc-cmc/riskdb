
create procedure
	tt_farosflextradetally
       		@agent varchar(50),
       		@source varchar(50),
		@default_login varchar(50), 
		@granularity varchar(15)=NULL, /* Provided by FIX server config.properties & spring.xml */
		@broker varchar(50)=NULL, /* Provided by FIX server config.properties & spring.xml */
		@sender_comp varchar(50),
		@target_comp varchar(50), 
		@deliver_to_comp_id varchar(50),
		@deliver_to_sub_id varchar(50),
		@execution_id varchar(100)=NULL,
		@exec_trans_type varchar(25)=NULL,
       		@trade_date datetime,
       		@trading_day datetime,
       		@trade_report_id varchar(50),
		@trade_report_ref_id varchar(50)=NULL,
       		@order_id varchar(50),
       		@cl_order_id varchar(50),
     		@symbol varchar(50),
       		@value_date datetime,
       		@side varchar(10),
       		@qty1 float,
       		@price float,
		@executing_firm varchar(50)=NULL,
		@client_id varchar(50)=NULL,
		@currency varchar(15)=NULL,
		@last_spot_rate float=NULL,
		@last_fwd_points float=NULL,
		@client_prime varchar(50)=NULL,
		@fund_prime varchar(50),
		@trade_report_type varchar(50)=NULL,
		@leg_ref_id varchar(50)=NULL,
		@account varchar(50)=NULL,
		@sender_location_id varchar(50)=NULL


as


declare @suppress_trade char(1)
declare @committed_status_id int
declare @external_account_id int
declare @external_account_type varchar(25)
declare @aggregation_style_id int
declare @aggregation_style varchar(25)
declare @fund_agency_trader varchar(1)

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @counterparty varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int
declare @clvcl_counterparty varchar(50)

declare @lookup_cpty varchar(50)
declare @lookup_trdr varchar(50)
declare @broker_id int
declare @source_id int
declare @client_or_market char(1)
declare @user varchar(50)
declare @user_account_id int 
declare @sales_code_id int

declare @is_obo_trade char(1)



declare @tallied_trade_id int
declare @tallied_cpty_id int

declare @ccy1 char(3)
declare @cancel_trade_id int
declare @cancel_identifier varchar(50)

select @ccy1 = @currency

if @trade_report_type = "CANCEL_AND_UPDATE_REBOOK"
begin
	return
end

if @broker = NULL
        select
                @broker = "Flextrade"

/*
 * VERIFY @broker exist and check for dupe
 */
select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @@rowcount != 1
begin
        select
                "error"="Error",
                "msg"="Broker not found",
                "broker"=@broker
        return
end

/*
if @trade_report_ref_id != NULL   /* Cancel Message */
begin
	select
		@cancel_identifier = rtrim(@trade_report_ref_id)+convert(char(8), @trading_day, 112)

	select
		@cancel_trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id 
	and
		identifier = @cancel_identifier

	select
		@cancel_identifier,
		@cancel_trade_id 

	
	if @cancel_trade_id != NULL
	begin
		update 
			trades
		set
			quantity = 0
		where
			trade_id = @cancel_trade_id
		
		exec
			r_updatetradenotification
				@cancel_trade_id,
				"Cancelled"
		
		select
			msg = "Trade " + convert(varchar(50), @cancel_trade_id) + " has been cancelled"
	end

	
	return
		
end
*/


select
	@source_id = source_id
from
	sources
where
	name = @source
	


if @client_id = NULL  /* This is a market trade */
begin
	select
        	@lookup_cpty = rtrim(@fund_prime)+"-"+@executing_firm,
        	@lookup_trdr = @sender_comp,
        	@deal_type = "B2B Forward",
        	@deal_exec_symbol = rtrim(@cl_order_id)+convert(char(8), @trading_day, 112),
		@trade_identifier = rtrim(@trade_report_id)+convert(char(8), @trading_day, 112)

end


if @executing_firm = NULL  /* This is a client trade  */
begin
	select
		@fund_agency_trader = "N",
		@suppress_trade = "N"

	select
                @lookup_trdr = @deliver_to_sub_id

	select
		@fund_agency_trader = "Y"
	from	
		fund_agency_traders a,
		trader_symbols b
	where
		a.trader_id = b.trader_id 
	and
		b.source_id = @source_id
	and
		b.symbol = @deliver_to_sub_id
		
	if @fund_agency_trader != "Y"
	begin
		select
                	@fund_agency_trader = "Y"
        	from
                	fund_agency_traders a,
                	traders b
        	where
                	a.trader_id = b.trader_id
        	and
                	b.symbol = @deliver_to_sub_id
	end
	
	if @fund_agency_trader = "Y"
	begin
		select
                	@suppress_trade = "Y" 
		from
			suppression_symbols
		where
			source_id = @source_id
		and
			symbol = @deliver_to_comp_id
		
		if @suppress_trade = "Y"
		begin
			select
				@is_obo_trade = "N",
				@lookup_trdr = @deliver_to_comp_id
		end
	
	end
	
	if @fund_agency_trader = "Y" and @suppress_trade != "Y"
	begin	
		select
			@lookup_trdr = @deliver_to_comp_id,
			@is_obo_trade = "Y"
	end
	
		
	select
		@lookup_cpty = @client_id,
		@deal_type = "B2B Forward",
		@deal_exec_symbol = rtrim(@cl_order_id)+convert(char(8), @trading_day, 112),
        	@trade_identifier = rtrim(@leg_ref_id) /* might be rtrim(@leg_ref_id)+convert(char(8), @trading_day, 112) */
end


select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

/*---- chriso: We may not need granularity level 
   
if @granularity = "Account Level"
begin
	select
		@lookup_trader = @sender_sub_id
end
else if @granularity = "Trader Level"
begin
	select
		@lookup_trader = @sender_sub_id+"-"+@client_id
end
else
begin
	select 
		warning = "Warn",
		message = "Granularity level not 'Account Level' or 'Trader Level' - Defaulting to 'Account Level'",
		granularity = @granularity

	select
		@lookup_trader = @sender_sub_id
end
------ */

select 
	@counterparty = b.name,
	@counterparty_id = b.counterparty_id
from
	counterparty_symbols a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id 
and
	a.source_id = @source_id
and
	a.symbol = @lookup_cpty
if @counterparty = NULL
begin
	select
		@counterparty = name,
		@counterparty_id = counterparty_id
	from
		counterparties
	where
		name = @lookup_cpty
	if @counterparty = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find counterparty for market trade with @lookup_cpty, '" + @lookup_cpty + "'",	
			lookup_cpty = @lookup_cpty
		return
	end
end

select
	@trader_id = a.trader_id,
	@trader = a.symbol,
	@user_account_id = a.tico_account_id,
	@sales_code_id = a.sales_code_id
from
	traders a,
	trader_symbols b
where
	a.trader_id = b.trader_id
and
	b.source_id = @source_id
and
	b.symbol = @lookup_trdr

if @trader = NULL
begin
	select
		@trader_id = a.trader_id,
		@trader = a.symbol,
		@user_account_id = a.tico_account_id,
		@sales_code_id = a.sales_code_id
	from
		traders a
	where
		a.symbol = @lookup_trdr
	if @trader = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find trader and user for @lookup_trdr, '" + @lookup_trdr + "'",
			lookup_trdr = @lookup_trdr,
			trader = @trader
		return
	end
end

select
	@user = login
from
	tico_accounts
where
	account_id = @user_account_id
if @user = NULL
begin
	select 
		status = "Error",
		message = "Problem determining login from trader",
		trader = @trader
	return
end



/* Determine ext account based off client or market */
/* chriso: this keeps changing so using fund_agency_counterparies */
/* --
if @client_id = NULL and @executing_firm != NULL 
	select
		@client_or_market = "M"
if @client_id != NULL and @executing_firm = NULL
	select
		@client_or_market = "C"
*/

select
	@client_or_market = "C"
from
	fund_agency_counterparties
where
	counterparty_id = @counterparty_id

if @client_or_market != "C"
	select
		@client_or_market = "M"


if @client_or_market = "M"
begin
	select
		@external_account = a.symbol,
		@external_account_id = a.external_account_id
	from
		external_accounts a,
		counterparties b
	where
		a.external_account_id = b.external_account_id
	and
		b.name = @counterparty
	if @external_account = NULL
	begin
        	select
                    		status = "Error",
                      		message = "Couldn't find market account for @external_account from @counterparty, '" + @counterparty + "'",
                      		trader = @counterparty
              		return
	end
end
else if @client_or_market = "C"
begin
	/*
	select 
		@suppress_trade = "Y"
	from
		fund_agency_traders
	where
		trader_id = @trader_id
	*/
	
	if @suppress_trade = "Y"
	begin
		/*
                /* Requery trader to check if this is an on behalf of (obo) trade */
                select
        		@trader_id = a.trader_id,
        		@trader = a.symbol,
        		@user_account_id = a.tico_account_id,
        		@sales_code_id = a.sales_code_id
		from
        		traders a,
        		trader_symbols b
		where
        		a.trader_id = b.trader_id
		and
        		b.source_id = @source_id
		and
        		b.symbol = @deliver_to_comp_id
		if @@rowcount != 1
		begin
        		select
                		@trader_id = a.trader_id,
                		@trader = a.symbol,
                		@user_account_id = a.tico_account_id,
                		@sales_code_id = a.sales_code_id
        		from
                		traders a
        		where
                		a.symbol = @deliver_to_comp_id
			if @@rowcount != 1
        		begin
                		select
                        		status = "Error",
                        		message = "Couldn't find trader and user for @deliver_to_comp_id, '" + @deliver_to_comp_id + "'",
                        		deliver_to_comp = @deliver_to_comp_id,
                        		trader = @trader
                		return
        		end
		end
		
		select
                	@is_obo_trade = "N"
        	from
                	fund_agency_traders
        	where
                	trader_id = @trader_id
		*/
   
		if @is_obo_trade = "N"
                begin
			select
				message = "Client trade has fund agency trader and is not obo client. Suppressing trade"
			return
		end
		else
		begin
			select
				message = "Determined On Behalf Of Trade",
				done_for = @deliver_to_comp_id,
				done_by = @deliver_to_sub_id,
				trader = @trader
		end
	end

	select
		@external_account = a.symbol,
		@external_account_id = a.external_account_id
	from
		external_accounts a,
		traders b
	where
		a.external_account_id = b.external_account_id
	and
		b.trader_id = @trader_id
	if @external_account = NULL
	begin
	        select
                     	status = "Error",
                       	message = "Couldn't find client account for @external_account from @trader, '" + @trader + "'",
                       	trader = @trader
               	return
	end
end
else
begin
        select
                status = "Error",
                message = "Couldn't detemine client or market",
		client_or_market = @client_or_market,
		client_id = @client_id,
		executing_firm = @executing_firm
        return
end



/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Couldn't find external_account from @external_account_id",
		external_account_id = @external_account_id
	return
end


select
	@trade_type = "Spot"
	
if @last_fwd_points != 0 and @last_fwd_points != NULL
begin
	select
		@trade_type = "Forward"
end

if @side = "SELL"
begin
	select
		@qty1 = -@qty1
end

if @client_or_market = "C"
begin
    select
        @qty1 = -@qty1
end

declare @ccy1_determined char(3)
declare @ccy2_determined char(3)

select
        @ccy1_determined = substring(@symbol, 1, 3),
        @ccy2_determined = substring(@symbol, 4, 6)


/*
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @ccy1 != NULL and @ccy2_determined = @ccy1 
begin
    select
        @symbol = @ccy2_determined + @ccy1_determined,
        @inverted = "Y"
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int
	declare @true_ccy1 char(3)
	declare @true_ccy2 char(3)

	/* re-determine ccy1 & ccy2 because we may have changed the sybol above */ 
	select
        	@true_ccy1 = substring(@symbol, 1, 3),
        	@true_ccy2 = substring(@symbol, 4, 6)


        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @true_ccy1,
                	@true_ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end




select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_exec_symbol


if @deal_id = NULL
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    )
end
else
begin
	select
		msg = "Appending to existing deal"

	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = 'B2B Forward'
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for 'B2B Forward'"
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
end
		
    
exec
	fxa_tallytrade
		@login = @user,
		@source = @source,
		@trade_id = @trade_id out,
		@deal_id = @deal_id out,
		@tally_type = @trade_type,
		@deal_type = @deal_type,
		@trade_type = @trade_type,
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @qty1,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@trader = @trader,
		@broker = @broker,
		@identifier = @trade_identifier,
		@spot_reference = @last_spot_rate

if @trade_id = NULL
begin
	select
		status = "Error",
		message = "Failed to tally trade"
	return
end


/*
insert into
	trade_quoted_prices (	trade_id,
				price)
	values(
		@trade_id,
		@quoted_price
		)
*/

exec
	r_inserttradenotification
				@trade_id


/* 
 * AUTOCOMMIT
 *
 * If there is a client trade in this deal and the account type is set for
 * Autocommit, then push through this deal automatically.
 */
if @deal_id != NULL and @client_or_market = "C" and @aggregation_style = "Autocommit"
begin

    update
        deals
    set
        status_id = @committed_status_id
    where
        deal_id = @deal_id
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    end
end
else
begin
    select
        message = "No autocommitted",
        deal_id = @deal_id,
        trade_id = @trade_id,
        aggregation_style = @aggregation_style
end

select
	status = "Tallied",
	message = "Trade successfully tallied",
    	trade_id = @trade_id,
    	deal_id = @deal_id,
	account = @external_account,
	counterparty = @counterparty,
	symbol = @symbol,
	side = @side,
	quantity = @qty1,
	price = @price,
	val_date = @value_date

/* ### DEFNCOPY: END OF DEFINITION */
