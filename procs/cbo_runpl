create table
	#fut_based_contracts(
		contract_id int,
		multiplier numeric(30,2),
		product_id int,
		currency_id int)
insert into
	#fut_based_contracts
select
	a.contract_id,
	b.quantity,
	c.product_id,
	c.currency_id
from
	future_contracts a,
	futures b,
	forwards c
where
	a.future_id = b.future_id
and
	b.forward_id = c.contract_id
and
	a.expiration >= @start_date

insert into
	#fut_based_contracts
select
	a.contract_id,
	e.quantity,
	f.product_id,
	f.currency_id
from
	option_contracts a,
	option_expirations b,
	options c,
	future_contracts d,
	futures e,
	forwards f
where
	a.option_expiration_id = b.option_expiration_id
and
	b.option_id = c.option_id
and
	c.underlying_contract_id = d.contract_id
and
	d.future_id = e.future_id
and
	e.forward_id = f.contract_id
and
	b.expiration >= @start_date

		
create table
	#positions(
		id int identity,
		contract_id int,
		currency_id int NULL,
		product_id int NULL,
		quantity numeric(30,4),
		last_trade datetime,
		prev_settle float NULL,
		settle_price float NULL,
		native_pl float NULL,
		evaluation_pl float NULL)
insert into
	#positions(
		contract_id,
		quantity,
		last_trade)
select
	a.contract_id,
	sum(quantity),
	max(trade_date)
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#fut_based_contracts g,
	#counterparties h
where
	a.contract_id = g.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = h.counterparty_id
and
	a.value_date >= @start_date
and
	a.trade_date < @start_date
group by
	a.contract_id

delete

from
	#positions
where
	quantity = 0.0

update
	#positions
set
	a.currency_id = b.currency_id,
	a.product_id = b.product_id
from
	#positions a,
	#fut_based_contracts b
where
	a.contract_id = b.contract_id

update
	#positions
set
	a.prev_settle = b.price
from
	#positions a,
	bo_prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @start_date)

update
	#positions
set
	a.settle_price = b.price
from
	#positions a,
	bo_prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @stop_date)

update
	#positions
set
	a.native_pl = (a.settle_price - a.prev_settle) * b.multiplier * a.quantity
from
	#positions a,
	#fut_based_contracts b
where
	a.contract_id = b.contract_id

update
	#positions
set
	evaluation_pl = native_pl
where
	currency_id = @evaluation_currency_id

update
	#positions
set
	a.evaluation_pl = a.native_pl * c.price
from
	#positions a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @stop_date)


update
	#positions
set
	a.evaluation_pl = a.native_pl * (1.0 / c.price)
from
	#positions a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @stop_date)
and
	a.evaluation_pl = NULL


create table
	#fut_trades(
		trade_id int,
		trade_date datetime,
		external_account_id int,
		quantity numeric(30,4),
		contract_id int,
		product_id int NULL,
		currency_id int NULL,
		price float,
		settle_price float NULL,
		native_pl float NULL,
		evaluation_pl float NULL)
insert into
	#fut_trades(
		trade_id,
		trade_date,
		external_account_id,
		quantity,
		contract_id,
		price)
select
	a.trade_id,
	a.trade_date,
	a.external_account_id,
	a.quantity,
	a.contract_id,
	a.price
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#fut_based_contracts g,
	#counterparties h
where
	a.contract_id = g.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = h.counterparty_id
and
	a.trade_date >= @start_date
and
	a.trade_date < @stop_date

/*************** Futures Trades *********************************/
update
	#fut_trades
set
	a.currency_id = b.currency_id,
	a.product_id = b.product_id
from
	#fut_trades a,
	#fut_based_contracts b
where
	a.contract_id = b.contract_id

update
	#fut_trades
set
	a.settle_price = b.price
from
	#fut_trades a,
	bo_prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @stop_date)

update
	#fut_trades
set
	a.native_pl = (a.settle_price - a.price) * b.multiplier * a.quantity
from
	#fut_trades a,
	#fut_based_contracts b
where
	a.contract_id = b.contract_id

update
	#fut_trades
set
	evaluation_pl = native_pl
where
	currency_id = @evaluation_currency_id

update
	#fut_trades
set
	a.evaluation_pl = a.native_pl * c.price
from
	#fut_trades a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @stop_date)
and
	a.evaluation_pl = NULL

update
	#fut_trades
set
	a.evaluation_pl = a.native_pl * (1.0 / c.price)
from
	#fut_trades a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @stop_date)
and
	a.evaluation_pl = NULL


/*************** Futures Trades *********************************/


create table
	#trades(
		trade_id int,
		contract_id int,
		total_premium float NULL,
		premium_currency varchar(30) NULL,
		evaluation_premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized_pl_to_date float NULL,
		end_realized_pl_to_date float NULL,
		begin_unrealized_pl_to_date float NULL,
		end_unrealized_pl_to_date float NULL,
		realized_range_pl float NULL,
		unrealized_range_pl float NULL,
		end_evaluation_value float NULL,
		settle_price float NULL,
		volume float NULL)


/*
 * Find any trades that existed before the range starts
 * @start_date >= bo_trade_date <= @stop_date
 */
if lower(@include_positions) like "%y%"
begin
	insert into
		#trades(
			trade_id,
			contract_id,
			begin_realized_pl_to_date,
			begin_unrealized_pl_to_date,
			volume)
	select
		a.trade_id,
		a.contract_id,
		realized_pl_to_date,
		unrealized_pl_to_date,
		volume = 0.0 /* Don't count the volume of existing positions */
	from
		committed_daily_revals a,
		trades b,
		#external_accounts c,
		#internal_accounts d,
		#traders e,
		#strategies f,
		#brokers g,
		#counterparties h
	where
		a.trade_id = b.trade_id
	and
		b.external_account_id = c.external_account_id
	and
		b.internal_account_id = d.internal_account_id
	and
		b.trader_id = e.trader_id
	and
		b.strategy_id = f.strategy_id
	and
		b.broker_id = g.broker_id
	and
		b.counterparty_id = h.counterparty_id
	and
		a.bo_trade_date < @start_date
	and
		a.value_date >= @start_date
	and
		a.reval_date = @start_date
	and
		a.source_id = @source_id
	and
		a.evaluation_currency_id = @evaluation_currency_id
end


/*
 * Find any trades that were done during the range
 */
insert into
	#trades(
		trade_id,
		contract_id,
		begin_realized_pl_to_date,
		begin_unrealized_pl_to_date,
		end_evaluation_value,
		settle_price,
		volume)
select
	a.trade_id,
	a.contract_id,
	realized_pl_to_date = 0.0,
	unrealized_pl_to_date = 0.0,
	a.evaluation_value,
	a.close_price,
	a.evaluation_notional
from
	committed_daily_revals a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g,
	#counterparties h
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.broker_id = g.broker_id
and
	b.counterparty_id = h.counterparty_id
and
	a.value_date >= @start_date
and
	a.bo_trade_date >= @start_date
and
	a.bo_trade_date < @stop_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id


update
	#trades
set
	a.end_realized_pl_to_date = b.realized_pl_to_date,
	a.end_unrealized_pl_to_date = b.unrealized_pl_to_date,
	a.realized_range_pl = b.realized_pl_to_date - a.begin_realized_pl_to_date,
	a.unrealized_range_pl = b.unrealized_pl_to_date - a.begin_unrealized_pl_to_date,
	a.settle_price = b.close_price,
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id
and
	convert(char(11), b.reval_date, 1) = convert(char(11), b.value_date, 1)
and
	b.reval_date <= @stop_date /* TEST */


update
	#trades
set
	a.end_realized_pl_to_date = b.realized_pl_to_date,
	a.end_unrealized_pl_to_date = b.unrealized_pl_to_date,
	a.realized_range_pl = b.realized_pl_to_date - a.begin_realized_pl_to_date,
	a.unrealized_range_pl = b.unrealized_pl_to_date - a.begin_unrealized_pl_to_date,
	a.settle_price = b.close_price,
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.reval_date = @stop_date
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id


update
	#trades
set
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	datepart(day, b.reval_date) = datepart(day, b.value_date)
and
	datepart(month, b.reval_date) = datepart(month, b.value_date)
and
	datepart(year, b.reval_date) = datepart(year, b.value_date)
and
	b.reval_date <= @stop_date


update
	#trades
set
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	a.end_evaluation_value is NULL
and
	b.reval_date = @stop_date


update
	#trades
set
	a.end_unrealized_pl_to_date = 0,
	a.unrealized_range_pl = 0
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	a.unrealized_range_pl is NULL


update
	#trades
set
	a.total_premium = b.premium,
	a.evaluation_premium = b.evaluation_premium,
	a.premium_currency = c.symbol,
	a.premium_settle_date = b.premium_settle_date
from
	#trades a,
	committed_daily_revals b,
	products c
where
	a.trade_id = b.trade_id
and
	b.premium_ccy_id = c.product_id
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id
and
	b.source_id = @source_id
	


select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

select
	@source = name
from
	sources
where
	source_id = @source_id

if lower(convert(char(1), @display_output)) = "y"
	select
		section = "Run",
		run_name = @run_name,
		begin_date = @start_date,
		end_date = @stop_date,
		run_date = getdate(),
		evaluation_currency = @evaluation_currency,
		evaluation_source_id = @source

create table
	#reval_output(
		id int identity,
		trade_id int NULL,
		trade_date char(11) NULL,
		contract_id int NULL,
		underlying_forward_id int NULL,
		perspective_contract_id int NULL,
		symbol varchar(50),
		quantity numeric(30,4) NULL,
		price float NULL,
		value_date varchar(11) NULL,
		premium float NULL,
		premium_currency varchar(50) NULL,
		evaluation_premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized float NULL,
		end_realized float NULL,
		begin_unrealized float NULL,
		end_unrealized float NULL,
		realized_range float NULL,
		unrealized_range float NULL,
		ending_valuation float NULL,
		settle_price float NULL,
		total_pl float NULL,
		volume float NULL)

create table
	#trade_revals(
		trade_id int,
		trade_date char(11),
		contract_id int,
		underlying_forward_id int NULL,
		perspective_contract_id int NULL,
		symbol varchar(50),
		quantity numeric(30,4),
		price float,
		value_date varchar(11),
		premium float NULL,
		premium_currency varchar(50) NULL,
		evaluation_premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized float NULL,
		end_realized float NULL,
		begin_unrealized float NULL,
		end_unrealized float NULL,
		realized_range float NULL,
		unrealized_range float NULL,
		ending_valuation float NULL,
		settle_price float NULL,
		volume float NULL)
insert into
	#trade_revals
select
	a.trade_id,
	trade_date = convert(char(11), b.trade_date, 1),
	a.contract_id,
	underlying_forward_id = NULL,
	perspective_contract_id = NULL,
	c.symbol,
	b.quantity,
	b.price,
	value_date = convert(char(11), (select max(d.value_date) from committed_daily_revals d where a.trade_id = d.trade_id), 1),
	premium = a.total_premium,
	a.premium_currency,
	a.evaluation_premium,
	a.premium_settle_date,
	begin_realized = a.begin_realized_pl_to_date,
	end_realized = a.end_realized_pl_to_date,
	begin_unrealized = a.begin_unrealized_pl_to_date,
	end_unrealized = a.end_unrealized_pl_to_date,
	realized_range = a.realized_range_pl,
	unrealized_range = a.unrealized_range_pl,
	ending_valuation = a.end_evaluation_value,
	settle_price = a.settle_price,
	volume = a.volume
from
	#trades a,
	trades b,
	contracts c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id


update
	#trade_revals
set
	a.underlying_forward_id = a.contract_id
from
	#trade_revals a,
	forwards b
where
	a.contract_id = b.contract_id


update
	#trade_revals
set
	a.underlying_forward_id = c.forward_id
from
