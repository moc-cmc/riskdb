create table
	#unsettled_premiums(
		contract_id int,
		currency varchar(50) NULL,
		total_premium float NULL,
		evaluation_premium float NULL)
insert into
	#unsettled_premiums
select
	perspective_contract_id,
	premium_currency,
	sum(premium),
	sum(evaluation_premium)
from
	#trade_revals
group by
	perspective_contract_id,
	premium_currency
having
	sum(premium) != NULL

select
	@id = 0
select
	@contracts = count(*)
from
	#contracts
where
	id > @id

while @contracts > 0
begin
	select
		@id = min(id)
	from
		#contracts
	where
		id > @id

	select
		@contract_id = contract_id
	from
		#contracts
	where
		id = @id

	select
		@total_begin_unrealized = NULL,
		@total_end_unrealized = NULL,
		@total_settled_premium = NULL,
		@total_unsettled_premium = NULL,
		@total_premium = NULL,
		@total_realized = NULL,
		@total_fwd_realized = NULL,
		@total_fwd_unrealized = NULL,
		@total_end_fwd_unrealized = NULL,
		@total_fwd_value = NULL,
		@total_opt_value = NULL


	select
		@total_settled_premium = sum(premium)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	and
		premium_settle_date <= @stop_date
	and
		premium_settle_date >= @start_date
	if @total_settled_premium = NULL
		select
			@total_settled_premium = 0.0

	select
		@total_unsettled_premium = sum(premium)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	and
		premium_settle_date >= @stop_date
	if @total_unsettled_premium = NULL
		select
			@total_unsettled_premium = 0.0


	select
		@total_premium = sum(premium)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	if @total_premium = NULL
		select
			@total_premium = 0.0
		

	select
		@total_fwd_unrealized = sum(a.unrealized_range),
		@total_fwd_value = sum(a.ending_valuation),
		@total_end_fwd_unrealized = sum(a.end_unrealized)
	from
		#trade_revals a,
		forwards b
	where
		a.contract_id = b.contract_id
	and
		perspective_contract_id = @contract_id
	if @total_fwd_unrealized = NULL
		select
			@total_fwd_unrealized = 0.0,
			@total_fwd_value = 0.0,
			@total_end_fwd_unrealized = 0.0

	select
		@total_opt_unrealized = sum(a.unrealized_range),
		@total_opt_value = sum(a.ending_valuation)
	from
		#trade_revals a,
		contracts  b,
		instruments c
	where
		a.contract_id = b.contract_id
	and
		b.instrument_id = c.instrument_id
	and
		c.name = "Option"
	and
		a.perspective_contract_id = @contract_id
	if @total_opt_unrealized = NULL
		select
			@total_opt_unrealized = 0.0,
			@total_opt_value = 0.0

	select
		@total_exotic_unrealized = sum(a.unrealized_range),
		@total_exotic_value = sum(a.ending_valuation)
	from
		#trade_revals a,
		contracts b,
		instruments c
	where
		a.contract_id = b.contract_id
	and
		b.instrument_id = c.instrument_id
	and
		c.name = "Exotic"
	and
		a.perspective_contract_id = @contract_id
	if @total_exotic_unrealized = NULL
		select
			@total_exotic_unrealized = 0.0,
			@total_exotic_value = 0.0


	select
		@total_opt_unrealized = @total_opt_unrealized + @total_exotic_unrealized,
		@total_opt_value = @total_opt_value + @total_exotic_value

	select
		@total_realized = sum(realized_range),
		@total_end_unrealized = sum(end_unrealized),
		@total_begin_unrealized = sum(begin_unrealized)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id


	if @total_realized = NULL
		select
			@total_realized = 0.0

	if @total_end_unrealized = NULL
		select
			@total_end_unrealized = 0.0

	if @total_begin_unrealized = NULL
		select
			@total_begin_unrealized = 0.0


	insert into
		#summary(
			contract_id,
			settled_premium,
			realized_pl,
			fwd_unrealized_pl,
			opt_unrealized_pl,
			fwd_ending_value,
			opt_ending_value)
	values(
		@contract_id,
		@total_settled_premium,
		@total_realized,
		@total_fwd_unrealized,
		@total_opt_unrealized,
		@total_end_fwd_unrealized,
		/* @total_fwd_value, TEST */
		@total_opt_value)

	insert into
		#summary
			(contract_id,
			premium_currency,
			unsettled_premium,
			evaluation_premium)
	select
		contract_id,
		currency,
		total_premium,
		evaluation_premium
	from
		#unsettled_premiums
	where
		contract_id = @contract_id

	insert into
		#reval_output(
			trade_id,
			trade_date, 
			contract_id,
			underlying_forward_id,
			perspective_contract_id,
			symbol,
			quantity,
			price,
			value_date,
			premium,
			premium_currency,
			evaluation_premium,
			begin_realized,
			end_realized,
			begin_unrealized,
			end_unrealized,
			realized_range,
			unrealized_range,
			ending_valuation,
			settle_price,
			total_pl,
			volume)
	select
		trade_id,
		trade_date,
		contract_id,
		underlying_forward_id,
		perspective_contract_id,
		symbol,
		quantity,
		price,
		value_date,
		premium,
		premium_currency,
		evaluation_premium,
		begin_realized,
		end_realized,
		begin_unrealized,
		end_unrealized,
		realized_range,
		unrealized_range,
		ending_valuation,
		settle_price,
		realized_range + unrealized_range,
		volume
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id
	order by
		symbol,
		value_date,
		trade_date

	select
		@total_pl = sum(realized_range + unrealized_range),
		@total_fwd_volume = sum(volume)
	from
		#trade_revals
	where
		perspective_contract_id = @contract_id

	select
		@symbol = symbol
	from
		contracts
	where
		contract_id = @contract_id

	select
		@symbol = "<b>" + rtrim(@symbol) + " Total</b>"

	insert into
		#reval_output(
			symbol,
			premium,
			realized_range,
			begin_unrealized,
			end_unrealized,
			unrealized_range,
			ending_valuation,
			total_pl,
			volume)
	values(
		@symbol,
		@total_premium,
		@total_realized,
		@total_begin_unrealized,
		@total_end_unrealized,
		/* @total_end_fwd_unrealized, */
		@total_fwd_unrealized + @total_opt_unrealized,
		@total_fwd_value + @total_opt_value,
		@total_pl,
		@total_fwd_volume)
		

	select
		@contracts = count(*)
	from
		#contracts
	where
		id > @id
end
	
