drop procedure
	cbo_editacctbiproductrate
go

create procedure
	cbo_editacctbiproductrate
		@login varchar(50),
		@account varchar(50),
		@contract varchar(50),
		@closing_date datetime,
		@closing_rate float=NULL,
		@roll_date datetime=NULL,
		@roll_rate float=NULL,
		@fund_name varchar(50)=NULL
as

declare @external_account_id int
declare @contract_id int



select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @contract
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "contract not found",
		currency = @contract
	return
end

select
	@closing_date = convert(datetime, convert(date, @closing_date))

/* update all of the other account for that product that do not have a rate set */

update
        ext_account_biproduct_rates
set
        closing_rate = @closing_rate,
        roll_date = @roll_date,
        roll_rate = @roll_rate
where
        contract_id = @contract_id
and
        convert(date, closing_date) = convert(date, @closing_date)
and
	roll_rate = NULL

update
	ext_account_biproduct_rates
set
	closing_rate = @closing_rate,
	roll_date = @roll_date,
	roll_rate = @roll_rate
where
	external_account_id = @external_account_id
and
	contract_id = @contract_id
and
	convert(date, closing_date) = convert(date, @closing_date)
if @@rowcount = 0
begin
	insert into
		ext_account_biproduct_rates
	values(
		@external_account_id,
		@contract_id,
		@closing_date,
		@closing_rate,
		@roll_date,
		@roll_rate)
end

if @fund_name != NULL
begin
	exec
		cbo_positionsandrolls
			@login,
			@closing_date,
			@fund_name
end




go
