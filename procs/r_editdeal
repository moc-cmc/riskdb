
if object_id("r_editdeal") != NULL
    drop procedure
        r_editdeal
go

create procedure
	r_editdeal
		@login char(30),
		@deal_id int,
		@trade_date datetime,
		@symbol char(50),
		@value_date datetime=NULL,
		@trade_quantity numeric(30,0),
		@trade_price float,
		@trader char(100),
		@broker char(100),
		@strategy char(100)
as

declare @instrument varchar(50)
declare @underlying_contract_id int
declare @contract_id int

select
	@instrument = a.name,
	@contract_id = b.contract_id
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.symbol = @symbol

if @instrument = "Option"
begin
	select
		@underlying_contract_id = a.underlying_contract_id
	from
		options a,
		option_expirations b,
		option_contracts c
	where
		a.option_id = b.option_id
	and
		b.option_expiration_id = c.option_expiration_id
	and
		c.contract_id = @contract_id

	select
		@instrument = a.name
	from
		instruments a,
		contracts b
	where
		a.instrument_id = b.instrument_id
	and
		b.contract_id = @underlying_contract_id
end


if @instrument = "Forward"
begin
	exec
		r_editspotdeal
			@login,
			@deal_id,
			@trade_date,
			@symbol,
			@value_date,
			@trade_quantity,
			@trade_price,
			@trader,
			@broker,
			@strategy

	return
end

if @instrument = "Future"
begin
	exec
		r_editfuturedeal
			@login,
			@deal_id,
			@trade_date,
			@symbol,
			@value_date,
			@trade_quantity,
			@trade_price,
			@trader,
			@broker,
			@strategy

	return
end


go
