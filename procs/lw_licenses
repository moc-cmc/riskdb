use
	risk_firsel
go

drop procedure
	lw_licenses
go

create procedure
	lw_licenses
		@login varchar(50),
		@jurisdiction varchar(50)=NULL
as

declare @search_string varchar(200)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Column Format",
	"license_number",
	"Number",
	"###0")

insert into
	#meta
values(
	"Column Link",
	"jurisdiction",
	"Inspect License",
	NULL)

insert into
	#meta
values(
	"Column Style",
	"exemption_type",
	NULL,
	"text-align:right")

insert into
	#meta
values(
	"Column Style",
	"cert_renew",
	NULL,
	"text-align:right")

insert into
	#meta
values(
	"Column Style",
	"cert_auth_exp",
	NULL,
	"text-align:right")

insert into
	#meta
values(
	"Column Style",
	"cert_auth",
	NULL,
	"text-align:right")

insert into
	#meta
values(
	"Column Style",
	"lic_renew",
	NULL,
	"text-align:right")

insert into
	#meta
values(
	"Column Style",
	"license_number",
	NULL,
	"text-align:right")

select * from #meta

select
	@search_string = "%" + lower(rtrim(@jurisdiction)) + "%"

select
	jurisdiction = b.name,
	a.collecting,
	/* entity = c.name, */
	status = d.name,
	as_of_date = convert(char(11), a.as_of_date, 1),
	expiration_date = case
		when
			a.expiration_date != NULL
		then
			convert(char(11), a.expiration_date, 1)
		else
			"N/A"
		end,
	licensing_authority = e.name,
	a.license_number,
	lic_renew = case
		when
			a.license_renewal_fee != NULL
		then
			convert(varchar(50), a.license_renewal_fee)
		else
			"N/A"
		end,
	cert_auth = case
		when
			a.cert_auth_date != NULL
		then
			convert(char(11), a.cert_auth_date, 1)
		else
			"N/A"
		end	,
	cert_auth_exp = case
		when
			a.cert_auth_exp != NULL
		then
			convert(char(11), a.cert_auth_exp, 1)
		else
			"N/A"
		end,
	cert_renew = case
		when
			a.cert_auth_renew_fee != NULL
		then
			convert(varchar(30), a.cert_auth_renew_fee)
		else
			"N/A"
		end,
	exemption_type = f.name,
	legal_basis = g.name,
	bond_amt = case
		when
			a.bond_amt != NULL
		then	
			convert(varchar(30), a.bond_amt)
		else
			"N/A"
		end,
	bond_exp = case
		when
			bond_exp != NULL
		then
			convert(char(11), a.bond_exp, 1)
		else
			"N/A"
		end
	/* date_started = convert(char(11), a.date_started, 1),
	est_completion = convert(char(11), a.est_completion, 1), 
	a.notes */
from
	licenses a,
	jurisdictions b,
	/* entities c, */
	statuses d,
	licensing_authorities e,
	exemption_types f,
	legal_bases g
where
	a.jurisdiction_id = b.jurisdiction_id
/* and
	a.entity_id = c.entity_id */
and
	a.status_id = d.status_id
and
	a.licensing_authority_id = e.licensing_authority_id
and
	a.exemption_type_id = f.exemption_type_id
and
	a.legal_basis_id = g.legal_basis_id
and
	lower(b.name) like @search_string
order by
	b.name


go
