drop procedure fxa_importmarketrolls
go

create procedure
	fxa_importmarketrolls
		@login varchar(50),
		@trade_date datetime,
		@buy_sell varchar(50),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@near_date datetime,
		@near_price float,
		@far_date datetime,
		@far_price float,
		@row_index int,
		@row_count int

as

declare @identifier varchar(100)
declare @broker_id int
declare @trades int

select 
	@broker_id = broker_id
from
	brokers
where
	symbol = "MPT Tally"
if @broker_id = NULL
	return

select
	@identifier = "RollImport-"+rtrim(convert(varchar(8), @trade_date, 112))+"-"+rtrim(@dealt_currency)+rtrim(@counter_currency)+"-"+rtrim(@counterparty)

select
	@trades = count(*)
from
	trades
where
	broker_id = @broker_id
and
	identifier like rtrim(@identifier)+"%"
if @trades > 0
begin
	select
		msg = "Dupe",
		identifier = @identifier,
		trade_count = @trades
	return
end

exec
        fxa_tallymarketroll
                @login=@login,
                @trade_date=@trade_date,
                @buy_sell=@buy_sell,
                @counterparty=@counterparty,
                @quantity=@quantity,
                @dealt_currency=@dealt_currency,
                @counter_currency=@counter_currency,
                @near_date=@near_date,
                @near_price=@near_price,
                @far_date=@far_date,
                @far_price=@far_price,
		@inspect_deal=NULL,
		@identifier=@identifier


if @row_index = @row_count - 1
begin
	exec
		cbo_clientrollrecon
			@login,
			@trade_date
end

go

