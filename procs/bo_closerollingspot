drop procedure
	bo_closerollingspot
go

create procedure
	bo_closerollingspot
		@login varchar(50),
		@trade_date datetime
as

declare @trade_type_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @ids int
declare @position numeric(30,4)
declare @closing_quantity numeric(30,4)
declare @roll_position numeric(30,4)
declare @closing_val_date datetime
declare @roll_val_date datetime
declare @value_date datetime

declare @tally_login varchar(50)

declare @contract_id int
declare @external_account_id int
declare @external_account varchar(50)
declare @source varchar(50)
declare @tally_type varchar(15)
declare @deal_type varchar(20)
declare @trade_type varchar(20)

declare @near_trade_id int
declare @far_trade_id int
declare @near_val_date datetime
declare @far_val_date datetime
declare @deal_id int
declare @near_quantity numeric(30,4)
declare @far_quantity numeric(30,4)
declare @symbol varchar(50)
declare @price numeric(30,8)
declare @trader varchar(50)
declare @near_identifier varchar(50)
declare @far_identifier varchar(50)





exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


select
	@near_val_date = convert(datetime, convert(date, @end_date))

exec
	r_nextbusinessday
		@near_val_date,
		@far_val_date output

select
	@source = "MPT",
	@tally_type = "Swap",
	@deal_type = "Rolling Spot",
	@trade_type = "Rolling Spot",
	@trader = "ROLL"

	

select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = "Rolling Spot"


select
	@tally_login = a.login
from
	tico_accounts a,
	traders b
where
	a.account_id = b.tico_account_id
and
	b.symbol = @trader
if @tally_login = NULL
begin
	select
		status = "Error",
		message = "ROLL trader not found"
	return
end

create table
	#positions(
		id int identity,
		external_account_id int,
		contract_id int,
		position numeric(30,4))
insert into
	#positions(
		external_account_id,
		contract_id,
		position)
select
	external_account_id,
	contract_id,
	sum(quantity)
from
	trades
where
	trade_type_id = @trade_type_id
and
	trade_date < @end_date
and
	convert(date, value_date) = convert(date, @end_date)
group by
	external_account_id,
	contract_id

delete

from
	#positions
where
	position = 0.0

create table
	#contracts(
		contract_id int,
		settle_price float NULL)
insert into
	#contracts(
		contract_id)
select
	distinct(contract_id)
from
	#positions

update
	#contracts
set
	a.settle_price = b.price
from
	#contracts a,
	prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @end_date)


select
	@id = 0
select
	@ids = count(*)
from
	#positions
where
	id > @id


while @ids > 0
begin
	select
		@id = min(id)
	from
		#positions
	where
		id > @id

	select
		@near_quantity = NULL,
		@far_quantity = NULL,
		@symbol = NULL,
		@contract_id = NULL,
		@external_account_id = NULL,
		@price = NULL,
		@deal_id = NULL,
		@near_trade_id = NULL,
		@far_trade_id = NULL

	select
		@near_quantity = position * -1.0,
		@far_quantity = position,
		@contract_id = contract_id,
		@external_account_id = external_account_id
	from
		#positions
	where
		id = @id

	select
		@price = settle_price
	from
		#contracts
	where
		contract_id = @contract_id

	select
		@symbol = symbol
	from
		contracts
	where
		contract_id = @contract_id

	select
		@external_account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	exec
		tt_newdeal
			@deal_type = "Rolling Spot",
			@deal_id = @deal_id output

	select
		@near_identifier = convert(varchar(10), @deal_id) + " Rolling Spot Near",
		@far_identifier = convert(varchar(10), @deal_id) + " Rolling Spot Far"
	exec
		fxa_tallytrade
			@login = @tally_login,
			@source = @source,
			@trade_id = @near_trade_id output,
			@deal_id = @deal_id output,
			@tally_type = @tally_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@quantity = @near_quantity,
			@symbol = @symbol,
			@value_date = @near_val_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @trader,
			@identifier = @near_identifier 

	exec
		fxa_tallytrade
			@login = @tally_login,
			@source = @source,
			@trade_id = @far_trade_id output,
			@deal_id = @deal_id output,
			@tally_type = @tally_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@quantity = @far_quantity,
			@symbol = @symbol,
			@value_date = @far_val_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @trader,
			@identifier = @far_identifier 
			

	/*	
	select
		login = @tally_login,
		source = @source,
		near_trade_id = @near_trade_id,
		far_trade_id = @far_trade_id,
		deal_id = @deal_id,
		tally_type = @tally_type,
		deal_type = @deal_type,
		trade_type = @trade_type,
		near_quantity = @near_quantity,
		far_quantity = @far_quantity,
		symbol = @symbol,
		external_account = @external_account,
		price = @price
	*/

	select
		@ids = count(*)
	from
		#positions
	where
		id > @id
end



exec
	cbo_copyfopricestobo
		@login = @login,
		@trade_date = @trade_date


go
