
drop procedure
	api_scheduledledgerfees
go

create procedure
	api_scheduledledgerfees
		@login varchar(50),
		@batch_id int,
		@ledger_fee_schedule varchar(50),
		@trade_date datetime,
		@tally_fees varchar(10)=NULL

as


declare @ledger_fee_schedule_id int
declare @begin_date datetime
declare @end_date datetime
declare @tico_account_id int
declare @external_account_id int
declare @transaction_type_id int
declare @fee_transaction_type_id int
declare @currency_id int
declare @fee_product_id int
declare @fee_price float
declare @fee numeric(30, 8)
declare @balance float
declare @min_size float
declare @fee_schedule_type_id int
declare @fee_product float
declare @book_to_account_id int
declare @credit_to_account_id int
declare @fee_schedule_type varchar(100)
declare @product_id int
declare @products int


declare @queued_transaction_id int
declare @entered_by int
declare @book_date datetime


select
	@entered_by = account_id
from
	tico_accounts
where
	login = @login
if @entered_by = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

select
	@book_date = convert(date, @end_date)


select
	@ledger_fee_schedule_id = ledger_fee_schedule_id,
	@fee_transaction_type_id = fee_transaction_type_id,
	@tico_account_id = entered_by,
	@external_account_id = external_account_id,
	@transaction_type_id = transaction_type_id,
	@currency_id = currency_id,
	@fee_schedule_type_id = fee_schedule_type_id,
	@fee_product_id = fee_product_id,
	@fee_price = fee_price,
	@min_size = min_size,
	@book_to_account_id = book_to_account_id,
	@credit_to_account_id = credit_to_account_id
from
	ledger_fee_schedules
where
	name = @ledger_fee_schedule

select
	@fee_schedule_type = name
from
	fee_schedule_types
where
	fee_schedule_type_id = @fee_schedule_type_id

create table
	#tico_accounts(
		tico_account_id int)
if @tico_account_id = NULL
begin
	insert into
		#tico_accounts(
			tico_account_id)
	select
		account_id
	from
		tico_accounts
end
else
begin
	insert into
		#tico_accounts(
			tico_account_id)
	values(
		@tico_account_id)
end

create table
	#external_accounts(
		external_account_id int)
if @external_account_id = NULL
begin
	insert into
		#external_accounts(
			external_account_id)
	select
		external_account_id
	from
		external_accounts
end
else
begin
	insert into
		#external_accounts(
			external_account_id)
	values(
		@external_account_id)
end


create table
	#transaction_types(
		transaction_type_id int)
if @transaction_type_id = NULL
begin
	insert into
		#transaction_types(
			transaction_type_id)
	select
		transaction_type_id
	from
		transaction_types
end
else
begin
	insert into
		#transaction_types(
			transaction_type_id)
	values(
		@transaction_type_id)
end


create table
	#currencies(
		product_id int)
if @currency_id = NULL
begin
	insert into
		#currencies(
			product_id)
	select
		product_id
	from
		products
end
else
begin
	insert into
		#currencies(
			product_id)
	values(
		@currency_id)
end


if @fee_schedule_type = "Balance Custody"
begin
	create table
		#product_balances(
			product_id int,
			amount float NULL)
	insert into
		#product_balances(
			product_id,
			amount)
	select
		a.currency_id,
		sum(a.amount)
	from
        	account_transactions a,
        	#tico_accounts b,
        	#external_accounts c,
        	#transaction_types d,
        	#currencies e
	where
        	a.entered_by = b.tico_account_id
	and
        	a.external_account_id = c.external_account_id
	and
        	a.transaction_type_id = d.transaction_type_id
	and
        	a.currency_id = e.product_id
	and
		a.transaction_date <= @end_date
	group by
		a.currency_id

	select
		@product_id = 0
	select
		@products = count(*)
	from
		#product_balances
	where
		product_id > @product_id

	while @products > 0
	begin
		select
			@product_id = min(product_id)
		from
			#product_balances
		where
			product_id > @product_id


		select
			@queued_transaction_id = NULL,
			@balance  = NULL,
			@fee = NULL

		select
			@balance = amount
		from
			#product_balances
		where
			product_id = @product_id

		select
			@fee = convert(numeric(30, 8), @balance * (@fee_price / 365.0))
		

		exec
			j_nextkey
				"queued_transactions",
				@queued_transaction_id output

		insert into
			queued_transactions(
				queued_transaction_id,
				tico_account_id,
				batch_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@queued_transaction_id,
			@entered_by,
			@batch_id,
			@entered_by,
			@book_to_account_id,
			@fee_transaction_type_id,
			@book_date,
			@fee_product_id,
			@fee * -1.0)


		select
			@queued_transaction_id = NULL
		exec
			j_nextkey
				"queued_transactions",
				@queued_transaction_id output

		insert into
			queued_transactions(
				queued_transaction_id,
				tico_account_id,
				batch_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@queued_transaction_id,
			@entered_by,
			@batch_id,
			@entered_by,
			@credit_to_account_id,
			@fee_transaction_type_id,
			@book_date,
			@fee_product_id,
			@fee)


		select
			@products = count(*)
		from
			#product_balances
		where
			product_id > @product_id
	end

end
if @fee_schedule_type = "Ticket Count"
begin
	select msg = "not done yet"
end






go
