drop procedure
	c_editcliencontact
go

create procedure
	c_editcliencontact
		@login varchar(50),
		@account varchar(50),
		@name varchar(200)=NULL,
		@phone varchar(200)=NULL,
		@email varchar(200)=NULL,
		@address_line1 varchar(200)=NULL,
		@address_line2 varchar(200)=NULL,
		@additional1 varchar(200)=NULL,
		@additional2 varchar(200)=NULL,
		@additional3 varchar(200)=NULL
as


declare @total int
declare @fund_id int
declare @external_account_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@external_account_id = a.external_account_id
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.symbol = @account

if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

select
	@total = count(*)
from
	client_contacts
where
	external_account_id = @external_account_id
if @total = NULL or @total = 0
begin
	insert into
		client_contacts(
			external_account_id)
	values(
		@external_account_id)
end
	
update
	client_contacts
set
	name = 	@name,
	phone =	@phone,
	email =	@email,
	address_line1 =	@address_line1,
	address_line2 =	@address_line2,
	additional1 = @additional1,
	additional2 = @additional2,
	additional3 = @additional3
where
	external_account_id = @external_account_id

exec
	c_clientcontacts
		@login


go
