
if object_id("f_extaccounttransactions") != NULL
    drop procedure
        f_extaccounttransactions
go

create procedure
	f_extaccounttransactions
		@external_account char(100),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as


declare @init_balance numeric(30,2)
declare @external_account_id int
declare @activity numeric(30,2)
declare @datestring char(25)

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Format Number",
	"amount",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Column Link",
	"ytd",
	"YTD Account Transactions",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"trade_id",
	"Deal Inspector For Trade",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"mtd",
	"MTD Account Transactions",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"edit",
	"Edit Account Transaction",
	"suppressAutoexecute=YES",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding external account",
		external_account = @external_account
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()


select
	@begin_date = convert(datetime, convert(char(11), @begin_date, 1))

if @end_date = NULL
begin
	select
		@end_date = max(transaction_date)
	from
		account_transactions
	where
		external_account_id = @external_account_id

	if @end_date = NULL
		select
			@end_date = dateadd(day, 1, @begin_date)

end

select
	@datestring = convert(char(11), @end_date, 1) + " 23:59:59"
select
	@end_date = convert(datetime, @datestring)


select
	@init_balance = convert(numeric(30,2), sum(amount))
from
	account_transactions
where
	external_account_id = @external_account_id
and
	transaction_date < @begin_date
if @init_balance = NULL
	select
		@init_balance = 0.0


select
	@activity = sum(convert(numeric(30,2), amount))
from
	account_transactions
where
	external_account_id = @external_account_id
and
	transaction_date >= @begin_date
and
	transaction_date < @end_date
if @activity = NULL
	select
		@activity = 0.0


create table
	#summary(
		external_account char(50),
		begin_date datetime,
		end_date datetime,
		mtd char(10),
		ytd char(10),
		init_balance numeric(30,2),
		activity numeric(30,2),
		end_balance numeric(30,2))
insert into
	#summary
values(
	@external_account,
	@begin_date,
	@end_date,
	"MTD", 
	"YTD", 
	@init_balance,	
	@activity,
	@init_balance + @activity)


create table
	#account_transactions(
		transaction_id int,
		entered_by char(30),
		account char(50),
		transaction_type char(50),
		trade_date char(11) NULL,
		settle_date char(11),
		amount char(30),
		trade_id int NULL,
		edit char(20))
insert into
	#account_transactions
select
	transaction_id = a.account_transaction_id,
	entered_by = b.login,
	account = c.symbol,
	transaction_type = d.name,
	trade_date = NULL,
	settle_date = convert(char(11), a.transaction_date, 1),
	amount = convert(char(30), convert(numeric(30,2), a.amount)),
	trade_id = e.trade_id,
	edit = "EDIT TRANS"
from
	account_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d,
	account_transaction_trades e
where
	a.external_account_id = @external_account_id
and
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	a.account_transaction_id *= e.account_transaction_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date < @end_date
order by
	a.transaction_date

update
	#account_transactions
set
	trade_date = convert(char(11), b.trade_date, 1)
from
	#account_transactions a,
	trades b
where
	a.trade_id = b.trade_id


--Adaptive Server has expanded all '*' elements in the following statement
select #account_transactions.transaction_id, #account_transactions.entered_by, #account_transactions.account, #account_transactions.transaction_type, #account_transactions.trade_date, #account_transactions.settle_date, #account_transactions.amount, #account_transactions.trade_id, #account_transactions.edit from #account_transactions order by convert(datetime, settle_date)


--Adaptive Server has expanded all '*' elements in the following statement
select #summary.external_account, #summary.begin_date, #summary.end_date, #summary.mtd, #summary.ytd, #summary.init_balance, #summary.activity, #summary.end_balance from #summary

create table
	#output(
		category char(100),
		amount float)

insert into
	#output
values(
	"Begin Balance",
	@init_balance)

insert into
	#output
select
	transaction_type = d.name,
	amount = sum(convert(numeric(30,2), a.amount))
from
	account_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d
where
	a.external_account_id = @external_account_id
and
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date < @end_date
group by
	d.name

insert into
	#output
values(
	"Ending Balance",
	@init_balance + @activity)

select
	category,
	amount = convert(char(30), convert(numeric(30,2), amount))
from
	#output


go
