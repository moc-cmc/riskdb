
if object_id("ss_tallyclienttrade") != NULL
    drop procedure
        ss_tallyclienttrade
go

create procedure
	ss_tallyclienttrade
		@login varchar(50),
		@tally_type varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@quantity numeric(30,4),
		@price float,
		@value_date datetime,
		@trade_date datetime, 
		@fixing_date datetime = NULL
as

declare @external_account varchar(50)
declare @symbol varchar(50)
declare @trade_type varchar(25)
declare @contract_id int
declare @trade_id int
declare @deal_id int

if @client_buys_sells = "Client Buys"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@quantity = abs(@quantity)
end

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)

select
    @contract_id = contract_id
from
    contracts
where
    symbol = @symbol
if @@rowcount != 1
begin

	declare @evaluation_currency varchar(50)
	declare @fund_id int

	exec
        r_defaultfundforlogin
                @login,
                @fund_id output

	select
        @evaluation_currency = a.symbol
	from
        products a,
        funds b
	where
        a.product_id = b.evaluation_currency_id
  
	exec r_addbatchfwdsubscription
			@login,
			@symbol,
			@dealt_currency,
			@counter_currency,
			@evaluation_currency 

	if not exists (select contract_id from contracts where symbol=@symbol)
	begin
		select
			status = "Error",
			message = "Contract not found",
			symbol=@symbol

		return
	end

end


select
	@external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

select
	@trade_type = @tally_type


exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Client Forward",
		@trade_type = @trade_type,	
		@external_account = @external_account,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@fixing_date = @fixing_date

go
