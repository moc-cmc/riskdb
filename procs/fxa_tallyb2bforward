
if object_id("fxa_tallyb2bforward") != NULL
    drop procedure
        fxa_tallyb2bforward
go

create procedure
	fxa_tallyb2bforward
		@login varchar(50),
		@tally_type varchar(25),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@client_price float,
		@client_val_date datetime,
		@market_price float,
		@market_val_date datetime

as

declare @deal_id int

exec api_tallyb2bforward
			@login,
			@tally_type,
			@client_user,
			@client_buys_sells,
			@counterparty,
			@quantity,
			@dealt_currency,
			@counter_currency,
			@client_price,
			@client_val_date,
			@market_price,
			@market_val_date,
			@deal_id output,
			NULL,
			NULL

exec
	r_inspectdealtrades
		@login,
		@deal_id




go
