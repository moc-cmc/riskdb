
if object_id("x_contractmultiplier") != NULL
    drop procedure
        x_contractmultiplier
go
 
create procedure
	x_contractmultiplier
		@contract_id int,
		@multiplier float output
as

select
	@multiplier = quantity
from
	forwards
where
	contract_id = @contract_id
if @multiplier != NULL
	return

select
	@multiplier = a.quantity * b.quantity
from
	forwards a,
	futures b,
	future_contracts c
where
	a.contract_id = b.forward_id
and
	b.future_id = c.future_id
and
	c.contract_id = @contract_id
if @multiplier != NULL
	return


select
	@multiplier = a.quantity * b.quantity * d.quantity
from
	forwards a,
	futures b,
	future_contracts c,
	options d,
	option_expirations e,
	option_contracts f
where
	a.contract_id = b.forward_id
and
	b.future_id = c.future_id
and
	c.contract_id = d.underlying_contract_id
and
	d.option_id = e.option_id
and
	e.option_expiration_id = f.option_expiration_id
and
	f.contract_id = @contract_id
if @multiplier != NULL
	return


select
	@multiplier = a.quantity * b.quantity
from
	forwards a,
	options b,
	option_expirations c,
	option_contracts d
where
	a.contract_id = b.underlying_contract_id
and
	b.option_id = c.option_id
and
	c.option_expiration_id = d.option_expiration_id
and
	d.contract_id = @contract_id
if @multiplier != NULL
	return


select
	@multiplier = a.quantity * b.quantity
from
	forwards a,
	options b,
	option_expirations c,
	exotic_contracts d
where
	a.contract_id = b.underlying_contract_id
and
	b.option_id = c.option_id
and
	c.option_expiration_id = d.option_expiration_id
and
	d.contract_id = @contract_id
if @multiplier != NULL
	return

select
	@multiplier = 1.0
go
