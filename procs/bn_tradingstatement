create or replace procedure
        bn_tradingstatement
                @login char(100)
as

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


create table
   #meta(
           meta_type char(200),
           name char(50) NULL,
           action char(100) NULL,
           value char(200) NULL)
insert into
   #meta
values(
   "Row Style",
   "style",
   NULL,
   NULL)

insert into
   #meta
values (
   "Column Group",
   "section",
   NULL,
   NULL)


insert into
	#meta
values(
	"Column Link",
	"daily_statement",
	"Trading Account Daily Statement",
	NULL
)

insert into
	#meta
values(
	"Column Link",
	"monthly_statement",
	"Trading Account Monthly Statement",
	NULL
)

insert into
        #meta
values(
        "Column Link",
        "daily_bank_statement",
        "Bank Account Daily Statement",
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "monthly_bank_statement",
        "Bank Account Monthly Statement",
        NULL
)


select * from #meta

create table
	#output(
		id int identity,
		section varchar(100),
		account_name varchar(100),
		account varchar(50),
	        daily_bank_statement varchar(30) NULL,
        	monthly_bank_statement varchar(30) NULL,
	        daily_statement varchar(30) NULL,
        	monthly_statement varchar(30) NULL,
        	style varchar(200),
		ordering int NULL
)

		
insert into
	#output(
		section,
		account_name,
		account,
		daily_bank_statement,
		monthly_bank_statement,
		style,
		ordering)
select
	section = "Bank Account Statements",
        account_name = f.name,
        account = f.symbol,
	daily_bank_statement = "Daily Statement",
        monthly_bank_statement = "Monthly Statement",
	style = @style,
	ordering = 1
from
	legal_entities a,
	legal_entity_tico_accounts b,
	tico_accounts c,
	bo_master_accounts d,
	external_accounts f	
where
	a.legal_entity_id = b.legal_entity_id
and
	b.tico_account_id = c.account_id
and
	a.legal_entity_id = d.legal_entity_id
and
	d.external_account_id = f.external_account_id
and
	c.login = @login
if @@rowcount = 0
begin
	select
		section = "No Access",
		status = "Error",
		message = "This login has no access to view any legal entities for bo accounts"
	return
end


insert into
        #output(
                section,
                account_name,
                account,
                daily_statement,
                monthly_statement,
                style,
                ordering)
select
        section = "Trading Account Statements",
        account_name = f.name,
        account = f.symbol,
        daily_statement = "Daily Statement",
        monthly_statement = "Monthly Statement",
        style = @style,
        ordering = 2
from
        legal_entities a,
        legal_entity_tico_accounts b,
        tico_accounts c,
        bo_master_accounts d,
        fo_sub_accounts e,
        external_accounts f
where
        a.legal_entity_id = b.legal_entity_id
and
        b.tico_account_id = c.account_id
and
        a.legal_entity_id = d.legal_entity_id
and
        d.bo_master_account_id = e.bo_master_account_id
and
        e.external_account_id = f.external_account_id
and
        c.login = @login
if @@rowcount = 0
begin
        select
                section = "No Access",
                status = "Error",
                message = "This login has no access to view any legal entities"
        return
end


select 
	section,
	account_name,
	account,
	daily_bank_statement,
	monthly_bank_statement,
	style
from
	#output
where
	section = "Bank Account Statements"
order by
	ordering,
	account_name

select
        section,
        account_name,
        account,
        daily_statement,
        monthly_statement,
        style
from
        #output
where
	section = "Trading Account Statements"
order by
        ordering,
        account_name


		
go
