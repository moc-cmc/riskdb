use
	risk_rcm
go

drop procedure
	cta_portfolioblotter
go

create procedure
	cta_portfolioblotter
		@login char(100),
		@trade_date datetime=NULL,
		@portfolio varchar(50)
as

declare @tico_account_id int
declare @cta_portfolio_id int

if @trade_date = NULL
	select
		@trade_date = max(trade_date)
	from
		trades

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Unable to determine current user"
	return
end


create table
	#external_accounts(
		symbol varchar(50))

insert into
	#external_accounts
select
	a.symbol 
from
	external_accounts a,
	cta_portfolio_ext_accts b,
	cta_portfolios c
where
	a.external_account_id = b.external_account_id
and
	b.portfolio_id = c.portfolio_id
and
	c.name = @portfolio
and
	user_id = @tico_account_id


create table
	#output(
		trade_id int,
		trade_date datetime,
		account varchar(50),
		long_name varchar(100),
		quantity int,
		contract varchar(50),
		price numeric(30,4),
		trace_number varchar(50) NULL,
		external_account_id int,
		internal_account varchar(50) NULL,
		ib_broker varchar(50) NULL)

insert into
	#output
select
	a.trade_id,
	a.trade_date,
	account = b.symbol,
	long_name = b.name,
	a.quantity,
	contract = d.symbol,
	convert(numeric(30,4), a.price),
	trace_number = a.identifier,
	a.external_account_id,
	internal_account = NULL,
	ib_broker = NULL
from
	trades a,
	external_accounts b,
	internal_account_users c,
	contracts d,
	#external_accounts f
where
	a.external_account_id = b.external_account_id
and
	b.internal_account_id = c.internal_account_id
and
	a.contract_id = d.contract_id
and
	c.account_id = @tico_account_id
and
	datepart(day, a.trade_date) = datepart(day, @trade_date)
and
	datepart(month, a.trade_date) = datepart(month, @trade_date)
and
	datepart(year, a.trade_date) = datepart(year, @trade_date)
and
	b.symbol = f.symbol


update
	#output
set
	a.internal_account = b.symbol
from
	#output a,
	internal_accounts b,
	external_accounts c
where
	a.external_account_id = c.external_account_id
and
	c.internal_account_id = b.internal_account_id

update
	#output
set
	a.ib_broker = b.symbol
from
	#output a,
	ib_brokers b,
	external_accounts c
where
	a.external_account_id = c.external_account_id
and
	c.ib_broker_id = b.ib_broker_id

