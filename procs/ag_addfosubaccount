create or replace procedure
	ag_addfosubaccount
		@login varchar(50),
		@legal_entity varchar(150),       /* used in form, uneditable */
		@bo_master_account varchar(50),  /* used in form, uneditable */
		@master_account_name varchar(50),/* used in form, uneditable */
		@symbol varchar(50),
		@name varchar(150)=NULL,
		@prime_broker varchar(50)



as

declare @external_account_id int
declare @bo_master_account_id int
declare @fo_sub_account_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @symbol
if @external_account_id != NULL
begin
	select
		status = "Error",
		message = "Account already exists with symbol",
		symbol = @symbol
	return
end
	

select
	@external_account_id = external_account_id
from
	external_accounts
where
	name = @name
if @external_account_id != NULL
begin
	select
		status = "Error",
		message = "Account already exists with name",
		name = @name
	return
end
	

exec
	api_addfosubaccount
		@login = @login,
		@symbol = @symbol,
		@name = @name,
		@bo_master_account = @bo_master_account,
		@prime_broker = @prime_broker



exec
        ag_legalentitieshome
                @login=@login,
		@legal_entity=@legal_entity

go
			
		



		
		
