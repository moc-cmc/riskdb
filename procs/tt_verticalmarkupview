if @query_options = "O"  /* O for ONLY, ONLY query options, remove all other trades */
begin
	delete from
		#trades
	where
		trade_type not in("Option")
end
else if @query_options = "N"
begin
        delete from
                #trades
        where
                trade_type in("Option")
end

