select
	@boa_pb_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = "Bank of America"
	

select
	@markup = a.name
from
	account_spread_overrides a,
	#trades b
where
	a.contract_id = b.contract_id
and
	a.external_account_id = b.external_account_id
and
	b.trade_id = @trade_id

if @markup = NULL
begin
	select
		@markup = a.name
	from
		default_account_spreads a,
		#trades b,
		external_accounts c,
		external_account_types d
	where
		a.contract_id = b.contract_id
	and
		b.external_account_id = c.external_account_id
	and
		c.external_account_type_id = d.external_account_type_id
	and
		d.name = "Client"
	and
		b.trade_id = @trade_id
end
	
	

create table
	#vertical(
		id int identity,
		attribute varchar(50),
		value varchar(75) NULL
	)

insert into #vertical select "OrderID", deal_alias from #trades where trade_id = @trade_id
insert into #vertical select "TradeID", identifier from #trades where trade_id = @trade_id
insert into #vertical select "Customer", external_account from #trades where trade_id = @trade_id
insert into #vertical select "Trader", trader from #trades where trade_id = @trade_id
insert into #vertical select "Trade Date", convert(varchar(12), trade_day, 100) from #trades where trade_id = @trade_id
insert into #vertical select "Value Date", convert(varchar(12), vald, 100) from #trades where trade_id = @trade_id
declare @gmt_adjustment int
declare @gmt_trade_date datetime
declare @current_trade_date datetime
select @current_trade_date = trade_date from #trades where trade_id = @trade_id

/*
if object_id("gmt_adjustment") != NULL
begin
	select
		@gmt_adjustment = adjustment
	from
		gmt_adjustment
end
*/
if @gmt_adjustment not in(NULL, 0)
begin
	select
		@gmt_trade_date = dateadd(hour, @gmt_adjustment, @current_trade_date)
end
else
begin
	select
		@gmt_trade_date = @current_trade_date
end
insert into #vertical values("Execution Time", rtrim(convert(varchar(12), @gmt_trade_date, 100))+" "+rtrim(convert(varchar(25), @gmt_trade_date, 108))+" GMT")
insert into #vertical select "Trade Type", upper(trade_type) from #trades where trade_id = @trade_id
insert into #vertical select "Currency Pair", rtrim(convert(char(3), traded_ccy))+"/"+rtrim(convert(char(3), counter_ccy))  from #trades where trade_id = @trade_id
insert into #vertical select "Buy/Sell", client_buy_sell from #trades where trade_id = @trade_id
insert into #vertical select "Dealt Currency", traded_ccy from #trades where trade_id = @trade_id
insert into #vertical select "Dealt Amount", convert(varchar(30),convert(numeric(30, 2),  abs_qty)) from #trades where trade_id = @trade_id
insert into #vertical select "Contra Currency", counter_ccy from #trades where trade_id = @trade_id
insert into #vertical select "Contra Amount", convert(varchar(30), convert(numeric(30, 2),  abs_qty*db_price)) from #trades where trade_id = @trade_id
declare @display_rate varchar(30)
declare @current_rate varchar(30)
select
	@current_rate = convert(varchar(30), convert(numeric(30, 8), std_price)) from #trades where trade_id = @trade_id
exec
	u_striptrailingzeros
		@current_rate,
		@display_rate output
insert into #vertical values("Rate", @display_rate)
insert into #vertical values("Configured Markup", @markup)
insert into #vertical values("System TradeID", convert(varchar(30), @trade_id))

select 
	attribute,
	value
from
	#vertical
order by
	id


