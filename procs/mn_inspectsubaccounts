drop procedure
	mn_inspectsubaccounts
go

create procedure
	mn_inspectsubaccounts
		@login varchar(50),
		@master_allocation varchar(50),
		@version int
as

declare @ma_version_id int
declare @status varchar(50)
declare @add_sub_account varchar(100)
declare @edit_allocation varchar(50)
declare @remove_allocation varchar(50)
declare @remaining_pct float
declare @active_versions int
declare @activate varchar(20)
declare @archive varchar(20)
declare @default_account varchar(50)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"archive",
	"Archive Allocation Version",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"activate",
	"Activate Allocation Version",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"remove_allocation",
	"Remove Sub Account Alloc",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_allocation",
	"Edit Sub Account Alloc",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"new_sub_account",
	"Add Sub-Account",
	NULL)

select * from #meta


select
	@ma_version_id = a.ma_version_id,
	@default_account = c.symbol
from
	ma_versions a,
	master_allocations b,
	external_accounts c
where
	a.master_allocation_id = b.master_allocation_id
and
	b.external_account_id = c.external_account_id
and
	b.name = @master_allocation
and
	a.version = @version

select
	@active_versions = 0
select
	@active_versions = count(a.ma_version_id)
from
	ma_versions a,
	statuses b
where
	a.status_id = b.status_id
and
	a.ma_version_id = @ma_version_id
and
	b.name = "Active"
if @active_versions = NULL
	select
		@active_versions = 0

select
	@status = a.name
from
	statuses a,
	ma_versions b
where
	a.status_id = b.status_id
and
	b.ma_version_id = @ma_version_id

select
	@remaining_pct = 1.0 - sum(allocation)
from
	sub_accounts
where
	ma_version_id = @ma_version_id
if @remaining_pct = NULL
	select
		@remaining_pct = 1.0


if @status = "Queued"
begin
	select
		@add_sub_account = "Add new sub account to template",
		@edit_allocation = "EDIT",
		@remove_allocation = "REMOVE"

	if @active_versions = 0
		select
			@activate = "ACTIVATE"
end

if @status = "Active"
	select
		@archive = "ARCHIVE"


select
	new_sub_account = @add_sub_account,
	master_allocation = @master_allocation,
	status = @status,
	default_account = @default_account,
	remaining_pct = @remaining_pct,
	version = @version,
	activate = @activate,
	archive = @archive
	
select
	master_allocation = a.name,
	b.version,
	account = c.symbol,
	d.allocation,
	edit_allocation = @edit_allocation,
	remove_allocation = @remove_allocation
from
	master_allocations a,
	ma_versions b,
	external_accounts c,
	sub_accounts d
where
	a.master_allocation_id = b.master_allocation_id
and
	b.ma_version_id = d.ma_version_id
and
	d.external_account_id = c.external_account_id
and
	d.ma_version_id = @ma_version_id


go
