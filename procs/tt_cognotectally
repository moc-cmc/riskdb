use
	risk_cantorny
go

drop procedure
	tt_cognotectally
go

create proc
	tt_cognotectally
		@agent varchar(50),
		@source varchar(50),
		@client_source varchar(50),
		@executing_firm varchar(50),
		@contra_firm varchar(50),
		@sponsoring_firm varchar(50), /* sometimes NULL */
		@trade_date datetime,
		@trading_day datetime,
		@trade_report_id varchar(50),
		@order_id varchar(50),
		@client_order_id varchar(50),
		@execution_id varchar(50),
		@symbol varchar(50),
		@ccy1 varchar(10),
		@ccy2 varchar(10),
		@value_date datetime,
		@side varchar(10),
		@qty1 float,
		@price float


as

declare @quantity numeric(30,4)
declare @broker_id int
declare @trade_id int
declare @deal_id int
declare @counterparty varchar(50)
declare @trader varchar(50)
declare @external_account varchar(50)
declare @market_trade_identifier varchar(100)
declare @client_trade_identifier varchar(100)
declare @trade_identifier varchar(100)

if lower(rtrim(@side)) = "sell"
begin
	select
		@quantity = abs(@qty1) * -1.0
end
else
begin
	select
		@quantity = abs(@qty1)
end

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @source
if @broker_id = NULL
begin
	select
		status = "Error",
		message = "Broker not found",
		broker = @source
	return
end

select
	@market_trade_identifier = rtrim(@execution_id) + ".M",
	@client_trade_identifier = rtrim(@execution_id) + ".C"

/*
 * Check to see if @contra_firm is defined as a counterparty. If it is,
 * then it's a market trade so use the default external account and trader
 * for market trades done on cognotec. If it is not a defined counterparty, 
 * then assume it's a client trade and get the external account and the
 * trader via the traders table looking it up by @contra_firm.
 *
 * After detect whether it's a client or counterparty trade, then the trade
 * should look like this:
 *
 * Client Trade:
 *		@trader = @contra_firm
 *		@external_account = symbol of external account associated
 *					with the @trader
 * 		@counterparty = NULL [ Use the default ]
 *
 * Market Trade:
 *		@trader = NULL [ Use the default ]
 *		@external_account = NULL [ Use the default ]
 *		@counterparty = @contra_firm
 * 
 */

select
	@counterparty = name
from
	counterparties
where
	name = @contra_firm

if @counterparty = NULL
begin
	/* It is a client trade */
	select
		@external_account = a.symbol,
		@trader = b.symbol
	from
		external_accounts a,
		traders b
	where
		a.external_account_id = b.external_account_id
	and
		b.symbol = @contra_firm

	if @external_account = NULL
	begin
		select
			status = "Error",
			message = "Unable to resolve external account for contra firm",
			contra_firm = @contra_firm
		return
	end

	select
		@trade_identifier = @client_trade_identifier

	select
		@trade_id = trade_id
	from
		trades
	where
		identifier = @trade_identifier
	and
		broker_id = @broker_id
	if @trade_id != NULL
	begin
		select
			status = "Dupe",
			message = "Trade is already tallied",
			trade_identifier = @trade_identifier
		return
	end
		
	select
		@deal_id = deal_id
	from
		trades
	where
		identifier = @market_trade_identifier
	and
		broker_id = @broker_id
end
else
begin
	/* It is a counterparty (market) trade */
	select
		@external_account = NULL,
		@trader = NULL

	select
		@trade_identifier = @market_trade_identifier

	select
		@trade_id = trade_id
	from
		trades
	where
		identifier = @trade_identifier
	and
		broker_id = @broker_id
	if @trade_id != NULL
	begin
		select
			status = "Dupe",
			message = "Trade is already tallied",
			trade_identifier = @trade_identifier
		return
	end

	select
		@deal_id = deal_id
	from
		trades
	where
		identifier = @client_trade_identifier
	and
		broker_id = @broker_id
end
		
/*
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @ccy1 != NULL and @ccy2 != NULL and @symbol = @ccy2 + @ccy1
begin
    select
	@symbol = @ccy1 + @ccy2
end

	

exec
	fxa_tallytrade
		@login = @agent,
		@source = @source,
		@broker = @source,
		@deal_id = @deal_id output,
		@trade_id = @trade_id output,
		@tally_type = "Spot",
		@deal_type = "B2B Forward",
		@trade_type = "Spot",
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@trader = @trader,
		@identifier = @trade_identifier



go
			
