
if object_id("r_contracttheoasof") != NULL
    drop procedure
        r_contracttheoasof
go

create procedure
	r_contracttheoasof
		@contract_id int,
		@as_of_date datetime,
		@tv float output,
		@delta float output,
		@gamma float output,
		@theta float output,
		@tau float output
as

declare @timestamp datetime
	
select
	@tv = tv,
	@delta = delta,
	@gamma = gamma,
	@theta = theta,
	@tau = tau
from
	contract_tvs
where
	contract_id = @contract_id
and
	tv_date = @as_of_date

if @tv = NULL
begin
	select
		@timestamp = timestamp
	from
		current_contract_tvs
	where
		contract_id = @contract_id

	if @as_of_date > dateadd(hour, -7, @timestamp)
	begin
		select
			@tv = tv,
			@delta = delta,
			@gamma = gamma,
			@theta = theta,
			@tau = tau
		from
			current_contract_tvs
		where
			contract_id = @contract_id
	end
end

if @tv = NULL
begin
	select
		@tv = tv,
		@delta = delta,
		@gamma = gamma,
		@theta = theta,
		@tau = tau
	from
		contract_tvs
	where
		contract_id = @contract_id
	and
		tv_date = (select
				max(tv_date)
			from
				contract_tvs
			where
				contract_id = @contract_id
			and
				tv_date <= @as_of_date)
end
			
if @tv = NULL
begin
	select
		@tv = tv,
		@delta = delta,
		@gamma = gamma,
		@theta = theta,
		@tau = tau
	from
		current_contract_tvs
	where
		contract_id = @contract_id
end

go
