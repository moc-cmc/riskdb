drop procedure fxa_markresid
go
		
create procedure
	fxa_markresid
		@login varchar(50),
		@trade_id int,
		@run_name varchar(50)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL

as


declare @resid_status_id int


select
	@resid_status_id = status_id
from
	statuses
where
	name = "Resid"
if @@rowcount != 1
begin
	select
		error = -1,
		msg = "Problem finding status with name 'Resid'"
	return
end

update
	trades
set 
	status_id = @resid_status_id
where
	trade_id = @trade_id
if @@rowcount != 1
begin
	select
		error = -1,
		msg = "Problem finding trade",
		trade_id = @trade_id
	return
end

exec
	fxa_batchmarkresids
		@login,
		@run_name,
		@begin_date,
		@end_date
go

