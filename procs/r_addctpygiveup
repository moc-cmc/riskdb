drop procedure
	r_addctpygiveup
go

create procedure
	r_addctpygiveup
		@login varchar(50),
		@counterparty varchar(50),
		@source varchar(50),
		@symbol varchar(50)

as

declare @counterparty_id int
declare @source_id int

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		msg = "Can not find source",
		source = @source
	return
end

select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
	select
		msg = "Can not find counterparty",
		ctyp = @counterparty
	return
end

insert into
	counterparty_give_ups
values(
	@counterparty_id,
	@source_id,
	@symbol)

exec
        cm_counterpartymappings
                @login,
                @counterparty

go


