use contracts
go

create or replace procedure
	ct_addfwdsubscription
		@login varchar(30),
		@db_name varchar(30),
		@servername varchar(30),
		@symbol varchar(50),
		@dealt_currency varchar(20),
		@counter_currency varchar(20),
		@evaluation_currency varchar(30)
as

declare @contract_id int
declare @evaluation_currency_id int
declare @evaluation_name varchar(50)
declare @source varchar(50)
declare @product_type varchar(50)
declare @product_symbol varchar(50)
declare @product_name varchar(50)
declare @currency_symbol varchar(50)
declare @currency_name varchar(50)
declare @exchange varchar(30)
declare @contract_symbol varchar(50)
declare @sql_string varchar(255)
declare @product_id int
declare @currency_id int
declare @evaluation_contract varchar(50)
declare @evaluation_contract_id int
declare @inverted_contract_id int
declare @remotecall_servername varchar(50)
declare @debug char(1)

select
	@debug = "N"

select
	@remotecall_servername = @servername

if @@servername = @remotecall_servername
begin
	select
		@remotecall_servername = rtrim(@remotecall_servername)+"_LOOPBACK"
end

select
	@evaluation_name = name,
	@evaluation_currency_id = product_id
from
	products
where
	symbol = @evaluation_currency
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Evaluation currency not found",
		evaluation_currency = @evaluation_currency
	return
end

select
	symbol = @symbol

select
	@contract_id = contract_id,
	@contract_symbol = symbol
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Forward not found"
	return
end

select
	@product_type = a.name,
	@product_id = b.product_id,
	@product_symbol = b.symbol,
	@product_name = b.name,
	@currency_symbol = c.symbol,
	@currency_name = c.name,
	@currency_id = c.product_id,
	@exchange = d.name
from
	product_types a,
	products b,
	products c,
	exchanges d,
	forwards e
where
	a.product_type_id = b.product_type_id
and
	b.product_id = e.product_id
and
	c.product_id = e.currency_id
and
	e.exchange_id = d.exchange_id
and
	e.contract_id = @contract_id

select
	@source = "MPT Contracts"


update
	product_rate_subscriptions
set
	last_update = "1/1/10"
where
	product_id = @currency_id
and
	db_name = @db_name
and
	servername = @servername
if @@rowcount = 0
begin
	insert into
		product_rate_subscriptions
	values(
		@currency_id,
		@db_name,
		@servername,
		"1/1/10")
end


select
	@sql_string = "exec " + rtrim(@db_name) + "..r_importforward '" + rtrim(@login) + "', '" + 
		rtrim(@source) + "', '" + rtrim(@product_type) + "', '" + 
		rtrim(@product_symbol) + "', '" + rtrim(@product_name) + "', '"
		+ rtrim(@currency_symbol) + "', '" + rtrim(@currency_name) +
		"', '" + rtrim(@exchange) + "', '" + rtrim(@contract_symbol) + "'"



if @debug ="Y"
        select "ct_addfwdsubscription", "TEST 1", sql_string1 = @sql_string


exec
	sp_remotesql
		@remotecall_servername,
		@sql_string


if @product_type = "Currency"
begin
	update
		product_rate_subscriptions
	set
		last_update = "1/1/10"
	where
		product_id = @product_id
	and
		db_name = @db_name
	and
		servername = @servername
	if @@rowcount = 0
	begin
		insert into
			product_rate_subscriptions
		values(
			@product_id,
			@db_name,
			@servername,
			"1/1/10")
	end

	if @product_id != @evaluation_currency_id
	begin
		select
			@evaluation_contract = NULL
		select
			@evaluation_contract = a.symbol,
			@evaluation_contract_id = a.contract_id
		from
			contracts a,
			forwards b
		where
			a.contract_id = b.contract_id
		and
			b.product_id = @product_id
		and
			b.currency_id = @evaluation_currency_id

		if @evaluation_contract != NULL
		begin
			select
				@exchange = a.name
			from
				exchanges a,
				forwards b
			where
				a.exchange_id = b.exchange_id
			and
				b.contract_id = @evaluation_contract_id
		
			select
				@sql_string = "exec " + rtrim(@db_name) + "..r_importforward '" +
				rtrim(@login) + "', '" + rtrim(@source) + "', '" 
				+ rtrim(@product_type) + "', '" + rtrim(@product_symbol) + "', '"
				+ rtrim(@product_name) + "', '" + rtrim(@evaluation_currency) + "', '"
				+ rtrim(@evaluation_name) + "', '" + rtrim(@exchange) + "', '"
				+ rtrim(@evaluation_contract) + "'"

			if @debug ="Y"
			begin
				select "ct_addfwdsubscription", "TEST 2", sql_string2 = @sql_string
			end

			exec
				sp_remotesql
					@remotecall_servername,
					@sql_string

			delete

			from
				forward_subscriptions
			where
				servername = @servername
			and
				db_name = @db_name
			and
				contract_id = @evaluation_contract_id

			insert into
				forward_subscriptions(
					contract_id,
					db_name,
					servername)
			values(
				@evaluation_contract_id,
				@db_name,
				@servername)

		end

		select
			@inverted_contract_id = NULL,
			@evaluation_contract = NULL
		exec
			r_invertedcontract
				@evaluation_contract_id,
				@inverted_contract_id output

		select
			@evaluation_contract = symbol
		from
			contracts
		where
			contract_id = @inverted_contract_id

		if @evaluation_contract != NULL
		begin

			select
				@exchange = a.name
			from
				exchanges a,
				forwards b
			where
				a.exchange_id = b.exchange_id
			and
				b.contract_id = @inverted_contract_id

			select
				@sql_string = "exec " + rtrim(@db_name) + "..r_importforward '" +
				rtrim(@login) + "', '" + rtrim(@source) + "', '"
				+ rtrim(@product_type) + "', '" + rtrim(@evaluation_currency) + "', '"
				+ rtrim(@evaluation_name) + "', '" + rtrim(@product_symbol) + "', '"
				+ rtrim(@product_name) + "', '" + rtrim(@exchange) + "', '"
				+ rtrim(@evaluation_contract) + "'"


			if @debug ="Y"
			begin
				select "ct_addfwdsubscription", "TEST 3", sql_string3 = @sql_string
			end

			exec
				sp_remotesql
					@remotecall_servername,
					@sql_string

			delete

			from    
				forward_subscriptions
			where
				servername = @servername
			and
				db_name = @db_name
			and
				contract_id = @inverted_contract_id

			insert into
				forward_subscriptions(
					contract_id,
					db_name,
					servername)
			values(
				@inverted_contract_id,
				@db_name,
				@servername)

		end
	end
end

if @currency_id != @evaluation_currency_id
begin
	select
		@evaluation_contract = NULL
	select
		@evaluation_contract = a.symbol,
		@evaluation_contract_id = a.contract_id
	from
		contracts a,
		forwards b
	where
		a.contract_id = b.contract_id
	and
		b.product_id = @currency_id
	and
		b.currency_id = @evaluation_currency_id

	/* select
		evaluation_contract = @evaluation_contract,
		evaluation_contract_id = @evaluation_contract_id,
		currency_id = @currency_id,
		evaluation_currency_id = @evaluation_currency_id  TEST */

	if @evaluation_contract != NULL
	begin
		select
			@exchange = a.name
		from
			exchanges a,
			forwards b
		where
			a.exchange_id = b.exchange_id
		and
			b.contract_id = @evaluation_contract_id
	
		/* TEST
		select
			source = @source,
			product_type = @product_type,
			product_symbol = @product_symbol,
			product_name = @product_name,
			evaluation_currency = @evaluation_currency,
			evaluation_name = @evaluation_name,
			exchange = @exchange,
			evaluation_contract = @evaluation_contract */
	
		/* 
		 * Replaced/fixed this. don't know how it ever worked.
		 * should be currency_symbol not product etc 
		 */
		/* select
			@sql_string = "exec " + rtrim(@db_name) + "..r_importforward '" +
			rtrim(@login) + "', '" + rtrim(@source) + "', '" 
			+ rtrim(@product_type) + "', '" + rtrim(@product_symbol) + "', '"
			+ rtrim(@product_name) + "', '" + rtrim(@evaluation_currency) + "', '"
			+ rtrim(@evaluation_name) + "', '" + rtrim(@exchange) + "', '"
			+ rtrim(@evaluation_contract) + "'" */

		select
			@sql_string = "exec " + rtrim(@db_name) + "..r_importforward '" +
			rtrim(@login) + "', '" + rtrim(@source) + "', '" 
			+ rtrim(@product_type) + "', '" + rtrim(@currency_symbol) + "', '"
			+ rtrim(@currency_name) + "', '" + rtrim(@evaluation_currency) + "', '"
			+ rtrim(@evaluation_name) + "', '" + rtrim(@exchange) + "', '"
			+ rtrim(@evaluation_contract) + "'" 


		if @debug ="Y"
		begin
			select "ct_addfwdsubscription", "TEST 4", sql_string4 = @sql_string 
		end
		exec
			sp_remotesql
				@remotecall_servername,
				@sql_string

		delete

		from
			forward_subscriptions
		where
			servername = @servername
		and
			db_name = @db_name
		and
			contract_id = @evaluation_contract_id

		insert into
			forward_subscriptions(
				contract_id,
				db_name,
				servername)
		values(
			@evaluation_contract_id,
			@db_name,
			@servername)

	end

	select
		@inverted_contract_id = NULL,
		@evaluation_contract = NULL
	exec
		r_invertedcontract
			@evaluation_contract_id,
			@inverted_contract_id output

	select
		@evaluation_contract = symbol
	from
		contracts
	where
		contract_id = @inverted_contract_id

	if @evaluation_contract != NULL
	begin

		select
			@exchange = a.name
		from
			exchanges a,
			forwards b
		where
			a.exchange_id = b.exchange_id
		and
			b.contract_id = @inverted_contract_id

		select
			@sql_string = "exec " + rtrim(@db_name) + "..r_importforward '" +
			rtrim(@login) + "', '" + rtrim(@source) + "', '"
			+ rtrim(@product_type) + "', '" + rtrim(@evaluation_currency) + "', '"
			+ rtrim(@evaluation_name) + "', '" + rtrim(@currency_symbol) + "', '"
			+ rtrim(@currency_name) + "', '" + rtrim(@exchange) + "', '"
			+ rtrim(@evaluation_contract) + "'"
	
	
		if @debug ="Y"
		begin
			select "ct_addfwdsubscription", "TEST 5", sql_string5 = @sql_string
		end

		exec
			sp_remotesql
				@remotecall_servername,
				@sql_string

		delete

		from    
			forward_subscriptions
		where
			servername = @servername
		and
			db_name = @db_name
		and
			contract_id = @inverted_contract_id

		insert into
			forward_subscriptions(
				contract_id,
				db_name,
				servername)
		values(
			@inverted_contract_id,
			@db_name,
			@servername)

	end
end


delete

from
	forward_subscriptions
where
	servername = @servername
and
	db_name = @db_name
and
	contract_id = @contract_id

insert into
	forward_subscriptions(
		contract_id,
		db_name,
		servername)
values(
	@contract_id,
	@db_name,
	@servername)

