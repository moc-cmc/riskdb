drop procedure
	ag_productbalancetrades
go

create procedure
	ag_productbalancetrades
		@login varchar(50),
		@account varchar(50),
		@symbol varchar(50),
		@value_date datetime
as

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Format",
	"quantity",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	"#,##0.00000")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

declare @external_account_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		section = "Errors",
		status = "Error",
		msg = "Problem finding account",
		account = @account
	return
end
		
create table
	#contracts(
		contract_id int)
insert into
	#contracts
select
	a.contract_id
from
	forwards a,
	products b
where
	a.product_id = b.product_id
and
	b.symbol = @symbol

insert into
	#contracts
select
	a.contract_id
from
	forwards a,
	products b
where
	a.currency_id = b.product_id
and
	b.symbol = @symbol

create table
	#trade_types(
		trade_type_id int,
		name varchar(25)
		)
insert into
	#trade_types(
		trade_type_id,
		name)
select
	trade_type_id,
	name
from	
	trade_types
where
	name not like ("%CFD%")

create table
	#trades(
		trade_id int)
insert into
	#trades
select
	a.trade_id
from
	trades a,
	#contracts c
where
	a.external_account_id = @external_account_id
and
	a.contract_id = c.contract_id
and
	convert(date, a.value_date) = convert(date, @value_date)

select
	section = "Maturing trades",
	style = "background:#FFFFFF;border: 1px solid white",
	a.trade_id,
	a.deal_id,
	a.trade_date, 
	trade_type = b.name,
	account = c.name,
	counterparty = d.name,
	a.quantity,
	e.symbol,
	a.value_date,
	a.price,
	trader = f.symbol,
	status = g.name
from
	trades a,
	#trade_types b,
	external_accounts c,
	counterparties d,
	contracts e,
	traders f,
	statuses g,
	#trades h
where
	a.contract_id = e.contract_id
and
	a.trade_type_id = b.trade_type_id
and
	a.external_account_id = c.external_account_id
and
	a.counterparty_id = d.counterparty_id
and
	a.trader_id = f.trader_id
and
	a.status_id = g.status_id
and
	a.trade_id = h.trade_id
order by
	convert(date, a.trade_date),
	e.symbol

go
