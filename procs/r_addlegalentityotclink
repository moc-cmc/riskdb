create or replace procedure
	r_addlegalentityotclink
		@login varchar(100),
		@entering_legal_entity varchar(150),
		@available_legal_entity varchar(150)

as

declare @legal_entity_otc_link_id int

exec
	api_addlegalentityotclink
		@login = @login,
		@entering_legal_entity = @entering_legal_entity,
		@available_legal_entity = @available_legal_entity,
		@legal_entity_otc_link_id = @legal_entity_otc_link_id output
		
exec
	r_managelegalentityotclinks
		@login = @login,
		@legal_entity = @entering_legal_entity

go


		
