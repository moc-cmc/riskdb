
if object_id("r_forwardposplfordate") != NULL
    drop procedure
        r_forwardposplfordate
go


create procedure
	r_forwardposplfordate
		@contract_id int,
		@quantity numeric(30,2),
		@begin_date datetime,
		@end_date datetime,
		@open_price float output,
		@begin_value float output,
		@close_price float output,
		@end_value float output,
		@p_l float output
		
as

declare @multiplier float
declare @inverted_contract_id int

exec
	r_priceasof
		@contract_id,
		@begin_date,
		@open_price output

exec
	r_priceasof
		@contract_id,
		@end_date,
		@close_price output


if @open_price = NULL
begin
	exec
		r_invertedcontract
			@contract_id,
			@inverted_contract_id output

	exec
		r_posprices
			@inverted_contract_id,
			@begin_date,
			@end_date,
			@open_price output,
			@close_price output

	select
		@open_price = 1 / @open_price,
		@close_price = 1 / @close_price
end
	


select
	@multiplier = quantity
from
	forwards b
where
	contract_id = @contract_id

select
	@begin_value = @close_price * @quantity * @multiplier,
	@end_value = @open_price * @quantity * @multiplier

select
	@p_l = (@close_price * @quantity * @multiplier) - (@open_price * @quantity * @multiplier)

return

go
