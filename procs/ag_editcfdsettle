drop procedure
	xag_editcfdsettle
go

create procedure
	xag_editcfdsettle
		@login varchar(50),
		@symbol varchar(50),
		@settle_date datetime,
		@settle_price float,
		@show_output char(1)=NULL
as

declare @price_id int
declare @status_id int
declare @price_type_id int
declare @contract_id int
declare @prices int
declare @price_date datetime
declare @aligned_price float

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)
insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Group",
        "section",
        NULL,
        NULL)
select 
	* 
from
	#meta

select
	@settle_date = convert(datetime, convert(date, @settle_date))

select
	@price_date = dateadd(hour, 17, @settle_date)


select
	@price_type_id = price_type_id
from
	price_types
where
	name = "Close"
if @price_type_id = NULL
begin
	select
		status = "Error",
		message = "Price type Close not found"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "User Review"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "User Review status not found"
	return
end

	
select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

declare @cfd_product_id int
declare @cfd_underlying_ccy_id int

select
	@cfd_product_id = a.product_id,
	@cfd_underlying_ccy_id = a.currency_id
from
	forwards a
where
	contract_id = @contract_id

/* Get all the conversion cfd contracts that are used for pricing only
   ie   If we are updating DAXEUR, we need to recalc the price for DAXUSD DAXGBP, etc */
create table
	#conversion_cfds(
		id int identity,
		contract_id int, 
		symbol varchar(50),
		product_id int,
		currency_id int,
		conversion_contract_id int NULL,
		inverted_conversion char(1) NULL,
		conversion_price float NULL,
		aligned_price float NULL,
		has_price_for_date char(1) NULL
)

insert into
	#conversion_cfds(
		contract_id,
		symbol,
		product_id,
		currency_id)
select	
	a.contract_id,
	a.symbol,
	c.product_id,
	c.currency_id
from
	contracts a,
	forwards c
where
	a.contract_id = c.contract_id
and
	c.product_id = @cfd_product_id
and
	c.currency_id != @cfd_underlying_ccy_id

update
	#conversion_cfds
set
	conversion_contract_id = a.contract_id
from
	contracts a,
	forwards b,
	#conversion_cfds c
where
	a.contract_id = b.contract_id
and
	b.product_id = @cfd_underlying_ccy_id
and
	b.currency_id = c.currency_id


update
        #conversion_cfds
set
        inverted_conversion = "Y"
from
        #conversion_cfds a,
        contract_price_styles b,
        price_styles c
where
        a.conversion_contract_id = b.contract_id
and
        b.price_style_id = c.price_style_id
and
        c.name = "Inverted"

update
	#conversion_cfds
set
        conversion_contract_id = a.contract_id
from
	contracts a,
        forwards b,
        #conversion_cfds c
where
        a.contract_id = b.contract_id
and
        b.product_id = c.currency_id
and
        b.currency_id = @cfd_underlying_ccy_id
and
	c.inverted_conversion = "Y"

	

update
	#conversion_cfds
set
	conversion_price = a.price,
	aligned_price = case when b.inverted_conversion = "Y" then (1/a.price) * @settle_price else a.price * @settle_price end
from
	prices a,
	#conversion_cfds b
where
	a.contract_id = b.conversion_contract_id
and 
	a.price_date = @price_date


declare @conversion_prices int
declare @conversion_contracts int


update
	#conversion_cfds
set
	has_price_for_date = "Y"
from
	prices a,
	#conversion_cfds b
where
	a.contract_id = b.contract_id
and
	a.price_date = @price_date

select
	@conversion_prices = count(*)
from
	#conversion_cfds
where
	has_price_for_date = "Y"

select * from #conversion_cfds

select
	section = "Aligned Prices",
	style = "background:#FFFFFF;border: 1px solid white",
	symbol=a.symbol,
	product=b.symbol,
	currency=c.symbol,
	conversion_contract=d.symbol,
	a.conversion_price,
	a.aligned_price
from 
	#conversion_cfds a,
	products b,
	products c,
	contracts d
where
	a.product_id = b.product_id
and	
	a.currency_id = c.product_id
and
	a.conversion_contract_id = d.contract_id

	
	
begin tran
	update
		prices
	set
		price = @settle_price
	where
		contract_id = @contract_id
	and
		price_date = @price_date
	select
		@prices = @@rowcount
	if @prices > 1
	begin
		select
			status = "Error",
			message = "Multiple price problem encountered",
			symbol = @symbol,
			price_date = @price_date
		rollback tran
		return
	end
	update
		prices
	set
		price = a.aligned_price
	from
		#conversion_cfds a,
		prices b
	where
		a.contract_id = b.contract_id
	and
		price_date = @price_date
	and
		a.has_price_for_date = "Y"
	if @@rowcount != @conversion_prices
	begin
		select
			status = "Error",
			message = "Problem aligning CFD conversion prices, please provide the below table to support@elysiumtechgroup.com"
			
		select 
			msg = "CFD alignement error", * from #conversion_cfds
		rollback tran
		return
	end
		
commit tran

if @prices = 0
begin
	exec
		j_nextkey
			"prices",
			@price_id output

	insert into
		prices(
			price_id,
			status_id,
			contract_id,
			price_date,
			price_type_id,
			price)
	values(
		@price_id,
		@status_id,
		@contract_id,
		@price_date,
		@price_type_id,
		@settle_price)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			msg = "Problem inserting price",
			contract_id= @contract_id
	end
end

/* If there is a new conversion contract, we have may have to insert a price */
delete from
	#conversion_cfds
where
	has_price_for_date = "Y"


declare @id int
declare @ids int

select
	@id = 0
select
	@ids = count(*)
from
	#conversion_cfds
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#conversion_cfds
	where
		id > @id

	select
		@price_id = NULL,
		@contract_id = NULL,
		@settle_price = NULL

	exec
		j_nextkey
			"prices",
			@price_id output

	select
		@contract_id = contract_id,
		@settle_price = aligned_price
	from
		#conversion_cfds
	where
		id = @id

	if @settle_price = NULL
	begin
		select
			status = "Error",
			message = "Trying to save null price for conversion cfd",
			status_id = @status_id,
			price_date = @price_date,
			contract_id = @contract_id,
			settle_price = @settle_price

		select
			contract = a.symbol
		from
			contracts a
		where
			contract_id = @contract_id
	end
	else
	begin
		insert into
			prices(
				price_id,
				status_id,
				contract_id,
				price_date,
				price_type_id,
				price)
		values	(
			@price_id,
			@status_id,
			@contract_id,
			@price_date,
			@price_type_id,
			@settle_price)
	end
	
	
	select
		@ids = count(*)
	from
		#conversion_cfds
	where
		id > @id
end


if @show_output != "N"
begin
	exec
		ag_cfdsettles
			@login,
			@settle_date
end

go

