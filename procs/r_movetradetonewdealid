if object_id("r_movetradetonewdealid") != NULL
    drop procedure
        r_movetradetonewdealid
go

create procedure
	r_movetradetonewdealid
		@login varchar(50),
		@trade_id int,
		@deal_id int
as

declare @new_deal_id int
declare @deal_type_id int
declare @status_id int

select
	@deal_type_id = deal_type_id,
	@status_id = status_id
from
	deals
where
	deal_id = @deal_id

exec
	j_nextkey
		"deals",
		@new_deal_id output


insert into
	deals
values(
	@new_deal_id,
	@deal_type_id,
	getdate(),
	@status_id)

exec
	r_changetradedealid
		@login,
		@trade_id,
		@deal_id,
		@new_deal_id


go
