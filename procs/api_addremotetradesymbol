create or replace procedure
	api_addremotetradesymbol
		@login varchar(100),
		@source varchar(100),
		@internal_account varchar(50),
		@external_account varchar(50),
		@counterparty varchar(50),
		@quantity numeric(30, 8),
		@price float,
		@contract varchar(50),
		@trade_date datetime,
		@value_date datetime,
		@fixing_date datetime=NULL,
		@identifier varchar(100),
		@remote_trade_symbol_id int=NULL output

as

declare @tico_account_id int
declare @trade_id int
declare @source_id int
declare @internal_account_id int
declare @external_account_id int
declare @counterparty_id int
declare @contract_id int
declare @new_status_id int
declare @bo_trade_date datetime
declare @begin_date datetime
declare @end_date datetime

exec     
        r_daterangefordate
                @trade_date, 
                @begin_date output,
                @end_date output
             
select
        @bo_trade_date = convert(date, @end_date)  

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

if @remote_trade_symbol_id != NULL
begin
	select
		status = "Error",
		message = "Must not provide remote_trade_symbol_id on insert"
	return
end

select
	@source_id = source_id
from
	sources
where 
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source",
		source = @source
	return
end

select
	@remote_trade_symbol_id = remote_trade_symbol_id	
from
	remote_trade_symbols
where
	source_id = @source_id
and
	identifier = @identifier
if @remote_trade_symbol_id != NULL
begin
	select
		status = "Dupe",
		message = "Remote trade reported for source and identifier",
		source = @source,
		identifier = @identifier,
		remote_trade_symbol_id = @remote_trade_symbol_id		
	
	return
end

select
	@internal_account_id = internal_account_id
from
	internal_accounts	
where
	symbol = @internal_account
if @internal_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining internal account",
		internal_account = @internal_account
	return
end
		
select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining external account",
		external_account = @external_account
	return
end
		
select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @counterparty_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining counterparty",
		counterparty = @counterparty
	return
end
		
select
	@contract_id = contract_id	
from
	contracts
where
	symbol = @contract
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining contract",
		contract = @contract
	return
end
		
select
	@remote_trade_symbol_id = remote_trade_symbol_id	
from
	remote_trade_symbols
where
	source_id = @source_id
and
	identifier = @identifier
if @remote_trade_symbol_id != NULL
begin
	select
		status = "Dupe",
		message = "Remote trade reported for source and identifier",
		source = @source,
		identifier = @identifier,
		remote_trade_symbol_id = @remote_trade_symbol_id		
	return
end
		
select	
	@new_status_id = status_id	
from
	statuses
where
	name = "New"
if @new_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding 'New' status for recon"
	return
end
	
exec
	j_nextkey
		"remote_trade_symbols",
		@remote_trade_symbol_id output

insert into
	remote_trade_symbols (
		remote_trade_symbol_id,
		source_id,
		trade_id,
		recon_status_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		quantity,
		price,
		contract_id,
		trade_date,
		value_date,
		fixing_date,
		identifier,
		bo_trade_date)   
values(
	@remote_trade_symbol_id,
	@source_id,
	NULL,
	@new_status_id,
	@internal_account_id,
	@external_account_id,
	@counterparty_id,
	@quantity,
	@price,
	@contract_id,
	@trade_date,
	@value_date,
	@fixing_date,
	@identifier,
	@bo_trade_date)   
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem inserting remote trade symbol",
		remote_trade_symbol_id = @remote_trade_symbol_id,
		identifier = @identifier,
		source = @source
	return
end

go	
