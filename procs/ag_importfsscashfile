drop procedure
	ag_importfsscashfile
go

create procedure
	ag_importfsscashfile
		@login varchar(50),
		@source varchar(50),
		@clientreferenceid varchar(50)=NULL,
		@entityid varchar(50)=NULL,
		@instrumentid varchar(50)=NULL,
		@movementdate varchar(50)=NULL,
		@ccyid varchar(3)=NULL,
		@amount varchar(50)=NULL,
		@customer varchar(50)=NULL,
		@fromdirection varchar(50)=NULL,
		@fromaccounttype varchar(50)=NULL,
		@fromaccountid varchar(50)=NULL,
		@todirection varchar(50)=NULL,
		@toaccounttype varchar(50)=NULL,
		@toaccountid varchar(50)=NULL,
		@outaccountid varchar(50)=NULL,
		@tradedate varchar(50)=NULL,
		@offsetvalidationtype varchar(50)=NULL,
		@externalreferenceid varchar(50)=NULL,
		@tradesourcetype varchar(50)=NULL,
		@traderid varchar(50)=NULL,
		@portfolioid varchar(50)=NULL,
		@profitcenterid varchar(50)=NULL,
		@interfacepermissionmode varchar(10)=NULL,
		@tradenumber varchar(50)=NULL,
		@notes varchar(100)=NULL
as

declare @client_reference_id int
declare @entity_id varchar(50)
declare @instrument_id varchar(50)
declare @movement_date datetime
declare @currency varchar(3)
declare @quantity float
declare @from_direction varchar(50)
declare @from_account_type varchar(50)
declare @from_account_id varchar(50)
declare @to_direction varchar(50)
declare @to_account_type varchar(50)
declare @to_account_id varchar(50)
declare @out_account_id varchar(50)
declare @trade_date datetime
declare @offset_validation_type varchar(50)
declare @external_reference_id varchar(50)
declare @trade_source_type varchar(50)
declare @trader_id varchar(50)
declare @portfolio_id varchar(50)
declare @profit_center_id varchar(50)
declare @trade_number int

declare @external_account_id int
declare @source_id int
declare @external_account varchar(50)
declare @account_transaction_id int
declare @product_id int
declare @transaction_type_id int
declare @product varchar(25)
declare @tico_account_id int
declare @timestamp datetime
declare @dupe varchar(1)

declare @direction int

/*
select
	@client_reference_id = convert(int, @clientreferenceid),
	@entity_id = @entityid,
	@instrument_id = @instrumentid,
	@movement_date = convert(datetime, @movementdate),
	@currency = @ccyid,
	@quantity = convert(float, @amount),
	@from_direction = @fromdirection,
	@from_account_type = @fromaccounttype,
	@from_account_id = @fromaccountid,
	@to_direction = @todirection,
	@to_account_type = @toaccounttype,
	@to_account_id = @toaccountid,
	@out_account_id = @outaccountid,
	@trade_date = convert(datetime, @tradedate),
	@offset_validation_type = @offsetvalidationtype,
	@external_reference_id = @externalreferenceid,
	@trade_source_type = @tradesourcetype,
	@trader_id = @traderid,
	@portfolio_id = @portfolioid,
	@profit_center_id = @profitcenterid,
	@trade_number = convert(int, @tradenumber)
*/

select
	@quantity = convert(float, @amount),
	@movement_date = convert(datetime, @movementdate)

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Unable to find a source",
		source = @source
	return
end

/*
select
        @dupe = "Y"
from
        account_transaction_identifiers
where
        source_id = @source_id
and
        identifier = @externalreferenceid
if @dupe = "Y"
begin
        select
                status = "Error",
                message = "Duped cash file",
		identifier = @externalreferenceid
        return
end
*/

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login
if @tico_account_id = NULL
begin
        select
                status = "Error",
                message = "Unable to resolve login"
        return
end

select
        @product_id = product_id
from
        products
where
        symbol = @ccyid
if @product_id = NULL
begin
        select
                status = "Error",
                message = "Product not found",
                product = @product
        return
end


select
	@direction = 1

if @fromdirection = "Withdrawal" /* vs 'Deposit' */
begin
	select
		@direction = -1
end

select
	@quantity = @quantity * @direction

select
	@external_account_id = a.external_account_id,
	@external_account = b.symbol
from
	external_account_symbols a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.source_id = @source_id
and
	a.symbol = @customer
if @@rowcount != 1
begin
	select
		@external_account_id = external_account_id,
		@external_account = symbol
	from
		external_accounts
	where
		symbol = @customer
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not find account", 
			source = @source,
			account = @customer
		return
	end
end

select
        @transaction_type_id = transaction_type_id
from
        transaction_types
where
        name = @fromdirection
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Could not find transaction_type",
		type = @fromdirection
	return
end

select
        @timestamp = convert(date, getdate())

/* Clear note if value is "No Notes Added" */
if @notes = "No Notes Added"
begin
	select
		@notes = NULL
end

exec
        j_nextkey
                "account_transactions",
                @account_transaction_id output

begin tran
        insert into
                account_transactions(
                        account_transaction_id,
                        entered_by,
                        external_account_id,
                        transaction_type_id,
                        transaction_date,
                        currency_id,
                        amount,
                        note)
        values(
                @account_transaction_id,
                @tico_account_id,
                @external_account_id,
                @transaction_type_id,
                @timestamp,
                @product_id,
                @quantity,
                @notes)
        if @@rowcount != 1
        begin
                select
                        status = "Error",
                        messsage = "Unable to book. Transfer failed",
                        account = @external_account ,
			identifier = @externalreferenceid
                rollback tran
                return
        end
commit tran

select
	status = "Transaction inserted",
	account_transaction_id = @account_transaction_id,
	identifier = @externalreferenceid

go
