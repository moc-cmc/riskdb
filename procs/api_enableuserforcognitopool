
create or replace procedure
	api_enableuserforcognitopool
		@login varchar(50),
		@mfa_login varchar(50),
		@mfa_phone_number varchar(50),
		@user_pool varchar(50),
		@mfa_type varchar(50)
as


declare @tico_account_id int
declare @mfa_tico_account_id int
declare @cognito_user_id int
declare @cognito_user_pool_id int
declare @cognito_user_status_id int
declare @new_cognito_user_status_id int
declare @cognito_user_status varchar(50)
declare @phone_plus_char char(1)
declare @email varchar(100)
declare @status_id int
declare @mfa_type_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login",
		login = @login
   	return
end

select
	@mfa_tico_account_id = account_id
from
	tico_accounts
where
	login = @mfa_login
if @mfa_tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for MFA login",
		mfa_login = @mfa_login
   	return
end

select
	@email = a.email
from
	emails a,
	user_emails b,
	tico_accounts c
where
	a.email_id = b.email_id
and
	b.tico_account_id = c.account_id
if @email = NULL
begin
	select
		status = "Error",
		message = "Problem finding email for account. MFA requires an email for login"
	return
end
	

select
	@cognito_user_pool_id = cognito_user_pool_id
from
	cognito_user_pools
where
	name = @user_pool
if @cognito_user_pool_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding user pool",
		user_pool = @user_pool
	return
end

select
	@new_cognito_user_status_id = cognito_user_status_id
from
	cognito_user_statuses
where
	name = "Pending"
if @new_cognito_user_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding 'Pending' cognito user status"
	return
end

select
	@mfa_type_id = mfa_type_id
from
	mfa_types
where
	name = @mfa_type
if @mfa_type_id = NULL
begin
	select
		status = "Error",
		message = "Could not find mfa type from provided",
		mfa_type = @mfa_type
	return
end

select
        @status_id = status_id
from
        statuses
where
        name = "User Review"
if @status_id = NULL
begin
        select
                status = "Error",
                message = "Problem finding 'User Review' status"
        return
end
		

/* Add a plus sign to the phone nuumber if its missing */
select
	@phone_plus_char = convert(char(1), @mfa_phone_number)

if @phone_plus_char != "+"
begin
	select
		@mfa_phone_number = "+" + rtrim(@mfa_phone_number)
end

if len(@mfa_phone_number) < 12
begin
	select
		status = "Error",
		message = "Problem with format of phone number. Should be at least 12 characters with leading + sign, country code, number"
	return
end


select
	@cognito_user_id = cognito_user_id,
	@cognito_user_status_id = cognito_user_status_id
from
	cognito_users
where
	tico_account_id = @mfa_tico_account_id
and
	cognito_user_pool_id = @cognito_user_pool_id
if @cognito_user_id != NULL
begin
	select
		@cognito_user_status = name
	from
		cognito_user_statuses
	where
		cognito_user_status_id = @cognito_user_status_id
	
	select
		status = "Error",
		message = "User already enabled for MFA in Cognito",
		cognito_user_status = @cognito_user_status
	return
end

select
	@cognito_user_id = cognito_user_id
from
	cognito_users
where
	tico_account_id = @mfa_tico_account_id
and
	cognito_user_pool_id = @cognito_user_pool_id

if @cognito_user_id != NULL
begin
	select
		status = "Error",
		message = "Account already created for user pool"
	return
end

exec
	j_nextkey
		"cognito_users",
		@cognito_user_id output

insert into
	cognito_users(
		cognito_user_id,
		tico_account_id,
		cognito_user_pool_id,
		cognito_user_status_id,
		status_id,
		phone_number,
                phone_number_verified,
		create_date,
		last_modify_date,
		cognito_sub,
		mfa_type_id)
values(
	@cognito_user_id,
	@mfa_tico_account_id,
	@cognito_user_pool_id,
	@new_cognito_user_status_id,
	@status_id,
	@mfa_phone_number,
	"N",
	getdate(),
	getdate(),
	NULL,
	@mfa_type_id
)
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem inserting cognito user",
		cognito_user_id = @cognito_user_id
	return
end

select
	status = "Success",
	message = "Enabled user for MFA in Cognito User Pool",
	mfa_login = @mfa_login,
	mfa_phone_number = @mfa_phone_number,
	user_pool = @user_pool,
	mfa_tyoe = @mfa_type_id



go 

