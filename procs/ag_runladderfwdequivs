		counterparty_id
	from
		counterparties

create table
	#positions(
		product_id int,
		symbol varchar(50) NULL,
		value_date datetime,
		quantity float)
insert into
	#positions(
		product_id,
		value_date,
		quantity)
select
	h.product_id,
	a.value_date,
	sum(a.quantity)
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	forwards h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.contract_id = h.contract_id
and
	a.value_date >= @begin_date
and
	a.trade_date <= @end_date
group by
 
	h.product_id,
	a.value_date

insert into
	#positions(
		product_id,
		value_date,
		quantity)
select
	h.currency_id,
	a.value_date,
	sum(a.quantity * a.price * -1.0)
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	forwards h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.contract_id = h.contract_id
and
	a.value_date >= @begin_date
and
	a.trade_date <= @end_date
group by
	h.currency_id,
	a.value_date
update
	#positions
set
	a.symbol = b.symbol
from
	#positions a,
	products b
where
	a.product_id = b.product_id

	
create table
	#balances(
		id int identity,
		style varchar(250) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		value_date datetime NULL,
		balance float NULL,
		evaluation_currency_id int NULL,
 		contract_id int NULL,
		contract varchar(50) NULL,
		spot_price float NULL,
		days float NULL,
		forward_price float NULL,
		currency_rate float NULL,
		product_rate float NULL,
		equiv float NULL,
		equiv_ccy varchar(50) NULL)

insert into
	#balances(
 		product_id,
 		product,
		value_date,
		balance)
select
	product_id,
	symbol,
	value_date,
	sum(quantity)
from
	#positions
group by
	product_id,
	symbol,
	value_date
order by
	symbol,
	value_date

update
	#balances
set
	style = @style

update
	#balances
set
	evaluation_currency_id = @evaluation_currency_id

update
	#balances
set
	a.contract_id = b.contract_id
from
	#balances a,
	forwards b
where
	a.product_id = b.product_id
and
	a.evaluation_currency_id = b.currency_id

update
	#balances
set
	a.contract = b.symbol
from
	#balances a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#balances
set
	a.equiv_ccy = b.symbol
from
	#balances a,
	products b
where
	a.evaluation_currency_id = b.product_id
	
select
	@id = 0
select
	@ids = count(*)
from
	#balances
where

 	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#balances
	where
		id > @id

	select
		@spot_price = NULL,
		@days = NULL,
		@forward_price = NULL,
		@give_product_rate = NULL,
		@get_product_rate = NULL,
		@contract_id =NULL,
		@forward_date = NULL,
		@product_id = NULL

	select
		@contract_id = contract_id,
		@forward_date = value_date,
		@product_id = product_id
	from
		#balances
	where
		id = @id

	if @product_id != @evaluation_currency_id
	begin
		exec
			ag_fwdpricefromspotasof
				@contract_id = @contract_id,
				@as_of_date = @end_date,
				@forward_date = @forward_date,
				@spot_price = @spot_price output,
				@days = @days output,
				@forward_price = @forward_price output,
				@give_product_rate = @give_product_rate output,
		
 		@get_product_rate = @get_product_rate output

		update
			#balances
		set
			spot_price = @spot_price,
			days = @days,
			forward_price = @forward_price,
			currency_rate = @give_product_rate,
			product_rate = @get_product_rate
		where
			id = @id
	end
	else
	begin
		update
			#balances
		set
			forward_price = 1.0
		where
			id = @id
	end


	select
		@ids = count(*)
	from
		#balances
	where
		id > @id
end

update
	#balances
set
	balance = dbo.f_fmtqty(product, balance)

update
	#balances
set
	equiv = balance * forward_price
select
	@equiv = sum(equiv)
from
	#balances

insert into
	#balances(
		style,
		equiv)
values(
	@total_style,
	@equiv)

create table
	#date_equivs(
		id int identity,
		style varchar(250) NULL,
		value_date datetime NULL,
		equiv float NULL)
insert into
	#date_equivs(
		value_date,
		equiv)
select
	value_date,
	sum(equiv)
from
	#balances
where
	value_date != NULL
group by
	value_date
order by
	value_date
update
	#date_equivs
set
	style = @style

insert into
	#date_equivs(
		style,
 
		equiv)
values(
	@total_style,
	@equiv)

create table
	#product_equivs(
		id int identity,
		style varchar(250) NULL,
		product varchar(50) NULL,
		balance float NULL,
		equiv float NULL,
		product_id int NULL,
		limit numeric(30, 4) NULL,
		usage float NULL,
		notice_level float NULL,
		warning_level float NULL,
		blocked_level float NULL)

insert into
	#product_equivs(
		product_id,
		product,
		balance,
		equiv)
select
	product_id,
	product,
	sum(balance),
	sum(equiv)
from
	#balances
where
	product != NULL
group by
	product_id,
	product
order by
	product
update
	#product_equivs
set
	style = @style
insert into
	#product_equivs(
		style,
		equiv)
values(
	@total_style,
	@equiv)

update
	#product_equivs
set
	limit = b.nop_limit,
	notice_level = b.notice_level,
	warning_level = b.warning_level,
	blocked_level = b.blocked_level,
	usage = case when balance != 0 then abs(balance) / b.nop_limit else 0.0 end
from
        #product_equivs a,
        product_limits b
where
	a.product_id = b.product_id


select
	section = "Product Balances",
	style,
	product,
	value_date = convert(varchar(11), value_date),
	balance = dbo.f_fmtproductqty(product, balance),
	spot_price = case when product = "JPY" then 1/spot_price else spot_price end,
	days,
	forward_price = case when product = "JPY" then 1/forward_price else forward_price end,
	product_rate,
	currency_rate,
	equiv = dbo.f_fmtproductqty(equiv_ccy, equiv),
	equiv_ccy
from
	#balances
order by 
	id


select
	section = "Net By Product",
 	style,
	product,
	balance = dbo.f_fmtproductqty(product, balance),
	equiv = dbo.f_fmtproductqty(@evaluation_ccy, equiv),
	limit = limit,
	usage = usage,
	notice_level,
	warning_level,
	blocked_level
from
	#product_equivs
order by
	id

select
	section = "Net By Date",
	style,
	value_date = convert(varchar(11), value_date),
	equiv = dbo.f_fmtproductqty(@evaluation_ccy, equiv)
from
	#date_equivs
order by
	id


