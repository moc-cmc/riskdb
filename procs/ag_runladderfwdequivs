	NULL,
	NULL)

 
/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style ="background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Unable to determine evaluation currency"
	return
end

select
	@evaluation_ccy = symbol
from
	products
where
	product_id = @evaluation_currency_id
if @evaluation_ccy = NULL
begin
        select
                status = "Error",
                message = "Unable to set evaluation currency "
        return
end



select
	@tico_account_id =account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

if @run_name = NULL
begin
	select
		@run_name = name
	from
		funds
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run not found",
		run = @run_name
	return
end


create table
	#traders(
		trader_id int)
insert into
	#traders
select
