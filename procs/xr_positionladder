insert into
	#inventory_output(
		value_date,
		expiration,
		contract_id,
		contract,
		strike,
		product,
		quantity)
select
	value_date = convert(datetime, convert(varchar(11), value_date, 1)),
	expiration = convert(datetime, convert(varchar(11), value_date, 1)),
	contract_id,
	contract,
	strike = 0,
	product,
	quantity
from
	#output
order by
	value_date,
	product,
	contract
	
update
	#inventory_output
set
	a.expiration = b.expiration,
	a.strike = c.strike,
	a.put_call = c.put_call
from
	#inventory_output a,
	option_expirations b,
	option_contracts c
where
	a.contract_id = c.contract_id
and
	b.option_expiration_id = c.option_expiration_id


/* set the product for future contracts */
update
	#inventory_output
set
	a.product = b.symbol
from
	#inventory_output a,
	products b,
	forwards c,
	futures d,
	future_contracts e
where
	a.contract_id = e.contract_id
and
	e.future_id = d.future_id
and
	d.forward_id = c.contract_id
and
	c.product_id = b.product_id

/* set the product for spot options */
update
	#inventory_output
set
	a.product = b.symbol
from
	#inventory_output a,
	products b,
	option_contracts c,
	option_expirations d,
	options e,
	forwards f
where
	a.contract_id = c.contract_id
and
	c.option_expiration_id = d.option_expiration_id
and
	d.option_id = e.option_id
and
	e.underlying_contract_id = f.contract_id
and
	f.product_id = b.product_id


/* set the product for futures options */
update
	#inventory_output
set
	a.product = b.symbol
from
	#inventory_output a,
	products b,
	option_contracts c,
	option_expirations d,
	options e,
	future_contracts f,
	futures g,
	forwards h
where
	a.contract_id = c.contract_id
and
	c.option_expiration_id = d.option_expiration_id
and
	d.option_id = e.option_id
and
	e.underlying_contract_id = f.contract_id
and
	f.future_id = g.future_id
and
	g.forward_id = h.contract_id
and
	h.product_id = b.product_id



