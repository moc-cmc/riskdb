create table
	#sorted_exposure(
		id int identity,
		value_date datetime,
		product_id int,
		product varchar(50),
		net_exposure float NULL,
		adjusted_shorts float NULL,
		adjusted_longs float)

create table
	#exposure_output(
		id int identity,
		style varchar(100) NULL,
		value_date varchar(50) NULL,
		product varchar(100) NULL,
		net_exposure float NULL,
		adjusted_shorts float NULL,
		adjusted_longs float NULL)
		
select
	@running_longs = 0.0,
	@running_shorts = 0.0


if @sorting = "By Value Date"
begin
			
	insert into
		#sorted_exposure(
			value_date,
			product_id,
			product,
			net_exposure,
			adjusted_shorts,
			adjusted_longs)
	select
		b.value_date,
		a.product_id,
		a.symbol,
		b.net_exposure,
		adjusted_shorts = case when
			b.adjusted_exposure < 0
				then
					b.adjusted_exposure
				else
					0.0
		end,
		adjusted_longs = case when
			b.adjusted_exposure >= 0
				then
					b.adjusted_exposure
				else
					0.0
		end
	from
		products a,
		#net_exposure b
	where
		a.product_id = b.product_id
	order by
		b.value_date,
		a.symbol


	select
		@id = 0
	select
		@ids = count(*)
	from
		#sorted_exposure
	where
		id > @id

	while @ids > 0
	begin
		select
			@id = min(id)
		from
			#sorted_exposure
		where
			id > @id

		select
			@value_date = value_date
		from
			#sorted_exposure
		where
			id = @id

		insert into
			#exposure_output(
				value_date,
				product,
				net_exposure,
				adjusted_shorts,
				adjusted_longs)
		select
			convert(char(11), value_date, 1),
			product,
			net_exposure,
			adjusted_shorts,
			adjusted_longs
		from
			#sorted_exposure
		where
			value_date = @value_date
		order by
			id

		select
			@net_longs = sum(adjusted_longs),
			@net_shorts = sum(adjusted_shorts)
		from
			#sorted_exposure
		where
			value_date = @value_date

		insert into
			#exposure_output(
				style,
				value_date,
				adjusted_shorts,
				adjusted_longs)
		values(
			"background:#00FFFF;font-weight:bold",
			convert(char(11), @value_date, 1),
			@net_shorts,
			@net_longs)
			

		delete

		from
			#sorted_exposure
		where
			value_date = @value_date

		select
			@ids = count(*)
		from
			#sorted_exposure
		where
			id > @id
	end

	select
		@net_shorts = sum(adjusted_shorts),
		@net_longs = sum(adjusted_longs)
	from
		#exposure_output

	insert into
		#exposure_output(
			style,
			value_date,
			adjusted_shorts,
			adjusted_longs)
	values(
		"background:#FFFF66;font-weight:bold;font-size:200%",
		"Gross Total",
		@net_shorts,
		@net_longs)


	select
		style,
		value_date,
		product,
		net_exposure,
		adjusted_longs,
		adjusted_shorts,
		net_adjusted = adjusted_shorts + adjusted_longs
	from
		#exposure_output
	order by
		id
	
end
