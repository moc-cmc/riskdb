		underlying_price float NULL,
		adjusted_underlying float NULL,
		delta1 float NULL,
		close_price float NULL,
		native_exposure float NULL,
		counter_exposure float NULL,
		processing_status varchar(50))
insert into
	#trades
select
	a.trade_id,
	instrument = "Forward",
	a.trade_date,
	a.contract_id,
	a.value_date,
	b.product_id,
	product_rate = NULL,
	b.currency_id,
	currency_rate = NULL,
	a.quantity,
	a.price,
	b.quantity,
	underlying_price = NULL,
	adjusted_underlying = NULL,
	delta1 = NULL,
	close_price = NULL,
	native_exposure = NULL,
	counter_exposure = NULL,
	processing_status = "Incomplete"
from
	trades a,
	forwards b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#brokers f,
	#strategies g,
	#counterparties h
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	a.internal_account_id = d.internal_account_id
and
	a.trader_id = e.trader_id
and
	a.broker_id = f.broker_id
and
	a.strategy_id = g.strategy_id
and
	a.counterparty_id = h.counterparty_id
and
	a.trade_date < @end_date
and
	a.value_date >= @begin_date


insert into
	#trades
select
	a.trade_id,
	instrument = "Future",
	a.trade_date,
	a.contract_id,
	b.expiration,
	d.product_id,
	product_rate = NULL,
	d.currency_id,
	currency_rate = NULL,
	a.quantity,
	a.price,
	c.quantity,
	underlying_price = NULL,
	adjusted_underlying = NULL,
	delta1 = 1.0,
	close_price = NULL,
	native_exposure = NULL,
	counter_exposure = NULL,
	processing_status = "Incomplete"
from
	trades a,
	future_contracts b,
	futures c,
	forwards d,
	#external_accounts e,
	#internal_accounts f,
	#traders g,
	#brokers h,
	#strategies i,
	#counterparties j
where
	a.external_account_id = e.external_account_id
and
	a.internal_account_id = f.internal_account_id
and
	a.trader_id = g.trader_id
and
	a.broker_id = h.broker_id
and
	a.strategy_id = i.strategy_id
and
	a.counterparty_id = j.counterparty_id
and
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id
and
	c.forward_id = d.contract_id
and
	a.quantity != 0
and
	a.trade_date < @end_date
and
	b.expiration >= @begin_date

insert into
	#trades
select
	a.trade_id,
	instrument = "Option",
	a.trade_date,
	a.contract_id,
	e.expiration,
	g.product_id,
	product_rate = NULL,
	g.currency_id,
	currency_rate = NULL,
	a.quantity,
	a.price,
	f.quantity,
	underlying_price = NULL,
	adjusted_underlying = NULL,
	delta1 = NULL,
	close_price = NULL,
	native_exposure = NULL,
	counter_exposure = NULL,
	processing_status = "Incomplete"
from
	trades a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f,
	forwards g,
	#external_accounts h,
	#internal_accounts i,
	#traders j,
	#brokers k,
	#strategies l,
	#counterparties m
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.future_id = f.future_id
and
	f.forward_id = g.contract_id
and
	a.external_account_id = h.external_account_id
and
	a.internal_account_id = i.internal_account_id
and
	a.counterparty_id = m.counterparty_id
and
	a.trader_id = j.trader_id
and
	a.broker_id = k.broker_id
and
	a.strategy_id = l.strategy_id
and
	a.quantity != 0
and
	a.trade_date < @end_date
and
	c.expiration > @begin_date


insert into
	#trades
select
	a.trade_id,
	instrument = "Option",
	a.trade_date,
	a.contract_id,
	c.expiration,
	e.product_id,
	product_rate = NULL,
	e.currency_id,
	currency_rate = NULL,
	a.quantity,
	a.price,
	e.quantity,
	underlying_price = NULL,
	adjusted_underlying = NULL,
	delta1 = NULL,
	close_price = NULL,
	native_exposure = NULL,
	counter_exposure = NULL,
	processing_status = "Incomplete"
from
	trades a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e,
	#external_accounts f,
	#internal_accounts g,
	#traders h,
	#brokers i,
	#strategies j,
	#counterparties k
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	a.external_account_id = f.external_account_id
and
	a.internal_account_id = g.internal_account_id
and
	a.trader_id = h.trader_id
and
	a.broker_id = i.broker_id
and
	a.counterparty_id = k.counterparty_id
and
	a.strategy_id = j.strategy_id
and
	a.trade_date < @end_date
and
	c.expiration >= @begin_date


select
	@trade_id = 0
select
	@trades = count(*)
from
	#trades
where
	trade_id > @trade_id
and
	processing_status = "Incomplete"


while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#trades
	where
		trade_id > @trade_id
	and
		processing_status = "Incomplete"

	select
		@spot_price = NULL,
		@days = NULL,
		@forward_price = NULL,
		@give_product_rate = NULL,
		@get_product_rate = NULL,
		@perspective_contract_id = NULL,
		@delta1 = NULL,
		@trade_price = NULL

	select
		@instrument = instrument,
		@contract_id = contract_id,
		@value_date = value_date,
		@product_id = product_id,
		@currency_id = currency_id,
		@trade_price = price
	from
		#trades
	where
		trade_id = @trade_id

	if @instrument = "Forward"
	begin
		exec
			r_forwardpriceasof
				@contract_id,
				@end_date,
				@value_date,
				@days output,
				@spot_price output,
				@forward_price output,
				@give_product_rate output,
				@get_product_rate output

				
		select
			@delta1 = 1.0 / exp(@get_product_rate * (@days / 360.0))


		update
			#trades
		set
			close_price = @forward_price,
			underlying_price = @spot_price,
			delta1 = @delta1
		where
			contract_id = @contract_id
		and
			value_date = @value_date
	end

	if @instrument = "Future"
	begin
		select
			@price = NULL
		exec
			r_contractprice
				@contract_id,
				@end_date,
				@price output

		exec
			b_contractdelta
				@run_id,
				@end_date,
				@contract_id,
				1,
				@perspective_contract_id output,
				@delta1 output

		select
			@multiplier = multiplier
		from
			#trades
		where
			trade_id = @trade_id

		select
			@delta1 = @delta1 / @multiplier

		update
			#trades
		set
			close_price = @price,
			underlying_price = @price
		where
			contract_id = @contract_id
		and
			value_date = @value_date
	end
	if @instrument = "Option"
	begin
		select
			@underlying_contract_id = a.underlying_contract_id
		from
			options a,
			option_expirations b,
			option_contracts c
		where
			a.option_id = b.option_id
		and
			b.option_expiration_id = c.option_expiration_id
		and
			c.contract_id = @contract_id

		select
			@underlying_instrument = a.name
		from
			instruments a,
			contracts b
		where
			a.instrument_id = b.instrument_id
		and
			b.contract_id = @underlying_contract_id

		select
			@tv = NULL,
			@delta1 = NULL,
			@gamma = NULL,
			@theta = NULL,
			@tau = NULL

		exec
			r_contracttheoasof
				@contract_id,
				@end_date,
				@tv output,
				@delta1 output,
				@gamma output,
				@theta output,
				@tau output


		if @underlying_instrument = "Future"
		begin
			exec
				r_contractprice
					@underlying_contract_id,
					@end_date,
					@price output

		end
		if @underlying_instrument = "Forward"
		begin
			exec
				r_forwardpriceasof
					@underlying_contract_id,
					@end_date,
					@value_date,
					@days output,
					@price output,
					@forward_price output,
					@give_product_rate output,
					@get_product_rate output

		end

		update
			#trades
		set
			close_price = @tv,
			underlying_price = @price
		where
			contract_id = @contract_id
		and
			value_date = @value_date
	end


	exec
		r_contractproduct
			@contract_id,
			@product_id output

	exec
		r_rateasof
			@product_id,
			@end_date,
			@value_date,
			@get_product_rate output

	exec
		r_contractcurrency
			@contract_id,
			@currency_id output

	exec
		r_rateasof
			@currency_id,
			@end_date,
			@value_date,
			@give_product_rate output

	select
		@forward_id = contract_id
	from
		forwards
	where
		product_id = @product_id
	and
		currency_id = @currency_id

	exec
		r_priceasof
			@forward_id,
			@end_date,
			@underlying_price output

	update
		#trades
	set
		processing_status = "Complete",
		delta1 = @delta1,
		product_rate = @get_product_rate,
		currency_rate = @get_product_rate,
		underlying_price = @underlying_price
	where
		contract_id = @contract_id
	and
		value_date = @value_date

	select
		@trades = count(*)
	from
		#trades
	where
		trade_id > @trade_id
	and
		processing_status = "Incomplete"
end

update
	#trades
set
	a.adjusted_underlying = a.underlying_price * b.price
from
	#trades a,
	prices b,
	forwards c
where
	a.currency_id = c.product_id
and
	c.currency_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	b.price_date = @end_date

update
	#trades
set
	a.adjusted_underlying = a.underlying_price * (1.0 / b.price)
from
	#trades a,
	prices b,
	forwards c
where
	a.currency_id = c.currency_id
and
	c.product_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	b.price_date = @end_date
and
	a.adjusted_underlying = NULL

