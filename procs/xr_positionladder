create table
	#trade_balances(
		trade_id int,
		contract_id int,
		symbol varchar(50),
		quantity numeric(30,4),
		net_delta1 float NULL,
		value_date datetime,
		product_id int,
		product varchar(50),
		product_amount float NULL,
		currency_id int,
		currency varchar(50),
		currency_amount float NULL)
insert into
	#trade_balances
select
	a.trade_id,
	a.contract_id,
	d.symbol,
	a.quantity,
	net_delta1 = a.quantity * a.delta1,
	a.value_date,
	b.product_id,
	product = b.symbol,
	product_amount = native_exposure,
	c.product_id,
	currency = c.symbol,
	currency_amount = counter_exposure
from
	#trades a,
	products b,
	products c,
	contracts d
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id
and
	a.contract_id = d.contract_id

