create table
	#net_exposure(
		product_id int,
		value_date datetime,
		net_exposure float NULL,
		adjusted_price float NULL,
		adjusted_exposure float NULL)
insert into
	#net_exposure(
		product_id,
		value_date,
		net_exposure)
