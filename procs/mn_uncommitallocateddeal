drop procedure
	mn_uncommitallocateddeal
go

create procedure
	mn_uncommitallocateddeal
		@login varchar(50),
		@run_name varchar(50),
		@deal_id int
as

declare @external_account varchar(50)
declare @external_account_id int
declare @is_allocated varchar(1)

select
	@external_account = a.symbol
from
	external_accounts a,
	external_account_types b,
	trades c
where
	a.external_account_type_id = b.external_account_type_id
and
	a.external_account_id = c.external_account_id
and
	c.deal_id = @deal_id
and
	b.name = "Master"

exec
	cn_validateaccountaccess
		@login,
		@external_account,
		@external_account_id output

if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Deal not found"
	return
end


select
	@is_allocated = "Y"
from
	deal_ma_versions
where
	deal_id = @deal_id
and
	ma_version_id != 0


if @is_allocated = "Y"
begin
exec
	mn_setdealstatus
		@login,
		@deal_id,
		"Allocated"
end

if @is_allocated != "Y"
begin
	delete from
		deal_ma_versions
	where
		deal_id = @deal_id
exec
        mn_setdealstatus
                @login,
                @deal_id,
                "User Review"
end

exec
	mn_accounttrades
		@login,
		@run_name


go
