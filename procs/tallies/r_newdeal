drop procedure r_newdeal
go

create procedure 
	r_newdeal
		@deal_type varchar(50),
		@deal_status varchar(50)=NULL,
		@deal_id int=NULL output

as

declare @deal_type_id int
declare @deal_status_id int

if @deal_status = NULL
begin
	select
		@deal_status = "User Review"
end
select
	@deal_status_id = status_id
from
	statuses
where
	name = @deal_status
if @deal_status_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding deal status",
		provided = @deal_status
	return
end

select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = @deal_type
if @deal_type_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding deal type",
		provided = @deal_type
	return
end


if @deal_id = NULL
begin
	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals (
            		deal_id,
            		deal_type_id,
            		timestamp,
            		status_id)
	values(
        	@deal_id,
		@deal_type_id,
		getdate(),
        	@deal_status_id
    	)
    
end



go
