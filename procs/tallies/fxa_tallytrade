if object_id("fxa_tallytrade") != NULL
    drop procedure
        fxa_tallytrade
go

create procedure
	fxa_tallytrade
		@login char(25),
		@source varchar(50),
		@trade_id int output,
		@deal_id int output,
		@tally_type varchar(25),
		@deal_type varchar(50),
		@trade_type varchar(25),
		@internal_account varchar(50)=NULL,
		@external_account varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@quantity float,
		@symbol varchar(50),
		@value_date datetime,
		@price float,
		@trade_date datetime,
		@trader varchar(50)=NULL,
		@strategy varchar(50)=NULL,
		@status varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@identifier varchar(100)=NULL,
		@sales_code varchar(25)=NULL,
		@premium float=NULL,
		@premium_currency varchar(25)=NULL,
		@prem_settle_date datetime=NULL,
		@pct_price float=NULL,
		@spot_reference float=NULL,
		@fixing_date datetime=NULL,
		@mid_mark float=NULL,
		@trade_note varchar(255)=NULL

as

declare @source_id int
declare @tico_account_id int
declare @fund_id int
declare @tally_type_id int
declare @deal_type_id int
declare @trade_type_id int
declare @internal_account_id int
declare @external_account_id int
declare @counterparty_id int
declare @contract_id int 
declare @trader_id int
declare @strategy_id int
declare @broker_id int
declare @status_id int
declare @deal_status_id int
declare @price_style varchar(40)
declare @premium_currency_id int
declare @premium_transaction_type_id int
declare @account_transaction_id int
declare @quantity_sign float
declare @trades int
declare @sales_code_id int
declare @default_sales_code_id int
declare @client_user_id int
declare @aggregation_style varchar(25)
declare @aggregation_style_id int
declare @trade_day datetime
declare @account_status_id int
declare @readonly_status_id int
declare @strategy_ti_acct_id int
declare @is_fund_agency_trader char(1)
declare @external_account_type_id int
declare @external_account_type varchar(25)
declare @fund_sub_type varchar(50)

declare @start_time datetime
declare @end_time datetime
select
	@start_time = getdate()

if @trade_date in(NULL, "")
	select
		@trade_date = getdate()

/*
| Set trading day to EST 17:00-17:00 market standard
*/
if @trade_date > convert(char(8), @trade_date, 112) +' 17:00'
begin
        exec
                r_nextbusinessday
                        @trade_date,
                        @trade_day output
        select
                @trade_day = convert(date, @trade_day)
end
else
begin
        select
                @trade_day = convert(date, @trade_date)
end

if @value_date < @trade_day
begin
	select
		"error"="Error",
		"message"="Value date must be greater than or equal to trade date",
        	trade_date = @trade_date,
        	trade_day = @trade_day,
		value_date = @value_date
	return
end



if @mid_mark = 0.00
	select
		@mid_mark = NULL
if @trade_note = ""
	select
		@trade_note = NULL
select
    @deal_status_id = status_id
from
    statuses
where
    name = "User Review"

if @deal_status_id = NULL
begin
    select
        status = "Error",
        message = "No status found named, 'User Review'"
    return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id,
	@account_status_id = status_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login, '" + @login + "'",
        login = @login
	return
end

select
	@readonly_status_id = status_id
from
	statuses
where
	name = "Read Only"

if @account_status_id = @readonly_status_id
begin
	select
		status = "Error",
		message = "Can not tally trade. Login status is Read Only"
	return
end

select
	@tally_type_id = tally_type_id
from
	tally_types
where
	name = @tally_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Tally type not found",
		tally_type = @tally_type
	return
end


select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = @deal_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Deal type not found",
		deal_type = @deal_type
	return
end

select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = @trade_type
if @@rowcount != 1
begin
	insert into
		trade_types(
			name)
	values(
		@trade_type)
	select
		@trade_type_id = @@identity
end


if @trader not in("", NULL)
begin
	select
		@client_user_id = tico_account_id,
		@trader_id = trader_id,
		@default_sales_code_id = sales_code_id
	from
		traders
	where
		symbol = @trader
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end
end

if @client_user_id = NULL
	select
		@client_user_id = @tico_account_id

select
	@internal_account_id = internal_account_id,
	@external_account_id = external_account_id,
	@trader_id = trader_id,
	@strategy_id = strategy_id,
	@broker_id = broker_id,
	@status_id = status_id,
	@counterparty_id = counterparty_id
from
	default_tally_accounts
where
	tico_account_id = @client_user_id
and
	tally_type_id = @tally_type_id
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Trader has no tally defaults"
	return
end

if @default_sales_code_id = NULL
begin
	select
		@default_sales_code_id = sales_code_id
	from
		traders
	where
		trader_id = @trader_id
	if @default_sales_code_id = NULL
	begin
		select
			@default_sales_code_id = sales_code_id
		from
			sales_codes
		where
			name = "None"
	end
end

if @broker not in("", NULL)
begin
	select
		@broker_id = broker_id
	from
		brokers
	where
		symbol = @broker
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Broker not found",
			broker = @broker
		return
	end
end

/* we may want to remove this and let the api procs check.
 * there is still an index on trades that should address this
 */
if @identifier not in("", NULL)
begin
	if @trade_id = NULL
	begin
		select
			@trade_id = trade_id
		from
			trades
		where
			broker_id = @broker_id
		and
			identifier = @identifier

		if @trade_id != NULL
		begin
			select
				status = "Dupe",
				messsage = "Trade is already tallied",
				identifier = @identifier,
				trade_id = @trade_id
			return
		end
	end
end
	

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end


if @trader not in("", NULL)
begin
	select
		@trader_id = trader_id,
		@default_sales_code_id = sales_code_id
	from
		traders
	where
		symbol = @trader
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end
	select
		@is_fund_agency_trader = "Y"
	from
		fund_agency_traders
	where
		trader_id = @trader_id
end

/* If strategy provided, all good. If not:
     - if the trader is a fund agency trader, look up the tally defaults from the trader's assigned tico_account_id
     - if the trader is a client trader, look up the tally defaults from the @login provided
*/
if @strategy not in("", NULL)
begin
	select
		@strategy_id = strategy_id
	from
		strategies
	where
		name = @strategy
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Strategy not found",
			strategy = @strategy
		return
	end
end
else
begin
	if @is_fund_agency_trader = "Y"
	begin
		select
			@strategy_ti_acct_id = tico_account_id
		from
			traders
		where
			trader_id = @trader_id
	end
	else
	begin	
		select
			@strategy_ti_acct_id = account_id
		from
			tico_accounts
		where
			login = @login
	end

	select
		@strategy_id = strategy_id
	from
        	default_tally_accounts
	where
        	tico_account_id = @strategy_ti_acct_id
	and
        	tally_type_id = @tally_type_id
	
end

if @sales_code not in("", NULL)
begin
	select
		@sales_code_id = sales_code_id
	from
		sales_codes
	where
		name = @sales_code
	if @@rowcount != 1
	begin
		exec
			j_nextkey
				"sales_codes",
				@sales_code_id output
		insert into
			sales_codes(
				sales_code_id,
				name)
		values(
			@sales_code_id,
			@sales_code)
	end
end
else
begin
	select
		@sales_code_id = @default_sales_code_id
end

if @counterparty not in("", NULL)
begin
	select
		@counterparty_id = counterparty_id
	from
		counterparties
	where
		name = @counterparty
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Counterparty not found",
			counterparty = @counterparty
		return
	end
end

if @external_account not in("", NULL)
begin
	select
		@external_account_id = external_account_id,
		@aggregation_style_id = aggregation_style_id,
		@external_account_type_id = external_account_type_id
	from
		external_accounts
	where
		symbol = @external_account
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "External account not found",
			external_account = @external_account
		return
	end
end

if @internal_account not in("", NULL)
begin
	select
		@internal_account_id = internal_account_id
	from
		internal_accounts
	where
		symbol = @internal_account
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Internal account not found",
			internal_account = @internal_account
		return
	end
end

/* Check the aggregation style. If the aggregation style is not "None", then
 * override the @status_id of the trade to "Unaggregated". This can be
 * overridden by the @status parameter. */
select
    @aggregation_style = name
from
    aggregation_styles
where
    aggregation_style_id = @aggregation_style_id
    
if @aggregation_style != "None"
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name = "Unaggregated"
    
    if @status_id = NULL
    begin
		select
			status = "Error",
			message = "Status, 'Unaggregated', not found",
			status_name = "Unaggregated"
		return
    end
end

if @status not in("", NULL)
begin
	select
		@status_id = status_id
	from
		statuses
	where
		name = @status
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Status not found",
			status_name = @status
		return
	end
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

if @deal_type = "Option"
	exec
		r_contractvaluedate
			@contract_id,
			@trade_date,
			@value_date output


select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	b.contract_id = @contract_id
and
	b.price_style_id = a.price_style_id

if @price_style = "Inverted"
	select
		@price = 1.0 / @price,
                @spot_reference = 1.0 / @spot_reference

if @trade_id = NULL
begin
    exec
        j_nextkey
            "trades",
            @trade_id output
    
    if @identifier = NULL
        select
            @identifier = rtrim(@source) + " " + rtrim(convert(varchar(20), @trade_id))

end

if @deal_id = NULL
begin

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals (
            deal_id,
            deal_type_id,
            timestamp,
            status_id
        )
	values(
        @deal_id,
		@deal_type_id,
		getdate(),
        @deal_status_id
    )
    
end

select
	@premium_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Option Premium"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"transaction_types",
			@premium_transaction_type_id output

	insert into
		transaction_types(
			transaction_type_id,
			name,
			direction)
	values(
		@premium_transaction_type_id,
		"Option Premium",
		1)
end

if @premium != NULL
begin
	select
		@premium_currency_id = product_id
	from
		products
	where
		symbol = @premium_currency
	if @premium_currency_id = NULL
	begin
		select
			@premium_currency_id = evaluation_currency_id
		from
			funds
		where
			fund_id = @fund_id
		if @premium_currency_id = NULL
		begin
			select
				status = "Error",
				message = "Unable to resolve premium currency"
			return
		end
	end

	exec
		j_nextkey
			"account_transactions",
			@account_transaction_id output

	select
		@quantity_sign = sign(@quantity)

	select
		@premium = abs(@premium) * @quantity_sign * -1.0
end

begin tran

	insert into
		trades (
            		trade_id,
            		deal_id,
            		user_id,
            		trade_type_id,
            		internal_account_id,
            		external_account_id,
            		counterparty_id,
            		quantity,
            		contract_id,
            		value_date,
            		fixing_date,
            		price,
            		trade_date,
            		trader_id,
            		strategy_id,
            		status_id,
            		broker_id,
            		sales_code_id,
            		identifier,
            		pct_price,
            		spot_reference
        )
	values(
        	@trade_id,
		@deal_id,
		@tico_account_id,
		@trade_type_id,
		@internal_account_id,
		@external_account_id,
		@counterparty_id,
		@quantity,
		@contract_id,
		@value_date,
		@fixing_date,
		@price,
		@trade_date,
		@trader_id,
		@strategy_id,
		@status_id,
		@broker_id,
		@sales_code_id,
		@identifier,
		@pct_price,
		@spot_reference)
        
    if @@rowcount != 1
    begin
        rollback
		select
			status = "Error",
			message = "Failed to tally trade",
			status_name = "Unaggregated",
            		trade_id = @trade_id,
            		deal_id = @deal_id,
            		trade_type_id = @trade_type_id,
            		internal_account_id = @internal_account_id,
            		external_account_id = @external_account_id,
            		counterparty_id = @counterparty_id,
            		quantity = @quantity,
            		contract_id = @contract_id,
            		value_date = @value_date,
            		fixing_date = @fixing_date,
            		price = @price,
            		trade_date = @trade_date,
            		trader_id = @trader_id,
            		strategy_id = @strategy_id,
            		status_id = @status_id,
            		broker_id = @broker_id,
            		sales_code_id = @sales_code_id,
            		identifier = @identifier,
            		pct_price = @pct_price,
            		spot_reference = @spot_reference
		
	select 
		@trade_id = NULL,
		@deal_id = NULL
		
        return
    end

    
        
    if @premium != NULL
    begin
		select
			@fund_sub_type = name
		from
			fund_sub_types
		where
			fund_id = @fund_id

		if @fund_sub_type = "Prime of Prime"
		begin
			select
				@external_account_type = name
			from
				external_account_types
			where
				external_account_type_id = @external_account_type_id

			if @external_account_type = "Client"
			begin
				select
					@premium = @premium * -1
			end
		end
			
		insert into
			account_transactions (
            			account_transaction_id,
                		entered_by,
                		external_account_id,
                		transaction_type_id,
                		transaction_date,
                		currency_id,
                		amount,
                		note
            )
		values(
			@account_transaction_id,
			@tico_account_id,
			@external_account_id,
			@premium_transaction_type_id,
			@prem_settle_date,
            		@premium_currency_id,
			@premium,
			NULL)

		if @@rowcount != 1
                begin
                        rollback
                                select
                                        status = "Error",
                                        message = "Failed to add to account_transactions",
                                        trade_id = @trade_id,
                                        account_transaction_id = @account_transaction_id
                        return
                end

		insert into
			account_transaction_trades (
            			account_transaction_id,
                		trade_id,
                		conversion_rate)
		values(
			@account_transaction_id,
			@trade_id,
			1)

		if @@rowcount != 1
		begin
			rollback
                                select
                                        status = "Error",
                                        message = "Failed to add to account_transaction_trades",
                                        trade_id = @trade_id,
					account_transaction_id = @account_transaction_id
                        return
                end
	end

	if (@mid_mark != NULL  or @trade_note != NULL)
	begin
        	/* chriso: support for additional attributes for trades */
        	insert into
			trade_attributes(
				trade_id,
				mid_mark,
				note
		)
		values(
			@trade_id,
			@mid_mark,
			@trade_note
		)
        	if @@rowcount != 1
        	begin
                	rollback
                        	select
                                	status = "Error",
                                	message = "Failed to add additional trade attributes",
					trade_id = @trade_id,
					mid_mark = @mid_mark,
					note = @trade_note
			return
		end
	end

	insert into
		recent_identifiers(
					trade_id,
					broker_id,
					identifier
		)
	values(
			@trade_id,
			@broker_id,
			@identifier
	)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Failed to insert recent_identifier. Rolling back trade."
		rollback
		return
	end

    /*
    insert into
        trade_matches (
            trade_id
        )
    values (
        @trade_id
    )
    if @@rowcount != 1
    begin
        rollback
        select
            status = "Error",
            message = "Failed to insert into trade matches. Rolling back trade."
        return
    end
     */

commit tran

select
	@end_time = getdate()

exec 
	sp_dogstatsdtimer 
		@metric_name="ase.proc.fxa_tallytrade",
		@start_time=@start_time,
		@end_time=@end_time,
		@tags=NULL,
		@sample_rate="1.0"

go
