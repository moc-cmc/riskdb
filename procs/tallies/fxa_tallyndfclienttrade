drop procedure fxa_tallyndfclienttrade
go

create procedure
	fxa_tallyndfclienttrade	
		@login varchar(50),
		@tally_type varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@quantity numeric(30,4),
		@price float,
                @mid_mark float=NULL,
		@value_date datetime,
		@fixing_date datetime,
		@trade_note varchar(255)=NULL,
		@strategy varchar(50)=NULL,
		@trade_date datetime = NULL

as

declare @deal_id int
declare @trade_id int
declare @midmark_required char(1)

select
        @midmark_required = "Y"
from
        enabled_product_features
where
        name = "Midmark Tally Requirement"

if @midmark_required = "Y"
begin
        if @mid_mark = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade. Required field mid mark not provided"
                return
        end
end


exec api_tallyclienttrade
		@login=@login,
		@tally_type=@tally_type,
		@client_user=@client_user,
		@client_buys_sells=@client_buys_sells,
		@dealt_currency=@dealt_currency,
		@counter_currency=@counter_currency,
		@quantity=@quantity,
		@price=@price,
		@value_date=@value_date,
		@deal_id=@deal_id output,
		@trade_id=@trade_id output,
		@fixing_date=@fixing_date,
		@mid_mark=@mid_mark,
		@trade_note=@trade_note,
		@strategy=@strategy,
		@trade_date = @trade_date

exec
	r_inserttradenotification @trade_id
		
exec
	r_inspectdealtrades
		@login,
		@deal_id

go

