
create or replace procedure
	mc4_tallyclioptionsimple
		@login varchar(50)=NULL,
		@client_user varchar(50)=NULL,
		@client_buy_sell varchar(1)=NULL,
		@dealt_ccy varchar(10)=NULL,
		@counter_ccy varchar(10)=NULL,
		@strike varchar(20)=NULL,
		@call_put varchar(5)=NULL,
		@timezone varchar(50)=NULL,
		@expiration datetime=NULL,
		@option_settle datetime=NULL,
		@quantity numeric(30, 4)=NULL,
		@premium_ccy varchar(10)=NULL,
		@premium_amount numeric(30, 4)=NULL,
		@premium_settle datetime=NULL,
		@strategy varchar(50)=NULL,
		@trade_note varchar(255)=NULL,
		@trade_date datetime=NULL,
		@fixing_date datetime=NULL,
		@fixing_center varchar(50)=NULL
as


declare @trade_id int
declare @deal_id int

declare @quantity_string varchar(30)
declare @premium_amount_s varchar(30)

select
	@quantity_string = convert(varchar(30), @quantity),
	@premium_amount_s = convert(varchar(30), @premium_amount)



exec
        api_tallyclioptionsimple
                @login = @login,
		@client_user = @client_user,
                @client_buy_sell = @client_buy_sell,
                @dealt_ccy = @dealt_ccy,
                @counter_ccy = @counter_ccy,
                @strike = @strike,
                @call_put = @call_put,
                @timezone = @timezone,
                @expiration = @expiration,
                @option_settle = @option_settle,
                @quantity = @quantity_string,
                @premium_ccy = @premium_ccy,
                @premium_amount = @premium_amount_s,
                @premium_settle = @premium_settle,
                @strategy = @strategy,
                @trade_note = @trade_note,
                @trade_date = @trade_date,
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@fixing_date = @fixing_date,
		@fixing_center = @fixing_center


if @trade_id = NULL
begin
	select
		status = "Error",
		msg = "Could not tally trade"
	return
end

select
	status = "Success",
	trade_id = @trade_id,
	deal_id = @deal_id

exec
	r_inspectdealtrades
		@login,
		@deal_id

go 

