
create or replace procedure
	fxa_tallyndfb2bswap
		@login varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(20),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@near_date datetime,
		@near_fixing_date datetime,
		@client_near_price float,
		@client_near_mid float=NULL,
		@market_near_price float,
		@far_date datetime,
		@far_fixing_date datetime,
		@client_far_price float,
		@client_far_mid float=NULL,
		@market_far_price float,
		@client_near_note varchar(255)=NULL,
		@client_far_note varchar(255)=NULL,
		@market_near_note varchar(255)=NULL,
		@market_far_note varchar(255)=NULL,
		@strategy varchar(50)=NULL,
		@trade_date datetime=NULL,
		@fixing_center varchar(50)=NULL
as


declare @deal_id int
declare @midmark_required char(1)

select
        @midmark_required = "Y"
from
        enabled_product_features
where
        name = "Midmark Tally Requirement"

if @midmark_required = "Y"
begin
        if @client_near_mid = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade. Required field client near mid not provided"
                return
        end
        if @client_far_mid = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade. Required field client far mid not provided"
                return
        end
end


exec
	api_tallyb2bswap
		@login=@login,
		@client_user=@client_user,
		@client_buys_sells=@client_buys_sells,
		@counterparty=@counterparty,
		@quantity=@quantity,
		@dealt_currency=@dealt_currency,
		@counter_currency=@counter_currency,
		@near_date=@near_date,
		@client_near_price=@client_near_price,
		@market_near_price=@market_near_price,
		@far_date=@far_date,
		@client_far_price=@client_far_price,
		@market_far_price=@market_far_price,
		@deal_id=@deal_id output,
		@near_fixing_date=@near_fixing_date,
		@far_fixing_date=@far_fixing_date,
                @client_near_mid=@client_near_mid,
                @client_far_mid=@client_far_mid,
                @client_near_note=@client_near_note,
                @client_far_note=@client_far_note,
                @market_near_note=@market_near_note,
                @market_far_note=@market_far_note,
		@strategy=@strategy,
		@trade_date=@trade_date,
		@fixing_center=@fixing_center

	


exec
	r_inspectdealtrades
		@login,
		@deal_id




go 

