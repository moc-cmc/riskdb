
create or replace procedure
	fxa_tallyndfclientswap
		@login char(25),
		@client_user varchar(25),
		@client_buys_sells varchar(25),
		@quantity numeric(30,4),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@near_date datetime = NULL,
		@near_price float,
		@near_mid float=NULL,
		@near_fixing_date datetime,
		@far_date datetime = NULL,
		@far_price float,
		@far_mid float=NULL,
		@far_fixing_date datetime,
		@near_note varchar(255)=NULL,
		@far_note varchar(255)=NULL,
		@strategy varchar(50)=NULL,
		@trade_date datetime = NULL,
		@fixing_center varchar(50) = NULL
as


declare @deal_id int
declare @midmark_required char(1)

select
        @midmark_required = "Y"
from
        enabled_product_features
where
        name = "Midmark Tally Requirement"

if @midmark_required = "Y"
begin
        if @near_mid = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade. Required field near mid not provided"
                return
        end
        if @far_mid = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade. Required field far mid not provided"
                return
        end
end


exec api_tallyclientswap
		@login=@login,
		@client_user=@client_user,
		@client_buys_sells=@client_buys_sells,
		@quantity=@quantity,
		@dealt_currency=@dealt_currency,
		@counter_currency=@counter_currency,
		@near_date=@near_date,
		@near_price=@near_price,
		@far_date=@far_date,
		@far_price=@far_price,
		@deal_id=@deal_id output,
		@near_fixing_date=@near_fixing_date,
		@far_fixing_date=@far_fixing_date,
                @near_mid=@near_mid,
                @far_mid=@far_mid,
                @near_note=@near_note,
                @far_note=@far_note,
		@strategy=@strategy,
		@trade_date = @trade_date,
		@fixing_center = @fixing_center


exec
	r_inspectdealtrades
		@login,
		@deal_id


go 

