
create or replace procedure
	api_tallymarkettrade
		@login varchar(25),
		@tally_type varchar(25),
		@buy_sell varchar(5),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@counterparty_account varchar(100),
		@quantity numeric(30,2),
		@price float,
		@value_date datetime = NULL,
		@deal_id int output,
		@trade_id int output,
		@fixing_date datetime = NULL,
		@trade_note varchar(255)=NULL,
		@strategy varchar(50) = NULL,
		@trade_date datetime = NULL,
		@fixing_center varchar(50)=NULL
as


declare @symbol varchar(50)
declare @external_account varchar(50)
declare @sales_code varchar(50)
declare @trade_type varchar(25)
declare @contract_id int

if @buy_sell = "Sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @buy_sell = "Buy"
begin
	select
		@quantity = abs(@quantity)
end

select
	@external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty_account
	return
end


select
	@sales_code = "None"

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)

if @trade_date= NULL
select
	@trade_date = getdate()

select
    @contract_id = contract_id
from
    contracts
where
    symbol = @symbol
if @@rowcount != 1
begin

    declare @evaluation_currency varchar(50)
    declare @fund_id int

    exec
	r_defaultfundforlogin
		@login,
		@fund_id output

    select
	@evaluation_currency = a.symbol
    from
	products a,
	funds b
    where
	a.product_id = b.evaluation_currency_id

    exec r_addbatchfwdsubscription
	    @login,
	    @symbol,
	    @dealt_currency,
	    @counter_currency,
	    @evaluation_currency

    if not exists (select contract_id from contracts where symbol=@symbol)
    begin
	select
	    status = "Error",
	    message = "Contract not found",
	    symbol=@symbol

	return
    end

end


select
	@trade_type = @tally_type

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Market Forward",
		@trade_type = @trade_type,
		@external_account = @external_account,
		@counterparty = @counterparty_account,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@sales_code = @sales_code,
		@fixing_date = @fixing_date	,
		@strategy=@strategy,
		@trade_note = @trade_note,
		@trade_date = @trade_date,
		@fixing_center = @fixing_center


go 

