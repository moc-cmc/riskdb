
create or replace procedure
	api_tallyb2bswap
		@login varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(20),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@near_date datetime,
		@client_near_price float,
		@market_near_price float,
		@far_date datetime,
		@client_far_price float,
		@market_far_price float,
		@deal_id int output,
		@near_fixing_date datetime = NULL,
		@far_fixing_date datetime = NULL,
		@client_near_mid float=NULL,
		@client_far_mid float=NULL,
		@client_near_note varchar(255)=NULL,
		@client_far_note varchar(255)=NULL,
		@market_near_note varchar(255)=NULL,
		@market_far_note varchar(255)=NULL,
		@strategy varchar(50)=NULL,
		@trade_date datetime=NULL,
		@fixing_center varchar(50)=NULL
as


declare @tally_type varchar(20)
declare @client_external_account varchar(50)
declare @market_external_account varchar(50)
declare @trader varchar(25)
declare @symbol varchar(50)
declare @client_near_trade_id int
declare @market_near_trade_id int
declare @client_far_trade_id int
declare @market_far_trade_id int
declare @far_trade_id int
declare @client_near_quantity numeric(30,4)
declare @client_far_quantity numeric(30,4)
declare @market_near_quantity numeric(30,4)
declare @market_far_quantity numeric(30,4)
declare @market_sales_code varchar(50)
declare @client_swap_symbol_id int
declare @client_swap_symbol varchar(50)
declare @market_swap_symbol varchar(50)
declare @market_swap_symbol_id int
declare @trade_day datetime

/* 
With a swap/ndf swap, need to run a few checks on dates
      Far Date > Near Date >= Trade Date
      Near Fixing Date < Near Date
      Far Fixing Date < Far Date

chriso: not sure how fixing dates work on ndf swaps so not doing any check    
*/

if @trade_date in(NULL, "")
	select
		@trade_date = getdate()

/*
| Set trading day to EST 17:00-17:00 market standard
*/
if @trade_date > convert(char(8), @trade_date, 112) +' 17:00'
begin
        exec
                r_nextbusinessday
                        @trade_date,
                        @trade_day output
        select
                @trade_day = convert(date, @trade_day)
end
else
begin
        select
                @trade_day = convert(date, @trade_date)
end

if @near_date < @trade_day
begin
	select
		"error"="Error",
		"message"="Near date must be greater than or equal to trade date",
        	trade_date = @trade_date,
        	trade_day = @trade_day,
		near_date = @near_date
	return
end

if @far_date <= @near_date
begin
        select
                "error"="Error",
                "message"="Far date must be greater than near date",
                near_date = @near_date,
                far_date = @far_date
        return
end

if @far_fixing_date >= @far_date
begin
        select
                "error"="Error",
                "message"="Far fixing date must be less than far date",
                far_fixing_date = @far_fixing_date,
                far_date = @far_date
        return
end


if @near_fixing_date >= @near_date
begin
        select
                "error"="Error",
                "message"="Near fixing date must be less than than near date",
                near_fixing_date = @near_fixing_date,
                near_date = @near_date
        return
end



select
	@market_sales_code = "None"

select
	@tally_type = "Swap"

if @client_buys_sells = "Client Buys"
begin
	select
		@client_near_quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@client_near_quantity = abs(@quantity)
end

select
	@client_far_quantity = @client_near_quantity * -1.0

select
	@market_near_quantity = @client_near_quantity * -1.0,
	@market_far_quantity = @client_far_quantity * -1.0

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)


select
	@client_external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

select
	@market_external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end


select
	@trader = a.symbol
from
	traders a,
	tico_accounts b
where
	a.tico_account_id = b.account_id
and
	b.login = @login

if @trade_date = NULL
select
	@trade_date = getdate()


/*
 *  Tally all legs of the b2b swaps
 */ 

/* Tally the client near leg */
exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Near",
		@external_account = @client_external_account,
		@quantity = @client_near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@price = @client_near_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@fixing_date = @near_fixing_date,
		@mid_mark = @client_near_mid,
		@trade_note=@client_near_note,
		@strategy=@strategy,
		@fixing_center = @fixing_center


/* Tally the market near leg */
exec
	fxa_tallytrade
		@login,
		@source = "MPT Manual Tally",
		@trade_id = @market_near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Near",
		@external_account = @market_external_account,
		@counterparty = @counterparty,
		@quantity = @market_near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@price = @market_near_price,
		@trade_date = @trade_date,
		@sales_code = @market_sales_code,
		@fixing_date = @near_fixing_date,
		@trade_note=@market_near_note,
		@strategy=@strategy,
		@fixing_center = @fixing_center


/* Tally the client far leg */
exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Far",
		@external_account = @client_external_account,
		@quantity = @client_far_quantity,
		@symbol = @symbol,
		@value_date= @far_date,
		@price = @client_far_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@fixing_date = @far_fixing_date	,
                @mid_mark = @client_far_mid,
                @trade_note=@client_far_note,
		@strategy=@strategy,
		@fixing_center = @fixing_center



/* Tally the market far leg */
exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @market_far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Far",
		@external_account = @market_external_account,
		@counterparty = @counterparty,
		@quantity = @market_far_quantity,
		@symbol = @symbol,
		@value_date = @far_date,
		@price = @market_far_price,
		@trade_date = @trade_date,
		@sales_code = @market_sales_code,
		@fixing_date = @far_fixing_date,
                @trade_note=@market_far_note,
		@strategy=@strategy,
		@fixing_center = @fixing_center




/* 
 * Create and assign swap_symbols
 */

/* Create and assign market swap symbol */
exec
	j_nextkey
		"swap_symbols",
		@market_swap_symbol_id output
select
	@market_swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".M"

insert into
	swap_symbols
(
	swap_symbol_id,
	symbol,
	timestamp
)
values
(
	@market_swap_symbol_id,
	@market_swap_symbol,
	getdate()
)

/* Tie bothe legs to the swap symbol */
insert into 
	swap_symbol_trades
(
	swap_symbol_id,
	trade_id
)
values
(
	@market_swap_symbol_id,
	@market_near_trade_id
)
insert into 
	swap_symbol_trades
(
	swap_symbol_id,
	trade_id
)
values
(
	@market_swap_symbol_id,
	@market_far_trade_id
)

/* Create and assign client swap symbol */
exec
	j_nextkey
		"swap_symbols",
		@client_swap_symbol_id output
select
	@client_swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".C"

insert into
	swap_symbols
(
	swap_symbol_id,
	symbol,
	timestamp
)
values
(
	@client_swap_symbol_id,
	@client_swap_symbol,
	getdate()
)

/* Tie both legs to the swap symbol */
insert into 
	swap_symbol_trades
(
	swap_symbol_id,
	trade_id
)
values
(
	@client_swap_symbol_id,
	@client_near_trade_id
)
insert into 
	swap_symbol_trades
(
	swap_symbol_id,
	trade_id
)
values
(
	@client_swap_symbol_id,
	@client_far_trade_id
)





/*
 *  Notify all legs of the b2b swap
 */
exec
	r_inserttradenotification @market_far_trade_id
exec
	r_inserttradenotification @market_near_trade_id
exec
	r_inserttradenotification @client_near_trade_id
exec
	r_inserttradenotification @client_far_trade_id


go 

