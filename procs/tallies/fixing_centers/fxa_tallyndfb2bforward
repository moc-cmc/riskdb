
create or replace procedure
	fxa_tallyndfb2bforward
		@login varchar(50),
		@tally_type varchar(25),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@client_price float,
		@client_mid_mark float=NULL,
		@client_val_date datetime,
		@client_fixing_date datetime,
		@market_price float,
		@market_val_date datetime,
		@market_fixing_date datetime,
		@client_trade_note varchar(255)=NULL,
		@market_trade_note varchar(255)=NULL,
		@strategy varchar(50)=NULL,
		@trade_date datetime=NULL,
		@fixing_center varchar(50)=NULL
as


declare @deal_id int
declare @midmark_required char(1)

select
        @midmark_required = "Y"
from
        enabled_product_features
where
        name = "Midmark Tally Requirement"

if @midmark_required = "Y"
begin
        if @client_mid_mark = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade. Required field client mid mark not provided"
                return
        end
end


exec api_tallyb2bforward
			@login=@login,
			@tally_type=@tally_type,
			@client_user=@client_user,
			@client_buys_sells=@client_buys_sells,
			@counterparty=@counterparty,
			@quantity=@quantity,
			@dealt_currency=@dealt_currency,
			@counter_currency=@counter_currency,
			@client_price=@client_price,
			@client_val_date=@client_val_date,
			@market_price=@market_price,
			@market_val_date=@market_val_date,
			@deal_id = @deal_id output,
			@client_fixing_date=@client_fixing_date,
			@market_fixing_date=@market_fixing_date,
                	@client_mid_mark=@client_mid_mark,
                	@client_trade_note=@client_trade_note,
                	@market_trade_note=@market_trade_note,
			@strategy=@strategy,
			@trade_date=@trade_date,
			@fixing_center=@fixing_center


exec
	r_inspectdealtrades
		@login,
		@deal_id



go 

