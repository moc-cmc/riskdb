drop procedure fxa_tallyb2boption
go

create procedure
	fxa_tallyb2boption
		@login varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(25),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@biproduct varchar(50),
		@timezone varchar(25),
		@expiration datetime,
		@option_settlement datetime,
		@strike numeric(30,6),
		@call_put varchar(10),
		@implied_volatility float,
		@spot_reference float,
		@client_price float,
                @client_mid float=NULL,
		@client_format varchar(10),
		@client_total_premium float = NULL,
		@client_premium_currency varchar(25) = NULL,
		@client_premium_settle datetime = NULL,
		@market_price float,
		@market_format varchar(10),
		@market_total_premium float = NULL,
		@market_premium_currency varchar(25) = NULL,
		@market_premium_settle datetime = NULL,
		@client_trade_note varchar(255)=NULL,
                @market_trade_note varchar(255)=NULL,
		@strategy varchar(50)=NULL,
		@trade_date datetime=NULL

as

declare @deal_id int
declare @midmark_required char(1)

select
        @midmark_required = "Y"
from
        enabled_product_features
where
        name = "Midmark Tally Requirement"

if @midmark_required = "Y"
begin
        if @client_mid = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade. Required field client mid not provided"
                return
        end
end

if @call_put in('c','C', '0', 'CALL')
        select
                @call_put = 'C'

if @call_put in('p', 'P', '1', 'PUT')
        select
                @call_put = 'P'


exec 
	api_tallyb2boption
		@login=@login,
		@client_user=@client_user,
		@client_buys_sells=@client_buys_sells,
		@counterparty=@counterparty,
		@quantity=@quantity,
		@biproduct=@biproduct,
		@timezone=@timezone,
		@expiration=@expiration,
		@option_settlement=@option_settlement,
		@string=@strike,
		@call_put=@call_put,
		@implied_volatility=@implied_volatility,
		@spot_reference=@spot_reference,
		@client_price=@client_price,
		@client_format=@client_format,
		@client_premium=@client_total_premium,
		@client_premium_currency=@client_premium_currency,
		@client_premium_settle=@client_premium_settle,
		@market_price=@market_price,
		@market_format=@market_format,
		@market_premium=@market_total_premium,
		@market_premium_currency=@market_premium_currency,
		@market_premium_settle=@market_premium_settle,
		@deal_id=@deal_id output,
		@client_mid=@client_mid,
		@client_trade_note=@client_trade_note,
		@market_trade_note=@market_trade_note,
		@strategy=@strategy,
		@trade_date=@trade_date

exec
	r_inspectdealtrades
		@login,
		@deal_id

go
