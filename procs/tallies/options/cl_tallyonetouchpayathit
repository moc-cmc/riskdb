
drop procedure
	cl_tallyonetouchpayathit
go

create procedure
	cl_tallyonetouchpayathit
		@login varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@dealt_currency varchar(20),
		@counter_currency varchar(20),
		@spot_ref numeric(30,8),
		@rebate numeric(30,4),
		@notional_currency varchar(20),
		@timezone varchar(50),
		@expiration datetime,
		@exercise_style varchar(50),
		@option_settledate datetime,
		@barrier numeric(30,8),
		@barrier_direction varchar(30)=NULL,
		@payment_timing varchar(30),
		@window_start datetime,
		@window_end datetime,
		@premium numeric(30,4),
		@premium_ccy varchar(10),
		@premium_settledate datetime,
		@fixing_source varchar(50)=NULL,
		@trade_note varchar(100)

	
as

declare @deal_id int

exec
	api_clientonetouchpayathit
		@login = @login,
		@deal_id = @deal_id output,
		@client_user = @client_user,
		@client_buys_sells = @client_buys_sells,
		@dealt_currency = @dealt_currency,
		@counter_currency = @counter_currency,
		@spot_ref = @spot_ref,
		@rebate = @rebate,
		@notional_currency = @notional_currency,
		@timezone = @timezone,
		@expiration = @expiration,
		@exercise_style = @exercise_style,
		@option_settledate = @option_settledate,
		@barrier = @barrier,
		@barrier_direction = @barrier_direction,
		@payment_timing = @payment_timing,
		@window_start = @window_start,
		@window_end = @window_end,
		@premium = @premium,
		@premium_ccy = @premium_ccy,
		@premium_settledate = @premium_settledate,
		@fixing_source = @fixing_source,
		@trade_note = @trade_note

exec
	r_inspectdealtrades
		@login = @login,
		@deal_id = @deal_id

go	
