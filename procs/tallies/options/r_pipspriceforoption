drop procedure r_pipspriceforoption
go

create procedure 
	r_pipspriceforoption
		@dealt_ccy varchar(10),
		@counter_ccy varchar(10),
		@dealt_amount numeric(30, 4),
		@premium_ccy varchar(10),
		@premium_amount numeric(30, 4),
		@spot_reference float=NULL,
		@conversion_rate float=NULL,
		@pips_price float output

as



declare @standard_contract_id int
declare @contract_id int
declare @is_inverted char(1)
declare @now datetime
declare @begin_date datetime
declare @end_date datetime
declare @counter_amount numeric(30, 4)
declare @converted_premium numeric(30, 4)

if @counter_ccy = @premium_ccy
begin
	select
		@pips_price = abs(@premium_amount) / abs(@dealt_amount)
end
else if @dealt_ccy = @premium_ccy
begin
	/* convert the premium to the counter ccy then calculate pips price */
	select
		@contract_id = a.contract_id
	from
		contracts a,
		contract_price_styles b,
		price_styles c
	where
		a.contract_id = b.contract_id
	and
		b.price_style_id = c.price_style_id
	and
		c.name = "Inverted"
	and
		a.symbol = convert(char(3), @premium_ccy)+convert(char(3), @counter_ccy)
	if @contract_id = NULL
	begin
		select
			@contract_id = contract_id,
			@standard_contract_id = contract_id
		from
			contracts 
		where
			symbol = convert(char(3), @premium_ccy)+convert(char(3), @counter_ccy)
	end
	else
	begin
		select
			@is_inverted = "Y"
		select
			@standard_contract_id = contract_id
                from
                        contracts
                where
                        symbol = convert(char(3), @counter_ccy)+convert(char(3), @premium_ccy)
	end
	if @spot_reference = NULL
	begin
		select
			@spot_reference = price
		from
			current_prices
		where
			contract_id = @standard_contract_id
		if @spot_reference = NULL
		begin
			select
				@now = getdate()
			exec
				r_daterangefordate
					@now,
					@begin_date output,
					@end_date output	
			select
				@spot_reference = price
			from
				prices
			where
				contract_id = @standard_contract_id
			and
				price_date = @begin_date
			if @spot_reference = NULL
			begin
				/* couldnt find a spot price, return NULL, error handle in proc above */
				select
					@pips_price = NULL
				return
			end
		end
	end
	if @is_inverted = "Y"
	begin
		select
			@spot_reference = 1/@spot_reference
	end

	/* debug 
	select
		@contract_id, @standard_contract_id, @spot_reference
        */

	select
		@converted_premium = @premium_amount * @spot_reference
	select
                @pips_price = abs(@converted_premium) / abs(@dealt_amount)

end
else /* if premium ccy != dealt ccy or counter ccy */
begin
	select
		@contract_id = a.contract_id
	from
		contracts a,
		contract_price_styles b,
		price_styles c
	where
		a.contract_id = b.contract_id
	and
		b.price_style_id = c.price_style_id
	and
		c.name = "Inverted"
	and
		a.symbol = convert(char(3), @premium_ccy)+convert(char(3), @counter_ccy)
	if @contract_id = NULL
	begin
		select
			@contract_id = contract_id,
			@standard_contract_id = contract_id
		from
			contracts 
		where
			symbol = convert(char(3), @premium_ccy)+convert(char(3), @counter_ccy)
	end
	else
	begin
		select
			@is_inverted = "Y"

		select
			@standard_contract_id = contract_id
                from
                        contracts
                where
                        symbol = convert(char(3), @counter_ccy)+convert(char(3), @premium_ccy)
	end
	if @conversion_rate = NULL
	begin
		select
			@conversion_rate = price
		from
			current_prices
		where
			contract_id = @standard_contract_id
		if @conversion_rate = NULL
		begin
			select
				@now = getdate()
			exec
				r_daterangefordate
					@now,
					@begin_date output,
					@end_date output	
			select
				@conversion_rate = price
			from
				prices
			where
				contract_id = @standard_contract_id
			and
				price_date = @begin_date
			if @conversion_rate = NULL
			begin
				/* couldnt find a conversion rate, return NULL, error handle in proc above */
				select
					@pips_price = NULL
				return
			end
		end
	end
	if @is_inverted = "Y"
	begin
		select
			@conversion_rate = 1/@conversion_rate
	end
	/* debug
	select
		@contract_id, @standard_contract_id, @conversion_rate
        */


        select
                @converted_premium = @premium_amount * @conversion_rate
        select
                @pips_price = abs(@converted_premium) / abs(@dealt_amount)
end

go

