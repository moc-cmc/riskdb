create or replace procedure
	api_clienteuropeanbar
		@login varchar(50),
		@deal_id int output,
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@dealt_currency varchar(20),
		@counter_currency varchar(20),
		@put_call varchar(10),
		@spot_ref numeric(30,8),
		@strike numeric(30,8),
		@quantity numeric(30,4),
		@rebate numeric(30,4),
		@notional_currency varchar(20),
		@timezone varchar(50),
		@expiration datetime,
		@exercise_style varchar(50),
		@option_settledate datetime,
		@barrier numeric(30,8),
		@barrier_direction varchar(30)=NULL,
		@payment_timing varchar(30),
		@window_start datetime,
		@window_end datetime,
		@premium numeric(30,4),
		@premium_ccy varchar(10),
		@premium_settledate datetime,
		@fixing_source varchar(50),
		@trade_note varchar(100)

	
as

declare @option_expiration_id int
declare @expiration_symbol varchar(100)
declare @exercise_style_id int

declare @status varchar(50)
declare @string_value varchar(50)
declare @window_start_string varchar(25)
declare @window_end_string varchar(25)
declare @direction_name varchar(50)
declare @contract_id int
declare @symbol varchar(50)
declare @instrument_id int
declare @exotic_instrument_id int
declare @trade_date datetime
declare @trade_id int
declare @timing_attribute_id int
declare @fix_source_attr_id int
declare @barrier_location varchar(5)
declare @barrier_dir_attr_id int
declare @barrier_loc_attr_id int
declare @barrier_val_attr_id int
declare @window_start_attr_id int
declare @window_end_attr_id int
declare @rebate_ccy_attr_id int
declare @rebate_amt_attr_id int
declare @settledate_attr_id int
declare @timezone_symbol varchar(50)
declare @event_text varchar(255)


select
	@trade_date = getdate()

select
	@payment_timing = upper(convert(varchar(1), @payment_timing))

select
	@exercise_style_id = exercise_style_id
from
	exercise_styles
where
	name = @exercise_style
if @exercise_style_id = NULL
begin
	select
		status = "Error",
		message = "Exercise style not found",
		exercise_style = @exercise_style
	return
end


select
	@exotic_instrument_id = exotic_instrument_id
from
	exotic_instruments
where
	name = "Digital"
if @exotic_instrument_id = NULL
begin
	select
		status = "Error",
		message = "Exotic instrument Digital not found"
	return
end

exec
	ag_exoticexpiration
		@dealt_currency = @dealt_currency,
		@counter_currency = @counter_currency,
		@expiration = @expiration,
		@exercise_style = @exercise_style,
		@timezone = @timezone,
		@option_expiration_id = @option_expiration_id output,
		@symbol = @expiration_symbol output

select
	@symbol = @expiration_symbol + " ED " + convert(varchar(1), @exercise_style)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		@instrument_id = instrument_id
	from
		instruments
	where
		name = "Exotic"
	if @instrument_id = NULL
	begin
		select
			status = "Error",
			message = "Exotic instrument not found"
		return
	end

	
	exec
		j_nextkey
			"contracts",
			@contract_id output

	begin tran
		insert into
			contracts(
				contract_id,
				symbol,
				instrument_id)
		values(
			@contract_id,
			@symbol,
			@instrument_id)
		if @@rowcount != 1
		begin	
			select
				status = "Error",
				message = "Unable to add contract",
				symbol = @symbol
			rollback tran
			return
		end

		insert into
			exotic_contracts(
				contract_id,
				option_expiration_id,
				exotic_instrument_id,
				exercise_style_id)
		values(
			@contract_id,
			@option_expiration_id,
			@exotic_instrument_id,
			@exercise_style_id)
		if @@rowcount = 0
		begin
			select
				status = "Error",
				message = "Unable to add exotic contract",
				symbol = @symbol
			rollback tran
			return
		end
	commit tran
end
		
/* Create the exotic trade attributes */
select
	@fix_source_attr_id = attribute_type_id
from
	attribute_types
where
	name = "Fixing Source"
if @fix_source_attr_id = NULL
begin
	select
		status = "Error",
		message = "Fixing source attribute type not found"
	return
end

select
	@timing_attribute_id = attribute_type_id
from
	attribute_types
where
	name = "Timing"
if @timing_attribute_id = NULL
begin
	select
		status = "Error",
		message = "Timing attribute type not found"
	return
end

select
	@barrier_loc_attr_id = attribute_type_id
from
	attribute_types
where
	name = "Barrier Location"
if @barrier_loc_attr_id = NULL
begin
	select
		status = "Error",
		message = "Barrier Location attribute type not found"
	return
end

if @barrier > @spot_ref
begin
	select
		@barrier_location = "U"

	select
		@barrier_val_attr_id = attribute_type_id
	from
		attribute_types
	where
		name = "Upper Barrier"
	if @barrier_val_attr_id = NULL
	begin
		select
			status = "Error",
			message = "Upper Barrier attribute type not found"
		return
	end
end
if @barrier < @spot_ref 
begin
	select
		@barrier_location = "D"

	select
		@barrier_val_attr_id = attribute_type_id
	from
		attribute_types
	where
		name = "Lower Barrier"
	if @barrier_val_attr_id = NULL
	begin
		select
			status = "Error",
			message = "Upper Barrier attribute type not found"
		return
	end
end

if @barrier_location = "U"
	select
		@window_start_string = "Upper Window Start",
		@window_end_string = "Upper Window End"
else
	select
		@window_start_string = "Lower Window Start",
		@window_end_string = "Lower Window End"


if @barrier_direction in("Up and In", "Down and In")
	select
		@direction_name = "I"
if @barrier_direction in("Up and Out", "Down and Out")
	select
		@direction_name = "O"
if @direction_name = NULL
begin
	select
		status = "Error",
		message = "Barrier direction not found",
		barrier_direction = @barrier_direction
	return
end

select
	@barrier_dir_attr_id = attribute_type_id
from
	attribute_types
where
	name = "Barrier Direction"
if @barrier_dir_attr_id = NULL
begin
	select
		status = "Error",
		message = "Barrier Direction attribute type not found"
	return
end


select
	@window_start_attr_id = attribute_type_id
from
	attribute_types
where
	name = @window_start_string
if @window_start_attr_id = NULL
begin
	select
		status = "Error",
		message = "Window Start attribute type not found",
		window_start_string = @window_start_string
	return
end

select
	@window_end_attr_id = attribute_type_id
from
	attribute_types
where
	name = @window_end_string
if @window_end_attr_id = NULL
begin
	select
		status = "Error",
		message = "Window End attribute type not found",
		window_end_string = @window_end_string
	return
end
			
			
select
	@rebate_ccy_attr_id = attribute_type_id
from
	attribute_types
where
	name = "Rebate Currency"
if @rebate_ccy_attr_id = NULL
begin
	select
		status = "Error",
		message = "Rebate Currency attribute type not found"
	return
end
			
select
	@rebate_amt_attr_id = attribute_type_id
from
	attribute_types
where
	name = "Rebate Amount"
if @rebate_amt_attr_id = NULL
begin
	select
		status = "Error",
		message = "Rebate Amount attribute type not found"
	return
end 

select
	@settledate_attr_id = attribute_type_id
from
	attribute_types
where
	name = "Option Settlement Date"
if @settledate_attr_id = NULL
begin
	select
		status = "Error",
		message = "Option Settlement Date attribute type not found"
	return
end

if @client_buys_sells = "Client Buys"
	select
		@rebate = @rebate * -1.0
else
	select
		@rebate = abs(@rebate)

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Option",
		@deal_type = "Client Option",
		@trade_type = "Option",
		@quantity = @rebate,
		@symbol = @symbol,
		@value_date = @option_settledate,
		@price = @spot_ref,
		@trade_date = @trade_date,
		@trader = @client_user,
		@premium = @premium,
		@premium_currency = @premium_ccy,
		@prem_settle_date = @premium_settledate,
		@spot_reference = @spot_ref

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@timing_attribute_id,
	@payment_timing)

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@window_start_attr_id,
	@window_start)

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@window_end_attr_id,
	@window_end)

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@barrier_loc_attr_id,
	@barrier_location)

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@barrier_dir_attr_id,
	@direction_name)

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@barrier_val_attr_id,
	convert(varchar(30), @barrier))

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@rebate_ccy_attr_id,
	convert(varchar(30), @notional_currency))


insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@rebate_amt_attr_id,
	convert(varchar(30), @rebate))

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@settledate_attr_id,
	convert(varchar(30), @option_settledate))

if @fixing_source != NULL
begin
	insert into
		exotic_trade_attributes(
			trade_id,
			attribute_type_id,
			value)
	values(
		@trade_id,
		@fix_source_attr_id,
		@fixing_source)
end


select
        @status = NULL,
        @string_value = @put_call

exec
        u_addattributetoexotic
                @trade_id = @trade_id,
                @attribute_name = "Put Call",
                @value = @string_value,
                @status = @status output

select
        @status = NULL,
        @string_value = convert(varchar(30), @strike)

exec
        u_addattributetoexotic
                @trade_id = @trade_id,
                @attribute_name = "Strike",
                @value = @string_value,
                @status = @status output

select
	@status = NULL,
	@string_value = "BARR"

exec
        u_addattributetoexotic
                @trade_id = @trade_id,
                @attribute_name = "Exotic Type",
                @value = @string_value,
                @status = @status output


select
	@status = NULL,
	@string_value = convert(varchar(30), abs(@quantity))
exec
        u_addattributetoexotic
                @trade_id = @trade_id,
                @attribute_name = "Notional",
                @value = @string_value,
                @status = @status output
	
select
	@status = NULL,
	@string_value = convert(varchar(30), abs(@strike * @quantity))
exec
        u_addattributetoexotic
                @trade_id = @trade_id,
                @attribute_name = "Counter Amount",
                @value = @string_value,
                @status = @status output
	


exec
	r_inserttradenotification
		@trade_id

select
        @event_text = rtrim(@symbol) +" @slack-exotic-booking booked by "+rtrim(@login)
exec
        sp_dogstatsdevent
                @event_title = "Exotic Booking",
                @event_text = @event_text,
                @tags = "user_action:manual tally"

go
