drop procedure mc4_tallyb2bexotickoki
go

create procedure
	mc4_tallyb2bexotickoki
		@login varchar(50)=NULL,
		@client_user varchar(50)=NULL,
		@client_buy_sell varchar(1)=NULL,
		@counterparty varchar(50)=NULL,
		@dealt_ccy varchar(10)=NULL,
		@counter_ccy varchar(10)=NULL,
		@strike varchar(20)=NULL,
		@call_put varchar(5)=NULL,
		@timezone varchar(50)=NULL,
		@expiration datetime=NULL,
		@option_settle datetime=NULL,
		@quantity numeric(30, 4)=NULL,
		@premium_settle datetime=NULL,
		@client_premium_ccy varchar(10)=NULL,
		@client_premium_amount numeric(30, 4)=NULL,
		@market_premium_ccy varchar(10)=NULL,
		@market_premium_amount numeric(30, 4)=NULL,
                @exotic_instrument varchar(25)=NULL,
                @timing varchar(25)=NULL,
                @payout_ccy varchar(10)=NULL,
                @payout_amount numeric(30, 4)=NULL,
                @barrier_type varchar(25)=NULL,
                @barrier varchar(25)=NULL,
                @lower_barrier varchar(25)=NULL,
                @upper_barrier varchar(25)=NULL,
                @exercise_style varchar(30)=NULL,
		@strategy varchar(50)=NULL,
		@market_trade_note varchar(255)=NULL,
		@client_trade_note varchar(255)=NULL,
		@trade_date datetime=NULL,
		@fixing_date datetime=NULL


as

declare @cl_trade_id int
declare @mkt_trade_id int
declare @deal_id int
declare @show_inspector char(1)

declare @quantity_string varchar(30)
declare @market_premium_amount_s varchar(30)
declare @client_premium_amount_s varchar(30)

select
	@quantity_string = convert(varchar(30), @quantity),
	@market_premium_amount_s = convert(varchar(30), @market_premium_amount),
	@client_premium_amount_s = convert(varchar(30), @client_premium_amount)
exec
        api_tallyb2bexoticsimple
                @login = @login,
		@client_user = @client_user,
                @client_buy_sell = @client_buy_sell,
		@counterparty = @counterparty,
                @dealt_ccy = @dealt_ccy,
                @counter_ccy = @counter_ccy,
                @strike = @strike,
                @call_put = @call_put,
                @timezone = @timezone,
                @expiration = @expiration,
                @option_settle = @option_settle,
                @quantity = @quantity_string,
                @premium_settle = @premium_settle,
                @client_premium_ccy = @client_premium_ccy,
                @client_premium_amount = @client_premium_amount_s,
                @market_premium_ccy = @market_premium_ccy,
                @market_premium_amount = @market_premium_amount_s,
                @exotic_instrument = @exotic_instrument,
                @timing = @timing,
                @payout_ccy = @payout_ccy,
                @payout_amount = @payout_amount,
                @barrier_type = @barrier_type,
                @barrier = @barrier,
                @lower_barrier = @lower_barrier,
                @upper_barrier = @upper_barrier,
                @exercise_style = @exercise_style,
                @strategy = @strategy,
                @client_trade_note = @client_trade_note,
                @market_trade_note = @market_trade_note,
                @trade_date = @trade_date,
		@cl_trade_id = @cl_trade_id output,
		@mkt_trade_id = @mkt_trade_id output,
		@deal_id = @deal_id output,
		@fixing_date = @fixing_date


if @cl_trade_id = NULL
begin
	select
		status = "Error",
		msg = "Could not tally client trade"
	return
end
if @mkt_trade_id = NULL
begin
	select
		status = "Error",
		msg = "Could not tally market trade"
	return
end


select
	status = "Success",
	mkt_trade_id = @mkt_trade_id,
	cl_trade_id = @cl_trade_id,
	deal_id = @deal_id


if @show_inspector != "N"
begin
	exec
		r_inspectdealtrades
			@login=@login,
			@deal_id=@deal_id
end

go
