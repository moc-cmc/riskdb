use
	risk_makr_dev
go

drop procedure
	api_b2bsinglebarrier
go

create procedure
	api_b2bsinglebarrier
		@login varchar(50),
		@deal_id int output,
		@client_user varchar(50),
		@counterparty varchar(50),
		@client_buys_sells varchar(50),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@put_call varchar(10),
		@quantity numeric(30,4),
		@notional_currency varchar(50),
		@spot_ref numeric(30,8),
		@strike numeric(30,8),
		@barrier numeric(30,8),
		@barrier_direction varchar(25),
		@exercise_style varchar(25),
		@expiration datetime,
		@option_settledate datetime,
		@timezone varchar(50),
		@client_premium numeric(30,8),
		@market_premium numeric(30,8),
		@premium_ccy varchar(50),
		@premium_settledate datetime,
		@fixing_source varchar(50),
		@trade_note varchar(100)=NULL
as

declare @buy_sells varchar(50)

if @client_buys_sells = "Client Buys"
	select
		@buy_sells = "Buy"
else
	select
		@buy_sells = "Sell"

exec
	api_clientsinglebarrier
		@login = @login,
		@deal_id = @deal_id output,
		@client_user = @client_user,
		@client_buys_sells = @client_buys_sells,
		@dealt_currency = @dealt_currency,
		@counter_currency = @counter_currency,
		@put_call = @put_call,
		@quantity = @quantity,
		@notional_currency = @notional_currency,
		@spot_ref = @spot_ref,
		@strike = @strike,
		@barrier = @barrier,
		@barrier_direction = @barrier_direction,
		@exercise_style = @exercise_style,
		@expiration = @expiration,
		@option_settledate = @option_settledate,
		@timezone = @timezone,
		@premium = @client_premium,
		@premium_ccy = @premium_ccy,
		@premium_settledate = @premium_settledate,
		@fixing_source = @fixing_source,
		@trade_note = @trade_note


exec
	api_marketsinglebarrier
		@login = @login,
		@deal_id = @deal_id,
		@counterparty = @counterparty,
		@buys_sells = @buy_sells,
		@dealt_currency = @dealt_currency,
		@counter_currency = @counter_currency,
		@put_call = @put_call,
		@quantity = @quantity,
		@notional_currency = @notional_currency,
		@spot_ref = @spot_ref, 
		@strike = @strike,
		@barrier = @barrier,
		@barrier_direction = @barrier_direction,
		@exercise_style = @exercise_style,
		@expiration = @expiration,
		@option_settledate = @option_settledate,
		@timezone = @timezone,
		@premium = @market_premium,
		@premium_ccy = @premium_ccy,
		@premium_settledate = @premium_settledate,
		@fixing_source = @fixing_source,
		@trade_note = @trade_note


go


