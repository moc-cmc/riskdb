create or replace procedure
	api_tallyexoticoptionsimple
		@login varchar(50)=NULL,
		@buy_sell varchar(1)=NULL,
		@dealt_ccy varchar(10)=NULL,
		@counter_ccy varchar(10)=NULL,
		@strike varchar(20)=NULL,
		@call_put varchar(5)=NULL,
		@timezone varchar(50)=NULL,
		@expiration datetime=NULL,
		@option_settle datetime=NULL,
		@quantity varchar(20)=NULL,
		@premium_ccy varchar(10)=NULL,
		@premium_amount varchar(20)=NULL,
		@premium_settle datetime=NULL,
		@exotic_instrument varchar(25)=NULL,
		@timing varchar(25)=NULL,
                @payout_ccy varchar(10)=NULL,
                @payout_amount numeric(30, 4)=NULL,
		@barrier_type varchar(25)=NULL,
		@barrier varchar(25)=NULL,
		@lower_barrier varchar(25)=NULL,
		@upper_barrier varchar(25)=NULL,
                @window_start datetime=NULL,
                @window_end datetime=NULL,
		@exercise_style varchar(30)=NULL,
		@cl_or_lp char(2)=NULL,
		@counterparty varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@vol float=NULL,
		@spot_reference float=NULL,
		@conversion_rate float=NULL,
		@strategy varchar(50)=NULL,
		@trade_note varchar(255)=NULL,
		@trade_date datetime=NULL,
		@deal_type varchar(50)=NULL,
		@fixing_date datetime=NULL,
		@source varchar(25)=NULL,
		@deal_id int=NULL output,
		@trade_id int=NULL output


as

declare @barrier_subtype char(4)
declare @american_barrier char(1)

select
	@american_barrier = "N"

if @exotic_instrument in(NULL, "")
begin
        select
                status = "Error",
                msg = "Must provide value for exotic instrument",
                provided = @exotic_instrument
        return
end

if @login in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for login",
		provided = @login
	return
end
if @buy_sell not in("B", "S")
begin
	select
		status = "Error",
		msg = "Must provide value for buy_sell as 'B' or 'S'",
		provided = @buy_sell
	return
end
if @cl_or_lp not in("LP", "CL")
begin
	select
		status = "Error",
		msg = "Must provie value for cl_or_lp as 'CL' or 'LP'",
		provided = @cl_or_lp
	return
end
if @cl_or_lp = "LP" and @counterparty in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for counterparty for LP trade",
		provided = @counterparty
	return
end
if @cl_or_lp = "CL" and @trader in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for trader for CL trade",
		provided = @trader
	return
end
if @timezone in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for timezone",
		provided = @timezone
	return
end
if @expiration in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for expiration",
		provided = @expiration
	return
end
if @option_settle in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for option_settle. This is the expiration of the exercise if the option is ITM",
		provided = @option_settle
	return
end
if @quantity in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for quantity",
		provided = @quantity
	return
end
if @premium_ccy in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for premium_ccy",
		provided = @premium_ccy
	return
end
if @premium_amount in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for premium_amount",
		provided = @premium_amount
	return
end
if @premium_settle in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide value for premium_settle",
		provided = @premium_settle
	return
end

if @spot_reference = NULL
begin
	select
		status = "Error",
		msg = "Must provide spot reference"
	return
end


if not exists(select timezone_id from timezones where timezone = @timezone)
begin
        select
                status = "Error",
                msg = "Must provide valid timezone",
                provided = @timezone
        return
end


if not exists(select product_id from products where symbol = @dealt_ccy)
begin
	select
		status = "Error",
		msg = "Must provide valid dealt currency",
		provided = @dealt_ccy
	return
end
if not exists(select product_id from products where symbol = @counter_ccy)
begin
	select
		status = "Error",
		msg = "Must provide valid counter currency",
		provided = @counter_ccy
	return
end
if not exists(select deal_type_id from deal_types where name = @deal_type)
begin
	select
		status = "Error",
		msg = "Must provide valid deal type",
		provided = @deal_type
	return
end

if @exercise_style in("", NULL)
begin
	select
		status = "Error",
		msg = "Must provide an exercise style"
end
else
begin
	if not exists(select exercise_style_id from exercise_styles where name = @exercise_style)
	begin
		select
			status = "Error",
			msg = "Must provide a valid exercise style",	
			provied = @exercise_style
		return
	end
end


if @trade_date= NULL
select
        @trade_date = getdate()

if convert(date,  @premium_settle) < convert(date, @trade_date)
begin
	select
		status = "Error",
		msg = "Premium settle date can not be less than the trade date",
		provided = "trade date: "+rtrim(convert(varchar(8), convert(date, @trade_date), 112))+" premium date: "+rtrim(convert(varchar(8), convert(date, @premium_settle), 112))
	return
end
if convert(date,  @expiration) < convert(date, @trade_date)
begin
	select
		status = "Error",
		msg = "Expiration can not be less than the trade date",
		provided = "trade date: "+rtrim(convert(varchar(8), convert(date, @trade_date), 112))+" expiration date: "+rtrim(convert(varchar(8), convert(date, @expiration), 112))
	return
end
if(@fixing_date not in("", NULL) and convert(date,  @fixing_date) < convert(date, @trade_date))
begin
        select
                status = "Error",
                msg = "Fixing date can not be less than the trade date",
                provided = "trade date: "+rtrim(convert(varchar(8), convert(date, @trade_date), 112))+" fixing date: "+rtrim(convert(varchar(8), convert(date, @fixing_date), 112))
        return
end
if convert(date, @option_settle) < convert(date, @expiration)
begin
	select
		status = "Error",
		msg = "Option settle date can not be less than expiration. This is the expiration of an exercise if the option is ITM",
		provided = "Expiration: "+rtrim(convert(varchar(8), convert(date, @expiration), 112))+" option settle date: "+rtrim(convert(varchar(8), convert(date, @option_settle), 112))
	return
end


if (@window_start not in("",  NULL) and @window_end in("", NULL)) or (@window_start in("", NULL) and @window_end not in("", NULL)) 
begin
	select
		status = "Error",
		msg = "Must provide both a window start and window end when specifying either. Otherwise leave both blank",
		provided = "window_start: "+rtrim(convert(varchar(8), convert(date, @window_start), 112))+" window_end: "+rtrim(convert(varchar(8), convert(date, @window_start), 112))
	return
end

if @window_start not in("",  NULL) and @window_end not in("", NULL)
begin
	if @window_end < @window_start
	begin
		select
			status = "Error",
			msg = "Window start date can not be prior to window end date",
                	provided = "window_start: "+rtrim(convert(varchar(8), convert(date, @window_start), 112))+" window_end: "+rtrim(convert(varchar(8), convert(date, @window_start), 112))
		return
	end

	if convert(date,  @window_start) < convert(date, @trade_date)
	begin
        	select
                	status = "Error",
                	msg = "Window start can not be less than the trade date",
                	provided = "trade date: "+rtrim(convert(varchar(8), convert(date, @trade_date), 112))+" window start: "+rtrim(convert(varchar(8), convert(date, @window_start), 112))
        	return
	end

	/* we now have barrier windows provided */
	if convert(date, @window_start) != convert(date, @expiration)
	begin
		select
			@american_barrier = "Y"
	end
	if convert(date, @window_end) > convert(date, @expiration)
	begin
                select
                        status = "Error",
                        msg = "Window end can not be greater than the expiration",
                        provided = "expirations: "+rtrim(convert(varchar(8), convert(date, @expiration), 112))+" window end: "+rtrim(convert(varchar(8), convert(date, @window_end), 112))
                return
	end
end


if @barrier not in(NULL, "") and @lower_barrier not in(NULL, "") and @upper_barrier not in(NULL, "")
begin
	select
		error = "Error",
		status = "Error",
		msg = "Can not provide barrier, upper barrier, and lower barrier. Either provide only a barrier, or both upper and lower barriers"
	return
end
if @barrier_type not in(NULL, "") and @barrier in(NULL, "")  and @lower_barrier in(NULL, "") and @upper_barrier in(NULL, "")
begin
	select
		status = "Error",
		msg = "Must provide barrier information for "+rtrim(@barrier_type)+" exotic"
	return
end

declare @external_account varchar(50)
declare @contract_id int
declare @source_id int
declare @symbol varchar(100)
declare @tally_type varchar(20)
declare @sales_code varchar(50)
declare @biproduct varchar(50)
declare @quantity_num numeric(30, 4)
declare @premium_amount_num numeric(30, 4)
declare @underlying_contract_id int
declare @pips_price float
declare @pct_price float
declare @exotic_instrument_id int
declare @timing_id int
declare @payout_ccy_id int
declare @barrier_type_id int



select
	@quantity_num = convert(numeric(30, 4), @quantity),
	@premium_amount_num = convert(numeric(30, 4), @premium_amount)

select
	@tally_type = "Option"

select 
	@exotic_instrument_id = exotic_instrument_id
from
	exotic_instruments
where
	name = @exotic_instrument
if @exotic_instrument_id = NULL
begin
        select
                status = "Error",
                msg = "Must provide valid exotic_instrument",
                provided = @exotic_instrument
        return
end

if @exotic_instrument = "Digital"
begin
	if @barrier in ("",  NULL) and @timing = "INSTANT" and @strike not in("", NULL)
	begin
		select
			status = "Error",
			msg = "Must provide timing as SETTLEMENT for Digital all or nothing"
		return
	end
	select 
        	@timing_id = timing_id
	from
        	timings
	where
        	timing = @timing
	if @timing_id = NULL
	begin
        	select
                	status = "Error",
                	msg = "Must provide valid timing",
                	provided = @timing
        	return
	end
	
	select
		@payout_ccy_id = product_id
	from
		products
	where
		symbol = @payout_ccy
	if @payout_ccy_id = NULL
	begin
		select
			status = "Error",
			msg = "Must provide valid payout currency",
			provided = @payout_ccy
		return
	end
	if @payout_amount = NULL
	begin
		select
			status = "Error",
			msg = "Must provide payout amount for Digital option",
			provided = @payout_amount
		return
	end
end
if @exotic_instrument = "Single Barrier"
begin
	if @barrier in("", NULL)
	begin
		select
			status = "Error",
			msg = "Must provide a barrier for single barrier option",
			provided = @barrier
		return
	end
	if @barrier_type in("", NULL)
	begin
		select
			status = "Error",
			msg = "Must provide a barrier type for single barrier option",
			provided = @barrier_type
		return
	end
	select
		@barrier_type_id = barrier_type_id
	from
		barrier_types
	where
		barrier = @barrier_type
	if @barrier_type_id = NULL
	begin
		select
			status = "Error",
			msg = "Must provide a valid barrier type for single barrier option",
			provided = @barrier
		return
	end
	if @barrier_type like "Up%"
	begin
		if convert(float, @spot_reference) >= convert(float, @barrier)
		begin
			select
				status = "Error",
				msg = "Spot ref must be less than barrier for "+rtrim(@barrier_type)+" exotic"
			return
		end
	end
	else if @barrier_type like "Down%"
	begin
                if convert(float, @spot_reference) <= convert(float, @barrier)
                begin
                        select
                                status = "Error",
                                msg = "Spot ref must be less than barrier for "+rtrim(@barrier_type)+" exotic"
                        return
                end
	end
	else if @barrier_type like "DK%"
	begin
                if @barrier not in("", NULL)
                begin
			select 
				status = "Error",
				msg = "Double Knock In/Out must have barrier information in upper and lower barrier fields"
			return
                end
		select
			status = "Error",
			msg = "Double Knock In/Out must have an upper and lower barrier"
                return
	end
end

if @exotic_instrument = "Double Barrier"
begin
	if @barrier_type like "DK%"
	begin
                if @barrier not in("", NULL)
                begin
			select 
				status = "Error",
				msg = "Double Knock In/Out must have barrier information in upper and lower barrier fields"
			return
                end
	end
        if @upper_barrier in("", NULL)
        begin
                select
                        status = "Error",
                        msg = "Must provide an upper barrier for double barrier option",
                        provided = @upper_barrier
                return
        end
        if @lower_barrier in("", NULL)
        begin
                select
                        status = "Error",
                        msg = "Must provide an lower barrier for double barrier option",
                        provided = @lower_barrier
                return
        end

        if @barrier_type in("", NULL)
        begin
                select
                        status = "Error",
                        msg = "Must provide a barrier type for double barrier option",
                        provided = @barrier_type
                return
        end
        select
                @barrier_type_id = barrier_type_id
        from
                barrier_types
        where
                barrier = @barrier_type
        if @barrier_type_id = NULL
        begin
                select
                        status = "Error",
                        msg = "Must provide a valid barrier type for double barrier option",
                        provided = @barrier_type
                return
        end
end

/* We are not mandating that you provide a window start and window end on all barrier options 
if ((@barrier not in(NULL, "") or @lower_barrier not in(NULL, "") or  @upper_barrier not in(NULL, "")) and (@window_end in("", NULL)) or (@window_start in("", NULL)))
begin
                select
                        status = "Error",
                        msg = "Must provide window start and window end for any barrier option",
                        provided = @barrier_type
                return
end
*/

if @trade_date= NULL
select
        @trade_date = getdate()

select
	@barrier_subtype = subtype
from
	barrier_types
where
	barrier = @barrier_type

if @barrier_subtype = "KOKI"
begin
	if @exercise_style = "American" 
	begin
		select
			status = "Error",
			msg = "Must provide option as 'European' for KO & KI options"
		return
	end
end	

/*
if @barrier_subtype = "DIGI"
begin
	if @exercise_style = "European" and @window_start != @window_end and @window_start != @trade_date
	begin
		select
			status = "Error",
			msg = "Must provide option as 'American' for Digital option with barrier with no windows"
		return
	end
end
*/

if @source = NULL
begin
	select
		@source = "MPT Manual Tally"
end
else
begin
	select
		@source_id = a.source_id
	from
		sources a,
		source_types b
	where
		a.source_type_id = b.source_type_id
	and
		b.name = "Inbound"
	and
		a.name = @source
	if @source_id = NULL
	begin
        	select
                	status = "Error",
                	msg = "Cannot determine inbound source name",
                	provided = @source
        	return
	end
end




if @cl_or_lp = "LP"
begin
	select
        	@external_account = a.symbol
	from
        	external_accounts a,
        	counterparties b
	where
        	a.external_account_id = b.external_account_id
	and
        	b.name = @counterparty
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	msg = "Cannot determine default external account for counterparty",
                	provided = @counterparty
        	return
	end
	
	select 
		@trader = NULL
end
if @cl_or_lp = "CL"
begin
	select
		@external_account = a.symbol
	from
		external_accounts a,
		traders b
	where
		a.external_account_id = b.external_account_id
	and
		b.symbol = @trader
	if @@rowcount != 1
	begin
		select
			status = "Error",
			msg = "Cannot determine external account for trader",
			provided = @trader
		return
	end
	select
		@counterparty = NULL
end

if @cl_or_lp = "LP"
begin
	if @buy_sell = "B"
	begin
        	select
                	@quantity_num = abs(@quantity_num)
	end
	if @buy_sell = "S"
	begin
        	select
                	@quantity_num = abs(@quantity_num) * -1.0
	end
end
else if @cl_or_lp = "CL"
begin
	/* buy sell is client perspective, so if client buy, agency sell */
	if @buy_sell = "B"
	begin
        	select
                	@quantity_num = abs(@quantity_num) * -1.0
	end
	if @buy_sell = "S"
	begin
        	select
                	@quantity_num = abs(@quantity_num) 
	end
end


select
	@biproduct = rtrim(@dealt_ccy)+rtrim(@counter_ccy)

select
	@underlying_contract_id = contract_id
from
	contracts
where
	symbol = @biproduct
if @underlying_contract_id= NULL
begin
	select
		status = "Error",
		msg = "Could not find biproduct from dealt and counter ccy",
		provided = "biproduct: "+ rtrim(@biproduct)+" dealt_ccy: "+rtrim(@dealt_ccy)+" counter_ccy: "+rtrim(@counter_ccy)
	return
end

if @pips_price = NULL
begin
	/* debug 
	select
                        dealt_ccy=@dealt_ccy,
                        counter_ccy=@counter_ccy,
                        dealt_amount=@quantity_num,
                        premium_ccy=@premium_ccy,
                        premium_amount=@premium_amount_num,
                        spot_reference=NULL,
                        conversion_rate=NULL,
                        pips_price=@pips_price
	*/

	exec 
		r_pipspriceforoption
			@dealt_ccy=@dealt_ccy,
			@counter_ccy=@counter_ccy,
			@dealt_amount=@quantity_num,
			@premium_ccy=@premium_ccy,
			@premium_amount=@premium_amount_num,
			@spot_reference=@spot_reference,
			@conversion_rate=@conversion_rate,
			@pips_price=@pips_price output
end


exec
        r_exoticoptioncontract
                @underlying_contract=@biproduct,
                @timezone=@timezone,
                @expiration=@expiration,
                @put_call=@call_put,
                @strike=@strike,
                @option_settledate=@option_settle,
                @instrument_type=@exotic_instrument,
                @timing=@timing,
                @payout_ccy=@payout_ccy,
                @barrier_type=@barrier_type,
                @lower_barrier=@lower_barrier,
                @upper_barrier=@upper_barrier,
                @barrier=@barrier,
		@window_start=@window_start,
		@window_end=@window_end,
		@exercise_style=@exercise_style,
                @contract_id=@contract_id output


select
        @symbol = symbol
from
        contracts
where
        contract_id = @contract_id
if @symbol = NULL
begin
        select
                status = "Error",
                msg = "Problem finding contract after creation. Report this error to support@elysiumtechgroup.com",
                underlying_contract=@biproduct,
                timezone=@timezone,
                expiration=@expiration,
                put_call=@call_put,
                strike=@strike,
                option_settledate=@option_settle,
                instrument_type=@exotic_instrument,
                timing=@timing,
                payout_ccy=@payout_ccy,
                barrier_type=@barrier_type,
                lower_barrier=@lower_barrier,
                upper_barrier=@upper_barrier,
                barrier=@barrier,
                window_start=@window_start,
                window_end=@window_end,
                exercise_style=@exercise_style

        return
end

/* Dont do this for exotics
exec
	r_initializeoptcontract
		@symbol,
		@vol

*/


/* debug
select
	"fxa_tallytrade",
	login = @login,
	source = "MPT Manual Tally",
	trade_id = @trade_id,
	deal_id = @deal_id,
	tally_type = @tally_type,
	deal_type = @deal_type,
	trade_type = "Option",
	external_account = @external_account,
	counterparty = @counterparty,
	quantity = @quantity_num,
	symbol = @symbol,
	value_date = @option_settle,
	price = @pips_price,
	sales_code = @sales_code,
	premium = @premium_amount_num,
	premium_currency = @premium_ccy,
	prem_settle_date = @premium_settle,
	pct_price = @pct_price,
	spot_reference = @spot_reference,
	strategy = @strategy,
	trade_note = @trade_note,
	trade_date = @trade_date
*/

exec
	fxa_tallytrade
		@login = @login,
		@source = @source,
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = @deal_type,
		@trade_type = "Option",
		@external_account = @external_account,
		@counterparty = @counterparty,
		@trader = @trader,
		@quantity = @quantity_num,
		@symbol = @symbol,
		@value_date = @option_settle,
		@price = @pips_price,
		@sales_code = @sales_code,
		@premium = @premium_amount_num,
		@premium_currency = @premium_ccy,
		@prem_settle_date = @premium_settle,
		@pct_price = @pct_price,
		@spot_reference = @spot_reference,
		@strategy = @strategy,
		@trade_note = @trade_note,
		@trade_date = @trade_date,
		@fixing_date = @fixing_date

exec
	api_setexotictradeattribs
		@login = @login,
		@trade_id = @trade_id,
		@payout_amount = @payout_amount

exec r_inserttradenotification @trade_id


go 
