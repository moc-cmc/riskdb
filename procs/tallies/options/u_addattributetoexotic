use
	risk_makr_dev
go

drop procedure
	u_addattributetoexotic
go

create procedure
	u_addattributetoexotic
		@trade_id int,
		@attribute_name varchar(100),
		@value varchar(50),
		@status varchar(100) output
as


declare @attribute_type_id int
declare @datatype varchar(25)

select
	@attribute_type_id = attribute_type_id,
	@datatype = datatype
from
	attribute_types
where
	name = @attribute_name
if @attribute_type_id = NULL
begin

	select
		@status = "Unable to find attribute name " + rtrim(@attribute_name)
	return
end

insert into
	exotic_trade_attributes(
		trade_id,
		attribute_type_id,
		value)
values(
	@trade_id,
	@attribute_type_id,
	@value)


select
	@status = "Success"


go
