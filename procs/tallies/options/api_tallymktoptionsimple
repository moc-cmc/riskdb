drop procedure api_tallymktoptionsimple
go

create procedure
	api_tallymktoptionsimple
		@login varchar(50)=NULL,
		@buy_sell varchar(1)=NULL,
		@counterparty varchar(50)=NULL,
		@dealt_ccy varchar(10)=NULL,
		@counter_ccy varchar(10)=NULL,
		@strike varchar(20)=NULL,
		@call_put varchar(5)=NULL,
		@timezone varchar(50)=NULL,
		@expiration datetime=NULL,
		@option_settle datetime=NULL,
		@quantity varchar(20)=NULL,
		@premium_ccy varchar(10)=NULL,
		@premium_amount varchar(20)=NULL,
		@premium_settle datetime=NULL,
		@strategy varchar(50)=NULL,
		@trade_note varchar(255)=NULL,
		@trade_date datetime=NULL,
		@deal_id int=NULL output,
		@trade_id int=NULL output,
		@fixing_date datetime=NULL


as

declare @cl_or_lp char(2)
declare @deal_type varchar(50)
declare @deal_status varchar(50)

if @trade_id != NULL
begin
	select
		status = "Warn",
		msg = "Can not provide trade id. It is used for output only. Trade not tallied"
	return
end


select
	@deal_type = "Market Option",
	@deal_status = "User Review",
	@cl_or_lp = "LP"

exec
	r_newdeal
		@deal_type=@deal_type,
		@deal_status=@deal_status,
		@deal_id=@deal_id output
		
if @deal_id = NULL
begin
	select
		status = "Error",
		msg = "Could not create deal in tally market option. Contact support@elysiumtechgroup.com and provide this error message"
	return
end	

exec
        api_tallyoptionsimple
                @login = @login,
                @buy_sell = @buy_sell,
                @dealt_ccy = @dealt_ccy,
                @counter_ccy = @counter_ccy,
                @strike = @strike,
                @call_put = @call_put,
                @timezone = @timezone,
                @expiration = @expiration,
                @option_settle = @option_settle,
                @quantity = @quantity,
                @premium_ccy = @premium_ccy,
                @premium_amount = @premium_amount,
                @premium_settle = @premium_settle,
                @cl_or_lp = @cl_or_lp,
                @counterparty = @counterparty,
                @trader = NULL, /* trader null so it defaults to whoever books the trade */
                @vol = NULL,
                @spot_reference = NULL,
                @conversion_rate = NULL,
                @strategy = @strategy,
                @trade_note = @trade_note,
                @trade_date = @trade_date,
                @deal_type = @deal_type,
                @deal_id = @deal_id output,
		@trade_id = @trade_id output,
		@fixing_date = @fixing_date

if @trade_id = NULL
begin
	select
		status = "Error",
		msg = "Could not tally trade"
	return
end


go

go
