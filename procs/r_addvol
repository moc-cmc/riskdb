
if object_id("r_addvol") != NULL
    drop procedure
        r_addvol
go
 
create procedure
	r_addvol
		@login char(30),
		@symbol char(25),
		@vol_date datetime,
		@vol float
as

declare @vol_id int
declare @contract_id int
declare @message char(255)

select
	@vol_date = convert(char(2), datepart(month, @vol_date)) + "/" +
			convert(char(2), datepart(day, @vol_date)) + "/" +
			convert(char(4), datepart(year, @vol_date))

select
	@vol_date = dateadd(hour, 17, @vol_date)


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract with symbol",	
		sybmol = @symbol
	return
end

begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "vols"
	select
		@vol_id = last_id
	from
		keys
	where
		relation = "vols"
commit tran

begin tran
	insert into
		vols
	values(
		@vol_id,
		@contract_id,
		@vol_date,
		@vol)
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem adding vol"
		rollback tran
		return
	end
commit tran

select
	@message = "<b><font color='00CCFF'>UPDATED VOL</font></b> for contract <b><font color='00CCFF'>" + rtrim(@symbol) + " " + rtrim(convert(varchar(30), convert(numeric(30,4), @vol))) + "</b></font>" 

exec
	w_sendmessage
		@login,
		"Elysium Front Office",
		@message 

select
	id = 0,
	msg = "Successfully added vol"

go
