drop procedure
	r_editmarginprofile
go

create procedure
	r_editmarginprofile
		@login varchar(50),
		@cpid int,
		@name varchar(50),
		@currency varchar(10),
		@margin_model varchar(50),
		@notice_level float,
		@warning_level float,
		@blocked_level float,
		@multiplier float

as

declare @margin_profile_id int
declare @margin_model_id int
declare @currency_id int


select
	@currency_id = product_id
from
	products
where
	symbol = @currency
if @currency_id = NULL
begin
	select
		error="Error",
		msg="Currency not found", @currency
	return
end

select
	@margin_model_id = margin_model_id
from
	margin_models
where
	name=@margin_model
if @margin_model_id = NULL
begin
	select
		error="Error",
		msg="Margin model not found ", @margin_model
	return
end



update
	margin_profiles
set
	name = @name,
	currency_id = @currency_id,
	margin_model_id = @margin_model_id,
	notice_level = @notice_level,
	warning_level = @warning_level,
	blocked_level = @blocked_level,
	multiplier = @multiplier
where
	margin_profile_id = @cpid

if @@rowcount = 1
begin
	select
		status = "Successfully edited Margin Profile"
end

exec
	r_viewmarginprofile
		@login,
		@name


go

	
