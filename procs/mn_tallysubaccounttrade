use
	risk_ram
go

drop procedure
	mn_tallysubaccounttrade
go

create procedure
	mn_tallysubaccounttrade
		@login varchar(50),
		@deal_id int,
		@sub_account varchar(50),
		@allocation float,
		@ma_version_id int
as

declare @master_trade_id int
declare @source varchar(50)
declare @external_account_id int
declare @external_account varchar(50)
declare @original_login varchar(50)
declare @trade_type varchar(50)
declare @deal_type varchar(50)
declare @tally_type varchar(50)
declare @internal_account varchar(50)
declare @counterparty varchar(50)
declare @symbol varchar(50)
declare @trade_date datetime
declare @price float
declare @deal_quantity float
declare @sales_code varchar(50)
declare @broker varchar(50)
declare @value_date datetime
declare @trader varchar(50)
declare @status varchar(50)
declare @strategy varchar(50)
declare @master_allocation_id int
declare @quantity numeric(30,4)
declare @trade_id int
declare @source_id int
declare @instrument varchar(50)
declare @contract_id int
declare @master_quantity int

	
select
        @master_allocation_id = b.master_allocation_id,
        @master_trade_id = a.trade_id
from
        trades a,
        master_allocations b,
        ma_versions c
where
        a.external_account_id = b.external_account_id
and
        b.master_allocation_id = c.master_allocation_id
and
        c.ma_version_id = @ma_version_id
and
        a.deal_id = @deal_id


select
	@external_account = a.symbol,
	@external_account_id = a.external_account_id
from
	external_accounts a,
	trades b
where
	a.external_account_id = b.external_account_id
and
	b.trade_id = @master_trade_id



/*
exec
	cn_validateaccountaccess
		@login,
		@external_account,
		@external_account_id output
*/
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Deal not found"
	return
end

select
	@deal_quantity = sum(quantity)
from
	trades
where
	deal_id = @deal_id


select
	@source = name
from
	sources
where
	name = "MPT Allocation"
if @source = NULL
begin
	select
		@source = "MPT Allocation"
	exec
		j_nextkey
			"sources",
			@source_id output
	insert into
		sources
	values(
		@source_id,
		@source,
		3)
end
		
	

select
	@trade_type = b.name,
	@tally_type = b.name,
	@deal_type = c.name,
	@price = a.price,
	@counterparty = d.name,
	@trade_date = a.trade_date,
	@value_date = a.value_date,
	@internal_account = f.symbol
from
	trades a,
	trade_types b,
	deal_types c,
	counterparties d,
	deals e,
	internal_accounts f
where
	a.trade_type_id = b.trade_type_id
and
	a.deal_id = e.deal_id
and
	e.deal_type_id = c.deal_type_id
and
	a.counterparty_id = d.counterparty_id
and
	a.internal_account_id = f.internal_account_id
and
	a.trade_id = @master_trade_id



select
	@original_login = a.login
from
	tico_accounts a,
	trades b
where
	a.account_id = b.user_id

select
	@symbol = b.symbol,
	@sales_code = c.name,
	@broker = d.symbol,
	@trader = e.symbol,
	@status = f.name,
	@strategy = g.name
from
	trades a,
	contracts b,
	sales_codes c,
	brokers d,
	traders e,
	statuses f,
	strategies g
where
	a.contract_id = b.contract_id
and
	a.sales_code_id = c.sales_code_id
and
	a.broker_id = d.broker_id
and
	a.trader_id = e.trader_id
and
	a.status_id = f.status_id
and
	a.strategy_id = g.strategy_id
and
	a.trade_id = @master_trade_id


select
	@quantity = @deal_quantity * @allocation



select
	@instrument = b.name,
	@contract_id = a.contract_id
from	
	contracts a,
	instruments b
where
	a.instrument_id = b.instrument_id 
and
	a.symbol = @symbol


if @instrument = "Option"
begin
	select 
		@instrument = a.name
	from
		instruments a,
		contracts b,
		options c,
		option_expirations d,
		option_contracts e
	where
		a.instrument_id = b.instrument_id
	and
		d.option_expiration_id = e.option_expiration_id
	and
		c.underlying_contract_id = b.contract_id
	and
		c.option_id = d.option_id
	and
		e.contract_id = @contract_id
end


if @instrument = "Future"
begin
	select
		@quantity = round(@deal_quantity * @allocation, 0)
end


exec
	fxa_tallytrade
		@login = @original_login,
		@source = @source,
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = @deal_type,
		@trade_type = @trade_type,
		@external_account = @sub_account,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@trader = @trader,
		@broker = @broker,
		@strategy = @strategy,
		@status = @status,
		@sales_code = @sales_code

if @trade_id != NULL
begin 
	update
		trades
	set
		quantity = quantity - @quantity
	where
		trade_id = @master_trade_id

	select
		@master_quantity = quantity
	from
		trades
	where
		trade_id = @master_trade_id


end 

go
