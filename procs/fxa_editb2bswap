drop procedure
	fxa_editb2bswap
go


create procedure
	fxa_editb2bswap
		@login varchar(50),
		@deal_id int,
		@client_user varchar(50),
		@client_buys_sells varchar(20),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@near_date datetime,
		@near_fixing_date datetime = NULL,
		@client_near_price float,
		@market_near_price float,
		@far_date datetime,
		@far_fixing_date datetime = NULL,
		@client_far_price float,
		@market_far_price float


as

declare @tally_type varchar(20)
declare @client_external_account varchar(50)
declare @market_external_account varchar(50)
declare @trader varchar(25)
declare @symbol varchar(50)
declare @client_near_trade_id int
declare @market_near_trade_id int
declare @client_far_trade_id int
declare @market_far_trade_id int
declare @far_trade_id int
declare @trade_date datetime
declare @client_near_quantity numeric(30,4)
declare @client_far_quantity numeric(30,4)
declare @market_near_quantity numeric(30,4)
declare @market_far_quantity numeric(30,4)
declare @market_sales_code varchar(50)

select
	@market_sales_code = "None"

select
	@tally_type = "Swap"

if @client_buys_sells = "Client Buys"
begin
	select
		@client_near_quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@client_near_quantity = abs(@quantity)
end

select
	@client_far_quantity = @client_near_quantity * -1.0

select
	@market_near_quantity = @client_near_quantity * -1.0,
	@market_far_quantity = @client_far_quantity * -1.0

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)


select
	@client_external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

select
	@market_external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end


select
	@trader = a.symbol
from
	traders a,
	tico_accounts b
where
	a.tico_account_id = b.account_id
and
	b.login = @login


select
	@client_near_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
and
	a.deal_id = @deal_id
and
	a.value_date = (
		select
			min(a.value_date)
		from
			trades a,
			external_accounts b,
			external_account_types c
		where
			a.external_account_id = b.external_account_id
		and
			b.external_account_type_id = c.external_account_type_id
		and
			c.name = "Client"
		and
			a.deal_id = @deal_id)

select
	@client_far_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
and
	a.deal_id = @deal_id
and
	a.value_date = (
		select
			max(a.value_date)
		from
			trades a,
			external_accounts b,
			external_account_types c
		where
			a.external_account_id = b.external_account_id
		and
			b.external_account_type_id = c.external_account_type_id
		and
			c.name = "Client"
		and
			a.deal_id = @deal_id)


select
	@market_near_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Counterparty"
and
	a.deal_id = @deal_id
and
	a.value_date = (
		select
			min(a.value_date)
		from
			trades a,
			external_accounts b,
			external_account_types c
		where
			a.external_account_id = b.external_account_id
		and
			b.external_account_type_id = c.external_account_type_id
		and
			c.name = "Counterparty"
		and
			a.deal_id = @deal_id)


select
	@market_far_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Counterparty"
and
	a.deal_id = @deal_id
and
	a.value_date = (
		select
			max(a.value_date)
		from
			trades a,
			external_accounts b,
			external_account_types c
		where
			a.external_account_id = b.external_account_id
		and
			b.external_account_type_id = c.external_account_type_id
		and
			c.name = "Counterparty"
		and
			a.deal_id = @deal_id)



select
	@trade_date = trade_date
from
	trades
where
	trade_id = @market_far_trade_id

exec
	r_inserttradeedit @client_near_trade_id

/* Tally the client near leg */
exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Near",
		@internal_account = NULL,
		@external_account = @client_external_account,
		@counterparty = NULL,
		@quantity = @client_near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@fixing_date = @near_fixing_date,
		@price = @client_near_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@strategy = NULL,
		@status = NULL,
		@broker = NULL,
		@identifier = NULL,
		@sales_code = NULL,
		@premium = NULL,
		@premium_currency = NULL,
		@prem_settle_date = NULL,
		@pct_price = NULL,
		@spot_reference = NULL

if(@quantity = 0)
begin
    exec
        r_updatetradenotification @client_near_trade_id, "Cancelled"
end     
else    
begin
    exec
        r_updatetradenotification @client_near_trade_id, "Edit"
end

/* Tally the market near leg */

exec
    r_inserttradeedit @market_near_trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @market_near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Near",
		@internal_account = NULL,
		@external_account = @market_external_account,
		@counterparty = @counterparty,
		@quantity = @market_near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@fixing_date = @near_fixing_date,
		@price = @market_near_price,
		@trade_date = @trade_date,
		@trader = NULL,
		@strategy = NULL,
		@status = NULL,
		@broker = NULL,
		@identifier = NULL,
		@sales_code = @market_sales_code,
		@premium = NULL,
		@premium_currency = NULL,
		@prem_settle_date = NULL,
		@pct_price = NULL,
		@spot_reference = NULL

if(@quantity = 0)
begin
    exec
        r_updatetradenotification @market_near_trade_id, "Cancelled"
end
else
begin
    exec
        r_updatetradenotification @market_near_trade_id, "Edit"
end

/* Tally the client far leg */

exec
    r_inserttradeedit @client_far_trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Far",
		@internal_account = NULL,
		@external_account = @client_external_account,
		@counterparty = NULL,
		@quantity = @client_far_quantity,
		@symbol = @symbol,
		@value_date = @far_date,
		@fixing_date = @far_fixing_date,
		@price = @client_far_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@strategy = NULL,
		@status = NULL,
		@broker = NULL,
		@identifer = NULL,
		@sales_code = NULL,
		@premium = NULL,
		@premium_currency = NULL,
		@prem_settle_date = NULL,
		@pct_price = NULL,
		@spot_reference = NULL

if(@quantity = 0)
begin
    exec
        r_updatetradenotification @client_far_trade_id, "Cancelled"
end
else
begin
    exec
        r_updatetradenotification @client_far_trade_id, "Edit"
end


/* Tally the market far leg */

exec
    r_inserttradeedit @market_far_trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @market_far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Far",
		@internal_account = NULL,
		@external_account = @market_external_account,
		@counterparty = @counterparty,
		@quantity = @market_far_quantity,
		@symbol = @symbol,
		@value_date = @far_date,
		@fixing_date = far_fixing_date,
		@price = market_far_price,
		@trade_date = trade_date,
		@trader = NULL,
		@strategy = NULL,
		@status = NULL,
		@broker = NULL,
		@identifier = NULL,
		@sales_code = @market_sales_code,
		@premium = NULL,
		@premium_currency = NULL,
		@prem_settle_date = NULL,
		@pct_price = NULL,
		@spot_reference = NULL

if(@quantity = 0)
begin
    exec
        r_updatetradenotification @market_far_trade_id, "Cancelled"
end
else
begin
    exec
        r_updatetradenotification @market_far_trade_id, "Edit"
end

exec
	r_inspectdealtrades
		@login,
		@deal_id


go




