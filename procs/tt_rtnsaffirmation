drop procedure
	tt_rtnsaffirmation
go

create procedure
	tt_rtnsaffirmation
		@source varchar(50),
		@trade_id int,
		@status varchar(50)

as


declare @source_id int
declare @status_id int
declare @source_trade_status_id int
declare @already_processed varchar(1)

/* we currently dont support status_symbols with a source. hardcoding for now. converted to our status name */

if @status = "PENDING"
	select
		@status = "Pending"
if @status = "REJECTED"
	select
		@status = "Rejected"
if @status = "CONFIRMED"
	select
		@status = "Confirmed"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		error = "error",
		msg = "source not found",
		source = @source
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = @status
if @@rowcount != 1
begin
	select
		error = "error",
		msg = "status not found",
		status = @status
	return
end


select
	@already_processed = "Y"
from
	source_trade_statuses
where
	source_id = @source_id
and
	trade_id = @trade_id

if @already_processed != "Y"
begin
	insert into
		source_trade_statuses(
			source_id,
			trade_id,
			status_id
		)
	values(
		@source_id,
		@trade_id,
		@status_id
	)

	select
		msg = "trade status inserted",
		source = @source,
		trade = @trade_id,
		status = @status
end
else
begin
	update
		source_trade_statuses
	set
		status_id = @status_id
	where
		source_id = @source_id
	and
		trade_id = @trade_id

	select
		msg = "trade status updated",
		source = @source,
                trade = @trade_id,
                status = @status
end

go
