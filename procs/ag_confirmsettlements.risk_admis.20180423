drop procedure ag_confirmsettlements
go

create procedure
	ag_confirmsettlements
		@login varchar(50),
		@value_date datetime=NULL,
		@account varchar(50)=NULL,
		@product varchar(50)=NULL,
		@pair varchar(50)=NULL,
		@trade_date datetime=NULL
as


declare @fund_id int
declare @fund varchar(100)
declare @roll_trader_id int
declare @prime_broker_id int
declare @selected_prime_broker_id int
declare @selected_external_account_id int
declare @fund_prime_broker_id int
declare @fund_prime_broker varchar(50)
declare @prime_broker varchar(50)
declare @clearing varchar(50)
declare @fund_external_account_id int

declare @total_style varchar(250)
declare @grey_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

declare @id int
declare @ids int
declare @pb_id int

declare @product_id int
declare @contract_id int
declare @quantity numeric(30,2)

declare @balance float
declare @non_same_day_type_id int
declare @same_day_type_id int


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
