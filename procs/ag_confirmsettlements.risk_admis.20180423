create table
	#selected_pbs(
		prime_broker_id int)

if @selected_prime_broker_id != NULL
begin
	insert into
		#selected_pbs(
			prime_broker_id)
	values(
		@selected_prime_broker_id)
end
else
begin
	insert into
		#selected_pbs(
			prime_broker_id)
	select
		prime_broker_id
	from
		prime_brokers
end

	
update
	#pb_output
set
	non_same_day = balance - same_day_settlement


create table
	#confirmation_types(
		external_account_id int,
		product_id int,
		confirmation_type_id int,
		amount numeric(30,4))
insert into
	#confirmation_types(
		external_account_id,
		product_id,
		confirmation_type_id,
		amount)
select
	b.external_account_id,
	a.product_id,
	b.confirmation_type_id,
	sum(b.amount)
from
	pb_wire_signoffs a,
	wire_allocations b
where
	a.pb_wire_signoff_id = b.pb_wire_signoff_id
and
	convert(date, a.value_date) = convert(date, @value_date)
group by
	b.external_account_id,
	a.product_id,
	b.confirmation_type_id 

create table
	#netted_conf_types(
		external_account_id int,
		product_id int,
		confirmation_type_id int,
		amount numeric(30,4))
insert into
	#netted_conf_types(
		external_account_id,
		product_id,
		confirmation_type_id,
		amount)
select
	a.external_account_id,
	a.product_id,
	b.confirmation_type_id,
	sum(b.amount)
from
	pb_wire_signoffs a,
	wire_allocations b
where
	a.pb_wire_signoff_id = b.pb_wire_signoff_id
and
	convert(date, a.value_date) = convert(date, @value_date)
group by
	a.external_account_id,
	a.product_id,
	b.confirmation_type_id

delete

from
	#netted_conf_types
where
	external_account_id not in(
		select
			distinct(wire_net_account_id)
		from
			wire_net_accounts)


update
	#pb_output
set
	a.non_same_day = a.non_same_day - b.amount
from
	#pb_output a,
	#confirmation_types b,
	confirmation_types c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id
and
	b.confirmation_type_id = c.confirmation_type_id
and
	c.name = "Non Same Day"

update
	#pb_output
set
	a.same_day_settlement = a.same_day_settlement - b.amount
from
	#pb_output a,
	#confirmation_types b,
	confirmation_types c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id
and
	b.confirmation_type_id = c.confirmation_type_id
and
	c.name = "Same Day"


create table
	#netted_wires(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		wire_net_account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		balance numeric(30,4) NULL,
		signoff_amount numeric(30,4) NULL,
		non_same_day numeric(30,4) NULL,
		same_day_settlement numeric(30,4) NULL,
		remainder numeric(30,4) NULL,
		add_signoff varchar(50) NULL,
		confirm_non varchar(50) NULL,
		confirm_same varchar(50) NULL,
		confirm_tot varchar(50) NULL,
		confirm_other varchar(50) NULL)

insert into
	#netted_wires(
		wire_net_account,
		product,
		balance,
		same_day_settlement,
		non_same_day)
select
	wire_net_account,
	prod = product,
	sum(balance),
	sum(same_day_settlement),
	sum(non_same_day)
from
	#pb_output
where
	netting = "Netted"
group by
	wire_net_account,
	product
order by
	wire_net_account,
	product

update
	#netted_wires
set
	signoff_amount = 0.0,
	add_signoff = "Confirm Net Amount",
	confirm_non = "Confirm",
	confirm_tot = "Confirm",
	confirm_same = "Confirm",
	confirm_other = "Other"

update
	#netted_wires
set
	a.product_id = b.product_id
from
	#netted_wires a,
	products b
where
	a.product = b.symbol

update
	#netted_wires
set
	a.external_account_id = b.external_account_id
from
	#netted_wires a,
	external_accounts b
where
	a.wire_net_account = b.symbol

update
	#netted_wires
set
	style = @style

update
	#netted_wires
set
	a.signoff_amount = b.amount
from
	#netted_wires a,
	#signoffs b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id

update
	#netted_wires
set
	remainder = balance - signoff_amount

update
	#netted_wires
set
	non_same_day = balance - same_day_settlement

update
	#netted_wires
set
	a.non_same_day = a.non_same_day - b.amount
from
	#netted_wires a,
	#netted_conf_types b,
	confirmation_types c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id
and
	b.confirmation_type_id = c.confirmation_type_id
and
	c.name = "Non Same Day" 

update
	#netted_wires
set
	a.same_day_settlement = a.same_day_settlement - b.amount
from
	#netted_wires a,
	#confirmation_types b,
	confirmation_types c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id
and
	b.confirmation_type_id = c.confirmation_type_id
and
	c.name = "Same Day"




update
	#netted_wires
set
	add_signoff = NULL
where
	abs(remainder) < .01


update
	#netted_wires
set
	confirm_non = NULL
where
	abs(non_same_day) < .01 

update
	#netted_wires
set
	confirm_same = NULL
where
	abs(same_day_settlement) < .01 


update
	#pb_output
set
	confirm_non = NULL
where
	abs(non_same_day) < .01

update
	#pb_output
set
	confirm_same = NULL
where
	abs(same_day_settlement) < .01

update
	#pb_output
set
	confirm_tot = NULL,
	confirm_non = NULL,
	confirm_same = NULL
where
	abs(remainder) < .01

select
	@non_same_day_type_id = confirmation_type_id
from
	confirmation_types
where
	name = "Non Same Day"
if @non_same_day_type_id = NULL
begin
	select
		status = "Error",
		message = "Non Same Day confirmation type not found"
	return
end

select
	@same_day_type_id = confirmation_type_id
from
	confirmation_types
where
	name = "Same Day"
if @same_day_type_id = NULL
begin
	select
		status = "Error",
		message = "Same Day confirmation type not found"
	return
end

delete

from
	queued_wire_allocations
where
	value_date = @value_date

insert into
	queued_wire_allocations(
		wire_net_account_id,
		external_account_id,
		product_id,
		value_date,
		confirmation_type_id,
		amount)
select
	wire_net_account_id,
	external_account_id,
	product_id,
	value_date = @value_date,
	confirmation_type_id = @non_same_day_type_id,
	non_same_day
from
	#pb_output
where
	netting = "Netted"
and
	prime_broker = NULL 

insert into
	queued_wire_allocations(
		wire_net_account_id,
		external_account_id,
		product_id,
		value_date,
		confirmation_type_id,
		amount)
select
	wire_net_account_id,
	external_account_id,
	product_id,
	value_date = @value_date,
	confirmation_type_id = @same_day_type_id,
	same_day_settlement
from
	#pb_output
where
	netting = "Netted"
and
	prime_broker = NULL 



/* Select the output */

select
	style = @style,
	manage_settlements = "Back To Manage Settlements",
	back_to_all = "Show All Clearing Accounts",
	wires_queue = "Queued Wire Amounts",
	value_date = @value_date

select
	a.style,
	a.value_date,
	a.clearing,
	clearing_entity = a.prime_broker,
	a.account,
	acct = a.account,
	a.val_date,
	prod = a.product,
	a.product,
	a.non_same_day,
	a.confirm_non,
	a.same_day_settlement,
	a.confirm_same,
	total = a.balance,
	a.confirm_tot,
	prime_broker = a.clearing,
	total_confirmed = a.signoff_amount,
	unconfirmed = a.remainder,
	a.confirm_other
from
	#pb_output  a,
	#selected_pbs b
where
	a.prime_broker_id = b.prime_broker_id 
order by
	a.id

if @account = NULL
begin
	select
		section = "Netted Wire Amounts",
		style,
		acct = wire_net_account,
		account = wire_net_account,
		value_date = @value_date,
		val_date = @value_date,
		amount = remainder,
		prod = product,
		product,
		non_same_day,
		confirm_non,
		same_day_settlement,
		confirm_same,
		total = balance,
		total_confirmed = signoff_amount,
		unconfirmed = remainder,
		confirm_other
	from
		#netted_wires
	order by
		id
end

select
	section = "Confirmed Balance",
	style = @style,
	identifier = a.pb_wire_signoff_id,
	entered_by = b.login,
	account = c.symbol,
	product = d.symbol,
	wire_account = c.symbol,
	wire_product = d.symbol,
	confirmation_type = e.name,
	a.value_date,
	a.amount,
	wire_amount = a.amount,
	a.note,
	remove_signoff = "Cancel"
from
	pb_wire_signoffs a,
	tico_accounts b,
	external_accounts c,
	products d,
	confirmation_types e
where
	a.tico_account_id = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.product_id = d.product_id
and
	a.confirmation_type_id = e.confirmation_type_id
and
	d.symbol = @product
and
	c.symbol = @account
and
	convert(date, a.value_date) = convert(date, @value_date)

select
	section = rtrim(@product) + " Pair Positions For " + convert(varchar(20), @value_date),
	style,
	value_date = @value_date,
	account = @account,
	product = @product,
	pair = symbol,
	trade_date,
	pair_position,
	product_amount
from
	#pair_output
order by
	id

select
	section = rtrim(@pair) + " Trades for " + convert(varchar(11), @trade_date),
	style,
	trade_id,
	trade_date,
	platform,
	dealt_currency,
	dealt_amount,
	counter_currency,
	counter_amount,
	product_amount,
	price
from
	#trade_output
order by
	id


go 

