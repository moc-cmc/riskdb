
create procedure r_updateaccttransnotification @account_transaction_id int, @status varchar(100) 
as

declare @status_id int
declare @sent_status_id int 

select
	@sent_status_id = status_id
from
	statuses
where
	name="Sent"

select
	@status_id=status_id
from
	statuses
where
	name=@status

if(@@rowcount != 1)
begin
	return
end

/* set status if sent */

update 
	account_trans_notifications
set
	status_id=@status_id
where
	account_transaction_id = @account_transaction_id
and
	status_id=@sent_status_id

/* set status if trade is cancelled */

if(@status = "Cancelled")
begin
	update
		account_trans_notifications
	set
		status_id=@status_id
	where
		account_transaction_id = @account_transaction_id
end

return


go
