use
	risk_elviro
go

drop procedure
	ag_importspectrumeodtrades
go

create procedure
	ag_importspectrumeodtrades
		@login varchar(50),
		@trade_date varchar(50)=NULL,
		@trade_no varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@buy_sell varchar(50)=NULL,
		@con_cur varchar(50)=NULL,
		@con_amount varchar(50)=NULL,
		@cou_cur varchar(50)=NULL,
		@cou_amount varchar(50)=NULL,
		@rate varchar(50)=NULL,
		@terms varchar(50)=NULL,
		@settlement_date varchar(50)=NULL,
		@usd_value varchar(50)=NULL,
		@purpose varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@broker_fee varchar(50)=NULL,
		@portfolio varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@time varchar(50)=NULL,
		@ext_ref varchar(50)=NULL,
		@liq_provider varchar(50)=NULL,
		@options_liq_provider varchar(50)=NULL,
		@row_index int,
		@row_count int

as

if @buy_sell = "Sell" or @buy_sell = "Buy"
begin
	exec
		ag_importspectrumforwards
			@login = @login,
			@trade_date = @trade_date,
			@trade_no = @trade_no,
			@counterparty = @counterparty, 
			@buy_sell = @buy_sell,
			@con_cur = @con_cur,
			@con_amount = @con_amount,
			@cou_cur = @cou_cur,
			@cou_amount = @cou_amount,
			@rate = @rate,
			@terms = @terms,
			@settlement_date = @settlement_date,
			@usd_value = @usd_value,
			@purpose = @purpose,
			@broker = @broker,
			@broker_fee = @broker_fee,
			@portfolio = @portfolio,
			@trader = @trader,
			@time = @time,
			@ext_ref = @ext_ref,
			@liq_provider = @liq_provider,
			@options_liq_provider = @options_liq_provider
	
end

if @buy_sell = "LEP" or @buy_sell = "LEC" or @buy_sell = "SEP" or @buy_sell = "SEC"
begin
	exec
		ag_importspectrumoptions
			@login = @login,
			@trans_date = @trade_date,
			@transaction_number = @trade_no,
			@counterparty = @counterparty,
			@type = @buy_sell,
			@cur = @con_cur,
			@face_amount = @con_amount,
			@counter_cur = @cou_cur,
			@strike = @cou_amount,
			@settle_date = @rate,
			@expiry_date = @terms,
			@price = @settlement_date,
			@cur2 = @usd_value,
			@premium_amount = @purpose,
			@usd_value = @broker,
			@purpose = @broker_fee,
			@broker = @portfolio,
			@broker_fee = @trader,
			@portfolio = @time,
			@trader = @ext_ref,
			@ext_ref = @liq_provider,
			@liq_provider = @options_liq_provider

end


go


