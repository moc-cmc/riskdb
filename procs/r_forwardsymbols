
if object_id("r_forwardsymbols") != NULL
    drop procedure
        r_forwardsymbols
go

create procedure
	r_forwardsymbols
as

SELECT
	symbol = a.symbol
FROM
	contracts a,
	forwards b,
	exchanges c
WHERE
	a.contract_id = b.contract_id
AND
	b.exchange_id = c.exchange_id
and
	c.name = "OTC"
ORDER BY
	a.symbol

go
