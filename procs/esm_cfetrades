use
	risk_cfe
go

drop procedure
	esm_cfetrades
go

create procedure
	esm_cfetrades
		@trade_date datetime=NULL,
		@trade_id int=NULL,
		@trade_notification_id int=NULL
as

declare @timestamp datetime
declare @begin_date datetime
declare @end_date datetime
declare @processing_revals int


if @trade_notification_id = NULL
	select
		@trade_notification_id = 0

if @trade_id = NULL
	select
		@trade_id = 0

select
	@processing_revals = count(a.trade_daily_reval_id)
from
	trade_daily_revals a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Processing"


if @trade_date = NULL
	select
		@timestamp = getdate()

else
	select
		@timestamp = @trade_date

exec
	r_daterangefordate
		@timestamp,
		@begin_date output,
		@end_date output

if @trade_date = NULL
	select
		@trade_date = @begin_date


create table
	#output(
		trade_action varchar(20),
		trade_id int,
		contract_id int,
		quantity numeric(30,4),
		price float,
		trade_date datetime,
		trade_notification_id int NULL)

if @processing_revals != 0
begin
	select
		a.trade_action,
		b.symbol,
		a.quantity,
		a.price,
		a.trade_date,
		trade_notification_id = NULL
	from
		#output a,
		contracts b
	where
		a.contract_id = b.contract_id

	return
end

insert into
	#output
select
	trade_action = "Received",
	a.trade_id,
	a.contract_id,	
	a.quantity,
	a.price,
	a.trade_date,
	trade_notification_id = NULL
from
	trades a,
	brokers b
where
	a.broker_id = b.broker_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	b.symbol = "MPT Tally"
and
	a.trade_id > @trade_id


insert into
	#output
select
	trade_action = "Sent",
	b.trade_id,
	b.contract_id,
	b.quantity,
	b.price,
	b.trade_date,
	a.trade_notification_id
from
	trade_notifications a,
	trades b,
	statuses c
where
	a.trade_id = b.trade_id
and
	a.status_id = c.status_id
and
	b.trade_date >= @begin_date
and
	b.trade_date < @end_date
and
	c.name = "Sent"
and
	b.trade_id > @trade_id
and
	a.trade_notification_id > @trade_notification_id
	
	
update
	#output
set
	a.price = b.price
from
	#output a,
	current_prices b,
	option_contracts c,
	option_expirations d,
	options e
where
	a.contract_id = c.contract_id
and
	c.option_expiration_id = d.option_expiration_id
and
	d.option_id = e.option_id
and
	e.underlying_contract_id = b.contract_id





select
	a.trade_action,
	a.trade_id,
	b.symbol,
	a.quantity,
	a.price,
	a.trade_date,
	a.trade_notification_id
from
	#output a,
	contracts b
where
	a.contract_id = b.contract_id


go
