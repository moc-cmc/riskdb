
if object_id("r_authuser") != NULL
    drop procedure
        r_authuser
go

create procedure
    r_authuser
        @auth_type varchar(25),
        @name varchar(50),
        @pass varchar(100)
as

declare @found_user_id int
declare @found_pass varchar(100)
declare @found_pass_list varchar(100)

select
    @found_user_id = a.user_id,
    @found_pass = a.pass,
    @found_pass_list = "," + str_replace(a.pass, " ", NULL) + ","
from
    user_auths a,
    auth_types b,
    statuses c
where
    a.auth_type_id = b.auth_type_id
and
    a.status_id = c.status_id
and
    b.name = @auth_type
and
    a.name = @name
and
    c.name = "Active"

if @found_user_id = NULL or
    not (@found_pass = @pass or 
         @found_pass = "" or
         (@auth_type = "API Key" and @found_pass_list like "%," + @pass + ",%"))
begin
    select
        status = "error",
        message = "User not found",
        name = @name
end
else
begin
    select
        status = "ok",
        account_id = account_id,
        login = login,
        first_name = given_names,
        last_name = surname
    from
        tico_accounts
    where
        account_id = @found_user_id
end

go
