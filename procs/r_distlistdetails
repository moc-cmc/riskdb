create procedure
	r_distlistdetails
			@login varchar(50),
			@dist_list varchar(100)

as

declare @dist_list_id int
declare @email_count int

select 
	@dist_list_id = dist_list_id
from
	dist_lists
where
	name = @dist_list
if @@rowcount != 1
begin
	select 
		error = "Error", 
		message = "Problem determinin distribution list",
		dist_list = @dist_list
	return
end

create table
	#dist_lists
(
	dist_list_id int,
	dist_list varchar(100),
	dist_list_name varchar(100) NULL,
	email varchar(150) NULL,
	remove_email varchar(25) NULL,
	add_email varchar(25) NULL
)

insert into 
	#dist_lists
select
	dist_list_id,
	name,
	name,
	NULL,
	NULL,
	"ADD EMAIL"
from
	dist_lists
where
	dist_list_id = @dist_list_id

insert into
	#dist_lists
select
	a.dist_list_id,
	a.name,
	NULL,
	c.email,
	"REMOVE",
	NULL
from
	dist_lists a,
	dist_list_emails b,
	emails c
where
	a.dist_list_id = b.dist_list_id
and
	b.email_id = c.email_id
and
	a.dist_list_id = @dist_list_id

	

