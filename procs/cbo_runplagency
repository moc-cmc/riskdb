drop procedure
	cbo_runplagency
go

create procedure
	cbo_runplagency
		@login varchar(30),
		@run_name varchar(50),
		@trade_date datetime=NULL,
		@total_pl float output,
		@display_output varchar(10)=NULL,
		@include_positions varchar(10)=NULL
as


declare @start_date datetime
declare @stop_date datetime
declare @evaluation_currency_id int
declare @source_id int
declare @run_id int
declare @fund_id int
declare @total_realized_pl float
declare @fx_realized_pl float
declare @options_realized_pl float
declare @fx_unrealized_pl float
declare @options_unrealized_pl float
declare @pos_pl float
declare @pos_end_evaluation_total float
declare @trades_end_evaluation_total float
declare @trades_pl float
declare @evaluation_currency varchar(20)
declare @source varchar(30)
declare @open_equity float
declare @total_equity float

declare @id int
declare @external_account_id int
declare @external_accounts int
declare @external_account varchar(50)
declare @total_amount float
declare @contract_id int
declare @contracts int
declare @symbol varchar(50)
declare @total_begin_unrealized float
declare @total_end_unrealized float
declare @total_settled_premium float
declare @total_unsettled_premium float
declare @total_evaluation_premium float
declare @total_premium float
declare @total_realized float
declare @total_fwd_unrealized float
declare @total_end_fwd_unrealized float
declare @total_fwd_realized float
declare @total_opt_unrealized float
declare @total_opt_value float
declare @total_exotic_unrealized float
declare @total_exotic_value float
declare @total_fwd_value float
declare @total_volume float
declare @begin_date datetime
declare @end_date datetime

declare @value_dates int
declare @value_date datetime
declare @net_equiv float

declare @include_trade_blotter char(1)

declare @image_path varchar(200)


select
	@image_path = path
from
	image_paths
where
	name = "Daily MTM PL"

/*select _ = '<img id="report-logo" src="'+rtrim(@image_path)+'">', __ = '<style type="text/css">#report-logo { position:absolute; top:0, right:0 }</style>'*/

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output
	



select
	@include_trade_blotter = "Y"

if lower(convert(char(1), @display_output)) = "y"
	exec
		cbo_plstatementlinks
			@login

if @include_positions = NULL
	select
		@include_positions = "Y"

exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end


create table
	#transaction_nets(
		external_account_id int,
		transaction_type_id int,
		amount float,
		min_date datetime,
		max_date datetime)
insert into
	#transaction_nets
select
	a.external_account_id,
	a.transaction_type_id,
	sum(a.amount),
	min(a.transaction_date),
	max(a.transaction_date)
from
	account_transactions a,
	run_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.run_id = @run_id
and
	a.transaction_date <= @end_date
group by
	a.external_account_id,
	a.transaction_type_id
		
create table
	#account_summary(
		id int identity,
		external_account_id int NULL,
		account varchar(50) NULL,
		transaction_type varchar(50) NULL,
		total float NULL,
		last_activity datetime NULL)	

insert into
	#account_summary(
		external_account_id,
		account,
		transaction_type,
		total,
		last_activity)
select
	a.external_account_id,
	b.symbol,
	c.name,
	a.amount,
	a.max_date
from
	#transaction_nets a,
	external_accounts b,
	transaction_types c
where
	a.transaction_type_id = c.transaction_type_id
and
	a.external_account_id = b.external_account_id
order by
	b.symbol,
	a.min_date


create table
	#account_output(
		id int identity,
		style varchar(250) NULL,
		account varchar(50) NULL,
		transaction_type varchar(50) NULL,
		total float NULL,
		last_activity datetime NULL)



select
	@external_account_id = 0
select
	@external_accounts = count(*)
from
	#account_summary
where
	external_account_id > @external_account_id


while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		#account_summary
	where
		external_account_id > @external_account_id


	select
		@external_account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	insert into
		#account_output(
			style,
			account,
			transaction_type,
			total,
			last_activity)
	select
		style = "background:#FFFFFF;border: 1px solid white",
		account,
		transaction_type,
		total,
		last_activity
	from
		#account_summary	
	where
		external_account_id = @external_account_id
	order by
		id

	select
		@total_amount = sum(total)
	from
		#account_summary
	where
		external_account_id = @external_account_id


	select
		@external_account = "Total Cash (" + rtrim(@external_account) + ")"

	insert into
		#account_output(
			style,
			transaction_type,
			total)
	values(
		"background:#F2F2F2;border: 1px solid white",
		@external_account,
		@total_amount)


	select
		@external_accounts = count(*)
	from
		#account_summary
	where
		external_account_id > @external_account_id
end 

select
	@total_amount = sum(total)
from
	#account_output
where
	transaction_type like "Total Cash%"

insert into
	#account_output(
		style,
		transaction_type,
		total)
values(
	"background:#F2F2F2;border: 1px solid white",
	"Total Cash All Accounts",
	@total_amount)


select
	@start_date = @begin_date,
	@stop_date = @end_date

select
	@evaluation_currency_id = evaluation_currency_id,
	@source_id = source_id
from
	run_defaults
where
	run_id = @run_id
if @evaluation_currency_id = NULL
begin
	select
		@evaluation_currency_id = evaluation_currency_id,
		@source_id = source_id
	from
		fund_run_defaults
	where
		fund_id = @fund_id

	if @evaluation_currency_id = NULL
	begin
		select
			id = -1,
			error = "Unable to determine default run settings"
		return
	end
end


