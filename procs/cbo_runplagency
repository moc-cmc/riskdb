declare @vdid int
declare @vd_contracts int
declare @vd datetime 
declare @vd_symbol varchar(50)
declare @vd_start_pos float
declare @vd_pos_pl float
declare @vd_trade_pos float
declare @vd_trade_pl float

select
	@vdid = 0
select
	@vd_contracts = count(*)
from
	#value_date_contracts
where
	id > @vdid

while @vd_contracts > 0
begin
	select
		@vdid = min(id)
	from
		#value_date_contracts
	where
		id > @vdid

	select
		@vd_start_pos = 0.0,
		@vd_pos_pl = 0.0,
		@vd_trade_pos = 0.0,
		@vd_trade_pl = 0.0,
		@contract_id= NULL,
		@vd= NULL,
		@vd_symbol= NULL


	select
		@contract_id = contract_id,
		@vd = value_date,
		@vd_symbol = symbol
	from
		#value_date_contracts
	where
		id = @vdid


	select
		@vd_start_pos = sum(b.quantity * -1),
		@vd_pos_pl = sum((b.unrealized_range * -1) + (b.realized_range * -1))
	from
		#value_date_summary a,
		#trade_revals b
	where
		a.contract_id = b.contract_id
	and
		a.value_date = b.value_date
	and
		convert(char(11), b.trade_date, 1) < convert(char(11), @end_date, 1)
	and
		b.contract_id = @contract_id
	and
		b.value_date = @vd
	group by
		a.contract_id,
		a.value_date

	update
		#value_date_summary
	set
		symbol = @vd_symbol,
		starting_pos = @vd_start_pos,
		pos_profit_loss = @vd_pos_pl
	where	
		contract_id = @contract_id
	and
		value_date = @vd

	
	select
		@vd_trade_pos = sum(b.quantity * -1),
		@vd_trade_pl = sum((b.unrealized_range * -1) + (b.realized_range * -1))
	from	
		#value_date_summary a,
		#trade_revals b
	where
		a.contract_id = b.contract_id
	and
		a.value_date = b.value_date
	and
		convert(char(11), b.trade_date, 1) = convert(char(11), @end_date, 1)
	and
		b.contract_id = @contract_id
	and
		b.value_date = @vd
	group by
		a.contract_id,
		a.value_date
		
	
	update
		#value_date_summary
	set
		symbol = @vd_symbol,
		trades_quantity = @vd_trade_pos,
		trading_profit_loss = @vd_trade_pl
	where   
		contract_id = @contract_id
	and
		value_date = @vd

	select
		@vd_contracts = count(*)
	from
		#value_date_contracts
	where
		id > @vdid
end

		

update
       	#value_date_summary
set
       	total_position = starting_pos + trades_quantity,
