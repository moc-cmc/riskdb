		transaction_type,
		total)
values(
	"background:#F2F2F2;border: 1px solid white",
	"Total Open Equity",
	@open_equity)

select
	@total_equity = @open_equity + @total_amount

insert into
	#account_output(
		style,
		transaction_type,
		total)
values(
	"background:#F2F2F2;border: 1px solid white",
	"Total Equity",
	@total_equity)


