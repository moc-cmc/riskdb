select
	@pos_pl = sum(a.realized_range_pl + a.unrealized_range_pl)
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id
and
	b.trade_date <= @start_date

select
	@trades_pl = sum(a.realized_range_pl + a.unrealized_range_pl)
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id
and
	b.trade_date > @start_date


select
	@total_pl = sum(realized_range_pl + unrealized_range_pl),
	@total_volume = sum(volume)
from
	#trades

if lower(convert(char(1), @display_output)) = "y"
	select
		style = "background:#FFFFFF;border: 1px solid white",
		position_pl = @pos_pl * -1.0,
		trades_pl = @trades_pl * -1.0,
		total_pl = @total_pl * -1.0,
		total_volume = @total_volume

if lower(convert(char(1), @display_output)) = "y"
	select
		style = "background:#FFFFFF;border: 1px solid white",
		disclaimer = disclaimer,
		_ = '<img id="report-logo" src="'+rtrim(@image_path)+'">'
	from
		report_disclaimers
	where
		name = "Daily MTM PL"

