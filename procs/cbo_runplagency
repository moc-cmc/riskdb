create table
	#trades(
		trade_id int,
		contract_id int,
		total_premium float NULL,
		premium_currency varchar(30) NULL,
		evaluation_premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized_pl_to_date float NULL,
		end_realized_pl_to_date float NULL,
		begin_unrealized_pl_to_date float NULL,
		end_unrealized_pl_to_date float NULL,
		realized_range_pl float NULL,
		unrealized_range_pl float NULL,
		end_evaluation_value float NULL,
		settle_price float NULL,
		volume float NULL)


/*
 * Find any trades that existed before the range starts
 * @start_date >= bo_trade_date <= @stop_date
 */
if lower(@include_positions) like "%y%"
begin
	insert into
		#trades(
			trade_id,
			contract_id,
			begin_realized_pl_to_date,
			begin_unrealized_pl_to_date,
			volume)
	select
		a.trade_id,
		a.contract_id,
		realized_pl_to_date,
		unrealized_pl_to_date,
		volume = 0.0 /* Don't count the volume of existing positions */
	from
		committed_daily_revals a,
		trades b,
		#external_accounts c,
		#internal_accounts d,
		#traders e,
		#strategies f,
		#brokers g 
	where
		a.trade_id = b.trade_id
	and
		b.external_account_id = c.external_account_id
	and
		b.internal_account_id = d.internal_account_id
	and
		b.trader_id = e.trader_id
	and
		b.strategy_id = f.strategy_id
	and
		b.broker_id = g.broker_id
	and
		a.bo_trade_date < @start_date
	and
		a.value_date >= @start_date
	and
		a.reval_date = @start_date
	and
		a.source_id = @source_id
	and
		a.evaluation_currency_id = @evaluation_currency_id
end


/*
 * Find any trades that were done during the range
 */
insert into
	#trades(
		trade_id,
		contract_id,
		begin_realized_pl_to_date,
		begin_unrealized_pl_to_date,
		end_evaluation_value,
		settle_price,
		volume)
select
	a.trade_id,
	a.contract_id,
	realized_pl_to_date = 0.0,
	unrealized_pl_to_date = 0.0,
	a.evaluation_value,
	a.close_price,
	a.evaluation_notional
from
	committed_daily_revals a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g 
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.broker_id = g.broker_id
and
	a.value_date >= @start_date
and
	a.bo_trade_date >= @start_date
and
	a.bo_trade_date < @stop_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id


update
	#trades
set
	a.end_realized_pl_to_date = b.realized_pl_to_date,
	a.end_unrealized_pl_to_date = b.unrealized_pl_to_date,
	a.realized_range_pl = b.realized_pl_to_date - a.begin_realized_pl_to_date,
	a.unrealized_range_pl = b.unrealized_pl_to_date - a.begin_unrealized_pl_to_date,
	a.settle_price = b.close_price,
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id
and
	convert(char(11), b.reval_date, 1) = convert(char(11), b.value_date, 1)
and
	b.reval_date <= @stop_date /* TEST */


update
	#trades
set
	a.end_realized_pl_to_date = b.realized_pl_to_date,
	a.end_unrealized_pl_to_date = b.unrealized_pl_to_date,
	a.realized_range_pl = b.realized_pl_to_date - a.begin_realized_pl_to_date,
	a.unrealized_range_pl = b.unrealized_pl_to_date - a.begin_unrealized_pl_to_date,
	a.settle_price = b.close_price,
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.reval_date = @stop_date
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id


update
	#trades
set
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	datepart(day, b.reval_date) = datepart(day, b.value_date)
and
	datepart(month, b.reval_date) = datepart(month, b.value_date)
and
	datepart(year, b.reval_date) = datepart(year, b.value_date)
and
	b.reval_date <= @stop_date


update
	#trades
set
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	a.end_evaluation_value is NULL
and
	b.reval_date = @stop_date


update
	#trades
set
	a.end_unrealized_pl_to_date = 0,
	a.unrealized_range_pl = 0
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	a.unrealized_range_pl is NULL


update
	#trades
set
	a.total_premium = b.premium,
	a.evaluation_premium = b.evaluation_premium,
	a.premium_currency = c.symbol,
	a.premium_settle_date = b.premium_settle_date
from
	#trades a,
	committed_daily_revals b,
	products c
where
	a.trade_id = b.trade_id
and
	b.premium_ccy_id = c.product_id
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id
and
	b.source_id = @source_id
	


select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

select
	@source = name
from
	sources
where
	source_id = @source_id

if lower(convert(char(1), @display_output)) = "y"
	select
		style = "background:#FFFFFF;border: 1px solid white",
		run_name = @run_name,
		begin_date = @start_date,
		end_date = @stop_date,
		run_date = getdate(),
		evaluation_currency = @evaluation_currency,
		evaluation_source_id = @source,
		/*export='<button onclick="window.print()">Print</button>'*/
		export='<a href="#" onclick="window.print()">PRINT STATEMENT</a>'/*,
		_ = '<img id="report-logo" src="'+rtrim(@image_path)+'">'
		__ = '<style type="text/css">#report-logo { position:absolute; top:0, right:0 }</style>'*/


create table
	#reval_output(
		id int identity,
		style varchar(250) NULL,
		trade_id int NULL,
		trade_date char(11) NULL,
		external_account_id int NULL,
		trader_id int NULL,
		counterparty_id int NULL,
		external_account varchar(50) NULL,
		trader varchar(50) NULL,
		counterparty varchar(50) NULL,
		contract_id int NULL,
		underlying_forward_id int NULL,
		perspective_contract_id int NULL,
		symbol varchar(50),
		quantity numeric(30,4) NULL,
		price float NULL,
		value_date varchar(11) NULL,
		premium float NULL,
		premium_currency varchar(50) NULL,
		evaluation_premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized float NULL,
		end_realized float NULL,
		begin_unrealized float NULL,
		end_unrealized float NULL,
		realized_range float NULL,
		unrealized_range float NULL,
		ending_valuation float NULL,
		settle_price float NULL,
		previous_settle float NULL,
		change float NULL,
		total_pl float NULL,
		volume float NULL)

create table
	#trade_revals(
		trade_id int,
		trade_date char(11),
		external_account_id int NULL,
		trader_id int NULL,
		counterparty_id int NULL,
		contract_id int,
		underlying_forward_id int NULL,
		perspective_contract_id int NULL,
		symbol varchar(50),
		quantity numeric(30,4),
		price float,
		value_date varchar(11),
		premium float NULL,
		premium_currency varchar(50) NULL,
		evaluation_premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized float NULL,
		end_realized float NULL,
		begin_unrealized float NULL,
		end_unrealized float NULL,
		realized_range float NULL,
		unrealized_range float NULL,
		ending_valuation float NULL,
		settle_price float NULL,
		previous_settle float NULL,
		change float NULL,
		volume float NULL)
insert into
	#trade_revals
select
	a.trade_id,
	trade_date = convert(char(11), b.trade_date, 1),
	b.external_account_id,
	b.trader_id,
	b.counterparty_id,
	a.contract_id,
	underlying_forward_id = NULL,
	perspective_contract_id = NULL,
	c.symbol,
	b.quantity,
	b.price,
	value_date = convert(char(11), (select max(d.value_date) from committed_daily_revals d where a.trade_id = d.trade_id), 1),
	premium = a.total_premium,
	a.premium_currency,
	a.evaluation_premium,
	a.premium_settle_date,
	begin_realized = a.begin_realized_pl_to_date,
	end_realized = a.end_realized_pl_to_date,
	begin_unrealized = a.begin_unrealized_pl_to_date,
	end_unrealized = a.end_unrealized_pl_to_date,
	realized_range = a.realized_range_pl,
	unrealized_range = a.unrealized_range_pl,
	ending_valuation = a.end_evaluation_value,
	settle_price = a.settle_price,
	NULL,	
	NULL,
	volume = a.volume
from
	#trades a,
	trades b,
	contracts c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id

update 
	#trade_revals
set
	previous_settle = b.close_price,
	change = a.settle_price - b.close_price
from
	#trade_revals a,
	committed_daily_revals b,
	contracts c
where
	a.symbol = c.symbol
and
	b.contract_id = c.contract_id 
and
	convert(char(11), b.reval_date, 1) != convert(char(11), b.bo_trade_date, 1)

update
	#trade_revals
set
	previous_settle = NULL,
	change = a.settle_price - a.price
from
	#trade_revals a
where
	convert(char(11), a.trade_date, 1) = convert(char(11), @end_date, 1)



update
	#trade_revals
set
	a.underlying_forward_id = a.contract_id
from
	#trade_revals a,
	forwards b
where
	a.contract_id = b.contract_id


update
	#trade_revals
set
	a.underlying_forward_id = c.forward_id
from
	#trade_revals a,
	future_contracts b,
	futures c
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id

update
	#trade_revals
set
	a.underlying_forward_id = f.forward_id
from
	#trade_revals a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.future_id = f.future_id


update
	#trade_revals
set
	a.underlying_forward_id = e.contract_id
from
	#trade_revals a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id

update
	#trade_revals
set
	a.underlying_forward_id = e.contract_id
from
	#trade_revals a,
	exotic_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id


update
	#trade_revals
set
	perspective_contract_id = underlying_forward_id

update
	#trade_revals
set
	a.perspective_contract_id = b.perspective_contract_id
from
	#trade_revals a,
	run_perspective_contracts b
where
	a.underlying_forward_id = b.contract_id
and
	b.run_id = @run_id
if @@rowcount = 0
begin
	update
		#trade_revals
	set
		a.perspective_contract_id = b.perspective_contract_id
	from
		#trade_revals a,
		def_perspective_contracts b
	where
		a.underlying_forward_id = b.contract_id
end

/* Ladder start */

create table
	#products(
		product_id int,
		value_date datetime,
		quantity numeric(30,4))
insert into
	#products
select
	c.product_id,
	b.value_date,
	b.quantity * -1.0
from
	#trades a,
	trades b,
	forwards c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
	
insert into
	#products
select
	c.currency_id,
	b.value_date,
	b.quantity * b.price
from
	#trades a,
	trades b,
	forwards c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id

create table
	#balances(
		product_id int,
		value_date datetime,
		quantity float,
		evaluation_value float NULL)
insert into
	#balances(
		product_id,
		value_date,
		quantity)
select
	product_id,
	value_date,
	sum(quantity)
from
	#products
group by
	product_id,
	value_date

update
	#balances
set
	evaluation_value = quantity
where
	product_id = @evaluation_currency_id


update
	#balances
set
	a.evaluation_value = a.quantity * c.price
from
	#balances a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#balances
set
	a.evaluation_value = a.quantity * (1.0 / c.price)
from
	#balances a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)



create table
	#ladder(
		id int identity,
		style varchar(250) NULL,
		value_date datetime NULL,
		symbol varchar(50) NULL,
		quantity float NULL,
		equiv float NULL,
		total varchar(100) NULL)

select
	@value_date = dateadd(day, -1, min(value_date))
from
	#balances

select
	@value_dates = count(*)
from
	#balances
where
	value_date > @value_date


while @value_dates > 0
begin
	select
		@value_date = min(value_date)
	from
		#balances
	where
		value_date > @value_date


	select
		@net_equiv = sum(evaluation_value)
	from
		#balances
	where
		value_date = @value_date

	insert into
		#ladder(
			style,
			value_date,
			symbol,
			quantity,
			equiv)
	select
		style = "background:#FFFFFF;border: 1px solid white",
		a.value_date,
		b.symbol,
		a.quantity,
		a.evaluation_value
	from
		#balances a,
		products b
	where
		a.product_id = b.product_id
	and
		a.value_date = @value_date
	order by
		b.symbol	


	insert into
		#ladder(
			style,
			equiv,
			total)
	values(
		"background:#F2F2F2;border: 1px solid white",
		@net_equiv,
		rtrim(convert(varchar(11), @value_date)) + " (" + rtrim(@evaluation_currency) + ")")
			

	select
		@value_dates = count(*)
	from
		#balances
	where
		value_date > @value_date

end

/* find the total equity value of open positions */
select
	@open_equity = sum(a.end_unrealized_pl_to_date) * -1.0
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id
and
	b.value_date > @stop_date

if @open_equity = NULL
	select
