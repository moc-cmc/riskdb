use
	risk_firsel
go

drop procedure
	lw_editjurisdictionflow
go

create procedure
	lw_editjurisdictionflow
		@login varchar(50),
		@identifier varchar(50),
		@collection_model varchar(200),
		@jurisdiction varchar(100),
		@collection_event varchar(50),
		@days_offset int,
		@fixed_cost float,
		@settlement_offset int,
		@collection_rate float,
		@confidence_rating float
as

declare @tico_account_id int
declare @collection_model_id int
declare @jurisdiction_id int
declare @collection_event_id int
declare @id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@id = id
from
	jurisdiction_flows
where
	id = convert(int, @identifier)

if @id != NULL
begin

select
	@collection_model_id = collection_model_id
from
	collection_models
where
	name = @collection_model
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Collection model not found",
		collection_model = @collection_model
	return
end

select
	@jurisdiction_id = jurisdiction_id
from
	jurisdictions
where
	name = @jurisdiction
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Jurisdiction not found",
		jurisdiction = @jurisdiction
	return
end

select
	@collection_event_id = strategy_id
from
	strategies
where
	name = @collection_event
if @@rowcount != 1
begin
	exec
		j_nextkey
			"strategies",
			@collection_event_id output

	insert into
		strategies(
			strategy_id,	
			name)
	values(
		@collection_event_id,
		@collection_event)
end

update
	jurisdiction_flows
set	
	collection_model_id = @collection_model_id,
	jurisdiction_id = @jurisdiction_id,
	collection_event_id = @collection_event_id,
	offset_days = @days_offset,
	fixed_cost = @fixed_cost,
	settlement_offset = @settlement_offset,
	collection_rate = @collection_rate,
	confidence= @confidence_rating
where
	id = @id
	
end


exec
	lw_modelflows
		@login,
		@collection_model


go
