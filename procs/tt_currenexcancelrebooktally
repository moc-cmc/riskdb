drop procedure 
	tt_currenexcancelrebooktally
go

create procedure
	tt_currenexcancelrebooktally
        	@agent varchar(50),
        	@source varchar(50),
        	@cli_source varchar(50),
        	@default_login varchar(50),
        	@trade_report_id varchar(50),
        	@trade_id varchar(50),
        	@trade_request_id varchar(50),
        	@trade_type varchar(10),
        	@trade_match_id varchar(50),
        	@secondary_exec_id varchar(50),
        	@previously_reported char(1),
        	@exec_type varchar(15),

        	@intermediary_firm varchar(50),
        	@intermediary_trader varchar(50),
        	@exec_firm varchar(50),
        	@exec_trader varchar(50),
        	@order_orig_firm varchar(50),
        	@order_orig_trader varchar(50),
        	@giveup_clearing_firm varchar(50),

        	@side varchar(5),
        	@account varchar(50),

        	@symbol varchar(50),
        	@symbol_suffix varchar(15),
        	@product varchar(15),
        	@quantity numeric(30,6),
        	@price float,
        	@calc_ccy_last_qty float,
        	@currency varchar(5),
        	@settle_currency varchar(5),
        	@spot_ref float,
        	@trade_date datetime,
        	@transact_date datetime,
        	@value_date datetime,
        	@order_qty2 numeric(30,6),
        	@far_date datetime,
        	@last_swap_points numeric(30, 10),
        	@calc_ccy_last_qty2 numeric(30,6)
as

/* _ids */
declare @committed_status_id int
declare @rebook_status_id int
declare @source_id int

declare @trd_tico_account_id int
declare @trd_tally_type_id int
declare @trd_deal_type_id int
declare @trd_deal_status_id int
declare @trd_trade_type_id int
declare @trd_internal_account_id int
declare @trd_external_account_id int
declare @trd_counterparty_id int
declare @trd_contract_id int
declare @trd_trader_id int
declare @trd_strategy_id int
declare @trd_status_id int
declare @trd_broker_id int
declare @trd_sales_code_id int

/* lookups */
declare @lookup_trader varchar(50)
declare @lookup_cpty varchar(50)
declare @lookup_ext_acct varchar(50)
declare @lookup_broker varchar(50)

/* trade values */
declare @trd_login char(25)
declare @trd_source varchar(50)
declare @trd_trade_id int 
declare @trd_deal_id int 
declare @trd_tally_type varchar(25)
declare @trd_deal_type varchar(50)
declare @trd_trade_type varchar(25)
declare @trd_internal_account varchar(50)
declare @trd_external_account varchar(50)
declare @trd_counterparty varchar(50)
declare @trd_quantity numeric(30,4)
declare @trd_symbol varchar(50)
declare @trd_value_date datetime
declare @trd_price float
declare @trd_trade_date datetime
declare @trd_trader varchar(25)
declare @trd_strategy varchar(50)
declare @trd_status varchar(50)
declare @trd_broker varchar(50)
declare @trd_identifier varchar(100)
declare @trd_sales_code varchar(25)
declare @trd_premium float
declare @trd_premium_currency varchar(25)
declare @trd_prem_settle_date datetime
declare @trd_pct_price float
declare @trd_spot_reference float
declare @trd_fixing_date datetime
declare @quoted_price float

declare @trd_deal_status varchar(50)
declare @deal_exec_symbol varchar(100)
declare @trader_login varchar(50)

/* logic */
declare @trd_external_account_type varchar(50)
declare @inv_symbol varchar(50)
declare @quote_symbol varchar(50)
declare @inverted char(1)
declare @sign int
declare @aggregation_style varchar(25)
declare @aggregation_style_id int
declare @cpty_ext_acct_id int



/*
 |  MAP values
 */

select
	@lookup_trader = @order_orig_trader,
	@lookup_cpty = @intermediary_firm,
	@lookup_ext_acct = @order_orig_firm


/*
 | LOOKUP statuses
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"
if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

select
    @rebook_status_id = status_id
from
    statuses
where
    name = "Rebook"
if @rebook_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Rebook'"
    return
end

/*
 |  LOOKUP source
 */
select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		msg = "Problem determining source",
		source = @source
end

/*
 * LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 */ 

select
	@trd_trader_id = a.trader_id,
	@trd_trader = a.symbol,
	@trader_login = c.login,
	@trd_external_account_id = a.external_account_id
from
        traders a,
        trader_symbols b,
        tico_accounts c
where    
        a.trader_id = b.trader_id
and
        b.source_id = @source_id
and
        a.tico_account_id = c.account_id
and 
        b.symbol = @lookup_trader

if @trd_trader_id = NULL or @trader_login = NULL
begin
    select
            @trd_trader_id = a.trader_id,
            @trd_trader = a.symbol,
            @trader_login = c.login,
            @trd_external_account_id = a.external_account_id
    from
            traders a,
            tico_accounts c
    where    
            a.tico_account_id = c.account_id
    and 
            a.symbol = @lookup_trader

    if @trd_trader_id = NULL or @trader_login = NULL
    begin
	select
            status = "Error",
            message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            lookup_trader = @lookup_trader
        return
    end		
end

/*
 * LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 */

select
	@trd_counterparty_id = a.counterparty_id,
	@trd_counterparty = a.name,
	@cpty_ext_acct_id = a.external_account_id
from
        counterparties a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id
and
        b.symbol = @lookup_cpty
if @trd_counterparty = NULL
begin
        select
                @trd_counterparty_id = a.counterparty_id,
		@trd_counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
        from
                counterparties a
        where
                a.name = @lookup_cpty
        
        if @trd_counterparty = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
			lookup_cpty = @lookup_cpty
                return
        end
end


/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @trd_external_account = a.symbol,
    @trd_external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @trd_external_account_id
if @trd_external_account = NULL
begin
	select
		status = "Error",
		message = "Couldn't find external_account from @trd_external_account_id",
		external_account_id = @trd_external_account_id
	return
end


select
	@quote_symbol = substring(@symbol, 1, 3) + substring(@symbol, 5, 3),
	@trd_symbol = @currency + @settle_currency,
	@inv_symbol = @settle_currency + @currency

select
	@inverted = case when @quote_symbol = @inv_symbol then "Y" else "N" end,
	@sign = case lower(@side) when "buy" then -1 else 1 end /* opposite since this is client trade */

select
	@trd_trade_type = "Spot",
	@trd_deal_type = "Cancel/Rebook",
	@trd_login = @trader_login,
	@trd_source = @source,
	@trd_tally_type = "Spot",
	@trd_trade_type = "Spot",
	@trd_quantity = @quantity * @sign,
	@trd_value_date = @value_date,
	@trd_price = @price,
	@trd_trade_date = @transact_date,
	@trd_strategy = NULL,
	@trd_status = "Rebook",
	@trd_identifier = rtrim(@trade_id) + ".c",
        @deal_exec_symbol = rtrim(@trade_id),
	@trd_premium = NULL,
	@trd_premium_currency = NULL,
	@trd_prem_settle_date = NULL,
	@trd_pct_price = NULL,
	@trd_spot_reference = @spot_ref,
	@trd_fixing_date = NULL,
	@quoted_price = @price


if @trd_broker = NULL
	select
		@trd_broker = 'Currenex'



select
	@trd_deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_exec_symbol


if @trd_deal_id = NULL
begin
	select
		@trd_deal_status_id = status_id
	from
		statuses
	where
		name = "Committed"
	if @trd_deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'Committed'"
		return
	end
	select
		@trd_deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @trd_deal_type
	if @trd_deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @trd_deal_type",
			deal_type = @trd_deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@trd_deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@trd_deal_id,
			@trd_deal_type_id,
			getdate(),
			@trd_deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@trd_deal_id,
		@deal_exec_symbol
    )
end




create table
	#trade_output
(
	status varchar(25) NULL,
	ttype varchar(15) NULL,
	trade_id int NULL,
	deal_id int NULL,
	ext_acct varchar(25) NULL,
	cpty varchar(25) NULL,
	ct varchar(25) NULL,
	qty float NULL,
	price float NULL,
	trader varchar(50) NULL,
	identifier varchar(50) NULL,
	vald datetime NULL,
	trd_status varchar(10) NULL
)
	
if @trd_quantity != NULL
begin
        
        exec
            fxa_tallytrade
                @login = @trader_login,
                @source = @source,
                @trade_id = @trd_trade_id out,
                @deal_id = @trd_deal_id out,
                @tally_type = @trd_tally_type,
                @deal_type = @trd_deal_type,
                @trade_type = @trd_trade_type,
                @external_account = @trd_external_account,
                @counterparty = @trd_counterparty,
                @quantity = @trd_quantity,
                @symbol = @trd_symbol,
                @value_date = @trd_value_date,
                @price = @trd_price,
                @trade_date = @trd_trade_date,
                @trader = @trd_trader,
                @status = @trd_status,
                @broker = @trd_broker,
                @identifier = @trd_identifier,
                @spot_reference = @trd_spot_reference

        if @trd_trade_id = NULL
        begin
            select
                status = "Error",
                message = "Failed to tally trade"
            return
        end
       
	insert into
		#trade_output
	values(
		"Trade Tallied",
                "C/R",
		 @trd_trade_id,
	       	 @trd_deal_id,
		 @trd_external_account,
		@trd_counterparty,
		@trd_symbol,
		@trd_quantity,
		@trd_price,
		@trd_trader,
		@trd_identifier,
		@trd_value_date,
		@trd_status
	)

end


/*
 | EXEC r_inserttradenotification: Send out trade notifications
 */
/* -- chriso: notification called in the risk server so that cancels and rebooks are all notified at the same time
if @trd_trade_id != NULL
    exec
        r_inserttradenotification
            @trd_trade_id
*/

/* -- chriso: no autocommit to start 
/* 
 | AUTOCOMMIT
 |
 | If there is a client trade in this deal and the account type is set for
 | Autocommit, then push through this deal automatically.
 */
if @trd_deal_id != NULL and @trd_trade_id != NULL and @aggregation_style = "Autocommit"
begin

    update
        deals
    set
        status_id = @committed_status_id
    where
        deal_id = @trd_deal_id
    
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for client external account, '" + @trd_external_account + "', an aggregation style, '" + @trd_aggregation_style + "'"
    end

end
else
begin
    select
        message = "No autocommitted",
        trd_deal_id = @trd_deal_id,
        trd_trade_id = @trd_trade_id,
        aggregation_style = @aggregation_style
end
-- */

/*
 * SHOW trades: Dump information about these trades
 */
select
	*
from
	#trade_output


select
	cancel_rebook_deal = @trd_deal_id

go
