
if object_id("cm_runtraderfilters") != NULL
    drop procedure
        cm_runtraderfilters
go

create procedure
	cm_runtraderfilters
		@login varchar(30),
		@run_name varchar(50)
as

declare @run_id int

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Column Link",
	"exclude",
	"Configure Run Trader",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"include",
	"Configure Run Trader",
	NULL,
	NULL)

insert into
	#links
values(
	"Format Number",
	"trader",
	NULL,
	NULL,
	"#")
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	a.name = @run_name
and
	c.login = @login
	


create table
	#output(
		run_name varchar(50),
		trader_id int,
		trader varchar(50),
		is_included varchar(10) NULL,
		include varchar(20) NULL,
		exclude varchar(20) NULL)

insert into
	#output(
		run_name,
		trader_id,
		trader,
		is_included,
		include)
select
	run_name = @run_name,
	trader_id,
	symbol,
	is_included = "NO",
	include = "INCLUDE TRADER"
from
	traders

update
	#output
set
	a.is_included = "YES",
	a.include = NULL,
	a.exclude = "EXCLUDE TRADER"
from
	#output a,
	run_traders b
where
	a.trader_id = b.trader_id
and
	b.run_id = @run_id


select
	run_name,
	trader,
	is_included,
	include,
	exclude
from
	#output
order by
	trader



go
