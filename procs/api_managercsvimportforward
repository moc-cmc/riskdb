
if object_id("api_managercsvimportforward") != NULL
    drop procedure
        api_managercsvimportforward
go

create procedure 
	api_managercsvimportforward
		@login varchar(50)=NULL,
		@identifier varchar(100)=NULL,
		@deal_identifier varchar(100)=NULL,
		@report_type varchar(15)=NULL,
		@trade_type varchar(15)=NULL,
		@trade_date varchar(25)=NULL,
		@trading_party varchar(50)=NULL,
		@account varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@traded_currency varchar(10)=NULL,
		@counter_currency varchar(10)=NULL,
		@value_date varchar(25)=NULL,
		@fixing_date varchar(25)=NULL,
		@quantity varchar(25)=NULL,
		@buy_sell varchar(15)=NULL,
		@price varchar(25)=NULL,
		@spot_reference varchar(25)=NULL,
		@counter_party varchar(50)=NULL,
		@broker varchar(25)=NULL,
		@source varchar(50)=NULL,
		@far_value_date varchar(25)=NULL,
		@far_price varchar(25)=NULL,
		@far_fixing_date varchar(25)=NULL,
		@block_trade varchar(10)=NULL,
		@allocation_template varchar(50)=NULL,
		@pipping_schedule varchar(50)=NULL,
		@strategy varchar(25)=NULL

as

declare @tally_source varchar(50)
declare @tally_trade_type varchar(50)
declare @tally_tally_type varchar(50)
declare @tally_trader_type varchar(50)
declare @tally_trader varchar(50)
declare @tally_external_account varchar(50)
declare @tally_counterparty varchar(50)
declare @tally_quantity numeric(30, 8)
declare @tally_symbol varchar(50)
declare @tally_price float
declare @tally_trade_date datetime
declare @tally_value_date datetime
declare @tally_fixing_date datetime
declare @tally_sales_code varchar(50)
declare @tally_identifier varchar(100)
declare @tally_far_trade_type varchar(50)
declare @tally_far_price float
declare @tally_far_quantity numeric(30, 8)
declare @tally_far_value_date datetime
declare @tally_far_fixing_date datetime
declare @tally_spot_reference float
declare @tally_strategy varchar(50)
declare @tally_broker varchar(50)
declare @tally_pipping_schedule varchar(50)

declare @source_id int
declare @trade_id int
declare @deal_id int
declare @deployment_date datetime
declare @ma_version_id int

/* Attempt to find the @source */
select
    @source_id = source_id,
    @tally_source = name
from
    sources
where
    name = @source
if @tally_source = NULL
begin
    select
        @source_id = source_id,
        @tally_source = name
    from
        sources
    where
        lower(str_replace(name, " ", NULL)) = lower(str_replace(@source, " ", NULL))
    if @tally_source = NULL
    begin
        select
            status = "Error",
            message = "Source not found",
            source = @source
        return
    end
end

/* Conversions */
select
    @tally_identifier = @identifier,
    @tally_trade_type = @trade_type,
	@tally_price = convert(float, @price),
	@tally_quantity = abs(convert(numeric(30, 8), @quantity)),
	@tally_trade_date = convert(datetime, stuff(stuff(@trade_date, 14, 0, ":"), 12, 0, ":")),
	@tally_value_date = convert(datetime, convert(char(8), @value_date, 112)),
	@tally_fixing_date = convert(datetime, convert(char(8), @fixing_date, 112)),
	@tally_far_price = convert(float, @far_price),
	@tally_far_value_date = convert(datetime, convert(char(8), @far_value_date, 112)),
	@tally_far_fixing_date = convert(datetime, convert(char(8), @far_fixing_date, 112)),
	@tally_spot_reference = convert(float, @spot_reference),
    @tally_sales_code = "None"

if @pipping_schedule != NULL and @pipping_schedule != ""
    select
        @tally_pipping_schedule = @pipping_schedule

/* Only s */
if @trade_type = "Spot"
begin
    select
        @tally_tally_type = "Spot",
        @tally_trade_type = "Spot"
end
else if @trade_type = "Forward"
begin
    select
        @tally_tally_type = "Forward",
        @tally_trade_type = "Forward"
end
else if @trade_type = "Swap"
begin
    select
        @tally_tally_type = "Swap",
        @tally_trade_type = "Swap Near",
        @tally_far_trade_type = "Swap Far"
end
else if @trade_type = "Future"
begin
    select
        @tally_tally_type = "Future",
        @tally_trade_type = "Future"
end
else if @trade_type = "Option"
begin
    select
        @tally_tally_type = "Option",
        @tally_trade_type = "Option"
end
else
begin
    select
        status = "Error",
        message = "trade_type must be one of Spot, Forward, Swap, Future or Option",
        trade_type = @trade_type
    return
end

if @buy_sell in("SELL", "BUYSELL")
begin
	select
		@tally_quantity = @tally_quantity * -1,	
		@tally_far_quantity = @tally_quantity * -1
end
if @buy_sell in("SELLBUY")
begin
	select
		@tally_far_quantity = @tally_quantity * -1

end

/* Re-Assignments */
select
	@tally_symbol = rtrim(@traded_currency) + rtrim(@counter_currency),
	@tally_strategy = @strategy

if not exists(select contract_id from contracts where symbol = @tally_symbol)
begin
	select
		message = "Contract not found",
		contract = @tally_symbol
	return
end

select
    @tally_broker = symbol
from
    brokers
where
    symbol = @broker
if @tally_broker = NULL
begin
    select
        @tally_broker = a.symbol
    from
        brokers a,
        broker_symbols b
    where
        a.broker_id = b.broker_id
    and
        b.source_id = @source_id
    and
        b.symbol = @broker
    if @tally_broker = NULL
    begin
        select
            status = "Error",
            message = "Broker not found",
            broker = @broker
        return
    end
end

select
    @tally_trader = symbol
from
    traders
where
    symbol = @trader
if @tally_trader = NULL
begin
    select
        @tally_trader = a.symbol
    from
        traders a,
        trader_symbols b
    where
        a.trader_id = b.trader_id
    and
        b.source_id = @source_id
    and
        b.symbol = @trader
    if @tally_trader = NULL
    begin
        select
            status = "Error",
            message = "trader not found",
            trader = @trader
        return
    end
end


select
    @tally_counterparty = name
from
    counterparties
where
    name = @counter_party
if @tally_counterparty = NULL
begin
    select
        @tally_counterparty = a.name
    from
        counterparties a,
        counterparty_symbols b
    where
        a.counterparty_id = b.counterparty_id
    and
        b.source_id = @source_id
    and
        b.symbol = @counter_party
    if @tally_broker = NULL
    begin
        select
            status = "Error",
            message = "Counterparty not found not found",
            counterparty = @counter_party
        return
    end
end

select
    @deployment_date = convert(datetime, @allocation_template)

exec
    r_sourcemasterallocation
        @login = @login,
        @source = @tally_source,
        @strategy = @tally_strategy,
        @deployment_date = @deployment_date,
        @ma_version_id = @ma_version_id output,
        @external_account = @tally_external_account output

if @ma_version_id = NULL
begin
    select
        status = "Error",
        message = "No such allocation template",
        source = @tally_source,
        strategy = @strategy,
        deployment_date = @deployment_date
    return
end

/*
select
    "exec fxa_tallytrade",
		login = @login,
		source = @tally_source,
		trade_id = @trade_id,
		deal_id = @deal_id,
		tally_type = @tally_tally_type,
		deal_type = "Market Forward",
		trade_type = @tally_trade_type,
		external_account = @tally_external_account,
		counterparty = @tally_counterparty,
		quantity = @tally_quantity,
		symbol = @tally_symbol,
		value_date = @tally_value_date,
		price = @tally_price,
		trade_date = @tally_trade_date,
		sales_code = @tally_sales_code,
		fixing_date = @tally_fixing_date,
		identifier = @tally_identifier,
		strategy = @tally_strategy,
		broker = @tally_broker,
		tally_spot_reference = @tally_spot_reference,
        pipping_schedule = @tally_pipping_schedule
*/

exec
	fxa_tallytrade
		@login = @login,
		@source = @tally_source,
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_tally_type,
		@deal_type = "Market Forward",
		@trade_type = @tally_trade_type,
		@external_account = @tally_external_account,
		@trader = @tally_trader,
		@counterparty = @tally_counterparty,
		@quantity = @tally_quantity,
		@symbol = @tally_symbol,
		@value_date = @tally_value_date,
		@price = @tally_price,
		@trade_date = @tally_trade_date,
		@sales_code = @tally_sales_code,
		@fixing_date = @tally_fixing_date,
		@identifier = @tally_identifier,
		@strategy = @tally_strategy,
		@broker = @tally_broker,
		@tally_spot_reference = @tally_spot_reference,
        	@pipping_schedule = @tally_pipping_schedule

if @trade_id != NULL
begin
    exec
        r_inserttradenotification
            @trade_id
end

if @deal_id != NULL
begin
    select
        status = "OK",
        action = "Tallied",
        deal_id = convert(numeric(10,0), a.deal_id),
        trade_id = convert(numeric(10,0), a.trade_id),
        trade_date = convert(varchar(19), a.trade_date, 23),
        "user" = convert(varchar(15), b.login),
        "type" = convert(varchar(7), c.name),
        internal_account = convert(varchar(16), d.symbol),
        external_account = convert(varchar(16), e.symbol),
        counterparty = convert(varchar(12), f.name),
        trader = convert(varchar(12), g.symbol),
        quantity = str(a.quantity, 14, 2),
        contract = convert(varchar(8), h.symbol),
        value_date = convert(varchar(10), a.value_date, 101),
        fixing_date = convert(varchar(10), a.fixing_date, 101),
        price = str(a.price, 14, 6),
        identifier = convert(varchar(25), a.identifier),
        strategy = convert(varchar(10), j.name)
    from
        trades a,
        tico_accounts b,
        trade_types c,
        internal_accounts d,
        external_accounts e,
        counterparties f,
        traders g,
        contracts h,
        brokers i,
        strategies j
    where
        a.user_id = b.account_id
    and
        a.trade_type_id = c.trade_type_id
    and
        a.internal_account_id = d.internal_account_id
    and
        a.external_account_id = e.external_account_id
    and
        a.counterparty_id = f.counterparty_id
    and
        a.trader_id = g.trader_id
    and
        a.contract_id = h.contract_id
    and
        a.broker_id = i.broker_id
    and
        a.strategy_id = j.strategy_id
    and
        trade_id = @trade_id

end
