create table
	#market_rolls(
		style varchar(250) NULL,
		deal_id int,
		trade_date datetime NULL,
		external_account_id int,
		account_type varchar(50) NULL,
		closing_trade_id int,
		closing_quantity numeric(30,4),
		contract_id int,
		closing_rate float,
 	        closing_date datetime,
		roll_trade_id int NULL,
		roll_quantity numeric(30,4) NULL,
		roll_rate float NULL,
		roll_date datetime NULL)

insert into
	#market_rolls(
		deal_id,
		trade_date, 
		external_account_id,
		account_type,
		closing_trade_id,
		contract_id,
		closing_quantity,
		closing_rate,
		closing_date)
select
	a.deal_id,
	a.trade_date,
	a.external_account_id,
	c.name,
	a.trade_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.value_date
from
	trades a,
	external_accounts b,
	external_account_types c,
	trade_types d
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	a.trade_type_id = d.trade_type_id
/* and
	c.name = "Counterparty" */
and
	d.name = "Swap Near"
and
	a.trader_id = @roll_trader_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

update
	#market_rolls
set
	style = @pb_style
where
	account_type = "Counterparty"

update
	#market_rolls
set
	style = @client_style
where
	account_type = "Client"

create table
	#roll_legs(
		deal_id int,
		trade_id int)
insert into
	#roll_legs
select
	a.deal_id,
	a.trade_id
from
	trades a,
	#market_rolls b
where
	a.deal_id = b.deal_id

delete
	#roll_legs
from
	#roll_legs a,
	#market_rolls b
where
	a.trade_id = b.closing_trade_id

update
	#market_rolls
set
	a.roll_trade_id = b.trade_id
from
	#market_rolls a,
	#roll_legs b
where
	a.deal_id = b.deal_id

update
	#market_rolls
set
	a.roll_date = b.value_date,
	a.roll_rate = b.price,
	a.roll_quantity = b.quantity
from
	#market_rolls a,
	trades b
where
	a.roll_trade_id = b.trade_id

