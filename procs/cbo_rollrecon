	closing_spread_pl = closing_native_pl,
	roll_rate,
	roll_date = convert(varchar(12), roll_date),
	roll_quantity,
	roll_spread_pl = roll_native_pl,
	total_spread_pl = closing_native_pl + roll_native_pl,
	ccy
from
	#roll_output
order by
	id
