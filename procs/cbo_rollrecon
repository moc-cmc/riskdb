	#valid_rolls(
		id int)
insert into
	#valid_rolls
select
	id
from
	#client_balances
where
	abs(position) > 0
and
	closing_rate != NULL
and
	roll_date != NULL
and
	roll_rate != NULL
and
	spread_rate != NULL
	
select
	@id = 0
select
	@ids = count(*)
from
	#valid_rolls
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#valid_rolls
	where
		id > @id

	select
		@account = NULL,
		@near_quantity = NULL,
		@far_quantity = NULL,
		@dealt_currency = NULL,
		@counter_currency = NULL,
		@near_date = NULL,
		@near_price = NULL,
		@far_date = NULL,
		@far_price = NULL,
		@deal_id = NULL,
		@queued_roll_id = NULL,
		@trade_date = NULL

	select
		@trade_date = trade_date,
		@account = account,
		@near_quantity = roll_amount * -1.0,
		@far_quantity = roll_amount,
		@dealt_currency = dealt_currency,
		@counter_currency = counter_currency,
		@near_date = closing_date,
		@near_price = closing_rate,
		@far_date = roll_date,
		@far_price = spread_rate
	from
		#client_balances
	where
		id = @id

	exec
		j_nextkey
			"queued_rolls",
			@queued_roll_id output

	insert into
		queued_rolls(
			queued_roll_id,
			batch_id,
			trade_date,
 			account,
			near_quantity,
			far_quantity,
			dealt_currency,
			counter_currency,
			near_date,
			near_price,
			far_date,
			far_price)
	values(
		@queued_roll_id,
		@batch_id,
		@trade_date,
		@account,
		@near_quantity,
		@far_quantity,
		@dealt_currency,
		@counter_currency,
		@near_date,
		@near_price,
		@far_date,
		@far_price)


	select
		@ids = count(*)
	from
		#valid_rolls
	where
		id > @id
end
	

/****** end queue up valid rolls ***********/


select
	@trade_date = min(trade_date)
from
	#market_rolls


--Adaptive Server has expanded all '*' elements in the following statement
