/* Create a net rolls summary table */
create table
	#booked_rolls(
		id int identity,
                style varchar(250) NULL,
		deal_id int NULL,
		account varchar(50) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		closing_native_value float NULL,
		closing_quantity numeric(30,4) NULL,
		closing_date datetime NULL,
		closing_rate float NULL,
 		roll_rate float NULL,
		roll_date datetime NULL,
		roll_quantity numeric(30,4) NULL,
		roll_native_value float NULL)
insert into
	#booked_rolls(
		style,
		deal_id,
		account,
		contract_id,
		symbol,
		closing_quantity,
		closing_date,
		closing_rate,
 		roll_rate,
		roll_date,
		roll_quantity)
select
	a.style,
	a.deal_id,
	account = b.symbol,
	c.contract_id,
	c.symbol,
	a.closing_quantity,
	closing_date = convert(varchar(12), a.closing_date),
	a.closing_rate,
	a.roll_rate,
	roll_date = convert(varchar(12), a.roll_date),
	a.roll_quantity
from
	#market_rolls a,
	external_accounts b,
	contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
order by
	c.symbol,
	a.account_type desc,
	b.symbol

update
	#booked_rolls
set
	roll_native_value = roll_quantity * roll_rate * -1.0,
	closing_native_value = closing_quantity * closing_rate * -1.0

create table
	#contracts(
		id int identity,
		contract_id int NULL,
		symbol varchar(50))
insert into
	#contracts(
		symbol)
select
	distinct(symbol)
from
	#booked_rolls
order by
	symbol

update
	#contracts
set
	a.contract_id = b.contract_id
from
	#contracts a,
	contracts b
where
	a.symbol = b.symbol

select
	@id = 0
select
	@ids = count(*)
from
	#contracts
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#contracts
	where
		id > @id

	select
		@contract_id = NULL,
		@closing_native_value = NULL,
		@closing_quantity = NULL,
		@closing_native_value = NULL,
		@roll_quantity = NULL,
		@roll_native_value = NULL

	select
		@contract_id = contract_id
	from
		#contracts
	where
		id = @id

	insert into
		#roll_output(
			style,
			deal_id,
			account,
			contract_id,
			symbol,
			closing_native_value,
			closing_quantity,
			closing_date,
			closing_rate,
			roll_rate,
			roll_date,
			roll_quantity,
			roll_native_value)
	select
		style,
		deal_id,
		account,
		contract_id,
		symbol,
		closing_native_value,
		closing_quantity,
		closing_date,
		closing_rate,
		roll_rate,
		roll_date,
		roll_quantity,
		roll_native_value
	from
		#booked_rolls
	where
		contract_id = @contract_id
	order by
		id

	select
		@closing_native_value = sum(closing_native_value),
		@closing_quantity = sum(closing_quantity),
		@roll_quantity = sum(roll_quantity),
		@roll_native_value = sum(roll_native_value)
	from
		#roll_output
	where
		contract_id = @contract_id

	select
		@ccy = b.symbol
	from
		forwards a,
		products b
	where
		a.currency_id = b.product_id
	and
		a.contract_id = @contract_id

		
	insert into
		#roll_output(
			style,
			account,
			closing_native_pl,
			closing_quantity,
			roll_quantity,
			roll_native_pl,
			ccy)
	values(
		@total_style,
		"Total",
		@closing_native_value,
		@closing_quantity,
		@roll_quantity,
		@roll_native_value,
		@ccy)

	select
		@ids = count(*)
	from
 		#contracts
	where
		id > @id
end

exec
	j_nextkey
		"batches",
		@batch_id output

