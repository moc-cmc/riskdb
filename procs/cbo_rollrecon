	set_rates = "SET",
	trade_date = convert(varchar(12), a.trade_date),
	closing_date = convert(varchar(12), a.closing_date),
	roll_date = convert(varchar(12), a.roll_date),
	a.net_long,
	a.closing_rate_long,
	a.roll_rate_long,
	a.net_short,
	a.closing_rate_short,
	a.roll_rate_short
from
	#roll_rates a,
	contracts b
where
	a.contract_id = b.contract_id
and
	a.trade_date = @trade_date
order by
	b.symbol

