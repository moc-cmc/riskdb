create table
	#trades(
		trade_id int,
		contract_id int,
		external_account_id int,
		trader_id int,
		status_id int,
		quantity numeric(30, 4),
		price float,
		value_date datetime
		)

insert into
	#trades
select
	a.trade_id,
	a.contract_id,
	a.external_account_id,
	a.trader_id,
	a.status_id,
	a.quantity,
	a.price,
	a.value_date
from
	trades a,
	#client_accounts b
where
	a.external_account_id = b.external_account_id
and 
	a.value_date >= @trade_date
and
	a.trade_date < @end_date

create table
	#client_positions(
		id int identity,
		external_account_id int,
		contract_id int,
		quantity numeric(30,4),
		value_date datetime NULL,
		closing_date datetime NULL,
		closing_rate float NULL,
		roll_date datetime NULL,
		roll_rate float NULL)
insert into
	#client_positions(
		external_account_id,
		contract_id,
		value_date,
		quantity)
select
	a.external_account_id,
	a.contract_id,
	a.value_date,
	sum(a.quantity)
from
	#trades a,
	forwards b,
	#client_accounts d,
	statuses e
where
	a.contract_id = b.contract_id
and
	a.external_account_id = d.external_account_id
and
	a.status_id = e.status_id
and
	e.name != "Resid"
group by
	a.external_account_id,	
	a.contract_id,
	a.value_date

create table
	#client_balances(
		id int identity,
		section varchar(250) NULL,
		style varchar(250) NULL,
		trade_date datetime NULL,
		external_account_id int NULL,
		roll_spread_group_id int NULL,
		spread varchar(50) NULL,
		account varchar(50) NULL,
		settlement_style varchar(50) NULL,
		contract_id int NULL,
		product_id int NULL,
		dealt_currency varchar(50) NULL,
		currency_id int NULL,
		counter_currency varchar(50) NULL,
		symbol varchar(50) NULL,
		position numeric(30,4) NULL,
		roll_amount numeric(30,4) NULL,
		closing_date varchar(11) NULL,
		closing_rate float NULL,
		rolled_amount numeric(30,4) NULL,
		roll_date varchar(11) NULL,
		roll_rate float NULL,
		spread_rate float NULL,
		allocate varchar(50) NULL,
		value_date datetime)
insert into
	#client_balances(
		section,
		style,
		trade_date,
		external_account_id,
		account,
		settlement_style,
		contract_id,
		symbol,
		position,
		roll_amount,
		closing_date,
		closing_rate,
		roll_date,
		roll_rate,
		value_date)
select
	section = "Client Balances",
	style = "background:#FFFFFF;border: 1px solid white",
	@trade_date,
	c.external_account_id,
	account = c.symbol,
	d.name,
	a.contract_id,
	a.symbol,
	position = b.quantity,
	roll_amount = b.quantity,
	closing_date = convert(varchar(11), b.closing_date, 1),	
	b.closing_rate,
	roll_date = convert(varchar(11), b.roll_date, 1),
	b.roll_rate,
	b.value_date
from
	contracts a,
	#client_positions b,
	external_accounts c,
	settlement_methods d
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	c.settlement_method_id = d.settlement_method_id
order by
	c.symbol,
	a.symbol,
	b.value_date

update
	#client_balances
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#client_balances a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#client_balances
set
	a.dealt_currency = b.symbol
from
	#client_balances a,
        products b
where
	a.product_id = b.product_id

update
	#client_balances
set
	a.counter_currency = b.symbol
from
	#client_balances a,
	products b
where
	a.currency_id = b.product_id


/* default the spread group to No Spread */
update
	#client_balances
set
	a.roll_spread_group_id = b.roll_spread_group_id
from
	#client_balances a,
	roll_spread_groups b
where
