create table
	#roll_rates(
		contract_id int,
		trade_date datetime NULL,
		closing_date datetime NULL,
		net_long numeric(30,4) NULL,
		long_pbs int NULL,
		closing_rate_long float NULL,
		net_short numeric(30,4) NULL,
		short_pbs int NULL,
		closing_rate_short float NULL,
		roll_date datetime NULL,
		roll_rate_long float NULL,
		roll_rate_short float NULL)
insert into
	#roll_rates(
		contract_id,
		trade_date,
		closing_date,
		net_long,
		closing_rate_long,
		net_short,
		closing_rate_short,
		roll_date,
		roll_rate_long,
		roll_rate_short)
select
	contract_id,
	trade_date,
	closing_date,
	net_long,
	round(closing_rate_long, 8),
	net_short,
	round(closing_rate_short, 8),
	roll_date,
	round(roll_rate_long, 8),
	round(roll_rate_short, 8)
from
	defined_roll_rates
where
	trade_date = @trade_date
		
update
	#roll_rates
set
	a.closing_date = b.closing_date,
	a.closing_rate_long = round(b.closing_rate_long, 8),
	a.closing_rate_short = round(b.closing_rate_short, 8),
	a.roll_date = b.roll_date,
	a.roll_rate_long = round(b.roll_rate_long, 8),
	a.roll_rate_short = round(b.roll_rate_short, 8)
from
	#roll_rates a,
	roll_rate_overrides b
where
	a.contract_id = b.contract_id
and
	a.trade_date = b.trade_date

/* Use defined roll rates rather than the market rolls */

update
	#client_balances
set
	a.closing_date = b.closing_date,
	a.closing_rate = b.closing_rate_long,
	a.roll_date = b.roll_date,
	a.roll_rate = b.roll_rate_short
from
	#client_balances a,
	#roll_rates b
where
	a.contract_id = b.contract_id
and
	a.trade_date = b.trade_date
and
	a.value_date = b.closing_date
and
	sign(a.roll_amount) > 0.0

update
	#client_balances
set
	a.closing_date = b.closing_date,
	a.closing_rate = b.closing_rate_short,
	a.roll_date = b.roll_date,
	a.roll_rate = b.roll_rate_long
from
	#client_balances a,
	#roll_rates b
where
	a.contract_id = b.contract_id
and
	a.trade_date = b.trade_date
and
	a.value_date = b.closing_date
and
	sign(a.roll_amount) < 0.0

update
	#client_balances
set
	a.spread_rate = a.roll_rate - b.spread
from
	#client_balances a,
	contract_roll_spreads b
where
	a.contract_id = b.contract_id
and
	a.roll_spread_group_id = b.roll_spread_group_id
and
	sign(a.position) > 0

update
	#client_balances
set
	a.spread_rate = a.roll_rate + b.spread
from
	#client_balances a,
	contract_roll_spreads b
where
	a.contract_id = b.contract_id
and
	a.roll_spread_group_id = b.roll_spread_group_id
and
	sign(a.position) < 0

