		message = "There are no rolls booked for today. Import market side rolls"
end

select
	section,
	style,
	account,
	symbol,
	position,
	value_date = convert(varchar(11), value_date, 1),
	roll_amount,
	closing_date,
	closing_rate,
	roll_date,
	roll_rate,
	spread_rate,
	spread_group=spread
from
	#client_balances
