
drop procedure
	ag_onboardinghome
go

create procedure
	ag_onboardinghome
		@login varchar(50)

as


declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"old_value_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"import_open_trades",
	"Import Spectrum Open Trades",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"import_eod_trades",
	"Import Spectrum EOD Trades",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"import_prices",
	"Import Spectrum Prices",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"import_spectrum_trades",
	"Import Spectrum Trades",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"task",
	"Number",
	"###0")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


select
	section = "Onboarding Issues",
	style = @style,
	issue = name,
	status,
	task = task_id
from
	onboarding_issues
order by
	id

select
	style = @style,
	import_prices = "Test Import EOD Prices"

select
	style = @style,
	import_eod_trades = "Test Import EOD Trades"

select
	style = @style,
	import_open_trades = "Test Import Open Trades"
	
select
	style = @style,
	import_spectrum_trades = "Test Import Spectrum Trades (EOD & Open)"

go

