create procedure
	r_runcreditoverview
		@login varchar(50),
		@run_name varchar(50),
		@trade_date datetime=NULL
as

declare @run_id int
declare @begin_date datetime
declare @end_date datetime

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount = NULL
begin
	select
		status = "Error",
		message = "Run not found",
		run = @run_name
	return
end

if @trade_date = NULL
	select
		@trade_date = getdate()

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


