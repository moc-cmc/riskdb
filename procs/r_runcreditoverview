	a.external_account_id,
	a.quantity,
	a.contract_id,
	a.value_date,
	a.price
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date > @begin_date
and
	a.trade_date <= @end_date 

create table
	#ext_account_balances(
		external_account_id int,
		product_id int,
		amount float)
insert into
	#ext_account_balances
select
	a.external_account_id,
	d.product_id,
	amount = sum(
		case
		when c.currency_id = d.product_id then
			a.quantity * a.price * -1.0
		when c.product_id = d.product_id then
			a.quantity
		end
	)
from
	#trades a,
	forwards c,
	products d
where
	a.contract_id = c.contract_id
and (
		c.currency_id = d.product_id
	or
		c.product_id = d.product_id
	)
and
	a.value_date >= convert(datetime, convert(date, dateadd(hour, 7, getdate())))
group by
	a.external_account_id, 
	d.product_id

create table
	#ext_account_nops(
		external_account_id int,
		nop float NULL)
insert into
	#ext_account_nops
select
	external_account_id = a.external_account_id,
	nop = abs(sum(case 
		when
			ba.nop_type_id = NULL
		then
			NULL
		when
			ba.incl_base_ccy = "N"
		and
			b.currency_id = c.product_id
		then
	   		0
		when
			ba.incl_shorts = "Y"
		and
			c.amount < 0
		then
			c.amount * d.rate
		when
			ba.incl_longs = "Y"
		and
			c.amount > 0
		then
			c.amount * d.rate
		else
			0
	end))
from
	external_accounts a
	join ext_account_limits b
		on
			a.external_account_id = b.external_account_id
		left outer join nop_types ba
			on
				b.nop_type_id = ba.nop_type_id
	left outer join #ext_account_balances c
		on
			a.external_account_id = c.external_account_id
	left outer join currency_rates d
		on
			c.product_id = d.product_id
		and
			b.currency_id = d.currency_id
group by
	a.external_account_id

create table
	#ext_account_ladders(
		external_account_id int,
		product_id int,
		value_date datetime,
		amount float NULL)
insert into
	#ext_account_ladders
select
	a.external_account_id,
	d.product_id,
	a.value_date,
	amount = sum(
		case
		when c.currency_id = d.product_id then
			a.quantity * a.price * -1.0
		when c.product_id = d.product_id then
			a.quantity
		end
	)
from
	#trades a,
	forwards c,
	products d
where
	a.contract_id = c.contract_id
and (
		c.currency_id = d.product_id
	or
		c.product_id = d.product_id
	)
and
	a.value_date >= convert(datetime, convert(date, dateadd(hour, 7, getdate())))
group by
	a.external_account_id,
	d.product_id,
	a.value_date


create table
	#ext_account_dsls(
		external_account_id int,
		value_date datetime NULL,
		dsl float NULL)
insert into
	#ext_account_dsls
select
	a.external_account_id,
	c.value_date,
	dsl = abs(sum(case 
		when
			ba.dsl_type_id = NULL
		then
			NULL
		when
			ba.incl_base_ccy = "N"
		and
			b.currency_id = c.product_id
		then 
  			0
		when
			ba.incl_shorts = "Y" and c.amount < 0
		then
			c.amount * d.rate
		when
			ba.incl_longs = "Y" and c.amount > 0
		then
			c.amount * d.rate
		else
			0
	end))
from
	external_accounts a
	join ext_account_limits b
	on
		a.external_account_id = b.external_account_id
	left outer join
		dsl_types ba
	on
		b.dsl_type_id = ba.dsl_type_id
	left outer join
		#ext_account_ladders c
	on
		a.external_account_id = c.external_account_id
	join currency_rates d
	on
		c.product_id = d.product_id
	and
		b.currency_id = d.currency_id
group by
	a.external_account_id,
	c.value_date

create table
	#credit(
		style varchar(200) NULL,
		external_account_id int,
		account_type varchar(50),
		ext_account varchar(50),
		status varchar(50) NULL,
		nop float NULL,
		nop_type varchar(50) NULL,
		nop_limit float NULL,
		nop_use float NULL,
		dsl float NULL,
		value_date datetime NULL,
		dsl_type varchar(50) NULL,
		dsl_limit float NULL,
		dsl_use float NULL,
		notice_level float NULL,
		warning_level float NULL,
		blocked_level float NULL)
insert into
	#credit
select
	style = NULL,
	b.external_account_id,
	account_type = a.name,
	account = b.symbol,
	status = NULL,
	nop = NULL,
	nop_type = NULL,
	nop_limit = NULL,
	nop_use = NULL,
	dsl = NULL,
	value_date = NULL,
	dsl_type = NULL,
	dsl_limit = NULL,
	dsl_use = NULL,
	notice_level = NULL,
	warnin_level = NULL,
	blocked_level = NULL
from
	external_account_types a,
	external_accounts b,
	#external_accounts c
where
	b.external_account_id = c.external_account_id
and
	a.external_account_type_id = b.external_account_type_id
and
	a.name = "Client"

update
	#credit
set
	a.nop_limit = b.nop_limit,
	a.nop_type = c.name,
	a.dsl_limit = b.dsl_limit,
	a.dsl_type = d.name,
	a.notice_level = b.notice_level,
	a.warning_level = b.warning_level,
	a.blocked_level = b.blocked_level
from
	#credit a,
	ext_account_limits b,
	nop_types c,
	dsl_types d
where
	a.external_account_id = b.external_account_id
and
	b.nop_type_id = c.nop_type_id
and
	b.dsl_type_id = d.dsl_type_id


update
	#credit
set
	a.nop = b.nop
from
	#credit a,
	#ext_account_nops b
where
	a.external_account_id = b.external_account_id

update
	#credit
set
	a.dsl = b.dsl,
	a.value_date = b.value_date
from
	#credit a,
	#ext_account_dsls b
where
	a.external_account_id = b.external_account_id


update
	#credit
set
	nop_use = nop / nop_limit
where
	nop_limit != 0

update
	#credit
set
	dsl_use = dsl / dsl_limit
where
	dsl_limit != 0

update
	#credit
set
	style = "background:#FFFFCC;border: 1px solid white",
	status = "Notice"
where
	nop_use > notice_level
or
	dsl_use > notice_level

update
	#credit
set
	style = "background:#FFCC99;border: 1px solid white",
	status = "Warning"
where
	nop_use > warning_level
or
	dsl_use > warning_level

update
	#credit
set
	style = "background:#FF9999;border: 1px solid white",
	status = "Blocked"
where
	nop_use > blocked_level
or
	dsl_use > blocked_level

select
	style,
	account_type,
	external_account = ext_account,
	nop_type,
	nop,
	nop_limit = case
		when
			nop_limit != NULL then rtrim(convert(varchar(30), nop_limit / 1000000.0)) + "mm"
		else
			NULL
		end,
	nop_use,
	dsl_type,
	dsl,
	value_date = case
		when
			value_date != NULL
		then
			convert(char(11), value_date, 1)
		else
			NULL
		end,
	dsl_limit = case
		when
			dsl_limit != NULL then rtrim(convert(varchar(30), dsl_limit / 1000000.0)) + "mm"
		else
			NULL
		end,
	dsl_use
from
	#credit
order by
	ext_account


