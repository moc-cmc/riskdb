
if object_id("r_currentrateasof") != NULL
    drop procedure
        r_currentrateasof
go

create procedure
	r_currentrateasof
		@product_id int,
		@as_of_date datetime,
		@rate_date datetime,
		@rate float output
as

declare @product_rate_id int
declare @point_before_day float
declare @point_after_day float
declare @before_rate float
declare @after_rate float
declare @minutes int
declare @hours float
declare @days float
declare @days_in_range float
declare @range_days float
declare @curve_point float
declare @range_diff float
declare @points int

exec
	r_currentproductrateid
		@product_id,
		@product_rate_id output


select
	@points = count(*)
from
	current_product_rate_points
where
	product_rate_id = @product_rate_id
if @points = 1
begin
	select
		@rate = rate
	from
		current_product_rate_points
	where
		product_rate_id = @product_rate_id
	return
end

select
	@minutes = datediff(minute, @as_of_date, @rate_date)
if @minutes >= 1
	select
		@hours = convert(float, @minutes) / 60.0
else
	select
		@hours = 0.0

select
	@days = @hours / 24.0

/* select
	@days = datediff(day, @as_of_date, @rate_date)
if @days < 0
begin
	select
		msg = "encountered negative days",
		product_id = @product_id,
		as_of_date = @as_of_date,
		rate_date = @rate_date
	return
end */

select
	@point_before_day = max(days)
from
	current_product_rate_points
where
	product_rate_id = @product_rate_id
and
	days <= @days

select
	@point_after_day = min(days)
from
	current_product_rate_points
where
	product_rate_id = @product_rate_id
and
	days >= @days

if @point_before_day = NULL
begin
	select
		@point_before_day = @point_after_day

	select
		@point_after_day = min(days)
	from
		current_product_rate_points
	where
		product_rate_id = @product_rate_id
	and
		days > @point_before_day
end

if @point_after_day = NULL
begin
	select
		@point_after_day = @point_before_day
	select
		@point_before_day = max(days)
	from
		current_product_rate_points
	where
		product_rate_id = @product_rate_id
	and
		days < @point_after_day
end


select
	@before_rate = rate
from
	current_product_rate_points
where
	product_rate_id = @product_rate_id
and
	days = @point_before_day

select
	@after_rate = rate
from
	current_product_rate_points
where
	product_rate_id = @product_rate_id
and
	days = @point_after_day

select
	@days_in_range = @point_after_day - @point_before_day

if @days_in_range = 0
begin
	select
		@rate = @before_rate
	return
end

select
	@range_days = @days - @point_before_day

select
	@curve_point = @range_days / @days_in_range

select
	@range_diff = @after_rate - @before_rate

	
select
	@rate = @before_rate + (@range_diff * @curve_point)

/* select
	point_before_day = @point_before_day,
	before_rate = @before_rate,
	point_after_day = @point_after_day,
	after_rate = @after_rate,
	days_in_range = @days_in_range,
	curve_point = @curve_point,
	range_diff = @range_diff  */
	

go
