
if object_id("cv_dollaramount") != NULL
    drop procedure
        cv_dollaramount
go

create procedure
	cv_dollaramount
		@product_id int,
		@quantity float,
		@as_of_date datetime,
		@dollar_amount float output,
		@price_style varchar(30) output,
		@forward_price float output
as

declare @forward_id int
declare @inverted_forward_id int
declare @usd_product_id int

select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"
if @@rowcount != 1
	raiserror 999999 "USD currency missing!"

/* if @product_id = @usd_product_id
begin
	select
		@dollar_amount = @quantity
	return
end */

select
	@forward_id = contract_id
from
	forwards
where
	currency_id = @usd_product_id
and
	product_id = @product_id
select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @forward_id

exec
	r_priceasof
		@forward_id,
		@as_of_date,
		@forward_price output

/* if @price_style = "Inverted"
begin
	exec
		r_invertedcontract
			@forward_id,
			@inverted_forward_id output
	select
		@forward_price = 1.0 / price
	from
		current_prices
	where
		contract_id = @inverted_forward_id
end
else
begin
	select
		@forward_price = price
	from
		current_prices
	where
		contract_id = @forward_id
end */
		

select
	@dollar_amount = NULL
select
	@dollar_amount = @quantity * @forward_price

