
if object_id("r_dollaramount") != NULL
    drop procedure
        r_dollaramount
go
 
create procedure
	r_dollaramount
		@product_id int,
		@quantity float,
		@as_of_date datetime,
		@dollar_amount float output
as

declare @forward_id int
declare @usd_product_id int
declare @forward_price float

select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"
if @@rowcount != 1
	raiserror 999999 "USD currency missing!"

/* if @product_id = @usd_product_id
begin
	select
		@dollar_amount = @quantity
	return
end */

select
	@forward_id = contract_id
from
	forwards
where
	currency_id = @usd_product_id
and
	product_id = @product_id

exec
	r_priceasof
		@forward_id,
		@as_of_date,
		@forward_price output

select
	@dollar_amount = NULL
select
	@dollar_amount = @quantity * @forward_price

/* if @product_id = 32 
	select
		dollar_amount = @dollar_amount,
		quantity = @quantity,
		forward_price = @forward_price */

go
