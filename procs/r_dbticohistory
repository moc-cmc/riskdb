
if object_id("r_dbticohistory") != NULL
    drop procedure
        r_dbticohistory
go

create procedure
	r_dbticohistory
		@login varchar(30),
		@begin_date datetime=NULL,
		@end_date datetime=NULL

as

declare @sql_string varchar(200)
declare @tico_server varchar(50)
declare @tico_database varchar(50)
declare @db_name varchar(50)

if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date = NULL
	select
		@end_date = dateadd(day, 1, getdate())


select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds

select
	@db_name = db_name()

select
	@sql_string = "exec " + rtrim(@tico_database) + "..ti_dbgrouphistory '" + rtrim(@db_name) + "', '" + rtrim(convert(varchar(11), @begin_date, 1)) + "', '" + rtrim(convert(varchar(11), @end_date, 1)) + "'"

exec sp_remotesql @tico_server, @sql_string 


go
