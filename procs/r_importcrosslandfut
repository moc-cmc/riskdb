use
	risk_pinepoint
go

drop procedure
	r_importcrosslandfut
go

create procedure
	r_importcrosslandfut
		@login varchar(50),
		@TDDT varchar(25)=NULL,
		@BORS varchar(25)=NULL,
		@QUANTY varchar(25)=NULL,
		@EXCH varchar(25)=NULL,
		@FCONDT varchar(25)=NULL,
		@DESC varchar(25)=NULL,
		@PORC varchar(25)=NULL,
		@TRNTP varchar(25)=NULL,
		@FPRICE varchar(25)=NULL,
		@CMNS varchar(25)=NULL,
		@STRIK varchar(25)=NULL,
		@EXCF varchar(25)=NULL,
		@EXSF varchar(25)=NULL,
		@NFA varchar(25)=NULL,
		@ALTCUR varchar(25)=NULL,
		@REGCOD varchar(25)=NULL,
		@ACCTNO varchar(25)=NULL,
		@TRNCDE varchar(25)=NULL,
		@PRICE varchar(25)=NULL,
		@NITD varchar(25)=NULL,
		@PANDL varchar(25)=NULL,
		@CNYEAR varchar(25)=NULL,
		@MONTH varchar(25)=NULL,
		@FPRMPT varchar(25)=NULL,
		@FUTCOD varchar(25)=NULL,
		@FORO varchar(25)=NULL,
		@SLSPSN varchar(25)=NULL,
		@CRNCOD varchar(25)=NULL,
		@STLPR varchar(25)=NULL,
		@TXTY varchar(25)=NULL,
		@TXCD varchar(25)=NULL,
		@BROKR varchar(25)=NULL,
		@TXNO varchar(25)=NULL,
		@CMSTY varchar(25)=NULL,
		@FUTMCD varchar(25)=NULL,
		@ORGZCD varchar(25)=NULL,
		@FEEREC varchar(25)=NULL,
		@FBKR varchar(25)=NULL,
		@FEEAMT varchar(25)=NULL,
		@FEECTC varchar(25)=NULL,
		@FEEHF varchar(25)=NULL,
		@SDBK varchar(25)=NULL,
		@session_id varchar(100),
		@row_count int,
		@row_index int,
		@row_date datetime=NULL



as

declare @trade_id int
declare @commission float
declare @excf float
declare @exsf float
declare @nfa float
declare @new_trade_id int
declare @credit_type_id int
declare @credit float
declare @currency_id int
declare @account_transaction_id int
declare @tico_account_id int
declare @identifier varchar(50)
declare @external_account_id int
declare @deal_id int
declare @day char(2)
declare @month char(2)
declare @year char(2)
declare @trade_date datetime
declare @status varchar(50)

if @row_date = NULL
begin
	select
		status = "Error",
		message = "Trade date not entered"
	return
end

select
	@year = substring(@TDDT, 2, 2),
	@month = substring(@TDDT, 4, 2),
	@day = substring(@TDDT, 6, 2)

select
	@trade_date = convert(datetime, @month + "/" + @day + "/" + @year)


select
	@trade_id = trade_id
from
	trades
where
	identifier = @TXNO

if @TRNCDE = "140"
begin
	select
		status = "Late Report",
		message = "Found late report trade",
		identifier = @TXNO
	exec
		cn_tallyasoftrade
			@login,
			@TDDT,
			@BORS,
			@QUANTY,
			@FCONDT,
			@DESC,
			@PORC,
			@STRIK,
			@ACCTNO,
			@PRICE,
			@STLPR,
			@TXNO,
			@row_date

	return
end


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Login not found"
	return
end


select
	@currency_id = product_id
from
	products
where
	symbol = @ALTCUR
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Currency not found",
		currency = @ALTCUR
	return
end

select
	@trade_id = trade_id
from
	trades
where
	identifier = @TXNO
if @trade_id = NULL
	return

select
	@commission = convert(float, @CMNS),
	@excf = convert(float, @EXCF),
	@exsf = convert(float, @EXSF),
	@nfa = convert(float, @NFA)


select
	@credit = @commission + @excf + @exsf + @nfa

select
	@credit_type_id = transaction_type_id
from
	transaction_types
where
	name = "Fee Credit"
if @@rowcount != 1
begin

	exec
		j_nextkey
			"transaction_types",
			@credit_type_id output

	insert into
		transaction_types
	values(
		@credit_type_id,
		"Fee Credit",
		1)
end

if @credit < 0.0
begin
	select
		@external_account_id = external_account_id
	from
		trades
	where
		trade_id = @trade_id

	exec
		cn_busttrade
			@login,
			@trade_id,
			@row_date,
			@deal_id output,
			@new_trade_id output,
			@identifier output,
			@status output

	if @status != "Dupe"
	begin
		select
			@credit = @credit * -1.0

		select
			@account_transaction_id = NULL
		exec
			j_nextkey
				"account_transactions",
				@account_transaction_id output

		insert into
			account_transactions
		values(
			@account_transaction_id,
			@tico_account_id,
			@external_account_id,
			@credit_type_id,
			@row_date,
			@commission,
			@identifier,
			@currency_id)

		select
			msg = "Busted Trade Found",
			trade_id = @trade_id,
			identifier = @identifier
	end
end
else
begin
	select
		msg = "Ignoring non-busted trade",
		trade_id = @trade_id
	return
end
			
		
go
