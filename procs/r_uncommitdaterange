drop procedure
	r_uncommitdaterange
go

create procedure
	r_uncommitdaterange
		@begin_date datetime,
		@end_date datetime

as

declare @max_committed_reval_dt datetime
declare @prev_begin_date datetime
declare @uncommit_days int

declare @fo_commit_type_id int
declare @transactions_removed int
declare @revals_removed int

select
	@begin_date = convert(char(8), @begin_date, 112)+" 17:00",
	@end_date = convert(char(8), @end_date, 112)+" 17:00"
select
	@uncommit_days = abs(datediff(dd, @begin_date, @end_date))

if @uncommit_days > 30
begin
	select
		"error" = "ERROR",
		"msg" = "Can not uncommit a range more than 30 calendar days"
	return
end

exec
	r_prevbusinessday
		@begin_date,
		@prev_begin_date output

select
	@prev_begin_date = convert(char(8), @prev_begin_date, 112)+" 17:00"

/*select
	"msg" = "Uncommitting range",
	"begin" = @begin_date,
	"end" = @end_date*/

select 
	@max_committed_reval_dt = max(reval_date)
from
	committed_daily_revals

select
	@fo_commit_type_id = transaction_type_id
from
	transaction_types
where
	name = "Front Office Commit"
if @@rowcount != 1
begin
	select 
		error = "Error",
		msg = "Problem determining id for transaction type",
		type = "'Front Office Commit'"
	return
end	

create table
	#deleted_commits
(
	internal_account_id int,
	transaction_date datetime,
	amount numeric(30, 4)
)
insert into
	#deleted_commits
select 
	internal_account_id,
	transaction_date,
	amount
from
        int_account_transactions
where
        transaction_date >= @begin_date
and
        transaction_date <= @end_date
and
        transaction_type_id = @fo_commit_type_id

	
/*
 * Delete range
 */
delete from trade_daily_revals

delete from
	committed_daily_revals
where
	reval_date >= @begin_date
and
	reval_date <= @end_date

select 
	@revals_removed = @@rowcount

delete from
	int_account_transactions
where
	transaction_date >= @begin_date
and
	transaction_date <= @end_date
and
	transaction_type_id = @fo_commit_type_id
select
	@transactions_removed = @@rowcount

if @transactions_removed = 1
begin
	select 
		"status" = "COMPLETE",
		"msg" = "Removed "+rtrim(convert(varchar(15), @revals_removed))+" revals and "+rtrim(convert(varchar(10), @transactions_removed))+" commit transaction(s) for range "+
			convert(char(12), @begin_date, 1)+" through "+convert(char(12), @end_date, 1),
		"pl_removed" = amount
	from
		#deleted_commits
end
else
begin
        select
                "status" = "COMPLETE",
                "msg" = "Removed "+rtrim(convert(varchar(15), @revals_removed))+" revals and "+rtrim(convert(varchar(10), @transactions_removed))+" commit transaction(s) for range "+
			convert(char(12), @begin_date, 1)+" through "+convert(char(12), @end_date, 1)

	select
		run = a.symbol,
		b.transaction_date,
		b.amount
	from
		internal_accounts a,
		#deleted_commits b
	where
		a.internal_account_id = b.internal_account_id
	order by
		b.transaction_date,
		a.symbol
end



if @max_committed_reval_dt > @end_date
begin
	select
		"warn" = "*** WARNING ***",
		"msg" = "Revals exist after @end_date"
end

/*
 * required to recommit
 */
exec
	r_copycommittedtotrade
			@prev_begin_date

go
