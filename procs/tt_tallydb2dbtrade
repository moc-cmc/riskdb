drop procedure tt_tallydb2dbtrade
go

create procedure
	tt_tallydb2dbtrade
		@login varchar(50),
		@source varchar(50),
		@to_agency_trade char(1),
		@src_notification_id int,
		@src_notification_status_id int,
		@src_notification_source varchar(50),
		@src_trade_id int,
		@src_trade_identifier varchar(100),
		@src_trade_type varchar(50),
		@src_trade_status_id int,
		@src_deal_id int,
		@src_deal_identifier varchar(100),
		@src_deal_status_id int,
		@src_internal_account varchar(50),
		@src_external_account varchar(50),
		@src_trader varchar(50),
		@src_counterparty varchar(50),
                @src_fund_agency char(1),
		@src_broker varchar(50),
		@src_pb varchar(50),
		@notification_status varchar(50),
		@deal_type varchar(50),
		@std_contract varchar(50),
		@traded_ccy varchar(15),
		@counter_ccy varchar(15),
		@quantity float,
		@trade_date datetime,
		@trade_day varchar(15),
		@value_date varchar(15),
		@fixing_date varchar(15)=NULL,
		@std_price float,
		@spot_reference float=NULL,
		@target_trade_status varchar(50)=NULL,
		@b2b_trader varchar(50)=NULL /* B2B w no spread tallied if NOT null */


as

declare @trade_id int
declare @b2btrade_id int
declare @trade_identifier varchar(100)
declare @trade_type varchar(50)
declare @deal_id int
declare @deal_type_id int
declare @uncommitted_status_id int
declare @deal_identifier varchar(100)
declare @internal_account varchar(50)
declare @external_account_id int
declare @ext_account_id int
declare @cpty_ext_account_id int
declare @external_account varchar(50)
declare @trader_id int
declare @trader varchar(50)
declare @counterparty_id int
declare @counterparty varchar(50)
declare @fund_agency char(1)
declare @broker varchar(50)
declare @pb varchar(50)
declare @market_or_client char(1) /* 'M' or 'C' */
declare @ext_account_lookup varchar(50)
declare @trader_lookup varchar(50)
declare @counterparty_lookup varchar(50)
declare @sales_code_id int
declare @source_id int
declare @contract varchar(50)
declare @identifier varchar(100)

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end


/*
|  Declarations 
*/ 
select
	@trader_lookup = @src_trader,
	@ext_account_lookup = @src_external_account,
	@counterparty_lookup = @src_counterparty

select
	@broker = "DBConnect Tally",
	@trade_type = @src_trade_type,
	@deal_type = @deal_type,
	@contract = rtrim(@traded_ccy)+rtrim(@counter_ccy),
	@identifier = rtrim(@source)+":"+rtrim(convert(varchar(25), @src_trade_id))
	
/*
|  Query traders
*/		

select
	@trader_id = a.trader_id,
	@trader = a.symbol,
	@ext_account_id = a.external_account_id,
	@sales_code_id = a.sales_code_id
from
	traders a,
	trader_symbols b
where
	a.trader_id = b.trader_id
and
	b.source_id = @source_id
and
	b.symbol = @trader_lookup
if @trader_id = NULL
begin
	select
		@trader_id = a.trader_id,
		@trader = a.symbol,
		@ext_account_id = a.external_account_id
	from
		traders a
	where
		a.symbol = @trader_lookup
	if @trader_id = NULL
	begin
		select
			"error"="Error",
			"msg" = "Problem determing trader from trader lookup",
			trader_lookup = @trader_lookup
		return
	end
end

select
        @counterparty_id = a.counterparty_id,
        @counterparty = a.name,
        @cpty_ext_account_id = a.external_account_id
from
        counterparties a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id
and
        b.symbol = @counterparty_lookup
if @counterparty_id = NULL
begin
        select
                @counterparty_id = a.counterparty_id,
                @counterparty = a.name,
                @cpty_ext_account_id = a.external_account_id
        from
                counterparties a
        where
                a.name = @counterparty_lookup
        if @counterparty_id = NULL
        begin
                select
                        "error"="Error",
                        "msg" = "Problem determing counterparty from counterparty lookup",
                        counterparty_lookup = @counterparty_lookup
		return
        end
end

/*
| Query external account from counterparties.external_account_id
*/


if @to_agency_trade = "N"
begin
	select
		@external_account_id = @cpty_ext_account_id
end
if @to_agency_trade = "Y"
begin
	if @b2b_trader != NULL
	begin
		select 
			"error"= 'Error. If @to_agency_trade = "Y" then @b2b_trader should be NULL'
		return
	end

	select
		@external_account_id = @ext_account_id,
		@quantity = -@quantity
end

select
	@external_account = symbol
from
	external_accounts
where
	external_account_id = @external_account_id
if @external_account = NULL
begin
	select
		"error"="Error",
		"msg" = "Problem determining external account from @external_account_id",
		external_account_id = @external_account_id
	return
end

/*
| Flip the perspective
*/

select
	@quantity = -@quantity


select
	@deal_type = case @deal_type
		when "Market Forward" then  "Market Forward"
		when "B2B Forward" then     "Market Forward"
		when "B2B Swap" then        "Market Swap"
	end

select
	@deal_identifier =  convert(varchar(100), @src_deal_id)

select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_identifier
if @@rowcount != 1
begin
	exec
		j_nextkey
			"deals",
			@deal_id output

	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @@rowcount != 1
	begin
		select
			"error"="Error",
			"msg" = "Problem determining deal type from",
			"deal_type"= @deal_type
		return
	end
	select
		@uncommitted_status_id = status_id
	from
		statuses
	where
		name = "Uncommitted"
        if @@rowcount != 1
        begin
                select
                        "error"="Error",
                        "msg" = "Problem determining 'Uncomitted' status"
                return
        end

		
	insert into
		deals
	values(
		@deal_id,
		@deal_type_id,
		getdate(),
		@uncommitted_status_id
		)

	insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_identifier
		)
end
		
		
/*
| Tally Trade
*/
exec 
        fxa_tallytrade
                @login = @login,
                @source = @source,
                @trade_id = @trade_id output,
                @deal_id = @deal_id output,
                @tally_type = @trade_type,
                @deal_type = @deal_type,
                @trade_type = @trade_type,      
		@trader = @trader,
                @external_account = @external_account,
                @counterparty = @counterparty,
                @quantity = @quantity,
                @symbol = @contract,
                @value_date = @value_date,
                @price = @std_price,
                @trade_date = @trade_date,
                @fixing_date = @fixing_date,
		@identifier = @identifier,
		@broker = @broker



if @trade_id != NULL
begin
	select
		status="Trade Successfully Tallied",
		trade_id = @trade_id,
		deal_id = @deal_id,
                trader = @trader,
                external_account = @external_account,
                counterparty = @counterparty,
                quantity = @quantity,
                symbol = @contract,
                value_date = @value_date,
                price = @std_price,
                trade_date = @trade_date,
                identifier = @identifier
	/*
	| Log information from source database
	*//*
	select
     		@trade_id,
                @source_id,
                @src_notification_id,
                @src_trade_id,
                @src_trade_identifier,
                @src_trade_status_id,
                @src_deal_id,
                @src_deal_identifier,
                @src_deal_status_id */
	
	insert into
		source_trade_details
	(
        	trade_id,
        	source_id,	
        	trade_notification_id,	
        	source_trade_id,	
        	source_trade_identifier,	
        	source_trade_status_id,	
        	source_deal_id,	
        	source_deal_identifier,	
        	source_deal_status_id
	)
	values(
		@trade_id,
		@source_id,
		@src_notification_id,
		@src_trade_id,
		@src_trade_identifier,
		@src_trade_status_id,
		@src_deal_id,
		@src_deal_identifier,
		@src_deal_status_id
	)


	exec 
		r_inserttradenotification
				@trade_id=@trade_id


	/*
	| Tally Client Trade if B2B
	*/
	if @b2b_trader != NULL
	begin
		declare @b2b_identifier varchar(100)
		declare @b2b_quantity float
	
		select
			@b2b_identifier = rtrim(@identifier)+".autob2b",
			@b2b_quantity = -@quantity
		exec 
        		fxa_tallytrade
                		@login = @login,
                		@source = @source,
                		@trade_id = @b2btrade_id output,
                		@deal_id = @deal_id output,
                		@tally_type = @trade_type,
                		@deal_type = @deal_type,
                		@trade_type = @trade_type,
                		@trader = @b2b_trader,
                                @external_account = NULL, /* Determined by tally defaults of trader */
                                @counterparty = NULL,
                		@quantity = @b2b_quantity,
                		@symbol = @contract,
                		@value_date = @value_date,
                		@price = @std_price,
                		@trade_date = @trade_date,
                		@fixing_date = @fixing_date,
                		@identifier = @b2b_identifier,
                		@broker = @broker

		if @b2btrade_id != NULL
		begin
		        select
                		status="Trade Successfully Tallied",
                                trade_id = @b2btrade_id,
                                deal_id = @deal_id,
                                trader = @b2b_trader,
				external_acount = NULL,
				counterparty = NULL,
                                quantity = @b2b_quantity,
                                symbol = @contract,
                                value_date = @value_date,
                                price = @std_price,
                                trade_date = @trade_date,
                                identifier = @identifier,
                                broker = @broker
			
			exec 
                		r_inserttradenotification
                                		@trade_id=@b2btrade_id	
		end
		else
		begin
			select
                		error="Error tallying B2B trade"
		end
	end
end
else
begin
	select
		error="Error tallying trade"
end




go

