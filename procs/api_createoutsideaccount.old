create or replace procedure
	api_createoutsideaccount
		@login varchar(50),
		@outside_account_type varchar(50),
		@legal_entity varchar(150),
		@provider varchar(50),
		@name varchar(200)
		
as


declare @outside_account_id int
declare @outside_account_type_id int
declare @legal_entity_id int
declare @provider_id int

select
	@outside_account_type_id = outside_account_type_id
from
	outside_account_types
where
	name = @outside_account_type
if @outside_account_type_id = NULL
begin
	select
		status = "Error",
		message = "Outside account type not found",
		outside_account_type = @outside_account_type
	return
end

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @legal_entity_id = NULL
begin
	select
		status = "Error",
		message = "Legal entity not found",
		legal_entity = @legal_entity
	return
end

select
	@provider_id = provider_id
from
	providers
where
	name = @provider
if @provider_id = NULL
begin
	exec
		j_nextkey
			"providers",
			@provider_id output
	insert into
		providers(
			provider_id,
			name)
	values(
		@provider_id,
		@provider)
end

exec
	j_nextkey
		"outside_accounts",
		@outside_account_id output

insert into
	outside_accounts(
		outside_account_id,
		outside_account_type_id,
		legal_entity_id,
		provider_id,
		name)
values(
	@outside_account_id,
	@outside_account_type_id,
	@legal_entity_id,
	@provider_id,
	@name)

	

go



