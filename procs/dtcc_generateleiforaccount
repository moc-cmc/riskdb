drop procedure dtcc_generateleiforaccount
go

create procedure 
	dtcc_generateleiforaccount
		@login varchar(50),
		@external_account varchar(50)

as

declare @external_account_id int
declare @lei char(20)

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		msg = "Problem determining external account",
		external_account=@external_account
	return
end

exec
	dtcc_generatelei
		@login,
		@lei output

if @lei = NULL
begin
	return
end

exec
	dtcc_addregulatoryinfo
		@login=@login,
		@external_account = @external_account,
		@lei_number = @lei,
		@lei_type = "Internal"

go
