drop procedure r_revalandcommittrades
go

create procedure
	r_revalandcommittrades
		@login varchar(50),
		@commit_session_id int=NULL

as

declare @fund_id int
declare @tico_account_id int
declare @fund_type varchar(30)
declare @fund_name varchar(30)

declare @commit_runs int
declare @runs_committed int

declare @date datetime
declare @last_commit_date datetime
declare @next_commit_date datetime

declare @max_commit_transaction_dt datetime
declare @fo_commit_type_id int

declare @today_eod datetime
declare @dummy_date datetime


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount = 0
begin
	select 
		"error" = "Error",
		"msg" = "Problem determing account from login",
		"login" = @login
	return
end
	

exec	
	r_defaultfundforlogin
			@login,
			@fund_id output	

select
	@fund_name = a.name,
	@fund_type = b.name
from
	funds a,
	fund_types b
where
	a.fund_type_id = b.fund_type_id
and
	a.fund_id = @fund_id
if @@rowcount != 1
begin
	select
		"error" = "Error",
		"msg" = "Problem finding fund from id"
	return
end




select 
	@last_commit_date = max(reval_date)
from
	committed_daily_revals

select
	@fo_commit_type_id = transaction_type_id
from
	transaction_types
where
	name = "Front Office Commit"
if @@rowcount != 1
begin
	select 
		error = "Error",
		msg = "Problem determining id for transaction type",
		type = "'Front Office Commit'"
	return
end	


select
	@max_commit_transaction_dt = max(transaction_date)
from
	int_account_transactions
where
	transaction_type_id = @fo_commit_type_id
if @max_commit_transaction_dt = NULL

if @max_commit_transaction_dt < @last_commit_date
begin
	select
		@last_commit_date = @max_commit_transaction_dt
end
	
if @last_commit_date = NULL
begin
	select 
		@last_commit_date = @max_commit_transaction_dt
end


if @last_commit_date = NULL
begin
	declare @month int
	declare @monthchar char(2)
	declare @year int
	select
		@month = datepart(month, min(trade_date)),
		@year = datepart(year, min(trade_date))
	from
		trades

	if @month < 10
		select 
			@monthchar = "0"+convert(char(1), @month)
	if @month > 9
		select
			 @monthchar = convert(char(2), @month)
	select
		@last_commit_date = rtrim(convert(varchar(4), @year))+rtrim(@monthchar)+"01"

	exec 
		r_prevbusinessday
			@last_commit_date,
			@last_commit_date output

end
			
	
select
	@last_commit_date = convert(char(8), @last_commit_date, 112)+" 17:00"

exec
	r_nextbusinessday
		@last_commit_date,
		@next_commit_date output


create table
	#commit_run_accounts
(
	internal_account_id int
)

if @fund_type = "FX Agency"
begin
	insert into 
		#commit_run_accounts
	select
		run_id
	from
		runs
	where
		name = @fund_name
end
else
begin
	insert into 
		#commit_run_accounts
	select
		run_id
	from
	        runs
end

select 
	@commit_runs = count(*)
from
	#commit_run_accounts

select
	@runs_committed = count(*)
from
	int_account_transactions
where
	transaction_type_id = @fo_commit_type_id
and
	transaction_date = @last_commit_date










create table
	#output
(
	fund_name varchar(50), 
	commitable_runs int,
	runs_committed int,
	uncommit_last_date varchar(25),
	last_commit_date datetime,
	uncommit_date datetime,
	next_commit_date datetime,
	action varchar(25) NULL,
	batch_id int NULL,
	session_id int NULL,
	commit_session_id int NULL,
	trade_date datetime NULL
)


insert into 
	#output
(
	fund_name,
	commitable_runs,
	runs_committed,
	uncommit_last_date,
	last_commit_date,
	uncommit_date,
	next_commit_date,
	action,
	batch_id,
	session_id,
	commit_session_id,
	trade_date
)
values(
	@fund_name,
	@commit_runs,
	@runs_committed,
	"UNCOMMIT "+convert(char(5), @last_commit_date,1),
	@last_commit_date,
	convert(char(8), @last_commit_date,112),
	@next_commit_date,
	"REVAL TRADES "+convert(char(5), @next_commit_date, 1),
	@commit_session_id,
	@commit_session_id,
	@commit_session_id,
	convert(char(8), @next_commit_date, 112)
	)

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL)

if exists(select trade_daily_reval_id from trade_daily_revals where reval_date = @next_commit_date)
begin
	update 
		#output
	set
		action = "CALCULATE COMMITS "+convert(char(5), @next_commit_date, 1)
	
	if exists(	select 
				session_id
			from
				session_runs
			where
				session_id = @commit_session_id
		)
	begin

		update 
			#output
		set
			action = "CONFIRM P&L "+convert(char(5), @next_commit_date, 1)
	end
end
	
if @commit_session_id = NULL
begin
	update
		#output
	set
		action= "REVAL TRADES "+convert(char(5), @next_commit_date, 1)
end


select @today_eod = getdate()

exec
        r_daterangefordate
                @today_eod,
                @dummy_date output,
                @today_eod output


if @today_eod = @next_commit_date
begin
	update
		#output
	set
		action=""
end

insert into 
	#links
values(
	"Column Link",
	"uncommit_last_date",
	"Uncommit PL for Date",
	NULL
)
insert into 
	#links
values(
	"Column Link",
	"action",
	"Commit Process",
	NULL
)

insert into
        #links
values(
        "Column Hidden",
        "session_id",
        NULL,
        NULL
)

insert into
        #links
values(
        "Column Hidden",
        "batch_id",
        NULL,
        NULL
)

insert into
        #links
values(
        "Column Hidden",
        "trade_date",
        NULL,
        NULL
)

insert into
        #links
values(
        "Column Hidden",
        "uncommit_date",
        NULL,
        NULL
)





select * from #links
select
	fund_name,
        commitable_runs,
        runs_committed,
        uncommit_last_date,
        last_commit_date,
        uncommit_date,
        next_commit_date,
        action,
        batch_id,
        session_id,
        commit_session_id,
        trade_date
from
	#output
go


