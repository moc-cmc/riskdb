
if object_id("r_reconcilepbreporttrades") != NULL
    drop procedure
        r_reconcilepbreporttrades
go
/*
 * "Show [Report]" Action (-> "Overview")
 *   Displays a summary of the report by calculating a #match_list including 
 *   the set of contracts, total number of 
 *
 * "Show [Details]"
 * 
 * "[Rematch] Trades"
 * 
 * "[Commit] Match"
 *
 * "[Uncommit] Match"
 *
 * "Tally"
 */

create procedure
    r_reconcilepbreporttrades
        @login char(50),
		@prime_broker varchar(50),
        @trade_date datetime,
        @action char(100),
        @contract char(100)
as

declare @fund char(100)
declare @external_report char(100)
declare @prime_broker_id int
declare @external_report_id int
declare @prime_broker_source_id int
declare @report_commit_id int
declare @begin_date datetime
declare @end_date datetime
declare @fund_id int
declare @status char(50)
declare @source_id int
declare @filter_contract_id int
declare @autoreconiliation_action char(50)

declare @mismatch_strength float
declare @reconciled_strength float
declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @mismatched_status_id int
declare @matched_status_id int
declare @committed_status_id int
declare @review_status_id int

declare @noop int

/* 
 * Calculate @begin_date and @end_day
 */
select
    @begin_date = convert(datetime, convert(char(10), @trade_date, 101))
exec
    r_prevbusinessday
        @begin_date,
        @begin_date output
select
    @begin_date = convert(datetime, convert(char(10), @begin_date, 101) + " 17:00")
exec
    r_nextbusinessday
        @begin_date,
        @end_date output


/* ------MARK: Find the @external_report and @fund strings from @prime_broker------ */


select
	@prime_broker_id = a.prime_broker_id,
	@prime_broker_source_id = a.source_id
from	
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id 
and
	b.name = @prime_broker
if @@rowcount != 1
begin	
	select
			id = -1,
			error = "Problem determining prime broker",	
			prime = @prime_broker
	return
end

select
	@external_report = a.name,
	@external_report_id = external_report_id
from
	external_reports a,
	report_types b
where
	a.report_type_id = b.report_type_id 
and
	a.source_id = @prime_broker_source_id
and
	b.name = "Trade Recon"
if @@rowcount = 0
begin   
    select
            id = -1,
            error = "Problem determining 'Trade Recon' report for prime broker",
			prime = @prime_broker
    return
end
if @@rowcount > 1
begin   
    select
            id = -1,
            error = "More than 1 'Trade Recon' report for designated for prime broker",
			prime = @prime_broker
    return
end

select
	@fund = a.name
from
	funds a,
	fund_reports b
where
	a.fund_id = b.fund_id
and
	b.external_report_id = @external_report_id
if @@rowcount != 1
begin
	select 
			id = -1,
			error = "Problem determining a single fund from external'Trade Recon' report"
	return
end


/* -------------------- MARK: Find the @report_commit_id -------------------- */
exec
    r_reportcommitfordate
        @fund,
        @external_report,
        @trade_date,
        @report_commit_id output
if @report_commit_id = NULL
begin
    select
        id = -1,
        error = "Couldn't find the requested report commit"
    return
end

/* 
 * Find the @fund_id, commit @status and @source_id from the @report_commit_id,
 * we could've also gotten this using @fund and @external_report but this should
 * be more consistent
 */
select
    @fund_id = b.fund_id,
    @source_id = c.source_id,
    @status = d.name
from
    report_commits a,
    fund_reports b,
    external_reports c,
    statuses d
where
    a.report_commit_id = @report_commit_id
and
    a.fund_report_id = b.fund_report_id
and
    b.external_report_id = c.external_report_id
and
    a.status_id = d.status_id
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the external report, """ 
                + rtrim(@external_report) + """"
    return
end

/* 
 * Calculate the contract filter
 */
create table
    #contracts (
        contract_id int
    )
if @contract != NULL
begin
    /* 
     * If a @contract was specified, then only display the contract and
     * its inverted form
     */
    insert into
        #contracts
    select
        contract_id
    from
        contracts c
    where
        c.symbol = @contract
    
    insert into
        #contracts
    select
        c.contract_id
    from
        forwards a,
        contracts b,
        forwards c
    where
        a.contract_id = b.contract_id
    and
        b.symbol = @contract
    and
        a.product_id = c.currency_id
    and
        a.currency_id = c.product_id
end
else
begin
    /* Include all contracts of internal trades */
    insert into
        #contracts
    select distinct
        a.contract_id
    from
        trades a,
        fund_external_accounts b
    where
        a.external_account_id = b.external_account_id
    and
        b.fund_id = @fund_id
        
    /* Include all contracts of external trades */
    insert into
        #contracts
    select distinct
        b.contract_id
    from
        report_trades a,
        contracts b,
        #contracts c
    where
        a.report_commit_id = @report_commit_id
    and
        b.symbol in ( 
            rtrim(a.ccy_1) + rtrim(a.ccy_2), 
            rtrim(a.ccy_2) + rtrim(a.ccy_1)
        )
    and
        b.contract_id = c.contract_id
    and
        b.contract_id not in (
            select
                contract_id
            from
                #contracts
        )
end


/* ------------------------- MARK: Retrieve settings ------------------------ */

select
    @mismatched_status_id = status_id
from
    statuses
where
    name = "Mismatched"
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the ""Mismatched"" status"
    return
end

select
    @matched_status_id = status_id
from
    statuses
where
    name = "Matched"
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the ""Matched"" status"
    return
end

select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the ""Committed"" status"
    return
end

select
    @review_status_id = status_id
from
    statuses
where
    name = "Review"
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the ""Review"" status"
    return
end


create table
    #meta (
        meta_type char(50),
        name char(50) NULL,
        action char(100) NULL,
        value char(200) NULL
    )
    

 
/*+---------------------------------------------------------------------------* 
 |                      MARK: Filter Internal Trades                          | 
 *----------------------------------------------------------------------------*/

/*------- MARK: Ensure all external_accounts are tied to prime broker ------- */


if exists (select * from external_accounts where external_account_id
			not in(select external_account_id from external_account_prime_brokers))
begin
	
	select
		id = -1,
		error = "Prime broker not defined for external account(s)"

	select
		unmapped_account = a.symbol
	from
		external_accounts a
	where
		a.external_account_id not in(
					select
						external_account_id
					from
						external_account_prime_brokers)

	/*   ---- commented out, but can be used to provide option to map -----		
	select
		external_account = a.symbol,
		prime_broker = b.name,
		map_ext_acount = "MAP"
	from
		external_accounts a,
		sources b,
	    prime_brokers c	
	where
		b.source_id = c.source_id  /* only join on sources & prime_brokers */
	and
		a.external_account_id not in(
					select
						external_account_id
					from
						external_account_prime_brokers)
	*/


	return
end

create table
			#pb_external_accounts
(
			external_account_id int,
			symbol varchar(100)
)

insert into #pb_external_accounts
select
	a.external_account_id,
	a.symbol
from
	external_accounts a, 
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = @prime_broker_id
if @@rowcount = 0
begin
	select
		id = -1,
		msg = "No external accounts defined for prime broker",
		prime = @prime_broker
	
	return
end
	



/*+---------------------------------------------------------------------------* 
 |                           MARK: Perform Actions                            | 
 *----------------------------------------------------------------------------*/
 if @action like "%Clear"
 begin
    delete
    from
        report_trade_matches
    where
        report_trade_match_id in (
            select
                a.report_trade_match_id
            from
                report_trade_matches a,
                trades b,
                #contracts c,
				#pb_external_accounts d
            where
                a.trade_id = b.trade_id
            and
                b.contract_id = c.contract_id
            and
                report_commit_id = @report_commit_id
			and
				b.external_account_id = d.external_account_id
        )
 end

/* 
 * If we've been asked to Rematch the trades, then clear out all of the
 * report_trade_matches for our @report_commit_id and call our matching proc.
 */
if @action like "%Rematch%" or @action like "%Match%"
begin

    /* If we're "Rematch"ing, then delete the prior matches for this report */
    if @action like "%Rematch%"
    begin
        delete
        from
            report_trade_matches
        where
            report_trade_match_id in (
                select
                    a.report_trade_match_id
                from
                    report_trade_matches a,
                    trades b,
                    #contracts c,
					#pb_external_accounts d
                where
                    a.trade_id = b.trade_id
                and
                    b.contract_id = c.contract_id
                and
                    report_commit_id = @report_commit_id
				and
					b.external_account_id = d.external_account_id
            )
    end
    
    select
        @autoreconiliation_action = "Match"
    if @action like "%Aggressive%"
        select
            @mismatch_strength = -1e5,
            @autoreconiliation_action = "Non-Broker Match"
        
    exec
        r_autoreconcilepbreport
            @login,
            @prime_broker,
            @trade_date,
            @autoreconiliation_action,
            @mismatch_strength,
            @reconciled_strength,
            NULL,
            @contract,
            NULL,
            NULL

    select
        @action = "Show Report"
end

/* 
 * If we commit the entire report, then simply ensure that all matches have been
 * commited.
 */
if @action like "%Commit%"
begin

    if exists (
            select
                *
            from
                report_trade_matches a,
                statuses b,
				trades c,
				#pb_external_accounts d	
            where
                a.report_commit_id = @report_commit_id
            and
                a.status_id = b.status_id
			and
				a.trade_id = c.trade_id 
			and
				c.external_account_id = d.external_account_id
            and
                b.name != "Committed"
        )
    begin
        select
            id = -1,
            msg = "Not all matches have been committed"
    end
    else
    begin
        update
            report_commits
        set
            status_id = @committed_status_id
        where
            report_commit_id = @report_commit_id
        if @@rowcount != 1
        begin
            select
                id = -1,
                error = "Couldn't commit report"
            return
        end
        select
            @status = "Committed"
    end

    select
        @action = "Show Report"
end
else if @action like "%Uncommit%"
begin

    update
        report_commits
    set
        status_id = @review_status_id
    where
        report_commit_id = @report_commit_id
    if @@rowcount != 1
    begin
        select
            id = -1,
            error = "Couldn't commit report"
        return
    end
    select
        @status = "Review"

    select
        @action = "Show Report"
end
    
if @action like "Tally External-Only"
begin
    declare @report_trade_id int
	
	create table
			#for_external_only_cursor
	(
		report_trade_id int
	)

	insert into #for_external_only_cursor
	select 
		a.report_trade_id
    from
        report_trades a,
		#pb_external_accounts b
    where
        a.report_commit_id = @report_commit_id
	and
		a.external_account_id = b.external_account_id 
    and
        a.report_trade_id not in (
            select
                a.report_trade_id
            from
                report_trade_matches a,
				report_trades b,
				#pb_external_accounts c
            where
                a.report_commit_id = @report_commit_id
			and
				a.report_trade_id = b.report_trade_id
			and
				b.external_account_id = c.external_account_id
        )

    
    declare
        external_onlys
    cursor for select
				report_trade_id
			from
				#for_external_only_cursor
		
    open external_onlys
    
    fetch external_onlys into
        @report_trade_id
    while @@sqlstatus = 0
    begin
        exec
            r_commitreporttrade
                @login,
                @report_commit_id,
                @report_trade_id,
                NULL,
                "Tally"
    
        fetch external_onlys into
            @report_trade_id
    end
    close external_onlys
    deallocate cursor external_onlys
    
    select
        @action = "All"
end
    
/*+---------------------------------------------------------------------------* 
 |                           MARK: Collect Matches                            | 
 *----------------------------------------------------------------------------*/
 
create table 
    #match_list (
        report_trade_match_id int NULL,
        report_trade_id int NULL,
        trade_id int NULL,
        id char(50) NULL, /* dual */
        contract char(10),
        match_status char(30),
        match_strength float NULL,
        inverted bit,
        match_status_text char(40),
        trader char(50) NULL, /* dual? */
        trade_date char(50), /* dual */
        value_date char(10),
        quantity char(50), /* dual */
        in_quantity numeric(30,10) NULL,
        ex_quantity numeric(30,10) NULL,
        price char(50), /* dual */
        in_price float NULL,
        ex_price float NULL,
        internal_account char(50) NULL, 
        external_account char(50),
        broker char(25) NULL,
        strategy char(75), /* dual */
        symbol char(200) NULL, /* dual */
        ok char(50) NULL,
        change char(50) NULL,
        unpair char(50) NULL,
        tally char(50) NULL,
        edit_report_commit char(50) NULL,
        style char(100) NULL
	
    )

/* ------------------------ MARK: Add external trades ----------------------- */

/*select
    *
from
    #contracts
*/

insert into
    #match_list
select
    NULL,
    a.report_trade_id,
    NULL,
    str(a.report_trade_id) + " EX",
    rtrim(a.ccy_1) + rtrim(a.ccy_2),
    "External Only",
    NULL,
    0,
    "<b>External Only</b>",
    NULL,
    convert(char(5), a.activity_date, 1) + " " + convert(char(5), a.activity_date, 8),
    convert(char(5), a.value_date, 1),
    convert(char(30), convert(numeric(30,2), round(a.ccy_1_quantity, 2))),
        NULL,
        a.ccy_1_quantity,
    convert(char(30), convert(numeric(30,6), round(- a.ccy_2_quantity / a.ccy_1_quantity, 6))),
        NULL,
        - a.ccy_2_quantity / a.ccy_1_quantity,
    NULL,
    f.symbol,
    c.symbol,
    b.name,
    a.client_identifier,
    NULL,
    NULL,
    NULL,
    "Tally",
    "Edit Report Commit",
	"background:#c4ff5e"
from
    report_trades a,
    strategies b,
    brokers c,
/*    #contracts d,
*/
    contracts e,
	#pb_external_accounts f
where
    a.report_commit_id = @report_commit_id
and
    a.strategy_id = b.strategy_id
and
    a.broker_id *= c.broker_id
/*and
    d.contract_id = e.contract_id
*/
and
    e.symbol = rtrim(a.ccy_1) + rtrim(a.ccy_2)
and
    a.external_account_id = f.external_account_id
    
/*select
    external_count = @@rowcount,
    total = count(*)
from
    #match_list
*/

    
/* ---------------------- MARK: Cache external_accounts --------------------- */
 
create table
    #external_accounts (
        external_account_id int,
		symbol varchar(100)
        )

insert into
    #external_accounts
select
    a.external_account_id,
	a.symbol
from
    #pb_external_accounts a,
    external_accounts b
where
    a.external_account_id = b.external_account_id
and
    b.name not like "% INT"
    
/* ------------------------ MARK: Add internal trades ----------------------- */

insert into
    #match_list
select
    NULL,
    NULL,
    a.trade_id,
    str(a.trade_id) + " IN",
    c.symbol,
    "Internal Only",
    NULL,
    0,
    "<b>Internal Only</b>",
    d.symbol,
    convert(char(5), a.trade_date, 1) + " " + convert(char(5), a.trade_date, 8),
    convert(char(5), a.value_date, 1),
    convert(char(30), convert(numeric(30,2), round(a.quantity, 2))),
        a.quantity,
        NULL,
    convert(char(30), convert(numeric(30,6), round(a.price, 6))),
        a.price,
        NULL,
    f.symbol,
    g.symbol,
    h.symbol,
    i.name,
    a.identifier,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
	"background:#fcf860"
from
    trades a,
    #external_accounts b,
    contracts c,
    traders d,
    internal_accounts f,
    external_accounts g,
    brokers h,
    strategies i
where
    a.external_account_id = b.external_account_id
and
    a.trade_date >= @begin_date
and
    a.trade_date < @end_date
and
    a.contract_id = c.contract_id
and
    d.trader_id = a.trader_id
and
    a.internal_account_id = f.internal_account_id
and
    a.external_account_id = g.external_account_id
and
    a.broker_id = h.broker_id
and
    a.strategy_id = i.strategy_id
and
    a.quantity != 0

/*select
    internal_count = @@rowcount,
    total = count(*)
from
    #match_list
select
    *
from
    #contracts
select
    *
from
    #external_accounts
*/
    
delete
from
    #match_list
where
    trade_id in (
        select
            a.trade_id
        from
            report_trade_matches a,
			trades b,
			#pb_external_accounts c
        where
            a.report_commit_id = @report_commit_id
		and
			a.trade_id = b.trade_id 
		and
			b.external_account_id = c.external_account_id
    )
or
    report_trade_id in (
        select
            a.report_trade_id
        from
            report_trade_matches a,
			report_trades b,
			#pb_external_accounts c
        where
            a.report_commit_id = @report_commit_id
		and
			a.report_trade_id = b.report_trade_id
		and
			b.external_account_id = c.external_account_id
    )
    
/*select
    delete_count = @@rowcount,
    total = count(*)
from
    #match_list
*/


/* ------------------------ MARK: Add matched trades ------------------------ */

insert into
    #match_list
select
    a.report_trade_match_id,
    c.report_trade_id,
    b.trade_id,
    str(b.trade_id) + " IN<br/>" + str(c.report_trade_id) + " EX",
    d.symbol,
    l.name,
    a.match_strength,
    a.inverted,
    case when a.inverted != 0 then 
        "<b>" + rtrim(l.name) + "</b> Inverted<br/>" 
        	+ rtrim(convert(varchar(50), convert(numeric(30,3), round(a.match_strength * 100, 3)))) + "%"
    else
        "<b>" + rtrim(l.name) + "</b><br/>" 
        	+ rtrim(convert(varchar(50), convert(numeric(30,3), round(a.match_strength * 100, 3)))) + "%"
/*        rtrim(l.name) + "<br/>" + rtrim(convert(varchar(6), 
            convert(int, 100000 * a.match_strength) / 1000.0)) + "%"
*/
    end,
    e.symbol,
    convert(char(5), b.trade_date, 1) + " " + convert(char(5), b.trade_date, 8)
            + "<br/>" + convert(char(5), c.activity_date, 1) + " " 
            + convert(char(5), c.activity_date, 8),
    convert(char(5), b.value_date, 1),
    case when a.inverted != 0 then 
        rtrim(convert(char(30), convert(numeric(30,2), round(b.quantity, 2)))) + "<br/>" 
        + rtrim(convert(char(20), convert(numeric(30,2), round(c.ccy_2_quantity, 2))))
    else
        rtrim(convert(char(30), convert(numeric(30,2), round(b.quantity, 2)))) + "<br/>" 
        + rtrim(convert(char(20), convert(numeric(30,2), round(c.ccy_1_quantity, 2))))
    end,
        b.quantity,
        case when a.inverted != 0 then
            c.ccy_2_quantity
        else
            c.ccy_1_quantity
        end,
    case when a.inverted != 0 then 
        rtrim(convert(char(30), convert(numeric(30,6), round(b.price, 6)))) + "<br/>" 
        + rtrim(convert(char(20), convert(numeric(30,6), 
        round(-1 * c.ccy_1_quantity / c.ccy_2_quantity, 6))))
    else
        rtrim(convert(char(30), convert(numeric(30,6), round(b.price, 6)))) + "<br/>" 
        + rtrim(convert(char(20), convert(numeric(30,6), 
        round(-1 * c.ccy_2_quantity / c.ccy_1_quantity, 6))))
    end,
        b.price,
        case when a.inverted != 0 then
            -1 * c.ccy_1_quantity / c.ccy_2_quantity
        else
            -1 * c.ccy_2_quantity / c.ccy_1_quantity
        end,
    g.symbol,
    h.symbol,
    rtrim(i.symbol) + "<br/>" + rtrim(n.symbol),
    rtrim(j.name) + "<br/>" + rtrim(k.name),
    rtrim(b.identifier) + "<br/>" + rtrim(c.client_identifier),
    case 
        when l.name = "Matched" then "OK"
        when l.name = "Mismatched" then "OK"
        when l.name = "Committed" then "Uncommit"
    end,
    case 
        when l.name = "Matched" then "Modify"
        when l.name = "Mismatched" then "Modify"
        when l.name = "Committed" then ""
    end,
    case 
        when l.name = "Matched" then "Unpair"
        when l.name = "Mismatched" then "Unpair"
        when l.name = "Committed" then ""
    end,
    NULL,
    NULL,
    case 
        when l.name = "Matched" then "background:#fff"
        when l.name = "Mismatched" then "background:#decafc"
        when l.name = "Committed" then "background:#f0f0f8;color:#666"
    end
from
    report_trade_matches a,
    trades b,
    report_trades c,
    contracts d,
    traders e,
    internal_accounts g,
    #external_accounts h,
    brokers i,
    strategies j,
    strategies k,
    statuses l,
/*    #contracts m,
*/
    brokers n
where
    a.report_commit_id = @report_commit_id
and
    a.trade_id = b.trade_id
and
    a.report_trade_id = c.report_trade_id
and
    b.contract_id = d.contract_id
and
