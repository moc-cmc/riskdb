        a.style,
		"prime_broker" = @prime_broker
    from
        #match_list a
    where 
        (
            @contract = NULL
        or
            (
                a.contract in (
                    select
                        b.symbol
                    from
                        contracts b,
                        #contracts c
                    where
                        b.contract_id = c.contract_id
                )
            )
        )
    and 
        (
            a.match_status != "Committed"
        or
            @action like "%All%"
        )
    order by
        a.contract asc,
        a.broker asc,
        a.value_date asc,
        a.external_account asc,
        a.quantity asc,
        a.match_status_text asc
        
end

