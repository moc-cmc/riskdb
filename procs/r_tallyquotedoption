create procedure
	r_tallyquotedoption
		@login varchar(50),
		@trader_name varchar(50),	
		@biproduct varchar(20),
		@buy_amt numeric(30,4),
		@expiration_date datetime,
		@strike_price float,
		@p_or_c varchar(50),
		@volatility float,
		@spot_ref float,
		@bid float,
		@offer float


as


declare @buysell varchar(20)
declare @timezone varchar(40)
declare @settle_date datetime
declare @price_format varchar(20)
declare @total_premium numeric(30,4)
declare @premium_currency varchar(50)
declare @premium_settledate datetime
declare @quantity numeric(30,4)
declare @price float

if @buy_amt > 0
select
	@buysell = "Client Buys"

if @buy_amt < 0
select
	@buysell = "Client Sells"

if @buysell = "Client Buys"
select
	quantity = @buy_amt

if @buysell = "Client Sells"
select
	@quantity = -@buy_amt

if @quantity > 0
select
	@price = @offer

if @quantity < 0
select
	@price = @bid

select
	@timezone = "New York"

select
	@settle_date = dateadd(dd, 2, @expiration_date)

select
	@price_format = "Pips"

select
	@premium_currency = substring(@biproduct, 4, 3)

select
	@trader_name,
	@quantity,
	@expiration_date,
	@strike_price,
	@p_or_c,
	@volatility,
	@spot_ref,
	@bid,
	@offer,
	@buysell,
	@timezone,
	@settle_date,
	@price_format,
	@total_premium,
	@premium_currency,
	@premium_settledate,
	@quantity,
	@price

