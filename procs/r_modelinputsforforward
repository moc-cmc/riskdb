
if object_id("r_modelinputsforforward") != NULL
    drop procedure
        r_modelinputsforforward
go

create procedure
	r_modelinputsforforward
		@contract_id int
as

declare @underlying_price float
declare @underlying_contract_id int
declare @as_of_date datetime
declare @rate_date datetime
declare @spot_price float
declare @expiration datetime
declare @vol float
declare @minutes int
declare @hours float
declare @days float
declare @interest_rate float
declare @carry_cost float
declare @product_rate float
declare @currency_rate float
declare @contract_tv_id int
declare @current_vol_timestamp datetime
declare @saved_vol_timestamp datetime


select
	@expiration = b.expiration,
	@underlying_contract_id = c.underlying_contract_id
from
	option_contracts a,
	option_expirations b,
	options c
where
	a.contract_id = @contract_id
and
	a.option_expiration_id = b.option_expiration_id
and
	b.option_id = c.option_id

exec
	r_nextbusinessday
		@expiration,
		@rate_date output

exec
	r_nextbusinessday
		@rate_date,
		@rate_date output

select
	@as_of_date = getdate()


select
	@contract_tv_id = contract_tv_id
from
	contract_tvs
where
	contract_id = @contract_id
and
	tv_date = (
		select
			max(tv_date)
		from
			contract_tvs
		where
			contract_id = @contract_id)

/* New logic for vol lookup, try to always use the more recent vol
	between the contract_tvs and current_contract_tvs. Previous
	logic always used the most recent contract_tvs and never
	looked at the current_contract_tv  
select
	@saved_vol_timestamp = tv_date
from
	contract_tvs
where
	contract_tv_id = @contract_tv_id

select
	@current_vol_timestamp = timestamp
from
	current_contract_tvs
where
	contract_id = @contract_id 


if @current_vol_timestamp = NULL or @current_vol_timestamp < @saved_vol_timestamp
	select
		@vol = volatility
	from
		contract_tvs
	where
		contract_tv_id = @contract_tv_id
else
	select
		@vol = volatility
	from
		current_contract_tvs
	where
		contract_id = @contract_id

if @vol = NULL
	select
		@vol = volatility
	from
		contract_tvs
	where
		contract_tv_id = @contract_tv_id  */

select
	@vol = volatility
from
	contract_tvs
where
	contract_tv_id = @contract_tv_id 

exec
	r_forwardpriceasof
		@underlying_contract_id,
		@as_of_date,
		@rate_date,
		@days output,
		@spot_price output,
		@underlying_price output,
		@currency_rate output,
		@product_rate output

select
	@minutes = datediff(minute, getdate(), @expiration)
if @minutes >= 1
	select
		@hours = convert(float, @minutes) / 60.0
else
	select
		@hours = 0,
		@vol = 0

select
	@days = @hours / 24.0 
	

select
	underlying_price = @underlying_price,
	volatility = @vol,
	days = @days,
	interest_rate = @currency_rate,
	/* carry_cost = @product_rate, */
	carry_cost = 0.0,
	days_in_year = 360.0

go
