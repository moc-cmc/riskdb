
if object_id("r_marktraderesid") != NULL
    drop procedure
        r_marktraderesid
go

create procedure
	r_marktraderesid
		@login char(30),
		@deal_id int
as

declare @tico_account_id int
declare @total int
declare @resid_status_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@total = count(a.external_account_id)
from
	fund_external_accounts a,
	fund_tico_accounts b,
	trades c
where
	a.fund_id = b.fund_id
and
	a.external_account_id = c.external_account_id
and
	b.tico_account_id = @tico_account_id
and
	c.deal_id = @deal_id

if @total = 0
begin
	select
		id = -1,
		error = "Trade not found",
		deal_id = @deal_id
	return
end

select
	@deal_id = deal_id
from
	trades
where
	deal_id = @deal_id

select
	@resid_status_id = status_id
from
	statuses
where
	name = "Resid"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding Resid status"
	return
end

begin tran
	update
		trades
	set
		status_id = @resid_status_id
	where
		deal_id = @deal_id
commit tran

exec
	r_inspectdealtrades
		@login,
		@deal_id



go
