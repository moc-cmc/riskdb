
if object_id("r_resolveuser") != NULL
    drop procedure
        r_resolveuser
go

create procedure
	r_resolveuser
        @login varchar(50),
        @source varchar(50),
        
        @user_id int = NULL out,
        
        @name varchar(25) = NULL out,
        @password varchar(20) = NULL,
        @status_id int = NULL out,
        @status varchar(15) = NULL out,
        @surname varchar(50) = NULL out,
        @given_names varchar(100) = NULL out,
        
        @create char(1) = NULL out,
        @report char(1) = NULL
as

/* messages */
declare @to varchar(50)
declare @issue varchar(250)
declare @subject varchar(250)
declare @content varchar(250)
declare @check_sql varchar(250)

declare @should_create char(1)
declare @source_id int

select
    @should_create = @create,
    @create = "N"

if @login = NULL or @source = NULL
begin
    if @report != "N"
        select
            status = "Error",
            message = "Login and source required",
            login = @login,
            source = @source
    raiserror 99001, "@login and @source required"
    return
end

/* Set up defaults */
if @status = NULL
    select
        @status = "Active"
    
if @user_id = NULL
begin

    if @user_id = NULL and @name != NULL
        select
            @user_id = account_id
        from
            tico_accounts
        where
            login = @name
    
end


if @user_id = NULL
begin
    
    /* Resolve the @source_id from @source */
    exec
        r_resolvesource
            @login = @login,
            @source_id = @source_id out,
            @name = @source,
            @report = @report
    if @source_id = NULL
        return
        
    /* ---------------------------- MARK: Create ---------------------------- */

    if @should_create != "N" and /* has permission */ exists (
        select
            *
        from
            source_permissions
        where
            source_id = @source_id
        and
            autocreates_users = "Y"
    )
    begin
    
        if @name = NULL
        begin
            
            select
                @issue = "unsupported:r_resolveuser():missing:@name",
                @to = "support",
                @subject = "Couldn't autocreate user without a name",
                @content = "User does not exist. r_resolveuser attempted to create the user but no @name was provided."
            exec
                r_postmessage
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High"
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Cannot create user without specifying login",
                    'user' = @name
                    
            return
        end
        
        if @password = NULL
            select
                @password = newid()
                
        if @status_id = NULL
        begin
            select "M1"
            exec
                r_resolvestatus
                    @login = @login,
                    @source = @source,
                    @status_id = @status_id out,
                    @name = @status,
                    @create = "Y",
                    @report = @report
            if @status_id = NULL
            begin
                if @report != "N"
                    select
                        status = "Error",
                        message = "Couldn't resolve status, """ + @status + """"
                return
            end
        end
        
        if @surname = NULL
            select
                @surname = ""

        if @given_names = NULL
            select
                @given_names = @name
        
        exec
            j_nextkey
                "tico_accounts",
                @user_id out
        
        insert into
            tico_accounts
        values (
            @user_id,
            @name,
            @password,
            @status_id,
            @surname,
            @given_names
        )
        
        select
            @create = "Y"

        select
            @to = "support",
            @subject = "User, """ + @name + """, created",
            @content = "The user, """ + @name + """, was created by " + @login + " on behalf of " + @source + "."
        exec
            r_postmessage
                @login = @login,
                @to = @to,
                @channel = "General",
                @subject = @subject,
                @content = @content,
                @priority = "Low"
                
    end
    else
    begin
        
        select
            @issue = "notfound:tico_accounts(login=" + @name + ")",
            @to = "support",
            @subject = "User, """ + @name + """, not found",
            @content = "The user, """ + @name + """, could not be found.",
            @check_sql = "if exists(select * from tico_accounts where login = """ + @name + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
        exec
            r_manageissue
                @login = @login,
                @name = @issue,
                @to = @to,
                @channel = "General",
                @subject = @subject,
                @content = @content,
                @priority = "High",
                @check_sql = @check_sql
                
        if @report != "N"
            select
                status = "Error",
                message = "User not found",
                name = @name
                
        return
    end

end
    
select
    @name = a.login,
    @password = a.password,
    @status_id = b.status_id,
    @status = b.name,
    @surname = a.surname,
    @given_names = a.given_names
from
    tico_accounts a
join
    statuses b on a.status_id = b.status_id
where
    a.account_id = @user_id

go
