
drop procedure 
	fxa_canceltrade
go

create procedure
	fxa_canceltrade
		@login varchar(50),
		@deal_id int

as

declare @revals int
declare @trade_id int
declare @status_id int

select
	@revals = count(a.trade_id)
from
	trade_daily_revals a,
	trades b	
where
	a.trade_id = b.trade_id
and
	b.deal_id = @deal_id

if @revals > 0
begin
	select
		status = "Error",
		message = "This trade has been committed to the back office already. It cannot be canceled this way"
	return
end

declare cancel_trade cursor for

    select
        trade_id
    from
        trades
    where
        deal_id=@deal_id
    order by
        trade_id

open cancel_trade  
fetch cancel_trade into @trade_id

while @@sqlstatus = 0
begin

    exec
        r_inserttradeedit @trade_id

    fetch cancel_trade into @trade_id

end
close cancel_trade
deallocate cancel_trade

begin tran
	update
		trades
	set
		quantity = 0
	where
		deal_id = @deal_id

	update
		account_transactions
	set
		a.amount = 0
	from
		account_transactions a,
		account_transaction_trades b,
		trades c
	where
		a.account_transaction_id = b.account_transaction_id
	and
		b.trade_id = c.trade_id
	and
		c.deal_id = @deal_id
commit tran

declare cancel_trade cursor for
	
	select
		trade_id
	from
		trades
	where
		deal_id=@deal_id
	order by
		trade_id

open cancel_trade	
fetch cancel_trade into @trade_id

while @@sqlstatus = 0
begin

	exec
		r_updatetradenotification @trade_id, "Cancelled" 

	fetch cancel_trade into @trade_id

end
close cancel_trade
deallocate cancel_trade



exec
	fxa_intradayfwdpl
		@login

go
