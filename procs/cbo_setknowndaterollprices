
create or replace procedure
	cbo_setknowndaterollprices
		@login varchar(50),
		@trade_date datetime=NULL
as



declare @tico_account_id int
declare @fund_id int
declare @fund varchar(100)
declare @roll_trader_id int
declare @roll_trader varchar(50)
declare @roll_trader_login varchar(50)
declare @roll_trader_account_id int

declare @defined_roll_rate_id int
declare @contract_id int
declare @value_date datetime
declare @closing_date datetime
declare @closing_quantity numeric(30,4)
declare @net_closing_long numeric(30,4)
declare @closing_long_pbs int
declare @closing_rate_long float
declare @net_closing_short numeric(30,4)
declare @closing_short_pbs int
declare @closing_rate_short float
declare @roll_date datetime
declare @roll_rate_long float
declare @roll_rate_short float
declare @begin_date datetime
declare @end_date datetime


declare @id int
declare @ids int

declare @debug char(1)

select
	@debug = "N"


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Could not resolve login"
	return
end

select
	@fund = name
from
	funds
where
	fund_id = @fund_id

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output
create table
	#spot_value_dates(
		contract_id int,
		product_id int NULL,
		currency_id int NULL,
		symbol varchar(50) NULL,
		trade_date datetime,
		closing_date datetime,
		spot_date datetime,
		includes_holiday varchar(1))
insert into
	#spot_value_dates(
		contract_id,
		trade_date,
		closing_date,
		spot_date,
		includes_holiday)
select
	contract_id,
	trade_date,
	closing_date,
	spot_date,
	includes_holiday
from
	spot_value_dates
where
	convert(date, trade_date) = convert(date, @trade_date)

create table
	#inverted_contracts(
		contract_id int,
		product_id int, 
		currency_id int,
		inverted_contract_id int NULL)
insert into
	#inverted_contracts(
		contract_id,
		product_id,
		currency_id)
select
	a.contract_id,
	b.product_id,
	b.currency_id
from
	#spot_value_dates a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#inverted_contracts
set
	a.inverted_contract_id = b.contract_id
from
	#inverted_contracts a,
	forwards b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id

delete

from
	#inverted_contracts
where
	inverted_contract_id = NULL

insert into
	#spot_value_dates(
		contract_id,
		trade_date,
		closing_date,
		spot_date,
		includes_holiday)
select
	a.inverted_contract_id,
	b.trade_date,
	b.closing_date,
	b.spot_date,
	b.includes_holiday
from
	#inverted_contracts a,
	#spot_value_dates b
where
	a.contract_id = b.contract_id

update
	#spot_value_dates
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#spot_value_dates a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#spot_value_dates
set
	a.symbol = b.symbol
from
	#spot_value_dates a,
	contracts b
where
	a.contract_id = b.contract_id

create unique index
	u_svd
on
	#spot_value_dates(
		contract_id)
create unique index
	n_svd
on
	#spot_value_dates(
		contract_id,
		closing_date)


create table
	#market_rolls(
		style varchar(250) NULL,
		deal_id int,
		trade_date datetime NULL,
		external_account_id int,
		account_type varchar(50) NULL,
		closing_trade_id int,
		closing_quantity numeric(30,4),
		contract_id int,
		closing_rate float,
		closing_date datetime,
		roll_trade_id int NULL,
		roll_quantity numeric(30,4) NULL,
		roll_rate float NULL,
		roll_date datetime NULL,
		bo_trade_date datetime NULL)

insert into
	#market_rolls(
		deal_id,
		trade_date,
		external_account_id,
		account_type,
		closing_trade_id,
		contract_id,
		closing_quantity,
		closing_rate,
		closing_date)
select
	a.deal_id,
	a.trade_date,
	a.external_account_id,
	c.name,
	a.trade_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.value_date
from
	trades a,
	external_accounts b,
	external_account_types c,
	trade_types d,
	#spot_value_dates e
where
	a.contract_id = e.contract_id
and
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	a.trade_type_id = d.trade_type_id
and
	c.name = "Counterparty"
and
	d.name = "Swap Near"
and
	a.value_date = e.closing_date
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date


update
	#market_rolls
set
	bo_trade_date = case
		when a.trade_date >= convert(char(8), a.trade_date, 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 112))
		else
			convert(char(12), a.trade_date, 112)
	end
from
	#market_rolls a

/* Set the trade date of the rolls to the bo_trade_date */
update
	#market_rolls
set
	trade_date = bo_trade_date


if @debug="Y"
begin
	select
		debug="#market_rolls_post_botradedate",
		deal_id,
		contract_id,
		trade_date,
		bo_trade_date,
		roll_date,
		closing_date
	from
		#market_rolls
	order by
		contract_id,
		trade_date
end



create table
	#roll_legs(
		deal_id int,
		trade_id int)
insert into
	#roll_legs
select
	a.deal_id,
	a.trade_id
from
	trades a,
	#market_rolls b
where
	a.deal_id = b.deal_id

delete
	#roll_legs
from
	#roll_legs a,
	#market_rolls b
where
	a.trade_id = b.closing_trade_id

update
	#market_rolls
set
	a.roll_trade_id = b.trade_id
from
	#market_rolls a,
	#roll_legs b
where
	a.deal_id = b.deal_id

update
	#market_rolls
set
	a.roll_date = b.value_date,
	a.roll_rate = b.price,
	a.roll_quantity = b.quantity
from
	#market_rolls a,
	trades b
where
	a.roll_trade_id = b.trade_id

create table
	#contracts(
		id int identity,
		contract_id int)
insert into
	#contracts(
		contract_id)
select
	distinct(contract_id)
from
	#market_rolls

if @debug = "Y"
begin
	select debug="#contracts",  * from #contracts
end

select
	@id = 0
select
	@ids = count(*)
from
	#contracts
where
	id > @id


/* Logic below for @does_existt */
declare @does_exist char(1)

while @ids > 0
begin
	select
		@id = min(id)
	from
		#contracts
	where
		id > @id

	select
		@contract_id = NULL,
		@trade_date = NULL,
		@closing_date = NULL,
		@closing_quantity = NULL,
		@closing_rate_long = NULL,
		@closing_rate_short = NULL,
		@roll_date = NULL,
		@roll_rate_long = NULL,
		@roll_rate_short = NULL,
		@net_closing_long = NULL,
		@closing_long_pbs = NULL

	select
		@contract_id = contract_id
	from
		#contracts
	where
		id = @id

	select
		@trade_date = trade_date,
		@closing_date = closing_date,
		@roll_date = roll_date
	from
		#market_rolls
	where
		contract_id = @contract_id


	select
		@net_closing_long = sum(closing_quantity),
		@closing_long_pbs = count(contract_id),
		@closing_rate_long = sum(closing_quantity * closing_rate) / sum(closing_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(closing_quantity) > 0.0

	select
		@roll_rate_short = sum(roll_quantity * roll_rate) / sum(roll_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(roll_quantity) < 0.0

	select
		@net_closing_short = sum(closing_quantity),
		@closing_short_pbs = count(contract_id),
		@closing_rate_short = sum(closing_quantity * closing_rate) / sum(closing_quantity),
		@roll_rate_long = sum(closing_quantity * roll_rate) / sum(roll_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(closing_quantity) < 0.0

	select
		@roll_rate_long = sum(roll_quantity * roll_rate) / sum(roll_quantity)
	from
		#market_rolls
	where
		contract_id = @contract_id
	and
		sign(roll_quantity) > 0.0
	

	if @debug = "Y"
	begin
		select
			debug="#loop",
			contract_id = @contract_id,
			trade_date = @trade_date,
                	tico_account_id = @tico_account_id,
                	closing_date = @closing_date,
                	net_long = @net_closing_long,
                	long_pbs = @closing_long_pbs,
                	closing_rate_long = @closing_rate_long,
                	net_short = @net_closing_short,
                	short_pbs = @closing_short_pbs,
                	closing_rate_short = @closing_rate_short,
                	roll_date = @roll_date,
                	roll_rate_long = @roll_rate_long,
                	roll_rate_short = @roll_rate_short
		
		select
			debug="#defined_roll_rates data",
			a.*
		from
			defined_roll_rates a
		where
                	a.contract_id = @contract_id
        	and
                	convert(date, a.trade_date) = convert(date, @trade_date)
	end
			
	update
		defined_roll_rates
	set
		tico_account_id = @tico_account_id,
		closing_date = @closing_date,
		net_long = @net_closing_long,
		long_pbs = @closing_long_pbs,
		closing_rate_long = @closing_rate_long,
		net_short = @net_closing_short,
		short_pbs = @closing_short_pbs,
		closing_rate_short = @closing_rate_short,
		roll_date = @roll_date,
		roll_rate_long = @roll_rate_long,
		roll_rate_short = @roll_rate_short,
		timestamp = getdate()
	where
		contract_id = @contract_id
	and
		convert(date, trade_date) = convert(date, @trade_date)
	if @@rowcount = 0
	begin
		/* chriso: we are violating the contract_id, closing_date index here. 
			so check if there are already rated for that contract_id and trade date, 
			and if so, dont try and insert */
		select @does_exist = NULL

		select 
			@does_exist = "Y"
		from 
			defined_roll_rates 
		where 
			contract_id = @contract_id 
		and 
			convert(date, trade_date) = convert(date, @trade_date)
		if @does_exist != "Y"
		begin

			if @debug = "Y"
			begin
				select debug="#offender",
                                	@defined_roll_rate_id,
                                	@tico_account_id,
                                	@contract_id,
                                	@trade_date,
                                	@closing_date,
                                	@net_closing_long,
                                	@closing_long_pbs,
                                	@closing_rate_long,
                                	@net_closing_short,
                                	@closing_short_pbs,
                                	@closing_rate_short,
                                	@roll_date,
                                	@roll_rate_long,
                                	@roll_rate_short
			end


			exec
				j_nextkey
					"defined_roll_rates",
					@defined_roll_rate_id output
	
			insert into
				defined_roll_rates(
					defined_roll_rate_id,
					tico_account_id,
					contract_id,
					trade_date,
					closing_date,
					net_long,
					long_pbs,
					closing_rate_long,
					net_short,
					short_pbs,
					closing_rate_short,
					roll_date,
					roll_rate_long,
					roll_rate_short,
					timestamp)
			values(
				@defined_roll_rate_id,
				@tico_account_id,
				@contract_id,
				@trade_date,
				@closing_date,
				@net_closing_long,
				@closing_long_pbs,
				@closing_rate_long,
				@net_closing_short,
				@closing_short_pbs,
				@closing_rate_short,
				@roll_date,
				@roll_rate_long,
				@roll_rate_short,
				getdate())
		end
	end	
	

	select
		@ids = count(*)
	from
		#contracts
	where
		id > @id
end



go 

