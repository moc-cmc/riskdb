
create or replace procedure
	api_runremotesourcerecon
		@login varchar(50),
		@source varchar(50),
		@trade_date datetime=NULL
as


declare @tico_account_id int
declare @source_id int
declare @begin_date datetime
declare @end_date datetime
declare @prev_bo_trade_date datetime
declare @processing_status_id int
declare @bo_trade_date datetime
declare @trade_count int
declare @matched_count int
declare @unmatched_count int
declare @mismatched_count int
declare @inv_mismatched_count int
declare @date_mismatched_count int
declare @new_count int
declare @remote_count int
declare @debug char(1)
declare @algo_recon_method_id int
declare @algo_inv_recon_method_id int
declare @date_recon_method_id int
declare @match_inverted char(1)
declare @conventional_dates char(1)

select
	@debug = "N",
	@inv_mismatched_count = 0

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source",
		source = @source
	return
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output

select
	@bo_trade_date = convert(date, @end_date)

exec
	r_prevbusinessday
		@bo_trade_date,
		@prev_bo_trade_date output

select
	@processing_status_id = status_id
from
	statuses
where
	name = "Processing"
if @processing_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining 'Processing' status"
	return
end

select
	@algo_recon_method_id = recon_method_id
from
	recon_methods
where
	name = "Algo"
if @algo_recon_method_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining 'Auto' recon method"
	return
end

select
        @algo_inv_recon_method_id = recon_method_id
from
        recon_methods
where
        name = "Algo Invert"
if @algo_inv_recon_method_id = NULL
begin
        select
                status = "Error",
                message = "Problem determining 'Algo Invert' recon method"
        return
end

select
        @date_recon_method_id = recon_method_id
from
        recon_methods
where
        name = "Algo Prev Date"
if @date_recon_method_id = NULL
begin
        select
                status = "Error",
                message = "Problem determining 'Algo Prev Date' recon method"
        return
end


select
	@conventional_dates = conventional_dates,
	@match_inverted = match_inverted_trades
from
	recon_source_settings
where
	source_id = @source_id

create table
	#statuses(
		status_id int,
		name varchar(50),
		match_candidate char(1)
)

insert into
	#statuses
select
	a.status_id,
	a.name,
	b.match_candidate
from
	statuses a,
	remote_recon_statuses b
where
	a.status_id = b.status_id


create table
	#remote_trades(
        	remote_trade_symbol_id int,
		source_id int,
		trade_id int NULL,
		recon_status_id int,	
        	internal_account_id int,
        	external_account_id int,
        	counterparty_id int,
        	quantity numeric(30,8),
        	price float,
        	contract_id int,
        	trade_date datetime,
        	value_date datetime,
        	fixing_date datetime null,
        	identifier varchar(100),
		multi_match_id int NULL,
		recon_method_id int NULL,
		product_id int NULL,
		currency_id int NULL,
		counter_quantity numeric(30, 8) NULL,
		prev_date char(1),
		bo_trade_date datetime
)

insert into
	#remote_trades(
		remote_trade_symbol_id,
		source_id,
		trade_id,
		recon_status_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		quantity,
		price,
		contract_id,
		trade_date,
		value_date,
		fixing_date,
		identifier,
		recon_method_id,
		product_id,
		currency_id,
		counter_quantity,
		prev_date,
		bo_trade_date)
select
	a.remote_trade_symbol_id,
	a.source_id,
	a.trade_id,
	a.recon_status_id,
	a.internal_account_id,
	a.external_account_id,
	a.counterparty_id,
	a.quantity,
	a.price,
	a.contract_id,
	a.trade_date,
	a.value_date,
	a.fixing_date,
	a.identifier,
	a.recon_method_id,
	d.product_id,
	d.currency_id,
	convert(numeric(30, 8), (a.quantity * convert(numeric(30, 10), a.price) * -1)),
	"N",
	a.bo_trade_date
from
	remote_trade_symbols a,
	#statuses b,
	contracts c,
	forwards d
where
	a.recon_status_id = b.status_id
and
	a.contract_id = c.contract_id
and
	c.contract_id = d.contract_id
and
	b.match_candidate = "Y"
and
	a.source_id = @source_id
and
	a.bo_trade_date = @bo_trade_date
select
	@remote_count = @@rowcount

if @conventional_dates = "N"
begin
	insert into
        	#remote_trades(
                	remote_trade_symbol_id,
                	source_id,
                	trade_id,
                	recon_status_id,
                	internal_account_id,
                	external_account_id,
                	counterparty_id,
                	quantity,
                	price,
                	contract_id,
                	trade_date,
                	value_date,
                	fixing_date,
                	identifier,
                	recon_method_id,
                	product_id,
                	currency_id,
                	counter_quantity,
                	prev_date,
			bo_trade_date)
	select
        	a.remote_trade_symbol_id,
        	a.source_id,
        	a.trade_id,
        	a.recon_status_id,
        	a.internal_account_id,
        	a.external_account_id,
        	a.counterparty_id,
        	a.quantity,
        	a.price,
        	a.contract_id,
        	a.trade_date,
        	a.value_date,
        	a.fixing_date,
        	a.identifier,
        	a.recon_method_id,
        	d.product_id,
        	d.currency_id,
                convert(numeric(30, 8), (a.quantity * convert(numeric(30, 10), a.price) * -1)),
        	"Y",
		a.bo_trade_date
	from
        	remote_trade_symbols a,
        	#statuses b,
        	contracts c,
        	forwards d
	where
        	a.recon_status_id = b.status_id
	and
        	a.contract_id = c.contract_id
	and
        	c.contract_id = d.contract_id
	and
        	b.name = "Unmatched"
	and
        	a.source_id = @source_id
	and
        	a.bo_trade_date = @prev_bo_trade_date
	and
		a.trade_id = NULL
end

update
	#remote_trades
set
	counter_quantity = convert(numeric(30, 8), (a.quantity * convert(numeric(30, 10), (1/a.price)) * -1))
	/* 2024-03-04 - counter_quantity = convert(numeric(30, 2), a.quantity * convert(numeric(30, 10), (1/convert(numeric(30, 10), a.price))) * -1) */
	/* old - counter_quantity = convert(numeric(30, 2), a.quantity * (1/a.price)) * -1 */
        /* trades does convert(numeric(30, 2), (a.quantity * convert(numeric(30, 10), a.price) * -1)) */
from
	#remote_trades a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

if @debug = "Y"
	/* Adaptive Server has expanded all '*' elements in the following statement */ select debug="#remote_trades", #remote_trades.remote_trade_symbol_id, #remote_trades.source_id, #remote_trades.trade_id, #remote_trades.recon_status_id, #remote_trades.internal_account_id, #remote_trades.external_account_id, #remote_trades.counterparty_id, #remote_trades.quantity, #remote_trades.price, #remote_trades.contract_id, #remote_trades.trade_date, #remote_trades.value_date, #remote_trades.fixing_date, #remote_trades.identifier, #remote_trades.multi_match_id, #remote_trades.recon_method_id, #remote_trades.product_id, #remote_trades.currency_id, #remote_trades.counter_quantity, #remote_trades.prev_date, #remote_trades.bo_trade_date from #remote_trades

select
	@new_count = count(*)
from
	#remote_trades a,
	#statuses b
where
	a.recon_status_id = b.status_id
and
	b.name = "New"

update
	remote_trade_symbols
set
	recon_status_id = @processing_status_id
from
	remote_trade_symbols a,
	#remote_trades b
where
	a.remote_trade_symbol_id = b.remote_trade_symbol_id
and
 	a.source_id = @source_id
and
	a.bo_trade_date = @bo_trade_date


create table
	#trades(
		trade_id int,
		internal_account_id int,
		external_account_id int,
		counterparty_id int,
		quantity numeric(30, 8),
		price float,
		contract_id int,
		value_date datetime,
		trade_date datetime,
		remote_trade_id int NULL,
		multi_match_id int NULL,
		product_id int NULL,
		currency_id int NULL,
		counter_quantity numeric(30, 8) NULL,
		post_eod char(1) NULL,
		identifier varchar(100) NULL
)

insert into
	#trades(
		trade_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		quantity,
		price,
		contract_id,
		value_date,
		trade_date,
		product_id,
		currency_id,
		counter_quantity,
		post_eod,
		identifier)
select
	a.trade_id,
	a.internal_account_id,
	a.external_account_id,
	a.counterparty_id,
	a.quantity,
	a.price,
	a.contract_id,
	a.value_date,
	a.trade_date,
	c.product_id,
	c.currency_id,
	convert(numeric(30, 8), (a.quantity * convert(numeric(30, 10), a.price) * -1)),
	post_eod = "N",
	a.identifier
from
	trades a,
	contracts b,
	forwards c
where
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.value_date >= @bo_trade_date
and
	a.fixing_date = NULL
and
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
select
	@trade_count = @@rowcount

update
        #trades
set
        b.remote_trade_id = a.remote_trade_symbol_id
from
        remote_trade_symbols a,
        #trades b,
	#statuses c
where
        a.trade_id = b.trade_id
and
        a.source_id = @source_id
and
	a.bo_trade_date = @bo_trade_date
and
	c.name = "Matched"

if @conventional_dates = "N"
begin
	update
		#trades
	set
		post_eod = "Y"
	from
		#trades
	where
		trade_date >= convert(char(8), trade_date, 112) +' 17:00'
	and
		remote_trade_id = NULL
end

update
	#trades
set
	b.remote_trade_id = a.remote_trade_symbol_id
from
	#remote_trades a,
	#trades b
where
	a.trade_id = b.trade_id

if @debug = "Y"
	/* Adaptive Server has expanded all '*' elements in the following statement */ select
		debug="#trades", #trades.trade_id, #trades.internal_account_id, #trades.external_account_id, #trades.counterparty_id, #trades.quantity, #trades.price, #trades.contract_id, #trades.value_date, #trades.trade_date, #trades.remote_trade_id, #trades.multi_match_id, #trades.product_id, #trades.currency_id, #trades.counter_quantity, #trades.post_eod, #trades.identifier from #trades

update
	#remote_trades
set
	recon_status_id = b.status_id,
	trade_id = c.trade_id,
	recon_method_id = @algo_recon_method_id
from
	#remote_trades a,
	#statuses b,
	#trades c
where
	b.name = "Matched"
and
	a.internal_account_id = c.internal_account_id
and
	a.external_account_id = c.external_account_id
and
	a.counterparty_id = c.counterparty_id
and
	a.contract_id = c.contract_id
and
	a.quantity = c.quantity
and
        a.price = c.price
and
	a.value_date = c.value_date
and
	a.trade_id = NULL
and
	c.remote_trade_id = NULL
and
	a.prev_date = "N"
select
	@matched_count = @@rowcount

update
	#trades
set
	b.remote_trade_id = a.remote_trade_symbol_id
from
	#remote_trades a,
	#trades b
where
	a.trade_id = b.trade_id
and
	b.remote_trade_id = NULL


update
        #remote_trades
set
        recon_status_id = b.status_id,
        trade_id = c.trade_id,
        recon_method_id = @algo_recon_method_id
from
        #remote_trades a,
        #statuses b,
        #trades c
where
        b.name = "Matched"
and
        a.internal_account_id = c.internal_account_id
and
        a.external_account_id = c.external_account_id
and
        a.counterparty_id = c.counterparty_id
and
        a.contract_id = c.contract_id
and
        a.quantity = c.quantity
and
        a.counter_quantity = c.counter_quantity /* counters vs price */
and
        a.value_date = c.value_date
and
        a.trade_id = NULL
and
        c.remote_trade_id = NULL
and
        a.prev_date = "N"
select
        @matched_count = @@rowcount

update
        #trades
set
        b.remote_trade_id = a.remote_trade_symbol_id
from
        #remote_trades a,
        #trades b
where
        a.trade_id = b.trade_id
and
        b.remote_trade_id = NULL


/* identifier + relaxed counters */
update
        #remote_trades
set
        recon_status_id = b.status_id,
        trade_id = c.trade_id,
        recon_method_id = @algo_recon_method_id
from
        #remote_trades a,
        #statuses b,
        #trades c
where
        b.name = "Matched"
and
        a.internal_account_id = c.internal_account_id
and
        a.external_account_id = c.external_account_id
and
        a.counterparty_id = c.counterparty_id
and
        a.contract_id = c.contract_id
and
        a.quantity = c.quantity
and
        convert(int, a.counter_quantity) = convert(int, c.counter_quantity) /* relaxed counters vs price  + identifiers*/
and
	a.identifier = c.identifier
and
        a.value_date = c.value_date
and
        a.trade_id = NULL
and
        c.remote_trade_id = NULL
and
        a.prev_date = "N"
select
        @matched_count = @@rowcount

/* identifier + relaxed price */
update
        #remote_trades
set
        recon_status_id = b.status_id,
        trade_id = c.trade_id,
        recon_method_id = @algo_recon_method_id
from
        #remote_trades a,
        #statuses b,
        #trades c
where
        b.name = "Matched"
and
        a.internal_account_id = c.internal_account_id
and
        a.external_account_id = c.external_account_id
and
        a.counterparty_id = c.counterparty_id
and
        a.contract_id = c.contract_id
and
        a.quantity = c.quantity
and
        convert(numeric(30, 8), c.price) = convert(numeric(30, 8), 1/a.price) /* relaxed inv price  + identifiers*/
and
        a.identifier = c.identifier
and
        a.value_date = c.value_date
and
        a.trade_id = NULL
and
        c.remote_trade_id = NULL
and
        a.prev_date = "N"
select
        @matched_count = @@rowcount


update
        #trades
set
        b.remote_trade_id = a.remote_trade_symbol_id
from
        #remote_trades a,
        #trades b
where
        a.trade_id = b.trade_id
and
        b.remote_trade_id = NULL
	

update
	#remote_trades
set
	recon_status_id = b.status_id,
	trade_id = c.trade_id,
	recon_method_id = @algo_recon_method_id
from
	#remote_trades a,
	#statuses b,
	#trades c
where
	b.name = "Mismatched"
and
	a.trade_id = NULL
and
	a.internal_account_id = c.internal_account_id
and
	a.external_account_id = c.external_account_id
and
	a.counterparty_id = c.counterparty_id
and
	a.contract_id = c.contract_id
and
	a.quantity = c.quantity
and
	a.price = c.price
and
	c.remote_trade_id = NULL
and
	a.prev_date = "N"
select
	@mismatched_count = @@rowcount

update
	#trades
set
	b.remote_trade_id = a.remote_trade_symbol_id
from
	#remote_trades a,
	#trades b
where
	a.trade_id = b.trade_id
and
	b.remote_trade_id = NULL
	

update
        #remote_trades
set
        recon_status_id = b.status_id,
        trade_id = c.trade_id,
	recon_method_id = @algo_recon_method_id
from
        #remote_trades a,
        #statuses b,
        #trades c
where
        b.name = "Mismatched"
and
        a.trade_id = NULL
and
        a.internal_account_id = c.internal_account_id
and
        a.external_account_id = c.external_account_id
and
        a.counterparty_id = c.counterparty_id
and
        a.contract_id = c.contract_id
and
	sign(a.quantity) = sign(c.quantity)
and
        floor(abs(a.quantity)) = floor(abs(c.quantity))
and
        convert(numeric(30, 10), a.price) = convert(numeric(30, 10), c.price)
and
	a.value_date = c.value_date
and
	c.remote_trade_id = NULL
and
	a.prev_date = "N"
select
        @mismatched_count = @mismatched_count + @@rowcount

update
	#trades
set
	b.remote_trade_id = a.remote_trade_symbol_id
from
	#remote_trades a,
	#trades b
where
	a.trade_id = b.trade_id
and
	b.remote_trade_id = NULL

if @match_inverted = "Y"
begin
	update
        	#remote_trades
	set
        	recon_status_id = b.status_id,
        	trade_id = c.trade_id,
        	recon_method_id = @algo_inv_recon_method_id
	from
        	#remote_trades a,
        	#statuses b,
        	#trades c
	where
        	b.name = "Mismatched"
	and
        	a.trade_id = NULL
	and
        	c.remote_trade_id = NULL
	and
        	a.internal_account_id = c.internal_account_id
	and
        	a.external_account_id = c.external_account_id
	and
        	a.counterparty_id = c.counterparty_id
	and
		a.product_id = c.currency_id
	and
		a.currency_id = c.product_id
	and
        	sign(a.quantity) = sign(c.counter_quantity)
	and
	(	
		round(abs(a.quantity), 0) = round(abs(c.counter_quantity), 0)
	or
		floor(abs(a.quantity)) = floor(abs(c.counter_quantity))
	)
	and
        	a.value_date = c.value_date
	and
		a.prev_date = "N"
	select
        	@inv_mismatched_count = @inv_mismatched_count + @@rowcount

	update
        	#trades
	set
        	b.remote_trade_id = a.remote_trade_symbol_id
	from
        	#remote_trades a,
        	#trades b
	where
        	a.trade_id = b.trade_id
	and
        	b.remote_trade_id = NULL

	update
        	#remote_trades
	set
        	recon_status_id = b.status_id,
        	trade_id = c.trade_id,
        	recon_method_id = @algo_inv_recon_method_id
	from
        	#remote_trades a,
        	#statuses b,
        	#trades c
	where
        	b.name = "Mismatched"
	and
        	a.trade_id = NULL
	and
        	c.remote_trade_id = NULL
	and
        	a.internal_account_id = c.internal_account_id
	and
        	a.external_account_id = c.external_account_id
	and
        	a.counterparty_id = c.counterparty_id
	and
        	a.product_id = c.currency_id
	and
        	a.currency_id = c.product_id
	and
        	sign(a.quantity) = sign(c.counter_quantity)
	and
	(      
        	round(abs(c.quantity), 0) = round(abs(a.counter_quantity), 0)
	or
        	floor(abs(c.quantity)) = floor(abs(a.counter_quantity))
	)
	and
        	a.value_date = c.value_date
	and
		a.prev_date = "N"
	select
        	@inv_mismatched_count = @inv_mismatched_count + @@rowcount
	
	update
        	#trades
	set
        	b.remote_trade_id = a.remote_trade_symbol_id
	from
        	#remote_trades a,
        	#trades b
	where
        	a.trade_id = b.trade_id
	and
        	b.remote_trade_id = NULL

end

create table
	#ndf_trades(
		trade_id int,
		internal_account_id int,
		external_account_id int,
		counterparty_id int,
		quantity numeric(30, 8),
		price float,
		contract_id int,
		value_date datetime,
		fixing_date datetime NULL,
		remote_trade_id int NULL,
		multi_match_id int NULL,
                product_id int NULL,
                currency_id int NULL,
                counter_quantity numeric(30, 8) NULL
)

insert into
	#ndf_trades(
		trade_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		quantity,
		price,
		contract_id,
		value_date,
		fixing_date,
		product_id,
		currency_id,
		counter_quantity)
select
	a.trade_id,
	a.internal_account_id,
	a.external_account_id,
	a.counterparty_id,
	a.quantity,
	a.price,
	a.contract_id,
	a.value_date,
	a.fixing_date,
        c.product_id,
        c.currency_id,
        convert(numeric(30, 8), (a.quantity * convert(numeric(30, 10), a.price) * -1))
from
	trades a,
	contracts b,
	forwards c
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.value_date >= @bo_trade_date
and
	a.fixing_date != NULL
select
	@trade_count = @trade_count + @@rowcount
	

