	/* Adaptive Server has expanded all '*' elements in the following statement */ select #remote_trades.remote_trade_symbol_id, #remote_trades.source_id, #remote_trades.trade_id, #remote_trades.recon_status_id, #remote_trades.internal_account_id, #remote_trades.external_account_id, #remote_trades.counterparty_id, #remote_trades.quantity, #remote_trades.price, #remote_trades.contract_id, #remote_trades.trade_date, #remote_trades.value_date, #remote_trades.fixing_date, #remote_trades.identifier, #remote_trades.multi_match_id, #remote_trades.recon_method_id, #remote_trades.product_id, #remote_trades.currency_id, #remote_trades.counter_quantity, #remote_trades.prev_date, #remote_trades.bo_trade_date from #remote_trades
end
	
