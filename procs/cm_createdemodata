
if object_id("cm_createdemodata") != NULL
    drop procedure
        cm_createdemodata
go

create procedure
	cm_createdemodata
		@login varchar(30),
		@fund_name varchar(50),
		@assets_under_management numeric(30,2),
		@evaluation_currency char(30)
as

declare @tico_account_id int
declare @fund_id int
declare @internal_account_id int
declare @run_id int
declare @portfolio_id int
declare @int_account_transaction_id int
declare @deposit_transaction_type_id int
declare @month char(2)
declare @year char(4)
declare @datestring varchar(30)
declare @transaction_date datetime
declare @evaluation_currency_id int
declare @currency_product_type_id int
declare @source_id int

select
	@source_id = source_id
from
	sources
where
	name = "MPT"
if @source_id = NULL
begin
	exec
		j_nextkey
			"sources",
			@source_id output

	insert into
		sources
	values(
		@source_id,
		"MPT")
end

select
	@month = convert(char(2), datepart(month, getdate())),
	@year = convert(char(4), datepart(year, getdate()))

select
	@datestring = @month + "/1/" + @year
select
	@transaction_date = convert(datetime, @datestring)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Login not found"
	return
end

truncate table
	fund_tico_accounts

insert into
	fund_tico_accounts
select
	fund_id,
	account_id,
	priority = 1
from
	funds a,
	tico_accounts b


select
	@evaluation_currency_id = product_id
from
	products
where
	symbol = @evaluation_currency
if @@rowcount != 1
begin
	select
		@currency_product_type_id = product_type_id
	from
		product_types
	where
		name = "Currency"
	if @@rowcount != 1
	begin
		exec
			j_nextkey
				"product_types",
				@currency_product_type_id output
		insert into
			product_types
		values(
			@currency_product_type_id,
			"Currency")
	end


	exec
		j_nextkey
			"products",
			@evaluation_currency_id output

	insert into
		products
	values(
		@evaluation_currency_id,
		@currency_product_type_id,
		@evaluation_currency,
		@evaluation_currency)

end

update
	funds
set
	name = @fund_name,
	evaluation_currency_id = @evaluation_currency_id
if @@rowcount = 0
begin
	exec
		j_nextkey
			"funds",
			@fund_id output

	insert into 
		funds(
			fund_id,
		 	name,
		 	evaluation_currency_id)
	values(
		@fund_id,
		@fund_name,
		@evaluation_currency_id)
end
		
select
	@fund_id = fund_id
from
	funds
where
	name = @fund_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Funds are not set up properly for demo environment"
	return
end


exec
	j_nextkey
		"internal_accounts",
		@internal_account_id output

insert into
	internal_accounts
values(
	@internal_account_id,
	@fund_name,
	@fund_name,
	0)

insert into
	fund_internal_accounts
values(
	@fund_id,
	@internal_account_id)

insert into
	internal_account_views
values(
	@internal_account_id)


exec
	j_nextkey
		"runs",
		@run_id output

insert into
	runs
values(
	@run_id,
	@fund_name)

insert into
	run_internal_accounts
values(
	@run_id,
	@internal_account_id)

insert into
	user_runs
select
	account_id,
	run_id = @run_id
from
	tico_accounts

exec
	j_nextkey
		"portfolios",
		@portfolio_id output

insert into
	portfolios
values(
	@portfolio_id,
	@fund_name)

insert into
	portfolio_accounts
values(
	@portfolio_id,
	@internal_account_id)


exec
	j_nextkey
		int_account_transactions,
		@int_account_transaction_id output

select
	@deposit_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Deposit"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Deposit transaction type not found"
	return
end

insert into
	int_account_transactions
values(
	@int_account_transaction_id,
	@tico_account_id,
	@internal_account_id,
	@deposit_transaction_type_id,
	@transaction_date,
	@assets_under_management,
	"Initial Deposit")


update
	fund_run_defaults
set
	evaluation_currency_id = @evaluation_currency_id,
	source_id = @source_id
where
	fund_id = @fund_id
if @@rowcount = 0
	insert into
		fund_run_defaults
	values(
		@fund_id,
		@evaluation_currency_id,
		@source_id)
	

go
