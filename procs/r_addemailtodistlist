drop procedure
	r_addemailtodistlist
go

create procedure
	r_addemailtodistlist
		@login varchar(50),
		@dist_list varchar(50),
		@email varchar(50)

as

declare @tico_account_id int
declare @email_id int
declare @dist_list_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = -1,
		error = "Problem deterimining login"
	return
end

select
	@email_id = email_id
from
	emails
where
	email = @email
if @@rowcount != 1
begin
	exec
		r_addemail
			@login,
			@email
	select
        	@email_id = email_id
	from
        	emails
	where
        	email = @email
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem finding email after autocreation"
		return
	end
end

select
        @dist_list_id = dist_list_id
from
        dist_lists
where
        name = @dist_list
if @@rowcount != 1
begin
        select
                id = -1,
                msg = "Problem finding dist_list",
                dist_list = @dist_list
        return
end

if exists(select email_id from dist_list_emails where dist_list_id = @dist_list_id and email_id = @email_id)
begin
	select
		id = -1,
		msg = "Email address already exists for distribution list"
	return
end	
	
insert into 
	dist_list_emails
(
	dist_list_id,
	email_id
)
values(
	@dist_list_id,
	@email_id
)
if @@rowcount != 1
begin
        select
                id = -1,
                msg = "Problem adding email to distribution list",
                dist_list = @dist_list
        return
end

select
        id = 1,
        msg = "Successfully added email to distribution list",
        email = @email,
	dist_list = @dist_list

exec 
	r_distlistdetails
		@login,
		@dist_list
go

