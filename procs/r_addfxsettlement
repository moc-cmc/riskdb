drop procedure
	r_addfxsettlement
go

create procedure
	r_addfxsettlement
		@login varchar(50),
		@account varchar(50),
		@currency varchar(50),
		@balance numeric(30,2),
		@value_date datetime
as


declare @fund_id int
declare @external_account_id int
declare @tico_account_id int
declare @transaction_type_id int
declare @currency_id int
declare @prime_broker varchar(50)
declare @account_transaction_id int

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
	#meta
values(
	"Column Link",
	"cash_settle_recon",
	"Cash Settle Recon",
	NULL) 

insert into
        #meta
values(
        "Column Hidden",
        "value_date",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "prime_broker",
        NULL,
        NULL)

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "FX Settlement type not found"
	return
end

select
	@currency_id = product_id
from
	products
where
	symbol = @currency
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Currency not found",
		currency = @currency
	return
end

create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50))
insert into
	#external_accounts
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.fund_id = @fund_id

select
	@external_account_id = external_account_id
from
	#external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

select
	@prime_broker = a.name
from
	sources a,
	prime_brokers b,
	external_account_prime_brokers c
where
	a.source_id = b.source_id
and
	b.prime_broker_id = c.prime_broker_id
and
	c.external_account_id = @external_account_id

exec
	j_nextkey
		"account_transactions",
		@account_transaction_id output

insert into
	account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount)
values(
	@account_transaction_id,
	@tico_account_id,
	@external_account_id,
	@transaction_type_id,
	@value_date,
	@currency_id,
	@balance)




select
	style = "background:#FFFFFF;border: 1px solid white",
	prime_broker = @prime_broker,
	value_date = @value_date
	

exec
	cbo_settlementrecon
		@login,
		@value_date,
		@prime_broker

go
