drop procedure
	r_showdisclaimer
go

create procedure
	r_showdisclaimer
		@report_name varchar(100)

as


declare @image_path varchar(200)


select
	@image_path = path
from
	image_paths
where
	name = @report_name

select
	style = "background:#FFFFFF;border: 1px solid white",
	disclaimer = disclaimer,
	_ = '<img id="report-logo" src="'+rtrim(@image_path)+'">'
from
	report_disclaimers
where
	name = @report_name

go
