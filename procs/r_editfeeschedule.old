drop procedure
	r_editfeeschedule
go

create procedure
	r_editfeeschedule
		@login varchar(50),
		@fsid int,
                @name varchar(50),
                @description varchar(200),
		@fee_schedule_type varchar(50),
		@trade_type varchar(50)=NULL,
		@internal_account varchar(50)=NULL,
		@external_account varchar(50)=NULL,
		@book_to_account varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@symbol varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@strategy varchar(50)=NULL,
		@status varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@sales_code varchar(50)=NULL,
		@product varchar(50),
		@fee_price float,
                @min_ticket_size float,
                @direction int,
		@created_by varchar(50),
		@created_at datetime


as
declare @fee_schedule_id int
declare @trade_type_id int  
declare @internal_account_id int 
declare @external_account_id int 
declare @book_to_ext_account_id int
declare @counterparty_id int 
declare @contract_id int 
declare @trader_id int 
declare @strategy_id int 
declare @status_id int 
declare @broker_id int 
declare @sales_code_id int 
declare @fee_product_id int
declare @product_id int
declare @fee_schedule_type_id int
declare @archived_by int
declare @archived_at datetime
declare @new_created_by int
declare @new_created_at datetime
declare @created_by_id int

select
	@fee_schedule_id = @fsid

select
	@created_by_id = account_id
from
	tico_accounts
where
	login = @created_by

select
        @archived_by = account_id
from
        tico_accounts
where
        login = @login

select
        @archived_at = getdate()

select
        @new_created_by = account_id
from
        tico_accounts
where
        login = @login

select
        @new_created_at = getdate()

insert into
        archive_fee_schedules
select
        fee_schedule_id,
        name,
        description,
        fee_schedule_type_id,
        trade_type_id,
        internal_account_id,
        external_account_id,
        counterparty_id,
        contract_id,
        trader_id,
        strategy_id,
        status_id,
        broker_id,
        sales_code_id,
        fee_product_id,
        fee_price,
        min_ticket_size,
        direction,
        created_at,
        created_by,
        @archived_at,
        @archived_by,
	book_to_ext_account_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id

select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = @trade_type
if @@rowcount != 1
begin
        select
                @trade_type_id = NULL
end


select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @internal_account
if @@rowcount != 1
begin
        select
                @internal_account_id = NULL
end


select
        @external_account_id = external_account_id
from
        external_accounts
where
        symbol = @external_account
if @@rowcount != 1
begin
        select
                @external_account_id = NULL
end

select
        @book_to_ext_account_id = external_account_id
from
        external_accounts
where
        symbol = @book_to_account
if @@rowcount != 1
begin
        select
                @book_to_ext_account_id = NULL
end


select
	@counterparty_id = counterparty_id 
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
        select
                @counterparty_id = NULL
end


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
        select
                @contract_id = NULL
end


select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
        select
                @trader_id = NULL
end


select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin
        select
                @strategy_id = NULL
end


select
	@status_id = status_id
from
	statuses
where
	name = @status
if @@rowcount != 1
begin
        select
                @status_id = NULL
end


select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
        select
                @broker_id = NULL
end


select
	@sales_code_id 
from
	sales_codes
where 
	name = @sales_code
if @@rowcount != 1
begin
        select
                @sales_code_id = NULL
end


select
	@fee_product_id = product_id
from
	products
where
	symbol = @product
if @@rowcount != 1
begin
	select
		@product_id = NULL
end

select
	@fee_schedule_type_id = fee_schedule_type_id
from
	fee_schedule_types
where
	name = @fee_schedule_type

update
	fee_schedules
set
        name = @name,
        description = @description,
	fee_schedule_type_id = @fee_schedule_type_id,
        trade_type_id = @trade_type_id,
        internal_account_id = @internal_account_id,
        external_account_id = @external_account_id,
	book_to_ext_account_id = @book_to_ext_account_id,
        counterparty_id = @counterparty_id,
        contract_id = @contract_id,
        trader_id = @trader_id,
        strategy_id = @strategy_id,
        status_id = @status_id,
        broker_id = @broker_id,
        sales_code_id = @sales_code_id,
        fee_product_id = @fee_product_id,
	fee_price = @fee_price,
        min_ticket_size = @min_ticket_size,
	direction = @direction,
	created_at = @created_at,
	created_by = @created_by_id
where
	fee_schedule_id = @fee_schedule_id

exec
	r_viewfeeschedule
		@login
go
