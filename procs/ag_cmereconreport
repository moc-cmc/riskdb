create or replace procedure
	ag_cmereconreport
		@login varchar(50),
		@begin_date datetime = NULL,
		@end_date datetime = NULL

as

declare @tico_account_id int
declare @source_id int

select
    @tico_account_id = account_id
from
     tico_accounts
where
    login = @login
if @tico_account_id = NULL
begin
    select
           status="Error",
           message="Problem finding account for login"
    return
end

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)
declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @spectrum_source_id int

select
    @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
    @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
    @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
    @style = "background:#FFFFFF;border: 1px solid white",
    @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
    @client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
    #meta(
        meta_type char(200),
        name char(50) NULL,
        action char(100) NULL,
        value char(200) NULL)
insert into
    #meta
values(
    "Row Style",
    "style",
    NULL,
    NULL)

insert into
    #meta
values (
    "Column Group",
    "section",
    NULL,
    NULL)

insert into
	#meta
values(
	"Column Link",
	"id_recon",
	"CME Intraday Recon",
	NULL) 

select
	@source_id = source_id
from
	sources
where
	name = "CME Intraday SFTP" 
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source",
		source = "CME Intraday SFTP" 
	return
end

select
	@spectrum_source_id = source_id
from
	sources
where
	name = "Spectrum In"

if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Could not locate source ",
		source = "Spectrum In"
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2),datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
select
	@end_date = convert(datetime, @end_day_string)


/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

create table
	#trade_responses(
		trade_id int,
		response varchar(250) NULL)

insert into
	#trade_responses
	(trade_id)
select
	a.trade_id
from
        trades a,
        trade_aliases b,
        fund_regulatory_info c,
        external_accounts d,
        external_account_types e
where 
        a.trade_id *= b.trade_id
and
        a.trade_date >= @begin_date
and
        a.trade_date < @end_date
and
        b.source_id = @source_id
and
        a.external_account_id = d.external_account_id
and
        d.external_account_type_id = e.external_account_type_id
and
        e.name="Client"		

update
	#trade_responses
set
	a.response=b.response
from
	#trade_responses a,
	cme_responses b
where
	a.trade_id=b.trade_id
and
	b.source_run = 43

select
	id_recon = "Change Date"

select 
	section = "ID Recon for Range",
	trade_date = a.trade_date, 
	etg_id= a.trade_id,
	spectrum_id=b.alias, 
	cme_id = rtrim(lei_number)+convert(char(10),a.trade_id),
	f.response,
	style=@style
from
	trades a, 
	trade_aliases b, 
	fund_regulatory_info c,
	external_accounts d,
	external_account_types e,
	#trade_responses f,
	trade_types g
where 
	a.trade_id *= b.trade_id 
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	b.source_id = @spectrum_source_id
and
	a.external_account_id = d.external_account_id
and
	d.external_account_type_id = e.external_account_type_id 
and
	e.name="Client"
and
	a.trade_id=f.trade_id
and
	a.trade_type_id=g.trade_type_id
and
	g.name != "Spot"
order by 
	a.trade_date

go


