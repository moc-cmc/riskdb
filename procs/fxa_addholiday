use
	risk_crossfield
go

drop procedure
	fxa_addholiday
go

create procedure
	fxa_addholiday
		@login varchar(50),
		@product varchar(50),
		@holiday varchar(50),
		@trade_date datetime
as

declare @holiday_id int
declare @product_id int
declare @product_holiday_id int

select
	@trade_date = convert(datetime, convert(date, @trade_date))

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@holiday_id = holiday_id
from
	holidays
where
	name = @holiday
if @@rowcount != 1
begin
	exec
		j_nextkey
			"holidays",
			@holiday_id output

	insert into
		holidays(
			holiday_id,
			name)
	values(
		@holiday_id,
		@holiday)
end

select
	@product_holiday_id = product_holiday_id
from
	product_holidays
where
	product_id = @product_id
and
	holiday_id = @holiday_id
and
	convert(char(11), date, 1) = convert(char(11), @trade_date, 1)
if @product_holiday_id != NULL
begin
	select
		status = "Error",
		message = "Holiday already exists for product and date",
		product = @product,
		holiday = @holiday,
		trade_date = @trade_date
	return
end

exec
	j_nextkey
		"product_holidays",
		@product_holiday_id output

insert into
	product_holidays(
		product_holiday_id,
		holiday_id,
		date)
values(
	@product_id,
	@holiday_id,
	@trade_date)

exec
	fxa_holidays
		@login,
		@trade_date


go
