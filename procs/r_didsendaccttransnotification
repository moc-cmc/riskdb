
create or replace procedure
	r_didsendaccttransnotification
		@trade_notification_id int, /* using trade_notification_id but its really the account_trans_notification_id */
		@status varchar(25),
		@error varchar(250)
as


declare @status_id int
declare @sent_status_id int

select
    @sent_status_id = status_id,
    @status_id = status_id
from
    statuses
where
    name = 'Sent'
if @status_id = null
begin
    select
        id = -1,
        err = "No status named, 'Sent'"
    return
end

if @status != null
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name = @status
    if @status_id = null
    begin
        select
            id = -1,
            err = "No status named, '" + @status + "'"
        return
    end
    
    if @status_id != @sent_status_id
        select
            @status_id = @status_id
end

update
    account_trans_notifications
set
    status_id = @status_id,
    notify_date = getdate()
where
    account_trans_notification_id = @trade_notification_id


go 

