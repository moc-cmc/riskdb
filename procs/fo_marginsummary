create table
	#shorts(
		external_account_id int,
		bucket varchar(30), 
		product_id int,
		quantity numeric(30,4),
		bucket_margin float NULL,
		currency_id int NULL,
		conversion_rate float NULL,
		margin_use float NULL,
		equivalent float NULL
		)
insert into
	#shorts(
		external_account_id,
		bucket,
		product_id,
		quantity)
select
	external_account_id,
	bucket,
	short_product_id,
	sum(short_qty)
from
	#trades
where
	short_product_id != @evaluation_currency_id
group by
	external_account_id,
	bucket,
	short_product_id

update
	#shorts
set
	quantity = abs(quantity)

update
	#shorts
set
	bucket_margin = convert(float, bucket),
	currency_id = @evaluation_currency_id


update
	#shorts
set
	conversion_rate = 1.0
where
	product_id = currency_id

update
	#shorts
set
	a.conversion_rate = c.price
from
	#shorts a,
	forwards b,
	prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)


update
	#shorts
set
	a.conversion_rate = 1.0 / c.price
from
	#shorts a,
	forwards b,
	prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.conversion_rate = NULL

update
	#shorts
set
	a.conversion_rate = c.price
from
	#shorts a,
	forwards b,
	current_prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	a.conversion_rate = NULL

update
	#shorts
set
	a.conversion_rate = 1.0 / c.price
from
	#shorts a,
	forwards b,
	current_prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	a.conversion_rate = NULL




update
	#shorts
set
	margin_use = bucket_margin *  quantity


update
	#shorts
set
	equivalent = margin_use * conversion_rate
	

create table
	#summary(
		external_account_id int,
		equivalent float)
insert into
	#summary
select
	external_account_id,
	sum(equivalent)
from
	#shorts
group by
	external_account_id

select
	section = "Client Margin Usage Summary",
	style = "background:#FFFFFF;border: 1px solid white",
	account = a.symbol,
	account_type = c.name,
	margin_use = equivalent
from
	external_accounts a,
	#summary b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	a.external_account_type_id = c.external_account_type_id
and
	a.symbol != "INTERNAL"
order by
	a.symbol


