
if object_id("r_reportcommitfordate") != NULL
    drop procedure
        r_reportcommitfordate
go

create procedure
    r_reportcommitfordate
        @fund char(100),
        @report char(100),
        @date date,
        @report_commit_id int output
as

/* 
 * Returns the @report_commit_id for the @fund, @report and @date, creating it
 * if ncessary
 */

declare @fund_id int
declare @external_report_id int
declare @fund_report_id int
declare @review_status_id int

/* 
 * Find data
 */

select
    @review_status_id = status_id
from
    statuses
where
    name = "Review"
if @@rowcount != 1
begin
    raiserror 999999 "'Review' status not found"
    return
end

/* 
 * Process arguments
 */

select
    @fund_id = fund_id
from
    funds
where
    name = @fund
if @@rowcount != 1
begin
    raiserror 999999 "Fund not found"
    return
end

select
    @external_report_id = external_report_id
from
    external_reports
where
    name = @report
if @@rowcount != 1
begin
    raiserror 999999 "External report not found"
    return
end

if @date = null
    select
        @date = getdate()
select
    @date = convert(datetime, convert(char(10), @date, 101))
exec
    r_prevbusinessday
        @date,
        @date output
exec
    r_nextbusinessday
        @date,
        @date output

select
    @fund_report_id = fund_report_id
from
    fund_reports
where
    fund_id = @fund_id
and
    external_report_id = @external_report_id
if @@rowcount != 1
begin
    raiserror 999999 "The report is not available to the fund"
    return
end

select
    @report_commit_id = report_commit_id
from
    report_commits
where
    fund_report_id = @fund_report_id
and
    trade_date = @date
if @@rowcount = 0
begin
    
    insert into
        report_commits
    values (
        @fund_report_id,
        @date,
        @review_status_id,
        getdate()
    )
    select
        @report_commit_id = @@identity

end

go
