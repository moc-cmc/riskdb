drop procedure tt_primexmtally
go

create procedure
	tt_primexmtally
		@source varchar(50),
        	@default_login varchar(50)=NULL,
		@sender_comp varchar(50)=NULL,
		@sender_sub varchar(50)=NULL,
		@target_comp varchar(50)=NULL,
		@target_sub varchar(50)=NULL,
        	@trade_report_id varchar(50)=NULL,
        	@execution_id varchar(100)=NULL,
		@order_id varchar(50)=NULL,
        	@symbol varchar(50)=NULL,
        	@quantity numeric(30,6)=NULL,
        	@price float=NULL,
        	@currency varchar(5)=NULL,
        	@settle_currency varchar(5)=NULL,
        	@trade_date datetime=NULL,
        	@value_date datetime=NULL,
        	@side varchar(5)=NULL,
        	@account varchar(50)=NULL,
		@contra_firm varchar(50)=NULL
		
as



declare @committed_status_id int
declare @dont_tally_salescode_id int

declare @contract_symbol varchar(10)
declare @cl_or_lp char(2)

declare @trade_type varchar(25)
declare @trade_type_id int
declare @tally_type varchar(25)
declare @deal_type varchar(25)
declare @deal_id int
declare @deal_exec_symbol varchar(100)
declare @deal_type_id int
declare @deal_status_id int
declare @inverted char(1)
declare @broker varchar(25)
declare @mkt_trade_id int
declare @mkt_trade_identifier varchar(100)
declare @mkt_trader_login varchar(50)
declare @mkt_external_account varchar(25)
declare @mkt_external_account_id int
declare @mkt_cpty_ext_acct_id int
declare @mkt_aggregation_style_id int
declare @mkt_aggregation_style varchar(25)
declare @mkt_counterparty varchar(25)
declare @mkt_counterparty_id int
declare @mkt_trader varchar(25)
declare @mkt_trader_id int
declare @mkt_quantity numeric(30, 4)
declare @mkt_price float
declare @mkt_quoted_price float

declare @cli_trade_id int
declare @cli_trade_identifier varchar(100)
declare @cli_trader_login varchar(50)
declare @cli_external_account varchar(25)
declare @cli_external_account_id int
declare @cli_cpty_ext_acct_id int
declare @cli_aggregation_style_id int
declare @cli_aggregation_style varchar(25)
declare @cli_counterparty varchar(25)
declare @cli_counterparty_id int
declare @cli_trader varchar(25)
declare @cli_trader_id int
declare @cli_quantity numeric(30, 4)
declare @cli_price float
declare @cli_quoted_price float


declare @mkt_lookup_cpty varchar(50)
declare @mkt_lookup_trader varchar(50)
declare @cli_lookup_cpty varchar(50)
declare @cli_lookup_trader varchar(50)

declare @cli_tallied int
declare @mkt_tallied int
declare @contract_id int


declare @substring1 varchar(3)
declare @substring2 varchar(3)

declare @contra_broker varchar(50)
declare @fund_agency_trader varchar(50)
declare @suppress_trade varchar(1)
declare @source_id int

declare @trigger_symbol varchar(50)
declare @cl_create char(1)
declare @lp_create char(1)

declare @t2_cl_ext_account varchar(50)
declare @t2_cl_trader varchar(50)
declare @t2_cl_counterparty varchar(50)
declare @t2_cl_trade_id int
declare @t2_cl_identifier varchar(100)
declare @t2_cl_quantity numeric(30, 4)
declare @t2_cl_inv_qty char(1)

declare @t2_lp_ext_account varchar(50)
declare @t2_lp_trader varchar(50)
declare @t2_lp_counterparty varchar(50)
declare @t2_lp_trade_id int
declare @t2_lp_identifier varchar(100)
declare @t2_lp_quantity numeric(30, 4)
declare @t2_lp_inv_qty char(1)
declare @t2_deal_id int


declare @auto_b2b_deal_status_id int
declare @auto_b2b_deal_type_id int
declare @auto_b2b_deal_id int
declare @is_mt4  varchar(1)


select
	@broker = "PrimeXM",
	@trade_type = "Spot",
	@tally_type = "Spot"

declare @broker_id int
select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
        @source_id = source_id
from
        sources
where
        name = @source

/* Adding Suppression to cut down on log size. Will ACK message and return.
   For now only suppressing on @account. WD 7/2/15 */

select
        @suppress_trade = "Y"
from
        suppression_symbols
where
	source_id = @source_id
and
        symbol = @account

if @suppress_trade = "Y"
begin
	select
		msg = "Suppressing trade",
		account = @account
	
	 /*
 	* Acknoweldge this trade report
	*/
	select
    		trade_report_id=@trade_report_id,
    		symbol=@symbol
    		/*exec_type="TRADE"*/
	
	return
end

select
        @suppress_trade = "Y"
from
        suppression_symbols
where
        source_id = @source_id
and
        symbol = @contra_firm

if @suppress_trade = "Y"
begin
        select
                msg = "Suppressing trade",
		ctpy = @contra_firm

         /*
        * Acknoweldge this trade report
        */
        select
                trade_report_id=@trade_report_id,
                symbol=@symbol
                /*exec_type="TRADE"*/

        return
end


/* Check fund_agency_traders to verify if this is a client or LP message */

select
	@fund_agency_trader = "Y"
from
	trader_symbols a,
	fund_agency_traders b
where
	a.trader_id = b.trader_id
and
	a.source_id = @source_id
and
	a.symbol = @account

if @fund_agency_trader != "Y"
begin
	select
	 	@fund_agency_trader = "Y"
	from
        	traders a,
		fund_agency_traders b
	where
        	a.trader_id = b.trader_id
	and
        	a.symbol = @account
end
	
if @fund_agency_trader = "Y"
begin
	select
		@cl_or_lp = "LP"
end
else
begin
	select
		@cl_or_lp = "CL"
end


/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end


if @side = "SELL" and @cl_or_lp = "CL"
begin
    select
        @quantity = -@quantity
end
if @side = "BUY" and @cl_or_lp = "LP"
begin
    select
        @quantity = -@quantity
end



if @currency != NULL
begin
        select
                @substring1 = substring(@symbol, 1, 3),
                @substring2 = substring(@symbol, 4, 6)

        if @substring1 != @currency
        begin
                select
                        @inverted = "Y"
        end

end

select
	@contract_symbol = rtrim(@currency) + rtrim(@settle_currency)

/* PrimeXM's hacky logic to identiy a CFD trade */
if convert(date, @value_date) = convert(date, "20160101")
begin
        select
                @tally_type = "CFD",
                @trade_type = "CFD",
                /*@contract_symbol = rtrim(@settle_currency) + rtrim(@currency),*/
                @inverted = NULL

        if @trade_date > convert(char(8), @trade_date, 112) +' 17:00'
        begin
                select
                        @value_date = dateadd(day, 1,  convert(char(15), @trade_date, 112))
        end
        else
        begin
                select
                        @value_date = @trade_date
        end
        select
                @value_date = convert(date, @value_date)



        select
                @contract_id = a.contract_id
        from
                contract_symbols a
        where
                source_id = @source_id
        and
                symbol = @symbol
        if @contract_id = NULL
        begin
                select
                        "Error"="CFD not mapped",
                        symbol = @symbol

		select
    			trade_report_id=@trade_report_id,
    			symbol=@symbol

                return
        end

        select
                @contract_symbol = symbol
        from
                contracts
        where
                contract_id = @contract_id

        /* HACK HACK  Chriso to get trades to tally without an exec ID */
        if @execution_id = NULL
                select
                        @execution_id = @trade_report_id

end

if not exists(select contract_id from contracts where symbol = @contract_symbol)
begin
	select
		message = "Contract not found",
		contract = @contract_symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"

        if @trade_type = "CFD"
        begin
                select
                        message = "CFD not requesting contract"
                return
        end

	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @currency,
                	@settle_currency,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@contract_symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@contract_symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @contract_symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @contract_symbol
	and
       		b.name = "Inverted"
   	
end


if @cl_or_lp = "LP"
begin

	select
		@deal_type = "B2B Forward",
		@deal_exec_symbol = @order_id,
		/* @mkt_trade_identifier = rtrim(@execution_id) + ".m", */ 
		@mkt_trade_identifier = rtrim(@trade_report_id),
		@mkt_lookup_cpty = @contra_firm,
		@mkt_lookup_trader = @account,
		@mkt_price = @price,
		@mkt_quantity = @quantity, 
		@mkt_quoted_price = @price


	select
		cl_or_lp = @cl_or_lp,
		lookup_trader = @mkt_lookup_trader,
		lookup_cpty = @mkt_lookup_cpty

	/*
	* CHECK to see if this requires a manufactured B2B
	*/
	select 
		@cl_create = cl_create,
		@lp_create = lp_create
	from 
		ticket_creation_values 
	where 
		trigger_symbol = @mkt_lookup_trader
	and
 		source_id = @source_id
	if @@rowcount != 0
	begin
       		select
               		@trigger_symbol = @mkt_lookup_trader
	end

	select
		@mkt_trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id
	and
		identifier = @mkt_trade_identifier
	if @mkt_trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Mkt trade is already tallied",
			trade_identifier = @mkt_trade_identifier,
			lookup_cpty = @mkt_lookup_cpty,
			lookup_trdr = @mkt_lookup_trader,
			price = @mkt_price,
			quantity = @mkt_quantity


 		/*
 		* Acknoweldge this trade report
		*/
		select
    			trade_report_id=@trade_report_id,
    			symbol=@symbol
    			/*exec_type="TRADE"*/
		return
	end

	/*
 	,-------------------,
 	| TRADE LOOKUPS    |
 	'-------------------'
	*/
	if @mkt_trade_id  = NULL
	begin
		/*
 		* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 		*/ 
		
		select
			@mkt_trader_id = a.trader_id,
			@mkt_trader = a.symbol,
			@mkt_trader_login = c.login,
			@mkt_external_account_id = a.external_account_id
		from
        		traders a,
        		trader_symbols b,
        		tico_accounts c
		where    
        		a.trader_id = b.trader_id
		and
        		a.tico_account_id = c.account_id
		and
			b.source_id = @source_id
		and 
        		b.symbol = @mkt_lookup_trader
		
		if @mkt_trader_id = NULL or @mkt_trader_login = NULL
		begin
    			select
            			@mkt_trader_id = a.trader_id,
            			@mkt_trader = a.symbol,
            			@mkt_trader_login = c.login,
            			@mkt_external_account_id = a.external_account_id
    			from
            			traders a,
            			tico_accounts c
    			where    
            			a.tico_account_id = c.account_id
    			and 
            			a.symbol = @mkt_lookup_trader
		
    			if @mkt_trader_id = NULL or @mkt_trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @mkt_lookup_trader, '" + @mkt_lookup_trader + "'",
            			mkt_lookup_trader = @mkt_lookup_trader
        			return
    			end		
		end
		
		/*
 		* LOOKUP @mkt_counterparty_id, @mkt_counterparty_symbol, @mkt_cpty_ext_acct_id from @mkt_lookup_cpty
 		*/
		
		select
			@mkt_counterparty_id = a.counterparty_id,
			@mkt_counterparty = a.name,
			@mkt_cpty_ext_acct_id = a.external_account_id
		from
        		counterparties a,
        		counterparty_symbols b
		where
        		a.counterparty_id = b.counterparty_id
		and
        		b.source_id = @source_id
		and
        		b.symbol = @mkt_lookup_cpty
		if @mkt_counterparty = NULL
		begin
        		select
                		@mkt_counterparty_id = a.counterparty_id,
				@mkt_counterparty = a.name,
				@mkt_cpty_ext_acct_id = a.external_account_id
        		from
                		counterparties a
        		where
                		a.name = @mkt_lookup_cpty
        		
        		if @mkt_counterparty = NULL
        		begin
               			select
                        		status = "Error",
                        		message = "Couldn't find counterparty for @mkt_lookup_cpty, '" + @mkt_lookup_cpty + "'",
					mkt_lookup_cpty = @mkt_lookup_cpty
                		return
        		end
		end
	
	
		/*
 		* LOOKUP @mkt_external_account, @mkt_external_account_type based on @mkt_external_account_id
 		*/
		select
    			@mkt_external_account = a.symbol,
    			@mkt_aggregation_style = c.name
		from
    			external_accounts a,
    			aggregation_styles c
		where
    			a.aggregation_style_id = c.aggregation_style_id
		and
    			a.external_account_id = @mkt_cpty_ext_acct_id
		if @mkt_external_account = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find external_account from @mkt_external_account_id",
				mkt_external_account_id = @mkt_external_account_id
			return
		end
	end

	select
		@deal_id = deal_id
	from
		deal_exec_symbols
	where
		symbol = @deal_exec_symbol

		
	if @deal_id = NULL
	begin
		select
			msg = "Creating new deal"
		
		select
			@deal_status_id = status_id
		from
			statuses
		where
			name = "User Review"
		if @deal_status_id = NULL
		begin
			select
				status = "Error",
				message = "No status found named, 'User Review'"
			return
		end

		select
			@deal_type_id = deal_type_id
		from
			deal_types
		where
			name = @deal_type
		if @deal_type_id = NULL
		begin
			select
				status = "Error",
				message = "No deal type found for @deal_type",
				deal_type = @deal_type
			return	
		end
	
		exec
			j_nextkey
				"deals",
				@deal_id output
			
			insert into
				deals(
					deal_id,   
					deal_type_id,
					timestamp,  
					status_id  
		 			)      
				values( 
					@deal_id,
					@deal_type_id,
					getdate(),
					@deal_status_id
					)
    		
    			insert into
				deal_exec_symbols
			values(
				@deal_id,
				@deal_exec_symbol
    				)
	end
	else
	begin
		select
			msg = "Appending to existing deal"
	
		/*  Below to support management of deal_type. 
	    	This tally is currently purposed for B2B deals. This will be inserted B2B */	
		/*
        	select
                	@deal_type_id = deal_type_id
        	from
                	deal_types
        	where
                	name = 'B2B Forward'
        	if @deal_type_id = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "No deal type found for 'B2B Forward'"
                	return
        	end
	
		update
			deals
		set
			deal_type_id = @deal_type_id
		where
			deal_id = @deal_id
		*/
	end
				
	if @mkt_trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @mkt_trader_login,
				@source = @source,
				@trade_id = @mkt_trade_id out,
				@deal_id = @deal_id out,
				@tally_type = @tally_type,
				@deal_type = @deal_type,
				@trade_type = @trade_type,
				@external_account = @mkt_external_account,
				@counterparty = @mkt_counterparty,
				@quantity = @mkt_quantity,
				@symbol = @contract_symbol,
				@value_date = @value_date,
				@price = @mkt_price,
				@trade_date = @trade_date,
				@trader = @mkt_trader,
				@broker = @broker,
				@identifier = @mkt_trade_identifier,
				@spot_reference = @mkt_quoted_price
	
		if @mkt_trade_id = NULL
		begin
			select
				status = "Error",
				message = "Failed to tally trade"
			return
		end
	
	
		insert into
			trade_quoted_prices (	
				trade_id,
				price)
		values(
			@mkt_trade_id,
			@mkt_quoted_price
			)

		exec
			r_inserttradenotification
			@mkt_trade_id
		select		
			@mkt_tallied = 1
	end

	if @cl_create = "Y" or @lp_create = "Y"
	begin
		if @cl_create = "Y"
		begin
			/*
			declare @t2_cl_ext_account varchar(50)
			declare @t2_cl_trader varchar(50)
			declare @t2_cl_counterparty varchar(50)
			declare @t2_cl_trade_id int
			declare @t2_cl_identifier varchar(100)
			declare @t2_cl_quantity numeric(30, 4)
			declare @t2_cl_inv_qty char(1) */
				
			select
				@t2_cl_ext_account = cl_ext_account,
				@t2_cl_trader = cl_trader,
				@t2_cl_counterparty = cl_counterparty,
				@t2_cl_inv_qty = cl_inv_qty
			from
				ticket_creation_values
			where
	        		trigger_symbol = @trigger_symbol
	
			select
				@t2_cl_identifier = rtrim(@mkt_trade_identifier)+".t2cl_autob2b",
                       		@t2_cl_quantity = @mkt_quantity
	
				
			if @t2_cl_inv_qty = "Y"
			begin
				select
					@t2_cl_quantity = -@mkt_quantity
			end
	
			exec
				fxa_tallytrade
					@login = @mkt_trader_login,
					@source = @source,
					@trade_id = @t2_cl_trade_id out,
					@deal_id = @deal_id out,
					@tally_type = @trade_type,
					@deal_type = @deal_type,
					@trade_type = @trade_type,
					@external_account = @t2_cl_ext_account,
					@counterparty = @t2_cl_counterparty,
					@quantity = @t2_cl_quantity,
					@symbol = @symbol,
					@value_date = @value_date,
					@price = @price,
					@trade_date = @trade_date,
					@trader = @t2_cl_trader,
					@broker = @broker,
					@identifier = @t2_cl_identifier,
					@spot_reference = @mkt_quoted_price
	
	
			if @t2_cl_trade_id = NULL
			begin
    				select
       					status = "Error",
       					message = "Failed to tally trade"
    				return
			end
		
	
			exec
   					r_inserttradenotification
       					@t2_cl_trade_id
	
			select
       				status = "Tallied",
       				message = "Trade successfully tallied",
       				trade_id = @t2_cl_trade_id,
       				deal_id = @deal_id,
       				account = @t2_cl_ext_account,
       				symbol = @symbol,
       				quantity = @t2_cl_quantity,
       				price = @price,
       				val_date = @value_date
 	
			
	
		end
		if @lp_create = "Y"
		begin
			/*
        		declare @t2_lp_ext_account varchar(50)
               		declare @t2_lp_trader varchar(50)
               		declare @t2_lp_counterparty varchar(50)
               		declare @t2_lp_trade_id int
               		declare @t2_lp_identifier varchar(100)
               		declare @t2_lp_quantity numeric(30, 4)
			declare @t2_lp_inv_qty char(1)
                	declare @t2_deal_id int */
	
               		select
                       		@t2_lp_ext_account = lp_ext_account,
                       		@t2_lp_trader = lp_trader,
                       		@t2_lp_counterparty = lp_counterparty,
				@t2_lp_inv_qty = lp_inv_qty
               		from
                       		ticket_creation_values
               		where
                       		trigger_symbol = @trigger_symbol
	
               		select
                       		@t2_lp_identifier = rtrim(@mkt_trade_identifier)+".t2lp_autob2b",
				@t2_lp_quantity = @mkt_quantity
	
               		if @t2_lp_inv_qty = "Y"
               		begin
                       		select
                               		@t2_lp_quantity = -@mkt_quantity
               		end
			
			if @cl_create = "Y"
			begin
				select
					@t2_deal_id = @auto_b2b_deal_id
			end
			else
			begin
				select
					@t2_deal_id = @deal_id
			end
               		exec
                       		fxa_tallytrade
                               		@login = @mkt_trader_login,
                               		@source = @source,
