drop procedure
	r_insaggregatedtrade
go

create procedure
	r_insaggregatedtrade
		@trade_identifier varchar(100),
		@aggregate_trade_id int

as


declare @trade_id int

select
	@trade_id = trade_id
from
	trades
where
	identifier = @trade_identifier 
if @@rowcount != 1
begin
	select
		status = "Error", 
		msg = "Could not find trade_id from identifier " + @trade_identifier  
	return
end

insert into
	aggregated_trades (
		aggregate_trade_id,
		trade_id,
		deal_id,
		user_id,
		trade_type_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		quantity,
		contract_id,
		value_date,
		fixing_date,
		price,
		trade_date,
		trader_id,
		strategy_id,
		status_id,
		broker_id,
		sales_code_id,
		identifier,
		pct_price,
		spot_reference
		)
select
	@aggregate_trade_id,
	@trade_id,
	deal_id,
	user_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	counterparty_id,
	quantity,
	contract_id,
	value_date,
	fixing_date,
	price,
	trade_date,
	trader_id,
	strategy_id,
	status_id,
	broker_id,
	sales_code_id,
	identifier,
	pct_price,
	spot_reference
from
	trades 
where
	trade_id = @trade_id

delete from
	trades 
where
	trade_id = @trade_id

select
	msg = "Micro trade aggregated",
	trade_id = @trade_id,
	aggregated_trade_id = @aggregate_trade_id


go
