use
	risk_sjmdemo
go

drop procedure
	ag_assigncustodialaccount
go

create procedure
	ag_assigncustodialaccount
		@login varchar(50),
		@ledger_request_id int,
		@custodial_account varchar(50),
		@ledger_request_type varchar(50),
		@product varchar(50),
		@amount float
as

declare @tico_account_id int
declare @admin_level int
declare @status varchar(50)
declare @next_status_id int
declare @custodial_account_id int
declare @unassigned_account_id int

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login
if @tico_account_id = NULL
begin
        select
                status = "Error",
                message = "Unable to resolve login"
        return
end

select
        @admin_level = admin_level
from
        approval_users
where
        tico_account_id = @tico_account_id

if @admin_level != 0
begin
        select
                status = "Restricted Access",
                message = "Senior Admin level status required for login to access this page"
                return
end

select
	@unassigned_account_id = a.external_account_id
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Custody"
and
	a.symbol = "UNASSIGNED CUSTODY"
if @unassigned_account_id = NULL
begin
	select
		status = "Error",
		message = "UNASSIGNED CUSTODY account not found"
	return
end

select
	@status = a.name
from
	statuses a,
	ledger_requests b
where
	a.status_id = b.status_id
and
	b.ledger_request_id = @ledger_request_id
if @status != "New"
begin
	select
		status = "Error",
		message = "Request must be New to assign custodial account"
	return
end


if @custodial_account = "UNASSIGNED CUSTODY"
begin
	select
		status = "Unchanged",
		message = "UNASSIGNED CUSTODY account cannot be used to approve requests"
	return
end

select
	@custodial_account_id = a.external_account_id
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Custody"
and
	a.symbol = @custodial_account
if @custodial_account_id = NULL
begin
	select
		status = "Error",
		message = "Custodial account not found",
		account = @custodial_account
	return
end

begin tran
	insert into
		ledger_request_edits(
			ledger_request_id,
			requestor_id,
			status_id,
			outside_account_id,
			bo_master_account_id,
			custodial_account_id,
			ledger_request_type_id,
			product_id,
			amount,
			transaction_date,
			request_date,
			edited_by,
			timestamp)
	select
		ledger_request_id,
		requestor_id,
		status_id,
		outside_account_id,
		bo_master_account_id,
		custodial_account_id,
		ledger_request_type_id,
		product_id,
		amount,
		transaction_date,
		request_date,
		edited_by = @tico_account_id,
		timestamp = getdate()
	from
		ledger_requests
	where
		ledger_request_id = @ledger_request_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to log edit to request",
			ledger_request_id = @ledger_request_id
		rollback tran
		return
	end
	
	update
		ledger_requests
	set
		custodial_account_id = @custodial_account_id
	where
		ledger_request_id = @ledger_request_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not assign custodial account to request",
			ledger_request_id = @ledger_request_id,
			custodial_account = @custodial_account
		rollback tran
		return
	end

	update
		pending_transactions
	set
		external_account_id = @custodial_account_id 
	where
		ledger_request_id = @ledger_request_id
	and
		external_account_id = @unassigned_account_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to update pending transaction for custodial account",
			ledger_request_id = @ledger_request_id,
			custodial_account = @custodial_account
		rollback tran
		return
	end
			
commit tran

exec
	ag_approvenextaction
		@login = @login,
		@ledger_request_id = @ledger_request_id,
		@status = "New",
		@next_action = "Acknowledged"

go


