
drop procedure
	fxa_editmarkettrade
go

create procedure
	fxa_editmarkettrade
		@login varchar(25),
		@deal_id int,
		@tally_type varchar(25),
		@buy_sell varchar(5),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@counterparty varchar(25),
		@quantity numeric(30,2),
		@price float,
		@value_date datetime = NULL,
		@fixing_date datetime = NULL
as

declare @symbol varchar(50)
declare @trade_id int
declare @trade_date datetime
declare @external_account varchar(50)
declare @sales_code varchar(50)
declare @trade_type varchar(25)

if @buy_sell = "Sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @buy_sell = "Buy"
begin
	select
		@quantity = abs(@quantity)
end

select
	@external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end


select
	@sales_code = "None"

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)

select
	@trade_date = getdate()

select
	@trade_id = trade_id
from
	trades
where
	deal_id = @deal_id

select
	@trade_type = @tally_type

exec
	r_inserttradeedit @trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Market Forward",
		@trade_type = @trade_type,	
		@internal_account = NULL,
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@fixing_date = @fixing_date,
		@price = @price,
		@trade_date = @trade_date,
		@trader = NULL,
		@strategy = NULL,
		@status = NULL,
		@broker = NULL,
		@identifier = NULL,
		@sales_code = @sales_code,
		@premium = NULL,
		@premium_currency = NULL,
		@prem_settle_date = NULL,
		@pct_price = NULL,
		@spot_reference = NULL

if (@quantity = 0)
begin
	exec r_updatetradenotification @trade_id, "Cancelled"
end
else
begin

	exec
		r_updatetradenotification @trade_id, "Edit"

end

exec
	r_inspectdealtrades
		@login,
		@deal_id


go


