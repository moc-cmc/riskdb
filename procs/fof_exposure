create table
	#deltas(
		id int identity,
		contract_id int,
		quantity numeric(30,4),
		current_price float NULL,
		product_id int,
		currency_id int)

insert into
	#deltas(
		contract_id,
		quantity,
		current_price,
		product_id,
		currency_id)
select
	a.contract_id,
	quantity = 1000000.00,
	c.price,
	b.product_id,
	b.currency_id
from
	contracts a,
	forwards b,
	current_prices c
where
	a.contract_id = b.contract_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id
and
	a.symbol in("USDCAD", "EURUSD", "USDJPY", "GBPUSD", "EURGBP", "EURJPY")

update
	#deltas
set
	quantity = convert(float, id) * quantity


create table
	#balances(
		product_id int,
		balance float NULL)

insert into
	#balances
select
	product_id,
	quantity
from
	#deltas

insert into
	#balances
select
	currency_id,
	quantity * current_price * -1.0
from
	#deltas

create table
	#net_balances(
		product_id int,
		balance float)

update
	#net_balances
set
	a.balance = a.balance / 100.00
from
	#net_balances a,
	products b
where
	a.product_id = b.product_id
and
	b.symbol = "JPY"

insert into
	#net_balances
select
	product_id,
	sum(balance)
from
	#balances
group by
	product_id

update
	#net_balances
set
	a.balance = a.balance / 100.00
from
	#net_balances a,
	products b
where
	a.product_id = b.product_id
and
	b.symbol = "JPY"

update
	#net_balances
set
	balance = balance / 1000000.00

select
    '<div style="height:220px;background:#fff"><div id="longs" style="width:200px;float:left"><h3 style="text-align:center">Longs</h3><div id="chart1" style="height:200px;width:200px;margin:0 -4px;"></div></div><div id="shorts" style="width:200px;float:left"><h3 style="text-align:center">Shorts</h3><div id="chart2" style="height:200px;width:200px;margin:0 -4px;"></div></div></div>'

select
	a.symbol,
	longs = abs(b.balance),
	shorts = abs(b.balance)
from
	products a,
	#net_balances b
where
	a.product_id = b.product_id
order by
	a.symbol


select
    '<script type="text/javascript">jQuery("#chart1").chart(jQuery(".OutputTable").eq(1), { plot:"pie", xaxis:{type:"date"}, series:[{x1:0,y1:1}], bind:{rowStart:2}})</script>',
    '<script type="text/javascript">jQuery("#chart2").chart(jQuery(".OutputTable").eq(1), { plot:"pie", xaxis:{type:"date"}, series:[{x1:0,y1:2}], bind:{rowStart:2}})</script>',
    '<style>.Legend{display:none}</style>',
    '<script>jQuery(".OutputTable").eq(1).hide();</script>'


go

