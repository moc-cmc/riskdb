create or replace procedure
	r_managefiledropmultirun
		@login varchar(50),
		@run varchar(50)=NULL,
		@filedrop_report varchar(50)=NULL,
		@filedrop_destination varchar(50)=NULL

as

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @run_id int
declare @filedrop_report_id int
declare @filedrop_destination_id int

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "configure_run",
        "Configure Filedrop Run",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "filedrop_reports",
        "View Filedrop Reports",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "filedrop_destinations",
        "View Filedrop Destinations",
        NULL)

insert into
        #meta
values( 
        "Column Link",
        "view_logs",
        "View Filedrop Logs",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "remove_run",
        "Delete Filedrop Run",
        NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

select
        style = @style,
        configure_run = "ADD RUN",
        filedrop_reports = "VIEW REPORTS",
        filedrop_destinations = "VIEW DESTINATIONS",
	view_logs = "VIEW LOGS"

create table
	#output(
		style varchar(50) NULL,
		run varchar(50) NULL,
		run_id int NULL,
		filedrop_report varchar(50) NULL,
		filedrop_report_id int NULL,
		filedrop_destination varchar(50) NULL,
		filedrop_destination_id int NULL,
		remove_run varchar(50) NULL)

insert into
	#output(
		style,
		run,
		run_id,
		filedrop_report,
		filedrop_report_id,
		filedrop_destination,
		filedrop_destination_id,
		remove_run)
select
	style = @style,
	run = a.name,
	run_id = a.run_id,
	filedrop_report = b.name,
	filedrop_report_id = b.filedrop_report_id,
	filedrop_destination = c.name,
	filedrop_destination_id = c.filedrop_destination_id,
	remove_run = "DELETE"
from
	runs a,
	filedrop_reports b,
	filedrop_destinations c,
	run_fd_report_destinations d
where
	a.run_id = d.run_id
and
	b.filedrop_report_id = d.filedrop_report_id
and
	c.filedrop_destination_id = d.filedrop_destination_id
order by
	a.name,
	b.name,
	c.name

if @run != NULL
begin
        select
                @run_id = run_id
        from
                runs
        where
                name = @run
        if @@rowcount != 1
        begin
                select
                        status = "Error",
                        msg = "Could not find run",
                        run = @run
                return
        end

	delete from
		#output
	where
		run_id != @run_id 
end

if @filedrop_report != NULL
begin
        select
                @filedrop_report_id = filedrop_report_id
        from
                filedrop_reports
        where
                name = @filedrop_report
        if @@rowcount != 1
        begin
                select
                        status = "Error",
                        msg = "Could not find report",
                        filedrop_report = @filedrop_report
                return
        end

	delete from
		#output
	where
		filedrop_report_id != @filedrop_report_id
end

if @filedrop_destination != NULL
begin
        select
                @filedrop_destination_id = filedrop_destination_id
        from
                filedrop_destinations
        where
                name = @filedrop_destination
        if @@rowcount != 1
        begin
                select
                        status = "Error",
                        msg = "Could not find destination",
                        filedrop_destination = @filedrop_destination
                return
        end

	delete from
		#output
	where
		filedrop_destination_id != @filedrop_destination_id
end

select
	section = "Configured For Filedrop",
	style,
        run,
        filedrop_report,
        filedrop_destination,
        remove_run
from
	#output

go	
	
