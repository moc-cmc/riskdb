
drop procedure
	tt_resolvetradermapping
go

create procedure 
	tt_resolvetradermapping
		@login varchar(50),
		@source_id int,
		@source varchar(50),
		@broker_id int,
		@identifier varchar(100),
		@mapping_error_id int=NULL,
		@mapping varchar(50),
		@trader_id int=NULL output,
		@trader varchar(50)=NULL output,
		@trader_login varchar(50)=NULL output,
		@external_account_id int=NULL output

as

declare @message varchar(100)

select
	@trader_id = a.trader_id,
	@trader = a.symbol,
	@trader_login = c.login,
	@external_account_id = a.external_account_id
from
	traders a,
	trader_symbols b,
	tico_accounts c
where
	a.trader_id = b.trader_id
and
	b.source_id = @source_id
and
	a.tico_account_id = c.account_id
and
	b.symbol = @mapping

if @trader_id = NULL or @trader_login = NULL
begin
	select
                @message="No trader mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@mapping) + "'"
	
	if @mapping_error_id = NULL
	begin
		select
			msg = @message
                      
		exec
			ag_sendfailedmappingmessage
				@login=@login,
				@broker_id=@broker_id,
				@identifier=@identifier,
				@mapping_error_type="Trader",
				@message = @message
 
	end
	else
	begin
		select
			msg = @message,
			mapping_error_id = @mapping_error_id 
		return
	end
end

if @mapping_error_id != NULL
	exec
		ag_resolvefailedmappingmessage
			@login = @login,
			@mapping_error_id = @mapping_error_id

go

