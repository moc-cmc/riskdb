create table
	#trades(
		trade_id int)
insert into
	#trades(
		trade_id)
select
	a.trade_id
from
	trades a,
	#trade_types b,
	#internal_accounts c,
	#external_accounts d,
	#counterparties e,
	#contracts f,
	#traders g,
	#strategies h,
	#sales_codes i,
	#brokers j
where
	a.trade_type_id = b.trade_type_id
and
	a.internal_account_id = c.internal_account_id
and
	a.external_account_id = d.external_account_id
and
	a.counterparty_id = e.counterparty_id
and
	a.contract_id = f.contract_id
and
	a.trader_id = g.trader_id
and
	a.strategy_id = h.strategy_id
and
	a.sales_code_id = i.sales_code_id
and
	a.broker_id = j.broker_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date



create table
	#output(
		trade_id int,
		deal_id int,
		trade_date datetime,
		account varchar(50),
		quantity numeric(30,4),
		contract_id int,
		product_id int NULL,
		currency_id int NULL,
		inverted_contract_id int NULL,
		symbol varchar(50),
		value_date datetime,
		price numeric(30,8),
		broker varchar(50),
		counterparty varchar(50),
		eod_mark numeric(30,8) NULL,
		volume numeric(30,4) NULL,
		fee_schedule_type varchar(50) NULL,
		fee float NULL,
		fee_currency_id int NULL,
		conversion_rate float NULL,
		fee_currency varchar(5) NULL,
		debit_account varchar(50) NULL,
		credit_account varchar(50) NULL) 
insert into
	#output(
		trade_id,
		deal_id,
		trade_date,
		account,
		quantity,
		contract_id,
		symbol,
		value_date,
		price,
		broker,
		counterparty)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	account = c.symbol,
	a.quantity,
	a.contract_id,
	d.symbol,
	a.value_date,
	a.price,
	broker = e.symbol,
	counterparty = f.name
from
	trades a,
	#trades b,
	external_accounts c,
	contracts d,
	brokers e,
	counterparties f
where
	a.trade_id = b.trade_id
and
	a.external_account_id = c.external_account_id
and
	a.contract_id = d.contract_id
and
	a.broker_id = e.broker_id
and
	a.counterparty_id = f.counterparty_id

update
	#output
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#output a,
	forwards b
where
	a.contract_id = b.contract_id


update
	#output
set
	a.inverted_contract_id = b.contract_id
from
	#output a,
	forwards b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id


update
	#output
set
	a.eod_mark = b.price
from
	#output a,
	prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @end_date)


update
	#output
set
	a.eod_mark = 1.0 / b.price
from
	#output a,
	prices b
where
	a.inverted_contract_id = b.contract_id
and
	a.eod_mark = NULL

update
	#output
set
	volume = abs(quantity)
where
	product_id = @evaluation_currency_id

update
	#output
set
	volume = abs(quantity * price * -1.0)
where
	currency_id = @evaluation_currency_id

update
	#output
set
	a.volume = abs(a.quantity) * b.rate
from
	#output a,
	#conversion_rates b
where
	a.product_id = b.product_id
and
	a.volume = NULL

update
	#output
set
	a.volume = abs(a.quantity * a.price * -1.0) * b.rate
from
	#output a,
	#conversion_rates b
where
	a.currency_id = b.product_id
and
	a.volume = NULL

update
	#output
set
	fee_schedule_type = @fee_schedule_type


update
	#output
set
	fee = (volume / 1000000.0) * @fee_price,
	fee_currency = @fee_product
where
	fee_schedule_type = "Volume"


