go

create procedure
	ag_tradefeesfordate
		@login varchar(50),
		@fee_schedule varchar(100),
		@trade_date datetime=NULL
as

/* Status filtering not supported */

declare @fund_id int
declare @evaluation_currency_id int

declare @begin_date datetime
declare @end_date datetime
declare @fee_schedule_id int
declare @fee_schedule_type varchar(50)
declare @fee_price numeric(30,4)
declare @fee_product_id int
declare @fee_product varchar(50)
declare @debit_account varchar(50)
declare @credit_account varchar(50)
declare @transaction_type varchar(50)
declare @conversion_rate float

exec
	r_defaultfundforlogin
		@login,
		@fund_id output



select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @trade_date = NULL
	select
		@trade_date = convert(datetime, convert(date, getdate()))


exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	a.product_id
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"

update
	#conversion_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL


select
	@fee_schedule_id = fee_schedule_id,
	@fee_price = fee_price,
	@fee_product_id = fee_product_id
from
	fee_schedules
where
	name = @fee_schedule
if @fee_schedule_id = NULL
begin
	select
		status = "Error",
		message = "Fee schedule not found",
		fee_schedule = @fee_schedule
	return
end

select
	@conversion_rate = rate
from
	#conversion_rates
where
	product_id = @fee_product_id



select
	@debit_account = a.symbol
from
	external_accounts a,
	fee_schedules b
where
	a.external_account_id = b.book_to_ext_account_id
and
	b.fee_schedule_id = @fee_schedule_id


select
	@credit_account = a.symbol
from
	external_accounts a,
	fee_schedules b
where
	a.external_account_id = b.credit_ext_account_id
and
	b.fee_schedule_id = @fee_schedule_id


select
	@transaction_type = a.name
from
	transaction_types a,
	fee_schedules b
where
	a.transaction_type_id = b.fee_type_id
and
	b.fee_schedule_id = @fee_schedule_id

select
	@fee_product = symbol
from
	products
where
	product_id = @fee_product_id

select
	@fee_schedule_type = a.name
from
	fee_schedule_types a,
	fee_schedules b
where
	a.fee_schedule_type_id = b.fee_schedule_type_id
and
	b.fee_schedule_id = @fee_schedule_id

create table
	#trade_types(
		trade_type_id int)
	
insert into
	#trade_types(
		trade_type_id)
select
	trade_type_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	trade_type_id != NULL
if @@rowcount = 0
	insert into
		#trade_types(
			trade_type_id)
	select
		trade_type_id
	from
		trade_types

