update
	#output
set
	a.fee = c.amount,
	a.fee_currency = d.symbol
from
	#output a,
	scheduled_fee_transactions b,
	account_transactions c,
	products d,
	transaction_types e
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.currency_id = d.product_id
and
	c.transaction_type_id = e.transaction_type_id
and
	a.fee_schedule_type = "Pip Spread"
and
	e.name = "Spread Payout"





update
	#output
set
	fee_currency_id = currency_id
where
	fee_schedule_type = "Pip Spread"

update
	#output
set
	a.conversion_rate = b.rate
from
	#output a,
	#conversion_rates b
where
	a.fee_currency_id = b.product_id

select
	trade_id,
	deal_id,
	trade_date,
	account,
	quantity,
	symbol,
	value_date,
	price,
	broker,
	counterparty,
	eod_mark,
	volume,
	fee_schedule_type,
	fee,
	fee_currency,
	fee_equiv = convert(numeric(30,2), (fee * conversion_rate)),
	debit_account = @debit_account,
	credit_account = @credit_account,
	transaction_type = @transaction_type
from
	#output



