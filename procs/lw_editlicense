use
	risk_firsel
go

drop procedure
	lw_editlicense
go

create procedure
	lw_editlicense
		@login varchar(50),
		@jurisdiction varchar(100),
		@entity varchar(50),
		@collecting varchar(5)=NULL,
		@status varchar(50)=NULL,
		@as_of_date datetime=NULL,
		@expiration_date datetime=NULL,
		@licensing_authority varchar(250)=NULL,
		@license_number varchar(50)=NULL,
		@license_renewal_fee float=NULL,
		@cert_auth datetime=NULL,
		@cert_auth_exp datetime=NULL,
		@cert_auth_renew_fee float=NULL,
		@exemption_type varchar(250)=NULL,
		@legal_basis varchar(100)=NULL,
		@bond_amt float=NULL,
		@bond_exp datetime=NULL,
		/* @date_started datetime=NULL, 
		@est_completion datetime=NULL, */
		@notes varchar(255)=NULL

as


declare @tico_account_id int
declare @archive_date datetime
declare @license_id int
declare @entity_id int
declare @jurisdiction_id int
declare @status_id int
declare @licensing_authority_id int
declare @exemption_type_id int
declare @legal_basis_id int
declare @l_date datetime
declare @expiration datetime
declare @start datetime
declare @complete datetime


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@archive_date = getdate()

select
	@jurisdiction_id = jurisdiction_id
from
	jurisdictions
where
	name = @jurisdiction
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Jurisdiction not found",
		jurisdiction = @jurisdiction
	return
end

select
	@license_id = license_id
from
	licenses
where
	jurisdiction_id = @jurisdiction_id
if @license_id = NULL
begin
	select
		status = "Error",
		message = "License not found",
		jurisdiction = @jurisdiction
	return
end

select
	@entity_id = entity_id
from
	entities
where
	name = @entity
if @@rowcount = 0
begin
	exec
		j_nextkey
			"entities",
			@entity_id output

	insert into
		entities
	values(
		@entity_id,
		@entity)
end

select
	@status_id = status_id
from
	statuses
where
	name = @status
if @@rowcount = 0
begin
	exec
		j_nextkey
			"statuses",
			@status_id output

	insert into
		statuses
	values(
		@status_id,
		@status)
end

select
	@licensing_authority_id = licensing_authority_id
from
	licensing_authorities
where
	name = @licensing_authority
if @licensing_authority_id = NULL
begin
	exec
		j_nextkey
			"licensing_authorities",
			@licensing_authority_id output

	insert into
		licensing_authorities
	values(
		@licensing_authority_id,
		@licensing_authority)
end


if @exemption_type != NULL
begin
	select
		@exemption_type_id = exemption_type_id
	from
		exemption_types
	where
		name = @exemption_type
	if @@rowcount = 0
	begin
		exec
			j_nextkey
				"exemption_types",
				@exemption_type_id output

		insert into
			exemption_types
		values(
			@exemption_type_id,
			@exemption_type)
	end
end

if @legal_basis != NULL
begin
	select
		@legal_basis_id = legal_basis_id
	from
		legal_bases
	where
		name = @legal_basis
	if @@rowcount = 0
	begin
		exec
			j_nextkey
				"legal_bases",
				@legal_basis_id output
	
		insert into
			legal_bases
		values(
			@legal_basis_id,
			@legal_basis)
	end
end

insert into
	license_archive
select
	license_id,
	jurisdiction_id,
	entity_id,
	status_id,
	as_of_date,
	expiration_date,
	licensing_authority_id,
	license_number,
	cert_auth_date,
	exemption_type_id,
	legal_basis_id,
	date_started,
	est_completion,
	notes,
	license_renewal_fee,
	cert_auth_exp,
	cert_auth_renew_fee,
	tico_account_id = @tico_account_id,
	archive_date = @archive_date,
	collecting,
	bond_amt,
	bond_exp
from
	licenses
where
	jurisdiction_id = @jurisdiction_id

update
	licenses
set
	jurisdiction_id = @jurisdiction_id,
	entity_id = @entity_id,
	status_id = @status_id,
	as_of_date = @as_of_date,
	expiration_date = @expiration_date,
	licensing_authority_id = @licensing_authority_id,
	license_number = @license_number,
	license_renewal_fee = @license_renewal_fee,
	cert_auth_date = @cert_auth,
	cert_auth_exp = @cert_auth_exp,
	cert_auth_renew_fee = @cert_auth_renew_fee,
	exemption_type_id = @exemption_type_id,
	legal_basis_id = @legal_basis_id,
	/* date_started = @date_started,
	est_completion = @complete, */
	notes = @notes,
	collecting = @collecting,
	bond_amt = @bond_amt,
	bond_exp = @bond_exp
where
	jurisdiction_id = @jurisdiction_id
	
exec
	lw_inspectlicense
		@login,
		@jurisdiction


go
