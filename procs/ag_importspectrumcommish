use
	risk_elviro
go

drop procedure
	ag_importspectrumcommish
go

create procedure
	ag_importspectrumcommish
		@login varchar(50),
		@customer varchar(50)=NULL,
		@trade_number varchar(50)=NULL,
		@trade_dt varchar(50)=NULL,
		@value_dt varchar(50)=NULL,
		@trade_type varchar(50)=NULL,
		@purpose varchar(50)=NULL,
		@contract_amount varchar(50)=NULL,
		@base_rate varchar(50)=NULL,
		@traded_rate varchar(50)=NULL,
		@counter_amount varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@portfolio varchar(50)=NULL,
		@commission_type varchar(50)=NULL,
		@ccy varchar(50)=NULL,
		@commission varchar(50)=NULL,
		@row_index int,
		@row_count int
as

declare @account varchar(50)
declare @transaction_date datetime
declare @value_date datetime
declare @transaction_type_id int
declare @currency_id int
declare @account_transaction_id int
declare @tico_account_id int
declare @external_account_id int
declare @source_id int
declare @source varchar(50)
declare @identifier varchar(50)
declare @amount float


if @customer like "%CUSTOMER%" return

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@source = "Spectrum"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Unable to find source",
		source = @source
	return
end


select
	@account = left(@customer, charindex(":", @customer) -1)

select
	@value_date = convert(datetime, @value_dt, 3),
	@transaction_date = convert(datetime, @trade_dt, 3)


select
	@external_account_id = external_account_id
from
	external_account_symbols
where
	source_id = @source_id
and
	symbol = @account
if @external_account_id = NULL
begin
	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @account
	if @external_account_id = NULL
	begin
		select
			status = "Error",
			message = "External account not found",
			account = @account
		return
	end
end


select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Commission"
if @transaction_type_id = NULL
begin	
	select
		status = "Error",
		message = "Commission transaction type not found"
	return
end

select
	@currency_id = product_id
from
	products
where
	symbol = @ccy
if @currency_id = NULL
begin
	select
		status = "Error",
		message = "Currency not found",
		currency = @ccy
	return
end

select
	@identifier = rtrim(@source) + "-" + rtrim(@trade_number) + "-" + convert(varchar(11), @value_date)

select
	@amount = convert(float, @commission) * -1.0

select
	@account_transaction_id = account_transaction_id
from
	account_transactions
where
	note = @identifier
if @account_transaction_id != NULL
begin
	select
		status = "Dupe",
		message = "Account transaction already booked",
		identifier = @identifier
	return
end

exec
	j_nextkey
		"account_transactions",
		@account_transaction_id output

insert into
	account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount,
		note)
values(
	@account_transaction_id,
	@tico_account_id,
	@external_account_id,
	@transaction_type_id,
	@transaction_date,
	@currency_id,
	@amount,
	@identifier)

insert into
	external_commissions(
		source_id,
		trade_date,
		external_account_id,
		product_id,
		amount)
values(
	@source_id,
	@transaction_date,
	@external_account_id,
	@currency_id,
	@amount)



if @row_index = @row_count - 1
	select
		status = "Success",
		message = "End of file import"



go

