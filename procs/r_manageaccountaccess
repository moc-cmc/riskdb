create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)


insert into
	#links
values(
	"Column Link",
	"view_details",
	"Manage Access By Account",
	NULL,
	NULL)


