create table
	#run_counts0(
		account_id int,
		runs_subscribed int
)

create table
	#run_counts(
		account_id int,
                runs_subscribed int
)

insert into
	#run_counts0
select
	account_id,
	0
from
	tico_accounts

insert into
	#run_counts
select
	tico_account_id,
	count(*)
