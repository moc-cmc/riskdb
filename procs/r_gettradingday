
if object_id("r_gettradingday") != NULL
    drop procedure
        r_gettradingday
go

create procedure
	r_gettradingday
		@date datetime=NULL,
        @trading_day datetime=NULL output,
		@begin_date datetime=NULL output,
		@end_date datetime=NULL output
as

if @date = NULL
    select
        @date = getdate()
        
if datepart(hour, @date) >= 17
    exec
        r_nextbusinessday
            @date,
            @date output

select
    @date = convert(datetime, convert(char(10), @date, 101))

exec
    r_prevbusinessday
        @date,
        @begin_date output

select
    @begin_date = convert(datetime, convert(char(10), @begin_date, 101) + " 17:00")

exec
    r_nextbusinessday
        @begin_date,
        @end_date output

select
    @trading_day = @end_date

select
    @end_date = convert(datetime, convert(char(10), @end_date, 101) + " 17:00")

go
