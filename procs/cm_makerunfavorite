
drop procedure
	cm_makerunfavorite
go

create procedure
	cm_makerunfavorite 
			@login varchar(25),
			@account_name varchar(50),
			@run_name varchar(200)

as

declare @tico_account_id int
declare @run_id int

select
	@tico_account_id=account_id
from
	tico_accounts
where
	login=@account_name

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Could not get login id for tico login",
		login=@login

	return
end

select
	@run_id=a.run_id
from
	user_runs a,
	runs b
where
	a.tico_account_id=@tico_account_id
and
	a.run_id=b.run_id
and
	b.name=@run_name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not get run id for run",
		run=@run_name

	return
end

begin tran

	
	insert into
		user_run_favorites
	(
 	tico_account_id,
 	run_id)
	values	
	(
 	@tico_account_id,
 	@run_id)

	if (@@rowcount != 1)
	begin
		select
			status="Error",
			msg="Could not create user run favorite",
			run=@run_name

		rollback tran
		return
	end

commit tran

exec 
	r_manageaccountaccessdetails @account_name

return

go

