
create or replace procedure
	dd_outboundsourcecheck

as

declare @start_time datetime
select
	@start_time=getdate()

declare @end_time datetime
declare @now datetime
declare @begin_date datetime
declare @end_date datetime
declare @next_id int
declare @source_id int
declare @status_id int
declare @source varchar(50)
declare @status varchar(50)
declare @queued varchar(10)
declare @stale_count int
declare @tags varchar(255)
declare @ops_name varchar(70)
declare @integration varchar(50)
declare @org varchar(50)
declare @swap_far_trade_type int
declare @format_swaps char(1)
declare @far_swaps int

select
	@now = getdate()

exec
	r_daterangefordate
		@now,
		@begin_date output,
		@end_date output

create table
	#statuses(
		status_id int,
		name varchar(50)
)
insert into
	#statuses
select
	status_id,
	name
from
	statuses
where
	name in("Active", "Edit", "Cancelled")


select
	@swap_far_trade_type = trade_type_id
from
	trade_types
where
	name = "Swap Far"

if @@rowcount != 1
begin
	select
		status="Warning",
		msg="Trade Type not available",
		trade_type="Swap Far"
end

create table
	#outbound_sources(
		id int identity, 
		source_id int,
		source_name varchar(50),
		ops_name varchar(50),
		integration varchar(50),
		stale_threshold datetime,
		org_id int NULL,
		org varchar(50) NULL,
		format_swaps char(1) NULL,
		far_leg_count int,
		stale_count int
)

insert into 
	#outbound_sources(
		source_id,
		source_name,	
		ops_name,
		integration,
		stale_threshold,
		org_id,
		format_swaps,
		far_leg_count,
		stale_count)
select
	a.source_id,
	a.name,
	c.ops_name,
	e.name,
	dateadd(ss, c.stale_threshold * -1, getdate()),
	e.org_id,
	e.format_swaps,
        0,
	0
from	
	sources a,
	source_types b,
	connections c,
	connection_statuses d,
	integrations e
where
	a.source_id = c.source_id
and
	a.source_type_id = b.source_type_id
and
	c.connection_status_id = d.connection_status_id
and
	c.integration_id = e.integration_id
and
	b.name = "Outbound"
and
	c.monitoring_enabled = "Y"
and
	d.name = "Active"

update 
	#outbound_sources
set
	org = b.name
from
	#outbound_sources a,
	orgs b
where
	a.org_id = b.org_id

create table
	#far_swap_counts (
		source_id int,
		far_swap_count int)

insert into
	#far_swap_counts(
		source_id,
		far_swap_count)
select
        d.source_id,
	count(*)
from
        trade_notifications a,
        trades b,
        #statuses c,
        #outbound_sources d
where
        a.trade_id = b.trade_id
and
        a.status_id = c.status_id
and
        a.source_id = d.source_id
and
        b.trade_date >= @begin_date
and
        a.capture_date <= d.stale_threshold
and
        c.name="Active"
and
        b.trade_type_id=@swap_far_trade_type
group by
        d.source_id	
	
update
        #outbound_sources
set
        far_leg_count = a.far_swap_count 
from
	#far_swap_counts a,
	#outbound_sources b
where
	a.source_id = b.source_id	

/* debug  
select * from #outbound_sources
*/

create table
        #outbound_counts(
		id int identity, 
		obs_id int,
                queued int
)

insert into
	#outbound_counts
	(obs_id,
	 queued)
select
	d.id,
	count(*)
from
	trade_notifications a,
	trades b,
	#statuses c,
	#outbound_sources d
where
	a.trade_id = b.trade_id
and
	a.status_id = c.status_id
and
	a.source_id = d.source_id
and
	b.trade_date >= @begin_date
and
	a.capture_date <= d.stale_threshold
and 
	c.name="Active"
group by
	d.id	

/* debug 
select * from #outbound_counts
*/
 
create table
	#trade_edits(
		trade_id int,
		edit_date datetime
)

insert into
	#trade_edits
select
	trade_id,
	max(timestamp)
from
	trade_edits
where
	timestamp >= @begin_date
group by
	trade_id

create table
        #outbound_counts_edits(
                id int identity,
                obs_id int,
                queued int
)

insert into 
	#outbound_counts_edits
	(obs_id,
	 queued)
select
	d.id,
	count(*)
from
	trade_notifications a,
	#trade_edits b,
	#statuses c,
	#outbound_sources d
where
	a.trade_id = b.trade_id
and
	a.status_id=c.status_id
and
	a.source_id=d.source_id
and
	b.edit_date <= d.stale_threshold
and
	c.name in ("Edit", "Cancelled")
group by
	d.id	

/* debug
select * from #outbound_counts_edits
*/

update 
	#outbound_counts
set
	a.queued = a.queued + b.queued
from
	#outbound_counts a,
	#outbound_counts_edits b
where
	a.obs_id=b.obs_id

/* debug
select * from #outbound_counts	
*/

/* can track match_notifications in same temp table
 * since the outbound sourcce for match notifications
 * will not be the same as those for trade_notifications
 */

insert into
        #outbound_counts
select
        d.id,
        count(*)
from
        match_notifications a,
        trade_matches b,
        #statuses c,
        #outbound_sources d,
	trades e
where
        a.trade_match_id = b.trade_match_id
and
	b.trade_id = e.trade_id
and
        a.status_id = c.status_id
and
        a.source_id = d.source_id
and
        e.trade_date >= @begin_date
and
        a.capture_date <= d.stale_threshold
group by
        d.id

/* debug
select 
	*,
	@begin_date
from
	#outbound_counts
order by
	id
*/

update 
	#outbound_sources
set
	stale_count = b.queued
from
	#outbound_sources a,
	#outbound_counts b
where
	a.id = b.obs_id

update
	#outbound_sources
set
	stale_count = stale_count - far_leg_count
where
	format_swaps = "N"

/* debug 
select * from #outbound_sources
*/

declare
        source_status_cursor
cursor for
        select
		id
	from
		#outbound_sources
	order by
		id


open source_status_cursor
fetch source_status_cursor into @next_id

while @@sqlstatus = 0
begin
	select
		@source_id = NULL,
		@source = NULL,
		@ops_name = NULL,
		@integration = NULL,
		@org = NULL,
		@queued = NULL,
		@stale_count = NULL,
		@format_swaps = NULL,
                @tags = ""

	select
		@source_id = source_id,
		@source = source_name,
		@ops_name = ops_name,
		@integration = integration,
		@org = org,
		@stale_count = stale_count,
                @format_swaps = format_swaps
	from
		#outbound_sources
	where
		id = @next_id
	
	select
		@tags = "source_name:"+rtrim(@source)
			+",ops_name:"+rtrim(@ops_name)
			+",integration:"+rtrim(@integration)
	
	if @org != NULL
	begin
		select
			@tags = rtrim(@tags)+",org:"+rtrim(@org)
	end

	select
		@queued = convert(varchar(10), @stale_count)

	/* debug
	select
		metric = "stp.outbound",
		value = @queued,
		tags = @tags
	select
		metric = "stp.outbound",
		source=@source,
		ops_name=@ops_name,
		integration=@integration,
		org = @org,
		tags=@tags,
		value=@queued
        */
	
	exec
		sp_dogstatsdguage
			@metric_name = "stp.outbound.stale",
			@value = @queued,
			@tags = @tags
		

	fetch source_status_cursor into @next_id
end

close source_status_cursor
deallocate source_status_cursor

select
	@end_time = getdate()

exec 
	sp_dogstatsdtimer 
		@metric_name="ase.proc.dd_outboundsourcecheck",
		@start_time=@start_time,
		@end_time=@end_time,
		@tags="",
 		@sample_rate="1.0"

select
	status = "OK",
	message = "Outbound source check complete",
	ms=convert(varchar(20), datediff(ms, @start_time, @end_time))	

go

