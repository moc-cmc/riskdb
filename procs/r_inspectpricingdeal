create procedure
	r_inspectpricingdeal
		@login varchar(50),
		@identifier varchar(100)
as

declare @internal_account_id int
declare @deal_id int
declare @id int
declare @ids int
declare @contract_id int
declare @value_date datetime
declare @pmc_id int
declare @instrument varchar(50)
declare @forward_id int
declare @expiration datetime
declare @days float
declare @spot_price float
declare @forward_price float
declare @currency_rate float
declare @product_rate float
declare @now datetime
declare @strike float
declare @vol float
declare @label varchar(50)

