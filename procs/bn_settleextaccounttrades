create or replace procedure
	bn_settleextaccounttrades
		@login varchar(100),
		@external_account varchar(100),
		@trade_date datetime=NULL

as


declare @begin_date datetime
declare @end_date datetime
declare @external_account_id int
declare @tico_account_id int
declare @run_id int
declare @fund_id int
declare @evaluation_currency_id int
declare @mark_to_market char(1)
declare @settled_status_id int
declare @id int
declare @ids int
declare @account_transaction_id int
declare @offset_transaction_id int
declare @trade_count int
declare @processing_time datetime
declare @net_balannce_count int
declare @transaction_date datetime
declare @new_status_id int
declare @transaction_type_id int
declare @net_balance_count int

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
   @client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
   #meta(
           meta_type char(200),
           name char(50) NULL,
           action char(100) NULL,
           value char(200) NULL)
insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)



if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

select
	@mark_to_market = "Y"

exec
	r_daterangefordate 
		@trade_date,
		@begin_date output,
		@end_date output

select
	@begin_date = convert(varchar(8), convert(date, @begin_date), 112) + " 17:00",
	@end_date = convert(varchar(8), convert(date, @end_date), 112) + " 17:00"

select
	@transaction_date = convert(date, @end_date)


select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end



select
	@settled_status_id = status_id
from
	statuses
where
	name = "Settled"
if @settled_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding status of 'Settled' in system"
	return
end

select
        @new_status_id = status_id
from
        statuses
where
        name = "New"
if @new_status_id = NULL
begin
        select
                status = "Error",
                message = "Problem finding status of 'New' in system"
        return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Trade Settlement"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Transaction type not found",
		transaction_type = "Trade Settlement"
	return
end



select
	@external_account_id = a.external_account_id
from
	external_accounts a
where
	a.symbol = @external_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding external account",
		external_account = @external_account
	return
end

select
        @settled_status_id = status_id
from
        statuses
where
        name = "Settled"
if @settled_status_id = NULL
begin
        select
                status = "Error",
                message = "Problem finding status of 'Settled' in system"
        return
end

create table
	#trades(
		trade_id int,
		external_account_id int,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity float NULL,
		counter_quantity float NULL,
                product_id int NULL,
		currency_id int NULL,
		status_id int NULL,
		settled char(1) NULL,
		product_transaction_id int NULL,
		currency_transaction_id int NULL
		)


insert into
	#trades
(
	trade_id,
	external_account_id,
	contract_id,
	quantity,
	counter_quantity,
	status_id,
	settled
)
select 
	trade_id = a.trade_id,
	external_account_id = a.external_account_id,
	contract_id = a.contract_id,
	quantity = a.quantity,
	counter_quantity = a.quantity * price * -1,
	status_id = a.status_id,
	settled = "N"
from
	trades a
where
	a.external_account_id = @external_account_id
and
	a.trade_date <= @end_date
and
	a.value_date = convert(date, @end_date)  /* only trades settling today */
and
	a.quantity != 0
and
	a.status_id != @settled_status_id
select 
	@trade_count = @@rowcount
	


/*
|  Query contracts, dealt ccy, counter ccy
*/
update 
	#trades
set
	std_contract = b.symbol,
	product_id = g.product_id,
        traded_ccy = g.symbol,
	currency_id = f.product_id,
        counter_ccy = f.symbol
from
	#trades a,
	contracts b,
	forwards e,
	products f,
	products g
where
	a.contract_id = b.contract_id
and
	b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#trades
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy)
from
	#trades a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"


create table
	#product_positions(
		id int identity,
		external_account_id int,
		product_id int,
		quantity float NULL
)

insert into
	#product_positions(
		external_account_id,
		product_id,
		quantity)
select
        external_account_id,
	product_id,
	quantity = sum(quantity)
from
	#trades
group by
        external_account_id,
	product_id


insert into
        #product_positions(
		external_account_id,
		product_id,
		quantity)
select
        external_account_id,
	currency_id,
        quantity = sum(counter_quantity)
from
        #trades
group by
        external_account_id,
	currency_id




/* net product_positions by products and currencies */

create table
        #net_product_positions(
                id int identity,
                external_account_id int,
                product_id int,
                quantity float NULL,
		account_transaction_id int NULL,
		offset_transaction_id int NULL
)
insert into
	#net_product_positions(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id, 
	product_id,
	sum(quantity)
from
	#product_positions
group by
	external_account_id,
	product_id
select
	@net_balance_count = @@rowcount

/* WE MAY WANT TO USE EXTERNAL_ACCOUNT_DIRECTIONS FOR THIS INSTEAD 
update
	#net_product_positions
set
	quantity = quantity * -1
*/



/* allocate account_transaction_ids for the net positions */

select
	@id = 0
select
	@ids = count(*)
from
	#net_product_positions
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#net_product_positions
	where
		id > @id

	select
		@account_transaction_id = NULL,
		@offset_transaction_id = NULL


	exec
		j_nextkey
			"account_transactions",
			@account_transaction_id output

	/* NOT WORRYING ABOUT OFFSETTING TRANSACTIONS FOR SETTLEMENTS SINCE NO SPREAD 
	exec
		j_nextkey
			"account_transactions",
			@offset_transaction_id output
	*/

	update
		#net_product_positions
	set
		account_transaction_id = @account_transaction_id /*,
		offset_transaction_id = @offset_transaction_id    */
	where
		id = @id
		
	select
		@ids = count(*)
	from
		#net_product_positions
	where
		id > @id
end



/* flag trades with allocated account transaction ids  -- should be 2 per trade */

update 
	#trades
set
	a.product_transaction_id = b.account_transaction_id
from
	#trades a,
	#net_product_positions b
where
	a.product_id = b.product_id

update 
        #trades
set
        a.currency_transaction_id = b.account_transaction_id
from
        #trades a,
        #net_product_positions b
where
        a.currency_id = b.product_id


select
	@processing_time = getdate()

begin tran

	/* insert pending_transactions to client account 
	insert into
		pending_transactions(
			account_transaction_id,
			entered_by,
			external_account_id,
			transaction_type_id,
			transaction_date,
			currency_id,
			amount,
			create_date,
			status_id,
			ledger_request_id,
			note)
	select
		account_transaction_id,
		@tico_account_id,
		external_account_id,
		@transaction_type_id,
		@transaction_date,
		product_id,
		quantity,
		getdate(),
		@new_status_id,
		NULL,
		NULL
	from
		#net_product_positions
	*/

        insert into
                account_transactions(
                        account_transaction_id,
                        entered_by,
                        external_account_id,
                        transaction_type_id,
                        transaction_date,
                        currency_id,
                        amount,
                        note)
        select
                account_transaction_id,
                @tico_account_id,
                external_account_id,
                @transaction_type_id,
                @transaction_date,
                product_id,
                quantity,
                NULL
        from
                #net_product_positions
	if @@rowcount != @net_balance_count
	begin 
		select
			status = "Error",
			messsage = "Problem saving down transactions"
		rollback tran
		return
	end


	/* insert offset_account_transactions 
           NOT WORRYING ABOUT OFFSETTING TRANSACTIONS FOR SETTLEMENTS SINCE NO SPREAD
	begin
		select
			status = "Error",
			message = "Problem saving down offset transactions for settlements"
		rollback tran
		return
	end
	*/

	/* insert into settle_transaction_trades for product*/
	insert into
		settle_transaction_trades(
			trade_id,
			product_transaction_id,
			currency_transaction_id,
			settled_at)
	select
		trade_id,
		product_transaction_id,
		currency_transaction_id,
		@processing_time
	from
		#trades
	if @@rowcount != @trade_count
	begin
		select
			status = "Error",
			message = "Problem inserting settle transaction trade and processing time"
		rollback tran
		return
	end

	/* update trades status to settled = "N" */
	update
		trades
	set
		a.status_id = @settled_status_id
	from
		trades a,
		#trades b
	where
		a.trade_id = b.trade_id
	if @@rowcount != @trade_count
	begin
		select
			status = "Error",
			message = "Problem flagging trade status as settled for all trades"
		rollback tran
		return
	end
commit tran

select * from #meta
if @trade_count = 0 and @net_balance_count = 0
begin
	select
		section = "Processed Settlement",
		status = "No Action",
		message= "No trades to settle for account",
		external_account = @external_account,
		trade_date = @trade_date,
		settled_trades = @trade_count,
		ledger_bookings = @net_balance_count,
		style = @style
end
else
begin
	select
		section = "Processed Settlement",
		status = "Success",
		message= "Processe intraday settlement of trades",
		external_account = @external_account,
		trade_date = @trade_date,
		settled_trades = @trade_count,
		ledger_bookings = @net_balance_count,
		style = @style
end


go

	


