use
	risk_rcm
go

drop procedure
	r_processrjomoney
go

create procedure
	r_processrjomoney
		@login varchar(50),
		@trade_date datetime

as

declare @source_id int
declare @fund_id int
declare @external_account_id int
declare @external_accounts int
declare @id int

declare @identifier  varchar(50)
declare @initial_margin  float
declare @total_maint_margin  float
declare @margin_excess  float
declare @begin_balance  float
declare @end_balance  float
declare @option_value  float
declare @cash_activity  float
declare @currency_id  int
declare @futures_value  float

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@source_id = source_id
from
	sources
where
	name = "RJO"
if @@rowcount != 1
begin
	select
		status ="Error",
		message = "RJO source not found"
	return
end


create table
	#output(
		source_id int NULL,
		identifier varchar(50) NULL,
		external_account_id int,
		initial_margin float NULL,
		total_maint_margin float NULL,
		margin_excess float NULL,
		begin_balance float NULL,
		end_balance float NULL,
		option_value float NULL,
		cash_activity float NULL,
		currency_id int NULL,
		futures_value float NULL)

insert into
	#output(
		external_account_id,
		identifier,
		initial_margin,
		total_maint_margin,
		margin_excess,
		begin_balance,
		end_balance,
		option_value,
		futures_value)
select
	external_account_id,
	max(identifier),
	sum(convert(float, mfir) * convert(float, mcvtfb)),
	sum(convert(float, mfmr) * convert(float, mcvtfb)),
	sum(convert(float, mme) * convert(float, mcvtfb)),
	sum(convert(float, mprbal) * convert(float, mcvtfb)),
	sum(convert(float, mbal) * convert(float, mcvtfb)),
	sum((convert(float, mlov) +convert(float, msov)) * convert(float, mcvtfb)),
	sum(convert(float, mote) * convert(float, mcvtfb))
from
	rjo_cash_file
where
	convert(date, trade_date) = convert(date, @trade_date)
group by
	external_account_id
	
update
	#output
set
	source_id = @source_id,
	cash_activity = 0.0,
	currency_id = @currency_id


select
	@external_account_id = 0
select
	@external_accounts = count(*)
from
	#output
where
	external_account_id > @external_account_id

while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		#output
	where
		external_account_id > @external_account_id

	select
		@identifier = NULL,
		@initial_margin = NULL,
		@total_maint_margin = NULL,
		@margin_excess = NULL,
		@begin_balance = NULL,
		@end_balance = NULL,
		@option_value = NULL,
		@cash_activity = NULL,
		@currency_id = NULL,
		@futures_value = NULL

	select
		@identifier = identifier,
		@initial_margin = initial_margin,
		@total_maint_margin = total_maint_margin,
		@margin_excess = margin_excess,
		@begin_balance = begin_balance,
		@end_balance = end_balance,
		@option_value = option_value,
		@cash_activity = cash_activity,
		@currency_id = currency_id,
		@futures_value = futures_value
	from
		#output
	where
		external_account_id = @external_account_id

	update
		external_margin_transactions
	set
		identifier = @identifier,
		initial_margin = @initial_margin,
		total_maint_margin = @total_maint_margin,
		margin_excess = @margin_excess,
		begin_balance = @begin_balance,
		end_balance = @end_balance,
		option_value = @option_value,
		cash_activity = @cash_activity,
		currency_id = @currency_id,
		futures_value = @futures_value
	where
		external_account_id = @external_account_id
	and
		convert(date, trade_date) = convert(date, @trade_date)
	and
		source_id = @source_id
	if @@rowcount = 0
	begin
		select
			@id = NULL
		exec
			j_nextkey
				"external_margin_transactions",
				@id output

		insert into
			external_margin_transactions
		values(
			@id,
			@source_id,
			@identifier,
			@external_account_id,
			@trade_date,
			@initial_margin,
			@total_maint_margin,
			@margin_excess,
			@begin_balance,
			@end_balance,
			@option_value,
			@cash_activity,
			@currency_id,
			@futures_value)

	end

	select
		@external_accounts = count(*)
	from
		#output
	where
		external_account_id > @external_account_id
end


select
	*
from
	external_margin_transactions
where
	convert(date, trade_date) = convert(date, @trade_date)


go
