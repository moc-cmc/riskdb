		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		balance float NULL,
		equiv float NULL,
		close_price float NULL)
insert into
	#non_pl_ledgers(
		account,
		product,
		balance)
select
	c.symbol,
	d.symbol,
	sum(a.amount)
from
	account_transactions a,
	#non_pl_types b,
	external_accounts c,
	products d
where
	a.external_account_id = c.external_account_id
and
