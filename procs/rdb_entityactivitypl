	product_id,
	rate
into
	#end_rates
from
	x_conversion_rates
where
	_login = @login
and
	_as_of_date = @end_date
and
	_product = @evaluation_currency

create table
	#legal_entities(
		id int identity,
		legal_entity_id int,
		name varchar(100))
insert into
	#legal_entities(
		legal_entity_id,
		name)
select
	a.legal_entity_id,
	a.name
from
	legal_entities a,
	legal_entity_tico_accounts b
where
	a.legal_entity_id = b.legal_entity_id
and
	b.tico_account_id = @tico_account_id
order by
	a.name

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @legal_entity_id != NULL
begin
	delete

	from
		#legal_entities
	where
		legal_entity_id != @legal_entity_id
end

create table
	#accts(
		external_account_id int,
		account varchar(50) NULL,
		legal_entity_id int NULL,
		legal_entity varchar(50) NULL,
		strategy_id int NULL,
		strategy varchar(50) NULL
		)
create unique index
	u_a
on
	#accts(
		external_account_id)

insert into
	#accts(
		external_account_id,
		legal_entity_id,
		legal_entity)
select
	a.external_account_id,
	a.legal_entity_id,
	b.name
from
	bo_master_accounts a,
	#legal_entities b
where
	a.legal_entity_id = b.legal_entity_id

insert into
	#accts(
		external_account_id,
		legal_entity_id,
		legal_entity)
select
	a.external_account_id,
	b.legal_entity_id,
	c.name
from
	fo_sub_accounts a,
	bo_master_accounts b,
	#legal_entities c
where
	a.bo_master_account_id = b.bo_master_account_id
and
	b.legal_entity_id = c.legal_entity_id
and
	a.external_account_id not in(
		select
			distinct(external_account_id)
		from
			#accts)


update
	#accts
set
	a.account = b.symbol
from
	#accts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#accts
set
	strategy_id = 0,
	strategy = "Unassigned"

update
	#accts
set
	a.strategy_id = c.strategy_id,
	a.strategy = c.name
from
	#accts a,
	account_strategies b,
	strategies c
where
	a.external_account_id = b.external_account_id
and
	b.strategy_id = c.strategy_id

select  
	external_account_id,
	product_id,
	payments,
	payments_equiv,  
	settlements,
	settlements_equiv,
	forwards,
	forwards_equiv,
	futures,
	futures_equiv,
	total,
	total_equiv 
into    
	#begin    
from	
	x_all_entity_bals
where   
	_login = @login
and	  
	_legal_entity = @legal_entity
and     
	_trade_date = @day1

select  
	external_account_id,
	product_id,
	payments,
	payments_equiv, 
	settlements,
	settlements_equiv,
	forwards,
	forwards_equiv,
	futures,
	futures_equiv,
	total,
	total_equiv
into    
	#end    
from	    
	x_all_entity_bals
where   
	_login = @login
and	     
	_legal_entity = @legal_entity
and     
	_trade_date = @day2


select
	external_account_id,
	contract_id,
	longs,
	avg_long,
	shorts,
	avg_short,
	open_pos,
	avg_open,
	closed_pos,
	product_id,
	currency_id,
	multiplier,
	open_value,
	open_equiv,
	realized_pl,
	unrealized_pl,
	realized_equiv,
	unrealized_equiv,
	last_price
into
	#fut_trades_exp
from
	x_range_fut_bals
where
	_login = @login
and
	_legal_entity = @legal_entity
and
	_from_date = @from_date
