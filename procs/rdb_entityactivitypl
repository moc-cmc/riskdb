	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@deficit_style = "background:#F5F3CE;color:#FF0000;border: 1px solid white",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold", 
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@selected_trade_style = "background:#F7F4C1;border: 1px solid white"

select
	@_from_date = @from_date,
	@_to_date = @to_date

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@settlement_product_id = settlement_product_id
from
	funds
where
	fund_id = @fund_id
if @settlement_product_id = NULL
begin
	select
		status = "Error",
		message = "Settlement product not found"
	return
end

if @from_date = NULL or @from_date = ""
begin
	if @to_date = NULL or @to_date = ""
	begin
		select
			@trade_date = convert(datetime, convert(date, getdate()))

		exec
			r_daterangefordate
				@trade_date,
				@begin_date output,
				@end_date output
	end
	else
	begin
		select
			@to_date = convert(datetime, convert(date, @to_date))
		exec
			r_daterangefordate
				@to_date,
				@begin_date output,
				@end_date output
	end
end

if @to_date = NULL or @to_date = ""
begin
	if @from_date = NULL or @from_date = ""
	begin
		select
			@trade_date = convert(datetime, convert(date, getdate()))
		exec
			r_daterangefordate
				@trade_date,
				@begin_date output,
				@end_date output
	end
	else
	begin
		select
			@from_date = convert(datetime, convert(date, @from_date))

		exec
			r_daterangefordate
				@from_date,
				@begin_date output,
				@end_date output
	end
end

if @begin_date = NULL and @end_date = NULL /* both dates were not null */
begin
	select
		@from_date = convert(datetime, convert(date, @from_date))
	exec
		r_prevbusinessday
			@from_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

	select
		@to_date = convert(datetime, convert(date, @to_date))

	if datename(weekday, @to_date) = "Saturday"
		select
			@to_date = dateadd(day, 2, @to_date)
	if datename(weekday, @to_date) = "Sunday"
		select
			@to_date = dateadd(day, 1, @to_date)

	select
		@end_date = dateadd(hour, 17, @to_date)
end

select
	@day1 = convert(datetime, convert(date, @begin_date)),
	@day2 = convert(datetime, convert(date, @end_date))
	

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end


select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

