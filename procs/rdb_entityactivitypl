create table
	#fut_trades(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		longs float NULL,
		avg_long float NULL,
		shorts float NULL,
		avg_short float NULL,
		currency_id int NULL,
		realized_pl float NULL,
		unrealized_pl float NULL,
		total_pl float NULL,
		equiv_pl float NULL,
		close_price float NULL)
insert into
	#fut_trades(
		style,
		external_account_id,
		account,
		contract_id,
		symbol,
		longs,
		avg_long,
		shorts,
		avg_short,
		currency_id,
		realized_pl,
		unrealized_pl,
		total_pl,
		close_price)
select
	style = @style,
	a.external_account_id,
	b.symbol,
	a.contract_id,
	c.symbol,
	a.longs,
	a.avg_long,
	a.shorts,
	a.avg_short,
	a.currency_id,
	a.realized_pl,
	a.unrealized_pl,
	realized_pl + unrealized_pl,
	a.last_price
from
	#fut_trades_exp a,
	external_accounts b,
	contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
order by
	b.symbol,
	c.symbol

update
	#fut_trades
set
	a.equiv_pl = total_pl * b.rate
from
	#fut_trades a,
	#end_rates b
where
	a.currency_id = b.product_id

select
	@fut_trades = sum(equiv_pl)
from
	#fut_trades
if @fut_trades = NULL
	select
		@fut_trades = 0.0

insert into
	#fut_trades(
		style,
		account,
		equiv_pl)
values(
	@total_style,
	"Total",
	@fut_trades)

/* Spot Fwd Trades during range */
select
	external_account_id,
	product_id,
	balance
into
	#fwd_trades
from
	x_range_trade_bals
where
	_login = @login
and
	_legal_entity = @legal_entity
and
	_from_date = @_from_date
and
	_to_date = @_to_date

create table
	#fwds(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		balance float NULL,
		equiv float NULL,
		close_price float NULL)
insert into
	#fwds(
		style,
		external_account_id,
		account,
		product_id,
		product,
		balance,
		equiv)
select
	style = @style,
	a.external_account_id,
	b.symbol,
	a.product_id,
	c.symbol,
	a.balance,
	equiv = 0.0
from
	#fwd_trades a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id

update
	#fwds
set
	a.equiv = a.balance * b.rate,
	a.close_price =  b.rate
from
	#fwds a,
	#end_rates b
where
	a.product_id = b.product_id

select
	@trades_equiv = sum(equiv)
from
	#fwds
insert into
	#fwds(
		style,
		account,
		equiv)
values(
	@total_style,
	"Total",
	@trades_equiv)

create table
	#fwd_pairs(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		product_qty float NULL,
		product_equiv float NULL,
		currency_id int NULL,
		currency varchar(50) NULL,
		currency_qty float NULL,
		currency_equiv float NULL,
		market_rate float NULL,
		equiv float NULL)
		
insert into
	#fwd_pairs(
		account,
		symbol,
		product_qty,
		currency_qty)
select
	d.symbol,
	b.symbol,
	sum(a.quantity),
	sum(a.quantity * a.price * -1.0)
from
	trades a,
	contracts b,
	forwards c,
	external_accounts d
where
	a.external_account_id = d.external_account_id
and
	a.contract_id = b.contract_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
group by
	d.symbol,
	b.symbol
order by
	d.symbol,
	b.symbol

update
	#fwd_pairs
set
	a.external_account_id = b.external_account_id
from
	#fwd_pairs a,
	external_accounts b
where
	a.account = b.symbol

update
	#fwd_pairs
set
	a.contract_id = b.contract_id
from
	#fwd_pairs a,
	contracts b
where
	a.symbol = b.symbol

update
	#fwd_pairs
set
	a.product_id = b.product_id,
	a.product = c.symbol,
	a.currency_id = b.currency_id,
	a.currency = d.symbol
from
	#fwd_pairs a,
	forwards b,
	products c,
	products d
where
	a.contract_id = b.contract_id
and
	b.product_id = c.product_id
and
	b.currency_id = d.product_id

update
	#fwd_pairs
set
	a.product_equiv = a.product_qty * b.rate
from
	#fwd_pairs a,
	#end_rates b
where
	a.product_id = b.product_id

update
	#fwd_pairs
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#fwd_pairs a,
	#end_rates b
where
	a.currency_id = b.product_id

update
	#fwd_pairs
set
	style = @style,
	equiv = product_equiv + currency_equiv /* MARKR */


update
	#fwd_pairs
set
	a.market_rate = b.price
from
	#fwd_pairs a,
	prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @end_date)

if @end_date > getdate()
	update
		#fwd_pairs
	set
		a.market_rate = b.price
	from
		#fwd_pairs a,
		current_prices b
	where
		a.contract_id = b.contract_id


select
	@pair_equiv = sum(equiv)
from
	#fwd_pairs

insert into
	#fwd_pairs(
		style,
		account,
		equiv)
values(
	@total_style,
	"Total",
	@pair_equiv)







