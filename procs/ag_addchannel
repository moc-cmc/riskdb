drop procedure
	ag_addchannel
go

create procedure
	ag_addchannel
		@login varchar(50),
		@name varchar(100)
as


declare @channel_id int
declare @activity_status_id int


select
	@channel_id = channel_id
from
	channels
where
	name = @name
if @channel_id != NULL
begin
	select
		status = "Error",
		message = "Channel name already exists",
		name = @name
	return
end

select
	@activity_status_id = activity_status_id
from
	activity_statuses
where
	name = "Inactive"
if @activity_status_id = NULL
begin
	select
		status = "Error",
		message = "Activity status not found",
		activity_status = "Inactive"
	return
end

exec
	j_nextkey
		"channels",
		@channel_id output

insert into
	channels(
		channel_id,
		name,
		activity_status_id)
values(
	@channel_id,
	@name,
	@activity_status_id)

exec
	ag_messageshome
		@login = @login,
		@channel = @name


go
