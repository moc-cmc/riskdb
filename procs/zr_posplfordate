
if object_id("zr_posplfordate") != NULL
    drop procedure
        zr_posplfordate
go

create procedure
	zr_posplfordate
		@pl_type char(100),
		@contract_id int,
		@value_date datetime,
		@quantity numeric(30,2),
		@begin_date datetime,
		@end_date datetime,
		@open_price float output,
		@begin_value float output,
		@close_price float output,
		@end_value float output,
		@p_l float output,
		@native_currency_id int output,
		@native_pl float output
		
as

declare @instrument char(100)
declare @is_committable int


select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @contract_id


if @instrument = "Forward"
begin
	exec
		zr_forwardposplfordate
			@contract_id,
			@value_date,
			@quantity,
			@begin_date,
			@end_date,
			@open_price output,
			@begin_value output,
			@close_price output,
			@end_value output,
			@native_pl output


end
	
if @instrument = "Future"
	exec
		d_futureposplfordate
			@contract_id,
			@quantity,
			@begin_date,
			@end_date,
			@open_price output,
			@begin_value output,
			@close_price output,
			@end_value output,
			@native_pl output
	
if @instrument = "Option"
	exec
		r_optionposplfordate
			@contract_id,
			@quantity,
			@begin_date,
			@end_date,
			@open_price output,
			@begin_value output,
			@close_price output,
			@end_value output,
			@native_pl output

if @instrument = "Exotic"
	exec
		r_exoticposplfordate
			@contract_id,
			@quantity,
			@begin_date,
			@end_date,
			@open_price output,
			@begin_value output,
			@close_price output,
			@end_value output,
			@native_pl output

exec
	r_dollarvalue
		@native_pl,
		@contract_id,
		@end_date,
		@p_l output,
		@native_currency_id output 

go
