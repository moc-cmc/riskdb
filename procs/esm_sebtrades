use
	risk_seb
go

drop procedure
	esm_sebtrades
go

create procedure
	esm_sebtrades
		@trade_date datetime=NULL,
		@trade_id int=NULL
as

declare @timestamp datetime
declare @begin_date datetime
declare @end_date datetime
declare @last_reported_trade_id int

if @trade_id = NULL
	select
		@trade_id = 0

if @trade_date = NULL
begin
	select
		@timestamp = getdate()

end
else
begin
	select
		@timestamp = @trade_date

	select
		@last_reported_trade_id = max(trade_id)
	from
		reported_esm_trades
end

if @last_reported_trade_id = NULL
	select
		@last_reported_trade_id = 0

exec
	r_daterangefordate
		@timestamp,
		@begin_date output,
		@end_date output

if @trade_date = NULL
	select
		@trade_date = @begin_date


create table
	#output(
		trade_action varchar(20),
		trade_id int,
		contract_id int,
		quantity numeric(30,4),
		price float,
		trade_date datetime)

insert into
	#output
select
	trade_action = "Received",
	a.trade_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.trade_date
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.trade_date > @begin_date
and
	a.trade_date < @end_date
and
	trade_id > @trade_id


insert into
	#output
select
	trade_action = "Received",
	a.trade_id,
	d.underlying_contract_id,
	a.quantity,
	price = 0.0,
	a.trade_date	
from
	trades a,
	option_contracts b,
	option_expirations c,
	options d
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	a.trade_date > @begin_date
and
	a.trade_date < @end_date
and
	a.trade_id > @trade_id


update
	#output
set
	a.price = b.price
from
	#output a,
	current_prices b
where
	a.contract_id = b.contract_id
and
	a.price = 0.0
	

insert into
	reported_esm_trades
select
	trade_id
from
	#output

select
	a.trade_action,
	a.trade_id,
	b.symbol,
	a.quantity,
	a.price,
	a.trade_date
from
	#output a,
	contracts b
where
	a.contract_id = b.contract_id



go
