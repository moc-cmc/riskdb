drop procedure
	ag_toggleacctproducts
go

create procedure
	ag_toggleacctproducts
		@login varchar(50),
		@prime_broker varchar(50),
		@account varchar(50),
		@product varchar(50)
as

declare @product_id int
declare @external_account_id int

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

delete

from
	acct_deliverable_products
where
	external_account_id = @external_account_id
and
	product_id = @product_id
if @@rowcount = 0
begin
	insert into
		acct_deliverable_products(
				external_account_id,
				product_id)
	values(
		@external_account_id,
		@product_id)
end

exec
	ag_extaccountproducts
		@login = @login,
		@prime_broker = @prime_broker

go
