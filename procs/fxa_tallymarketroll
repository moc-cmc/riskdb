drop procedure
	fxa_tallymarketroll
go

create procedure
	fxa_tallymarketroll
		@login varchar(50),
		@trade_date datetime=NULL,
		@buy_sell varchar(50),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@near_date datetime,
		@near_price float,
		@far_date datetime,
		@far_price float,
		@inspect_deal char(1)=NULL,
		@identifier varchar(100)=NULL
as

declare @deal_id int
declare @roll_tico_account_id int
declare @external_account_id int
declare @fund_id int
declare @roll_trader_id int
declare @trader varchar(50)
declare @symbol varchar(50)
declare @contract_id int
declare @trade_day varchar(8)
declare @now datetime
select
	@now = getdate()

/*
| Set trading day to EST 17:00-17:00 market standard
A*/
select
	@trade_day = case
		when @now > convert(char(8), @now, 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), @now, 112))
		else
			convert(char(12), @now, 112)
	end

if @trade_date = NULL
begin

	select
		@trade_date = convert(datetime, @trade_day)
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

if @trade_date = NULL
begin
	select
		status = "Error",
		message = "No trade date specified"
	return
end

select
	@roll_trader_id = roll_trader_id
from
	fund_roll_traders
where
	fund_id = @fund_id

select
	@trader = symbol
from
	traders
where
	trader_id = @roll_trader_id
if @trader = NULL
begin
	select
		status = "Error",
		message = "Roll trader not found"
	return
end


exec 
	api_tallymarketswap
		@login = @login,
		@buy_sell = @buy_sell,
		@trader = @trader,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@dealt_currency = @dealt_currency,
		@counter_currency = @counter_currency,
		@near_date = @near_date,
		@near_price = @near_price,
		@far_date = @far_date,
		@far_price = @far_price,
		@trade_date = @trade_date,
		@deal_id = @deal_id output,
		@identifier = @identifier

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol

select
	@roll_tico_account_id = tico_account_id
from
	traders
where
	trader_id = @roll_trader_id

select
	@external_account_id = a.external_account_id
from
	default_tally_accounts a,
	tally_types b
where
	a.tally_type_id = b.tally_type_id
and
	b.name = "Swap"
and
	a.tico_account_id = @roll_tico_account_id

update
	ext_account_biproduct_rates
set
	closing_rate = @near_price,
	roll_date = @far_date,
	roll_rate = @far_price
where
	external_account_id = @external_account_id
and
	contract_id = @contract_id
and
	closing_date = @near_date
if @@rowcount != 1
begin
	insert into
		ext_account_biproduct_rates(
			external_account_id,
			contract_id,
			closing_date,
			closing_rate,
			roll_date,
			roll_rate,
			trade_date)
	values(
		@external_account_id,
		@contract_id,
		@near_date,
		@near_price,
		@far_date,
		@far_price,
		@trade_date)
end

exec
	r_setextacctrollrates
		@login,
		@symbol,
		@near_date,
		@near_price,
		@far_date,
		@far_price,
		@trade_date


begin tran
	update
		trades
	set
		trader_id = @roll_trader_id
	where
		deal_id = @deal_id
	if @@rowcount != 2
		rollback tran
commit tran

if @inspect_deal != "N"
begin
	exec
		r_inspectdealtrades
			@login,
			@deal_id
end

go
