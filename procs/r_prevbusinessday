
if object_id("r_prevbusinessday") != NULL
    drop procedure
        r_prevbusinessday
go
 
create procedure
	r_prevbusinessday
		@a_date datetime,
		@next_date datetime output
as

declare @weekday int

select @next_date = dateadd(day, -1, @a_date)

while @next_date < @a_date
begin
	select
		@weekday = datepart(weekday, @next_date)
	if @weekday != 1 AND @weekday != 7
		break
	else
		select
			@next_date = dateadd(day, -1, @next_date)
end

return

go
