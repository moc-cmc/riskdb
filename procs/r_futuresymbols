
if object_id("r_futuresymbols") != NULL
    drop procedure
        r_futuresymbols
go

create procedure
	r_futuresymbols
as
select
        symbol = a.symbol
from
        contracts a,
        future_contracts b,
        futures c,
        future_types d
where
        a.contract_id = b.contract_id
and
        b.future_id = c.future_id
and
        c.future_type_id = d.future_type_id
and
        b.expiration > dateadd(day, -1, getdate())
and
        d.name = "Regular"
order by
        a.symbol


go
