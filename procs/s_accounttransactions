
if object_id("s_accounttransactions") != NULL
    drop procedure
        s_accounttransactions
go

create procedure
	s_accounttransactions
		@external_account char(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @external_account_id int
declare @total_balance float
declare @datestring char(25)

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Format Number",
	"amount",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"total",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Column Link",
	"ytd",
	"YTD Account Transactions",
	"suppressAutoexecute=YES",
	NULL)

insert into
	#links
values(
	"Column Link",
	"mtd",
	"MTD Account Transactions",
	"suppressAutoexecute=YES",
	NULL)

insert into
	#links
values(
	"Column Link",
	"assign",
	"Assign Premium To Trade",
	"suppressAutoexecute=YES",
	NULL)


insert into
	#links
values(
	"Column Link",
	"trade_id",
	"Deal Inspector For Trade",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"edit",
	"Edit Account Transaction",
	"suppressAutoexecute=YES",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

create table
	#account_transactions(
		transaction_id int,
		entered_by char(50),
		account char(30),
		transaction_type char(30),
		transaction_date char(30),
		amount char(30),
		note char(255) NULL,
		trade_id int NULL,
		edit char(10),
		assign char(20) NULL)

if @begin_date = NULL
begin
	select
		@datestring = convert(char(2), datepart(month, getdate())) + "/" + "01" + "/" + convert(char(4), datepart(year, getdate()))
	select
		@begin_date = convert(datetime, @datestring)
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding account with symbol",
		account = @external_account
	return
end

if @end_date = NULL or @end_date = ""
begin
	select
		@end_date = max(transaction_date)
	from
		account_transactions
	where
		external_account_id = @external_account_id
	if @@rowcount = 0
		select
			@end_date = "12/31/2020"
end

select
	@datestring = convert(char(11), @end_date, 1) + " 23:59:59"

select
	@end_date = convert(datetime, @datestring)

select
	@total_balance = sum(a.amount)
from
	account_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d
where
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date
and
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	c.external_account_id = @external_account_id


select
	external_account = @external_account,
	begin_date = @begin_date,
	end_date = @end_date,
	mtd = "MTD",
	ytd = "YTD"

/* select
	balance = convert(char(30), convert(numeric(30,2), @total_balance)) */

insert into
	#account_transactions
select
	transaction_id = a.account_transaction_id,
	entered_by = b.login,
	account = c.symbol,
	transaction_type = d.name,
	transaction_date = convert(char(25), a.transaction_date, 0),
	amount = convert(char(30), convert(numeric(30,2), a.amount)),
	a.note,
	e.trade_id,
	edit = "EDIT",
	NULL
from
	account_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d,
	account_transaction_trades e
where
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date
and
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	c.external_account_id = @external_account_id
and
	a.account_transaction_id *= e.account_transaction_id
order by
	convert(datetime, transaction_date)

update
	#account_transactions
set
	assign = "ASSIGN TRADE"
where
	trade_id = NULL
and
	transaction_type = "Option Premium"


select
	transaction_id,
	entered_by,
	account,
	transaction_type,
	settle_date = transaction_date,
	amount,
	note,
	trade_id,
	edit,
	assign
from
	#account_transactions
order by
	convert(datetime, transaction_date)

create table
	#summary(
		transaction_type char(50),
		total float NULL)
insert into
	#summary
select
	transaction_type = min(transaction_type),
	total = sum(convert(float, amount))
from
	#account_transactions
group by
	transaction_type
	
insert into
	#summary
values(
	"<b><font size=2>Total</font></b>",
	@total_balance)
--Adaptive Server has expanded all '*' elements in the following statement


select #summary.transaction_type, #summary.total from #summary

go
