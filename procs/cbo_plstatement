
if object_id("cbo_plstatement") != NULL
    drop procedure
        cbo_plstatement
go

create procedure
	cbo_plstatement
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @total_pl float

exec
	cbo_runpl
		@login,
		@run_name,
		@begin_date,
		@end_date,
		@total_pl output,
		"y"



go
