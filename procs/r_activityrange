create procedure
	r_activity
		@login varchar(50),
		@trade_date datetime=NULL/*,
		@run_name varchar(50)=NULL*/

as

declare @begin_date datetime
declare @end_date datetime
declare @last_commit_date datetime
declare @cl_total_attrib_pl float
declare @lp_total_attrib_pl float
declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @total_pl float
declare @total_volume float
declare @total_trade_count int
declare @total_avg_size float
declare @total_mm_pl float
declare @fund_name varchar(50)
declare @using_ticking_price char(1)



create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


insert into
	#meta
values(
	"Column Format",
	"volume",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
        #meta
values(
        "Column Format",
        "pl",
        "Number",
         "<span style=""color:blue"">#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
        #meta
values(
        "Column Format",
        "mm_pl",
        "Number",
         "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
        #meta
values(
        "Column Format",
        "avg_size",
        "Number",
         "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")



select * from #meta


select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	/*@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",*/
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


/* Find the last commit that is done*/
select
       @last_commit_date = max(commit_date)
from
       daily_commits a,
       commit_statuses b
where
       a.commit_status_id = b.commit_status_id
and
       b.name in("Commit Complete")
if @last_commit_date = NULL
begin
	select
		@last_commit_date = "January 01, 1970"
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

select
	@trade_date = convert(date, @trade_date)
exec
	r_daterangefordate 
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#trades
(
	trade_id int,
	deal_id int,
	trade_type_id int,
 	external_account_id int,
	counterparty_id int,
	contract_id int,
	trader_id int,
	strategy_id int,
	broker_id int,
	sales_code_id int,
	pb_id int NULL,
	qty numeric(30, 4),
	counter_qty numeric(30, 4),
	product_id int NULL,
	currency_id int NULL,
	pd1_eq numeric(30, 4) NULL,
	pd2_eq numeric(30, 4) NULL,
	mtm_pl numeric(30, 4) NULL,
	cl_vo numeric(30, 4) NULL,
	lp_vo numeric(30, 4) NULL,
	vo numeric(30, 4) NULL
)

insert into
	#trades(
		trade_id,
		deal_id,
		trade_type_id,
		external_account_id,
		counterparty_id,
		contract_id,
		trader_id,
		strategy_id,
		broker_id,
		sales_code_id,
		qty,
		counter_qty)
select
	trade_id,
	deal_id,
	trade_type_id,
	external_account_id,
	counterparty_id,
	contract_id,
	trader_id,
	strategy_id,
	broker_id,
	sales_code_id,
	quantity,
	quantity * price * -1
from
	trades
where
	trade_date >= @begin_date
and
	trade_date < @end_date

create nonclustered index u_did on #trades(deal_id)
create nonclustered index u_cid on #trades(counterparty_id)
create nonclustered index u_eid on #trades(external_account_id)


update
	#trades
set
	product_id = b.product_id,
	currency_id = b.currency_id
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

update 
	#trades
set
	pb_id = prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id


/* The only conversion rates that matter are those of the evaluation ccys, so only get those */
create table
        #eval_ccys(
                product_id int,
                symbol varchar(10) NULL
)
insert into
        #eval_ccys(
                product_id)
select
        distinct(evaluation_currency_id)
from
        funds

update
        #eval_ccys
set
        symbol = a.symbol
from
        products a,
        #eval_ccys b
where
        a.product_id = b.product_id

create table
	#traded_products(
		product_id int
)

insert into
	#traded_products
select
	distinct(product_id)
from
	#trades

insert into 
	#traded_products
select
	distinct(currency_id)
from
	#trades
where
	currency_id not in(select product_id from #traded_products)

create table
	#conversion_contracts
(
	contract_id int NULL,
	product_id int,
	currency_id int,
	inverse_contract_id int NULL,
	standard_price float NULL,
	conversion_price float NULL
)


insert into 
	#conversion_contracts(
		contract_id,
		product_id,
		currency_id
	)
select
	a.contract_id,
	a.product_id,
	a.currency_id
from
	forwards a,
	#traded_products b,
	#eval_ccys c
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id

update
	#conversion_contracts
set
	inverse_contract_id = a.contract_id
from
	forwards a,
	#conversion_contracts b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id


/* bo_spot_settles should never contain a price for an inverted contract */
if @trade_date > @last_commit_date /* use front office prices */
begin
	select
		@using_ticking_price = "Y"

	/* create temp table of current prices so price ticks dont affect conversion rates */
	create table
		#current_prices(
			contract_id int,
			price float
	)
	insert into
		#current_prices
	select
		contract_id,
		price
	from
		current_prices
	
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		#current_prices a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	#current_prices a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
		b.standard_price = NULL
end
else /* use back office prices */
begin
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		bo_spot_settles a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	and
		convert(date, a.price_date) = convert(date, @trade_date)
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	bo_spot_settles a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
        	convert(date, a.price_date) = convert(date, @trade_date)
	and
		b.standard_price = NULL
end
insert into
	#conversion_contracts
(
	product_id,
	currency_id,
	conversion_price
)
select
	product_id,
	product_id,
	1.0
from
	#eval_ccys

/* Check if any conversion rates are missing, select error section using @error_style row and return */
/* not yet implemented */

/* debug 
select * from #traded_products
select * from #conversion_contracts
*/

update 
	#trades
set
	pd1_eq = qty * conversion_price
from
	#trades a,
	#conversion_contracts b
where
	a.product_id = b.product_id

update
        #trades
set
        pd2_eq = counter_qty * conversion_price
from
        #trades a,
        #conversion_contracts b
where
        a.currency_id = b.product_id

update
	#trades
set
	vo = abs(pd1_eq)

update 
	#trades
set
	cl_vo = vo
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id

update 
        #trades
set
        lp_vo = vo
from
        #trades a
where
        cl_vo = NULL

update
	#trades
set
	mtm_pl = pd1_eq + pd2_eq


select 
	@total_pl = sum(mtm_pl),
	@total_volume = sum(vo) / 1000000,
	@total_trade_count = count(*)
from
	#trades

select
	@total_avg_size = @total_volume / @total_trade_count,
	@total_mm_pl = @total_pl / @total_volume

select
	@fund_name = name
from
	funds

		

create table
	#deals(
		deal_id int,
		tc int NULL,
		total_pl float NULL,
		total_vo float NULL,
		total_cl_vo float NULL,
		total_lp_vo float NULL
)

insert into
	#deals(	
		deal_id,
		tc,
		total_pl,
		total_vo,
		total_cl_vo,
		total_lp_vo
)
select
	deal_id,
	count(*),
	sum(mtm_pl),
	sum(vo),
	sum(cl_vo),
	sum(lp_vo)
from
	#trades
group by
	deal_id

/* debug
select * from #deals
*/
	

create table
	#deal_cl_attrib(
		deal_id int,
		external_account_id int,
		vo float NULL,
		cl_vo float NULL,
		lp_vo float NULL,
		pl float NULL
)

insert into
	#deal_cl_attrib(
		deal_id,
		external_account_id,
		vo,
		cl_vo,
		lp_vo)
select
	deal_id,
	external_account_id,
	sum(abs(pd1_eq)),
	sum(cl_vo),
	sum(lp_vo)
from
	#trades
group by
	deal_id,
	external_account_id

update
	#deal_cl_attrib
set
	pl = a.total_pl * (b.cl_vo / a.total_cl_vo)
from
	#deals a,
	#deal_cl_attrib b
where
	a.deal_id = b.deal_id


create table
        #deal_lp_attrib(
                deal_id int,
                counterparty_id int,
                vo float NULL,
		cl_vo float NULL,
		lp_vo float NULL,
		pl float NULL
)

insert into
        #deal_lp_attrib(
                deal_id,
                counterparty_id,
                vo,
		cl_vo,
		lp_vo)
select
        deal_id,
        counterparty_id,
	sum(abs(pd1_eq)),
	sum(cl_vo),
        sum(lp_vo)
from
        #trades
group by
        deal_id,
        counterparty_id

update
        #deal_lp_attrib
set
        pl = a.total_pl * (b.lp_vo / a.total_lp_vo)
from    
        #deals a,
        #deal_lp_attrib b
where
        a.deal_id = b.deal_id

/* debug
select * from #deal_cl_attrib order by deal_id
select * from #deal_lp_attrib order by deal_id
*/

create table
	#cl_attrib(
		ordering float NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		trade_count int NULL,
		avg_size float NULL,
		volume float NULL,
		pl float NULL,
		mm_pl float NULL,
		style varchar(100) NULL
)

create table
        #lp_attrib(
		ordering float NULL,
                counterparty_id int NULL,
                counterparty varchar(50) NULL,
                trade_count int NULL,
                avg_size float NULL,
                volume float NULL,
                pl float NULL,
                mm_pl float NULL,
		style varchar(100) NULL
)

/* Get client totals from deal/ext acct totals */
insert into
	#cl_attrib(
		ordering,
		external_account_id,
		trade_count,
		volume,
		pl,
		style)
select
	1, /* ordering, non total */
	external_account_id,
	count(*),
	sum(vo) /1000000.0 ,
	sum(pl),
	@style
from
	#deal_cl_attrib
group by
	external_account_id
	



update
	#cl_attrib
set
	avg_size = volume / trade_count,
	mm_pl = pl / volume

update 
	#cl_attrib
set
	ordering = 1.5 /* cpty ext accts, no pl */
where
	pl = NULL

update
	#cl_attrib
set
	account = b.symbol
from
	#cl_attrib a, 
	external_accounts b
where
	a.external_account_id = b.external_account_id


/* Get counterparty totals from deal/cpty totals */
insert into
	#lp_attrib(
		ordering,
		counterparty_id,
		trade_count,
		volume,
		pl,
		style)
select
	1, /* ordering, non total */
	counterparty_id,
	count(*),
	sum(vo) / 1000000.0 ,
	sum(pl),
	@style
from
	#deal_lp_attrib
group by
	counterparty_id

update
	#lp_attrib
set
	avg_size = volume / trade_count,
	mm_pl = pl / volume

update 
	#lp_attrib
set
	ordering = 1.5 /* cpty ext accts, no pl */
where
	pl = NULL

update
	#lp_attrib
set
	counterparty = b.name
from
	#lp_attrib a, 
	counterparties b
where
	a.counterparty_id = b.counterparty_id

	
/* Calc and add unattributed and totals */
select
	@cl_total_attrib_pl = sum(pl)
from
	#cl_attrib

select
	@lp_total_attrib_pl = sum(pl)
from
	#lp_attrib


insert into
	#cl_attrib(
		ordering,
		account,
		pl,
		style)
select
	2, /* ordering, unattributed*/
	"Unattributed",
	@total_pl - @cl_total_attrib_pl,
	@subtotal_style


insert into
        #lp_attrib(
                ordering,
                counterparty,
                pl,
                style)
select
        2, /* ordering, unattributed*/
        "Unattributed",
        @total_pl - @lp_total_attrib_pl,
        @subtotal_style



/* Totals */
insert into
	#cl_attrib(
		ordering,
		account,
		trade_count,
		avg_size,
		volume,
		pl,
		mm_pl,
		style)
select
	3, /* ordering, total*/
	"Total",
	@total_trade_count,
	@total_avg_size,
	@total_volume,
	@total_pl,
	@total_mm_pl,
	@total_style

insert into
	#lp_attrib(
		ordering,
		counterparty,
		trade_count,
		avg_size,
		volume,
		pl,
		mm_pl,
		style)
select
	3, /* ordering, total*/
	"Total",
	@total_trade_count,
	@total_avg_size,
	@total_volume,
	@total_pl,
	@total_mm_pl,
	@total_style


/* Breakdown - no attribution */

create table
        #br_breakdown(
                ordering int NULL,
                broker_id int NULL,
                platform varchar(50) NULL,
                trade_count int NULL,
                avg_size float NULL,
                volume float NULL,
                pl float NULL,
                mm_pl float NULL,
                style varchar(100) NULL
)

create table
        #pb_breakdown(
                ordering int NULL,
                prime_broker_id int NULL,
                prime_broker varchar(50) NULL,
                trade_count int NULL,
                avg_size float NULL,
                volume float NULL,
                pl float NULL,
                mm_pl float NULL,
                style varchar(100) NULL
)

create table
        #ct_breakdown(
                ordering int NULL,
                contract_id int NULL,
                contract varchar(50) NULL,
                trade_count int NULL,
                avg_size float NULL,
                volume float NULL,
                pl float NULL,
                mm_pl float NULL,
                style varchar(100) NULL
)

insert into
        #br_breakdown(
                ordering,
                broker_id,
                trade_count,
                volume,
                pl,
                style)
select
        1, /* ordering, non total */
        broker_id,
        count(*),
        sum(vo) / 1000000,
        sum(mtm_pl),
        @style
from
        #trades
group by
        broker_id

update 
	#br_breakdown
set
        avg_size = volume / trade_count,
        mm_pl = pl / volume

update
        #br_breakdown
set
        platform = b.symbol
from
        #br_breakdown a,
        brokers b
where
        a.broker_id = b.broker_id


insert into
        #pb_breakdown(
                ordering,
                prime_broker_id,
                trade_count,
                volume,
                pl,
                style)
select
        1, /* ordering, non total */
        pb_id,
        count(*),
        sum(vo) / 1000000,
        sum(mtm_pl),
        @style
from
        #trades
group by
        pb_id

update
        #pb_breakdown
set
        avg_size = volume / trade_count,
        mm_pl = pl / volume

update
        #pb_breakdown
set
        prime_broker = b.name
from
        #pb_breakdown a,
        sources b,
	prime_brokers c
where
        a.prime_broker_id = c.prime_broker_id
and
	b.source_id = c.source_id


insert into
        #ct_breakdown(
                ordering,
                contract_id,
                trade_count,
                volume,
                pl,
                style)
select
        1, /* ordering, non total */
        contract_id,
        count(*),
        sum(vo) / 1000000,
        sum(mtm_pl),
        @style
from
        #trades
group by
        contract_id

update
        #ct_breakdown
set
        avg_size = volume / trade_count,
        mm_pl = pl / volume

update
        #ct_breakdown
set
        contract = b.symbol
from
        #ct_breakdown a,
        contracts b
where
        a.contract_id = b.contract_id



/* Totals */
insert into
        #br_breakdown(
                ordering,
                platform,
                trade_count,
                avg_size,
                volume,
                pl,
                mm_pl,
                style)
select
        3, /* ordering, total*/
        "Total",
        @total_trade_count,
        @total_avg_size,
        @total_volume,
        @total_pl,
        @total_mm_pl,
        @total_style

/* Totals */
insert into
        #pb_breakdown(
                ordering,
                prime_broker,
                trade_count,
                avg_size,
                volume,
                pl,
                mm_pl,
                style)
select
        3, /* ordering, total*/
        "Total",
        @total_trade_count,
        @total_avg_size,
        @total_volume,
        @total_pl,
        @total_mm_pl,
        @total_style

insert into
        #ct_breakdown(
                ordering,
                contract,
                trade_count,
                avg_size,
                volume,
                pl,
                mm_pl,
                style)
select
        3, /* ordering, total*/
        "Total",
        @total_trade_count,
        @total_avg_size,
        @total_volume,
        @total_pl,
        @total_mm_pl,
        @total_style





/*
 * ----------------------------- 
 *           Output 
 * -----------------------------
 */

select
	section = "Totals",
	account = @fund_name,
	trade_count = @total_trade_count,
	avg_size = @total_avg_size,
	volume = @total_volume,
	pl = @total_pl,
	mm_pl = @total_mm_pl,
	style = @total_style

select
	section = "Attributed PL - By Account",
	account,
	trade_count,
	avg_size,
	volume,
	pl,
	mm_pl,
	style
from
	#cl_attrib
order by
	ordering,
	account
	
select
	section = "Attributed PL - By Counterparty",
	counterparty,
	trade_count,
	avg_size,
	volume,
	pl,
	mm_pl,
	style
from
	#lp_attrib
order by
	ordering,
	counterparty
	

select
        section = "Breakdown - By Platform",
        platform,
        trade_count,
        avg_size,
        volume,
        pl,
        mm_pl,
        style
from
        #br_breakdown
order by
        ordering,
        platform


select
        section = "Breakdown - By Prime Broker",
        prime_broker,
        trade_count,
        avg_size,
        volume,
        pl,
        mm_pl,
        style
from
        #pb_breakdown
order by
        ordering,
        prime_broker

select
        section = "Breakdown - By Contract",
        contract,
        trade_count,
        avg_size,
        volume,
        pl,
        mm_pl,
        style
from
        #ct_breakdown
order by
        ordering,
        contract


if @using_ticking_price = "Y"
begin
	select 
		section = "Price Alerts",
		msg = "Data is not committed for date provided. Therfore, PL for this report is using ticking market rates to convert PL to evaluation ccy. PL values can change until data is committed.",
		style = @error_style
end	







