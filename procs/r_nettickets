
if object_id("r_nettickets") != NULL
    drop procedure
        r_nettickets
go

create procedure
	r_nettickets
		@login varchar(50),
		@trade_date datetime = NULL,
		@symbol varchar(50) = NULL,
        @value_date varchar(50) = NULL,
        @deal_id int = NULL,
        @deal_status varchar(25) = NULL
as

exec
    r_assigntrades
        @login = @login,
        @trade_date = @trade_date,
        @symbol = @symbol,
        @value_date = @value_date,
        @deal_id = @deal_id,
        @deal_status = @deal_status,
        @page_title = "Trade Netting",
        @mode = "netting"

go
