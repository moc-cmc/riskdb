drop procedure
	tt_groupinterplatform
go

create procedure
	tt_groupinterplatform
		@deal_id int,
		@source_id int,
		@alias varchar(100)=NULL

as

declare @group_into_deal_id int
declare @group_from_deal_id int
declare @deal_count int

if @alias = NULL
begin
	select
		msg = "no alias passed in"

	select
		@alias = alias
	from
		suppressed_deal_aliases
	where
		deal_id = @deal_id
	and
		source_id = @source_id

	if @alias = NULL
	begin
        	return	
	end
end

select
	@deal_count = count(*)
from
	suppressed_deal_aliases
where
	alias = @alias

if @deal_count > 1
begin
	/* QUERY all trades in given deal */
	select
		msg = "more than 1 deal"

	create table
        	#deals(
			deal_id int)
	
	insert into
		#deals(
			deal_id)
	select
		deal_id
	from
		suppressed_deal_aliases
	where
		alias = @alias

	select
		@group_into_deal_id = min(deal_id)
	from
		#deals

	update
		trades
	set
		deal_id = @group_into_deal_id
	from
		trades a,
		#deals b
	where
		a.deal_id = b.deal_id

	select
		msg = "updated interplatform trades"
end


go
		
