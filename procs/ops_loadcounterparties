
drop procedure
	ops_loadcounterparties
go

create procedure
	ops_loadcounterparties
			@login varchar(25),
			@cpty  varchar(25),
			@ext_acct  varchar(50)

as

declare @counterparty_id int
declare @external_account_id int

select
	@external_account_id=external_account_id
from
	external_accounts
where
	name=@ext_acct

if @@rowcount != 1
begin
	select
		status="Error",
		msg="External Account does not exist",
		ext_acct=@ext_acct
	
	return
end

exec j_nextkey "counterparties", @counterparty_id output

insert into
	counterparties(
		counterparty_id,
		name,
		external_account_id)
	values(
		@counterparty_id,
		@cpty,
		@external_account_id)

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Could not insert Counterparty",
		cpty=@cpty

	return
end

select
	status="Success",
	mag="Counterparty created",
	cpty=@cpty

return


go


