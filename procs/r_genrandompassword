drop procedure r_genrandompassword
go

create procedure
	r_genrandompassword
		@pass_length int=NULL,
		@new_pass varchar(25) output

as

declare @charpool varchar(50)
declare @poollength int
declare @randomstring varchar(25)
declare @loopcount int

if @pass_length = NULL
begin
        /* min_length = 8, max_length = 12 */
	select 
		@pass_length = RAND() * 5 + 8
end

/* define allowable character explicitly - easy to read this way an easy to 
   omit easily confused chars like l (ell) and 1 (one) or 0 (zero) and O (oh) */
select @charpool = 'abcdefghjkmnpqrstuvwxyz23456789ABCDEFGHJKLMNPQRSTUVWXYZ.-_'
select @poollength = len(@charpool)

select @loopcount = 0
select @randomstring = NULL

while (@loopcount < @pass_length)
begin
    select
	@randomstring = @randomstring + substring(@charpool, convert(int, RAND() * @poollength), 1)
    select
	 @loopcount = @loopcount + 1
end

select
	@new_pass = @randomstring

go
