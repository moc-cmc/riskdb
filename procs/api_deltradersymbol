
drop procedure
	api_deltradersymbol
go

create procedure
	api_deltradersymbol
			@login varchar(25),
			@name varchar(50),
			@source_name varchar(100),
			@mapping varchar(50)
	
as

declare @trader_id int
declare @source_id int

select 
	@trader_id=trader_id
from
	traders	
where
	symbol=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find trader",
		trader=@name

	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Could not find source",
		source=@source_name
	return
end

begin tran
	delete from
		trader_symbols
	where
		trader_id=@trader_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount !=1)
	begin
		rollback tran

		select
			status="Error",
			msg="Could not delete Trader mapping",
			name=@name

		return
	end

commit tran

select
	status="Success",
	msg="Trader Mapping Deleted",
	name=@name

exec
	r_mappingoverview
		@login=@login

return

go


