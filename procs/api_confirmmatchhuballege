create or replace procedure
	api_confirmmatchhuballege
		@login varchar(50),
		@matchhub_trade_id int,
		@status varchar(50)
as

declare @status_id int
declare @tico_account_id int
declare @submitted_status_id int

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end

select
	@submitted_status_id = status_id
from
	statuses
where 
	name = "Submitted"
if @submitted_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding submitted status"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = @status
and
	name in("Confirmed", "Rejected")

begin tran
	update
		matchhub_trades
	set
		status_id = @status_id,
		confirmed_by = @tico_account_id,
		confirmed_at = getdate(),
		confirm_status_id = @submitted_status_id
	from
		matchhub_trades
	where
		matchhub_trade_id = @matchhub_trade_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem finding match hub allege from id",
			match_hub_trade_id = @matchhub_trade_id
		rollback tran
		return
	end
commit tran

select
	status = "Success",
	message = "Processed matchhub allege action",
	matchhub_trade_id = @matchhub_trade_id

go 
