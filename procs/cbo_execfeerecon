use
	risk_sjm_dev2
go

drop procedure
	cbo_execfeerecon
go

create procedure
	cbo_execfeerecon
		@login varchar(50),
		@trade_date datetime=NULL
as

declare @begin_date datetime
declare @end_date datetime

if @trade_date = NULL
	select
		@trade_date = getdate()

select
	@trade_date = convert(datetime, convert(date, @trade_date))

select
	@begin_date = dateadd(day, -30, @trade_date),
	@end_date = @trade_date

exec
	api_execfeerecon
		@login = @login,
		@begin_date = @begin_date,
		@end_date = @end_date,
		@display_output = "N",
		@send_message = "Y"


go
