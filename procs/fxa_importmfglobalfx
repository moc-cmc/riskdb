use
	risk_crossfield
go

drop procedure
	fxa_importmfglobalfx
go

create procedure
	fxa_importmfglobalfx
		@login varchar(50),
		@value_date varchar(50)=NULL,
		@contract varchar(50)=NULL,
		@rollup varchar(50)=NULL,
		@buy_sell varchar(25),
		@quantity numeric(30,4)=NULL,
		@curr1 varchar(25)=NULL,
		@price float=NULL,
		@value float=NULL,
		@cur2 varchar(25)=NULL,
		@sequence varchar(25)=NULL,
		@port varchar(25)=NULL,
		@trade_date datetime=NULL


as

declare @product1_id int
declare @product2_id int
declare @contract1_id int
declare @contract2_id int
declare @inverted_contract_id int
declare @contract_id int
declare @symbol varchar(50)
declare @is_resid char(1)
declare @usd_product_id int
declare @strategy varchar(50)
declare @trade_quantity numeric(30,4)
declare @status varchar(50)
declare @date date
declare @fund varchar(100)
declare @report_commit_id int

if @value_date = "Total"
	return

if @trade_date = NULL
	select
		@date = getdate()
else
	select
		@date = @trade_date

select
	@fund = name
from
	funds

select
	@product1_id = product_id
from
	products
where
	symbol = @curr1
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Curr1 not found",
		curr1 = @curr1
	return
end

select
	@product2_id = product_id
from
	products
where
	symbol = @cur2
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Curr2 not found",
		curr2 = @cur2
	return
end

select
	@contract1_id = contract_id
from
	forwards
where
	product_id = @product1_id
and
	currency_id = @product2_id

select
	@contract2_id = contract_id
from
	forwards
where
	product_id = @product2_id
and
	currency_id = @product1_id

select
	@inverted_contract_id = a.contract_id
from
	contract_price_styles a,
	price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.name = "Inverted"
and
	a.contract_id in(@contract1_id, @contract2_id)

if @inverted_contract_id = @contract1_id
	select
		@contract_id = @contract2_id,
		@trade_quantity = @value
else
	select
		@contract_id = @contract1_id,
		@trade_quantity = @quantity


/* if rtrim(@rollup) != "R" and rtrim(@port) = "12" /* This is a resid so USD is the currency */ */
if rtrim(@port) like "%12%"
begin
	if rtrim(@rollup) not like "%R%"
	begin
		select
			@is_resid = "Y"
	
		select
			@usd_product_id = product_id
		from
			products
		where
			symbol = "USD"

		if @product1_id = @usd_product_id
			select
				@contract_id = contract_id
			from
				forwards
			where
				product_id = @product2_id
			and
				currency_id = @product1_id
		else
			select
				@contract_id = contract_id
			from
				forwards
			where
				product_id = @product1_id
			and
				currency_id = @product2_id
	end
end

if rtrim(@rollup) like "%R%"
	select
		@strategy = "FX Roll",
		@sequence = "Roll - " + rtrim(@sequence)
else
	select
		@strategy = "Short Term"
		

if @is_resid = "Y"
	select
		@status = "Resid",
		@sequence = "Resid - " + rtrim(@sequence)
else
	select
		@status = "Active"

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id



exec
	r_reportcommitfordate
		@fund,
		"MFG Trade Recon",
		@date,
		@report_commit_id output

/* select
	symbol = @symbol,
	value_date = @value_date,
	contract = @contract,
	trade_quantity = @trade_quantity,
	price = @price,
	strategy = @strategy,
	status = @status,
	sequence = @sequence,
	port = @port,
	report_commit_id = @report_commit_id */

exec
	fxa_addreporttrade
		@report_commit_id = @report_commit_id,
		@import_date = @date,
		@trade_type = "Forward",
		@external_account_type = "Counterparty",
		@external_account = "MFG Crossfield Spot",
		@counterparty = "MFG",
		@quantity = @trade_quantity,
		@contract = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @date,
		@trader = "GMAN",
		@strategy = @strategy,
		@status = @status,
		@broker = "FXClear",
		@identifier = @sequence

go
