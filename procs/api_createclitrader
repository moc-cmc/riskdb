drop procedure
	api_createclitrader
go

create procedure
	api_createclitrader
		@login varchar(50),
		@trader varchar(50),	
		@external_account varchar(50),
		@sales_code varchar(50)=NULL

as


declare @trader_type varchar(50)
declare @tico_account_id int
declare @top_level_trader varchar(50)
declare @trader_login varchar(25)
declare @sales_code_id int


select
	@trader_type = "Client"


if @sales_code = NULL
begin
        select
                @sales_code = "None"
end

select
        @sales_code_id = sales_code_id
from
        sales_codes
where
        name = @sales_code
if @@rowcount != 1
begin
        exec
                j_nextkey
                        "sales_codes",
                        @sales_code_id output

        insert into
                sales_codes
        values(
                @sales_code_id,
                @sales_code)
end


exec
	api_createtrader
                @login = @login,
                @trader = @trader,
                @external_account = @external_account,
                @trader_type = @trader_type,
                @trader_login = @trader_login,
                @sales_code = @sales_code

go	
