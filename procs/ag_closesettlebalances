drop procedure
	ag_closesettlebalances
go

create procedure
	ag_closesettlebalances
		@login varchar(50),
		@settle_date datetime
as

declare @fx_transaction_type_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Link",
        "audit_log",
	"Close Settle Balances Log",
        NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Hidden",
        "route_to",
        NULL,
        NULL)


insert into
        #meta
values(
        "Column Hidden",
        "price_date",
        NULL,
        NULL)

insert into
	#meta
values(
	"Column Link",
	"undo_conversion",
	"Undo Settlement Conversions",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"convert_settlements",
	"Convert Account Settlements",
	NULL) 

insert into
        #meta
values(
        "Column Link",
        "set_rate",
        "Set PB Conversion Rate",
        NULL)


insert into
	#meta
values(
	"Column Format",
	"conversion_rate",
	"Number",
	"#,##0.000000")

insert into
	#meta
values(
	"Column Format",
	"converted_amount",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"amount",
	"Number",
	"#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@fx_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @fx_transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end

create table
	#balances(
		id int identity,
		style varchar(200) NULL,
		account_transaction_id int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		product_id int,
		amount float,
		currency_id int NULL,	
		conversion_rate float NULL,
		converted_amount float NULL,
		inverted char(1) NULL,
		overwrite_from_pb char(1) NULL)
insert into
	#balances(
		style,
		account_transaction_id,
		external_account_id,
		transaction_type_id,
		transaction_date,
		product_id,
		amount,
		currency_id)
select
	style = "background:#FFFFFF;border: 1px solid white",
	a.account_transaction_id,
	a.external_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.currency_id,
	a.amount,
	b.evaluation_currency_id
from
	account_transactions a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = @fx_transaction_type_id
and
	convert(date, a.transaction_date) = convert(date, @settle_date)

create table
	#prime_brokers(
		prime_broker_id int,
		name varchar(50)
)
insert into
	#prime_brokers
select
	a.prime_broker_id,
	b.name
from
	prime_brokers a,
	sources b,
	external_account_prime_brokers c,
	#balances d
where
	a.source_id = b.source_id
and
	a.prime_broker_id = c.prime_broker_id
and
	c.external_account_id = d.external_account_id
group by
	a.prime_broker_id,
	b.name

/* The only conversion rates that matter are those of the evaluation ccys, so only get those */
create table
        #eval_ccys(
                id int identity,
                product_id int,
                symbol varchar(10) NULL
)
insert into
        #eval_ccys(
                product_id)
select
        distinct(evaluation_currency_id)
from
        funds

insert into
        #eval_ccys(
                product_id)
select
        distinct(a.evaluation_currency_id)
from
        external_accounts a,
	#balances b
where
	a.external_account_id = b.external_account_id
and
        a.evaluation_currency_id not in(select product_id from #eval_ccys)


update
        #eval_ccys
set
        symbol = a.symbol
from
        products a,
        #eval_ccys b
where
        a.product_id = b.product_id

create table
	#contracts(
		contract_id int,
		symbol varchar(50),
		product_id int,
		currency_id int)
insert into
	#contracts(
		contract_id,
		symbol,
		product_id,
		currency_id)
select
	a.contract_id,
	a.symbol,
	b.product_id,
	b.currency_id
from
	contracts a,
	forwards b,
	#eval_ccys c,
	#balances d
where
	a.contract_id = b.contract_id
and
	b.product_id = c.product_id
and
	b.currency_id = d.product_id
group by
        a.contract_id,
        a.symbol,
        b.product_id,
        b.currency_id

insert into
        #contracts(
                contract_id,
                symbol,
                product_id,
                currency_id)
select
        a.contract_id,
        a.symbol,
        b.product_id,
        b.currency_id
from
        contracts a,
        forwards b,
        #eval_ccys c,
        #balances d
where
        a.contract_id = b.contract_id
and
        b.product_id = d.product_id
and
        b.currency_id = c.product_id
and
	a.contract_id not in(select contract_id from #contracts)
group by 
	a.contract_id,
	a.symbol,
	b.product_id,
	b.currency_id

delete 
	#contracts
from
	#contracts a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"


/*select * from #contracts*/
create table
        #conversion_rates(
                id int identity,
                prime_broker_id int,
                contract_id int,
                price_date datetime,
                price float,
                overwritten char(1) NULL)


insert into
        #conversion_rates(
                prime_broker_id,
                contract_id,
                price_date,
                price)
select
        b.prime_broker_id,
        a.contract_id,
        a.price_date,
        a.price
from
        bo_spot_settles a,
        #prime_brokers b,
	#contracts c
where
        /* do not join prime brokers to insert all pbs */
	a.contract_id = c.contract_id
and
        convert(date, a.price_date) = convert(date, @settle_date)

update
        #conversion_rates
set
        price = b.price,
        overwritten = "Y"
from
        #conversion_rates a,
        pb_conversion_rates b
where
        a.price_date = b.price_date
and
        a.contract_id = b.contract_id
and
        a.prime_broker_id = b.prime_broker_id


select
	section = "Conversion Rates",
	style = "background:#FFFFFF;border: 1px solid white",
        prime_broker = a.name,
        price_date = c.price_date,
        symbol = b.symbol,
        price = c.price,
        overwritten_settle = c.overwritten,
	route_to = "FX",
	set_rate = "SET RATE"
from
        sources a,
        contracts b,
        #conversion_rates c,
        prime_brokers d
where
        c.prime_broker_id = d.prime_broker_id
and
        d.source_id = a.source_id
and
        c.contract_id = b.contract_id
order by
        b.symbol,
        a.name



update
	#balances
set
	conversion_rate = 1.0
where
	product_id = currency_id

/* Use bo_spot_settles as a base */
update
	#balances
set
	a.conversion_rate = c.price
from
	#balances a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.transaction_date)

update
	#balances
set
	a.conversion_rate = 1.0 / c.price,
	a.inverted = "Y"
from
	#balances a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.transaction_date)
and
	a.conversion_rate = NULL

/* Use PB Conversion Rates to update */
update
	#balances
set
	a.conversion_rate = c.price,
	a.overwrite_from_pb = "Y"
from
	#balances a,
	forwards b,
	pb_conversion_rates c,
	external_account_prime_brokers d
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.transaction_date)
and
	c.prime_broker_id = d.prime_broker_id
and
	a.external_account_id = d.external_account_id
	
update
	#balances
set
	a.conversion_rate = 1.0 / c.price,
	a.overwrite_from_pb = "Y"
from
	#balances a,
	forwards b,
	pb_conversion_rates c,	
	external_account_prime_brokers d
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.transaction_date)
and
	a.inverted = "Y"
and
	c.prime_broker_id = d.prime_broker_id
and
	a.external_account_id = d.external_account_id

update
	#balances
set
	converted_amount = amount * conversion_rate
	
create table
	#net_settlements(
		external_account_id int,
		/* external_account_type_id int, */
		currency_id int,
		converted_amount float NULL,
		convert_settlements varchar(50) NULL)
insert into
	#net_settlements(
		external_account_id,
		currency_id,
		converted_amount)
select
	external_account_id,
	currency_id,
	sum(converted_amount)
from
	#balances
group by
	external_account_id,
	currency_id

update
	#net_settlements
set
	convert_settlements = "Convert Settlements"

/* update
	#net_settlements
set
	a.external_account_type_id = b.external_account_type_id,
	a.convert_settlements = "Convert Settlements"
from
	#net_settlements a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client" */

create table
	#closed_balances(
		id int identity,
		style varchar(200) NULL,
		sb_id int,
		account_transaction_id int,
		external_account_id int,
		transaction_date datetime,
		product_id int,
		amount float,
		converted_amount float,
		conversion_rate float)
insert into
	#closed_balances(
		style,
		sb_id,
		account_transaction_id,
		external_account_id,
		transaction_date,
		product_id,
		amount,
		converted_amount,
		conversion_rate)
select
	style = "background:#FFFFFF;border: 1px solid white",
	sb_id,
	account_transaction_id,
	external_account_id,
	transaction_date,
	product_id,
	amount,
	converted_amount,
	conversion_rate
from
	settlement_balances
where
	convert(date, transaction_date) = convert(date, @settle_date)
	

create table
        #net_closed(
                external_account_id int,
                currency_id int NULL,
                converted_amount float,
                undo_conversion varchar(50) NULL)
insert into
        #net_closed(
                external_account_id,
                converted_amount)
select
        external_account_id,
        sum(converted_amount)
from
        #closed_balances
group by
        external_account_id
update
	#net_closed
set
	a.currency_id = b.evaluation_currency_id
from
	#net_closed a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
        #net_closed
set
        a.undo_conversion = "Undo Conversion"
from
        #net_closed a,
        external_accounts b,
        external_account_types c
where
        a.external_account_id = b.external_account_id
and
        b.external_account_type_id = c.external_account_type_id
and
        c.name = "Client"

update
	#net_settlements
set
	a.convert_settlements = NULL
from
	#net_settlements a,
	#net_closed b
where
	a.external_account_id = b.external_account_id

select
	section = "Net Settled Balances",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
	currency = c.symbol,
	converted_amount= convert(numeric(30,2), a.converted_amount),
	a.convert_settlements,
	settle_date = @settle_date
from
	#net_settlements a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
order by
	b.symbol,
	c.symbol	

select
	section = "Net Converted Balances",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
	currency = c.symbol,
	converted_amount= convert(numeric(30,2), a.converted_amount),
	a.undo_conversion,
	settle_date = @settle_date
from
	#net_closed a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
order by
	b.symbol,
	c.symbol

select
	section = "Settled Balances",
	a.style,
	a.account_transaction_id,
	account = b.symbol,
	transaction_type = c.name,
	date = convert(varchar(11), a.transaction_date),
	currency = d.symbol,
	a.amount,
	account_currency = e.symbol,
	a.conversion_rate,
	a.converted_amount
from
	#balances a,
	external_accounts b,
	transaction_types c,
	products d,
	products e
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.product_id = d.product_id
and
	a.currency_id = e.product_id
order by
	b.symbol,
	d.symbol

select
	section = "Closed Balances",
	a.style,
	/* a.sb_id, */
	a.account_transaction_id,
	account = c.symbol,
	a.transaction_date,
	currency = b.symbol,
	a.amount,
	a.converted_amount,
	a.conversion_rate
from
	#closed_balances a,
	products b,
	external_accounts c
where
	a.product_id = b.product_id
and
	a.external_account_id = c.external_account_id
order by
	c.symbol,
	b.symbol


select
	settle_date = @settle_date,
        audit_log = "VIEW AUDIT LOG"

go

