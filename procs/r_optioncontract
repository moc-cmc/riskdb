
if object_id("r_optioncontract") != NULL
    drop procedure
        r_optioncontract
go
 
create procedure
	r_optioncontract
		@underlying char(100),
		@strike char(50),
		@put_call char(5),
		@contract_id int output

as

declare @option_expiration_id int
declare @def_exercise_style_id int
declare @symbol char(200)
declare @instrument_id int

select
	@symbol = rtrim(@underlying) + " " + rtrim(@strike) + " " + rtrim(@put_call)

select symbol = @symbol

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id != NULL
	return

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Option"
if @instrument_id = NULL
begin
	select
		id = -1,
		error = "Problem finding option instrument"
	return
end

select
	@option_expiration_id = option_expiration_id
from
	option_expirations
where
	symbol = @underlying
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding underlying for option",
		underlying = @underlying
	return
end

select
	@def_exercise_style_id = a.def_exercise_style_id
from
	options a,
	option_expirations b
where
	a.option_id = b.option_id
and
	b.option_expiration_id = @option_expiration_id

	
select
	@contract_id = contract_id
from
	option_contracts
where
	option_expiration_id = @option_expiration_id
and
	strike = convert(float, @strike)
and
	put_call = @put_call
if @@rowcount != 1
begin
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "contracts"
	select
		@contract_id = last_id
	from
		keys
	where
		relation = "contracts"


	insert into
		option_contracts
	values(
		@contract_id,
		@option_expiration_id,
		@def_exercise_style_id,
		convert(float, @strike),
		@put_call)
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem creating option contract",
			underlying = @underlying,
			strike = @strike,
			put_call = @put_call
		rollback tran
		select @contract_id = NULL
		return
	end


	insert into
		contracts
	values(
		@contract_id,
		@symbol,
		@instrument_id)

end


go
