
if object_id("r_ratecurvewithdate") != NULL
    drop procedure
        r_ratecurvewithdate
go

create procedure
	r_ratecurvewithdate
		@product_id int,
		@date datetime,
		@product_rate_id int output
as

declare @rate_date datetime
declare @most_recent_rate_id int

select
	@rate_date = max(rate_date)
from
	product_rates
where
	product_id = @product_id
and
	rate_date <= @date



if @rate_date = @date
begin
	select
		@product_rate_id = product_rate_id
	from
		product_rates
	where
		product_id = @product_id
	and
		rate_date = @date

	return
end	
else
begin
	select
		@most_recent_rate_id = product_rate_id
	from
		product_rates
	where
		product_id = @product_id
	and
		rate_date = @rate_date

	exec
		j_nextkey
			"product_rates",
			@product_rate_id output

	insert into
		product_rates
	values(
		@product_rate_id,
		@product_id,
		@date)

	insert into
		product_rate_points
	select
		product_rate_id = @product_rate_id,
		days,
		rate
	from
		product_rate_points
	where
		product_rate_id = @most_recent_rate_id

	return
end


go
