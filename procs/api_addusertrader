create or replace procedure
	api_addusertrader
		@login varchar(30),
		@trader varchar(50),
		@user_name varchar(100),
		@external_account varchar(50),
		@sales_code varchar(50)=NULL,
		@trader_id int=NULL output
as


declare @tico_account_id int
declare @trader_tico_account_id int
declare @sales_code_id int
declare @external_account_id int
declare @external_account_type varchar(50)
declare @broker_id int
declare @did_create_trader char(1)

/* tally defaults */
declare @fund_id int
declare @fund_name varchar(50)
declare @internal_account varchar(50)
declare @strategy varchar(50)
declare @status varchar(50)
declare @broker varchar(50)
declare @counterparty varchar(50)


declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)




select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error", 
		message = "Login not found"
	return
end


select
	@trader_tico_account_id = account_id
from
	tico_accounts
where
	login = @user_name
if @@rowcount != 1
begin
	select
		status = "Error", 
		message = "Login not found for username",
		user_name = @user_name
	return
end



if @sales_code = NULL
begin
	select
		@sales_code = "None"
end

select
	@sales_code_id = sales_code_id
from
	sales_codes
where
	name = @sales_code
if @@rowcount != 1
begin
	exec
		j_nextkey
			"sales_codes",
			@sales_code_id output

	insert into
		sales_codes
	values(
		@sales_code_id,
		@sales_code)
end

select
	@external_account_id = a.external_account_id,
	@external_account_type = b.name
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	a.symbol = @external_account
if @@rowcount != 1
begin
	select
		status= "Error",
		message = "External account not found",
		external_account = @external_account
	return
end


select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 0
begin
	select
		status = "Dupe",
		message = "Trader already exists",
		trader = @trader
	return
end

exec
	j_nextkey
		"traders",
		@trader_id output


insert into
	traders(
		trader_id,
		symbol,
		tico_account_id,
		default_strategy_id,
		external_account_id,
		sales_code_id)
values(
	@trader_id,
	@trader,
	@trader_tico_account_id,
	1,
	@external_account_id,
	@sales_code_id)
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem creating trader"
	return
end

/* Add tally defaults for username */
exec
                r_defaultfundforlogin
                        @login,
                        @fund_id output

select
       	@fund_name = name
from
       	funds
where
       	fund_id = @fund_id

select
       	@strategy = name
from
       	strategies
where
       	name = "Agency"
if @@rowcount != 1
begin
       	select
               	status = "Error",
               	message = "Strategy not found",
               	strategy = @strategy
       	return
end

select
       	@broker = symbol
from
       	brokers
where
       	symbol = "MPT Tally"
if @@rowcount != 1
begin
	select
		@broker = "MPT Tally"

	exec
		j_nextkey
			"brokers",
			@broker_id output
	insert into
		brokers(
			broker_id,
			symbol,
			source_id)
	values(
		@broker_id,
		"MPT Tally",
		0
	)
end

select
       	@counterparty = b.name
from
       	fund_agency_counterparties a,
       	counterparties b
where
      	a.counterparty_id = b.counterparty_id
	
exec
        api_addtallydefaults
                @login,
                @user_name,
                "Spot",
                @fund_name,
                @external_account,
                @trader,
                @strategy,
                @broker,
                @counterparty

select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds
where
	fund_id = @fund_id
select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

/* exec sp_remotesql @tico_server, @sql_string */

select
	@did_create_trader = "Y"
from
	traders
where
	symbol = @trader
if @did_create_trader = "Y"
begin
	select
		status = "Success",
		msg = "Trader created",
		trader = @trader
end
else
begin
	select
		status = "Error",
		msg = "Problem creating trader. Check data",
		trader = @trader
end


go
