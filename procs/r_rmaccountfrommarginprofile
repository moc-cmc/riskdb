drop procedure
	r_rmaccountfrommarginprofile
go

create procedure
	r_rmaccountfrommarginprofile
		@login varchar(50),
		@margin_profile varchar(50),
		@account varchar(50)

as

declare @external_account_id int
declare @margin_profile_id int


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @@rowcount !=1
begin
	select
		msg = "Could not find account",
		account = @account
	return
end

select
	@margin_profile_id = margin_profile_id
from
	margin_profiles
where
	name = @margin_profile
if @@rowcount !=1
begin
        select
                msg = "Could not find margin profile",
		margin_profile = @margin_profile
        return
end

delete from
	margin_profile_accounts
where
	margin_profile_id = @margin_profile_id
and
	external_account_id = @external_account_id
if @@rowcount = 1
begin
	select
		msg = "Successfully removed " + @account + " From profile " + @margin_profile
end


exec
	r_viewmarginprofile
		@login,
		@margin_profile

go

