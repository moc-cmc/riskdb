update
	#trades
set
	trade_delivery_status = "ACTIVE",
	section = "Suspect Trades"
from
	#trades a,
	#active_trades b
where
	a.sort_by_trade_id = b.trade_id

update
        #trades
set
        trade_delivery_status = "HELD",
        section = "Suspect Trades"
from
        #trades a,
        #held_trades b
where
        a.sort_by_trade_id = b.trade_id

update
        #trades
set
        trade_delivery_status = "PROCESSING",
        section = "Suspect Trades"
from
        #trades a,
        #processing_trades b
where
        a.sort_by_trade_id = b.trade_id

update
        #trades
set
        trade_delivery_status = "SENT"
from
        #trades a,
        #active_trades b
where
        a.sort_by_trade_id = b.trade_id


update
	#trades
set
	send_as = "SEND"
where
	delivery_status in ("<span style=""color:red"">ACTIVE</span>")


select
	@fund_type = a.name
from
	fund_types a,
	funds b
where
 	a.fund_type_id = b.fund_type_id


if @fund_type != "FX Agency"
begin
	update
		#trades
	set
		source_name = "Email Confirm"
	where
		source_name = "Agency Client"
end


select
	section,
	run_name = @run_name,
	begin_date = @begin_date,
	end_date = @end_date,
	deal_id,
        trade_id,
	trade_date = convert(char(25), trade_date, 1) + right(convert(char(25), trade_date, 0), 13),
        "Symbol" = contract_name,
        quantity,
        "Price" = trade_price,
        value_date = convert(char(11), value_date, 1),
        external_account = external_account_name,
        trader = trader_name,
        counterparty = counterparty_name,
        broker = broker_name,
	notify_trade = sort_by_trade_id,
        source = source_name,
        last_notified = notify_date,
        delivery_status,
	"Send/Resend" = send_as,
	style

from
	#trades
order by
	trade_delivery_status desc,
	sort_by_trade_id,
	style
	



go 

