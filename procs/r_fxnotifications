
create or replace procedure
	r_fxnotifications
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime= NULL,
		@end_date datetime=NULL
as


declare @run_id int
declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @fund_type varchar(50)
declare @active_trade_id int
declare @source_id int



create table
        #meta(
                meta_type char(200),
                name char(30),
                action char(200) NULL,
                value char(255) NULL
)

insert into
       #meta
values(
       "Column Hidden",
       "notify_trade",
       NULL,
       NULL
)

insert into
       #meta
values(
       "Column Hidden",
       "begin_date",
       NULL,
       NULL
)

insert into
       #meta
values(
       "Column Hidden",
       "end_date",
       NULL,
       NULL
)


insert into
       #meta
values(
       "Column Hidden",
       "trade_time",
       NULL,
       NULL
)

insert into
       #meta
values(
       "Column Hidden",
       "run_name",
       NULL,
       NULL
)


insert into
       #meta
values(
       "Column Link",
       "send/resend",
       "Resend Notification",
       NULL
)


insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL
)
 
insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)


create table
	#traders(
		trader_id int,
		symbol varchar(50))
insert into
	#traders
select
	a.trader_id,
	b.symbol
from
	run_traders a,
	traders b
where
	a.run_id = @run_id
and
	a.trader_id = b.trader_id 
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id,
		symbol
	from
		traders
end

create table
	#strategies(
		strategy_id int,
		symbol varchar(50))
insert into
	#strategies
select
	a.strategy_id,
	b.name
from
	run_strategies a,
	strategies b
where
	a.run_id = @run_id
and
	a.strategy_id = b.strategy_id 
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id,
		name
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50))
insert into
	#external_accounts
select
	a.external_account_id,
	b.symbol
from
	run_external_accounts a,
	external_accounts b
where
	a.run_id = @run_id
and
	a.external_account_id = b.external_account_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id,
		symbol
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int,
		symbol varchar(50))
insert into
	#internal_accounts
select
	a.internal_account_id,
	b.symbol
from
	run_internal_accounts a,
	internal_accounts b
where
	a.run_id = @run_id
and
	a.internal_account_id = b.internal_account_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id,
		symbol
	from
		internal_accounts
create table
	#brokers(
		broker_id int,
		symbol varchar(50))
insert into
	#brokers
select
	a.broker_id,
	b.symbol
from
	run_brokers a,
	brokers b
where
	a.run_id = @run_id
and
	a.broker_id = b.broker_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id,
		symbol
	from
		brokers

create table
	#counterparties(
		counterparty_id int,
		symbol varchar(50))

insert into
	#counterparties
select
	a.counterparty_id,
	b.name
from
	run_counterparties a,
	counterparties b
where
	a.run_id = @run_id
and
	a.counterparty_id = b.counterparty_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id,
		name
	from
		counterparties

create table
	#trades(
		section varchar(50) NULL,	
		deal_id int NULL,
		trade_id int NULL,
		trade_date datetime NULL,
		contract_name varchar(50) NULL,
		value_date datetime NULL,
		quantity numeric(30,4) NULL,
		trade_price float NULL,
		trader_name varchar(50) NULL,
		broker_name varchar(50) NULL,
		external_account_name varchar(50) NULL,
		counterparty_name varchar(50) NULL,
		trade_status_name varchar(50) NULL,
		deal_status_name varchar(50) NULL,
		source_id int NULL,
		source_name varchar(50) NULL,
		notify_date datetime NULL,
		delivery_status char(100) NULL,
		trade_delivery_status varchar(50) NULL,
		trade_notification_id int NULL,
		sort_by_trade_id int,
		identifier varchar(50) NULL,
		send_as varchar(10) NULL,
		style varchar(100) NULL
)


/*
Insert for trades details
*/

insert into
	#trades
select
	"Notified Trades",
	a.deal_id,
	a.trade_id,
	a.trade_date,
	h.symbol,
	a.value_date,
	a.quantity,
	a.price,
	d.symbol,
	f.symbol,
	b.symbol,
	g.symbol,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	a.trade_id,
	a.identifier,
	NULL,
	"background:#E6EBEB"
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	contracts h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.contract_id = h.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date
and
	a.price != 0 


create table
        #trade_notifiers(
                trade_id int,
                source_id int
)

/*
Get trade_notifiers
*/

insert into
        #trade_notifiers
select
        b.trade_id,
        a.source_id
from
        trade_notifiers a,
        trades b,
	#trades c
where
        (
        a.external_account_id = NULL
    or
        a.external_account_id = b.external_account_id
    )
and (
        a.broker_id = NULL
    or
        a.broker_id = b.broker_id
    )
and (
        a.status_id = NULL
    or
        a.status_id = b.status_id
    ) 
and (
        a.trader_id = NULL
    or
        a.trader_id = b.trader_id
    )
and (
        a.counterparty_id = NULL
    or
        a.counterparty_id = b.counterparty_id
    ) 
and (
        a.trade_type_id = NULL
    or
        a.trade_type_id = b.trade_type_id
    )
 and
        c.trade_id = b.trade_id
and
	c.trade_date >= a.notifier_date
group by
    a.source_id,
    b.trade_id

/*
Section for trade_notification details below trade details in report
*/

insert into
        #trades
select
	"Notified Trades",
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
	NULL,
	NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        h.source_id,
        NULL,
        NULL,
        "<span style=""color:red"">ACTIVE</span>",
	NULL,
        NULL,
        a.trade_id,
	NULL,
	NULL,
        "background:#fff"
from
        trades a,
        #trade_notifiers h
where
	a.trade_id = h.trade_id
and
        a.price != 0



update
	#trades
set
	a.trade_price = 1.0 / a.trade_price
from
	#trades a,
	contract_price_styles b,
	price_styles c,
	trades d
where
	a.trade_id = d.trade_id
and
	d.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"

/*
Get source name from sources table
*/

update
        #trades
set
        source_name = b.name
from
        #trades a,
        sources b
where
        a.source_id = b.source_id


/*
Get trade_id status from trades table
*/
 
update
	#trades
set
	trade_status_name = d.name
from
	#trades a,
	trades b,
	statuses d
where
	a.trade_id = b.trade_id
and
	b.status_id = d.status_id

/*  
Get deal_id status from deals table
*/

update
        #trades
set
        deal_status_name = d.name
from
        #trades a,
        deals b,
        statuses d
where
        a.deal_id = b.deal_id
and
        b.status_id = d.status_id

/*
Get trade_notification_id for each trade_id
*/

update
        #trades
set
        trade_notification_id = c.trade_notification_id
from
        #trades a,
        sources b,
        trade_notifications c
where
        a.source_id = b.source_id
and
	b.source_id = c.source_id
and
        a.sort_by_trade_id = c.trade_id

/*
Get date from trade_notifications table
*/

update
	#trades
set
	notify_date = b.notify_date
from
	#trades a,
	trade_notifications b
where
	a.trade_notification_id = b.trade_notification_id

/*
Update #trades to SENT, send_as to RESEND if trade has been sent
*/

update
	#trades
set
	delivery_status = "<span style=""color:black"">SENT</span>",
	send_as = "RESEND"
from
	#trades a,
	trade_notifications b,
	statuses c
where
	a.trade_notification_id = b.trade_notification_id
and
	b.status_id = c.status_id
and
	c.name = "Sent"

/*
Update #trades to PROCESSING if trade is NEW, EDIT or DELETE in trade_notifications
*/

update
        #trades
set
        delivery_status = "<span style=""color:black"">PROCESSING</span>",
	send_as = "FORCE SEND"
from
        #trades a,
        trade_notifications b,
        statuses c
where
        a.trade_notification_id = b.trade_notification_id
and
        b.status_id = c.status_id
and
        c.name in("Active", "Edit", "Cancelled")

/*
Update #trades to HELD FOR AGGREGATION if trade will later be aggregated
*/

update
        #trades
set
        delivery_status = "<span style=""color:black"">HELD FOR AGGREGATION</span>" /* ,
	send_as = "SEND"*/
from
        #trades a,
        trade_notifications b,
        statuses c
where
        a.trade_notification_id = b.trade_notification_id
and
        b.status_id = c.status_id
and
        c.name in("Aggregated")

/*
create temp table to store trades that are not in trade_notifications
*/

create table
	#active_trades(
		trade_id int
)

create table
        #held_trades(
                trade_id int
)

create table
        #sent_trades(
                trade_id int
)

create table
        #processing_trades(
                trade_id int
)


insert into
	#active_trades
select
	sort_by_trade_id
from
	#trades 
where
	delivery_status in ("<span style=""color:red"">ACTIVE</span>")
group by
	sort_by_trade_id


insert into
        #held_trades
select
        sort_by_trade_id
from
        #trades
where
        delivery_status in ("<span style=""color:black"">HELD FOR AGGREGATION</span>")
group by
        sort_by_trade_id

insert into
        #sent_trades
select
        sort_by_trade_id
from
        #trades
where
        delivery_status in ("<span style=""color:black"">SENT</span>")
group by
        sort_by_trade_id

insert into
        #processing_trades
select
        sort_by_trade_id
from
        #trades
where
	delivery_status in ("<span style=""color:black"">PROCESSING</span>")
group by
        sort_by_trade_id





