drop procedure
	r_extaccountusage
go

create procedure
	r_extaccountusage
		@login varchar(50),
		@external_account_id int,
		@nop float output,
		@dsl float output
as

declare @ext_account varchar(50)
declare @nop_type varchar(50)
declare @dsl_type varchar(50)

select
	@ext_account = symbol
from
	external_accounts
where
	external_account_id = @external_account_id

select
	@nop_type = a.name,
	@dsl_type = b.name
from
	nop_types a,
	dsl_types b,
	ext_account_limits c
where
	a.nop_type_id = c.nop_type_id
and
	b.dsl_type_id = c.dsl_type_id 
and
	c.external_account_id = @external_account_id


if @nop_type = "Net"
begin
	select
		@nop = sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @ext_account
end

if @nop_type = "Longs"
begin
	select
		@nop = sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @ext_account
	and
		equiv > 0.0
end

if @nop_type = "Shorts"
begin
	select
		@nop = sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @ext_account
	and
		equiv < 0.0
end

create table
	#dsl(
		value_date datetime,
		dsl float)

if @dsl_type = "Net"
begin
	insert into
		#dsl
	select
		value_date,
		sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @ext_account
	group by
		value_date

	select
		@dsl = max(dsl)
	from
		#dsl
end

if @dsl_type = "Longs"
begin
	insert into
		#dsl
	select
		value_date,
		sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @ext_account
	and
		equiv > 0.0
	group by
		value_date

	select
		@dsl = max(dsl)
	from
		#dsl
end


if @dsl_type = "Shorts"
begin
	insert into
		#dsl
	select
		value_date,
		sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @ext_account
	and
		equiv < 0.0
	group by
		value_date

	select
		@dsl = max(dsl)
	from
		#dsl
end

go
