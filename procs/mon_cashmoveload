
drop procedure mon_cashmoveload
go

create procedure
	mon_cashmoveload

as

declare @source_id int
declare @weekday varchar(12)
declare @max_ladder_date datetime
declare @today datetime

select
	@source_id=source_id
from
	sources
where
	name="Spectrum"

if @@rowcount != 1
begin
	select
		Status="Error",
		msg="Could not locate source Spectrum in database"
	return
end

select
	@weekday = datename(weekday, getdate())

if (@weekday = 'Saturday' or @weekday = 'Sunday')
begin
	return
end

select
	@max_ladder_date = max(value_date)
from
	source_ladder
where
	@source_id=source_id

select
	@today = getdate()

if (convert(date,@today) != convert(date, @max_ladder_date))
begin	
	select
		Status = "Failed",
		msg = "Source Ladder table not loaded for today"
	return
end

select
	Status = "Ok",
	msg = "Cash Moves loaded"

go

