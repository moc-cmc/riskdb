
if object_id("cm_myruns") != NULL
    drop procedure
        cm_myruns
go

create procedure
	cm_myruns
		@login varchar(30)
as

declare @id int
declare @ids int
declare @name varchar(50)
declare @internal_account_id int
declare @committed_pls int

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Column Group",
	"section",
	NULL,
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"del_run",
	"Delete User Run",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"edit_run",
	"Run Configuration",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"create_run",
	"Create New Run",
	NULL,
	NULL)

insert into
        #links
values(
        "Column Link",
        "manage_access",
        "Manage User Run Access",
        NULL,
        NULL)

insert into 
	#links
values(
	"Column Link",
	"copy_runs",
	"Copy Runs",
	NULL,
	NULL)

--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	create_run = "CREATE NEW RUN",
	manage_access = "MANAGE ACCESS",
	copy_runs = "COPY RUNS"

create table
	#output(
		section varchar(25),
		id int identity,
		name varchar(50),
		edit_run varchar(30) NULL)

insert into
	#output(
		section,
		name,
		edit_run)
select
	"Runs",
	a.name,
	"EDIT"
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login

update
	#output
set
	section="Run Favorites"
from
	#output a,
	runs b,
	user_run_favorites c,
	tico_accounts d 
where
	a.name = b.name
and
	b.run_id = c.run_id
and
	c.tico_account_id = d.account_id
and
	d.login = @login


select
	section,
	name,
	edit_run
from
	#output
order by
	section,
	name


go
