	#meta
values(
	"Column Link",
	"refresh",
	"Fetch Live Expiration Price",
	NULL)


select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta


select
	@tally_type = name
from
	tally_types
where
	name = "Option"

select
	@account_id = account_id
from
	tico_accounts
where
	login = @login
select
	@trader_id = trader_id
from
	default_tally_accounts
where
	tico_account_id = @account_id

select
	@trader_name = symbol
from
	traders
where
	trader_id = @trader_id

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Underlying contract not found",
		symbol = @symbol
	return
end

select
	@as_of_date = getdate()

create table
	#output(
		symbol varchar(50) NULL,
		expiration datetime NULL,
		strike numeric(30,4) NULL,
		put_call varchar(5) NULL,
		spot float NULL,
		underlying float NULL,
		tv float NULL,
		bid float NULL,
		offer float NULL,
		delta float NULL,
		buy varchar(10) NULL,
		sell varchar(10) NULL,
		buy_amt numeric(30,4) NULL,
		sell_amt numeric(30,4) NULL,
		option_type varchar(15),
		style varchar(50),
		trader_name varchar(50),
		volatility float,
		spot_ref float,
		biproduct varchar(20),
		expiration_date datetime,
		strike_price numeric(30,4),
		p_or_c varchar(40))

exec
	r_forwardpriceasof
		@contract_id,
		@as_of_date,
		@expiration,
		@days output,
		@spot_price output,
		@forward_price output,
		@give_product_rate output,
		@get_product_rate output

select
	@put_call = "C"

exec
	SYB0101.risk.dbo.r_optionmodel
		@login = "markr",
		@underlying = @forward_price,
		@strike = @strike,
		@vol = .11,
		@days_to_exp = @days,
		@interest_rate = @give_product_rate,
		@carry_cost = 0.00,
		@put_call = @put_call,
		@exercise_style = "European",
		@tv = @tv output,
		@delta = @delta output,
		@gamma = @gamma output,
		@theta = @theta output,
		@tau = @tau output,
		@rho = @rho output

insert into
	#output
values(
	@symbol,
	@expiration,
	@strike,
	@put_call,
	@spot_price,
	@forward_price,
	@tv,
	@tv,
	@tv,
	@delta,
	"5",
	"-5",
	5000000,
	-5000000,
	"call",
	"background:#E6EBEB",
	@trader_name,
	11,
	@spot_price,
	@symbol,
	@expiration,
	@strike,
	@put_call)

insert into
	#output
values(
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
