select
	@put_call = "P"

exec
	SYB0101.risk.dbo.r_optionmodel
		@login = "markr",
		@underlying = @forward_price,
		@strike = @strike,
		@vol = .11,
		@days_to_exp = @days,
		@interest_rate = @give_product_rate,
		@carry_cost = 0.00,
		@put_call = @put_call,
		@exercise_style = "European",
		@tv = @tv output,
		@delta = @delta output,
		@gamma = @gamma output,
		@theta = @theta output,
		@tau = @tau output,
		@rho = @rho output


insert into
	#output
values(
	@symbol,
	@expiration,
	@strike,
	@put_call,
	@spot_price,
	@forward_price,
	@tv,
	@tv,
	@tv,
	@delta,
	"5",
        "-5",
        5000000,
        -5000000,
	"put",
	"background:#E6EBEB",
	@trader_name,
	11,
	@spot_price,
        @symbol,
        @expiration,
        @strike,
        @put_call)



insert into
        #output
values(
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        @tv,
        @tv,
        NULL,
        "10",
        "-10",
        10000000,
        -10000000,
	"put",
	"background:#fff",
	@trader_name,
	11,
	@spot_price,
        @symbol,
        @expiration,
        @strike,
        @put_call)


insert into
        #output
values(
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        NULL,
        @tv,
        @tv,
        NULL,
        "15",
        "-15",
        15000000,
        -15000000,
        "put",
        "background:#fff",
	@trader_name,
	11,
	@spot_price,
        @symbol,
        @expiration,
        @strike,
        @put_call)




select
	@spread = .0002

if @symbol like "%JPY"
	select
		@spread = .01
update
	#output
set
	bid = bid - @spread,
	offer = offer + @spread
where
	buy = "5"
and
	sell = "-5"

select
        @spread = .0004

if @symbol like "%JPY"
        select
                @spread = .01
update
        #output
set
        bid = bid - @spread,
        offer = offer + @spread
where
	buy = "10"
and
        sell = "-10"

select
        @spread = .0006

if @symbol like "%JPY"
        select
                @spread = .01
update
        #output
set
        bid = bid - @spread,
        offer = offer + @spread
where
        buy = "15"
and
        sell = "-15"




	

/*select #output.symbol, #output.expiration, #output.strike, #output.put_call, #output.spot, #output.underlying, #output.tv, #output.bid, #output.offer, #output.delta from #output */

