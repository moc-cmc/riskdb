from
	#suggested_transfers
where
	price != NULL
and
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#suggested_transfers
	where
		price != NULL
	and
		id > @id

	select
		@from_pb_id = prime_broker1_id,
		@to_pb_id = prime_broker2_id,
		@transfer_qty = prime_broker1_amount,
		@contract_id = contract_id,
		@value_date = value_date,
		@price = price
	from
		#suggested_transfers
	where
		id = @id

	select
		@external_account_id = from_pb_ext_acct_id,
		@counterparty_id = to_pb_cpty_id
	from
		pb_transfers
	where
		from_pb_id = @from_pb_id
	and
		to_pb_id = @to_pb_id

	select
		@queued_trade_id = NULL,
		@queued_deal_id = NULL

	exec
		j_nextkey
			"queued_deals",
			@queued_deal_id output

	exec
		j_nextkey
			"queued_trades",
			@queued_trade_id output

	insert into
		queued_deals(
			queued_deal_id,
			batch_id,
			deal_type_id,
			timestamp)
	values(
		@queued_deal_id,
		@batch_id,
		@deal_type_id,
		getdate())

	insert into
