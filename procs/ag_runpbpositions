			user_id,
			tally_type_id,
			trade_date,
			contract_id,
			value_date,
			quantity,
			price,
			external_account_id,
			internal_account_id,
			counterparty_id,
			trader_id,
			strategy_id,
			broker_id)
	values(
		@queued_trade_id,
		@queued_deal_id,
		@batch_id,
		@tico_account_id,
		@tally_type_id,
		@trade_date,
		@contract_id,
		@value_date,
		@transfer_qty,
		@price,
		@external_account_id,
		@internal_account_id,
		@counterparty_id,
		@trader_id,
		@strategy_id,
		@broker_id)

	select
		@from_pb_id = prime_broker2_id,
		@to_pb_id = prime_broker1_id,
		@transfer_qty = prime_broker2_amount,
		@contract_id = contract_id,
		@value_date = value_date,
		@price = price
	from
		#suggested_transfers
	where
		id = @id

	select
		@external_account_id = from_pb_ext_acct_id,
		@counterparty_id = to_pb_cpty_id
	from
		pb_transfers
	where
		from_pb_id = @from_pb_id
	and
		to_pb_id = @to_pb_id

	select
		@queued_trade_id = NULL
	exec
		j_nextkey
			"queued_trades",
			@queued_trade_id output

	insert into
		queued_trades(
			queued_trade_id,
			queued_deal_id,
			batch_id,
			user_id,
			tally_type_id,
			trade_date,
			contract_id,
			value_date,
			quantity,
			price,
			external_account_id,
			internal_account_id,
			counterparty_id,
			trader_id,
			strategy_id,
			broker_id)
	values(
		@queued_trade_id,
		@queued_deal_id,
		@batch_id,
		@tico_account_id,
		@tally_type_id,
		@trade_date,
		@contract_id,
		@value_date,
		@transfer_qty,
		@price,
		@external_account_id,
		@internal_account_id,
		@counterparty_id,
		@trader_id,
		@strategy_id,
		@broker_id)


	select
		@ids = count(*)
	from
		#suggested_transfers
	where
		price != NULL
	and
		id > @id
end

end /* create new batch trades */

