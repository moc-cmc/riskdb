create table
	#ordered_pb_positions(
		id int identity,
		prime_broker_id int,
		contract_id int,
		value_date datetime,
		position numeric(30,4),
		remaining_position numeric(30,4))
insert into
	#ordered_pb_positions(
		prime_broker_id,
		contract_id,
		value_date,
		position,
		remaining_position)
select
	prime_broker_id,
	contract_id,
	value_date,
	position,
	position
from
	#pb_positions
order by
	contract_id,
	value_date,
	abs(position) desc

create table
	#suggested_transfers(
		id int identity,
		style varchar(250) NULL,
		contract_id int,
		value_date datetime,
		price float NULL,
		prime_broker1_id int,
		prime_broker1_amount numeric(30,4),
		prime_broker2_id int,
		prime_broker2_amount numeric(30,4))

select
	@id = 0
select
	@ids = count(*)
from
	#ordered_pb_positions
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ordered_pb_positions
	where
		id > @id

	select
		@prime_broker_id = prime_broker_id,
		@contract_id = contract_id,
		@value_date = value_date,
		@position = remaining_position
	from
		#ordered_pb_positions
	where
		id = @id

	select
		@opposite_position = max(abs(remaining_position))
	from
		#ordered_pb_positions
	where
		contract_id = @contract_id
	and
		value_date = @value_date
	and
		sign(remaining_position) = sign(@position) * -1.0

	select
		@opposite_id = id
	from
		#ordered_pb_positions
	where
		contract_id = @contract_id
	and
		value_date = @value_date
	and
		sign(remaining_position) = sign(@position) * -1.0
	and
		abs(remaining_position) = abs(@opposite_position)

	select
		@opposite_position = remaining_position,
		@opposite_prime_broker_id = prime_broker_id
	from
		#ordered_pb_positions
	where
		id = @opposite_id


	/* Handle if position is bigger than, or equal to  opposite position */
	if abs(@position) >= abs(@opposite_position)
	begin

		if abs(@opposite_position) > 0
			insert into
				#suggested_transfers(
					contract_id,
					value_date,
					prime_broker1_id,
					prime_broker1_amount,
					prime_broker2_id,
					prime_broker2_amount)
			values(
				@contract_id,
				@value_date,
				@prime_broker_id,
				@opposite_position,
				@opposite_prime_broker_id,
				@opposite_position * -1.0)

		update
			#ordered_pb_positions
		set
			remaining_position = remaining_position + @opposite_position
		where
			id = @id
		update
			#ordered_pb_positions
		set
			remaining_position = remaining_position - @opposite_position
		where
			id = @opposite_id
	end


	/* Handle if position is smaller than opposite position */
	if abs(@position) < abs(@opposite_position)
	begin

		if abs(@position) > 0
			insert into
				#suggested_transfers(
					contract_id,
					value_date,
					prime_broker1_id,
					prime_broker1_amount,
					prime_broker2_id,
					prime_broker2_amount)
			values(
				@contract_id,
				@value_date,
				@prime_broker_id,
				@position * -1.0,
				@opposite_prime_broker_id,
				@position)
	
		update
			#ordered_pb_positions
		set
			remaining_position = remaining_position - @position
		where
			id = @id
		update
			#ordered_pb_positions
		set
			remaining_position = remaining_position + @position
		where
			id = @opposite_id
	end

	select
		@ids = count(*)
	from
		#ordered_pb_positions
	where
		id > @id
end

