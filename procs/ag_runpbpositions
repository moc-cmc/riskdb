insert into
	#trades(
		trade_id,
		quantity,
		contract_id,
		value_date,
		external_account_id,
		trader_id,
		internal_account_id,
		strategy_id,
		broker_id,
		status_id)
select
	a.trade_id,
	a.quantity,
	a.contract_id,
	a.value_date,
	a.external_account_id,
	a.trader_id,
	a.internal_account_id,
	a.strategy_id,
	a.broker_id,
	a.status_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date <= @end_date

