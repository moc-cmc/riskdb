create table
	#output(
		batch_file_id int,
		identifier varchar(100),
		name varchar(100), 
		timestamp datetime,
		accounts int NULL,
		total_balance float NULL,
		status varchar(50) NULL)
insert into
	#output(
		batch_file_id,
		identifier,
		name,
		timestamp,
		status)
select
	a.batch_file_id,
	a.identifier,
	a.name,
	a.timestamp,
	b.name
from
	batch_files a,
	statuses b
where
	a.status_id = b.status_id

	
create table
	#stats(
		batch_file_id int,
		num_accounts int,
		total_balance float)
insert into
	#stats
select
	batch_file_id,
	count(identifier),
	sum(amount)
from
	batch_file_accounts
group by
	batch_file_id

update
	#output
set
	a.accounts = b.num_accounts,
	a.total_balance = b.total_balance
from
	#output a,
	#stats b
where
	a.batch_file_id = b.batch_file_id


select
	identifier,
	name,
	timestamp,
	accounts,
	total_balance,
	status,
	evaluate = "EVALUATE",
	activate = "ACTIVATE"
from
	#output
order by
	name


