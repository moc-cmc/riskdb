
drop procedure
	eod_accounttransactions
go

create procedure
	eod_accounttransactions
		@source varchar(50),
		@trade_date datetime=NULL
		
as

declare @source_id int
declare @begin_date datetime
declare @end_date datetime
declare @price_date datetime

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end


/* This runs on 12pm - 12pm since its an eod report. If date is NULL
 |  then running this bewteen 5pm and 11:59pm will generate report for
 |  the 'previous business day'
 */
if @trade_date = NULL
begin
        select
                @trade_date = getdate()
end
select
	@trade_date = convert(date, @trade_date)

exec 
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

select
        @price_date = convert(varchar(8), @trade_date, 112) + " 17:00"


create table
	#account_transactions(
		balance_transaction_id int identity,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(15) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		ext_account_pb varchar(25) NULL,
		amount float NULL,
		abs_amount float NULL,
		notification_source varchar(40) NULL,
                product_id int NULL,
		product varchar(10) NULL,
                pd_eq float NULL
		)


/*
| Insert *_ids into #account_transactions that need to be notified 
*/
insert into
	#account_transactions
(
	external_account_id,
	product_id,
	amount
)
select 
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
        account_transactions a
where
	a.transaction_date <= @end_date
group by
	a.external_account_id,
	a.currency_id

/*
| Query external_accounts
*/

update 
        #account_transactions
set
        external_account = b.symbol,
	external_account_type_id = b.external_account_type_id
from
        #account_transactions a,
        external_accounts b
where
        a.external_account_id = b.external_account_id

update
	#account_transactions 
set
	external_account_type = b.name
from
	#account_transactions a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id

update
	#account_transactions
set
	external_account = b.symbol
from
	#account_transactions a,
	external_account_symbols b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id

update
	#account_transactions
set
	ext_account_pb = b.symbol
from
	#account_transactions a,
	client_give_ups b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id

update
	#account_transactions
set
	prime_broker_id = d.prime_broker_id,
	prime_broker = c.name
from
	#account_transactions a,
	external_account_prime_brokers b,
	prime_brokers d,
	sources c
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = d.prime_broker_id
and
	c.source_id = d.source_id

update
	#account_transactions
set
	prime_broker = b.symbol
from
	#account_transactions a,
	prime_broker_symbols b
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = @source_id

update
	#account_transactions
set
	product = b.symbol
from
	#account_transactions a,
	products b
where
	a.product_id = b.product_id

	
select
	/*daily_balance_id = convert(char(8), @trade_date, 112)+"-"+convert(varchar(10), balance_transaction_id),*/
	trade_date = convert(char(8), @trade_date, 112),
	external_account_id,
	external_account,
	external_account_type_id,
	external_account_type,
	prime_broker_id,
	prime_broker,
	ext_account_pb,
	amount,
	abs_amount,
	notification_source,
	product_id,
	product,
	pd_eq
from
        #account_transactions
order by
	external_account_type,
	external_account

go
