
if object_id("r_resolvetrader") != NULL
    drop procedure
        r_resolvetrader
go


create procedure
	r_resolvetrader
        @login varchar(50),
        @source varchar(50),
        
        @trader_id int = NULL out,
        
        @symbol varchar(100) = NULL out,
        @user_id int = NULL out,
        @user varchar(50) = NULL out,
        @default_strategy_id int = NULL out,
        @default_strategy varchar(50) = NULL out,
        @external_account_id int = NULL out,
        @external_account varchar(50) = NULL out,
        @rrcode varchar(25) = NULL out,
        
        @source_symbol varchar(50) = NULL out,
        
        @create char(1) = NULL out,
        @report char(1) = NULL
as

/* messages */
declare @to varchar(50)
declare @issue varchar(250)
declare @subject varchar(250)
declare @content varchar(250)
declare @check_sql varchar(250)

declare @should_create char(1)
declare @source_id int

select
    @should_create = @create,
    @create = "N"

if @login = NULL or @source = NULL
begin
    if @report != "N"
        select
            status = "Error",
            message = "Login and source required",
            login = @login,
            source = @source
    raiserror 99001, "@login and @source required"
    return
end

/* Set up defaults */
if @default_strategy = NULL
    select
        @default_strategy = "Short Term"
    
if @trader_id = NULL
begin

    /* Lookup @trader_id through trader_symbols.symbol */
    if @trader_id = NULL and @source_symbol != NULL
        select
            @trader_id = a.trader_id
        from
            traders a
        join
            trader_symbols b
                 on a.trader_id = b.trader_id
        where
            b.source_id = @source_id
        and
            b.symbol = @source_symbol
    
    /* Lookup @trader_id through traders.symbol */
    if @trader_id = NULL and @symbol != NULL
        select
            @trader_id = a.trader_id
        from
            traders a
        where
            a.symbol = @symbol
    
    /* Lookup @trader_id through traders.tico_account_id */
    if @trader_id = NULL and @user_id != NULL
        select
            @trader_id = a.trader_id
        from
            traders a
        where
            a.tico_account_id = @user_id
    
    /* Lookup @trader_id through tico_accounts.login */
    if @trader_id = NULL and @user != NULL
        select
            @trader_id = a.trader_id
        from
            traders a
        join
            tico_accounts b on a.tico_account_id = b.account_id
        where
            b.login = @user

end
            
if @trader_id = NULL
begin
        
    /* Resolve the @source_id from @source */
    exec
        r_resolvesource
            @login = @login,
            @source_id = @source_id out,
            @name = @source,
            @report = @report
    if @source_id = NULL
        return
        
    /* ---------------------------- MARK: Create ---------------------------- */

    if @should_create != "N" and /* has permission */ exists (
        select
            *
        from
            source_permissions
        where
            source_id = @source_id
        and
            autocreates_traders = "Y"
    )
    begin
    
        if @symbol = NULL
        begin
            
            select
                @issue = "unsupported:r_resolvetrader():missing:@symbol",
                @to = "support",
                @subject = "Couldn't autocreate trader without a symbol",
                @content = "Trader does not exist. r_resolvetrader attempted to create the trader but no @symbol was provided."
            exec
                r_postmessage
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High"
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Cannot create trader without specifying symbol",
                    trader = @symbol,
                    login = @login,
                    source = @source,
                    trader_id = @trader_id,
                    symbol = @symbol,
                    user_id = @user_id,
                    'user' = @user,
                    default_strategy_id = @default_strategy_id,
                    default_strategy = @default_strategy,
                    source_symbol = @source_symbol,
                    'create' = @create,
                    report = @report
                    
            return
        end
    
        /* ---------------- MARK: Lookup @user_id from @user ---------------- */

        if @user_id = NULL
        begin
            
            if @user = NULL
                select
                    @user = @symbol
            /*
            begin
            
                select
                    @issue = "unsupported:r_resolvetrader(symbol=" + @symbol + "):missing:@user,@user_id",
                    @to = "support",
                    @subject = "Couldn't autocreate trader, """ + @symbol + """, due to implementation error",
                    @content = "Trader, """ + @symbol + """, does not exist. r_resolvetrader attempted to create the trader but no @user_id nor @user was provided."
                exec
                    r_postmessage
                        @login = @login,
                        @name = @issue,
                        @to = @to,
                        @channel = "System",
                        @subject = @subject,
                        @content = @content,
                        @priority = "High"
                        
                if @report != "N"
                    select
                        status = "Error",
                        message = "Cannot create trader without specifying user",
                        trader = @symbol
                        
                return
            end
            */
            
            exec
                r_resolveuser
                    @login = @login,
                    @source = @source,
                    @user_id = @user_id out,
                    @name = @user,
                    @create = "Y",
                    @report = @report
            
            if @user_id = NULL
            begin
            
                select
                    @issue = "notfound:tico_accounts(login=" + @user + ")",
                    @to = "support",
                    @subject = "Cannot autocreate missing trader, """ + @symbol + """",
                    @content = "Trader, """ + @symbol + """, does not exist and cannot be autocreated because user, """ + @user + """, does not exist and could not be autocreated.",
                    @check_sql = "if exists(select * from tico_accounts where login = """ + @user + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
                exec
                    r_manageissue
                        @login = @login,
                        @name = @issue,
                        @to = @to,
                        @channel = "System",
                        @subject = @subject,
                        @content = @content,
                        @priority = "High",
                        @check_sql = @check_sql
                        
                if @report != "N"
                    select
                        status = "Error",
                        message = "Cannot create trader without specifying a valid user",
                        trader = @symbol,
                        'user' = @user
                
                return
            end
            
        end /* Resolve user */
        
        /* ---------------- MARK: Lookup @default_strategy_id --------------- */
        
        if @default_strategy_id = NULL
        begin
        
            exec
                r_resolvestrategy
                    @login = @login,
                    @source = @source,
                    @strategy_id = @default_strategy_id out,
                    @name = @default_strategy,
                    @create = "Y",
                    @report = @report
            
            if @default_strategy_id = NULL
            begin
            
                select
                    @issue = "notfound:strategies(name=" + @default_strategy + ")",
                    @to = "support",
                    @subject = "Couldn't autocreate trader, """ + @symbol + """, due to implementation error",
                    @content = "Trader, """ + @symbol + """, does not exist. r_resolvetrader attempted to create the trader but the default strategy, """ + @default_strategy + """, could not be resolved."
                exec
                    r_postmessage
                        @login = @login,
                        @name = @issue,
                        @to = @to,
                        @channel = "System",
                        @subject = @subject,
                        @content = @content,
                        @priority = "High"
                        
                if @report != "N"
                    select
                        status = "Error",
                        message = "Cannot create trader without a default strategy",
                        trader = @symbol,
                        default_strategy = @default_strategy
                        
                return
            end
            
        end
        
        /* ---------------- MARK: Lookup @external_account_id --------------- */
        
        /* FEATURE: traders.external_account_id */
        if @external_account_id = NULL
        begin
        
            exec
                r_resolveexternalaccount
                    @login = @login,
                    @source = @source,
                    @external_account_id = @external_account_id out,
                    @symbol = @external_account,
                    @name = @external_account,
                    @source_symbol = @external_account,
                    @create = "Y",
                    @report = @report
            
            if @external_account_id = NULL
            begin
            
                select
                    @issue = "notfound:strategies(name=" + @external_account + ")",
                    @to = "support",
                    @subject = "Couldn't autocreate trader, """ + @symbol + """, due to implementation error",
                    @content = "Trader, """ + @symbol + """, does not exist. r_resolvetrader attempted to create the trader but the external account, """ + @external_account + """, could not be resolved."
                exec
                    r_postmessage
                        @login = @login,
                        @name = @issue,
                        @to = @to,
                        @channel = "System",
                        @subject = @subject,
                        @content = @content,
                        @priority = "High"
                        
                if @report != "N"
                    select
                        status = "Error",
                        message = "Cannot create trader without a external account",
                        trader = @symbol,
                        external_account = @external_account
                        
                return
            end
            
        end
        
        /* FEATURE: traders.rrcode */
        if @rrcode = NULL
            select
                @rrcode = ""
        
        
        /*+-------------------------------------------------------------------* 
         |                           INSERT traders                           | 
         *--------------------------------------------------------------------*/

        exec
            j_nextkey
                "traders",
                @trader_id out
        
        insert into
            traders (
                trader_id,
                symbol,
                tico_account_id,
                default_strategy_id
                /* FEATURE: traders.external_account_id */,
                external_account_id
                /* FEATURE: traders.rrcode */,
                rrcode
            )
            values (
                @trader_id,
                @symbol,
                @user_id,
                @default_strategy_id
                /* FEATURE: traders.external_account_id */,
                @external_account_id
                /* FEATURE: traders.rrcode */,
                @rrcode
            )
        
        if @@rowcount != 1
        begin
        
            select
                @issue = "insert:traders(name=" + @symbol + ")",
                @to = "support",
                @subject = "Failed to create trader",
                @content = "The trader, """ + @symbol + """, does not exist and r_resolvetrader attempted to autocreate it but no row was inserted with (trader_id: " + convert(varchar(10), @trader_id) + ", symbol: '" + @symbol + "', tico_account_id: " + convert(varchar(10), @user_id) + ", default_strategy_id: " + convert(varchar(10), @default_strategy_id) + ").",
                @check_sql = "if exists(select * from traders where name = """ + @symbol + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
            exec
                r_manageissue
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High",
                    @check_sql = @check_sql
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Couldn't add trader",
                    trader = @symbol
            
            return
        end
        
        /*+-------------------------------------------------------------------* 
         |                       INSERT trader_symbols                        | 
         *--------------------------------------------------------------------*/

        if @source_symbol != NULL
        begin
        
            insert into
                trader_symbols (
                    trader_id,
                    source_id,
                    symbol
                )
                values (
                    @trader_id,
                    @source_id,
                    @source_symbol
                )
        
            if @@rowcount != 1
            begin
            
                select
                    @issue = "insert:trader_symbols(symbol=" + @source_symbol + ")",
                    @to = "support",
                    @subject = "Failed to create trader symbol, """ + @source_symbol + """, for trader, """ + @symbol +  """, for source, """ + @source + """",
                    @content = "The trader_symbol, """ + @source_symbol + """, does not exist and r_resolvetrader attempted to autocreate it but no row was inserted with (trader_id: " + convert(varchar(10), @trader_id) + ", source_id: " + convert(varchar(10), @source_id) + ", symbol: '" + @symbol + "').",
                    @check_sql = "if exists(select * from trader_symbols where trader_id = " + convert(varchar(10), @trader_id) + " and source_id = " + convert(varchar(10), @source_id) + " and symbol = '" + @source_symbol + "') exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
                exec
                    r_manageissue
                        @login = @login,
                        @name = @issue,
                        @to = @to,
                        @channel = "System",
                        @subject = @subject,
                        @content = @content,
                        @priority = "High",
                        @check_sql = @check_sql
                        
                if @report != "N"
                    select
                        status = "Error",
                        message = "Couldn't add trader symbol",
                        trader = @symbol,
                        symbol = @source_symbol
                
            end
            
        end
        
        select
            @create = "Y"
    
        select
            @to = "support",
            @subject = "Trader, """ + @symbol + """, created",
            @content = "The trader, """ + @symbol + """, was created by " + @login + " on behalf of " + @source + "."
        exec
            r_postmessage
                @login = @login,
                @to = @to,
                @channel = "General",
                @subject = @subject,
                @content = @content,
                @priority = "Low"
                
    end
    else
    begin

        select
            @issue = "notfound:traders(name=" + @symbol + ")",
            @to = "support",
            @subject = "Trader, """ + @symbol + """, not found",
            @content = "The trader, """ + @symbol + """, could not be found.",
            @check_sql = "if exists(select * from traders where name = """ + @symbol + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
        exec
            r_manageissue
                @login = @login,
                @name = @issue,
                @to = @to,
                @channel = "System",
                @subject = @subject,
                @content = @content,
                @priority = "High",
                @check_sql = @check_sql
                
        if @report != "N"
            select
                status = "Error",
                message = "Trader not found",
                trader = @symbol
        
        return
    end
    
end

select
    @symbol = a.symbol,
    @user_id = b.account_id,
    @user = b.login,
    @default_strategy_id = c.strategy_id,
    @default_strategy = c.name,
    @source_symbol = d.symbol
from
    traders a
join
    tico_accounts b	on a.tico_account_id = b.account_id
join
    strategies c on a.default_strategy_id = c.strategy_id
left outer join
    trader_symbols d on 
        a.trader_id = d.trader_id
    and
        d.source_id = @source_id
where
    a.trader_id = @trader_id

go
