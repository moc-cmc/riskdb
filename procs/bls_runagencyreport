use
	risk_cantorny
go

if object_id("bls_runagencyreport") != NULL
	drop procedure
		bls_runagencyreport
go

create procedure
	bls_runagencyreport
		@login varchar(50),
		@run varchar(50),
		@begin_date datetime = NULL,
		@end_date datetime = NULL,
		@deal_id int = NULL
as

declare @start_bench datetime
declare @last_bench datetime
declare @run_id int
declare @fo_commit_type_id int
declare @last_commit_date datetime
declare @deal_begin_date datetime
declare @deal_end_date datetime
declare @bo_prev_date datetime
declare @bo_begin_date datetime
declare @bo_end_date datetime

/* MARK: CREATE TABLE #meta */
create table
	#meta (
		meta_type varchar(25),
		name varchar(25),
		action varchar(25) NULL,
		value varchar(25) NULL,
	)

/* MARK: CREATE TABLE #messages */
create table
	#messages (
		id int identity,
		subject varchar(50),
		message varchar(50)
	)
select @start_bench = getdate(), @last_bench = getdate()

/* MARK: FIND @run_id */
select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run
	
if @run_id = NULL
begin
	select
		status = "Error",
		message = "No such run",
		run = @run
	return
end

/* MARK: FIND @last_commit_date */
select
	@fo_commit_type_id = transaction_type_id
from
	transaction_types
where
	name = "Front Office Commit"

select
	@last_commit_date = max(transaction_date)
from
	int_account_transactions
where
	transaction_type_id = @fo_commit_type_id
	

/* MARK: CALC @begin_date and @end_date */

/* Default @begin_date and @end_date to deal range */
if @deal_id != NULL
begin

	select
		@deal_begin_date = min(trade_date),
		@deal_end_date = max(value_date)
	from
		trades
	where
		deal_id = @deal_id
	and
		quantity != 0

	if @begin_date = NULL or @begin_date < @deal_begin_date
		select
			@begin_date =  @deal_begin_date

	if @end_date = NULL or @end_date < @deal_end_date
		select
			@end_date =  @deal_end_date
	
end

/* Default @begin_date and @end_date to @last_commit_date */
if @begin_date = NULL
	select
		@begin_date = @last_commit_date,
		@end_date = @last_commit_date
if @end_date = NULL
	select
		@end_date = @begin_date

/* Coerce @begin_date and @end_date into days */
select
	@begin_date = convert(datetime, convert(varchar(10),
		dateadd(hour, 7, @begin_date), 102)),
	@end_date = convert(datetime, convert(varchar(10),
		dateadd(hour, 7, @end_date), 102))

/* Calculate @bo_begin_date and @bo_end_date as trading days */
select
	@bo_begin_date = dateadd(day, case datepart(weekday, @begin_date)
		when 1 then 1 when 7 then 2 else 0 end, @begin_date),
	@bo_end_date = dateadd(day, case datepart(weekday, @end_date)
		when 1 then 1 when 7 then 2 else 0 end, @end_date)

/* Calculate @begin_date and @end_date as date range */
select
	@begin_date = dateadd(hour, 17,
		dateadd(day, case datepart(weekday, @begin_date)
			when 2 then -3 else -1 end, @begin_date)),
	@end_date = dateadd(hour, 17, @bo_end_date)

select
	run = @run,
	bo_begin_date = @bo_begin_date,
	bo_end_date = @bo_end_date,
	begin_date = @begin_date,
	end_date = @end_date

/* Date Debug
select
	bo_begin_date = @bo_begin_date,
	begin_date = @begin_date,
	bo_end_date = @bo_end_date,
	end_date = @end_date
*/

/* BENCH */
insert into #messages select "Set up", "Took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @last_bench, getdate()))) + " ms" 
select @last_bench = getdate()

/* MARK: CREATE TABLE #run_traders, #run_strategies, etc. */

create table
	#run_traders(
		trader_id int)
insert into
	#run_traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
insert into #messages select "Run Filter", "Trader: " + b.symbol from #run_traders a, traders b where a.trader_id = b.trader_id order by b.symbol
if @@rowcount = 0
begin
	insert into #messages select "Run Filter", "Trader: ALL"
	insert into
		#run_traders
	select
		trader_id
	from
		traders	
end

create table
	#run_strategies(
		strategy_id int)
insert into
	#run_strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
insert into #messages select "Run Filter", "Strategy: " + b.name from #run_strategies a, strategies b where a.strategy_id = b.strategy_id order by b.name
if @@rowcount = 0
begin
	insert into #messages select "Run Filter", "Strategy: ALL"
	insert into
		#run_strategies
	select
		strategy_id
	from
		strategies	
end

