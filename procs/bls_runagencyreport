	insert into #messages select "Run Filter", "Internal Account: ALL"
	insert into
		#run_internal_accounts
	select
		internal_account_id
	from
		internal_accounts	

create table
	#run_counterparties(
		counterparty_id int)
insert into
	#run_counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
insert into #messages select "Run Filter", "Counterparty: " + b.name from #run_counterparties a, counterparties b where a.counterparty_id = b.counterparty_id order by b.name
if @@rowcount = 0
	insert into #messages select "Run Filter", "Counterparty: ALL"
	insert into
		#run_counterparties
	select
		counterparty_id
	from
		counterparties	

create table
	#run_brokers(
		broker_id int)
insert into
	#run_brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
insert into #messages select "Run Filter", "Broker: " + b.symbol from #run_brokers a, brokers b where a.broker_id = b.broker_id order by b.symbol
if @@rowcount = 0
	insert into #messages select "Run Filter", "Broker: ALL"
	insert into
		#run_brokers
	select
		broker_id
	from
		brokers	

/* BENCH */
insert into #messages select "Set up run filters", "Took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @last_bench, getdate()))) + " ms" 
select @last_bench = getdate()

/* MARK: CREATE TABLE #deal_ids */
create table
	#deal_ids (
		deal_id int
	)

/* MARK: FIND #deal_ids from trades */
if @deal_id != NULL
begin
	insert into
		#deal_ids
	select distinct
		deal_id
	from
		trades a,
		#run_internal_accounts c,
		#run_external_accounts d,
		#run_traders e,
		#run_counterparties f,
		#run_brokers g,
		#run_strategies h
	where
		a.quantity != 0
	and
		a.internal_account_id = c.internal_account_id
	and
		a.external_account_id = d.external_account_id
	and
		a.trader_id = e.trader_id
	and
		a.counterparty_id = f.counterparty_id
	and
		a.broker_id = g.broker_id
	and
		a.strategy_id = h.strategy_id
	and
		a.trade_date < @end_date
	and
		a.value_date >= @begin_date
	and
		a.deal_id = @deal_id
end
else
begin
	insert into
		#deal_ids
	select distinct
		deal_id
	from
		trades a,
		#run_internal_accounts c,
		#run_external_accounts d,
		#run_traders e,
		#run_counterparties f,
		#run_brokers g,
		#run_strategies h
	where
		a.quantity != 0
	and
		a.internal_account_id = c.internal_account_id
	and
		a.external_account_id = d.external_account_id
	and
		a.trader_id = e.trader_id
	and
		a.counterparty_id = f.counterparty_id
	and
		a.broker_id = g.broker_id
	and
		a.strategy_id = h.strategy_id
	and
		a.trade_date < @end_date
	and
		a.value_date >= @begin_date
end

/* DEBUG
select deal_id from #deal_ids order by deal_id
return */

/* BENCH */
insert into #messages select "Search for #deal_ids", "Took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @last_bench, getdate()))) + " ms (" + convert(varchar(10), @@rowcount) + " rows)" 
