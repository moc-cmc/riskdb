/* MARK: - CALC #trades: Trades and positions P&L */

/* 
 *  Cases:  . . . B . . . E . .
 *  1:      -___-_x_x_x            
 *                A   B              -> { trade_pl = 0, position_pl = B - A }
 *  2:      -___-_x_x_x_x_x____
 *                A       B          -> { trade_pl = 0, position_pl = B - A }
 *  3:              x_x_x
 *                  A   B            -> { trade_pl = A, position_pl = B - A }
 *  4:              x_x_x_x____
 *                  A     B          -> { trade_pl = A, position_pl = B - A }
 *  5:       
 */

/* MARK: . Cases 3, 4: Calculate A */
update
	#trades
set
	begin_pl = realized_pl_to_date + unrealized_pl_to_date
from
	#trades a,
	#committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, b.bo_trade_date)
and
	b.bo_trade_date >= @bo_begin_date

/* BENCH */
insert into #messages select "P&L: Calc A Case 3, 4", "Took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @last_bench, getdate()))) + " ms (" + convert(varchar(10), @@rowcount) + " rows)"
select @last_bench = getdate()

/* MARK: . Cases 1, 2: Calculate A */
update
	#trades
set
	begin_pl = realized_pl_to_date + unrealized_pl_to_date
from
	#trades a,
	#committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, @bo_begin_date)
and
	b.bo_trade_date < @bo_begin_date
and
	b.value_date > @begin_date

/* BENCH */
insert into #messages select "P&L: Calc A Case 1, 2", "Took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @last_bench, getdate()))) + " ms (" + convert(varchar(10), @@rowcount) + " rows)"
select @last_bench = getdate()

/* MARK: . Case 5: Use default begin_pl = 0 */


/* MARK: . Cases 1, 3: Calculate B */

/* chriso: we only want position pl that was accrued during the range. let's
 * exclude position pl where the reval_date is not in the @bo_begin_date and
 * @bo_end date range */
update
	#trades
set
	end_pl = b.realized_pl_to_date + b.unrealized_pl_to_date
from
	#trades a,
	#committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, b.value_date)
and
	b.value_date <= @end_date
and
	b.value_date > @begin_date

/* BENCH */
insert into #messages select "P&L: Calc B Case 1, 3", "Took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @last_bench, getdate()))) + " ms (" + convert(varchar(10), @@rowcount) + " rows)"
select @last_bench = getdate()

/* MARK: . Cases 2, 4: Calculate B */
update
	#trades
set
