/* MARK: CREATE #committed_daily_revals from trades */
create table
	#committed_daily_revals (
		trade_daily_reval_id int,
		trade_id int,
		bo_trade_date datetime,
		source_id int,
		status_id int,
		contract_id int NULL,
		contract_qty int null,
		value_date datetime,
		reval_date datetime,
		close_price float null,
		native_value float null,
		forward_id int null,
		delta float null,
		gamma float null,
		theta float null,
		tau float null,
		native_currency_id int null,
		product_id int null,
		evaluation_currency_id int null,
		evaluation_value float null,
		price_change_to_date float null,
		native_realized_pl_to_date float null,
		native_unrealized_pl_to_date float null,
		realized_pl_to_date float null,
		unrealized_pl_to_date float null,
		premium_ccy_id int null,
		premium float null,
		evaluation_premium float null,
		premium_settle_date datetime null,
		notional_amount float null,
		evaluation_notional float null
	)

/*
 *  Cases:  . . . B . . . E . .
 *  1:      -___-_x_x_x
 *  2:      -___-_x_x_x_x_x____
 *  3:              x_x_x
 *  4:              x_x_x_x____
 *  5:      -_-                   - Both trade_date and value_date are before @begin_date
 *          ^   ^ ^^^^^^^^^
 *  ->      ^^^^^^^^^^^^^^^
 *
 *
 *                           [4]
 *                1   2   3   4   5   6   7
 *  client: ABC   |---|---|---|---|---|---|   <-- Case 2
 *  street: BOA   |---|---|   |   |   |   |   <-- Case 5:  begin_pl = 0, end_pl = 0
 *  street: JPM   |---|---|   |   |   |   |   <-- Case 5:  begin_pl = 0, end_pl = 0
 *
 */

/* MARK: INSERT #committed_daily_revals */
insert into
	#committed_daily_revals
(
	trade_daily_reval_id,
	trade_id,
	bo_trade_date,
	source_id,
	status_id,
	contract_id,
	contract_qty,
	value_date,
	reval_date,
	close_price,
	native_value,
	delta,
	gamma,
	theta,
	tau,
	native_currency_id,
	product_id,
	evaluation_currency_id,
	evaluation_value,
	price_change_to_date,
	native_realized_pl_to_date,
	native_unrealized_pl_to_date,
	realized_pl_to_date,
	unrealized_pl_to_date,
	premium_ccy_id,
	premium,
	evaluation_premium,
	premium_settle_date,
	notional_amount,
	evaluation_notional,
	forward_id
)
select
	b.trade_daily_reval_id,
	b.trade_id,
	b.bo_trade_date,
	b.source_id,
	b.status_id,
	b.contract_id,
	b.contract_qty,
	b.value_date,
	b.reval_date,
	b.close_price,
	b.native_value,
	b.delta,
	b.gamma,
	b.theta,
	b.tau,
	b.native_currency_id,
	b.product_id,
	b.evaluation_currency_id,
	b.evaluation_value,
	b.price_change_to_date,
	b.native_realized_pl_to_date,
	b.native_unrealized_pl_to_date,
	b.realized_pl_to_date,
	b.unrealized_pl_to_date,
	b.premium_ccy_id,
	b.premium,
	b.evaluation_premium,
	b.premium_settle_date,
	b.notional_amount,
	b.evaluation_notional,
	b.forward_id
from
	#trades a,
	committed_daily_revals b
where 
	a.trade_id = b.trade_id
and
	b.reval_date <= @end_date
and
	convert(date, b.reval_date) in (
		convert(date, b.bo_trade_date),
		convert(date, b.value_date),
		convert(date, @bo_begin_date),
		convert(date, @bo_end_date)
	)

