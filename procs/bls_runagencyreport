/* MAKER: UPDATE #trades: attribution */
update 
	#trades
set
	/* notional percentage */
	taker_attribution = a.taker_notional / b.total_taker_notional,
	maker_attribution = a.maker_notional / b.total_maker_notional,
	sales_code_attribution = a.sales_code_notional / b.total_sales_code_notional,
	/* trade pl */
	taker_trade_pl = b.total_trade_pl * (a.taker_notional / b.total_taker_notional),
	maker_trade_pl = b.total_trade_pl * (a.maker_notional / b.total_maker_notional),
	sales_code_trade_pl = b.total_trade_pl * (a.sales_code_notional / b.total_sales_code_notional),
	/* pos pl */	
	taker_position_pl = b.total_position_pl * (a.taker_notional / b.total_taker_notional),
	maker_position_pl = b.total_position_pl * (a.maker_notional / b.total_maker_notional),
	sales_code_position_pl = b.total_position_pl * (a.sales_code_notional / b.total_sales_code_notional)
from
	#trades a,
	#deals b
where
	a.deal_id = b.deal_id

