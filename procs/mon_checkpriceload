
drop procedure mon_checkpriceload 
go

create procedure
	mon_checkpriceload	

as

declare @weekday varchar(12)
declare @today datetime
declare @max_price_date datetime

select
        @weekday = datename(weekday, getdate())

if (@weekday = 'Saturday' or @weekday = 'Sunday')
begin
        return
end
 
select
	@max_price_date = max(price_date)
from
	prices

select
	@today = getdate()

if (convert(date, @today) != convert(date, @max_price_date))
begin
	select
		Status = "Failed",
		msg = "Prices not loaded"
	return
end

select
	Status = "Ok",
	msg = "Price loaded"

go

