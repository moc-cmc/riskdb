drop procedure cbo_wipevolumecache
go

create procedure
	cbo_wipevolumecache
		@login varchar(50),
		@trade_date datetime

as


select
	@trade_date = convert(date, @trade_date)

delete from
	trade_type_volumes
where
	volume_date = @trade_date


delete from
        account_volumes
where
        volume_date = @trade_date


delete from
	counterparty_volumes
where
	volume_date = @trade_date


delete from
	contract_volumes
where
	volume_date = @trade_date


delete from
	trader_volumes
where
	volume_date = @trade_date


delete from
	strategy_volumes
where
	volume_date = @trade_date


delete from
	broker_volumes
where
	volume_date = @trade_date


delete from
	sales_code_volumes
where
	volume_date = @trade_date


go

	














