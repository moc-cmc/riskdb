

create or replace procedure
		r_addworkorder
			@login varchar(25),
			@title	varchar(250),
			@client varchar(50),
			@request_date	datetime,
			@change_type	varchar(100),
			@expiration	datetime,
			@pivotal_id	varchar(12),
			@req_number 	int=NULL		
as

declare @client_id	int
declare @change_type_id	int
declare @external_account_type_id int
declare @work_order_req_id	int

select
	@external_account_type_id=external_account_type_id
from
	external_account_types
where
	name="Client"

if @@rowcount != 1
begin
	select
		status="Error",
		msg="External Account Type Does Not Exist",
		account_type="Client"
	return
end

select
	@client_id=external_account_id
from
	external_accounts
where
	name=@client
and
	external_account_type_id=@external_account_type_id

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Client does not exist",
		client=@client
	return
end

select
	@change_type_id=change_type_id
from
	change_types
where
	name=@change_type

if @@rowcount != 1
begin
	select 
		status="Error",
		msg="Change Type does not exist",
		change_type=@change_type
	return
end


if (@req_number = NULL)
begin
	
	exec
		j_nextkey "work_order_reqs", @work_order_req_id out

end
else
begin
	select
		@work_order_req_id = @req_number
end

insert into
	work_order_reqs (
		work_order_req_id,
		title,
		client_id,
		req_date,
		change_type_id,
		expiration,
		pivotal_id,
		setup_fees_billed,
		monthly_fees_billed)
values (
		@work_order_req_id,
		@title,
		@client_id,
		@request_date,
		@change_type_id,
		@expiration,
		@pivotal_id,
		"No",
	        "No" )

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Could not insert Work Order Request",
		title=@title	

	return
end

select
	status="Success",
	msg="Work Order Request	added",
	title=@title

exec
	r_getworkorders @login

go


       
