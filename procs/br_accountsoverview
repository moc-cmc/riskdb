use
	risk_finotec
go

drop procedure
	br_accountsoverview
go

create procedure
	br_accountsoverview
		@login varchar(50),
		@run_name varchar(50)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @fund_id int
declare @run_id int
declare @ordering int
declare @ids int
declare @id int
declare @oid int
declare @oids int
declare @sql varchar(255)
declare @transaction_type_id int
declare @tico_label varchar(50)
declare @final_select varchar(255)
declare @amount float
declare @update_sql varchar(255)
declare @evaluation_currency_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"perspective_contract",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"evaluate",
	"Evaluate Indicators",
	NULL) 

insert into
	 #meta
select
	meta_type = "Column Format",
	tico_label,
	action = "Number",
	value =  "#,##0.00"
from
	transaction_types

insert into
	 #meta
values(
	 "Column Format",
	 "equiv",
	 "Number",
	 "#,##0.00")

insert into
	 #meta
values(
	 "Column Format",
	 "activity",
	 "Number",
	 "#,##0.00")

insert into
	 #meta
values(
	 "Column Format",
	 "change",
	 "Number",
	 "#,##0.00")

insert into
	 #meta
values(
	 "Column Format",
	 "begin_balance",
	 "Number",
	 "#,##0.00")

insert into
	 #meta
values(
	 "Column Format",
	 "end_balance",
	 "Number",
	 "#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evalution Currency not found"
	return
end


if @run_name = NULL
begin
	select
		@run_name = name
	from
		funds
	where
		fund_id = @fund_id
end


if @begin_date = NULL
begin
	if @end_date = NULL
	begin
		select
			@end_date = getdate()
		exec
			r_daterangefordate
				@end_date,
				@begin_date output,
				@end_date output
	end
end

if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end
create table
	#external_accounts(
		external_account_id int)

insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#transaction_types(
		transaction_type_id int)

insert into
	#transaction_types
select
	transaction_type_id
from
	transaction_type_preferences

create table
	#account_transactions(
		account_transaction_id int,
		entered_by int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		currency_id int,
		amount float,
		note varchar(255) NULL)
insert into
	#account_transactions
select
	a.account_transaction_id,
	a.entered_by,
	a.external_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.currency_id,
	a.amount,
	a.note
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date


create table
	#report_transactions(
		id int identity,
		transaction_type_id int,
		name varchar(100),
		ordering int NULL)
insert into
	#report_transactions(
		transaction_type_id,
		name)
select
	a.transaction_type_id,
	b.name
from
	#transaction_types a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
order by
	b.name

update
	#report_transactions
set
	a.ordering = b.ordering
from
	#report_transactions a,
	transaction_type_preferences b
where
	a.transaction_type_id = b.transaction_type_id

select
	@ordering = max(ordering)
from
	#report_transactions
if @ordering = NULL
	update
		#report_transactions
	set
		ordering = id
else
	update
		#report_transactions
	set
		ordering = @ordering * id
	where
		ordering = NULL


create table
	#begin_balances(
		external_account_id int,
		currency_id int,
		begin_balance float)
insert into
	#begin_balances
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date < @begin_date
group by
	a.external_account_id,
	a.currency_id

create table
	#end_balances(
		external_account_id int,
		currency_id int,
		end_balance float)
insert into
	#end_balances
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date <= @end_date
group by
	a.external_account_id,
	a.currency_id


create table
	#transaction_totals(
		external_account_id int,
		currency_id int,
		amount float)
insert into
	#transaction_totals
select
	a.external_account_id,
	a.currency_id,
	sum(amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
group by
	a.external_account_id,
	a.currency_id


/* REPORT */
create table
	#report(
		id int identity,
		external_account_id int,
		account varchar(50),
		currency_id int,
		currency varchar(50),
		begin_balance float NULL,
		end_balance float NULL,
		other float NULL,
		activity float NULL,
		change float NULL,
		evaluation_currency_id int NULL,
		equiv float NULL)

insert into
	#report(
		external_account_id,
		account,
		currency_id,
		currency,
		evaluation_currency_id)
select
	a.external_account_id,
	b.symbol,
	a.currency_id,
	c.symbol,
	evaluation_currency_id = @evaluation_currency_id
from
	#transaction_totals a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
order by
	b.symbol,
	c.symbol
	

update
	#report
set
	a.begin_balance = b.begin_balance
from
	#report a,
	#begin_balances b
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = b.currency_id

update
	#report
set
	a.end_balance = b.end_balance
from
	#report a,
	#end_balances b
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = b.currency_id

update
	#report
set
	begin_balance = 0.0
where
	begin_balance = NULL
	
select
	@final_select = "select section = 'Account Details', account, currency, begin_balance",
	@update_sql = "update #report set activity = 0.0"


create table
	#type_nets(
		external_account_id int,
		currency_id int,
		amount float)
create table
	#ordered_ids(
		oid int identity,
		id int)
insert into
	#ordered_ids(
		id)
select
	id
from
	#report_transactions
order by
	ordering


select
	@oid = 0
select
	@oids = count(*)
from
	#ordered_ids
where
	oid > @oid
while @oids > 0
begin
	select
		@oid = min(oid)
	from
		#ordered_ids
	where
		oid > @oid

	select
		@id = id
	from
		#ordered_ids
	where
		oid = @oid

	select
		@tico_label = b.tico_label,
		@transaction_type_id = a.transaction_type_id
	from
		#report_transactions a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.id = @id

	select
		@sql = 'alter table #report add ' + rtrim(@tico_label) + ' float NULL'

	exec(@sql)

	truncate table
		#type_nets

	insert into
		#type_nets
	select
		external_account_id,
		currency_id,
		sum(amount)
	from
		#account_transactions
	where
		transaction_type_id = @transaction_type_id
	group by
		external_account_id,
		currency_id

	select
		@sql = "update #report set a." + rtrim(@tico_label) + " = b.amount from #report a, #type_nets b where a.external_account_id = b.external_account_id and a.currency_id = b.currency_id"

	exec(@sql)

	select
		@sql = "update #report set " + rtrim(@tico_label) + " = 0.0 where " + rtrim(@tico_label) + " = NULL"

	exec(@sql)

	select
		@final_select = rtrim(@final_select) + ", " + @tico_label,
		@update_sql = rtrim(@update_sql) + " + " + rtrim(@tico_label) 

	select
		@oids = count(*)
	from
		#ordered_ids
	where
		oid > @oid
end

update
	#report
set
	change = end_balance - begin_balance

select
	@final_select = rtrim(@final_select) + ", other, end_balance, change, equiv  from #report  order by id"

exec(@update_sql)

update
	#report
set
	other = end_balance - activity - begin_balance

update
	#report
set
	equiv = end_balance
where
	currency_id = @evaluation_currency_id

update
	#report
set
	a.equiv = a.end_balance * c.price
from
	#report a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, @end_date) = convert(date, c.price_date)

update
	#report
set
	a.equiv = a.end_balance * 1.0 / c.price
from
	#report a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.currency_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, @end_date) = convert(date, c.price_date)
and
	a.equiv = NULL
and
	c.price != 0.0






create table
	#ccy_sum(
		section varchar(200) NULL,
		style varchar(255) NULL,
		currency varchar(50),
		begin_balance float NULL,
		end_balance float NULL,
		change float NULL)
insert into
	#ccy_sum(
		currency,
		begin_balance,
		end_balance,
		change)
select
	currency,
	begin_balance = sum(begin_balance),
	end_balance = sum(end_balance),
	change = sum(change)
from
	#report
group by
	currency

update
	#ccy_sum
set
	section = "Totals By Currency",
	style = "background:#FFFFFF;border: 1px solid white"

select
	section = "Account Summary Run",
	style = "background:#FFFFFF;border: 1px solid white",
	run_name = @run_name,
	begin_date = @begin_date,
	end_date = @end_date

select
	section,
	style,
	currency,
	begin_balance,
	activity = change,
	end_balance
from
	#ccy_sum
order by
	currency
	

exec(@final_select) 


go




