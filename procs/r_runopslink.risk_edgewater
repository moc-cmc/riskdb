use risk_edgewater
go

drop procedure
	r_runopslink
go

create procedure
	r_runopslink
		@login varchar(50),
		@op_task varchar(255)
as


if @op_task = "View Option Model Parameters"
begin
	exec
		r_options
	return
end

if @op_task = "Run Expiration Tool"
begin
	exec
		r_expirytimesfordate
			@login
	return
end

if @op_task = "Edit Current Prices"
begin
	exec
		r_currentprices
			@login
	return
end

if @op_task = "Volume Runs"
begin
	exec
		cn_volreport
			@login
	return
end

if @op_task = "Edit Settle Prices"
begin
	exec
		cl_currentsettles
			@login,
			NULL
end

if @op_task = "Perspective Contracts"
begin
	exec
		r_defperspectivecontracts
			@login
end

if @op_task = "Link Unhedged Deals"
begin
	exec
		r_unhedgeddeals
			@login,
			NULL,
			NULL
end

if @op_task = "Assign Trades"
begin
	exec
		r_assigntrades
			@login,
			NULL,
			NULL
end

if @op_task = "Manage Client Notifications"
begin
	exec
		r_manageclientnotifications
			@login
end

if @op_task = "Risk Classes"
begin
	exec
		ag_riskclasses
			@login
end

if @op_task = "Flattening Runs"
begin
	exec
		ag_flatteningruns
			@login
end



go
