drop procedure r_editopstask
go

create procedure
	r_editopstask
		@login varchar(50),
		@task_id int,
		@task_name varchar(100)=NULL,
		@task_group varchar(30)=NULL,
		@assigned_to_login varchar(50)=NULL,
		@status varchar(20)=NULL,
		@ordering int = NULL,
		@task_date datetime=NULL,
		@as_of_date datetime=NULL

as

exec
	api_editopstask
		@login = @login,
		@ops_task_id = @task_id,
		@name = @task_name,
		@ops_task_type = @task_group,
		@status = @status,
		@ordering = @ordering,
		@assigned_to = @assigned_to_login,
		@task_date = @task_date

exec
	r_manageopstasks
		@login=@login,
		@as_of_date = @as_of_date


go

