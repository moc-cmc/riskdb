drop procedure
	tt_tradeairtally
go

create procedure
        tt_tradeairtally
                @source varchar(50),
                @default_login varchar(50),
                @broker varchar(50)=NULL, /* Provided by FIX server config.properties & spring.xml */
                @sender_comp varchar(50),
                @target_comp varchar(50),
                @execution_id varchar(100)=NULL,
                @trade_date datetime,
                @trading_day datetime,
                @symbol varchar(50),
                @ccy1 varchar(3),
		@ccy2 varchar(3),
                @qty1 float,
                @price float,
		@far_price float,
                @value_date datetime,
		@fixing_date datetime,
		@far_value_date datetime,
                @side varchar(10),
                @order_id varchar(50),
                @cl_order_id varchar(50)=NULL,
                @order_orig_firm varchar(50)=NULL,
                @order_orig_trader varchar(50)=NULL,
                @executing_firm varchar(50)=NULL,
		@executing_trader varchar(50)=NULL,
		@entering_firm varchar(50)=NULL,
		@entering_trader varchar(50)=NULL,
		@broker_of_credit varchar(50)=NULL,
                @contra_firm varchar(50)=NULL,
                @person varchar(50)=NULL,
		@secondary_order_id varchar(50)=NULL,
                @sponsoring_firm varchar(50)=NULL,
		@trade_report_id varchar(50)=NULL,
                @granularity varchar(15)=NULL /* Provided by FIX server config.properties & spring.xml */

as

declare @lookup_trdr varchar(50)
declare @cl_or_lp varchar(5)
declare @trade_report_status int
