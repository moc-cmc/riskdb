 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end


/* We need to figure out of this is a client or LP message using fund_agency_traders */
select
	@lookup_trdr = @entering_firm

select
	@cl_or_lp = "LP"
from
	traders a,
	trader_symbols b,
	fund_agency_traders c
where
	a.trader_id = b.trader_id
and
	a.trader_id = c.trader_id
and
	b.source_id = @source_id
and
	b.symbol = @lookup_trdr

if @cl_or_lp = NULL
begin
	select
		@cl_or_lp = "CL"
end

select
	client_or_lp = @cl_or_lp


if @cl_or_lp = "CL"
begin
	select
		@lookup_trader = rtrim(@entering_firm)+"-"+rtrim(@entering_trader),
		@lookup_cpty = rtrim(@executing_trader)
end
else
begin
	select
		@lookup_trader = rtrim(@entering_firm),
		@lookup_cpty = rtrim(@executing_firm)
end

	/*
	* CHECK to see if this requires a manufactured B2B
	*/
	select
        	@cl_create = cl_create,
        	@lp_create = lp_create
	from
        	ticket_creation_values
	where
        	trigger_symbol = @lookup_trader
	and
        	source_id = @source_id
	if @@rowcount != 0
	begin
        	select
                	@trigger_symbol = @lookup_trader
	end


	/*
	* CHECK FOR SUPPRESSION
	*/
	select
		@suppress_trade = "Y"
	from
		suppression_symbols
	where
		source_id = @source_id
	and
		symbol = @lookup_trader
	
	/*
 	* LOOKUP @trader_id, @trader, @trader_login, @external_account_id
 	*/

	select
        	@trader_id = a.trader_id,
        	@trader = a.symbol,
        	@trader_login = c.login,
        	@external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	tico_accounts c
	where
        	a.trader_id = b.trader_id
	and
        	b.source_id = @source_id
	and
        	a.tico_account_id = c.account_id
	and
        	b.symbol = @lookup_trader
	
	if @trader_id = NULL or @trader_login = NULL
	begin
    		select
            		@trader_id = a.trader_id,
            		@trader = a.symbol,
            		@trader_login = c.login,
            		@external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where
            		a.tico_account_id = c.account_id
    		and
            		a.symbol = @lookup_trader
	
			if @trader_id = NULL or @trader_login = NULL
			
			begin
        			select
            				status = "Error",
            				message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            				lookup_trader = @lookup_trader
        			return
			end
	end

	/*
 	* LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 	*/

	select
        	@counterparty_id = a.counterparty_id,
        	@counterparty = a.name,
        	@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = @source_id
	and
        	b.symbol = @lookup_cpty
	if @counterparty = NULL
	begin
        	select
                	@counterparty_id = a.counterparty_id,
                	@counterparty = a.name,
                	@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
	
        	if @counterparty = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
                        	lookup_cpty = @lookup_cpty
                	return
        	end
	end

	if @cl_or_lp = "CL"
	begin
        	/*
	 	* LOOKUP @external_account, @external_account_type based on @external_account_id
 		*/
		select
    			@external_account = a.symbol,
    			@external_account_type = b.name,
    			@aggregation_style = c.name
		from
    			external_accounts a,
    			external_account_types b,
    			aggregation_styles c
		where
    			a.external_account_type_id = b.external_account_type_id
		and
    			a.aggregation_style_id = c.aggregation_style_id
		and
  			a.external_account_id = @external_account_id
		if @external_account = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find external_account from @external_account_id",
				external_account_id = @external_account_id
			return
		end
	end
	if @cl_or_lp = "LP"
	begin
                /*
                * LOOKUP @external_account, @external_account_type based on @external_account_id
                */
                select
                        @external_account = a.symbol,
                        @external_account_type = b.name,
                        @aggregation_style = c.name
                from
                        external_accounts a,
                        external_account_types b,
                        aggregation_styles c
                where
                        a.external_account_type_id = b.external_account_type_id
                and
                        a.aggregation_style_id = c.aggregation_style_id
                and
                        a.external_account_id = @cpty_ext_acct_id
                if @external_account = NULL
                begin
                        select
                                status = "Error",
                                message = "Couldn't find external_account from @cpty_ext_acct_id",
                                external_account_id = @cpty_ext_acct_id
                        return
                end
	end

	select
		@trade_identifier = rtrim(@trade_report_id)+convert(char(8), @trading_day, 112)+".c",
                @deal_type = "B2B Forward",
		@deal_exec_symbol = rtrim(@order_id)

	if @cl_or_lp = "CL"
	begin
	select
		@qty1 = -@qty1 /* Flip qty because ticket is from perpective of client. So client BUY is really agency/fund SELL */
	end

/* select ctpy values 
begin
