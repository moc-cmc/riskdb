		@mkt_lookup_trader = @sender_comp,
		@mkt_lookup_cpty = rtrim(@executing_firm)+"-"+rtrim(@executing_trader)

	/*
        * CHECK FOR SUPPRESSION
        */
        select
                @mkt_suppress_trade = "Y"
        from
                suppression_symbols
        where
                source_id = @source_id
        and
                symbol = @mkt_lookup_cpty

	/*
        * LOOKUP @mkt_trader_id, @mkt_trader, @mkt_trader_login, @mkt_external_account_id
        */

        select
