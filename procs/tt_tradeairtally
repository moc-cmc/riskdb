select
	cli_lookup_trdr = @lookup_trader,
	cli_lookup_ctpy = @lookup_cpty /*,
	mkt_lookup_trdr = @mkt_lookup_trader,
	mkt_lookup_ctpy = @mkt_lookup_cpty */

select
	@trade_type = "Spot",
	@tally_type = "Spot"

/*
select
        @ccy1 = substring(@symbol, 1, 3),
	@ccy2 = substring(@symbol, 4, 3) 
*/

select
        @trade_id = trade_id
from
        trades
where
        identifier = @trade_identifier
if @@rowcount != 0
begin
        select
                status="Dupe",
                msg="Trade already tallied",
                identifier=@trade_identifier,
                trade_id = @trade_id


        return
end


declare @substring1 varchar(10)
declare @substring2 varchar(10)

/* Tradair provides CCY1, check for inverted pair */
if @ccy1 != NULL and @ccy2 != NULL
begin
        select
                @substring1 = substring(@symbol, 1, 3),
                @substring2 = substring(@symbol, 4, 6)

        if @substring1 != @ccy1
        begin
                select
                        @symbol = @substring2 + @substring1,
                        @inverted = "Y"
        end

end



if @side = "SELL"
begin
    select
        @qty1 = -@qty1
end

select
	@mkt_qty1 = -@qty1

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1,
                	@ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end


if @far_price != NULL
begin
	select
		@trade_type = "Swap Near",
		@far_trade_type = "Swap Far",
		@tally_type = "Swap",
		@deal_type = "B2B Swap"
end

select
	@status_id = status_id
from
	statuses
where
	name = "Active"


if @deal_id = NULL
begin
	select
		@deal_id = deal_id
	from
		deal_exec_symbols
	where
		symbol = @deal_exec_symbol
end


if @deal_id = NULL
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    )
end
else
begin
	select
		msg = "Appending to existing deal"

	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = 'B2B Forward'
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for 'B2B Forward'"
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
end

if @cl_create = "Y" and @lp_create = "Y"
begin
        select
                msg = "Creating new deal to separate auto-generated tickets"


        select
                @auto_b2b_deal_status_id = status_id
        from
                statuses
        where
                name = "User Review"
        if @auto_b2b_deal_status_id = NULL
        begin
                select
                        status = "Error",
                        message = "No status found named, 'User Review'"
                return
        end
        select
                @auto_b2b_deal_type_id = deal_type_id
        from
                deal_types
        where
                name = @deal_type
        if @auto_b2b_deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for @deal_type",
                        deal_type = @deal_type
                return
        end

        exec
                j_nextkey
                        "deals",
                        @auto_b2b_deal_id output

        insert into
                deals(
                        deal_id,
                        deal_type_id,
                        timestamp,
                        status_id
                        )
                values(
                        @auto_b2b_deal_id,
                        @auto_b2b_deal_type_id,
                        getdate(),
                        @auto_b2b_deal_status_id
                        )

        insert into
                deal_exec_symbols
        values(
                @auto_b2b_deal_id,
                rtrim(@deal_exec_symbol)+".autob2b"
        )
end


if @suppress_trade = "Y" and @mkt_suppress_trade = "Y"
begin
	select
                trade_report_id=@trade_report_id,
                symbol = @ccy1+"/"+@ccy2,
                status="ACCEPTED"

        return
end		
  
/*handle client tally */ 
if @suppress_trade = "Y"
begin
	select
		msg = "Suppressing client trade"

end
else
begin
	declare @tally_deal_id int

        if  @cl_create = "Y" and @lp_create = "Y"
        begin
                select
                        @tally_deal_id = @auto_b2b_deal_id
        end
        else
        begin
                select
                        @tally_deal_id = @deal_id
        end

 
	exec
		fxa_tallytrade
			@login = @trader_login,
			@source = @source,
			@trade_id = @trade_id out,
			@deal_id = @tally_deal_id out,
			@tally_type = @tally_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@quantity = @qty1,
			@symbol = @symbol,
