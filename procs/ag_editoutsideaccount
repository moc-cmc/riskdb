create or replace procedure
	ag_editoutsideaccount
		@login varchar(50),
		@legal_entity varchar(150),
		@outside_account varchar(100)=NULL,
		@outside_account_type varchar(100)=NULL,
		@provider_name varchar(100)=NULL,
		@name varchar(100)=NULL,
		@account_number varchar(100)=NULL,
		@account_code varchar(100)=NULL,
		@account_code_type varchar(50)=NULL

as

declare @outside_account_id int
declare @legal_entity_id int

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @legal_entity_id = NULL
begin
        select
                status = "Error",
                message = "Problem finding legal entity from provided",
                legal_entity = @legal_entity
        return
end

select
	@outside_account_id = outside_account_id
from
	outside_accounts
where
	legal_entity_id = @legal_entity_id
and
	name = @outside_account
if @outside_account_id = NULL
begin
	select 
		status = "Error",
		message = "Problem finding ouside account from provided",
		outside_account = @outside_account,
		legal_entity = @legal_entity
	return
end
exec
	api_editoutsideaccount
		@login=@login,
		@outside_account_id=@outside_account_id,
		@outside_account_type=@outside_account_type,
		@provider_name=@provider_name,
		@name=@name,
		@account_number=@account_number,
		@account_code=@account_code,
		@account_code_type=@account_code_type


exec
	ag_viewaccountinstructions
		@login = @login,
		@legal_entity = @legal_entity,
		@outside_account = @outside_account

go

