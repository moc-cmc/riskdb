drop procedure
	ag_uncommitvolumes
go

create procedure
	ag_uncommitvolumes
		@login varchar(50),
		@trade_date datetime
as


delete
	account_snapshots
from
	account_snapshots a,
	transaction_types b
where
	convert(date, a.snapshot_date) = convert(date, @trade_date)
and
	a.transaction_type_id = b.transaction_type_id
and
	lower(b.name) like "%volume%"




