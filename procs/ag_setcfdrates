drop procedure
	ag_setcfdrates
go

create procedure
	ag_setcfdrates
		@login varchar(50),
		@symbol varchar(50),
		@settle_date datetime,
		@settle_price float,
		@rate float,
		@days float,
		@exchange_rate float
as

declare @contract_id int
declare @status_id int
declare @cer_id int
declare @rate_date datetime

select
	@rate_date = convert(datetime, convert(date, @settle_date))
select
	@rate_date = dateadd(hour, 17, @rate_date)

select
	@status_id = status_id
from
	statuses
where
	name = "Prelim"
if @status_id = NULL
begin
	exec
		j_nextkey
			"statuses",
			@status_id output

	insert into
		statuses
	values(
		@status_id,
		"Prelim")
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

update
	cfd_eod_rates
set
	status_id = @status_id,
	rate = @rate,
	days = @days,
	exchange_rate = @exchange_rate
where
	contract_id = @contract_id
and
	convert(date, rate_date) = convert(date, @rate_date)
if @@rowcount = 0
begin
	exec
		j_nextkey
			"cfd_eod_rates",
			@cer_id output

	insert into
		cfd_eod_rates(
			cer_id,
			contract_id,
			rate_date,
			status_id,
			rate,
			days,
			exchange_rate)
	values(
		@cer_id,
		@contract_id,
		@rate_date,
		@status_id,
		@rate,
		@days,
		@exchange_rate)
end

select settle_date= @settle_date
exec
	ag_cfdsettles
		@login,
		@settle_date

go	
	
