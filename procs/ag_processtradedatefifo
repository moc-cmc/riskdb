exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


create table
	#positions(
		id int identity,
		external_account_id int,
		contract_id int,
		value_date datetime,
		position numeric(30,4))

insert into
	#positions(
		external_account_id,
		contract_id,
		value_date,
		position)
select
	a.external_account_id,
	a.contract_id,
	a.value_date,
	sum(a.quantity)
from
	trades a,
	forwards b,
	products c,
	product_types d
where
	a.contract_id = b.contract_id
and
	b.product_id = c.product_id
and
	c.product_type_id = d.product_type_id
and
	d.name = "CFD"
and
	a.trade_date < @end_date
and
	a.value_date >= @begin_date
group by
	a.external_account_id,
	a.contract_id,
	a.value_date


select
	@id = 0
select
	@ids = count(*)
from
	#positions
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#positions
	where
		id > @id


	select
		@external_account_id = NULL,
		@external_account = NULL,
		@contract_id = NULL,
		@symbol = NULL,
		@value_date = NULL

	select
		@external_account_id = external_account_id,
		@contract_id = contract_id,
		@value_date = value_date
	from
		#positions
	where
		id = @id

	select
		@external_account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	select
		@symbol = symbol
	from
		contracts
	where
		contract_id = @contract_id

	/* select
		external_account = @external_account,
		trade_date = @trade_date,
		symbol = @symbol,
		value_date = @value_date */

	exec
        	ag_processcontractfifo
                	@login = @login,
                	@external_account = @external_account,
                	@trade_date = @trade_date,
                	@symbol = @symbol,
                	@value_date = @value_date


	select
		@ids = count(*)
	from
		#positions
	where
		id > @id
end
