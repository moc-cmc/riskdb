
if object_id("r_claccounts") != NULL
    drop procedure
        r_claccounts
go

create procedure r_claccounts
as

declare @cl_account_type_id int

select
	@cl_account_type_id=external_account_type_id
from
	external_account_types
where
	name="Client"


select
	name
from
	external_accounts
where
	external_account_type_id=@cl_account_type_id
order by
	name


go
