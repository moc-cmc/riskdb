drop procedure
	mn_accounttrades
go

create procedure
	mn_accounttrades
		@login varchar(50),
		@run_name varchar(50),
		@trade_date datetime=NULL

as

declare @run_id int
declare @begin_date datetime
declare @end_date datetime
declare @total_allocation int


create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Column Link",
        "current_allocation",
        "Allocate Deal",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "edit_trade",
        "Deal Trade Inspector",
        NULL)


insert into
        #meta
values(
        "Column Link",
        "other_allocation",
        "Other Allocations",
        NULL)


insert into
        #meta
values(
        "Column Link",
        "unallocate",
        "Unallocate Deal",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "manage",
        "Managed Accounts",
        NULL)


insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "id",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "run_name",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "commit_deal",
        "Commit Allocated Deal",
        NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "uncommit_deal",
        "Uncommit Allocated Deal",
        NULL)


select * from #meta

select
        @run_id = a.run_id
from
        runs a,
        user_runs b,
        tico_accounts c
where
        a.run_id = b.run_id
and
        b.tico_account_id = c.account_id
and
        c.login = @login
and
        a.name = @run_name
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Problem finding run with name",
                run = @run_name
        return
end

if @trade_date = NULL
        select
                @trade_date = getdate()

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output

create table
        #traders(
                trader_id int)
insert into
        #traders
select
        trader_id
from
        run_traders
where
        run_id = @run_id
if @@rowcount = 0
begin
        insert into
                #traders
        select
                trader_id
        from
                traders
end

create table
        #strategies(
                strategy_id int)
insert into
        #strategies
select
        strategy_id
from
        run_strategies
where
        run_id = @run_id
if @@rowcount = 0
begin
        insert into
                #strategies
        select
                strategy_id
        from
                strategies
end

create table
        #external_accounts(
                external_account_id int)
insert into
        #external_accounts
select
        external_account_id
from
        run_external_accounts
where
        run_id = @run_id
if @@rowcount = 0
begin
        insert into
                #external_accounts
        select
                external_account_id
        from
                external_accounts
end

create table
        #internal_accounts(
                internal_account_id int)
insert into
        #internal_accounts
select
        internal_account_id
from
        run_internal_accounts
where
        run_id = @run_id
if @@rowcount = 0
        insert into
                #internal_accounts
        select
                internal_account_id
        from
                internal_accounts
create table
        #brokers(
                broker_id int)
insert into
        #brokers
select
        broker_id
from
        run_brokers
where
        run_id = @run_id
if @@rowcount = 0
        insert into
                #brokers
        select
                broker_id
        from
                brokers

create table
        #counterparties(
                counterparty_id int)
insert into
        #counterparties
select
        counterparty_id
from
        run_counterparties
where
        run_id = @run_id
if @@rowcount = 0
        insert into
                #counterparties
        select
                counterparty_id
        from
                counterparties

create table
        #deal_counts(
                deal_id int,
                legs int,
		quantity numeric(30,4),
                ma_version_id int NULL)

insert into
        #deal_counts(
                deal_id,
                legs,
		quantity)
select
        a.deal_id,
        count(a.trade_id),
	sum(a.quantity)
from
        trades a,
        #external_accounts b,
        #internal_accounts c,
        #traders d,
        #strategies e,
        #brokers f,
        #counterparties g
where
        a.external_account_id = b.external_account_id
and
        a.internal_account_id = c.internal_account_id
and
        a.trader_id = d.trader_id
and
        a.strategy_id = e.strategy_id
and
        a.broker_id= f.broker_id
and
        a.counterparty_id = g.counterparty_id  /*
and
        a.trade_date >= @begin_date
and
        a.trade_date <= @end_date */
group by
        a.deal_id

update
        #deal_counts
set
        a.ma_version_id = b.ma_version_id
from
        #deal_counts a,
        deal_ma_versions b
where
        a.deal_id = b.deal_id


/*
* Allocation Info for Active Versions*
*/

create table
        #allocations(
                id int identity,
                section varchar(100) NULL,
		style varchar(50) NULL,
                master_allocation_id int NULL,
		master_allocation_name varchar(50) NULL,
                deployment_date datetime NULL,
		version int NULL,
                account varchar(50) NULL,
                allocation_mode varchar(50) NULL,
                status varchar(50) NULL,
                allocation float NULL,
		ma_version_id int NULL,
		manage varchar(50) NULL)
insert into
        #allocations(
                section,
		style,
                master_allocation_id,
		master_allocation_name,
                deployment_date,
		version,
                account,
                allocation_mode,
                status,
		ma_version_id,
		manage)

select
        section = "Active Allocation Template",
	style = "background:#FFFFCC;border: 1px solid white",
        a.master_allocation_id,
	a.name,
        deployment_date = b.deployment_date,
	version = b.version,
        account = c.symbol,
        allocation_mode = d.name,
        status = e.name,
	b.ma_version_id,
	manage = "Change Active Version"
from
        master_allocations a,
	ma_versions b,
	external_accounts c,
        allocation_modes d,
        statuses e
where
	a.master_allocation_id = b.master_allocation_id
and
        a.external_account_id = c.external_account_id
and
        b.allocation_mode_id = d.allocation_mode_id
and
        b.status_id = e.status_id
and
	e.name = "Active"

create table
	#allocation_amounts(
		master_allocation_id int,
		allocation float)
insert into
	#allocation_amounts
select
	a.master_allocation_id,
	allocation = 1 - sum(f.allocation)
from
	master_allocations a,
        ma_versions b,
        external_accounts c,
        allocation_modes d,
        statuses e,
        sub_accounts f
where
        a.master_allocation_id = b.master_allocation_id
and
        a.external_account_id = c.external_account_id
and
        b.allocation_mode_id = d.allocation_mode_id
and
        b.status_id = e.status_id
and
        e.name = "Active"
and
        b.ma_version_id = f.ma_version_id
group by
	a.master_allocation_id

update
	#allocations
set
	a.allocation = b.allocation
from
	#allocations a,
	#allocation_amounts b
where
	a.master_allocation_id = b.master_allocation_id


insert into
        #allocations(
                section,
		style,
		master_allocation_id,
                account,
                allocation)
select
        section = "Active Allocation Template",
	style = "background:#FFFFFF;border: 1px solid white",
	d.master_allocation_id,
        b.symbol,
        a.allocation
from
        sub_accounts a,
        external_accounts b,
        #allocations c,
	ma_versions d
where
        a.external_account_id = b.external_account_id
and
	a.ma_version_id = c.ma_version_id
and
	a.ma_version_id = d.ma_version_id
	

select
        section,
	style,
	master_allocation_name,
        deployment_date = convert(varchar(20),deployment_date),
        account,
        allocation,
        allocation_mode,
	version,
        status,
	manage
from
        #allocations
order by
	master_allocation_id,
        id

create table
        #unallocated(
                id int identity,
		run_name varchar(50) NULL,
                section varchar(200) NULL,
                deal_id int NULL,
                trade_id int NULL,
                trade_date datetime NULL,
                account varchar(50) NULL,
                quantity numeric(30,4) NULL,
                symbol varchar(50) NULL,
                value_date datetime NULL,
                price float NULL,
                status varchar(50) NULL,
		commit_deal varchar(50) NULL, 
                current_allocation varchar(50) NULL,
		other_allocation varchar(50) NULL,
		edit_trade varchar(50) NULL )
insert into
        #unallocated(
		run_name,
                section,
                deal_id,
                trade_id,
                trade_date,
                account,
                quantity,
                symbol,
                value_date,
                price,
                status,
		commit_deal,
                current_allocation,
		other_allocation,
		edit_trade)
select
	run_name = @run_name,
        section = "Unallocated Deals",
        a.deal_id,
        a.trade_id,
        a.trade_date,
        account = b.symbol,
        a.quantity,
        c.symbol,
        a.value_date,
        a.price,
        f.name,
	commit_deal = "Commit",
        current_allocation = "Allocate to Current",
	other_allocation = "Allocate to Other",
	edit_trade = "Edit"
	
from
        trades a,
        external_accounts b,
        contracts c,
        statuses f,
	#deal_counts g,
	deals h,
	external_account_types i
where
        a.deal_id = g.deal_id
and
	a.deal_id = h.deal_id
and
        a.external_account_id = b.external_account_id
and
	b.external_account_type_id = i.external_account_type_id
and
	i.name = "Master"
and
        a.contract_id = c.contract_id
and
        h.status_id = f.status_id
and
        f.name not in("Committed", "Allocated")
order by
        a.deal_id

select
	run_name,
        section,
        deal_id,
        trade_id,
        trade_date = convert(varchar(11), trade_date, 1),
        account,
        quantity,
        symbol,
        value_date = convert(varchar(11), value_date, 1),
        price,
        status,
	commit_deal,
        current_allocation,
	other_allocation,
	edit_trade 
from
        #unallocated
order by
        id

create table
        #allocated(
                id int identity,
		run_name varchar(50) NULL,
                section varchar(200) NULL,
                style varchar(200) NULL,
                deal_id int NULL,
                trade_id int NULL,
		series varchar(50) NULL,
                trade_date datetime NULL,
                external_account_id int NULL,
                account varchar(50) NULL,
                quantity numeric(30,4) NULL,
                allocation float NULL,
                symbol varchar(50) NULL,
                value_date datetime NULL,
                price float NULL,
                status varchar(50) NULL,
                commit_deal varchar(50) NULL,
		unallocate varchar(50) NULL,
		edit_trade varchar(50) NULL )
insert into
        #allocated(
		run_name,
                section,
                style,
                deal_id,
                trade_id,
                trade_date,
                external_account_id,
                account,
                quantity,
                allocation,
                symbol,
                value_date,
                price,
                status,
                commit_deal,
		unallocate,
		edit_trade)
select
	run_name = @run_name,
        section = "Allocated Deals",
        style = "background:#FFFFFF;border: 1px solid white",
        a.deal_id,
        a.trade_id,
        a.trade_date,
        a.external_account_id,
        account = b.symbol,
        a.quantity,
        allocation = case
                when
                        g.quantity != 0
                then
                        round(a.quantity / g.quantity, 3)
                else
                        NULL
        end,
        c.symbol,
        a.value_date,
        a.price,
        f.name,
        commit_deal = "Commit",
	unallocate = "Unallocate",
	edit_trade = "Edit"
from
        trades a,
        external_accounts b,
        contracts c,
        statuses f,
	#deal_counts g,
	deals h
where
        a.deal_id = g.deal_id
and
	a.deal_id = h.deal_id
and
        a.external_account_id = b.external_account_id
and
        a.contract_id = c.contract_id
and
        h.status_id = f.status_id
and
        f.name = "Allocated"
order by
        a.deal_id,
        a.trade_id
update
        #allocated
set
        a.deal_id = NULL,
        a.status = NULL,
        a.commit_deal = NULL,
	unallocate = NULL,
	edit_trade = NULL
from
        #allocated a,
        external_accounts b,
        external_account_types c
where
        a.external_account_id = b.external_account_id
and
        b.external_account_type_id = c.external_account_type_id
and
        c.name != "Master"

update
	#allocated
set
	series = c.name+" Version "+convert(char(20),b.version)
from
	#allocated a,
	ma_versions b,
	master_allocations c,
	deal_ma_versions d
where
	a.deal_id = d.deal_id
and
	d.ma_version_id = b.ma_version_id
and
	b.master_allocation_id = c.master_allocation_id

update
        #allocated
set
        style = "background:#CCFFFF;border: 1px solid white"
where
        deal_id != NULL


select
	run_name,
        section,
        style,
        deal_id,
        trade_id,
        trade_date = convert(varchar(11), trade_date, 1),
        account,
        quantity,
        allocation,
        symbol,
        value_date = convert(varchar(11), value_date, 1),
        price,
        status,
	series,
        commit_deal,
	unallocate,
	edit_trade 
from
        #allocated
order by
        id

create table
        #deals(
                deal_id int NULL,
                trade_id int NULL,
                trade_date datetime NULL,
                external_account_id int NULL,
                contract_id int NULL,
                value_date datetime NULL,
                quantity numeric(30,4) NULL,
                price float NULL)
insert into
        #deals(
                deal_id,
                trade_date,
                contract_id,
                value_date,
                quantity,
                price)
select
        a.deal_id,
        max(a.trade_date),
        a.contract_id,
        a.value_date,
        sum(a.quantity),
        max(a.price)
from
        trades a,
        #deal_counts b,
        statuses c,
	deals d
where
	a.deal_id = b.deal_id
and
	a.deal_id = d.deal_id
and
        d.status_id = c.status_id
and
        c.name = "Committed"
group by
        a.deal_id,
        a.contract_id,
        a.value_date

update
        #deals
set
        a.trade_id = b.trade_id,
        a.external_account_id = b.external_account_id
from
        #deals a,
        trades b,
        external_accounts c,
        external_account_types d
where
        a.deal_id = b.deal_id
and
        b.external_account_id = c.external_account_id
and
        c.external_account_type_id = d.external_account_type_id
and
        d.name = "Master"

create table
        #committed_deals(
                id int identity,
		run_name varchar(50) NULL,
                section varchar(200) NULL,
                trade_id int NULL,
                deal_id int NULL,
                trade_date datetime NULL,
                account varchar(50) NULL,
                quantity numeric(30,4) NULL,
                symbol varchar(50) NULL,
                value_date datetime NULL,
                price float NULL,
                notification_status varchar(50) NULL,
		uncommit_deal varchar(50))
insert into
        #committed_deals(
		run_name,
                section,
                trade_id,
                deal_id,
                trade_date,
                account,
                quantity,
                symbol,
                value_date,
                price,
		uncommit_deal)
select
	run_name = @run_name,
        section = "Committed Deals",
        a.trade_id,
        a.deal_id,
        a.trade_date,
        account = b.symbol,
        a.quantity,
        c.symbol,
        a.value_date,
        a.price,
	uncommit_deal = "Uncommit"
from
        #deals a,
        external_accounts b,
        contracts c
where
        a.external_account_id = b.external_account_id
and
        a.contract_id = c.contract_id
order by
        a.deal_id,
        a.contract_id,
        a.value_date

update
        #committed_deals
set
        a.notification_status = c.name
from
        #committed_deals a,
        trade_notifications b,
        statuses c
where
        a.trade_id = b.trade_id
and
        b.status_id = c.status_id

select
	run_name,
        section,
        deal_id,
        trade_date = convert(varchar(11), trade_date, 1),
        account,
        quantity,
        symbol,
        value_date = convert(varchar(11), value_date, 1),
        price,
        notification_status,
	uncommit_deal
from
        #committed_deals
order by
        id


go
