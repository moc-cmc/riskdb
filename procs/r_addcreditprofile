drop procedure r_addcreditprofile
go

create procedure
	r_addcreditprofile
		@login varchar(50),
		@name varchar(50),
		@nop_limit numeric(30,4),
		@dsl_limit numeric(30,4),
		@currency varchar(10),
		@nop_type varchar(25),
		@dsl_type varchar(25),
		@notice_level float,
		@warning_level float,
		@blocked_level float

as

/*
   default_credit_profile_values exists, but is implemented through tico by using 
   hidden columns instead of NULL values here in this proc
*/
declare @credit_profile_id int
declare @nop_type_id int
declare @dsl_type_id int
declare @currency_id int

select
	@currency_id = product_id
from
	products
where
	symbol = @currency
if @currency_id = NULL
begin
	select
		error="Error",
		msg="Currency not found", @currency
	return
end

select
	@nop_type_id=nop_type_id
from
	nop_types
where
	name=@nop_type
if @nop_type_id = NULL
begin
	select
		error="Error",
		msg="NOP Type not found ", @nop_type
	return
end

select
	@dsl_type_id=dsl_type_id
from
	dsl_types
where
	name=@dsl_type
if @dsl_type_id = NULL
begin
	select
		error="Error",
		msg="DSL Type not found", @dsl_type
	return
end


exec
	j_nextkey 
		"credit_profiles",
		@credit_profile_id output

insert into
	credit_profiles(
		credit_profile_id,
		name,
		currency_id,
		nop_type_id,
		nop_limit,
		dsl_type_id,
		dsl_limit,
		notice_level,
		warning_level, 
		blocked_level)
values(
	@credit_profile_id,
	@name,
	@currency_id,
	@nop_type_id,
	@nop_limit,
	@dsl_type_id,
	@dsl_limit,
	@notice_level,
	@warning_level,
	@blocked_level
)
if @@rowcount = 1
begin
	select
		status = "Successfully created Credit Profile",
		name = @name
end

exec
	r_managecreditprofile
		@login


go

	
