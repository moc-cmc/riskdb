
drop procedure
	api_editextacctsymbol
go

create procedure
	api_editextacctsymbol 
			@login varchar(25),
			@name varchar(150),
			@source_name varchar(150),
			@mapping varchar(100),
			@new_mapping varchar(100)

as

declare @external_account_id int
declare @source_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where
	name=@name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="External Account does not exist",
		external_account=@name

	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source_name

	return
end

begin tran
	update 
		external_account_symbols
	set
		symbol=@new_mapping
	where
		external_account_id=@external_account_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount !=1)
	begin
		select
			status="Error",
			msg="Could not edit External Account Mapping",
			mapping=@mapping

		rollback tran

		return
	end

commit tran

select
	status="Success",
	msg="External Account Mapping Edited",
	name=@name

exec
	r_mappingoverview @login

return

go

