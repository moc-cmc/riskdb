
drop procedure 
	r_standardlogins
go

create procedure 
	r_standardlogins
as

	select 
		name=a.login
	from
		tico_accounts a,
		tico_account_types b,
		login_types c 
	where
		a.account_id=b.tico_account_id
	and
		b.login_type_id=c.login_type_id
	and
		c.name not in ("Client", "Elysium","Disabled")

go


