create or replace procedure
	r_checkmasterorsubtype
		@external_account varchar(100),
		@account_type varchar(50) output

as

declare @external_account_id int
declare @is_master char(1)
declare @is_sub char(1)

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding acccount",
		external_account = @external_account
	return
end

select
	@account_type = "BO Master"
from
	bo_master_accounts
where
	external_account_id = @external_account_id

if @account_type != NULL
	return

select
	@account_type = "FO Sub"
from
	fo_sub_accounts
where
	external_account_id = @external_account_id


go
