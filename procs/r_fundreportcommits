
if object_id("r_fundreportcommits") != NULL
    drop procedure
        r_fundreportcommits
go

create procedure
    r_fundreportcommits
        @login char(50),
        @begin_date datetime=NULL,
        @end_date datetime=NULL
as

declare @cursor_date datetime
declare @now_date datetime
declare @ttl int

select
    @now_date = getdate()

/*
 * If @end_date is null, use today. If @begin_date is null, back it up a week.
 */
if @end_date = null
    select
        @end_date = @now_date
if @begin_date = null
    select
        @begin_date = dateadd(day, 0, @end_date)


/*
 * Offset by one business day if the time is after 17:00.
 */
if @begin_date != null and datepart(hour, @begin_date) > 17
    exec
        r_nextbusinessday
            @begin_date,
            @begin_date output
if @end_date != null and datepart(hour, @end_date) > 17
    exec
        r_nextbusinessday
            @end_date,
            @end_date output

select
    @begin_date = convert(datetime, convert(varchar(10), @begin_date, 101)),
    @end_date = convert(datetime, convert(varchar(10), @end_date, 101))

create table
    #meta (
        meta_type char(50),
        name char(50) NULL,
        action char(100) NULL,
        value char(200) NULL
    )
    
insert into
    #meta
select
    "Column Link",
    "week",
    "FX Recon",
    NULL
insert into
    #meta
select
    "Column Link",
    "mtd",
    "FX Recon",
    "beginDate=" + ltrim(str(datepart(month, @now_date))) + "/1/" + ltrim(str(datepart(year, @now_date))) + "&endDate=" + convert(char(10), @now_date, 101)
insert into
    #meta
select
    "Column Link",
    "ytd",
    "FX Recon",
    "beginDate=" + "1/1/" + ltrim(str(datepart(year, @now_date))) + "&endDate=" + convert(char(10), @now_date, 101)

select
    *
from
    #meta
delete
from
    #meta

select
    begin_ = @begin_date,
    end_ = @end_date,
    week = "This Week",
    mtd = "MTD",
    ytd = "YTD"

/* ------------------------- Populate #fund_reports ------------------------- */

/* 
 * Add the fund reports availble for the user
 */
create table
    #account_fund_reports (
        fund_report_id int,
        fund char(50),
        external_report char(50),
        external_report_id int
    )
insert into
    #account_fund_reports
select
    d.fund_report_id,
    c.name,
    e.name,
    e.external_report_id
from
    tico_accounts a,
    fund_tico_accounts b,
    funds c,
    fund_reports d,
    external_reports e
where
    a.account_id = b.tico_account_id
and
    b.fund_id = c.fund_id
and
    b.fund_id = d.fund_id
and
    d.external_report_id = e.external_report_id
and
    a.login = @login
order by
    b.priority,
    e.name
    




/* -------- Populate #report_dates between @begin_date and @end_date -------- */

declare @fund_report_id int
declare @fund char(100)
declare @report char(100)

select
    @cursor_date = @begin_date,
    @ttl = 262
while @cursor_date <= @end_date and @cursor_date != NULL
begin

    declare
        account_fund_reports
    cursor for select
        fund_report_id,
        fund,
        external_report 
    from
        #account_fund_reports
    
    open account_fund_reports
    
    fetch account_fund_reports into
        @fund_report_id,
        @fund,
        @report
    while @@sqlstatus = 0
    begin
        exec
            r_reportcommitfordate
                @fund,
                @report,
                @cursor_date,
                @fund_report_id output
    
        fetch account_fund_reports into
            @fund_report_id,
            @fund,
            @report
    end
    
    close account_fund_reports
    deallocate cursor account_fund_reports
    
    exec r_nextbusinessday
        @cursor_date,
        @cursor_date output
    
    select
        @ttl = @ttl - 1
    if @ttl <= 0
    begin
        select
            message = "Only 1 year's worth of report data can be displayed. Please adjust your begin and end dates."
    end
end


create table
    #fund_report_commits (
        report_commit_id int,
        fund char(100),
        external_report char(100),
        trade_date char(10),
        status char(25)
    )

insert into
    #meta
values (
    "Column Link",
    "action",
    "Reconcile Report",
    NULL
)

select
    *
from
    #meta
delete
from
    #meta

select
	fund = a.fund,
	prime_broker = e.name,
	trade_date = convert(char(10), b.trade_date, 101),
	status = c.name,
	action = "Show Report"
from
	#account_fund_reports a,
	report_commits b,
	statuses c,
	prime_brokers d,
	sources e,
	external_reports f
where
	a.fund_report_id = b.fund_report_id
and
	b.status_id = c.status_id
and
	d.source_id = e.source_id
and
	e.source_id = f.source_id
and
	f.external_report_id = a.external_report_id
and
	b.trade_date >= @begin_date
and
	b.trade_date <= @end_date
order by
	a.fund,
	e.name,
	b.trade_date


