use
	risk_faros
go

if object_id("cbo_agencymis") != NULL
    drop procedure
        cbo_agencymis
go

create procedure
	cbo_agencymis
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @run_id int

select
	@run_id = run_id
from
	runs
where
	name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run name not found"
	return
end

exec
    r_normalizedaterange
        @begin_date,
        @end_date

select
    graphs = '<div style="width:100%"><div id="graphs" style="height:200px;background:#fff;margin:0 -4px;"></div></div>'

create table
	#run_data(
		run_id int,
		trade_date datetime,
		total_volume float,
		daily_pl float,
		total_pl float)
insert into
	#run_data
select
	a.run_id,
        a.trade_date,
        a.total_volume,
        a.total_pl,
        (select sum(total_pl) from run_agency_commits where trade_date <= a.trade_date and trade_date >= @begin_date) as running_total_pl
from
        run_agency_commits a
where
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date
order by
	a.trade_date


select
	run_name = a.name,
	trade_date = convert(char(11), b.trade_date, 1),
	total_volume = convert(numeric(30,2), total_volume / 1e6),
	daily_pl = convert(numeric(30,2), daily_pl),
	total_pl = convert(numeric(30,2), total_pl)
from
	runs a,
	#run_data  b
where
	a.run_id = b.run_id
and
	a.name = @run_name
and
	b.trade_date >= @begin_date
and
	b.trade_date <= @end_date

select
    '<script type="text/javascript">jQuery("#graphs").chart(jQuery(".OutputTable").eq(1), { xaxis:{type:"date"}, y2axis:{}, series:[{x1:1,x2:1,y2:2,plot:"bar"},{x1:1,y1:4,yaxis:"y2"}], bind:{rowStart:2}});</script>'

go
