create or replace procedure
	api_createoutsideaccount
		@login varchar(50),
		@outside_account_type varchar(50),
		@legal_entity varchar(150),
		@provider varchar(50),
		@name varchar(200),
		@account_number varchar(100),
		@account_code varchar(100)=NULL,
		@account_code_type varchar(50)=NULL
		
as


declare @outside_account_id int
declare @outside_account_type_id int
declare @legal_entity_id int
declare @provider_id int
declare @account_code_type_id int

select
	@outside_account_type_id = outside_account_type_id
from
	outside_account_types
where
	name = @outside_account_type
if @outside_account_type_id = NULL
begin
	select
		status = "Error",
		message = "Outside account type not found",
		outside_account_type = @outside_account_type
	return
end

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @legal_entity_id = NULL
begin
	select
		status = "Error",
		message = "Legal entity not found",
		legal_entity = @legal_entity
	return
end

select
	@provider_id = provider_id
from
	providers
where
	name = @provider
if @provider_id = NULL
begin
	exec
		j_nextkey
			"providers",
			@provider_id output
	insert into
		providers(
			provider_id,
			name)
	values(
		@provider_id,
		@provider)
end

select
	@account_code_type_id = outside_account_code_type_id
from
	outside_account_code_types
where
	name = @account_code
if @account_code_type_id = NULL and @account_code != NULL 
begin
	select
		status = "Error",
		message = "Account code type not found",
		account_code_type = @account_code_type
	return
end

exec
	j_nextkey
		"outside_accounts",
		@outside_account_id output

begin tran

	insert into
		pending_outside_accounts(
			outside_account_id,
			outside_account_type_id,
			legal_entity_id,
			provider_id,
			name)
	values	(
		@outside_account_id,
		@outside_account_type_id,
		@legal_entity_id,
		@provider_id,
		@name)
	if @@rowcount != 1 
	begin
		select
			status = "Error",
			message = "Problem adding pending outside account"
		
		rollback tran
		return
	end

	insert into
		outside_account_info(
			outside_account_id,
			account_number,
			account_code,
			account_code_type_id)
	values(
		@outside_account_id,
		@account_number,
		@account_code,
		@account_code_type_id
	)
        if @@rowcount != 1
        begin
                select
                        status = "Error",
                        message = "Problem adding pending outside account info"

                rollback tran
                return
        end
commit tran

	

go



