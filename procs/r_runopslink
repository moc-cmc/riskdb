
drop procedure
	r_runopslink
go
	
create procedure
	r_runopslink
		@login varchar(50),
		@op_task varchar(255)
as


if @op_task = "View Option Model Parameters"
begin
	exec
		r_options
	return
end

if @op_task = "Run Expiration Tool"
begin
	exec
		r_expirytimesfordate
			@login
	return 
end

if @op_task = "Option Expiration Calendar"
begin
	exec
		ag_optioncalendar
			@login
end


if @op_task = "Edit Current Prices"
begin
	exec
		r_currentprices
			@login
	return
end

if @op_task = "Edit Settle Prices"
begin
	exec
		cl_currentsettles 
 			@login,
			NULL
end

if @op_task = "Assign Trades"
begin
	exec
		r_assigntrades
			@login,
			NULL,
			NULL
end


if @op_task = "Recon Blotters"
begin
	exec
		r_reconblotters
			@login
end


if @op_task = "FXL Affirmations"
begin
	exec
		ag_fxlaffirmations
			@login = @login,
			@trade_date = NULL
end

if @op_task = "FSS Balance Recon"
begin
	exec
		ag_fssbalancerecon
			@login = @login,
			@trade_date = NULL
end


if @op_task = "Manage ISIN Codes by PB"
begin
	exec
		r_managepbisins
			@login = @login,
			@trade_date = NULL
end

if @op_task = "File Imports"
begin
	exec
		r_fileimportlinks
			@login = @login
end

if @op_task = "Set Haircut Import Date"
begin
	exec
		ag_sethaircutdate
			@login = @login,
			@trade_date = NULL
end
