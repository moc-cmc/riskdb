insert into
	#trades(
		trade_id,
		deal_id,
		trade_date,
		external_account_id,
		trader_id,
		counterparty_id,
		broker_id,
		contract_id,
		value_date,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		rate)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	a.external_account_id,
	a.trader_id,
	a.counterparty_id,
	a.broker_id,
	h.forward_id,
	a.value_date,
	h.product_id,
	a.quantity * h.quantity,
	h.currency_id,
	(a.quantity * h.quantity) *  a.price * -1.0,
	a.price
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	#future_forward_contracts h
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date >= @trades_begin
and
	a.trade_date < @end_date
