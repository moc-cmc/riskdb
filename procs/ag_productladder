	equiv = balance,
	market_rate = 1.0
where
	product_id = currency_id


create table
	#rates(
		contract_id int NULL,
		price_style varchar(50) NULL,
		product_id int NULL,
		currency_id int NULL,
		rate float NULL,
		display_rate float NULL,
		timestamp datetime NULL,
		derived_timestamp datetime NULL)
insert into
	#rates(
		product_id)
select
	distinct(a.product_id)
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
/* and
	b.name = "Currency" */

update
	#rates
set
	currency_id = @evaluation_currency_id,
	price_style = "Standard"


update
	#rates
set
	a.contract_id = b.contract_id
from
	#rates a,
	forwards b
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id

update
	#rates
set
	rate = 1.0,
	timestamp = getdate()
where
	product_id = currency_id

update
	#rates
set
	a.rate = c.price,
	a.timestamp = c.price_date
from
	#rates a,
	forwards b,
	prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#rates
set
	a.rate = 1.0 / c.price,
	a.timestamp = c.price_date
from
	#rates a,
	forwards b,
	prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#rates
set
	a.rate = c.price,
	a.timestamp = c.timestamp
from
	#rates a,
	forwards b,
	current_prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#rates
set
	a.rate = 1.0 / c.price,
	a.timestamp = c.timestamp
from
	#rates a,
	forwards b,
	current_prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#rates
set
	a.price_style = c.name
from
	#rates a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id

update
	#rates
set
	display_rate = rate


update
	#trades
set
	product_equiv = product_qty
where
	product_id = @evaluation_currency_id
update
	#trades
set
	currency_equiv = currency_qty
where
	currency_id = @evaluation_currency_id


update
	#trades
set
	a.product_equiv = a.product_qty * b.rate
from
	#trades a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

update
	#trades
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#trades a,
	#rates b
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

update
	#balances
set
	a.equiv = a.balance * b.rate
from
	#balances a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id



