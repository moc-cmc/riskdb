update
	#trades
set
	price_style = "Standard",
	display_contract_id = contract_id

update
	#trades
set
	a.deal_type_id = b.deal_type_id
from
	#trades a,
	deals b
where
	a.deal_id = b.deal_id

update
	#trades
set
	ladder_view = "Cash"

update
	#trades
set
	a.ladder_view = "EFP"
from
	#trades a,
	deal_types b
where
	a.deal_type_id = b.deal_type_id
and
	b.name like "%EFP%"
	
update
	#trades
set
	a.price_style = c.name
from
	#trades a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id

update
	#trades
set
	a.display_contract_id = b.contract_id
from
	#trades a,
	forwards b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	a.price_style = "Inverted"

