create table
	#option_trades(
		trade_id int)
insert into
	#option_trades
select
	a.trade_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	option_contracts h
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date >= @trades_begin
and
	a.trade_date < @end_date


insert into
	#trades(
		trade_id,
		deal_id,
		trade_date,
		external_account_id,
		trader_id,
		counterparty_id,
		broker_id,
		contract_id,
		value_date,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		rate)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	a.external_account_id,
	a.trader_id,
	a.counterparty_id,
	a.broker_id,
	a.contract_id,
	a.value_date,
	h.product_id,
	a.quantity,
	h.currency_id,
	a.quantity * a.price * -1.0,
	a.price
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	forwards h
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date >= @trades_begin
and
	a.trade_date < @end_date

create table
	#future_forward_contracts(
		contract_id int,
		forward_id int,
		product_id int,
		currency_id int,
		quantity numeric(30,4))
insert into
	#future_forward_contracts(
		contract_id,
		forward_id,
		product_id,
		currency_id,
		quantity)
select
	a.contract_id,
	b.forward_id,
	c.product_id,
	c.currency_id,
	c.quantity
from
	future_contracts a,
	futures b,
	forwards c
where
	a.future_id = b.future_id
and
	b.forward_id = c.contract_id
and
	a.expiration >= @begin_date

