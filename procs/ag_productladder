update
	#balances
set
	a.bucket_id = b.id
from
	#balances a,
	#buckets b
where
	convert(date, a.value_date) >= convert(date, b.begin_date)
and
	convert(date, a.value_date) <= convert(date, b.end_date)


create table
	#output(
		id int identity,
		style varchar(250) NULL,
		label varchar(100) NULL,
		bucket_id int NULL,
		begin_date datetime NULL,
		end_date datetime NULL)

insert into
	#output(
		style,
		label,
		bucket_id,
		begin_date,
		end_date)
select
	style = @style,
	label,
	id,
	begin_date,
	end_date
from
	#buckets
order by
	id

insert into
	#output(
		style,
		label)
values(
	@total_style,
	"Total")

select
	@final_sql = "select style, label, "


select
	@max_id = max(id)
from
	#all_products

select
	@id = 0
select
	@ids = count(*)
from
	#all_products

while @ids > 0
begin
	select
		@id = min(id)
	from
		#all_products
	where
		id > @id

	select
		@product = NULL,
		@sql = NULL,
		@balance = NULL,
		@product_id = NULL,
		@total = NULL

	select
		@product = product,
		@product_id = product_id
	from
		#all_products
	where
		id = @id

	select
		@total = sum(equiv)
	from
		#balances
	where
		product_id = @product_id

	select
		@sql = "alter table #output add " + rtrim(@product) + " int NULL"
	exec(@sql)

	select
		@sql = "update #output set " + rtrim(@product) + " = 0"
	exec(@sql)

	select
		@sql = "update #output set a." + rtrim(@product) + " = convert(int, b.equiv) from #output a, #balances b where a.bucket_id = b.bucket_id and b.product_id = " + convert(varchar(10), @product_id)


	exec(@sql)
	
	select
		@sql = "update #output set " + rtrim(@product) + " = convert(int, " + convert(varchar(50), convert(numeric(30,4), @total)) + ") where label = 'Total'"
	exec(@sql)

	select
		@final_sql = rtrim(@final_sql) + " " + rtrim(@product) 

	if @id != @max_id
		select
			@final_sql = @final_sql + ", "

	select
		@ids = count(*)
	from
		#all_products
	where
		id > @id
end


select
	@final_sql = @final_sql + " from #output order by id"


exec(@final_sql)

		

