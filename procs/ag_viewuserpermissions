create or replace procedure
	ag_viewuserpermissions
		@login varchar(50),	
		@user_name varchar(50),
		@legal_entity varchar(50)=NULL

as

declare @login_id int
declare @tico_account_id int
declare @legal_entity_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "back",
        "Legal Entities Home",
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "legal_entity",
        NULL,
        NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
        @legal_entity_id = legal_entity_id
from
        legal_entities
where
        name = @legal_entity

select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

select
	style = @style,
	legal_entity = @legal_entity,
	back = "<< Back"

select
	@login_id = account_id
from
	tico_accounts
where
	login = @login
if @login_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @user_name
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "User name not found",
		user_name = @user_name
	return
end


create table
	#client_permissions(
		login varchar(50),
		permission varchar(50))

insert into
	#client_permissions(
		login,
		permission)
select
	@user_name,
	"Request " +name
from
	ledger_request_types


select
	style = @style,
	section = "Access",
	login,
	permission
from
	#client_permissions

go
		
