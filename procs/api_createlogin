
create or replace procedure
	api_createlogin
		@login varchar(50),
		@first_name varchar(50),
		@last_name varchar(50),
		@email varchar(50)=NULL,
		@user_password varchar(25)=NULL,
		@login_type varchar(50),
		@user_name_output varchar(50)=NULL output,
		@tico_access char(1)=NULL
as


declare @login_type_id int
declare @fund_id int
declare @fund_name varchar(50)
declare @run_id int
declare @portfolio_id int
declare @evaluation_currency_id int
declare @aggregation_style_id int
declare @prime_broker_id int
declare @top_level_trader varchar(50)
declare @top_level_trader_id int
declare @tico_account_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)
declare @sales_code_id int
declare @template_account varchar(30)
declare @external_account_type varchar(50)
declare @source_id int
declare @status_id int
declare @pl_view_style_id int
declare @client_give_up_source_id int
declare @nop_type_id int
declare @dsl_type_id int
declare @strategy varchar(50)
declare @strategy_id int
declare @broker varchar(50)

declare @first_inital varchar(1)
declare @user_name varchar(50)
declare @suffix varchar(25)
declare @login_created varchar(10)
declare @login_count int
declare @login_length int

declare @email_id int
declare @pass_length int

if @user_password = NULL
begin
	if @login_type = "Elysium"
	begin
		select
			@pass_length = 6
	end
	else
	begin
		select
			@pass_length = 8	
	end
	exec
		r_genrandompassword
			@pass_length=@pass_length,
			@new_pass=@user_password output
end

select
	@pl_view_style_id = pl_view_style_id
from
        pl_view_styles
where
	name = "Agency"

select
	@login_type_id = login_type_id,
	@template_account = login_template
from
	login_types
where
	name = @login_type
if @login_type_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding login type. Login not created",
		login_type = @login_type,
		first_name = @first_name,
		last_name = @last_name,
		email = @email
	return
end

if @template_account = NULL
begin
	select
		status = "Error",
		msg = "Problem finding a template account for login type. Login not created",
		template_account = @template_account,
                login_type = @login_type,
                first_name = @first_name,
                last_name = @last_name,
                email = @email
	return
end

		

/* Default status is New. Overwrite below, should be a table but we'll manage here in this proc for now */		
select
       	@status_id = status_id
from
       	statuses
where
       	name = "New"

if @login_type = "Client"
begin
	select
		@status_id = status_id
        from
                statuses
        where   
                name = "FXMC Lite"
	if @status_id = NULL
	begin
		exec 
			j_nextkey
				"statuses",
				@status_id output
		insert into
			statuses(
				status_id,
				name)
		values(
			@status_id,
			"FXMC Lite"
		)	
	end

	if @template_account = NULL
	begin
		select
        		@template_account = "template_cao"
	end
end

	
/* Determine user_name */

select
        @first_inital = lower(substring(@first_name, 1, 1))
select
	@suffix = suffix
from
	login_types
where
	name = @login_type

/* default is first initial and lower last name. If special case code below */
select
	@user_name = @first_inital + lower(@last_name)

if @login_type = "Client"
begin
	select
		@user_name = lower(@last_name)
end
if @login_type = "Elysium"
begin
	select
		@user_name = lower(fund_code)
	from
		funds
end

/* remove white space */
select
	@user_name = lower(str_replace(@user_name, " ", null))

select
	@login_created = "Y"
from
	tico_accounts
where
	login like "%"+@user_name+"%"+rtrim(@suffix)

if @login_created = "Y"
begin
	/* user_name is not unique */
	select
		@login_count = count(*)
	from
		tico_accounts
	where
		login like "%"+@user_name+"%"+rtrim(@suffix)
	
	select
		@login_count = @login_count + 1

	/*
	select
		@user_name = @first_inital + lower(@last_name) + convert(varchar(2), @login_count) + @suffix
	*/
	select
                @user_name = @user_name + convert(varchar(5), @login_count) + @suffix
end
else
begin
	/* user_name is unique. set full user_name with suffix */

	/*
	select
		@user_name = @first_inital + lower(@last_name) + @suffix
	*/
	select
		@user_name = @user_name + @suffix
end


select
	@login_length = len(@user_name)

if @login_length > 50 
begin
	select
		status = "Error",
		msg = "please choose a shorter login symbol. Max characters is 25",
                user_name = @user_name,
		len_of_username = @login_length,
		first_name = @first_name,
		last_name = @last_name
	return
end

/* End determine user_name */
	
exec
        j_nextkey
                "tico_accounts",
                @tico_account_id output

insert into
        tico_accounts(
		account_id,
		login,
		password,
		status_id,
		surname,
		given_names)
values(
        @tico_account_id,
        @user_name,
        @user_password,
        @status_id,
        @last_name,
        @first_name)

select
        @tico_server = tico_server,
        @tico_database = tico_database,
        @fund_id = fund_id,
	@fund_name = name
from
        funds


/* Tico Account Types */
insert into
	tico_account_types(
		tico_account_id,
		login_type_id)
values(	
	@tico_account_id,
	@login_type_id
)

insert into
        fund_tico_accounts
values(
        @fund_id,
        @tico_account_id,
        1)


if @pl_view_style_id != NULL
begin
        insert into
                fwd_pl_preferences
        values(
                @tico_account_id,
                @pl_view_style_id,
                1)
end

if @login_type = "Standard"
begin
	insert into
		user_runs(
			tico_account_id,
			run_id)
	select
		@tico_account_id,
		a.run_id
	from
		runs a
	where
		a.name = @fund_name
end

if @email != NULL
begin
	select
		@email_id = email_id
	from
		emails
	where
		email = @email
	if @email_id = NULL
	begin
		exec
			j_nextkey
				"emails",
				@email_id output
		insert into
			emails(
				email_id,
				email)
		values(
			@email_id,
			@email
		)
	end
	insert into
		user_emails(
			tico_account_id,
			email_id)
	values(
		@tico_account_id,
		@email_id
	)
end

if @login_type = "Elysium"
begin
	exec
		r_addaccessgroupforlogin
			@login = @user_name,
			@access_group = "Admin"

        exec
                r_addaccessgroupforlogin
                        @login = @user_name,
                        @access_group = "Login Admin"

end

if upper(convert(char(1), @tico_access)) != "N"
begin
	select
        	@sql_string = "exec " + rtrim(@tico_database) + "..ti_copymanageraccount '" + rtrim(@template_account) + "', '" + rtrim(@user_name) + "', '" + rtrim(@user_password) + "', '" + rtrim(convert(varchar(30), db_name())) + "'"


	exec
        	sp_remotesql
                	@tico_server,
                	@sql_string
end

select
	@user_name_output = @user_name

select
	status = "Success",
	msg = "Login has been created",
	user_name = @user_name,
	user_password = @user_password


go 

