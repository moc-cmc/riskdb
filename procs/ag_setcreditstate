
drop procedure
	ag_setcreditstate 
go
	
create procedure
	ag_setcreditstate 
		@credit_profile varchar(50), 
		@nop_usage float, 
		@dsl_usage float

as


declare @credit_profile_id int
declare @nop_limit float
declare @nop_type_id int
declare @dsl_type_id int
declare @dsl_limit float
declare @notice_level float
declare @warning_level float 
declare @blocked_level float
declare @nop_pct float
declare @dsl_pct float
declare @prev_nop_status varchar(50)
declare @prev_dsl_status varchar(50)
declare @nop_status varchar(50)
declare @dsl_status varchar(50)
declare @nop_status_id int
declare @dsl_status_id int
declare @subject varchar(250)
declare @content varchar(250)
declare @channel varchar(100)
declare @message_type varchar(100)
declare @priority varchar(50)
declare @message_id int
declare @login varchar(50)
declare @ccy varchar(50)
declare @nop_type varchar(50)
declare @dsl_type varchar(50)

select
	@login = rtrim(lower(fund_code)) + ".etg"
from
	funds

select
	@channel = "Credit Alerts",
	@subject = rtrim(@credit_profile) + " ",
	@priority = "High",
	@message_type = "Normal"
select
	@credit_profile_id = a.credit_profile_id,
	@nop_type_id = a.nop_type_id,
	@nop_limit = a.nop_limit,
	@dsl_type_id = a.dsl_type_id,
	@dsl_limit = a.dsl_limit,
	@notice_level = a.notice_level,
	@warning_level = a.warning_level,
	@blocked_level = a.blocked_level,
	@ccy = b.symbol,
	@nop_type = c.name,
	@dsl_type = d.name
from
	credit_profiles a,
	products b,
	nop_types c,
	dsl_types d
where
	a.currency_id = b.product_id
and
	a.nop_type_id = c.nop_type_id
and
	a.dsl_type_id = d.dsl_type_id
and
	a.name = @credit_profile
if @credit_profile_id = NULL
begin
	select
		status = "Error",
		message = "Credit profile not found",
		credit_profile = @credit_profile
	return
end

if @nop_limit = 0.0
	select
		@nop_limit = 0.0000001

if @dsl_limit = 0.0
	select
		@dsl_limit = 0.0000001 


select
	@nop_pct = @nop_usage / @nop_limit,
	@dsl_pct = @dsl_usage / @dsl_limit

select
	@prev_nop_status = a.name
from
	credit_statuses a,
	credit_profile_states b
where
	a.credit_status_id = b.nop_credit_status_id
and
	b.credit_profile_id = @credit_profile_id
if @prev_nop_status = NULL
begin
	select
		@prev_nop_status = "Unknown"
end


select
	@prev_dsl_status = a.name
from
	credit_statuses a,
	credit_profile_states b
where
	a.credit_status_id = b.dsl_credit_status_id
and
	b.credit_profile_id = @credit_profile_id
if @prev_dsl_status = NULL
begin
	select
		@prev_dsl_status = "Unknown"
end


if @nop_pct < @notice_level
	select
		@nop_status = "Normal"

if @nop_pct >= @notice_level and @nop_pct < @warning_level
	select
		@nop_status = "Notice"

if @nop_pct >= @warning_level and @nop_pct < @blocked_level
	select
		@nop_status = "Warning"

if @nop_pct >= @blocked_level
	select
		@nop_status = "Blocked"


if @dsl_pct < @notice_level
	select
		@dsl_status = "Normal"

if @dsl_pct >= @notice_level and @dsl_pct < @warning_level
	select
		@dsl_status = "Notice"

if @dsl_pct >= @warning_level and @dsl_pct < @blocked_level
	select
		@dsl_status = "Warning"

if @dsl_pct >= @blocked_level
	select
		@dsl_status = "Blocked"


select
	@nop_status_id = credit_status_id
from
	credit_statuses
where
	name = @nop_status
if @nop_status_id = NULL
begin
	select
		status = "Error",
		message = "NOP Status not found",
		nop_status = @nop_status
	return
end

select
	@dsl_status_id = credit_status_id
from
	credit_statuses
where
	name = @dsl_status
if @dsl_status_id = NULL
begin
	select
		status = "Error",
		message = "DSL Status not found",
		dsl_status = @dsl_status
	return
end

update
	credit_profile_states
set
	nop_usage = @nop_usage,
	dsl_usage = @dsl_usage,
	nop_credit_status_id = @nop_status_id,
	dsl_credit_status_id = @dsl_status_id,
	timestamp = getdate()
where
	credit_profile_id = @credit_profile_id
if @@rowcount = 0
begin
	insert into
		credit_profile_states(
			credit_profile_id,
			nop_usage,
			dsl_usage,
			nop_credit_status_id,
			dsl_credit_status_id,
			timestamp)
	values(
		@credit_profile_id,
		@nop_usage,
		@dsl_usage,
		@nop_status_id,
		@dsl_status_id,
		getdate())
end

if @prev_nop_status != @nop_status
begin
	select
		@message_id = NULL
	select 
		@subject = @subject + " NOP " + @nop_status,
		@content = @subject + " Usage:" + rtrim(@ccy) + " " + rtrim(convert(varchar(50), convert(money, @nop_usage / 1000000), 1)) + " MM Limit:" + rtrim(@ccy) + " " + rtrim(convert(varchar(50), convert(money, @nop_limit / 1000000), 1)) + " MM " + rtrim(@nop_type) + " NOP"


	exec
		api_sendchannelmessage
			@login = @login,
			@channel = @channel,
			@message_type = @message_type,
			@subject = @subject,
			@content = @content,
			@priority = @priority,
			@message_id = @message_id output

end

if @prev_dsl_status != @dsl_status
begin
	select
		@message_id = NULL
	select 
		@subject = @subject + " DSL " + @dsl_status,
		@content = @subject + " Usage:" + rtrim(@ccy) + " " + rtrim(convert(varchar(50), convert(money, @dsl_usage / 1000000), 1)) + "  MM Limit:" + rtrim(@ccy) + rtrim(convert(varchar(50), convert(money, @dsl_limit / 1000000), 1)) + " MM " + rtrim(@dsl_type) + " DSL"

	exec
		api_sendchannelmessage
			@login = @login,
			@channel = @channel,
			@message_type = @message_type,
			@subject = @subject,
			@content = @content,
			@priority = @priority,
			@message_id = @message_id output

end




go	

