create or replace procedure
	api_addallocationrequest
		@login varchar(50),
		@sub_account varchar(50),
		@product varchar(50),
		@amount numeric(30, 8),
		@allocation_request_id int=NULL output
as

declare @new_status_id int
declare @tico_account_id int
declare @fo_sub_account_id int
declare @product_id int
declare @origination_type_id int
declare @decimal_precision int
declare @origination_type varchar(50)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50))
insert into
	#external_accounts(
		external_account_id,
		symbol)
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	fo_sub_accounts b,
	bo_master_accounts c,
	legal_entity_tico_accounts d
where
	a.external_account_id = b.external_account_id
and
	b.bo_master_account_id = c.bo_master_account_id
and
	c.legal_entity_id = d.legal_entity_id
and
	d.tico_account_id = @tico_account_id

select
	@fo_sub_account_id = a.fo_sub_account_id
from
	fo_sub_accounts a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @sub_account
if @fo_sub_account_id = NULL
begin
	select
		status = "Sub account not found",
		sub_account = @sub_account
	return
end

select
	@product_id = product_id,
	@decimal_precision = decimal_precision,
	@origination_type_id = origination_type_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@origination_type = name
from
	origination_types
where
	origination_type_id = @origination_type_id



/* Default to the more precise version 
if @origination_type = "Fiat"
begin
	select
		@amount = convert(numeric(30, 2), floor(@amount * 100) / 100)
end
else
begin
	select
		@amount = convert(numeric(30, 8), floor(@amount * 100000000) / 100000000)
end
*/

select
	@new_status_id = status_id
from
	statuses
where
	name = "New"
if @new_status_id = NULL
begin
	select
		status = "Error",
		mesage = "Problem finding New status"
	return
end

select
	@allocation_request_id = NULL

/* We need to merge this with ledger requests on the front end
 * and because ID management / formatting would become overly complicated
 * we will use a shared ID by using keys ledger_requests for the allocation
 * request id
 */
exec
	j_nextkey
		"ledger_requests",
		@allocation_request_id output

insert into
	allocation_requests(
		allocation_request_id,
		requestor_id,
		status_id,
		fo_sub_account_id,
		product_id,
		amount,
		request_date)
values(
	@allocation_request_id,
	@tico_account_id,
	@new_status_id,
	@fo_sub_account_id,
	@product_id,
	@amount,
	getdate())

go
