
drop procedure cn_tallyallnettedtrades
go

create procedure cn_tallyallnettedtrades @login varchar(25), @batch_id int
as

declare @trade_id int

declare trade_cursor cursor for

	select
		trade_id 
	from
		batch_trades
	where
		batch_id=@batch_id
	order by
		trade_id

open trade_cursor

fetch  trade_cursor into @trade_id

while (@@sqlstatus = 0)
begin
	
	exec cn_tallynettedtrade @login, @trade_id

	fetch trade_cursor into @trade_id

end
close trade_cursor
deallocate trade_cursor

return

go



