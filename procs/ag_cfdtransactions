/*select
	roll_open_cfds = "Roll Open CFD Positions",
	trade_date = convert(varchar(11), @trade_date)*/

select
	section = "Realized Transactions",
	style,
	account,
	currency,
	realized_pl
from
	#realized_transactions
order by
	id
if @@rowcount != 0
begin
	select
		@was_there_activity = "Y"
end

select
	section = "Round Turns",
	style,
	account,
	symbol,
	entry_id,
	entry_date,
	entry_qty,
	entry_price,
	exit_id,
	exit_date,
	exit_qty,
	exit_price,
	realized_pl,
	currency
from
	#round_turns
order by
	id
if @@rowcount != 0
begin
	select
		@was_there_activity = "Y"
end


select
	section = "Open Trades",
	style = @style,
	account = b.symbol,
	a.trade_id,
	c.symbol,
	a.value_date,
	a.open_amount,
	a.price,
	a.current_price,
	a.unrealized_pl,
	currency = d.symbol
from
	open_trades a,
	external_accounts b,
	contracts c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.currency_id = d.product_id
and
	convert(date, a.trade_date) = convert(date, @trade_date)
order by
	b.symbol,
	c.symbol,
	a.trade_date
if @@rowcount != 0
begin
	select
		@was_there_activity = "Y"
end

select
	section = "Rolled Trades",
	style = @style,
	a.trade_id,
	a.deal_id,
	a.trade_date,
	account = c.symbol,
	d.symbol,
	a.value_date,
	a.quantity,
	a.price
from
	#roll_deals a,
	external_accounts c,
	contracts d
where
	a.external_account_id = c.external_account_id
and
	a.contract_id = d.contract_id
order by
	a.deal_id,
	c.symbol,
	d.symbol,
	a.value_date
if @@rowcount != 0
begin
	select
		@was_there_activity = "Y"
end


if @was_there_activity != "Y"
begin
	select 
		section = "No CFD Activity for Date",
		msg = "There was no CFD activity for date",
		trade_date = @trade_date
end

go
