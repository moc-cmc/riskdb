
drop procedure
	ag_cfdtransactions
go

create procedure
	ag_cfdtransactions
		@login varchar(50),
		@trade_date datetime
as

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @style varchar(250)
declare @unassigned_style varchar(250)
declare @prelim_style varchar(250)
declare @subtotal_style varchar(250)

declare @id int
declare @ids int 
declare @round_turn_id int
declare @contract_id int
declare @external_account_id int
declare @total float
declare @was_there_activity char(1)

declare @cfd_roll_trade_type_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_price",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"roll_open_cfds",
	"Roll Open CFDs",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"process_cfds",
	"Process CFD Trades",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"set_rates",
	"Set CFD Rates",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"set_price",
	"Edit CFD Settle",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"set_quantity",
	"Edit CFD Contract Size",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"realized_pl",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"unrealized_pl",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"daily",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"value",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",

	@unassigned_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@prelim_style = "background:#DCE0DA;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold"


select
	@cfd_roll_trade_type_id = trade_type_id
from
	trade_types
where
	name = "CFD Roll"


create table
	#round_turns(
		id int identity,
		style varchar(250) NULL,
		round_turn_id int NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		entry_id int NULL,
		entry_date datetime NULL,
		entry_qty numeric(30,4) NULL,
		entry_price float NULL,
		exit_id int NULL,
		exit_date datetime NULL,
		exit_qty numeric(30,4) NULL,
		exit_price float NULL,
		currency_id int NULL,
		realized_pl float NULL,
		currency varchar(50) NULL)
create table
	#rt_ids(
		id int identity,
		round_turn_id int,
		contract_id int,
		external_account_id int)
insert into
	#rt_ids(
		round_turn_id,
		contract_id,
		external_account_id)
select
	a.round_turn_id,
	a.contract_id,
	a.external_account_id
from
	round_turns a,
	contracts b,
	products c,
	external_accounts d
where
	a.contract_id = b.contract_id
and
	a.currency_id = c.product_id
and
	a.external_account_id = d.external_account_id
and
	convert(date, a.trade_date) = convert(date, @trade_date)
order by
	d.symbol,
	b.symbol,	
	a.round_turn_id

select
	@id = 0
select
	@ids = count(*)
from
	#rt_ids
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#rt_ids
	where
		id > @id


	select
		@round_turn_id = round_turn_id,
		@contract_id = contract_id,
		@external_account_id = external_account_id
	from
		#rt_ids
	where
		id = @id

	insert into
		#round_turns(
			style,
			round_turn_id,
			contract_id,
			external_account_id,
			entry_id,
			entry_date,
			entry_qty,
			entry_price,
			exit_id,
			exit_date,
			exit_qty,
			exit_price,
			currency_id,
			realized_pl)
	select
		style = @style,
		round_turn_id,
		contract_id,
		external_account_id,
		entry_trade_id,
		entry_date,
		entry_quantity,
		entry_price,
		exit_trade_id,
		exit_date,
		exit_quantity,
		exit_price,
		currency_id,
		realized_pl
	from
		round_turns 
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id
	and
		convert(date, trade_date) = convert(date, @trade_date)

		
	delete

	from
		#rt_ids
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id

	

	select
		@ids = count(*)
	from
		#rt_ids
	where
		id > @id
end


update
	#round_turns
set
	a.account = b.symbol,
	a.symbol = c.symbol,
	a.currency = d.symbol
from
	#round_turns a,
	external_accounts b,
	contracts c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.currency_id = d.product_id

create table
	#account_transactions(
		external_account_id int,
		currency_id int,
		realized_pl numeric(30,4))
insert into
	#account_transactions(
		external_account_id,
		currency_id,
		realized_pl)
select
	external_account_id,
	currency_id,
	sum(realized_pl)
from
	#round_turns
group by
	external_account_id,
	currency_id

create table	
	#realized_transactions(
		id int identity,
		style varchar(250) NULL,
		external_account_id int,
		account varchar(50) NULL,
		currency_id int,
		currency varchar(50) NULL,
		realized_pl numeric(30,4) NULL)
insert into
	#realized_transactions(
		style,
		external_account_id,
		account,
		currency_id,
		currency,
		realized_pl)
select
	style = @style,
	a.external_account_id,
	b.symbol,
	a.currency_id,
	c.symbol,
	a.realized_pl
from
	#account_transactions a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
order by
	b.symbol,
	c.symbol

declare @cfd_far_value_date datetime
exec
	r_nextbusinessday
		@trade_date,
		@cfd_far_value_date output	

create table
	#roll_deals(
		trade_id int,
		deal_id int,
		trade_date datetime,
		external_account_id int,
		contract_id int,
		value_date datetime,
		quantity numeric(30, 2),
		price float)
insert into
	#roll_deals(
		trade_id,
		deal_id,
		trade_date,
		external_account_id,
		contract_id,
		value_date,
		quantity,
		price)
select
	trade_id,
	deal_id,
	trade_date,
	external_account_id,
	contract_id,
	value_date,
	quantity,
	price
from
	trades
where
	trade_type_id = @cfd_roll_trade_type_id
and
	value_date >= convert(date, @trade_date)
and
	value_date <= convert(date, @cfd_far_value_date)

/*
create table
	#cfd_transactions(
		external_account_id int NULL,
		product_id int NULL,
		amount numeric(30,4) NULL)

insert into
	#cfd_transactions(
		external_account_id,
		product_id,
		amount)
select
	a.external_account_id,	
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
	b.name = "CFD Settlement"
and
