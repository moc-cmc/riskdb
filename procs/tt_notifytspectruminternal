
create or replace procedure
	tt_notifytspectruminternal
		@source varchar(50),
		@query_options char(1)=NULL,
		@query_exotics char(1)=NULL,
		@query_futures char(1)=NULL,
		@format_swaps char(1)=NULL,
		@format_ndf_swaps char(1)=NULL,
		@mark_to_market char(1)=NULL
as


declare @source_id int
declare @cancelled_count int
declare @traiana_id_prefix varchar(15)
declare @netlink_broker_id int
declare @boa_pb_id int
declare @usi_lookup varchar(15)
declare @internal_trade_type_id int

declare @min_trade_id int

select
	@internal_trade_type_id = trade_type_id
from
	trade_types
where
	name = "Internal"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Trade Type not found",
		trade_type = "Internal"
	return
end

select
	@usi_lookup = usi_prefix
from
	usi_lookup

select
        @netlink_broker_id = broker_id
from
        brokers
where
        symbol = "Netlink"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

create table
	#trades(
		trade_id int,
		deal_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		deal_type_id int NULL,
		deal_type varchar(25) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(15) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
                agency_vs_counterparty varchar(40) NULL,
		fund_agency_trade char(1) NULL,
		fund_agency_buy_sell varchar(8) NULL,
		client_buy_sell varchar(4) NULL,
		broker_id int,
		broker varchar(25) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity float NULL,
		abs_qty float NULL,
		abs_counter_qty float NULL,
                abs_far_counter_qty float NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date varchar(15) NULL,
		fixing_date varchar(15) NULL,
		db_price float,
		std_price float NULL,
		spot_reference float NULL,
		sales_code_id int,
		sales_code varchar(15) NULL,
		strategy_id int,
		strategy varchar(30) NULL,
		identifier varchar(100) NULL,
		trade_status_id int,
		trade_status varchar(20) NULL,
		trade_notification_id int,
		notification_status_id int,
		notification_status varchar(15) NULL,
		notification_source_id int,
		notification_source varchar(25) NULL,
                source_trade_trade_id int NULL,
		source_trade_deal_id int NULL,
		/*- Swap Info -*/
		far_quantity float NULL,
		far_price float NULL,
		far_value_date datetime NULL,
		far_fixing_date datetime NULL,
		far_trade_notification_id int NULL,
                abs_far_qty float NULL,
		swap_symbol varchar(30) NULL,
		cl_or_lp varchar(4) NULL,
		old_qty_if_deleted float NULL,
		tr_usi varchar(25) NULL,
		far_tr_usi varchar(25) NULL,
		is_inverted_contract char(1) NULL,
                product_id int NULL,
		currency_id int NULL,
		/* Internal 2nd leg */
		t2_trade_id int NULL,
		t2_fund_agency_buy_sell varchar(10) NULL,
		t2_client_buy_sell varchar(10) NULL,
		t2_std_price float NULL,
		t2_value_date datetime NULL,
		t2_broker_id int NULL,
		t2_broker varchar(50) NULL,
		t2_strategy_id int NULL,
		t2_strategy varchar(50) NULL,
		t2_sales_code_id int NULL,
		t2_sales_code varchar(50) NULL
		)


/*create nonclustered index 
	tmp_tid
on
	#trades(trade_id)
*/


create table
	#trade_notifications(
		trade_notification_id int,
		trade_id int,
		source_id int,
		status_id int
		)


declare @active_status_id int
declare @edit_status_id int
declare @cancelled_status_id int
declare @cancelling_src_status_id int

select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
select
        @edit_status_id = status_id
from
        statuses 
where
        name = "Edit"
select
        @cancelled_status_id = status_id
from
        statuses 
where
        name = "Cancelled"


/*
| Insert into #trade_notifications anything with status_id "Active", "Edit", "Cancelled"
*/
insert into
        #trade_notifications
select
        a.trade_notification_id,
        a.trade_id,
        a.source_id,
        a.status_id
from
        trade_notifications a,
        statuses b
where
        a.status_id = b.status_id
and
        b.name in("Active", "Edit", "Cancelled")
and
        a.source_id = @source_id

select
        @min_trade_id = min(trade_id)
from
        #trade_notifications


/*
| Insert *_ids into #trades that need to be notified 
*/
insert into
	#trades
(
	trade_id,
	deal_id,
	trade_type_id,
	external_account_id,
	trader_id,
	counterparty_id,
	fund_agency_trade,
	contract_id,
	broker_id,
	quantity,
	trade_date,
	value_date,
	fixing_date,
	db_price,
	std_price,
	spot_reference,
	sales_code_id,
	strategy_id,
	identifier,
	trade_status_id,
	trade_notification_id,
	notification_status_id,
	notification_source_id,
	notification_source,
	abs_qty,
	cl_or_lp,
	abs_counter_qty
)
select 
	trade_id = a.trade_id,
	deal_id = a.deal_id,
	trade_type_id = a.trade_type_id,
	external_account_id = a.external_account_id,
	trader_id = a.trader_id,
	counterparty_id = a.counterparty_id,
        fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	quantity = a.quantity,
	trade_date = a.trade_date,
	value_date = convert(varchar(12), a.value_date, 112),
	fixing_date = convert(varchar(12), a.fixing_date, 112),
	db_price = a.price,
	std_price = a.price,
	spot_reference = a.spot_reference,
	sales_code_id = a.sales_code_id,
	strategy_id = a.strategy_id,
	identifier = a.identifier,
	trade_status_id = a.status_id,
	trade_notification_id = b.trade_notification_id,
	notification_status_id = b.status_id,
	notification_source_id = @source_id,
	notification_source = @source,
	abs_qty = abs(a.quantity),
	cl_or_lp = "LP",
	abs_counter_qty = round(abs(a.quantity) * a.price, 2)
from
	trades a,
	#trade_notifications b
where
	a.trade_id=b.trade_id
and
	a.trade_id >= @min_trade_id
and
	a.trade_type_id = @internal_trade_type_id



create table 
	#trade_edits
(
	trade_id int,
	quantity numeric(30, 2),
        price float,
	timestamp datetime
)
insert into
	#trade_edits
select
	b.trade_id,
	b.quantity,
	b.price,
	b.timestamp
from
	#trades a,
	trade_edits b
where
	a.trade_id = b.trade_id
and
	a.notification_status_id = @cancelled_status_id
and
	b.trade_id >= @min_trade_id

if @@rowcount > 0
begin
	/* chriso: on cancel, this allows us to get the qty prior to edit. there may have been multiple edits
		   to avoid a loop, doing the below subquery */
	update
		#trades
	set
		quantity = b.quantity,
		abs_qty = abs(b.quantity),
		abs_counter_qty = abs(b.quantity) * b.price
	from
		#trades a,
		#trade_edits b
	where
		a.trade_id = b.trade_id
	and
		b.timestamp = (select max(c.timestamp) from #trade_edits c where c.trade_id = b.trade_id)
end


/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    std_price = case 
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.db_price) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.db_price) * d.factor
        when c.factor != NULL then
            a.db_price * c.factor * d.factor
        else
            a.db_price * d.factor
    end
from
    #trades a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id

update 
	#trades
set
	swap_symbol = c.symbol
from
        #trades a,
        swap_symbol_trades b,
        swap_symbols c
where
        a.trade_id = b.trade_id
and
        b.swap_symbol_id = c.swap_symbol_id	
and
	b.trade_id >= @min_trade_id
	
/*
| Query trade_types
*/
update
	#trades
set
	trade_type = b.name
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id


update
	#trades
set
	trade_type = b.symbol
from
	#trades a,
	trade_type_symbols b
where
	a.trade_type_id = b.trade_type_id
and
	b.source_id = @source_id



/*
| Query external_accounts
*/

update 
        #trades
set
        external_account = b.symbol,
	external_account_type_id = b.external_account_type_id
from
        #trades a,
        external_accounts b
where
        a.external_account_id = b.external_account_id

update
	#trades 
set
	external_account_type = b.name
from
	#trades a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id

update
	#trades
set
	external_account = b.symbol
from
	#trades a,
	external_account_symbols b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id

	
/*
| Query traders
*/
update
	#trades
set
	trader = b.symbol
from
        #trades a,
        traders b
where
        a.trader_id = b.trader_id

update
        #trades
set
        trader = b.symbol
from
        #trades a,
        trader_symbols b
where
        a.trader_id = b.trader_id
and
        b.source_id = @source_id

/*
| Query counterparties
*/

update
	#trades
set
	counterparty = b.name,
	agency_vs_counterparty = b.name
from
	#trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
        #trades
set
        counterparty = b.symbol,
	agency_vs_counterparty = b.symbol
from
        #trades a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id

update
	#trades
set
	fund_agency_trade = "Y",
	cl_or_lp = "CL",
	agency_vs_counterparty = a.external_account
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id


update
	#trades
set
	fund_agency_buy_sell = "SELL",
        client_buy_sell = "BUY"
where
	quantity < 0

update
        #trades
set
        fund_agency_buy_sell = "BUY",
	client_buy_sell = "SELL"
where
        quantity > 0



/*
| Query brokers
*/

update
	#trades
set
	broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id

update
        #trades
set
        broker = b.symbol
from
        #trades a,
        broker_symbols b
where
        a.broker_id = b.broker_id
and
        b.source_id = @source_id

/*
| Query strategies
*/

update 
	#trades
set
	strategy = b.name
from
	#trades a,
	strategies b
where
	a.strategy_id = b.strategy_id

/* strategy_symbols does not exist */

/*
| Query strategies
*/

update
        #trades
set
        sales_code = b.name
from
        #trades a,
        sales_codes b
where
        a.sales_code_id = b.sales_code_id

/*
|  Query contracts, dealt ccy, counter ccy
*/
update 
	#trades
set
	std_contract = b.symbol,
        traded_ccy = g.symbol,
        counter_ccy = f.symbol
from
	#trades a,
	contracts b,
	forwards e,
	products f,
	products g
where
	a.contract_id = b.contract_id
and
	b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#trades
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy)
from
	#trades a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"



update
	#trades
set
	notification_status = b.name
from
	#trades a,
	statuses b
where
	a.notification_status_id = b.status_id

update
	#trades
set
	notification_status = b.status_symbol
from
	#trades a,
	status_symbols b
where
	a.notification_status_id = b.status_id

update
	#trades
set
	prime_broker_id = d.prime_broker_id,
	prime_broker = c.name
from
	#trades a,
	external_account_prime_brokers b,
	prime_brokers d,
	sources c
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = d.prime_broker_id
and
	c.source_id = d.source_id

update
	#trades
set
	prime_broker = b.symbol
from
	#trades a,
	prime_broker_symbols b
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = @source_id


/*
| Set trading day to EST 17:00-17:00 market standard
*/
update
	#trades
set
	trade_day = case
		when a.trade_date >= convert(char(8), a.trade_date, 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 112))
		else
			convert(char(12), a.trade_date, 112)
	end
from
	#trades a

/*
| If this was originally a db to db trade, grab information about previous source_db
*/
update
	#trades
set
	source_trade_trade_id = source_trade_id,
	source_trade_deal_id = source_deal_id
from
	#trades a,
	source_trade_details b
where
	a.trade_id = b.trade_id
and
	a.notification_status_id = @cancelling_src_status_id



update
	#trades
set
	is_inverted_contract = "Y"
from
	#trades a,
	contracts b,
        contract_price_styles c,
        price_styles d
where
	convert(varchar(3), a.traded_ccy)+convert(varchar(3), a.counter_ccy) = b.symbol
and
        b.contract_id = c.contract_id
and
        c.price_style_id = d.price_style_id
and
        d.name = "Inverted"

update
	#trades
set
	tr_usi = rtrim(@usi_lookup)+rtrim(convert(varchar(15), trade_id))
from
	#trades a,
	reg_reporting_ext_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.trade_type not in("Spot")

select
	@boa_pb_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = "Bank of America"
	
/* clease data and Update leg2 details */

create table
	#deal_trades(
		deal_id int)
insert into
	#deal_trades(
		deal_id)
select
	deal_id
from
	#trades
group by 
	deal_id
having
	count(*) != 2

delete from
	#trades
from
	#trades a,
	#deal_trades b
where
	a.deal_id = b.deal_id
	
create table
	#t2_trades(
		trade_id int,
		deal_id int)

insert into
	#t2_trades(
		trade_id,
		deal_id)
select
	max(trade_id),
	deal_id
from
	#trades
group by
	deal_id

update
	#trades
set
	t2_trade_id = b.trade_id
from
	#trades a,
	#t2_trades b
where
	a.deal_id = b.deal_id

update
	#trades
set
	t2_fund_agency_buy_sell = b.fund_agency_buy_sell,
	t2_client_buy_sell = b.client_buy_sell,
	t2_std_price = b.std_price,
        t2_value_date = b.value_date,
        t2_broker_id = b.broker_id,
        t2_broker = b.broker,
        t2_strategy_id = b.strategy_id,
        t2_strategy = b.strategy,
        t2_sales_code_id = b.sales_code_id,
        t2_sales_code = b.sales_code
from
	#trades a,
	#trades b
where
	a.t2_trade_id = b.trade_id

delete from
	#trades
from
	#trades a,
	#t2_trades b
where
	a.trade_id = b.trade_id


select
	trade_id,
	deal_id,
	trade_type,
	deal_type,
	external_account,
	external_account_type,
	trader,
	counterparty,
        agency_vs_counterparty,
	fund_agency_trade,
	fund_agency_buy_sell,
        fa_bs=convert(char(1), fund_agency_buy_sell), 
	client_buy_sell,
        cl_bs=convert(char(1), client_buy_sell),
	broker,
	prime_broker,
        contract = convert(varchar(3), traded_ccy)+convert(varchar(3), counter_ccy),
	std_contract,
	traded_ccy,
	counter_ccy,
	quantity,
	abs_quantity = abs(quantity),
        trade_date = rtrim(convert(varchar(10), trade_date, 112))+" "+rtrim(convert(varchar(10), trade_date, 108)),
        trade_date_ms = rtrim(convert(varchar(10), trade_date, 112))+" "+rtrim(convert(varchar(12), trade_date, 20)),
        trade_day = rtrim(convert(varchar(10), trade_day, 112)),
	value_date,
	fixing_date,
	db_price,
	std_price,
	spot_reference,
	sales_code,
	strategy,
	identifier,
	trade_status,
	trade_notification_id,
	notification_status,
	notification_source,
	far_price,
	far_quantity,
	far_value_date=rtrim(convert(varchar(10), far_value_date, 112)),
	far_fixing_date=rtrim(convert(varchar(10), far_fixing_date, 112)),
        swapsym=swap_symbol,
        abs_fq=abs_far_qty,
        abs_fcq=abs_far_counter_qty,
	cl_or_lp,
	old_qty_if_deleted,
	far_trade_notification_id,
	tr_usi,
	far_tr_usi,
	abs_cntr_qty=abs_counter_qty,
	/* Internal */
	t2_trade_id,
        t2_fund_agency_buy_sell,
        t2_client_buy_sell,
        t2_std_price,
        t2_value_date,
        t2_broker_id,
        t2_broker,
        t2_strategy_id,
        t2_strategy,
        t2_sales_code_id,
        t2_sales_code
from
        #trades


go 

