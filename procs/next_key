
if object_id("next_key") != NULL
    drop procedure
        next_key
go

create procedure
        next_key
                @tname varchar(32)
as

declare @new_id int 

begin tran
        update
                keys
        set
                last_id = last_id + 1
        where
                relation = @tname

        if @@rowcount != 1
        begin
                select id =
          -1
                rollback tran
                return
        end

        select
                @new_id = last_id
        from
                keys
        where
                relation = @tname
commit tran

select
        counter = @new_id

return @new_id

go
