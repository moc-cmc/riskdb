	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
	#output(
		id int identity,
		style varchar(250) NULL,
		pair varchar(50),
		contract_id int,
		value_date datetime,
		rate numeric(30,8) NULL,
		edit_resid_rate varchar(50))
insert into
	#output(
		style,
		pair,
		contract_id,
		value_date,
		rate,
		edit_resid_rate)
select
	style = @style,
	pair = b.symbol,
	a.contract_id,
	a.value_date,
	a.rate,
	edit_resid_rate = "EDIT"
from
	defined_resid_rates a,
	contracts b
where
	a.contract_id = b.contract_id
and
	convert(date, a.value_date) = convert(date, @value_date)
order by
	pair

update
	#output
set
	a.rate = 1.0 / a.rate
from
	#output a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"


select
	style,
	pair,
	value_date,
	rate,
	edit_resid_rate
from
	#output
order by
	id
	

go
	
