
if object_id("r_contractexpiration") != NULL
    drop procedure
        r_contractexpiration
go

create procedure
	r_contractexpiration
		@contract_id int,
		@expiration datetime output
as

select
	@expiration = NULL

select
	@expiration = expiration
from
	future_contracts
where
	contract_id = @contract_id
if @expiration != NULL
	return

select
	@expiration = a.expiration
from
	option_expirations a,
	option_contracts b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.contract_id = @contract_id
if @expiration != NULL
	return

select
	@expiration = a.expiration
from
	option_expirations a,
	exotic_contracts b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.contract_id = @contract_id

go
