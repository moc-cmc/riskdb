
if object_id("r_optcontractdelta") != NULL
    drop procedure
        r_optcontractdelta
go

create procedure
	r_optcontractdelta
		@run_id int,
		@contract_id int,
		@position float,
		@as_of_date datetime,
		@perspective_contract_id int output,
		@delta float output
as

declare @underlying_contract_id int
declare @underlying_multiplier float
declare @unit_delta float
declare @multiplier float
declare @instrument char(100)


select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @contract_id
if @instrument = "Exotic"
begin
	exec
		r_exoticcontractdelta
			@run_id,
			@contract_id,
			@position,
			@as_of_date,
			@perspective_contract_id output,
			@delta output

	return
end

select
	@underlying_contract_id = a.underlying_contract_id
from
	options a,
	option_expirations b,
	option_contracts c
where
	a.option_id = b.option_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.contract_id = @contract_id
if @@rowcount != 1
begin

	select
		id = -1,
		error = "Problem finding underlying contract for option",
		symbol = symbol
	from
		contracts
	where
		contract_id = @contract_id
	return
end

select
	@multiplier = a.quantity
from
	options a,
	option_expirations b,
	option_contracts c
where
	a.option_id = b.option_id 
and
	b.option_expiration_id = c.option_expiration_id
and
	c.contract_id = @contract_id

exec
	r_deltaasof
		@contract_id,
		@as_of_date,
		@unit_delta output

select
	@position = @position * @multiplier * @unit_delta 

/* select
	@position = @position * @unit_delta */

exec
	b_contractdelta
		@run_id,
		@as_of_date,
		@underlying_contract_id,
		@position,
		@perspective_contract_id output,
		@delta output


go
