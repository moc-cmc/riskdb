/*---------------------------------------------------------------------,
|   Declare all variables that will be used to call r_addreporttrade   |
'---------------------------------------------------------------------*/
declare @external_report varchar(50)        /* "" */
declare @default_broker_symbol varchar(50)  /* "" */
declare @noe_activity varchar(15)            /* "" */

select
	@default_broker_symbol = ""
select 
	@noe_activity = ""
/*----------- Declare non-r_addreporttrade variables -----------------*/
declare @prime_broker_source_id int
declare @trade_recon_report_type_id int



select
	@prime_broker = "Morgan Stanley"

select
	@prime_broker_source_id = a.source_id
from
	sources a,
	prime_brokers b
where
	a.source_id = b.source_id
and
	a.name = @prime_broker
if @@rowcount != 1
begin
	select	
		status = "ERROR",
		msg = "Source 'Morgan Stanley' not defined as prime broker"
	return
end

select
	@trade_recon_report_type_id = report_type_id
from
	report_types
where
	name = "Trade Recon"
if @@rowcount != 1
begin
        select
                status = "ERROR",
                msg = "Problem determining 'Trade Recon' report type"
        return
end

select
	@external_report = a.name
from
	external_reports a,
	sources b
where
	a.source_id = b.source_id
and
	b.source_id =  @prime_broker_source_id
and
	a.report_type_id = @trade_recon_report_type_id
if @@rowcount != 1
begin
        select
                status = "ERROR",
                msg = "Problem determining 'Trade Recon' external report for prime broker",
		prime_broker = @prime_broker
        return
end

