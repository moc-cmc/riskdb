create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	distinct(product_id)
from
	#trades
insert into
	#conversion_rates(
		product_id)
select
	distinct(currency_id)
from
	#trades
where
	currency_id not in(select product_id from #conversion_rates)

update
	#conversion_rates
set
	rate = 1.0
where 
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and 
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = a.product_id 
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#trades
set
	a.product_equiv = a.product_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#trades
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id


