	external_account_id,
	product_id,
	product_type_id,
	margin,
	sum(quantity)
from
	#product_positions
group by
	external_account_id,
	product_id,
	product_type_id,
	margin

update
	#net_positions
set
	long_equiv = 0.0,
	short_equiv = 0.0

update
	#net_positions
set
	a.equiv = a.quantity * b.rate
from
	#net_positions a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#net_positions
set
	long_equiv = equiv
where
	equiv > 0.0

update
	#net_positions
set
	short_equiv = equiv 
where
	equiv < 0.0

update
	#net_positions
set
	nop_long = long_equiv * margin,
	nop_short = abs(short_equiv) * margin

update
	#net_positions
set
	a.product = b.symbol
from
	#net_positions a,
	products b
where
	a.product_id = b.product_id

