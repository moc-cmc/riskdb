create table
	#external_accounts(
		id int identity,
		external_account_id int,
		symbol varchar(50),
		margin_multiplier float NULL)

insert into
	#external_accounts(
		external_account_id,
		symbol,
		margin_multiplier)
select
	a.external_account_id,
	a.symbol, 
	a.margin_multiplier
from
	external_accounts a,
	fund_external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	a.external_account_type_id = c.external_account_type_id
and
	c.name in( "Client", "Counterparty")
and
	a.symbol not in("INTERNAL", "FC FTPROA3900" )
order by
	a.symbol


create table
	#trades(
		trade_id int,
		prime_broker_id int NULL,
		external_account_id int,
		margin_multiplier float NULL, 
		quantity float,
		contract_id int,
		product_id int, 
		product_qty float,
		currency_id int,
		currency_qty float,
		price float,
		value_date datetime,
		status_id int,
		margin float NULL,
		product_type_id int NULL,
		product_equiv float NULL,
		currency_equiv float NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		margin_multiplier,
		quantity,
		contract_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		price,
		value_date,
		status_id,
		margin,
		product_type_id)
select
	a.trade_id,
	a.external_account_id,
	c.margin_multiplier,
	a.quantity,
	a.contract_id,
	b.product_id,
	a.quantity,
	b.currency_id,
	a.quantity * price * -1.0,
	a.price,
	a.value_date,
	a.status_id,
	margin = 0.0,
	d.product_type_id
from
	trades a,
	forwards b,
	#external_accounts c,
	products d
where 
 	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	b.product_id = d.product_id
and
	a.value_date > @begin_date
and
	a.trade_date < @end_date
/* chriso: added since 
 these accounts shouldnt have margin or open equity*/
and
	c.symbol not in("FC EDGEBOA", "FC INTERNAL")

update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.currency_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin


update
	#trades
set
	a.quantity = a.quantity * -1.0,
	a.product_qty = a.product_qty * -1.0,
	a.currency_qty = a.currency_qty * -1.0
from
	#trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"

