create table
	#output(
		id int identity,
		style varchar(250) NULL,
		nop_type_id int NULL,
		nop_type varchar(50) NULL,
		external_account_id int NULL,
		evaluation_currency_id int NULL,
		account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		product_type_id int NULL,
		product_type varchar(50) NULL,
		margin float NULL,
		quantity float NULL,
		equiv float NULL,
		long_equiv float NULL,
		long_use float NULL,
		incl_longs varchar(10) NULL,
		nop_long float NULL,
		short_equiv float NULL,
		short_use float NULL,
		incl_shorts varchar(10) NULL,
		nop_short float NULL,
		margin_use float NULL)

select
	@id = 0
select
	@ids = count(*)
from 
	#ordered_accounts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ordered_accounts
	where
		id > @id

	select
		@external_account_id = NULL,
		@long_equiv = NULL,
		@long_use = NULL,
		@nop_long = NULL,
		@short_equiv = NULL,
		@short_use = NULL,
		@nop_short = NULL,
		@total_id = NULL,
		@nop = NULL,
		@nop_type_id = NULL,
		@nop_type = NULL

	select
		@external_account_id = external_account_id
	from
		#ordered_accounts
	where
		id = @id
	
	select
		@nop_type_id = nop_type_id
	from
		external_accounts
	where
		external_account_id = @external_account_id

	select
		@nop_type = name
	from
		nop_types
	where
		nop_type_id = @nop_type_id

	insert into
		#output(
			style,
			account,
			external_account_id,
			nop_type)
	select
		style = @client_style,
		symbol,
		external_account_id,
		nop_type = @nop_type
	from
		external_accounts
	where
		external_account_id = @external_account_id
	select
		@total_id = @@identity
	
	insert into
		#output(
			style,
			external_account_id,
			nop_type_id,
			evaluation_currency_id,
			product_id,
			product,
			product_type_id,
			product_type,
			margin,
			quantity,
			equiv,
			long_equiv,
			nop_long,
			short_equiv,
			nop_short)
	select
		style = @style,
		external_account_id,
		nop_type_id = @nop_type_id,
		evaluation_currency_id = @evaluation_currency_id,
		product_id,
		product,
		product_type_id,
		product_type, 
 		margin,
		quantity,
		equiv,
		long_equiv,
		nop_long,
		short_equiv,
		nop_short
	from
		#net_positions
	where
		external_account_id = @external_account_id
	and
		product_type = "Currency"
	order by
		product_type,
		product
	if @@rowcount = 0
	begin 
 		delete

		from
			#output
		where
			external_account_id = @external_account_id
	end
	begin
		update
			#output
		set
			a.incl_longs = b.incl_longs,
			a.incl_shorts = b.incl_shorts
		from
			#output a,
			nop_types b
		where
			a.nop_type_id = b.nop_type_id
		and
			a.external_account_id = @external_account_id

		update
			#output
		set
			a.incl_longs = "N",
			a.incl_shorts = "N"
		from
			#output a,
			nop_types b
		where
			a.product_id = @evaluation_currency_id
		and
			a.nop_type_id = b.nop_type_id
		and
			b.incl_base_ccy = "N"
		and
			a.external_account_id = @external_account_id
			

		update
			#output 
		set
			margin_use = nop_long
		where
			nop_long > nop_short
		and
			id = @total_id

		update
			#output
		set
			margin_use = nop_short
		where
			nop_short >= nop_long
		and
			id = @total_id

		select
			@long_equiv = sum(long_equiv),
			@nop_long = sum(nop_long),
			@long_use = abs(sum(long_equiv * margin))
		from
			#output
		where
			incl_longs = "Y"
		and
			external_account_id = @external_account_id

		select
			@short_equiv = sum(short_equiv),
			@nop_short = sum(nop_short),
			@short_use = abs(sum(short_equiv * margin))
		from
			#output
		where
			incl_shorts = "Y"
		and
			external_account_id = @external_account_id


		update
			#output
		set
			long_equiv = @long_equiv,
			nop_long = @nop_long,
			long_use = @long_use,
			short_equiv = @short_equiv,
			nop_short = @nop_short,
			short_use = @short_use
		where
			id = @total_id


		update
			#output
		set
			margin_use = long_use
		where
			long_use >= short_use

		update
			#output
		set
			margin_use = short_use
		where
			short_use > long_use
	end

	select
		@ids = count(*)
	from
		#ordered_accounts
	where
		id > @id
end


select
	style,
	account, 
	nop_type,
	margin_use,
	product,
	balance = quantity,
	long_equiv,
	incl_longs,
	short_equiv,
	incl_shorts,
	margin_rate = margin
from
	#output
order by
	id

                                                                                                                                     
go
