
if object_id("mc_setcurrentcounterpartyutil") != NULL
    drop procedure
        mc_setcurrentcounterpartyutil
go

create procedure
    mc_setcurrentcounterpartyutil
        @counterparty_id int,
        @counterparty varchar(50),
        @nop float,
        @dsl float
as

declare @now_date datetime

select
    @now_date = getdate()

if @counterparty_id = NULL and @counterparty != NULL
begin
  
    select
        @counterparty_id = counterparty_id
    from
        counterparties
    where
        name = @counterparty
  
end

if @counterparty_id = NULL
begin
    
    select
        status = "Error",
        message = "No counterparty provided",
        counterparty_id = @counterparty_id,
        counterparty = @counterparty
    
end

update
    current_counterparty_utils
set
    nop = @nop,
    dsl = @dsl
where
    counterparty_id = @counterparty_id

if @@rowcount = 0
begin
    
    insert into
        current_counterparty_utils (
            counterparty_id,
            date,
            dsl,
            nop
        )
    values (
        @counterparty_id,
        @now_date,
        @dsl,
        @nop
    )
    
end

go
