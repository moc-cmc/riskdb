create or replace procedure
	r_addintegration
		@login varchar(50),
		@name varchar(50),
		@org varchar(50)=NULL,
		@format_swaps char(1)=NULL

as

exec
	tt_addintegration
		@login = @login,
		@name = @name,
		@org = @org,
		@format_swaps = @format_swaps

exec
	r_manageintegrations
		@login = @login

go
			
