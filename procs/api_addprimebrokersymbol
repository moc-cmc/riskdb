
drop procedure
	api_addprimebrokersymbol
go

create procedure
	api_addprimebrokersymbol
			@login varchar(25),
			@name varchar(100),
			@symbol varchar(50),
			@source varchar(100)
as

declare @prime_broker_id int
declare @source_id int
declare @source_type_id int
declare @source_type varchar(50)

select 
	@symbol = ltrim(rtrim(@symbol))

select
	@prime_broker_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id=b.source_id
and
	b.name=@name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Prime Broker name does not exist",
		prime_broker=@name

	return
end

select
	@source_id=source_id,
	@source_type_id=source_type_id
from
	sources
where
	name=@source

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source

	return
end

select
        @source_type=name
from
        source_types
where
        source_type_id=@source_type_id

if (@source_type="Outbound")
begin
        if exists (select 
                        prime_broker_id
                   from
                      	prime_broker_symbols 
                   where
                        source_id=@source_id
                   and
                        prime_broker_id=@prime_broker_id)

        begin
                select
                        status="Error",
                        msg="Prime Broker already has an Outbound Source",
                        name=@name

                return
        end
end

insert into 
	prime_broker_symbols (
		prime_broker_id,
		source_id,
		symbol )
values (
	@prime_broker_id,
	@source_id,
	@symbol)

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Problem adding Prime Broker Symbol",
		trader_symbol=@symbol

	return
end

select
	status="OK",
	msg="Successfully added Prime Broker Symbol",
	prime_broker_symbol=@symbol

return

go

