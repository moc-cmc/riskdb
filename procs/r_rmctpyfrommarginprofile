drop procedure
	r_rmctpyfrommarginprofile
go

create procedure
	r_rmctpyfrommarginprofile
		@login varchar(50),
		@margin_profile varchar(50),
		@counterparty varchar(50)

as

declare @counterparty_id int
declare @margin_profile_id int


select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount !=1
begin
	select
		msg = "Could not find ctpy",
		ctpy = @counterparty
	return
end

select
	@margin_profile_id = margin_profile_id
from
	margin_profiles
where
	name = @margin_profile
if @@rowcount !=1
begin
        select
                msg = "Could not find margin profile",
		margin_profile = @margin_profile
        return
end

delete from
	margin_profile_counterparties
where
	margin_profile_id = @margin_profile_id
and
	counterparty_id = @counterparty_id
if @@rowcount = 1
begin
	select
		msg = "Successfully removed " + @counterparty + " From profile " + @margin_profile
end


exec
	r_viewmarginprofile
		@login,
		@margin_profile

go

