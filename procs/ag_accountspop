
create or replace procedure
	ag_accountspop
		@login varchar(50),
		@run_name varchar(50)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@evaluation_ccy varchar(50)=NULL
as



declare @fund_id int
declare @run_id int
declare @evaluation_currency_id int
declare @missing_conversion_rates int
declare @price_status varchar(200)
declare @last_month datetime

/* 
 * For a date range for example of "Mar 7, 2014" and "Mar 31, 2014":
 *
 *   @trading_begin_date  = "Mar  6, 2014 17:00"
 *   @begin_date          = "Mar  7, 2014 00:00"
 *   @end_date            = "Mar 31, 2014 00:00"
 *   @trading_end_date    = "Mar 31, 2014 17:00"
 *   @end_of_end_date     = "Apr  1, 2014 00:00"
 */
declare @end_of_end_date datetime
declare @date datetime
declare @trading_begin_date datetime
declare @trading_end_date datetime
declare @settlement_pl float

exec
	ag_accountslinks
		@login


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = product_id
from
	products
where
	symbol = @evaluation_ccy
if @evaluation_currency_id = NULL
begin
	select
		@evaluation_currency_id = evaluation_currency_id
	from
		funds
	where
		fund_id = @fund_id
	if @evaluation_currency_id = NULL
	begin
		select
			status = "Error",
			message = "Evalution Currency not found"
		return
	end
end

if @run_name = NULL
begin
	select
		@run_name = name
	from
		funds
	where
		fund_id = @fund_id
end


if @begin_date = NULL and @end_date = NULL
begin

	select
		@end_date = max(commit_date) 
	from 
		daily_commits a, 
		commit_statuses b 
	where 
		a.commit_status_id = b.commit_status_id 
	and 
		b.name = "Commit Complete"

	select
		@end_date = convert(date, @end_date)
	select
		@begin_date = convert(date, @end_date)

	exec
		r_firstbusinessdayofmonth
			@begin_date,
			@begin_date output

end


if @begin_date = NULL and @end_date != NULL
begin
	exec
		r_prevbusinessday
			@end_date,
			@begin_date output
	select
		@begin_date = convert(datetime, convert(date, @begin_date))
end

if @begin_date != NULL and @end_date = NULL
begin
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output
	select
		@end_date = convert(datetime, convert(date, @end_date))
end

exec
	r_daterangefordate
		@begin_date,
		@trading_begin_date output,
		@date output

select
	@date = NULL
exec
	r_daterangefordate
		@end_date,
		@date output,
		@trading_end_date output

exec
  r_nextbusinessday
    @end_date,
    @end_of_end_date output
select
  @end_of_end_date = convert(date, @end_of_end_date)

/* select
	xbegin_date = @begin_date,
	xend_date = @end_date,
	trading_begin_date = @trading_begin_date,
	trading_end_date = @trading_end_date
return */


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end
create table
	#external_accounts(
		external_account_id int,
		margin_multiplier float NULL)

insert into
	#external_accounts(
		external_account_id)
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts(
			external_account_id)
	select
		external_account_id
	from
		external_accounts
end

update
	#external_accounts
set
	a.margin_multiplier = b.margin_multiplier
from
	#external_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id


delete
	#external_accounts
from
	#external_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.symbol in("INTERNAL", "FC FTPROA3900", "FC FXTRADECL")

delete from
	#external_accounts
from
	#external_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	archived_at != NULL


create table
	#account_transactions(
		account_transaction_id int,
		entered_by int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		currency_id int,
		amount float,
		equiv float NULL)
insert into
	#account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount)
select
	a.account_transaction_id,
	a.entered_by,
	a.external_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.currency_id,
	a.amount
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	/* a.transaction_date >= @begin_date */
	a.transaction_date >= @begin_date
and
	a.transaction_date < @end_of_end_date


create table
	#begin_balances(
		external_account_id int,
		currency_id int,
		begin_balance float,
		equiv float NULL)
insert into
	#begin_balances(
		external_account_id,
		currency_id,
		begin_balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date < @begin_date
group by
	a.external_account_id,
	a.currency_id


create table
	#end_balances(
		external_account_id int,
		currency_id int,
		end_balance float,
		equiv float NULL)
insert into
	#end_balances(
		external_account_id,
		currency_id,
		end_balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date < @end_of_end_date
group by
	a.external_account_id,
	a.currency_id


create table
	#conversion_rates(
		currency_id int,
		evaluation_currency_id int NULL,
		begin_date datetime NULL,
		begin_rate float NULL,
		end_date datetime NULL,
		end_rate float NULL)

create table
	#all_currencies(
		currency_id int)
insert into
	#all_currencies
select
	currency_id
from
	#begin_balances
insert into
	#all_currencies
select
	currency_id
from
	#end_balances
insert into
	#all_currencies
select
	currency_id
from
	#account_transactions

insert into
	#conversion_rates(
		currency_id)
select
	distinct(currency_id)
from
	#all_currencies

update
	#conversion_rates
set
	evaluation_currency_id = @evaluation_currency_id,
	begin_date = @begin_date,
	end_date = @end_date

update
	#conversion_rates
set
	begin_rate = 1.0,
	end_rate = 1.0
where
	currency_id = evaluation_currency_id

update
	#conversion_rates
set
	a.begin_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.begin_date)

update
	#conversion_rates
set
	a.begin_rate= 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.begin_date)
and
	a.begin_rate = NULL


update
	#conversion_rates
set
	a.end_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.end_date)

update
	#conversion_rates
set
	a.end_rate= 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, a.end_date)
and
	a.end_rate = NULL

update
	#begin_balances
set
	a.equiv = a.begin_balance * b.begin_rate 
from
	#begin_balances a,
	#conversion_rates b
where
	a.currency_id = b.currency_id

update
	#end_balances
set
	a.equiv = a.end_balance * b.end_rate
from
	#end_balances a,
	#conversion_rates b
where
	a.currency_id = b.currency_id

update
	#account_transactions
set
	a.equiv = a.amount * b.end_rate
from
	#account_transactions a,
	#conversion_rates b
where
	a.currency_id = b.currency_id


create table
	#missing_prices(
		section varchar(200) NULL,
		style varchar(200) NULL,
		status varchar(50) NULL,
		price_date datetime NULL,
		symbol varchar(50) NULL)
insert into
	#missing_prices
select
	section = "Missing Prices",
	style = "background:#FFFFFF;border: 1px solid white",
	status = "No conversion rate found",
	price_date = @begin_date,
	a.symbol
from
	products a,
	#conversion_rates b
where
	a.product_id = b.currency_id
and
	(b.begin_rate = NULL
or
	b.end_rate = NULL)


select
	@missing_conversion_rates = count(*)
from
	#missing_prices
if @missing_conversion_rates > 0
begin
	select
		@price_status = "<b><font color='FF0000'>Prices Missing</font></b>"
end
else
begin
	select
		@price_status = "<b><font color='00CC00'>Prices Saved</font></b>"
end
--Adaptive Server has expanded all '*' elements in the following statement

		
select
	#missing_prices.section, #missing_prices.style, #missing_prices.status, #missing_prices.price_date, #missing_prices.symbol
from
	#missing_prices

/* End price conversion */	

create table
	#begin_nets(
		external_account_id int,
		equiv float NULL)
insert into
	#begin_nets
select
	external_account_id,
	sum(equiv)
from
	#begin_balances
group by
	external_account_id

create table
	#end_nets(
		external_account_id int,
		equiv float NULL)
insert into
	#end_nets
select
	external_account_id,
	sum(equiv)
from
	#end_balances
group by
	external_account_id

create table
	#net_trans(
		external_account_id int,
		transaction_type_id int,
		equiv float NULL)
insert into
	#net_trans
select
	external_account_id,
	transaction_type_id,
	sum(equiv)
from
	#account_transactions
group by
	external_account_id,
	transaction_type_id


create table
	#net_fees(
		external_account_id int,
		equiv float NULL)
insert into
	#net_fees
select
	external_account_id,
	sum(equiv)
from
	#account_transactions a,
	fee_transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
group by
	external_account_id


create table
	#report(
		id int identity,
		section varchar(200) NULL,
		style varchar(200) NULL,
		external_account_id int NULL,
		external_account_type_id int NULL,
		symbol varchar(200),
		reporting_type varchar(50) NULL,
		begin_balance float NULL,
		deposits float NULL,
		withdrawals float NULL,
		fees float NULL,
		invoice float NULL,
		fx_settlement float NULL,
		cfd_settlement float NULL,
		fxt_settlement float NULL,
		unrealized_pl float NULL,
		volume float NULL,
		other float NULL,
		end_balance float NULL,
		change float NULL,
		total_equity float NULL,
		margin float NULL,
		last_trade datetime NULL)
insert into
	#report(
		section,
		style,
		external_account_id,
		external_account_type_id,
		symbol)
select
	section = "Accounts",
	style = "background:#FFFFFF;border: 1px solid white",
	a.external_account_id,
	a.external_account_type_id,
	a.symbol
from
	external_accounts a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
order by
	a.symbol

update
	#report
set
	begin_balance = 0.0,
	deposits = 0.0,
	withdrawals = 0.0,
	fees = 0.0,
	invoice = 0.0,
	fx_settlement = 0.0,
	cfd_settlement = 0.0,
	fxt_settlement = 0.0,
	unrealized_pl = 0.0,
	volume = 0.0,
	other = 0.0,
	end_balance = 0.0,
	change = 0.0,
	total_equity = 0.0,
	margin = 0.0


update
	#report
set
	reporting_type = "Uncategorized"

update
	#report
set
	a.reporting_type = c.name
from
	#report a,
	account_reporting_domains b,
	reporting_domains c
where
	a.external_account_id = b.external_account_id
and
	b.reporting_domain_id = c.reporting_domain_id
	
update
	#report
set
	a.begin_balance = b.equiv
from
	#report a,
	#begin_nets b
where
	a.external_account_id = b.external_account_id

update
	#report
set
	a.end_balance = b.equiv
from
	#report a,
	#end_nets b
where
	a.external_account_id = b.external_account_id

update
	#report
set
	a.deposits = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Deposit"

update
	#report
set
	a.withdrawals = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Withdrawal"

update
	#report
set
	a.invoice = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Invoice"


update
	#report
set
	a.fees = b.equiv
from
	#report a,
	#net_fees b
where
	a.external_account_id = b.external_account_id

update
	#report
set
	a.fx_settlement = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	 c.name = "FX Settlement" 

update
	#report
set
	a.cfd_settlement = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "CFD Settlement"

update
	#report
set
	a.fxt_settlement = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "FXTrades Settlement"

/* Combine the FX and CFD settlements into the FX Settlement column */
update
	#report
set
	fx_settlement = fx_settlement + cfd_settlement + fxt_settlement

update
	#report
set
	cfd_settlement = 0.0,
	fxt_settlement = 0.0


/* Open Positions and Margin */

create table
	#trades(
		trade_id int,
		external_account_id int,
		prime_broker_id int NULL,
		margin_multiplier float NULL,
		quantity float,
		contract_id int,
		product_id int,
		product_qty float,
		currency_id int,
		currency_qty float,
		price float,
		value_date datetime,
		status_id int,
		margin float NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		margin_multiplier,
		quantity,
		contract_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		price,
		value_date,
		status_id,
		margin)
select
	a.trade_id,
	a.external_account_id,
	c.margin_multiplier,
	a.quantity,
	a.contract_id,
	b.product_id,
	a.quantity,
	b.currency_id,
	a.quantity * price * -1.0,
	a.price,
	a.value_date,
	a.status_id,
	margin = 0.0
from
	trades a,
	forwards b,
	#external_accounts c
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	/* a.value_date > @begin_date */
	a.value_date >= @trading_end_date
and
	a.trade_date < @trading_end_date

update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.currency_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin


update
	#trades
set
	a.quantity = a.quantity * -1.0,
	a.product_qty = a.product_qty * -1.0,
	a.currency_qty = a.currency_qty * -1.0
from
	#trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"

create table
	#product_positions(
		external_account_id int,
		product_id int,
		margin float,
		quantity float)
insert into
	#product_positions
select
	external_account_id,
	product_id,
	margin,	
	sum(product_qty)
from
	#trades
group by
	external_account_id,
	product_id,
	margin

insert into
	#product_positions
select
	external_account_id,
	currency_id,
	margin,
	sum(currency_qty)
from
	#trades
group by
	external_account_id,
	currency_id,
	margin

create table
	#margin_balances(
		external_account_id int,
		product_id int,
		quantity float,
		margin float,
		currency_id int NULL,
		ote float NULL,
		equiv float NULL,
		usage float NULL)
insert into
	#margin_balances(
		external_account_id,
		product_id,
		margin,
		quantity)
select
	external_account_id,
	product_id,
	margin,
	sum(quantity)
from
	#product_positions
group by
	external_account_id,
	product_id,
	margin

update
	#margin_balances
set
	currency_id = @evaluation_currency_id

update
	#margin_balances
set
	equiv = quantity
where
	product_id = currency_id

update
	#margin_balances
set
	a.equiv = a.quantity * c.price
from
	#margin_balances a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.equiv = NULL

update
	#margin_balances
set
	a.equiv = a.quantity * (1.0 / c.price)
from
	#margin_balances a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.equiv = NULL


update
	#margin_balances
set
	ote = equiv

update
	#margin_balances
set
	equiv = 0
where
	equiv >= 0.0

update
	#margin_balances
set
	usage = abs(equiv) * margin


create table
	#account_usage(
		external_account_id int,
		nop_short float NULL,
		usage float NULL)
insert into
	#account_usage
select
	external_account_id,
	sum(equiv),
	sum(usage)
from
	#margin_balances
group by
	external_account_id

update
	#report
set
	a.margin = b.usage
from
	#report a,
	#account_usage b
where
	a.external_account_id = b.external_account_id

create table
	#net_ote(
		external_account_id int,
		ote float NULL)
insert into
	#net_ote
select
	external_account_id,
	sum(ote)
from
	#margin_balances
group by
	external_account_id

update
	#report
set
	a.unrealized_pl = b.ote
from
	#report a,
	#net_ote b
where
	a.external_account_id = b.external_account_id

create table
	#last_trade(
		external_account_id int,
		trade_date datetime)
insert into
	#last_trade
select
	external_account_id,
	max(trade_date)
from
	trades
where
	trade_date <= @trading_end_date
group by
	external_account_id

update
	#report
set
	a.last_trade = b.trade_date
from
	#report a,
	#last_trade b
where
	a.external_account_id = b.external_account_id

update
	#report
set
	volume = 0.0

create table
	#volume(
		external_account_id int,
		volume float NULL)
insert into
	#volume
select
	external_account_id,
	sum(volume)
from
	account_volumes
where
	volume_date >= @begin_date
and
	volume_date < @end_of_end_date
and
	product_id = @evaluation_currency_id
group by
	external_account_id


update
	#volume
set
	volume = volume / 1000000.00

update
	#report
set
	a.volume = b.volume
from
	#report a,
	#volume b
where
	a.external_account_id = b.external_account_id


update
	#report
set
	other = end_balance - (begin_balance + deposits + withdrawals + fees + invoice + fx_settlement),
	total_equity = end_balance + unrealized_pl

