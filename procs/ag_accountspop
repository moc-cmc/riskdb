	a.external_account_id = b.external_account_id
	
create table
	#p_l(
		external_account_id int,
		transaction_type_id int,
		equiv float NULL,
		vs_market float NULL,
		vs_clients float NULL)
insert into
	#p_l(
		external_account_id,
		transaction_type_id,
		equiv)
select
	a.external_account_id,
	a.transaction_type_id,
	sum(a.equiv)
from
	#account_transactions a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
	b.name like "%Settlement"
group by
	a.external_account_id,
	a.transaction_type_id

update
	#p_l
set
	vs_market = 0.0,
	vs_clients = 0.0

update
	#p_l
set
	a.vs_market = a.equiv
from
	#p_l a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Counterparty"

update
	#p_l
set
	a.vs_clients = a.equiv
from
	#p_l a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
	
create table
	#pl_output(
		id int identity,
		style varchar(250) NULL,
		transaction_type varchar(50) NULL,
		transaction_type_id int NULL,
		vs_market float NULL,
		vs_clients float NULL,
		p_l float NULL)
insert into
	#pl_output(
		transaction_type_id,
		vs_market,
		vs_clients)
select
	transaction_type_id,
	sum(vs_market),
	sum(vs_clients)
from
	#p_l
group by
	transaction_type_id

update
	#pl_output
set
	p_l = vs_market - vs_clients,
	style = "background:#FFFFFF;border: 1px solid white"

update
	#pl_output
set
	a.transaction_type = b.name
from
	#pl_output a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id

select
	@settlement_pl = sum(p_l)
from
	#pl_output

