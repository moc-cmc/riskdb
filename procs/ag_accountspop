insert into
	#client_report(
		section,
		style,
		external_account_id,
		external_account_type_id,
		symbol,
		reporting_type,
		begin_balance,
		deposits,
		withdrawals,
		fees,
		invoice,
		fx_settlement,
		unrealized_pl,
		volume,
		other,
		end_balance,
		change,
		total_equity,
		margin,
		last_trade,
		validate)
select
	section = "Client Accounts",
	a.style,
	a.external_account_id,
	a.external_account_type_id,
	a.symbol,
	a.reporting_type,
	a.begin_balance,
	a.deposits,
	a.withdrawals,
	a.fees,
	a.invoice,
	a.fx_settlement,
	a.unrealized_pl,
	a.volume,
	a.other,
	a.end_balance,
	a.change,
	a.total_equity,
	a.margin,
	a.last_trade,
        validate = "VALIDATE"
from
	#report a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name != "Counterparty"

update 
	#client_report
set
	a.section = "Internal Accounts"
from
        #client_report a,
        external_accounts b,
        external_account_types c
where
        a.external_account_id = b.external_account_id
and
        b.external_account_type_id = c.external_account_type_id
and
        c.name = "Internal"

delete
	#report
from
	#report a,
	#client_report b
