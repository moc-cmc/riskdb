drop procedure
	r_createfeeschedule
go

create procedure
	r_createfeeschedule
		@login varchar(50),
                @name varchar(50),
                @description varchar(200),
		@fee_schedule_type varchar(50),
		@transaction_type varchar(50),
		@trade_type varchar(50),
		@internal_account varchar(50),
		@external_account varchar(50),
		@book_to_account varchar(50),
		@counterparty varchar(50),
		@symbol varchar(50),
		@trader varchar(50),
		@strategy varchar(50),
		@status varchar(50),
		@broker varchar(50),
		@sales_code varchar(50),
		@product varchar(50),
		@fee_price float,
                @min_ticket_size float=NULL,
                @direction varchar(50)


as

declare @trade_type_id int  
declare @internal_account_id int 
declare @external_account_id int 
declare @book_to_ext_account_id int
declare @counterparty_id int 
declare @contract_id int 
declare @trader_id int 
declare @strategy_id int 
declare @status_id int 
declare @broker_id int 
declare @sales_code_id int 
declare @fee_product_id int
declare @product_id int
declare @fee_schedule_type_id int
declare @created_by int
declare @created_at datetime
declare @debit_or_credit int
declare @transaction_type_id int

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = @transaction_type
if @@rowcount != 1
begin
	select
		error  = "Transaction type must be set. Please try again"
	return
end


if @direction = "Credit"
begin
	select
		@debit_or_credit = 1
end

if @direction = "Debit"
begin
	select
		@debit_or_credit = -1
end

if @direction = NULL
begin
	select
		error = "Direction must be set. Please try again"
	return
end

if @min_ticket_size = NULL
begin
	select 
		@min_ticket_size = 0.0
end
		
select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = @trade_type
if @@rowcount != 1
begin
        select
                @trade_type_id = NULL
end


select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @internal_account
if @@rowcount != 1
begin
        select
                @internal_account_id = NULL
end


select
        @external_account_id = external_account_id
from
        external_accounts
where
        symbol = @external_account
if @@rowcount != 1
begin
        select
                @external_account_id = NULL
end

select
	@book_to_ext_account_id = external_account_id
from
        external_accounts
where
        symbol = @book_to_account
if @@rowcount != 1
begin
        select
                @book_to_ext_account_id = @external_account_id

	if @book_to_ext_account_id = NULL
	begin
		select
			@book_to_ext_account_id = NULL
	end
end



select
	@counterparty_id = counterparty_id 
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
        select
                @counterparty_id = NULL
end


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
        select
                @contract_id = NULL
end


select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
        select
                @trader_id = NULL
end


select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin
        select
                @strategy_id = NULL
end


select
	@status_id = status_id
from
	statuses
where
	name = @status
if @@rowcount != 1
begin
        select
                @status_id = NULL
end


select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
        select
                @broker_id = NULL
end


select
	@sales_code_id 
from
	sales_codes
where 
	name = @sales_code
if @@rowcount != 1
begin
        select
                @sales_code_id = NULL
end


select
	@fee_product_id = product_id
from
	products
where
	symbol = @product
if @@rowcount != 1
begin
	select
		error = "Product must be selected. Please try again"
	return
end

select
	@fee_schedule_type_id = fee_schedule_type_id
from
	fee_schedule_types
where
	name = @fee_schedule_type

if @fee_schedule_type_id = NULL
begin
	select
		error = "Fee Schedule Type must be selected. Please try again"
	return
end

select
	@created_by = account_id
from
	tico_accounts
where
	login = @login

select
	@created_at = getdate()
		
if @fee_price = NULL
begin
	select
		@fee_price = 0
end

insert into
	fee_schedules
values(
        @name,
        @description,
	@fee_schedule_type_id,
        @trade_type_id,
        @internal_account_id,
        @external_account_id,
        @counterparty_id,
        @contract_id,
        @trader_id,
        @strategy_id,
        @status_id,
        @broker_id,
        @sales_code_id,
        @fee_product_id,
	@fee_price,
        @min_ticket_size,
	@debit_or_credit,
	@created_at,
	@created_by,
	@transaction_type_id,
	@book_to_ext_account_id)


exec
	r_viewfeeschedule
		@login

go
