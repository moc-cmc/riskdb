if object_id("tt_importabngriptransaction") != NULL
    drop procedure
        tt_importabngriptransaction
go

create procedure
	tt_importabngriptransaction
			@external_reference	varchar(100),
			@trade_date		varchar(50)=NULL,
			@abn_account		varchar(50)=NULL,
			@trading_party		varchar(50)=NULL,
			@counter_party		varchar(50)=NULL,
			@transaction_type	varchar(50)=NULL,
			@ccy1			varchar(50)=NULL,
			@quantity1		varchar(50)=NULL,
			@quantity1_dir		varchar(50)=NULL,
			@ccy2			varchar(50)=NULL,
			@quantity2		varchar(50)=NULL,
			@quantity2_dir		varchar(50)=NULL,
			@price			varchar(50)=NULL,
			@value_date		varchar(50)=NULL,
			@portfolio		varchar(50)=NULL,
			@trader			varchar(50)=NULL,
			@fixing_date		varchar(50)=NULL,
			@direction		varchar(50)=NULL,
			@quantity_long		varchar(50)=NULL,
			@quantity_short		varchar(50)=NULL,
			@primary_amount		varchar(50)=NULL,
			@primary_amount_dc	varchar(20)=NULL,
			@primary_amount_ccy	varchar(20)=NULL,
			@comments		varchar(50)=NULL,
			@import_b2b		char(1)=NULL
			/* -- dont process swaps as of now
			@far_rate		varchar(50)=NULL,
			@far_value_date		varchar(50)=NULL,
			@far_qty_1		varchar(50)=NULL,
			@far_qty_2		varchar(50)=NULL,
			@far_fixing_date	varchar(50)=NULL
			*/

as

declare @qty_1 float
declare @qty_2 float
declare @rate float

select
	@qty_1 = convert(float, @quantity1),
	@qty_2 = convert(float, @quantity2),
	@rate = convert(float, @price)
	
declare @reported_matched_status_id int
declare @reported_unmatched_status_id int
declare @reported_edited_status_id int
declare @reported_deleted_status_id int
declare @report_trade_status_id int

declare @fund_report_id int
declare @external_report varchar(50)
declare @external_report_id int
declare @external_report_source_id int
declare @trade_type varchar(50)

declare @report_commit_id int
declare @begin_date datetime
declare @contract varchar(50)
declare @contract_id int
declare @trade_id int
declare @contract_price_style varchar(25)
declare @trade_type_id int
declare @trader_id int
declare @strategy_id int
declare @tally_quantity numeric(30, 2)
declare @mkt_tally_quantity numeric(30, 2)
declare @cl_tally_quantity numeric(30, 2)

declare @cl_report_trade_id int
declare @cl_existing_rt_status_id int
declare @cl_identifier varchar(100)
declare @cl_counterparty_name varchar(50)
declare @cl_external_account varchar(50)
declare @cl_external_account_type_id int
declare @cl_external_account_type varchar(25)
declare @cl_external_account_id int
declare @cl_trader_id int
declare @cl_counterparty_id int

declare @mkt_report_trade_id int
declare @mkt_existing_rt_status_id int
declare @mkt_identifier varchar(100)
declare @mkt_counterparty_name varchar(50)
declare @mkt_external_account varchar(50)
declare @mkt_external_account_type_id int
declare @mkt_external_account_type varchar(25)
declare @mkt_external_account_id int
declare @mkt_trader_id int
declare @mkt_counterparty_id int


select
	@external_report = "ABN GRIP Transactions"

select 
	@external_report_id = external_report_id,
	@external_report_source_id = source_id
from
	external_reports
where
	name = @external_report
if @external_report_id = NULL
begin
	select
		error = "Error",
		msg = "Problem finding external report",
		report = @external_report
	return
end

select
	@fund_report_id = fund_report_id
from
	fund_reports
where
	external_report_id = @external_report_id
if @@rowcount != 1
begin
	select
		error = "Error",
		msg = "Problem determinig fund report from external report",
		external_report = @external_report
end

declare @activity_date datetime


select
    @activity_date = convert(datetime, convert(char(10), @trade_date, 101))
exec
    r_prevbusinessday
        @activity_date,
        @activity_date output
exec
    r_nextbusinessday
        @activity_date,
        @activity_date output


select
	@report_commit_id = a.report_commit_id
from
	report_commits a
where
	a.fund_report_id = @fund_report_id
and
	a.trade_date = @activity_date
if @report_commit_id = NULL
begin
	declare @review_status_id int
	
	select
		@review_status_id = status_id
	from
		statuses
	where
		name = "Review"
	if @review_status_id = NULL
	begin
	        select
       	                error = "Error",
                        msg = "Problem finding status 'Review'"
		return
	end

	insert into 
		report_commits
	(
		fund_report_id,
		trade_date,
		status_id,
		update_date
	)
	values
	(
		@fund_report_id,
		@activity_date,
		@review_status_id,
		getdate()
	)

	select
		@report_commit_id = a.report_commit_id
	from
		report_commits a
	where
		a.fund_report_id = @fund_report_id
	and
		a.trade_date = @activity_date
	if @report_commit_id = NULL
	begin
		select
			error = "Error", 
			msg = "Problem determining/creating report commit"
		return
	end
end




select
	@cl_identifier = rtrim(@external_reference) + ".c",
	@mkt_identifier = rtrim(@external_reference) + ".m"



select 
	@mkt_existing_rt_status_id = status_id,
	@mkt_report_trade_id = report_trade_id
from
	report_trades	
where
	identifier = @mkt_identifier

select
        @cl_existing_rt_status_id = status_id,
        @cl_report_trade_id = report_trade_id
from
        report_trades
where
        identifier = @cl_identifier



/*
 *	MARK: Check to see if @counterparty matches a counterparty_symbol or counterparty
 */
select
	@mkt_counterparty_name = a.name,
	@mkt_counterparty_id = a.counterparty_id,
	@mkt_external_account_id = a.external_account_id
from
	counterparties a, 
	counterparty_symbols b 
where
	a.counterparty_id = b.counterparty_id
and
	b.source_id = @external_report_source_id
and
	b.symbol = @counter_party
if @mkt_counterparty_name = NULL
begin
	select 
		@mkt_counterparty_name = name,
		@mkt_counterparty_id = counterparty_id,
		@mkt_external_account_id = external_account_id
	from
		counterparties
	where
		name = @counter_party
	if @mkt_counterparty_name = NULL
	begin
	        select
                	error = "Error",
                	msg = "Problem determining market counterparty",
                	symbol = @counter_party
	end
	return	
end


if @cl_counterparty_name = NULL
begin
	select
      		@cl_external_account = a.symbol,
  		@cl_external_account_id = a.external_account_id
	from
   		external_accounts a,
       		external_account_symbols b
	where
   		a.external_account_id = b.external_account_id
	and
     		b.source_id = @external_report_source_id
	and
        	b.symbol = @trading_party
	if @cl_external_account = NULL
	begin
        	select
               		@cl_external_account = symbol,
              		@cl_external_account_id = external_account_id
        	from
               		external_accounts
        	where
               		name = @trading_party
		if @cl_external_account = NULL 
		begin
			select
				error = "Error",
				msg = "Problem determining client external_account",
				symbol = @trading_party
			return
		end
       	end
	select
		@cl_counterparty_name = a.name,
		@cl_counterparty_id = a.counterparty_id
	from
		counterparties a,
		counterparty_symbols b
	where
		a.counterparty_id = b.counterparty_id
	and
		b.source_id = @external_report_source_id
	and
		b.symbol = @abn_account
	if @cl_counterparty_name = NULL
	begin
		select
			error = "Error", 
			msg = "Problem determining counterparty for client trade",
            		abn_account = @abn_account
		return
	end
end
		
/*
select
	id = @interal_reference,
	counterparty = @counterparty_name,
	external_account = @external_account
*/

		

select
	@mkt_external_account_type_id = external_account_type_id
from
	external_accounts
where
	external_account_id = @mkt_external_account_id
if @mkt_external_account_type_id = NULL
begin
        select
                error = "Error",
                msg = "Problem determining external account type from ext account",
		ext_id = @mkt_external_account_id
	
	return
end

select
	@mkt_external_account_type = name
from
	external_account_types
where
	external_account_type_id = @mkt_external_account_type_id
if @mkt_external_account_type = NULL
begin
        select
                error = "Error",
                msg = "Problem determining external account type"
	return
end

select
        @cl_external_account_type_id = external_account_type_id
from
        external_accounts
where
        external_account_id = @cl_external_account_id
if @cl_external_account_type_id = NULL
begin
        select
                error = "Error",
                msg = "Problem determining external account type from ext account",
                ext_id = @cl_external_account_id

        return
end

select
        @cl_external_account_type = name
from
        external_account_types
where
        external_account_type_id = @cl_external_account_type_id
if @cl_external_account_type = NULL
begin
        select
                error = "Error",
                msg = "Problem determining external account type"
        return
end

if @direction = "SELL"
begin
	if @quantity2_dir = "D"
	begin
		select
			@contract = rtrim(@ccy2)+rtrim(@ccy1),
			@tally_quantity = @qty_2 * -1
	end
	else if @quantity2_dir = "C"
	begin
		select
			@contract = rtrim(@ccy1)+rtrim(@ccy2),
			@tally_quantity = @qty_1 * -1
	end
end
else if @direction = "BUY"
begin
	if @quantity2_dir = "C"
	begin
		select
			@contract = rtrim(@ccy2)+rtrim(@ccy1),
			@tally_quantity = @qty_2
	end
	else if @quantity2_dir = "D"
	begin
		select
			@contract = rtrim(@ccy1)+rtrim(@ccy2),
			@tally_quantity = @qty_1
	end
end
else
begin
	select
		error = "Error",
		msg = "Direction not 'SELL' or 'BUY'. Not tallying report trade"
	return
end

select
	@mkt_tally_quantity = @tally_quantity,
	@cl_tally_quantity = @tally_quantity * -1


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @contract
if @contract_id = NULL
begin
	select
		error = "Error",
		msg = "Contract not found",
		contract = @contract
	return
end

select
	@contract_price_style = b.name
from
	contract_price_styles a,
	price_styles b
where
	a.price_style_id = b.price_style_id
and
	a.contract_id = @contract_id


/*
select
	@price = @qty_2/@qty_1
*/





if @transaction_type = "FX CONF"
begin
	select
		@trade_type = "Spot"
	select
		@trade_type_id = trade_type_id
	from
		trade_types
	where
		name = @trade_type
	if @trade_type_id = NULL
	begin	
		select
			error = "Error",
			msg = "Problem finding trade type 'Forward'"
		return
	end
end


select
	@cl_trader_id = a.trader_id
from
	traders a,
	trader_symbols b
where
	a.trader_id = b.trader_id
and
	b.source_id = @external_report_source_id
and
	b.symbol = @trader
if @trader_id = NULL
begin
	select
		@trader_id = trader_id
	from
		traders
	where
		symbol = @trader
end

select
	@strategy_id = strategy_id
from
	strategies
where
	name = @portfolio
	

if @mkt_existing_rt_status_id = NULL
begin
		exec
			fxa_addreporttrade
				@report_trade_id=NULL,
				@report_deal_id=NULL,
				@report_commit_id=@report_commit_id,
				@import_date=NULL, /* default to getdate() in fxa_addreporttrade */
				@trade_type_id=@trade_type_id,
				@trade_type=NULL,
				@external_account_type_id=@mkt_external_account_type_id,
				@external_account_type=NULL,
				@external_account_id=@mkt_external_account_id,
				@external_account=NULL,
				@counterparty_id=@mkt_counterparty_id,
				@counterparty=NULL,
				@quantity=@mkt_tally_quantity,
				@contract_id=@contract_id,
				@contract=NULL,
				@value_date=@value_date,
				@fixing_date=@fixing_date,
				@price=@rate,
				@trade_date=@trade_date,
				@trader_id=@mkt_trader_id,
				@trader=NULL ,
				@strategy_id=@strategy_id,
				@strategy=NULL,
				@status_id=NULL,
				@status="Review",
				@broker_id=NULL,
				@broker=NULL ,
				@identifier=@mkt_identifier,
				@pct_price=NULL,
				@spot_reference=@rate,
				@reporter_identifier=@external_reference,
				@trade_id=@trade_id
end
if @import_b2b = "Y" and @cl_existing_rt_status_id = NULL
begin
		exec
			fxa_addreporttrade
				@report_trade_id=NULL,
				@report_deal_id=NULL,
				@report_commit_id=@report_commit_id,
				@import_date=NULL, /* default to getdate() in fxa_addreporttrade */
				@trade_type_id=@trade_type_id,
				@trade_type=NULL,
				@external_account_type_id=@cl_external_account_type_id,
				@external_account_type=NULL,
				@external_account_id=@cl_external_account_id,
				@external_account=NULL,
				@counterparty_id=@cl_counterparty_id,
				@counterparty=NULL,
				@quantity=@cl_tally_quantity,
				@contract_id=@contract_id,
				@contract=NULL,
				@value_date=@value_date,
				@fixing_date=@fixing_date,
				@price=@rate,
				@trade_date=@trade_date,
				@trader_id=@cl_trader_id,
				@trader=NULL ,
				@strategy_id=@strategy_id,
				@strategy=NULL,
				@status_id=NULL,
				@status="Review",
				@broker_id=NULL,
				@broker=NULL ,
				@identifier=@cl_identifier,
				@pct_price=NULL,
				@spot_reference=@rate,
				@reporter_identifier=@external_reference,
				@trade_id=@trade_id


end

select status = "Success"
go
