
drop procedure
	ag_sendfailedmappingmessage
go


create procedure
	ag_sendfailedmappingmessage
			@login varchar(25),
			@broker_id int,
			@identifier varchar(100),
			@mapping_error_type varchar(15),
			@message varchar(250)
as

declare @message_id int
declare @mapping_error_id int
declare @mapping_error_type_id int
declare @subject varchar(40) 

select	
	@mapping_error_type_id = mapping_error_type_id
from
	mapping_error_types
where
	name = @mapping_error_type
if @mapping_error_type_id = NULL
begin
	select
		status = "Error",
		message = "Could not find mapping_error_type",
		mapping_error_type = @mapping_error_type
	return
end


exec 
       	j_nextkey
               	"mapping_errors", 
               	@mapping_error_id output

select 
	@message_id=NULL,
	@subject = "Failed Mapping #"+rtrim(convert(varchar(20), @mapping_error_id))

exec
	api_sendchannelmessage
		@login=@login,
		@channel="Inbound STP",
		@message_type="Mapping",
		@subject=@subject,
		@content=@message,
		@priority="High",
		@message_id=@message_id output

if (@message_id != NULL)
begin
	insert into
		mapping_errors
		(
		mapping_error_id,
		broker_id,
		identifier,
		mapping_error_type_id,
		timestamp)
	values(
		@mapping_error_id,
		@broker_id,
		@identifier,
		@mapping_error_type_id,
		getdate())

	insert into
		mapping_error_messages
		(
		mapping_error_id,
		message_id)
	values(
		@mapping_error_id,
		@message_id)
end

return

go



