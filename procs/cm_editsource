
if object_id("cm_editsource") != NULL
    drop procedure
        cm_editsource
go

create procedure
	cm_editsource
		@login varchar(30),
		@source varchar(30),
		@new_name varchar(30)
as

declare @source_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)


select
	@source_id = source_id
from
	sources
where
	name = @new_name
if @source_id != NULL
begin
	select
		status = "Error",
		message = "New source name already exists",
		new_name = @new_name
	return
end

update
	sources
set
	name = @new_name
where
	name = @source


select
        @tico_server = tico_server,
        @tico_database = tico_database
from
        funds

select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string


exec
	cm_sources
		@login

go
