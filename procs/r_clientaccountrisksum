	statuses b,
	external_accounts c,
	contracts d
where
	a.external_account_id = c.external_account_id
and
	a.contract_id = d.contract_id
and
	a.status_id = b.status_id
and
	b.name != "Resid"
group by
	c.symbol,
	d.symbol
order by
	c.symbol,
	d.symbol

update
	#positions
set
	a.external_account_id = b.external_account_id
from
	#positions a,
	external_accounts b
where
	a.account = b.symbol

update
	#positions
set
	a.contract_id = b.contract_id
from
	#positions a,
	contracts b
where
	a.symbol = b.symbol

delete

from
	#positions
where
	position = 0.0

update
	#positions
set
	section = "Positions",
	style = "background:#FFFFFF;border: 1px solid white"

create table
	#min_ids(
		external_account_id int,
		id int)
insert into
	#min_ids
select
	external_account_id,
	min(id)
from
	#positions
group by
	external_account_id

update
	#positions
set
	style = "background:#FFFFCC;border: 1px solid white"
from
	#positions a,
	#min_ids b
where
	a.id = b.id
and
	a.external_account_id = b.external_account_id

select
	section = "Margin Usage",
	a.style,
	account = b.symbol,
	type = c.name,
	cash = a.cash_equiv * a.conversion_rate,
	settlements = a.settlements * a.conversion_rate,
	open_eqty = a.open_trade_equity * a.conversion_rate,
	total_equity = a.total_equity * a.conversion_rate,
	nop_short = a.nop_equiv * a.conversion_rate,
	margin_use = a.margin_use * a.conversion_rate,
	excess = a.excess * a.conversion_rate,
  currency = d.symbol,
	a.status,
	trade_date = convert(datetime, convert(date, @end_date))
from
	#output a,
	external_accounts b,
	external_account_types c,
  products d
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
  a.currency_id = d.product_id
order by
	b.symbol
	
select
	section = "Net PB vs Net Client",
	style = "background:#FFFFFF;border: 1px solid white",
	account_type = a.name,
	nop = b.nop_equiv,
	b.margin_use
from
	external_account_types a,
	#by_type b
where
	a.external_account_type_id = b.external_account_type_id
order by
	b.nop_equiv desc


select
	a.section,
	a.style,
	account = b.symbol,
	c.symbol,
	a.position
from
	#positions a,
	external_accounts b,
	contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
order by
	a.id 

