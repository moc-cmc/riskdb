create table
	#external_accounts(
		external_account_id int,
    		symbol varchar(50),
		prime_broker_id int NULL,
		margin_multiplier float NULL)

insert into
	#external_accounts(
		external_account_id,
		symbol,
		prime_broker_id,
		margin_multiplier)
select
	a.external_account_id,
  	a.symbol,
	d.prime_broker_id,
	a.margin_multiplier
from
	external_accounts a,
	fund_external_accounts b,
	external_account_types c,
	external_account_prime_brokers d
where
	a.external_account_id = b.external_account_id
and
	a.external_account_type_id = c.external_account_type_id
and
	a.external_account_id = d.external_account_id
and
	c.name in( "Client", "Counterparty")
and
	a.symbol not in("INTERNAL", "FC FTPROA3900")


