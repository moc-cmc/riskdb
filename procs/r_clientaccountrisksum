create table
	#margin_balances(
		external_account_id int,
		product_id int,
		quantity float,
		margin float,
		currency_id int NULL,
		equiv float NULL,
		usage float NULL)
insert into
	#margin_balances(
		external_account_id,
		product_id,
		margin,
		quantity)
select
	external_account_id,
	product_id,
	margin,
	sum(quantity)
from
	#product_positions
group by
	external_account_id,
	product_id,
	margin

update
	#margin_balances
set
	currency_id = @evaluation_currency_id

update
	#margin_balances
set
	equiv = quantity
where
	product_id = currency_id

update
	#margin_balances
set
	a.equiv = a.quantity * c.price
from
	#margin_balances a,
	forwards b,
	prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @trade_date)
and
	a.equiv = NULL

update
	#margin_balances
set
	a.equiv = a.quantity * (1.0 / c.price)
from
	#margin_balances a,
	forwards b,
	prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @trade_date)
and
	a.equiv = NULL

update
	#margin_balances
set
	a.equiv = a.quantity * c.price
from
	#margin_balances a,
	forwards b,
	current_prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	a.equiv = NULL

update
	#margin_balances
set
	a.equiv = a.quantity * (1.0 / c.price)
from
	#margin_balances a,
	forwards b,
	current_prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	a.equiv = NULL

update
	#margin_balances
set
	equiv = 0
where
	equiv >= 0.0

update
	#margin_balances
set
	usage = abs(equiv) * margin


