create table
	#output(
		style varchar(200) NULL,
		external_account_id int,
		external_account_type_id int,
    currency_id int NULL,
    conversion_rate float NULL,
		cash_equiv float NULL,
		settlements float NULL,
		open_trade_equity float NULL,
		total_equity float NULL,
		nop_equiv float NULL,
		margin_use float NULL,
		excess float NULL,
		status varchar(50) NULL)
insert into
	#output(
		style,
		external_account_id,
		external_account_type_id,
		cash_equiv,
		settlements,
		open_trade_equity,
		total_equity,
		nop_equiv,
		margin_use,
		status)
select
	style = "background:#FFFFFF;border: 1px solid white",
	a.external_account_id,
	a.external_account_type_id,
	cash_equiv = 0.0,
	settlements = 0.0,
	open_trade_equity = 0.0,
	total_equity = 0.0,
	nop_equiv = 0.0,
	margin_use = 0.0,
	status = "Excess"
from
	external_accounts a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	a.cash_equiv = b.cash_equiv,
	a.open_trade_equity = b.open_trade_equity
from
	#output a,
	#balance_nets b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	a.settlements = b.equiv
from
	#output a,
	#account_settlements b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	total_equity = cash_equiv + settlements + open_trade_equity

update
	#output
set
	a.nop_equiv = b.nop_short,
	a.margin_use = b.usage
from
	#output a,
	#account_usage b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	excess = total_equity - margin_use

update
	#output
set
	status = "Deficit",
	style = "background:#E1F2EB;color:#FF0000;border: 1px solid white"
where
	excess < 0.0

update
  #output
set
  currency_id = @evaluation_currency_id

/* The #output.currency_id is now @evaluation_currency_id. If
 * @evaluation_currency is "NATIVE", then update it to the
 * external_accounts.evaluation_currency_id. If @evaluation_currency is
 * otherwise non-NULL, then try to set it to the @evaluation_currency */
if lower(@evaluation_currency) = "native"
begin

  update
    #output
  set
    currency_id = b.evaluation_currency_id
  from
    #output a,
    external_accounts b
  where
    a.external_account_id = b.external_account_id

end
else if @evaluation_currency != null
begin

  update
    #output
  set
    currency_id = b.product_id
  from
    #output a,
    products b,
    product_types c
  where
    b.product_type_id = c.product_type_id
  and
    c.name = "Currency"
  and
    b.symbol = @evaluation_currency

end

update
	#output
set
	conversion_rate = 1.0
where
	currency_id = @evaluation_currency_id

update
	#output
set
	a.conversion_rate = c.price
from
	#output a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#output
set
	a.conversion_rate = 1.0 / c.price
from
	#output a,
	forwards b,
	prices c
where
	b.product_id = a.currency_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.conversion_rate = NULL

update
	#output
set
	a.conversion_rate = c.price
from
	#output a,
	forwards b,
	current_prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.currency_id
and
	b.contract_id = c.contract_id
and
	a.conversion_rate = NULL

update
	#output
set
	a.conversion_rate = 1.0 / c.price
from
	#output a,
	forwards b,
	current_prices c
where
	b.product_id = a.currency_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	a.conversion_rate = NULL

