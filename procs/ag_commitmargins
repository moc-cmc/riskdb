use
	risk_finotec
go

drop procedure
	ag_commitmargins
go

create procedure
	ag_commitmargins
		@login varchar(50),
		@trade_date datetime
as

declare @fund_id int
declare @revals int
declare @id int
declare @ids int
declare @account_snapshot_id int
declare @external_account_id int
declare @transaction_type_id int
declare @margin float
declare @currency_id int
declare @contract_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@revals = count(*)
from
	committed_daily_revals
where
	convert(date, bo_trade_date) = convert(date, @trade_date)
if @revals = 0 or @revals = NULL
begin
	select
		status = "Error",
		message = "No revals found for date",
		trade_date = @trade_date
	return
end

create table
	#margins(
		default_margin_id int NULL,
		contract_id int,
		margin float NULL,
		as_of_date datetime)
insert into
	#margins(
		contract_id,
		as_of_date)
select
	contract_id,
	max(as_of_date)
from
	default_margins
where
	fund_id = @fund_id
group by
	contract_id

update
	#margins
set
	a.default_margin_id = b.default_margin_id,
	a.margin = b.margin
from
	#margins a,
	default_margins b
where
	a.contract_id = b.contract_id
and
	a.as_of_date = b.as_of_date


create table
	#overrides(
		account_margin_id int NULL,
		external_account_id int,
		contract_id int,
		margin float NULL,
		as_of_date datetime)
insert into
	#overrides(
		external_account_id,
		contract_id,
		as_of_date)
select
	a.external_account_id,
	a.contract_id,
	max(a.as_of_date)
from
	account_margins a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.fund_id = @fund_id
group by
	a.external_account_id,
	a.contract_id

update
	#overrides
set
	a.account_margin_id = b.account_margin_id,
	a.margin = b.margin
from
	#overrides a,
	account_margins b
where
	a.contract_id = b.contract_id
and
	a.as_of_date = b.as_of_date
and
	a.external_account_id = b.external_account_id


create table
	#trades(
		trade_id int,
		external_account_id int,
		quantity numeric(30,4),
		contract_id int,
		currency_id int,
		value_date datetime,
		margin float NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		quantity,
		contract_id,
		currency_id,
		value_date)
select
	a.trade_id,
	b.external_account_id,
	b.quantity,
	a.contract_id,
	a.native_currency_id,
	a.value_date
from
	committed_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	convert(date, a.bo_trade_date) = convert(date, @trade_date)


update
	#trades
set
	a.margin = a.quantity * b.margin
from
	#trades a,
	#margins b
where
	a.contract_id = b.contract_id
	

update
	#trades
set
	a.margin = a.quantity * b.margin
from
	#trades a,
	#overrides b
where
	a.contract_id = b.contract_id
and
	a.external_account_id = b.external_account_id


create table
	#net_usage(
		id int identity,
		external_account_id int,
		currency_id int,
		margin float NULL)

insert into
	#net_usage(
		external_account_id,
		currency_id,
		margin)
select
	external_account_id,
	currency_id,
	sum(margin)
from
	#trades
group by
	external_account_id,
	currency_id


select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Margin"
if @transaction_type_id = NULL
begin
	exec
		j_nextkey
			"transaction_types",
			@transaction_type_id output

	insert into
		transaction_types
	values(
		@transaction_type_id,
		"Margin",
		1,
		"margin")
end

select
	@id = 0
select
	@ids = count(*)
from
	#net_usage
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#net_usage
	where
		id > @id

	select
		@external_account_id = NULL,
		@margin = NULL,
		@currency_id = NULL

	select
		@external_account_id = external_account_id,
		@margin = margin,
		@currency_id = currency_id
	from
		#net_usage
	where
		id = @id


	if @margin = NULL
	begin
		select
			status = "Error",
			message = "Null errro found",
			external_account_id = @external_account_id
	end
	else
	begin
		exec
			j_nextkey
				"account_snapshots",
				@account_snapshot_id output

		insert into
			account_snapshots
		values(
			@account_snapshot_id,
			@external_account_id,
			@transaction_type_id,
			@margin,
			@currency_id,
			@trade_date,
			NULL)
	end
		


	select
		@ids = count(*)
	from
		#net_usage
	where
		id > @id
end



go
