drop procedure cbo_runcommittedfees
go

create procedure
	cbo_runcommittedfees	
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime= NULL,
		@end_date datetime=NULL,
		@display varchar(50)=NULL
as

declare @run_id int
declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @evaluation_currency_id int
declare @fund_id int
declare @max_commit_date datetime

if @display = NULL
	select
		@display = "Summary"


create table
	#links(
       		meta_type char(200),
       		name char(50) NULL,
       		action char(100) NULL,
       		value char(200) NULL)

insert into
        #links
values (
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #links
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into
   #links
values(
   "Column Format",
   "rate",
   "Number",
   "#,##0.00")


select * from #links

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)

insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#product_transactions(
		product_transaction_id int,
		deal_id int,
		transaction_date datetime,
		product_id int NULL,
		value_date datetime,
		quantity numeric(30,4),
		trade_price float,
		trader_id int,
		broker_id int,
		external_account_id int,
		counterparty_id int,
		price float,
		fee_schedule_id int NULL,
		fee_schedule_name varchar(50) NULL,
		fee_schedule_type_id int NULL,
		fee_schedule_type varchar(50) NULL,
		trade_id int NULL)

insert into
	#product_transactions
select
	a.product_transaction_id,
	a.deal_id,
	a.transaction_date,
	a.product_id,
	a.value_date,
	a.quantity,
	a.price,
	a.trader_id,
	a.broker_id,
	a.external_account_id,
	a.counterparty_id,
	a.price,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL
from
	product_transactions a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date


update
	#product_transactions
set
	trade_id = b.trade_id,
	fee_schedule_name = c.name,
	fee_schedule_id = c.fee_schedule_id,
	fee_schedule_type_id = c.fee_schedule_type_id
from
	#product_transactions a,
	fs_product_transactions b,
	fee_schedules c
where
	a.product_transaction_id = b.product_transaction_id
and
	b.fee_schedule_id = c.fee_schedule_id

update
	#product_transactions
set
	fee_schedule_type = b.name
from
	#product_transactions a,
	fee_schedule_types b
where
	a.fee_schedule_type_id = b.fee_schedule_type_id

create table
	#summary
(
	fee_schedule_id int,
	fee_schedule_name varchar(50),
	total_quantity float NULL,
	total_breaks float NULL,
	total_fees float NULL
)
insert into
	#summary(
		fee_schedule_id,
		fee_schedule_name,
		total_quantity,
		total_breaks,
		total_fees
	)
select
	fee_schedule_id,
	fee_schedule_name,
	total_quantity = sum(quantity),
	total_breaks = sum(quantity * (1-price)) * -1,
	total_fees = sum(quantity) + (sum(quantity * (1-price)) * -1)
from
	#product_transactions
group by
	fee_schedule_id,
	fee_schedule_name

select
	section = "Fee Summary",
	run_name = @run_name,
	begin_range = @begin_date,
	end_range = @end_date,
        fee_schedule_name,
        total_quantity,
        total_breaks,
        total_fees
from
	#summary



	
if @display = "Detail"
begin
	select
		section = "Fee Details",
		a.product_transaction_id,
		a.deal_id,
		transaction_date = convert(char(11), a.transaction_date, 1),
		transaction_time = right(convert(char(26), a.transaction_date, 9), 14),
		/*a.value_date,*/
		amount=a.quantity,
		rate=a.trade_price,
		break_discount = (quantity * (1-price)) * -1,
		total_amount = a.quantity + ((quantity * (1-price)) * -1),
		trader = c.symbol,
		broker = d.symbol,
		external_account = e.symbol,
		counterparty = g.name,
		fee_schedule=a.fee_schedule_name,
		from_trade_id=a.trade_id
	from
		#product_transactions a,
		traders c,
		brokers d,
		external_accounts e,
		counterparties g
	where
		a.trader_id = c.trader_id
	and
		a.broker_id = d.broker_id
	and
		a.external_account_id = e.external_account_id
	and
		a.counterparty_id = g.counterparty_id
	order by
		a.deal_id
	
end	

go
