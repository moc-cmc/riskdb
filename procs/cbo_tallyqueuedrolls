drop procedure
	cbo_tallyqueuedrolls
go

create procedure
	cbo_tallyqueuedrolls
		@login varchar(50),
		@batch_id int
as

declare @fund_id int
declare @fund varchar(100)
declare @roll_trader_id int
declare @roll_trader varchar(50)
declare @roll_trader_login varchar(50)
declare @roll_trader_account_id int

declare @queued_rolls int
declare @queued_roll_id int

declare @deal_id int
declare @account varchar(50)
declare @near_quantity numeric(30,4)
declare @far_quantity numeric(30,4)
declare @dealt_currency varchar(50)
declare @counter_currency varchar(50)
declare @near_date datetime
declare @near_price float
declare @far_date datetime
declare @far_price float
declare @trade_date datetime



exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@fund = name
from
	funds
where
	fund_id = @fund_id

select	
	@roll_trader_id = roll_trader_id
from
	fund_roll_traders
where
	fund_id = @fund_id


select
	@roll_trader = symbol,
	@roll_trader_account_id = tico_account_id
from
	traders
where
	trader_id = @roll_trader_id
if @roll_trader = NULL
begin
	select
		status = "Error",
		message = "Roll trader not found"
	return
end

select
	@roll_trader_login = login
from
	tico_accounts
where
	account_id = @roll_trader_account_id


select
	@queued_roll_id = 0
select
	@queued_rolls = count(*)
from
	queued_rolls
where
	batch_id = @batch_id

while @queued_rolls > 0
begin
	select
		@queued_roll_id = min(queued_roll_id)
	from
		queued_rolls
	where
		batch_id = @batch_id
	and
		queued_roll_id > @queued_roll_id


	select
		@account = NULL,
		@near_quantity = NULL,
		@far_quantity = NULL,
		@dealt_currency = NULL,
		@counter_currency = NULL,
		@near_date = NULL,
		@near_price = NULL,
		@far_date = NULL,
		@far_price = NULL,
		@trade_date = NULL,
		@deal_id = NULL

	select
		@account = account,
		@near_quantity = near_quantity,
		@far_quantity = far_quantity,
		@dealt_currency = dealt_currency,
		@counter_currency = counter_currency,
		@near_date = near_date,
		@near_price = near_price,
		@far_date = far_date,
		@far_price = far_price,
		@trade_date = trade_date
	from
		queued_rolls
	where
		queued_roll_id = @queued_roll_id

	/* select
		account = @account,
		trader = @roll_trader,
		near_quantity = @near_quantity,
		far_quantity = @far_quantity,
		dealt_currency = @dealt_currency,
		counter_currency = @counter_currency,
		near_date = @near_date,
		near_price = @near_price,
		far_date = @far_date,
		far_price = @far_price,
		deal_id = @deal_id,
		trade_date = @trade_date  */
		

	exec
		api_tallyclientroll
			@login = @roll_trader_login,
			@account = @account,
			@trader = @roll_trader,
			@near_quantity = @near_quantity,
			@far_quantity = @far_quantity,
			@dealt_currency = @dealt_currency,
			@counter_currency = @counter_currency,
			@near_date = @near_date,
			@near_price = @near_price,
			@far_date = @far_date,
			@far_price = @far_price,
			@deal_id = @deal_id output,
			@trade_date = @trade_date 


	select
		@queued_rolls = count(*)
	from
		queued_rolls
	where
		batch_id = @batch_id
	and
		queued_roll_id > @queued_roll_id

end

delete

from
	queued_rolls
where
	batch_id = @batch_id

exec
	cbo_clientrollrecon
		@login,
		@near_date


go
