create procedure
        r_clientstatement
                @login char(100)
as

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)

insert into
        #links
values(
        "Column Link",
        "monthly_statement",
        "Client Monthly Statement",
        NULL,
        NULL)

insert into
        #links
values(
        "Column Link",
        "daily_statement",
        "Daily Trading Statement",
        NULL,
        NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
        run_name = a.name,
        daily_statement = "Daily Statement"
from
        runs a,
        user_runs b,
        tico_accounts c,
        external_accounts d
where
        a.run_id = b.run_id
and
        b.tico_account_id = c.account_id
and
        c.login = @login
and
        a.name = d.symbol
order by
        name

select
        account = a.symbol,
        monthly_statement = "Monthly Statement"
from
        external_accounts a,
        external_account_types b
where
        a.external_account_type_id = b.external_account_type_id
and
        b.name = "Client"
and
	a.archived_at = NULL
order by
        a.symbol

