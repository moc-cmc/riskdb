
drop procedure
	r_editdefaultcreditvalues
go

create procedure r_editdefaultcreditvalues
				@login varchar(25),
				@currency varchar(5),
				@nop_type varchar(25),
				@dsl_type varchar(25),
				@notice_level float,
				@warning_level float,
				@blocked_level float

as

declare @product_type_id int
declare @currency_id int
declare @nop_type_id int
declare @dsl_type_id int

select
	@product_type_id = product_type_id
from
	product_types
where
	name="Currency"

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find product type",
		product_type="Currency"
	return
end

select
	@currency_id = product_id
from
	products 
where
	symbol=@currency
and
	product_type_id=@product_type_id

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find currency",
		currency=@currency

	return
end

select 
	@nop_type_id = nop_type_id
from
	nop_types
where
	name=@nop_type

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find nop type",
		nop_type=@nop_type

	return
end

select
	@dsl_type_id = dsl_type_id
from
	dsl_types
where
	name=@dsl_type

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find dsl_type",
		dsl_type=@dsl_type
	return
end

begin tran

	update
		default_credit_profile_values
	set
		currency_id=@currency_id,
		nop_type_id=@nop_type_id,
		dsl_type_id=@dsl_type_id,
		notice_level=@notice_level,
		warning_level=@warning_level,
		blocked_level=@blocked_level

	if(@@rowcount != 1)
	begin
		select
			status="Error",
			msg="Could not update default credit values"
		
		rollback tran
		return
	end

commit tran

select
	status="Success",
	msg="Default Credit Values Updated"

exec
        r_managecreditprofile
                @login

return

go
	
