drop procedure	
	sp_dogstatsdmetric
go

create procedure
	sp_dogstatsdmetric
		@metric_name varchar(200),
		@type varchar(2),
		@value varchar(10)=NULL,
		@tags varchar(255)=NULL,
		@sample_rate varchar(10)=NULL,
		@start_time datetime=NULL,
		@end_time datetime=NULL

as

/* chriso: 2018-07-07 - https://docs.datadoghq.com/developers/dogstatsd/datagram_shell/#metrics 
   This proc utilizes the statsd implementation by datadog and sybase
   syb_sendmsg to send a string to UPD port 8125. The datadog statsd agent 
   should be listening and it will report the metrics to datadog. 
   The format of the string is:
      "metric.name:value|type|@sample_rate|#tag1:value,tag2" 
   where
      metric.name = a string with no colons, bars, or @ characters. See the metric naming policy.
      value = an integer or float.
      type = c for counter, g for gauge, ms for timer, h for histogram, s for set.
      sample rate (optional) = a float between 0 and 1, inclusive. Only works with counter, histogram, and timer metrics. Default is 1 (i.e. sample 100% of the time).
      tags (optional) = a comma separated list of tags. Use colons for key/value tags, i.e. env:prod
*/

/* NOTE */
/* 
   There are very few validation checks on the spec to send to statsd, get it right during testing 
   for timers, if you supply type = "ms" and @value = NULL then it will try an calc it from @start_time and @end_time
*/


declare @result int
declare @msg varchar(255)

if @type = "ms" and @value = NULL
begin
	select
		@value = convert(varchar(10), datediff(ms, @start_time, @end_time))
end
select
	@msg = rtrim(@metric_name) +":"+ rtrim(@value) +"|"+ rtrim(@type)
/*
select
	@result = syb_sendmsg("localhost", 8125,
            rtrim(@metric_name) +":"+ rtrim(@value) +"|"+
            rtrim(@type) +"|"+ rtrim(@sample_rate) +"|"+ 
            rtrim(@tags)
            )
*/
select
        @result = syb_sendmsg("localhost", 8125, @msg)


go
