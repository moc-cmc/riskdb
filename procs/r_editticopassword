
drop procedure
	r_editticopassword
go

create procedure r_editticopassword @login varchar(25), 
				    @login_name varchar(25),
				    @password varchar(20)
as

declare @account_id int
declare @passchange char(1)
declare @passlen int
declare @message varchar(250)
declare @isValid char(1)

exec r_checknewpassword @login, @password, @message output, @isValid output

if(@isValid = "N")
begin
        select
                status="Error",
                msg=@message,
                password=@password

        return

end
select 
	@account_id=account_id
from
	accounts
where
	login=@login_name

if @@rowcount < 1
begin
	select
		status="Error",
		msg="Login name does not exist",
		login_name=@login_name

	return
end

select @passchange = "Y"

select
	@passchange="N"
from
	accounts
where
	account_id=@account_id	
and
	password=@password	

if(@passchange = "N")
begin
	select  
		status="Error",
		msg="Password same as previous",
		password=@password
	
	return
end

begin tran

	update
		accounts
	set
		password=@password
	where
		account_id=@account_id

	if @@rowcount != 1
	begin
		select
			status="Error",
			msg="Password not changed",
			login_name=@login_name

		rollback tran
		return
	end

commit tran

select 
	status="Success",
	msg="Password Reset",
	login_name=@login_name

go

