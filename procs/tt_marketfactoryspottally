
if object_id("tt_marketfactoryspottally") != null
    drop procedure
        tt_marketfactoryspottally
go

/*
{ ix:"7678034190", ixs:{ex:"7678034190"},
  so:{nm:"MarketFactory"}, 
  dl:{ix:"2172as346", ixs:{cl:"2172as346", ex:"1270739673"}}, 
  dt:"2014-07-31T13:41:00.792Z", dy:"2014-07-31T04:00:00.000Z", 
  tp:{nm:"Spot"}, 
  ea:{sy:null}, 
  tu:{sy:null}, 
  cp:{sy:"BBLK"}, 
  px:102.932, 
  qt:-2000000, 
  ct:{sy:"USDJPY"}, 
  vd:"2014-08-04T04:00:00.000Z", 
  br:{sy:"MFDropCopyEdgewater"}, 
  rl:"maker", 
  ur:{sy:"RockyUser"}, 
  sppx:102.932, 
  _id:53da476db8498b4cb0b5e1ba
}
*/

create procedure
    tt_marketfactoryspottally
        @agent varchar(50),
        @source varchar(50),
        @platform varchar(50),
        @trade_identifier varchar(50),
        @trade_exchange_identifier varchar(50),
        @deal_identifier varchar(50),
        @deal_exchange_identifier varchar(50),
        @trade_type varchar(15),
        @external_account varchar(50),
        @trader varchar(50),
        @counterparty varchar(50),
        @symbol varchar(50),
        @price float
        @quantity float
        @value_date datetime,
        @broker varchar(50),
        @role varchar(15),
        @user varchar(50),
        @spot_reference float
as

declare @source_id int

declare @tally_type varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @symbol varchar(100)
declare @value_date datetime
declare @spot_reference float
declare @deal_identifier varchar(50)
declare @deal_id int

declare @cl_trade_identifier varchar(50)
declare @cl_login varchar(50)
declare @cl_external_account varchar(50)
declare @cl_internal_account varchar(50)
declare @cl_trader varchar(50)
declare @cl_counterparty varchar(50)
declare @cl_broker varchar(50)
declare @cl_quantity numeric(30,4)
declare @cl_price float
declare @cl_spot_reference float

/*
 * MARK: FIND @source_id
 */

select
    @source_id = source_id
from
    sources
where
    name = @source

if @source_id = null
begin
    select
        status = "Error",
        error = "Source not found",
        source = @source
    return
end

if @external_account != null
begin
    select
        @external_account = a.symbol
    from
        external_accounts a,
        external_account_symbols b
    where
        a.external_account_id = b.external_account_id
    and
        b.source_id = @source_id
end
if @external_account != null
begin
    select
        @external_account = a.symbol
    from
        external_accounts a
    where
        a.symbol = @external_account
end

exec
    fxa_tallytrade
        @login = @cl_trader,
        @source = @source,
        @trade_id = @cl_trade_id out,
        @deal_id = @deal_id out,
        @tally_type = @cl_tally_type,
        @deal_type = @cl_deal_type,
        @trade_type = @cl_trade_type,
        @external_account = @cl_external_account,
        @counterparty = @cl_counterparty,
        @quantity = @cl_quantity,
        @symbol = @symbol,
        @value_date = @value_date,
        @price = @cl_price,
        @trade_date = @trade_date,
        @trader = @cl_trader,
        @broker = @broker,
        @identifier = @cl_trade_identifier,
        @spot_reference = @cl_spot_reference


/******************************************************


@target_sub_id determines counterparty

if @granularity = "Account Level"
        @sender_sub_id determines trader
if @granularity = "Trader Level"
    @sender_sub_id+@client_id determines trader

-------------------------------------------
    CLIENT -- if @covered_exec_id = NULL (FIX tag 7601)
-------------------------------------------

@sender_sub_id --> trader -->  external account
@execution_id = trades.identifier + ".c"
@execution_id = deal_exec_symbol    


--------------------------------------------
    COUNTERPARTY -- if @cover_exec_id = NULL (FIX tag 7602)
--------------------------------------------

@sender_sub_id+@target_sub_id --> counterparty --> external account
@execution_id = trades.identifier + ".m"
@covered_exec_id = deal_exec_symbol
if clientvclient (@target_sub_id = fund_agency_counterpart):
   @sender_sub_id --> counterparty --> external_account
if street trade only  
   @deal_exec_symbol = @order_id (for desk order grouping)


******************************************************/



declare @committed_status_id int
declare @external_account_id int
declare @external_account_type varchar(25)
declare @aggregation_style_id int
declare @aggregation_style varchar(25)

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @counterparty varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_login varchar(50)
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int
declare @clvcl_counterparty varchar(50)

declare @lookup_cpty varchar(50)
declare @lookup_trader varchar(50)
declare @broker_id int
declare @market_trade char(1)

declare @source_id int
declare @prev_mkt_deal_id int
declare @create_deal_alias char(1)
declare @check_to_update_mkt_deals char(1)
declare @update_target_sub_id varchar(10)

declare @trigger_symbol varchar(50)
declare @cl_create char(1)
declare @lp_create char(1)

declare @suppressed_trade_id int
declare @suppressed_deal_id int
declare @suppress_trade varchar(1)


declare @auto_b2b_deal_status_id int
declare @auto_b2b_deal_type_id int
declare @auto_b2b_deal_id int


select
        @source_id = source_id
from
        sources
where
        name = @source
if @@rowcount != 1
begin
        select
                status = "Error",
                message = "Source not found",
                source = @source
        return
end


select
    @update_target_sub_id = "Y"
from
    integral_anon_symbols
where
    source_id = @source_id
and
    symbol = @on_behalf_of_comp_id

if @update_target_sub_id = "Y"
begin
    select
        @target_sub_id = @on_behalf_of_comp_id
end


/*
if @on_behalf_of_comp_id = "UNTL"
begin
        select
                @target_sub_id = "UNTL"
end

if @on_behalf_of_comp_id = "BTTP"
begin
        select
                @target_sub_id = "BTTP"
end
*/


if @broker = NULL
    select
        @broker = "Integral"

select
    @quoted_price = @price


select
    @lookup_cpty = @target_sub_id

/*
 * VERIFY @cover_exec_id and @covered_exec_id are as expected
 */ 
if @cover_exec_id = NULL and @covered_exec_id = NULL
begin
    select 
        "Street Trade" = "STREET TRADE",
        "granularity" = "Adjusted to 'Trader Level'"
    select
        @deal_type = "Market Forward",
        @covered_exec_id = @execution_id,
        @granularity = "Trader Level",
                @lookup_cpty = rtrim(@sender_sub_id)+"-"+@target_sub_id,
        @deal_exec_symbol = @order_id,
        @market_trade = "Y"
        
end
if @cover_exec_id != NULL and @covered_exec_id != NULL
begin
    select
        status = "Error",
        message = "@cover_exec_id != NULL and @covered_exec_id != NULL -- Can not determine client or street trade",
        cover_exec_id = @cover_exec_id,
        covered_exec_id = @covered_exec_id
    return
end


if @cover_exec_id = NULL /* STREET */
begin
    select
                @lookup_cpty = rtrim(@sender_sub_id)+"-"+@target_sub_id
end


select lookup_cpty = @lookup_cpty

/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end




if @granularity = "Account Level"
begin
    select
        @lookup_trader = @sender_sub_id
end
else if @granularity = "Trader Level"
begin
    select
        @lookup_trader = @sender_sub_id+"-"+@client_id
end
else
begin
    select 
        warning = "Warn",
        message = "Granularity level not 'Account Level' or 'Trader Level' - Defaulting to 'Account Level'",
        granularity = @granularity

    select
        @lookup_trader = @sender_sub_id
end

/*
 * LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 */ 

select
    @trader_id = a.trader_id,
    @trader = a.symbol,
    @trader_login = c.login,
    @external_account_id = a.external_account_id
from
        traders a,
        trader_symbols b,
        sources ba,
        tico_accounts c
where    
        a.trader_id = b.trader_id
and
        b.source_id = ba.source_id
and
        a.tico_account_id = c.account_id
and
        ba.name = @source
and 
        b.symbol = @lookup_trader

if @trader_id = NULL or @trader_login = NULL
begin
    select
            @trader_id = a.trader_id,
            @trader = a.symbol,
            @trader_login = c.login,
            @external_account_id = a.external_account_id
    from
            traders a,
            tico_accounts c
    where    
            a.tico_account_id = c.account_id
    and 
            a.symbol = @lookup_trader

    if @trader_id = NULL or @trader_login = NULL
    begin
    select
            status = "Error",
            message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            lookup_trader = @lookup_trader
        return
    end        
end


/*      
* CHECK to see if this requires suppresssion
*/

select
        @suppress_trade = "Y"
from
        suppression_symbols
where
        source_id = @source_id
and
        symbol = @lookup_trader

/*
* CHECK to see if this requires a manufactured B2B
*/
select 
    @cl_create = cl_create,
    @lp_create = lp_create
from 
    ticket_creation_values 
where 
    trigger_symbol = @lookup_trader
and
     source_id = @source_id
if @@rowcount != 0
begin
           select
                   @trigger_symbol = @lookup_trader
end


/*
 * LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 */

select
    @counterparty_id = a.counterparty_id,
    @counterparty = a.name,
    @cpty_ext_acct_id = a.external_account_id
from
        counterparties a,
        counterparty_symbols b,
        sources ba
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = ba.source_id
and
        ba.name = @source
and
        b.symbol = @lookup_cpty
if @counterparty = NULL
begin
        select
                @counterparty_id = a.counterparty_id,
        @counterparty = a.name,
        @cpty_ext_acct_id = a.external_account_id
        from
                counterparties a
        where
                a.name = @lookup_cpty
        
        if @counterparty = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
            lookup_cpty = @lookup_cpty
                return
        end
end

select
    @deal_id = deal_id
from
    deal_aliases
where
    source_id = @source_id
and
    alias = @order_id

/* 
 * DETERMINE if this is a counterparty trade or a client trade
 */
if @covered_exec_id = NULL  /* CLIENT */
begin
    select
        @trade_identifier = @execution_id + ".c",
                @deal_type = "B2B Forward",
        /*@deal_type = "Client Forward",*/
        @qty1 = -@qty1 /* Flip qty because ticket is from perpective of client. So client BUY is really agency/fund SELL */

    if @deal_exec_symbol = NULL
    begin
        select
            @deal_exec_symbol = @execution_id
    end

    /* Create a deal_alias using the order_id for client messages */
    if @deal_id = NULL
    begin
        select
            @create_deal_alias = "Y"
    end
    else
    begin
        select
            @check_to_update_mkt_deals = "Y"
    end  

end
if @cover_exec_id = NULL  /* COUNTERPARTY */
begin
        select
                @trade_identifier = @execution_id + ".m",
                @deal_exec_symbol = @covered_exec_id,
                @deal_type = "B2B Forward"
        /*@deal_type = "Market Forward"*/

    if @market_trade = "Y"
    begin
        select 
            @deal_type = "Market Forward",
            @deal_exec_symbol = @order_id
    end

        if @deal_exec_symbol = NULL
        begin
                select
                        @deal_exec_symbol = @execution_id
        end


        
        /*
         * CHECK if this is a market trade where the counterparty = the agency. If it is, set the cpty = sender sub and requery
         *       as this is a client vs client trade 
         */
        if exists(select counterparty_id from fund_agency_counterparties where counterparty_id = @counterparty_id)
        begin
        select
            msg="Identified client v client. Updating cpty to sender_sub_id",
            sender_sub_id = @sender_sub_id

        select
            @lookup_cpty = @sender_sub_id,
            @qty1 = -@qty1
    
        select
                @counterparty_id = a.counterparty_id,
                @clvcl_counterparty = a.name,
                @cpty_ext_acct_id = a.external_account_id
        from
                counterparties a,
                counterparty_symbols b,
                sources ba
        where
                a.counterparty_id = b.counterparty_id
        and
                b.source_id = ba.source_id
        and
                ba.name = @source
        and
                b.symbol = @lookup_cpty
        if @clvcl_counterparty = NULL
        begin
                select
                        @counterparty_id = a.counterparty_id,
                        @clvcl_counterparty = a.name,
                        @cpty_ext_acct_id = a.external_account_id
                from
                        counterparties a
                where
                        a.name = @lookup_cpty
        
                if @clvcl_counterparty = NULL
                begin
                        select
                                status = "Error",
                                message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
                                lookup_cpty = @lookup_cpty
                        return
                end
        end
        select 
            @counterparty = @clvcl_counterparty
    end

    
    /*
      * OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
      */ 
    select
        @external_account_id = @cpty_ext_acct_id
end


/*
 * VERIFY @broker exist and check for dupe
 */
select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @@rowcount != 1
begin
        select
                "error"="Error",
                "msg"="Broker not found",
                "broker"=@broker
        return
end

if exists(select trade_id from trades where identifier = @trade_identifier and broker_id = @broker_id)
begin
        select
                status="Dupe",
                msg="Trade already tallied",
                identifier=@trade_identifier,
                broker= @broker
        return
end


/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
    select
        status = "Error",
        message = "Couldn't find external_account from @external_account_id",
        external_account_id = @external_account_id
    return
end


select
    @trade_type = "Spot"
    
if @last_fwd_points != 0 and @last_fwd_points != NULL
begin
    select
        @trade_type = "Forward"
end

/* 
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @ccy1 != NULL and @ccy2 != NULL and @symbol = @ccy2 + @ccy1
begin
    select
        @symbol = @ccy1 + @ccy2,
    @inverted = "Y"
end


if @side = "SELL"
begin
    select
        @qty1 = -@qty1
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
    select
        message = "Contract not found",
        contract = @symbol,
        action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
    
    
    declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
            r_defaultfundforlogin
                    @default_login,
                    @fund_id output

        select
            @evaluation_currency = a.symbol
        from
            products a,
            funds b
        where
            a.product_id = b.evaluation_currency_id 
    and
        b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1,
                    @ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
    declare @waitfor_delay char(11)
    select
        @waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

    select 
        action = "Sleeping @waitfor_delay and checking for contract again",
        waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
    select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
     select
            c.*
        from
            contracts a,
            contract_price_styles b,
            price_styles c
        where
            a.contract_id = b.contract_id
        and
            b.price_style_id = c.price_style_id
        and
            a.symbol = @symbol
        and
            c.name = "Inverted"
    )
begin
            
        insert into
               contract_price_styles (
                   contract_id,
                   price_style_id,
                   factor
               )
        select
               a.contract_id,
               b.price_style_id,
               1.0
        from
               contracts a,
               price_styles b
       where
               a.symbol = @symbol
    and
               b.name = "Inverted"
       
end


if @deal_id = NULL
begin
    select
        @deal_id = deal_id
    from
        deal_exec_symbols
    where
        symbol = @deal_exec_symbol
end

if @deal_id = NULL
begin
    select
        msg = "Creating new deal"
    
    select
        @deal_status_id = status_id
    from
        statuses
    where
        name = "User Review"
    if @deal_status_id = NULL
    begin
        select
            status = "Error",
            message = "No status found named, 'User Review'"
        return
    end
    select
        @deal_type_id = deal_type_id
    from
        deal_types
    where
        name = @deal_type
    if @deal_type_id = NULL
    begin
        select
            status = "Error",
            message = "No deal type found for @deal_type",
            deal_type = @deal_type
        return    
    end

    exec
        j_nextkey
            "deals",
            @deal_id output

    insert into
        deals(
            deal_id,   
            deal_type_id,
            timestamp,  
            status_id  
             )      
        values( 
            @deal_id,
            @deal_type_id,
            getdate(),
            @deal_status_id
            )
    
    insert into
        deal_exec_symbols
    values(
        @deal_id,
        @deal_exec_symbol
    )

end
else
begin
    select
        msg = "Appending to existing deal"

    /*  Below to support management of deal_type. 
        This tally is currently purposed for B2B deals. This will be inserted B2B */    
    /*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = 'B2B Forward'
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for 'B2B Forward'"
                return
        end

    update
        deals
    set
        deal_type_id = @deal_type_id
    where
        deal_id = @deal_id
    */
end

if @cl_create = "Y" and @lp_create = "Y"
begin
        select
                msg = "Creating new deal to separate auto-generated tickets"


        select
                @auto_b2b_deal_status_id = status_id
        from
                statuses
        where
                name = "User Review"
        if @auto_b2b_deal_status_id = NULL
        begin
                select
                        status = "Error",
                        message = "No status found named, 'User Review'"
                return
        end
        select
                @auto_b2b_deal_type_id = deal_type_id
        from
                deal_types
        where
                name = @deal_type
        if @auto_b2b_deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for @deal_type",
                        deal_type = @deal_type
                return
        end

        exec
                j_nextkey
                        "deals",
                        @auto_b2b_deal_id output

        insert into
                deals(
                        deal_id,
                        deal_type_id,
                        timestamp,
                        status_id
                        )
                values(
                        @auto_b2b_deal_id,
                        @auto_b2b_deal_type_id,
                        getdate(),
                        @auto_b2b_deal_status_id
                        )

        insert into
                deal_exec_symbols
        values(
                @auto_b2b_deal_id,
                rtrim(@deal_exec_symbol)+".autob2b"
        )
end

        
if  @create_deal_alias = "Y"
begin
    select
        msg="Creating deal alias",
        deal_id = @deal_id,
        alias = @order_id

    insert into
        deal_aliases(
            deal_id,
            source_id,
            alias
    )
    values(
        @deal_id,
        @source_id,
        @order_id
    )
end

if  @check_to_update_mkt_deals = "Y"
begin
    select
        @prev_mkt_deal_id = deal_id
    from
        deal_exec_symbols
    where
        symbol = @deal_exec_symbol
    select
        msg = "Checking to update market deals",
        prev_mkt_deal_id = @prev_mkt_deal_id,
        deal_exec_symbol = @deal_exec_symbol,
        deal_id = @deal_id,
        order_id = @order_id
    if @prev_mkt_deal_id != NULL and @prev_mkt_deal_id != @deal_id
    begin
        update
            trades
        set
            deal_id = @deal_id
        where
            deal_id = @prev_mkt_deal_id
        if @@rowcount > 0
        begin
            select
                msg = "Updated previous market deals to client deal",
                from_deal = @prev_mkt_deal_id,
                to_deal = @deal_id
        end
    end
end

if @suppress_trade = "Y"
begin
        exec
                fxa_suppresstrade
                        @login = @trader_login,
                        @source = @source,
                        @suppressed_trade_id = @suppressed_trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @trade_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @external_account,
                        @counterparty = @counterparty,
                        @quantity = @qty1,
                        @symbol = @symbol,
                        @value_date = @value_date,
                        @price = @price,
                        @trade_date = @trade_date,
                        @trader = @trader,
                        @broker = @broker,
                        @identifier = @trade_identifier,
                        @spot_reference = @last_spot_rate

            if @suppressed_trade_id = NULL
            begin
                    select
                            status = "Error",
                            message = "Failed to suppress trade"
            end
end          
else
begin
