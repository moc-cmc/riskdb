use
	risk_sjmdemo
go

drop procedure
	api_clientwithdrawalreq
go

create procedure
	api_clientwithdrawalreq
		@login varchar(50),
		@product varchar(50),
		@amount float,
		@for_date datetime,
		@from_account varchar(50), /* BO Master account */
		@to_account varchar(50), /* Outside account */
		@ledger_request_id int output
as

declare @tico_account_id int
declare @product_id int
declare @origination_type_id int
declare @outside_account_id int
declare @bo_master_account_id int
declare @ledger_request_type_id int
declare @unassigned_custody_id int
declare @origination_type varchar(50)

declare @ledger_request_log_id int
declare @status_id int
declare @settled_balance float
declare @pending_balance float
declare @balance float
declare @fee_total float
declare @fee_count int
declare @id int
declare @ids int
declare @account_transaction_id int 
declare @unique_products int

declare @xact_id int
declare @xacts int
declare @running_balance float

declare @offset_acct_transaction_id int

if @amount < 0.0
begin
	select
		status = "Error",
		message = "Cannot withdraw negative amount"
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@unassigned_custody_id = a.external_account_id
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	a.symbol = "UNASSIGNED CUSTODY"
and
	b.name = "Custody"
if @unassigned_custody_id = NULL
begin
	select
		status = "Error",
		message = "UNASSIGNED CUSTODY account not found"
	return
end

select
	@product_id = product_id,
	@origination_type_id = origination_type_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@origination_type = name
from
	origination_types
where
	origination_type_id = @origination_type_id


select
	@outside_account_id = outside_account_id
from
	outside_accounts
where
	name = @to_account
if @outside_account_id = NULL
begin
	select
		status = "Error",
		message = "Outside account not found",
		outside_account = @to_account
	return
end

select
	@bo_master_account_id = a.bo_master_account_id
from
	bo_master_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @from_account
if @bo_master_account_id = NULL
begin
	select
		status = "Error",
		message = "BO Master account not found",
		bo_master_account = @from_account
	return
end

select
	@ledger_request_type_id = ledger_request_type_id
from
	ledger_request_types
where
	name = "Withdrawal"
if @ledger_request_type_id = NULL
begin
	select
		status = "Error",
		message = "Withdrawal ledger request type not found"
	return
end


select
	@settled_balance = sum(amount)
from
	account_transactions a,
	bo_master_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.bo_master_account_id = @bo_master_account_id
and
	a.currency_id = @product_id
if @settled_balance = NULL
	select
		@settled_balance = 0.0

select
	@pending_balance = sum(amount)
from
	pending_transactions a,
	bo_master_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.bo_master_account_id = @bo_master_account_id
and
	a.currency_id = @product_id
and
	a.transaction_date <= @for_date
if @pending_balance = NULL
	select
		@pending_balance = 0.0


select
	@balance = @settled_balance + @pending_balance


create table
	#ledger_request_type_fees(
		id int identity,
		account_transaction_id int NULL,
		offset_acct_transaction_id int NULL,
		transaction_type_id int,
		fee_price_type varchar(5),
		fee_price float,
		fee_product_id int NULL,
		fee_amount float NULL,
		ledger_request_fee_id int NULL)
insert into
	#ledger_request_type_fees(
		transaction_type_id,
		fee_price_type,
		fee_price,
		fee_product_id)
select
	transaction_type_id,
	fee_price_type,
	fee_price,
	fee_product_id
from
	ledger_request_type_fees
where
	ledger_request_type_id = @ledger_request_type_id
and
	origination_type_id = @origination_type_id
and
	(product_id = @product_id
or
	product_id = NULL)

update
	#ledger_request_type_fees
set
	fee_product_id = @product_id
where
	fee_product_id = NULL

update
	#ledger_request_type_fees
set
	fee_amount = fee_price * -1.0
where
	fee_price_type = "N"

update
	#ledger_request_type_fees
set
	fee_amount = @amount * fee_price * -1.0
where
	fee_price_type = "R"

select
	@fee_count = count(*)
from
	#ledger_request_type_fees
	
select
	@id = 0
select
	@ids = count(*)
from
	#ledger_request_type_fees
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#ledger_request_type_fees
	where
		id > @id

	select
		@account_transaction_id = NULL,
		@offset_acct_transaction_id = NULL

	exec
		j_nextkey
			"account_transactions",
			@account_transaction_id output
        exec
                j_nextkey
                        "account_transactions",
                        @offset_acct_transaction_id output


	update
		#ledger_request_type_fees
	set
		account_transaction_id = @account_transaction_id,
		offset_acct_transaction_id = @offset_acct_transaction_id
	where
		id = @id

	select
		@ids = count(*)
	from
		#ledger_request_type_fees
	where
		id > @id
end

select
	@unique_products = count(distinct(fee_product_id))
from
	#ledger_request_type_fees

if @unique_products > 1
begin
	select
		status = "Error",
		message = "Non base currency fee encountered. This feature not currently supported"
	return
end

select
	@fee_total = sum(fee_amount)
from
	#ledger_request_type_fees
where
	fee_product_id = @product_id
if @fee_total = NULL
	select
		@fee_total = 0.0

/* select
	amount = @amount,
	balance = @balance,
	fee_total = @fee_total  Debug */

if @origination_type = "Fiat"
	select
		@balance = convert(numeric(30,2), @balance),
		@amount = convert(numeric(30,2), @amount),
		@fee_total = convert(numeric(30,2), @fee_total)
if @origination_type = "Digital"
	select
		@balance = convert(numeric(30,8), @balance),
		@amount = convert(numeric(30,8), @amount),
		@fee_total = convert(numeric(30,8), @fee_total)



if @amount > (@balance + @fee_total)
begin
	select
		status = "Error",
		message = "Requested withdrawal amount exceeds available account balance",		product = @product,
		account = @from_account,
		requested_amount = @amount,
		balance = @balance
	return
end


select
	@status_id = status_id
from
	statuses
where
	name = "New"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "New status not found"
	return
end

exec
	j_nextkey
		"ledger_requests",
		@ledger_request_id output
exec
	j_nextkey
		"ledger_request_logs",
		@ledger_request_log_id output

begin tran

	insert into
		ledger_requests(
			ledger_request_id,
			requestor_id,
			outside_account_id,
			bo_master_account_id,
			custodial_account_id,
			ledger_request_type_id,
			product_id,
			amount,
			transaction_date,
			request_date,
			status_id)
	values(
		@ledger_request_id,
		@tico_account_id,
		@outside_account_id,
		@bo_master_account_id,
		@unassigned_custody_id,
		@ledger_request_type_id,
		@product_id,
		@amount,
		@for_date,
		getdate(),
		@status_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add ledger request",
			product = @product,
			amount = @amount,
			for_date = @for_date,
			from_account = @from_account,
			to_account = @to_account
		rollback tran
		return
	end

	insert into
		ledger_request_logs(
			ledger_request_log_id,
			ledger_request_id,
			user_id,
			timestamp,
			status_id)
	values(
		@ledger_request_log_id,
		@ledger_request_id,
		@tico_account_id,
		getdate(),
		@status_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add ledger request log. Request not tallied",
			product = @product,
			amount = @amount,
			for_date = @for_date,
			from_account = @from_account,
			to_account = @to_account
		rollback tran
		return
	end

	insert into
		ledger_request_fees(
			ledger_request_id,
			account_transaction_id,
			transaction_type_id,
			product_id,
			amount,
			offset_acct_transaction_id)
	select
		ledger_request_id = @ledger_request_id,
		account_transaction_id = account_transaction_id,
		transaction_type_id,
		fee_product_id,
		fee_amount,
		offset_acct_transaction_id = offset_acct_transaction_id
	from
		#ledger_request_type_fees
	if @@rowcount != @fee_count
	begin
		select
			status = "Error",
			message = "Unable to set fees for request. Request not booked",
			product = @product,
			amount = @amount,
			for_date = @for_date,
			from_account = @from_account,
			to_account = @to_account
		rollback tran
		return
	end
commit tran

exec
	r_processledgerrequest
		@login = @login,
		@ledger_request_id = @ledger_request_id


go
