create or replace procedure
	cl_dealblotter
		@login varchar(30),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@trade_id int=NULL
as



declare @tico_account_id int
declare @run_name varchar(50)
declare @blotter_view_style varchar(50)
declare @view_style varchar(100)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to determine user name"
	return
end

select
	@run_name = a.name,
	@view_style = c.name
from
	runs a,
	client_login_configs b,
	blotter_view_styles c
where
	a.run_id = b.run_id
and
	b.blotter_view_style_id = c.blotter_view_style_id
and
	b.tico_account_id = @tico_account_id


if @run_name = NULL
begin
	select
		status = "Error",
		message = "No run configured for user name"
	return
end

if @view_style = "Numerator View"
begin
	exec
		cl_biproductblotter
			@login,
			@run_name, 
			@begin_date,
			@end_date,
			@trade_id
	return
end

if @view_style = "Curr/Counter View"
begin
	exec
		cl_productblotter
			@login,
			@run_name,
			@begin_date,
			@end_date,
			@trade_id
	return
end

if @view_style = "FXAll View"
begin
        if @trade_id = NULL
 	begin
         	exec
 			cl_fxallblotterlinks
 	end


	exec
		cl_fxallblotter
			@login,
			@run_name,
			@begin_date,
			@end_date,
			@trade_id
end

if @view_style = "FXAll View2"
begin

	exec
		cl_fxallblotter2
			@login,
			@run_name,
			@begin_date,
			@end_date,
			@trade_id

end

if @view_style = "FXAll View2 Custom"
begin

        exec
                cl_fxallblotterall
                        @login,
                        @run_name,
                        @begin_date,
                        @end_date
end

if @view_style = "FXAll View2"
begin

        exec
                cl_fxallblotter2
                        @login,
                        @run_name,
                        @begin_date,
                        @end_date,
                        @trade_id

end


if @view_style = "Notification Alias View"
begin
	if @trade_id = NULL
	begin
		create table
        		#links(
                	meta_type char(200),
                	column char(30),
                	link char(200) NULL,
                	arguments char(255) NULL,
                	format char(20) NULL)

		insert into
        		#links
		values(
        		"Format Number",
        		"spot_rate",
        		NULL,
        		NULL,
        		"#,##0.00####")
		insert into
        		#links
		values(
        		"Format Number",
        		"all_in_rate",
        		NULL,
        		NULL,
        		"#,##0.00####")

	
	
        	select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links
	end

	exec
                cl_traderaliasblotter
                        @login,
                        @run_name,
                        @begin_date,
                        @end_date,
                        @trade_id

end

if @view_style = "Vertical View"
begin

	if @trade_id = NULL
	begin
		select 
			"error"="Error",
			"msg"="Client configured for Vertical View. TradeID is required for Vertical View. Trade ID not provided",
			trade_id=@trade_id
		return
	end
	exec 
		tt_verticalintegralview
			@login=@login,
			@run_name=@run_name,
			@trade_id=@trade_id

end


if @view_style = "Vertical Mark Up View"
begin

	if @trade_id = NULL
	begin
		select 
			"error"="Error",
			"msg"="Client configured for Vertical Mark Up View. TradeID is required for Vertical View. Trade ID not provided",
			trade_id=@trade_id
		return
	end
	exec 
		tt_verticalmarkupview
			@login=@login,
			@trade_id=@trade_id

end


go
