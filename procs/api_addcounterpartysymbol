
drop procedure
	api_addcounterpartysymbol
go

create procedure
	api_addcounterpartysymbol
			@login varchar(25),
			@name varchar(100),
			@symbol varchar(100),
			@source varchar(100)
as

declare @counterparty_id int
declare @source_id int
declare @source_type_id int
declare @source_type varchar(50)

select
	@counterparty_id=counterparty_id
from
	counterparties
where
	name=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Counterparty Name does not exist",
		counterparty_name=@name

	return
end

select
	@source_id = source_id,
	@source_type_id=source_type_id
from
	sources
where
	name=@source

if (@@rowcount!=1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source
	
	return
end

select
        @source_type=name
from
        source_types
where
        source_type_id=@source_type_id

if (@source_type="Outbound")
begin
        if exists (select 
                        counterparty_id
                   from
                       	counterparty_symbols
                   where
                        source_id=@source_id
                   and
                        counterparty_id=@counterparty_id)

        begin
                select
                        status="Error",
                        msg="Counterparty already has an Outbound Source",
                        name=@name

                return
        end
end

insert into
	counterparty_symbols (
		counterparty_id,
		source_id,
		symbol )
values (
	@counterparty_id,
	@source_id,
	@symbol )

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Problem adding Counterparty Symbol",
		counterparty_symbol=@symbol

	return
end

select
	status="OK",
	msg="Successfully added Counterparty Symbol",
	counterparty_symbol=@symbol

return

go

