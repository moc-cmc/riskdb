
if object_id("mc2_tallyclientswap") != NULL
    drop procedure
        mc2_tallyclientswap
go

create procedure
	mc2_tallyclientswap
		@login char(25),
		@client_user varchar(25),
		@client_buys_sells varchar(25),
		@quantity numeric(30,4),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@near_date datetime = NULL,
		@near_price float,	
		@far_date datetime = NULL,
		@far_price float,
		@near_mid float=NULL,
		@far_mid float=NULL,
		@near_note varchar(255)=NULL,
		@far_note varchar(255)=NULL
		
as

declare @deal_id int

exec api_tallyclientswap
		@login=@login,
		@client_user=@client_user,
		@client_buys_sells=@client_buys_sells,
		@quantity=@quantity,
		@dealt_currency=@dealt_currency,
		@counter_currency=@counter_currency,
		@near_date=@near_date,
		@near_price=@near_price,
		@far_date=@far_date,
		@far_price=@far_price,
		@deal_id=@deal_id output,
		@near_fixing_date=NULL,
		@far_fixing_date=NULL,
		@near_mid=@near_mid,
		@far_mid=@far_mid,
		@near_note=@near_note,
		@far_note=@far_note



exec
	mc_inspectdealtrades
		@login,
		@deal_id


go
