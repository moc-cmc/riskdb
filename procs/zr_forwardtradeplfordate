
if object_id("zr_forwardtradeplfordate") != NULL
    drop procedure
        zr_forwardtradeplfordate
go
create procedure
	zr_forwardtradeplfordate
		@trade_id int,
		@contract_id int,
		@quantity numeric(30,2),
		@end_date datetime,
		@trade_price float,
		@current_price float output,
		@p_l float output

		
as

declare @multiplier float
/* Adding support for forwards */
declare @days float
declare @spot_price float
declare @give_product_rate float
declare @get_product_rate float
declare @value_date datetime 
/* end forward variable additions */

/* exec
	r_priceasof
		@contract_id,
		@end_date,
		@current_price output  */

select
	@value_date = value_date
from
	trades
where
	trade_id = @trade_id

exec
	r_forwardpriceasof
		@contract_id,
		@end_date,
		@value_date,
		@days output,
		@spot_price output,
		@current_price output, /* The forward price */
		@give_product_rate output,
		@get_product_rate output
		


select
	@multiplier = quantity
from
	forwards b
where
	contract_id = @contract_id

if @trade_id = 504056
	select
		spot_price = @spot_price,
		current_price = @current_price,
		give_product_rate = @give_product_rate,
		get_product_rate = @get_product_rate,
		quantity = @quantity,
		multiplier = @multiplier,
		trade_price = @trade_price


select
	@p_l = (@current_price * @quantity * @multiplier) - (@trade_price * @quantity * @multiplier)

return

go
