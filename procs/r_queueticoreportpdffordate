create or replace procedure
    r_queueticoreportpdffordate
        @login varchar(50),
        @tico_report varchar(50),
        @trade_date datetime=NULL
        

as


declare @tico_account_id int
declare @tico_report_id int
declare @run_id int
declare @tico_report_request_id int
declare @new_status_id int
declare @id float
declare @ids float

select
   	@tico_account_id = account_id
from
   	tico_accounts
where
   	login = @login
if @tico_account_id = NULL
begin
   	select
           	status="Error",
           	message="Problem finding account for login"
   	return
end

select
	@new_status_id = status_id
from
	statuses
where
	name = "New"
if @@rowcount !=1
begin
	select
		status = "Error",
		message = "Could not find status New"
	return
end

if @trade_date = NULL
begin
        select
                @trade_date = getdate()
        select
                @trade_date = convert(date, @trade_date)
end


/*
select
    	@run_id = a.run_id
from
    	runs a,
    	user_runs b,
    	tico_accounts c
where
    	a.run_id = b.run_id
and
    	b.tico_account_id = c.account_id
and
    	a.name = @run_name
if @run_id = NULL
begin
    	select
        	status = "Error",
        	message = "Run not found",
        	run_name = @run_name
    	return
end
*/

create table
    	#reports(
        	id int identity,
        	tico_report_id int,
        	run_id int)

insert into
	#reports(
    		tico_report_id,
        	run_id )
select
    	tico_report_id,
    	run_id
from
    	tico_reports
where
    	name = @tico_report
if @@rowcount = 0
begin
    	select
        	status = "Error",
        	message = "Problem finding tico reports",
        	tico_report = @tico_report
    	return    
end


select
    	@id = 0
select
    	@ids = count(*)
from
    	#reports
where
    	id > @id

while @ids > 0
begin
	select
        	@id = min(id)
    	from
        	#reports
    	where
        	id > @id

	select
		@tico_report_request_id = NULL,
		@tico_report_id = NULL,
		@run_id = NULL

	select
 		@tico_report_id = tico_report_id,
        	@run_id = run_id
    	from
        	#reports
    	where
        	id = @id

	exec
		j_nextkey
			"tico_report_requests",
			@tico_report_request_id output


	insert into
		tico_report_requests(
			tico_report_request_id,
			tico_report_id,
			as_of_date,
			request_date,
			status_id)
	select
		@tico_report_request_id,
		@tico_report_id,
		@trade_date,
		getdate(),
		@new_status_id
		
	select
        	@ids = count(*)
    	from
        	#reports
    	where
        	id > @id

        /* @waitfor_delay = "HH:MM:SS.00"*/
    	declare @waitfor_delay char(11)
    	select
        	@waitfor_delay = "00:00:30.00"
        	/* sleep for 10 seconds */

    	select 
        	action = "Sleeping @waitfor_delay. Will queue next report shortly",
        	waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay
end



go
