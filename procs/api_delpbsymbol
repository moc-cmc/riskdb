
drop procedure
	api_delpbsymbol	
go

create procedure
	api_delpbsymbol	
			@login varchar(25),
			@name varchar(50),
			@source_name varchar(100),
			@mapping varchar(50)
as

declare @prime_broker_id int
declare @source_id int

select 
	@prime_broker_id=a.prime_broker_id
from
	prime_brokers a,
	sources b,
	source_types c	
where
	a.source_id=b.source_id
and
	b.name=@name
and
	b.source_type_id=c.source_type_id
and
	c.name="Prime Broker"

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find Prime Broker",
		prime_broker=@name

	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Could not find source",
		source=@source_name
	return
end

begin tran
	delete from
		prime_broker_symbols
	where
		prime_broker_id=@prime_broker_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount !=1)
	begin
		rollback tran

		select
			status="Error",
			msg="Could not delete Prime Broker mapping",
			name=@name

		return
	end

commit tran

select
	status="Success",
	msg="Prime Broker Mapping Deleted",
	name=@name

exec
	r_mappingoverview
		@login=@login

return

go


