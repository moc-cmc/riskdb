
drop procedure
	fxa_clientblotterviews
go

create procedure
	fxa_clientblotterviews
		@login varchar(50),
		@user_name varchar(50)
as

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Column Link",
	"back_to_client_access",
	"Client Access",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"make_view_style",
	"Set Client View Style",
	NULL,
	NULL)


select * from #links


select
	back_to_client_access = "Back To Client Access"

create table
	#output(
		user_name varchar(50),
		blotter_view_style varchar(50),
		is_view_style varchar(10) NULL,
		make_view_style varchar(25) NULL,
		description varchar(255))

insert into
	#output
select
	user_name = @user_name,
	name,
	NULL,
	"Make View Style",
	description
from
	blotter_view_styles


update
	#output
set
	a.is_view_style = "YES",
	a.make_view_style = NULL
from
	#output a,
	client_login_configs b,
	tico_accounts c,
	blotter_view_styles d
where
	a.user_name = c.login
and
	a.blotter_view_style = d.name
and
	b.blotter_view_style_id = d.blotter_view_style_id
and
	b.tico_account_id = c.account_id
	
select * from #output order by blotter_view_style
		



go
