
drop procedure
	api_delcpsymbol
go

create procedure
		api_delcpsymbol
			@login varchar(25),
			@name varchar(100),
			@source_name varchar(100),
			@mapping varchar(100)
as

declare @counterparty_id int
declare @source_id int

select
	@counterparty_id=counterparty_id
from
	counterparties
where
	name=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find counterparty",
		counterparty=@name

	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find source",
		source=@source_name
	return
end

begin tran
	delete from 
		counterparty_symbols
	where
		counterparty_id=@counterparty_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount !=1 )
	begin
		rollback tran
		
		select 
			status="Error",
			msg="Could not delete Counterparty mapping",
			name=@name

		return
	end

commit tran

select
	status="Success",
	msg="Counterparty Mapping Deleted",
	name=@name

exec
	r_mappingoverview
			@login=@login

return

go


