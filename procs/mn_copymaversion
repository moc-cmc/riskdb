use
	risk_atglobal
go

drop procedure
	mn_copymaversion
go

create procedure
	mn_copymaversion
		@login varchar(50),
		@master_allocation varchar(50),
		@version int
as

/* Previous version */
declare @master_allocation_id int
declare @ma_version_id int
declare @status varchar(50)
declare @queued_ma_versions int
declare @archived_status_id int

declare @new_ma_version_id int
declare @external_account_id int
declare @queued_status_id int
declare @sub_account_id int
declare @new_sub_account_id int
declare @new_version int
declare @allocation_mode_id int
declare @allocation float
declare @sub_accounts int



select
	@master_allocation_id = master_allocation_id
from
	master_allocations
where
	name = @master_allocation
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Master allocation not found",
		master_allocation = @master_allocation
	return
end

select
	@ma_version_id = ma_version_id,
	@allocation_mode_id = allocation_mode_id
from
	ma_versions
where
	master_allocation_id = @master_allocation_id
and
	version = @version
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Version not found",
		master_allocation = @master_allocation,
		version = @version
	return
end

select
	@queued_ma_versions = 0
select
	@queued_ma_versions = count(a.ma_version_id)
from
	ma_versions a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Queued"	
and
	a.ma_version_id = @ma_version_id

if @queued_ma_versions != 0
begin
	select
		status = "Error",
		message = "Queued version already exists. Please remove it before trying to copy"
	return
end

select
	@queued_status_id = status_id
from
	statuses
where
	name = "Queued"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"statuses",
			@queued_status_id output

	insert into
		statuses
	values(
		@queued_status_id,
		"Queued")
end

select
	@new_version = max(version)
from
	ma_versions
where
	master_allocation_id = @master_allocation_id

select
	@new_version = @new_version + 1

exec
	j_nextkey
		"ma_versions",
		@new_ma_version_id output

insert into
	ma_versions(
		ma_version_id,
		master_allocation_id,
		version,
		allocation_mode_id,
		status_id,
		creation_date)
values(
	@new_ma_version_id,
	@master_allocation_id,
	@new_version,
	@allocation_mode_id,
	@queued_status_id,
	getdate())

select
	@sub_account_id = 0
select
	@sub_accounts = count(*)
from
	sub_accounts
where
	ma_version_id = @ma_version_id
and
	sub_account_id > @sub_account_id

while @sub_accounts > 0
begin
	select
		@sub_account_id = min(sub_account_id)
	from
		sub_accounts
	where
		ma_version_id = @ma_version_id
	and
		sub_account_id > @sub_account_id

	select
		@external_account_id = external_account_id,
		@allocation = allocation
	from
		sub_accounts
	where
		sub_account_id = @sub_account_id

	select
		@new_sub_account_id = NULL

	exec
		j_nextkey
			"sub_accounts",
			@new_sub_account_id output

	insert into
		sub_accounts
	values(
		@new_sub_account_id,
		@new_ma_version_id,
		@external_account_id,
		@allocation)

	select
		@sub_accounts = count(*)
	from
		sub_accounts
	where
		ma_version_id = @ma_version_id
	and
		sub_account_id > @sub_account_id
end



exec
	mn_inspectsubaccounts
		@login,
		@master_allocation,
		@new_version


go

