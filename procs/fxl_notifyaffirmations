create or replace procedure
	fxl_notifyaffirmations
		@source varchar(50)
as

declare @start_time datetime
declare @end_time datetime
select
	@start_time=getdate()

declare @source_id int
declare @spectrum_broker_id int
declare @notified varchar(10)
declare @tags_t varchar(50)
declare @tags_g varchar(50)
declare @range varchar(10)
declare @min_trade_id int

declare @begin_date datetime
declare @end_date datetime


select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

select
	@spectrum_broker_id = broker_id
from
	brokers
where
	symbol = "Spectrum"


create table
	#statuses(
		status_id int
)

insert into
	#statuses
select
	status_id
from
	statuses
where
	name in("Active", "Edit", "Cancelled")


create table
	#trade_notifications(
		trade_notification_id int,
		trade_id int)

insert into
	#trade_notifications(
		trade_notification_id,
		trade_id)
select
	a.trade_notification_id,
	a.trade_id
from
	trade_notifications a,
	#statuses b
where
	a.source_id = @source_id
and
	a.status_id = b.status_id
	


select 
	@min_trade_id = min(trade_id)
from
	#trade_notifications


create table
	#trades(
		trade_id int,
		broker_id int,
		identifier varchar(100),
		trade_notification_id int,
		affirm_date datetime NULL,
		tnum varchar(25) NULL,
		snum varchar(25) NULL,
		ref_id varchar(50) NULL
		)


insert into
	#trades
(
	trade_id,
	broker_id,
	identifier,
	trade_notification_id
)
select 
	trade_id = a.trade_id,
	broker_id = a.broker_id,
	identifier = a.identifier,
        trade_notification_id = b.trade_notification_id
from
	trades a,
	#trade_notifications b
where
	a.trade_id = b.trade_id
and
	a.trade_id >= @min_trade_id


update 
	#trades
set
        affirm_date = b.affirm_date
from
	#trades a,
	affirmation_log b
where
	a.trade_id = b.trade_id
and
	b.trade_id >= @min_trade_id
select
	@notified = convert(varchar(10), @@rowcount)


update
        #trades
set
        tnum = substring(identifier,1, (charindex('-', identifier) -1)),
        snum = substring(identifier,(charindex('-', identifier)+1), ( (charindex('.', identifier)) - (charindex('-', identifier)+1)))
from
        #trades a
where
	identifier like("%.%")
and
	broker_id = @spectrum_broker_id

update
        #trades
set
        tnum = substring(identifier,1, (charindex('-', identifier) -1)),
	snum = substring(identifier,(charindex('-', identifier)+1), len(identifier) - (charindex('-', identifier)))
from
        #trades a
where
        identifier not like("%.%")
and
	broker_id = @spectrum_broker_id

update
	#trades
set
        tnum = substring(b.alias ,1, (charindex('-', b.alias) -1)),
        snum = substring(b.alias ,(charindex('-', b.alias)+1), len(b.alias) - (charindex('-', b.alias)))
from
	#trades a,
	trade_aliases b
where
	a.broker_id != @spectrum_broker_id
and
	b.trade_id >= @min_trade_id
and
	a.trade_id = b.trade_id
and
	b.source_id = @source_id
	

select
	trade_id,
	affirmation_status="Matched",
	affirm_date,
	trade_notification_id,
	tnum,
	snum,
	ref_id 
from
        #trades


select
	@end_time = getdate(),
	@tags_t = "sc:"+rtrim(@source),
	@tags_g = "sc:"+rtrim(@source)+",proc:fxl_notifyaffirmations"

exec
	sp_dogstatsdcounter
		@metric_name = "stp.outbound.notified",
		@value = @notified,
		@tags = @tags_g
exec 
	sp_dogstatsdtimer 
		@metric_name="ase.proc.fxl_notifyaffirmations",
		@start_time=@start_time,
		@end_time=@end_time,
		@tags=@tags_t,
 		@sample_rate="1.0"

go
