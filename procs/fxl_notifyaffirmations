create or replace procedure
	fxl_notifyaffirmations
		@source varchar(50),
		@query_options char(1)=NULL,
		@query_futures char(1)=NULL
as


declare @source_id int

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

create table
	#trades(
		trade_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		affirmation_status varchar(25),
		affirm_date datetime NULL,
		identifier varchar(100),
		trade_notification_id int,
		tnum varchar(25) NULL,
		snum varchar(25) NULL
		)


create nonclustered index 
	tmp_tid
on
	#trades(trade_id)


create table
	#trade_notifications(
		trade_notification_id int,
		trade_id int,
		source_id int,
		status_id int
		)


declare @active_status_id int
declare @edit_status_id int
declare @cancelled_status_id int
declare @cancelling_src_status_id int

select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
select
        @edit_status_id = status_id
from
        statuses 
where
        name = "Edit"
select
        @cancelled_status_id = status_id
from
        statuses 
where
        name = "Cancelled"


/*
| Insert into #trade_notifications anything with status_id "Active", "Edit", "Cancelled"
*/
insert into
        #trade_notifications
select
        a.trade_notification_id,
        a.trade_id,
        a.source_id,
        a.status_id
from
        trade_notifications a,
        statuses b
where
        a.status_id = b.status_id
and
        b.name in("Active", "Edit", "Cancelled")
and
        a.source_id = @source_id



/*
| Insert *_ids into #trades that need to be notified 
*/
insert into
	#trades
(
	trade_id,
	trade_type_id,
	affirmation_status,
	identifier,
	trade_notification_id
)
select 
	trade_id = a.trade_id,
	trade_type_id = a.trade_type_id,
	affirmation_status = "Matched",
	identifier = a.identifier,
	trade_notification_id = b.trade_notification_id
from
	trades a,
	#trade_notifications b,
	affirmation_log c
where
	a.trade_id=b.trade_id
and
	a.trade_id=c.trade_id

/*
| Query trade_types
*/
update
	#trades
set
	trade_type = b.name
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id

/*
| Query time of affirmation
*/
update
	#trades
set
	affirm_date = b.affirm_date
from
	#trades a,
	affirmation_log b
where
	a.trade_id = b.trade_id


if @query_futures = "O"  /* O for ONLY, ONLY query futures, remove all other trades */
begin
        delete from
                #trades
        where
                trade_type not in("Future")
end
else if @query_futures = "N"
begin
        delete from
                #trades
        where
                trade_type in("Future")
end

if @query_options = "O"  /* O for ONLY, ONLY query options, remove all other trades */
begin
	delete from
		#trades
	where
		trade_type not in("Option")
end
else if @query_options = "N"
begin
        delete from
                #trades
        where
                trade_type in("Option")
end


update
        #trades
set
        tnum = substring(identifier,1, (charindex('-', identifier) -1)),
        snum = substring(identifier,(charindex('-', identifier)+1), ( (charindex('.', identifier)) - (charindex('-', identifier)+1)))
from
        #trades a
where
	identifier like("%.%")

update
        #trades
set
        tnum = substring(identifier,1, (charindex('-', identifier) -1)),
	snum = substring(identifier,(charindex('-', identifier)+1), len(identifier) - (charindex('-', identifier)))
from
        #trades a
where
        identifier not like("%.%")

select
	trade_id,
	trade_type_id,
	trade_type,
	affirmation_status,
	affirm_date,
	identifier,
	trade_notification_id,
	tnum,
	snum
from
        #trades
order by
        trade_id


go
