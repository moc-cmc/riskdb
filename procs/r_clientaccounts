
if object_id("r_clientaccounts") != NULL
    drop procedure
        r_clientaccounts
go

create procedure r_clientaccounts
as

declare @client_account_type_id int

select
	@client_account_type_id=external_account_type_id
from
	external_account_types
where
	name="Counterparty"


select
	name
from
	external_accounts
where
	external_account_type_id=@client_account_type_id
order by
	name


go
