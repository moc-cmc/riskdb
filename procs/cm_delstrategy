
if object_id("cm_delstrategy") != NULL
    drop procedure
        cm_delstrategy
go

create procedure
	cm_delstrategy
		@login varchar(30),
		@strategy varchar(30)

as

declare @strategy_id int
declare @total_trades int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)



select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @strategy_id = NULL
begin
	select
		status = "Error",
		message = "Strategy not found",
		strategy = @strategy
	return
end

select
	@total_trades = count(*)
from
	trades
where
	strategy_id = @strategy_id
if @total_trades != 0
begin
	select
		status = "Error",
		message = "Non-zero number of trades found for this strategy. Not Deleted",
		strategy = @strategy
	return
end

delete

from
	strategies
where
	strategy_id = @strategy_id


select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds


select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string


exec
	cm_strategies
		@login

go
