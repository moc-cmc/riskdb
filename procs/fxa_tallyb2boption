drop procedure fxa_tallyb2boption
go

create procedure
	fxa_tallyb2boption
		@login varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(25),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@biproduct varchar(50),
		@timezone varchar(25),
		@expiration datetime,
		@option_settlement datetime,
		@strike numeric(30,6),
		@call_put varchar(10),
		@implied_volatility float,
		@spot_reference float,
		@client_price float,
		@client_format varchar(10),
		@client_total_premium float = NULL,
		@client_premium_currency varchar(25) = NULL,
		@client_premium_settle datetime = NULL,
		@market_price float,
		@market_format varchar(10),
		@market_total_premium float = NULL,
		@market_premium_currency varchar(25) = NULL,
		@market_premium_settle datetime = NULL

as

declare @deal_id int

if @call_put in('c','C', '0', 'CALL')
        select
                @call_put = 'C'

if @call_put in('p', 'P', '1', 'PUT')
        select
                @call_put = 'P'


exec 
	api_tallyb2boption
		@login,
		@client_user,
		@client_buys_sells,
		@counterparty,
		@quantity,
		@biproduct,
		@timezone,
		@expiration,
		@option_settlement,
		@strike,
		@call_put,
		@implied_volatility,
		@spot_reference,
		@client_price,
		@client_format,
		@client_total_premium,
		@client_premium_currency,
		@client_premium_settle,
		@market_price,
		@market_format,
		@market_total_premium,
		@market_premium_currency,
		@market_premium_settle,
		@deal_id output

exec
	r_inspectdealtrades
		@login,
		@deal_id

go

