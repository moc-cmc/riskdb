
if object_id("cm_deltrader") != NULL
    drop procedure
        cm_deltrader
go

create procedure
	cm_deltrader
		@login varchar(30),
		@trader varchar(50)

as

declare @trader_id int
declare @total_trades int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)



select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @trader_id = NULL
begin
	select
		status = "Error",
		message = "Trader not found",
		trader = @trader
	return
end

select
	@total_trades = count(*)
from
	trades
where
	trader_id = @trader_id
if @total_trades != 0
begin
	select
		status = "Error",
		message = "Non-zero number of trades found for this trader. Not Deleted",
		trader = @trader
	return
end

delete

from
	traders
where
	trader_id = @trader_id




select
        @tico_server = tico_server,
        @tico_database = tico_database
from
        funds

select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string


exec
	cm_traders
		@login

go
