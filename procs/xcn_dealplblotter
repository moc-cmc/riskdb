
if object_id("xcn_dealplblotter") != NULL
    drop procedure
        xcn_dealplblotter
go

create procedure
	xcn_dealplblotter
		@login varchar(30),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@reference_id varchar(50)=NULL,
		@entered_by varchar(50)=NULL,
		@external_account varchar(50)=NULL,
		@symbol varchar(50)=NULL,
		@rrcode varchar(30)=NULL,
		@trader varchar(30)=NULL,
		@broker varchar(30)=NULL

as

declare @start_date datetime
declare @stop_date datetime

declare @symbol_string varchar(30)
declare @reference_id_string varchar(30)

declare @trade_id int
declare @trades int

declare @quantity numeric(30,4)
declare @trade_price float
declare @begin_value float
declare @close_price float
declare @end_value float
declare @p_l float
declare @native_currency_id int
declare @native_pl float
declare @trade_reference varchar(30)
declare @broker_sym varchar(30)
declare @contract_id int

declare @total_pl float
declare @avg_volume float
declare @total_volume float
declare @total_deals int
declare @usd_volume float
declare @product_id int
declare @currency_id int

declare @usd_product_id int
declare @conversion_rate float
declare @price_style varchar(30)
declare @date datetime

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Format Number",
	"deal_pl",
	NULL,
	NULL,
	"#,##0.00")


insert into
	#links
values(
	"Format Number",
	"trade_pl",
	NULL,
	NULL,
	"#,##0.00")


insert into
	#links
values(
	"Format Number",
	"price",
	NULL,
	NULL,
	"#,##0.000000")
--Adaptive Server has expanded all '*' elements in the following statement


select
	#links.meta_type, #links.column, #links.link, #links.arguments, #links.format
from
	#links

select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "USD Product not found"
	return
end

create table
	#prices(
		contract_id int,
		inverted_contract_id int NULL,
		price float NULL)


if @reference_id != NULL
	select
		@reference_id = "%" + rtrim(@reference_id) + "%"
else
	select
		@reference_id = "%"

if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output

	select
		@start_date = @begin_date,
		@stop_date = @end_date
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@start_date output,
			@stop_date output

	exec
		r_daterangefordate
			@end_date,
			@begin_date output,
			@stop_date output
end

select
	@begin_date = @start_date,
	@end_date = @stop_date
	
		
create table
	#users(
		user_id int)
insert into
	#users
select
	account_id
from
	tico_accounts
where
	login = @entered_by
if @@rowcount = 0
	insert into
		#users
	select
		account_id
	from
		tico_accounts

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	traders
where
	symbol = @trader
if @@rowcount = 0
	insert into
		#traders
	select
		trader_id
	from
		traders

create table
	#rrcode_traders(
		trader_id int)

if @rrcode = "" or @rrcode = NULL
	insert into
		#rrcode_traders
	select
		trader_id
	from
		traders
else
begin
	insert into
		#rrcode_traders
	select
		trader_id
	from
		traders
	where
		rrcode = @rrcode
	if @@rowcount = 0
		insert into
			#rrcode_traders
		select
			trader_id
		from
			traders
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts


create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

select
	@symbol_string = "%" + lower(rtrim(@symbol)) + "%"

create table
	#contracts(
		contract_id int)
insert into
	#contracts
select
	contract_id
from
	contracts
where
	lower(symbol) like @symbol_string


create table
	#trades(
		trade_id int)

insert into
	#trades
select
	a.trade_id
from
	trades a,
	#users b,
	#external_accounts c,
	#contracts d,
	#rrcode_traders e,
	#traders f,
	#brokers g,
	trade_identifiers h
where
	a.user_id = b.user_id
and
	a.external_account_id = c.external_account_id
and
	a.contract_id = d.contract_id
and
	a.trader_id = e.trader_id
and
	a.trader_id = f.trader_id
and
	e.trader_id = f.trader_id
and
	a.broker_id = g.broker_id
and
	a.trade_id = h.trade_id
and
	h.identifier like @reference_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

create table
	#unique_deals(
		deal_id int)
insert into
	#unique_deals
select
	distinct(a.deal_id)
from
	trades a,
	#trades b
where
	a.trade_id = b.trade_id

insert into
	#trades
select
	a.trade_id
from
	trades a,
	#unique_deals b
where
	a.deal_id = b.deal_id
and
	a.trade_id not in(
		select
			trade_id
		from
			#trades)



create table
	#blotter(
		trade_id int,
		deal_id int,
		trade_date datetime,
		entered_by int,
		internal_account_id int,
		external_account_id int,
		product varchar(10) NULL,
		buy_sell varchar(30),
		quantity numeric(30,4),
		contract_id int,
		value_date datetime NULL,
		price float,
		rrcode varchar(30) NULL,
		reference_id varchar(30) NULL,
		trader varchar(30) NULL,
		broker varchar(30) NULL,
		p_l float NULL,
		deal_pl float NULL,
		usd_volume float NULL,
		conversion_rate float NULL)


select
	@trade_id = 0
select
	@trades = count(*)
from
	#trades
where
	trade_id > @trade_id

while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#trades
	where
		trade_id > @trade_id

	select
		@quantity = quantity,
		@trade_price = price,
		@contract_id = contract_id
	from
		trades
	where
		trade_id = @trade_id

	select
		@begin_value = NULL,
		@close_price = NULL,
		@end_value = NULL,
		@p_l = NULL,
		@native_currency_id = NULL,
		@native_pl = NULL,
		@trade_reference = NULL,
		@broker_sym = NULL,
		@usd_volume = NULL,
		@product_id = NULL,
		@currency_id = NULL

	select
		@broker_sym = a.symbol
	from
		brokers a,
		trades b
	where
		a.broker_id = b.broker_id
	and
		b.trade_id = @trade_id

	exec
		r_tradeplfordate
			"Intraday",
			@trade_id,
			@quantity,
			@trade_price,
			@begin_value output,
			@end_date,
			@close_price output,
			@end_value output,
			@p_l output,
			@native_currency_id output,
			@native_pl output


	exec
		r_contractproduct
			@contract_id,
			@product_id output

	if @product_id = @usd_product_id
	begin
		select
			@conversion_rate = 1.0,
			@usd_volume = @quantity
	end
	else
	begin
		
		select
			@price_style = NULL,
			@conversion_rate = NULL
		exec
			cv_dollaramount
				@product_id,
				@quantity,
				@end_date,
				@usd_volume output,
				@price_style output,
				@conversion_rate output


		if @price_style = "Inverted"
			select
				@conversion_rate = 1.0 / @conversion_rate
	end

	select
		@trade_reference = identifier
	from
		trade_identifiers
	where
		trade_id = @trade_id

	insert into
		#blotter
	select
		a.trade_id,
		a.deal_id,
		a.trade_date,
		a.user_id,
		a.internal_account_id,
		a.external_account_id,
		product = NULL,
		buy_sell = "BUY",
		a.quantity,
		a.contract_id,
		b.value_date,
		a.price,
		NULL,
		reference_id = @trade_reference,
		NULL,
		broker = @broker_sym,
		p_l = @p_l,
		NULL,
		usd_volume = @usd_volume,
		conversion_rate = @conversion_rate
	from
		trades a,
		trade_value_dates b
	where
		a.trade_id = @trade_id
	and
		a.trade_id *= b.trade_id
		
	
	update
		#blotter
	set
		a.rrcode = c.rrcode,
		a.trader = c.symbol
	from
		#blotter a,
		trades b,
		traders c
	where
		a.trade_id = b.trade_id
	and
		b.trader_id = c.trader_id
	and
		b.trade_id = @trade_id
	and
		a.trade_id = @trade_id 

	select
		@trades = count(*)
	from
		#trades
	where
		trade_id > @trade_id

end

update
	#blotter
    set
	a.product = "Spot"
    from
	#blotter a,
	trade_types b
    where
	a.trade_id = b.trade_id
    and
	b.trade_type = "S"

update
	#blotter
    set
	a.product = "Forward"
    from
	#blotter a,
	trade_types b
    where
	a.trade_id = b.trade_id
    and
	b.trade_type = "F"

update
	#blotter
    set
	a.product = "Option"
    from
	#blotter a,
	option_contracts b
    where
	a.contract_id = b.contract_id

create table
	#deals(
		deal_id int,
		deal_pl float NULL)
insert into
	#deals
select
	deal_id,
	sum(p_l)
from
	#blotter
group by
	deal_id

update
	#blotter
set
	a.deal_pl = b.deal_pl
from
	#blotter a,
	#deals b
where
	a.deal_id = b.deal_id

update
	#blotter
set
	buy_sell = "SELL"
where
	quantity < 0


update
	#blotter
set
	a.price = 1.0 / a.price
from
	#blotter a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"

create table
	#stats(
		category varchar(50),
		value varchar(30) NULL)
select
	@total_pl = sum(p_l)
from
	#blotter
insert into
	#stats
values(
	"Total P&L",
	convert(varchar(30), convert(numeric(30,2), @total_pl)))

select
	@total_volume = sum(abs(a.usd_volume))
from
	#blotter a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
insert into
	#stats
values(
	"Total Client Volume",
	convert(varchar(30), convert(numeric(30,2), @total_volume)))

select
	@total_deals = count(distinct(deal_id))
from
	#blotter
insert into
	#stats
values(
	"Total Deals",
	convert(varchar(30), convert(numeric(30,2), @total_deals)))

if @total_deals != 0
begin
	select
		@avg_volume = @total_volume / @total_deals
	insert into
		#stats
	values(
		"Average Client Trade Size",
		convert(varchar(30), convert(numeric(30,2), @avg_volume)))
end

select
	a.deal_id /*,
	a.trade_date,
	entered_by = b.login,
	internal_account = c.symbol,
	external_account = d.symbol,
	a.product,
	a.buy_sell,
	quantity = abs(a.quantity),
	e.symbol,
	value_date = convert(char(11), a.value_date, 1),
	a.price,
	a.rrcode,
	a.reference_id,
	a.trader,
	a.broker,
	a.conversion_rate,
	trade_pl = a.p_l,
	a.deal_pl */
from
	#blotter a,
	tico_accounts b,
	internal_accounts c,
	external_accounts d,
	contracts e
where
	a.entered_by = b.account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.external_account_id = d.external_account_id
and
	a.contract_id = e.contract_id
order by
	a.deal_id,
	a.trade_date,
	a.trade_id

	


--Adaptive Server has expanded all '*' elements in the following statement
select
	#stats.category, #stats.value
from
	#stats

go
