create procedure
	dm_simulateb2btradealways
		@login varchar(50),
		@edge float=NULL,
		@book_date datetime=NULL
as


declare @contract_id int
declare @id int
declare @num_contracts int
declare @tally int
declare @should_tally char(10)
declare @net_position float
declare @max_position float
declare @symbol varchar(50)
declare @last_price float
declare @client_price float
declare @market_price float
declare @sign_test int
declare @size_test int
declare @trade_sign int
declare @quantity float
declare @large_size float
declare @small_size float
declare @value_date datetime
declare @client_val_date datetime
declare @market_val_date datetime
declare @trade_date datetime
declare @client_buys_sells varchar(25)
declare @dealt_ccy varchar(10)
declare @counter_ccy varchar(10)
declare @counterparty_id int
declare @counterparty varchar(20)
declare @counterparties int
declare @tick_size float
declare @deal_id int
declare @trader varchar(25)
declare @traders int
declare @trader_id int
declare @fund_type varchar(50)
declare @prime_broker_id int
declare @prime_brokers int

declare @broker varchar(50)
declare @brokers int
declare @broker_id int


if @edge = NULL
	select
		@edge = 0.2

select
	@fund_type = name
from
	fund_sub_types


create table
	#prime_brokers(
		pb_id int identity,
		prime_broker_id int
)

if @fund_type = "FX Agency"
begin
	declare @min_pb_id int


	insert into
		#prime_brokers(
			prime_broker_id)
	select
		prime_broker_id
	from
		prime_brokers

        insert into
                #prime_brokers(
                        prime_broker_id)
        select
                prime_broker_id
        from
                prime_brokers

	select
		@min_pb_id = min(prime_broker_id)	
	from
		prime_brokers

	insert into #prime_brokers values(@min_pb_id)

end
else if @fund_type = "Prime of Prime"
begin
	select
		msg = "prime of prime workflow not supported"
	return
end

select
	@prime_brokers = count(*) from #prime_brokers

select
	@prime_broker_id  = prime_broker_id
from
	#prime_brokers
where
	pb_id = convert(int, (rand() * @prime_brokers))
if @prime_broker_id = NULL
begin
	select
		@prime_broker_id = max(prime_broker_id) from #prime_brokers
end

create table
	#counterparties(
		counterparty_id int identity,
		name varchar(50))
insert into
	#counterparties(
		name)
select
	a.name
from
	counterparties a,
	external_accounts b,
	external_account_prime_brokers c
where
	c.prime_broker_id = @prime_broker_id
and
	a.external_account_id = b.external_account_id
and
	b.external_account_id = c.external_account_id
and	
	a.counterparty_id not in(select counterparty_id from fund_agency_counterparties)
and
	a.name not like ("%RESID")

select
	@counterparties = count(*)
from
	#counterparties

select
	@counterparty_id = convert(int, rand() * @counterparties)

select
	@counterparty = name
from
	#counterparties
where
	counterparty_id = @counterparty_id

if @counterparty = NULL
	select
		@counterparty = name
	from
		#counterparties
	where
		counterparty_id = 1
	

create table
        #traders(
                trader_id int identity,
                symbol varchar(50))
insert into
        #traders(
                symbol)
select
        a.symbol
from
        traders a,
	external_accounts b,
	external_account_prime_brokers c
where
        c.prime_broker_id = @prime_broker_id
and
        a.external_account_id = b.external_account_id
and
        b.external_account_id = c.external_account_id
and
	a.trader_id not in(select trader_id from fund_agency_traders)
and
	a.symbol not like "% RM%"
and
	a.symbol not like "%UNALLOC"
and
	a.symbol not like "%PINE%"
and
	a.symbol not like "BRKR%"

select
        @traders = count(*)
from
        #traders

select
        @trader_id = convert(int, rand() * @traders)

select
        @trader = symbol
from
        #traders
where
        trader_id = @trader_id

if @trader = NULL
        select
                @trader = symbol
	from
		#traders
	where
		trader_id in(select max(trader_id) from #traders)

create table        
        #brokers(
                broker_id int identity,
                symbol varchar(50))

insert into
        #brokers(
                symbol)
select
        a.symbol
from
        brokers a

/* make sure the other brokers are more likely to get picked than MPT Tally */
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol != "MPT Tally"
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol != "MPT Tally"
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol != "MPT Tally"
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol != "MPT Tally"
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol != "MPT Tally"
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol != "MPT Tally"
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow", "Broadway")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow", "Broadway")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow", "Broadway")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow", "Broadway")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow", "Broadway")
insert into #brokers(symbol) select a.symbol from brokers a where a.symbol not in("MPT Tally", "Tradair", "Flextrade", "Integral", "FD Deltaflow", "Broadway")

select        
        @brokers = count(*)
from
        #brokers

select
        @broker_id = convert(int, rand() * @brokers)

select
        @broker = symbol
from
        #brokers
where
        broker_id = @broker_id

	


if @broker = NULL
        select
                @broker = symbol
        from
                #brokers
        where
                broker_id = (select max(broker_id) from #brokers)



create table
	#contracts(
		id int identity,
		symbol varchar(50),
		max_position float,
		net_position float NULL,
		last_price float NULL,
		small_size float NULL,
		large_size float NULL,
		tick_size float NULL)


insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("EURUSD", 20000000, 125000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("EURUSD", 20000000, 125000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("EURUSD", 20000000, 125000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("EURUSD", 20000000, 125000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("USDJPY", 20000000, 100000, 1000000, .01)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("USDJPY", 20000000, 100000, 1000000, .01)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("GBPUSD", 20000000, 62500, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("GBPUSD", 20000000, 62500, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("GBPUSD", 20000000, 62500, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("EURJPY", 20000000, 100000, 1000000, .01)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("USDCHF", 20000000, 125000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("EURCHF", 20000000, 100000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("USDCAD", 20000000, 100000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("AUDUSD", 20000000, 100000, 1000000, .0001)
insert into #contracts(symbol, max_position, small_size, large_size, tick_size) values("AUDUSD", 20000000, 125000, 1000000, .0001)


select
	@id = 0

select
	@num_contracts = count(*)
from
	#contracts
where
	id > @id

while @num_contracts > 0
begin
	select
		@id = min(id)
	from
		#contracts
	where
		id > @id

	select
		@contract_id = a.contract_id
	from
		contracts a,
		#contracts b
	where
		a.symbol = b.symbol
	and
		b.id = @id

	/*select
		@net_position = sum(quantity)
	from
		trades
	where
		contract_id = @contract_id
	and 
		trade_date > convert(date, @trade_date)*/
	if @net_position = NULL
		select
			@net_position = 0.0

	select
		@market_price = price
	from
		current_prices
	where
		contract_id = @contract_id

	update
		#contracts
	set
		net_position = @net_position,
		last_price = @market_price
	where
		id = @id

	select
		@num_contracts = count(*)
	from
		#contracts
	where
		id > @id
end


select @num_contracts = max(id) from #contracts

select @id = convert(int, rand() * @num_contracts)


select
	@symbol = symbol,
	@net_position = net_position,
	@max_position = max_position,
	@last_price = last_price,
	@large_size = large_size,
	@small_size = small_size,
	@tick_size = tick_size
from
	#contracts
where
	id = @id

if @symbol = NULL
begin
select
        @symbol = symbol,
        @net_position = net_position,
        @max_position = max_position,
        @last_price = last_price,
        @large_size = large_size,
        @small_size = small_size,
        @tick_size = tick_size
from
        #contracts
where
	symbol = "EURUSD"
end

select
	@market_price = @last_price

select
	@tick_size = @tick_size * @edge


if @symbol != NULL
begin
	select
		@contract_id = contract_id
	from
		contracts
	where
		symbol = @symbol

	select
		@dealt_ccy = a.symbol
	from
		products a,
		forwards b
	where
		a.product_id = b.product_id
	and
		b.contract_id = @contract_id

	select
		@counter_ccy = a.symbol
	from
		products a,
		forwards b
	where
		a.product_id = b.currency_id
	and
		b.contract_id = @contract_id


	select
		/*@tally = rand() * 10*/
                @tally = 10
	
	if @tally > 1
	begin
		select
			@should_tally = "YES"
		select
			@sign_test = rand() * 10,
			@size_test = rand() * 10

		if @net_position > .75 * @max_position
		begin
			select
				@trade_sign = sign(@net_position) * -1.0
		end
		else
		begin
			if @sign_test >= 5
				select
					@trade_sign = 1
			else
				select
					@trade_sign = -1.0
		end
		
		if @trade_sign < 0
			select
				@client_buys_sells = "Client Buys",
				@client_price = @market_price + @tick_size
		else
			select
				@client_buys_sells = "Client Sells",
				@client_price = @market_price - @tick_size

		if @size_test >= 4
			select
				@quantity = @large_size
		else
			select
				@quantity = @small_size
	end
	else
		select
			@should_tally = "NO"
end

if @book_date = NULL
begin
	select
		@trade_date = getdate()
end
else
begin
	select 
		@trade_date = @book_date
end


exec
	r_nextbusinessday
		@trade_date,
		@value_date output

if @symbol != "USDCAD"
	exec
		r_nextbusinessday
			@value_date,
			@value_date output


select @value_date = convert(datetime, convert(char(11), @value_date, 1))

if @should_tally = "YES"
begin
	select
		client_buys_sells = @client_buys_sells,
		dealt_ccy = @dealt_ccy,
		counter_ccy = @counter_ccy,
		should_tally = @should_tally,
		net_position = @net_position,
		max_position = @max_position,
		last_price = @last_price,
		quantity = @quantity,
		value_date = @value_date,
		counterparty = @counterparty
	
	exec
		api_simulateb2bforward
			@login = @login,
			@tally_type = "Spot",
			@client_user = @trader,
			/*@client_user = "FX0012-t1",*/
			@client_buys_sells = @client_buys_sells,
			@counterparty = @counterparty,
			@quantity = @quantity,
			@dealt_currency = @dealt_ccy,
			@counter_currency = @counter_ccy,
			@client_price = @client_price,
			@client_val_date = @value_date,
			@market_price = @market_price,
			@market_val_date = @market_val_date,
			@trade_date=@trade_date,
			@broker = @broker,
			@deal_id = @deal_id output


end
