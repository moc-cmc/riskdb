use
	risk_jeff
go

drop procedure
	ag_affirmationadmin
go

create procedure
	ag_affirmationadmin
		@login varchar(50),
		@as_of_date datetime=NULL,
		@trader varchar(50)=NULL,
		@traded_date datetime=NULL
as

declare @pending_status_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @begin_date datetime
declare @end_date datetime
declare @oldest datetime
declare @newest datetime
declare @total_trades int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"as_of_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"trader",
	"Affirmation Admin",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"reject",
	"Reject Client Request",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"next_action",
	"Approve Next Request Action",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"enable_user",
	"Enable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"disable_user",
	"Disable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"add_admin_user",
	"Add Approval User",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


if @as_of_date = NULL
	select
		@as_of_date = convert(datetime, convert(date, getdate()))

exec
	r_daterangefordate
		@as_of_date,
		@begin_date output,
		@end_date output


select
	@pending_status_id = status_id
from
	statuses
where
	name = "Pending Affirmation"
if @pending_status_id = NULL
begin
	select
		status = "Error",
		message = "Pending Affirmation status not found"
	return
end


select
	@begin_date = convert(datetime, convert(date, @begin_date)),
	@end_date = convert(datetime, convert(date, @end_date))


create table
	#pending(
		id int identity,
		style varchar(250) NULL,
		trader_id int,
		trader varchar(50) NULL,
		trade_date datetime,
		trades int)
insert into
	#pending(
		trader_id,
		trade_date,
		trades)
select
	trader_id,
	trade_date,
	count(trade_id)
from
	trades
where
	status_id = @pending_status_id
and
	trade_date <= @end_date
group by
	trader_id,
	trade_date

update
	#pending
set
	style = @style

update
	#pending
set
	a.trader = b.symbol
from
	#pending a,
	traders b
where
	a.trader_id = b.trader_id

update
	#pending
set
	style = @selected_style
where
	convert(date, trade_date) = convert(date, @traded_date)
and
	trader = @trader

select
	@oldest = min(trade_date),
	@newest = max(trade_date),
	@total_trades = sum(trades)
from
	#pending


create table
	#sum(
		id int identity,
		trader_id int,
		style varchar(250) NULL,
		trader varchar(50) NULL,
		trades int)
insert into
	#sum(
		trader_id,
		trades)
select
	trader_id,
	sum(trades)
from
	#pending
group by
	trader_id

update
	#sum
set
	style = @style

update
	#sum
set
	a.trader = b.symbol
from
	#sum a,
	traders b
where
	a.trader_id = b.trader_id

update
	#sum
set
	style = @selected_style
where
	trader = @trader

select
	section = "Summary",
	style = @style,
	as_of = convert(varchar(11), @as_of_date),
	oldest_pending = convert(varchar(11), @oldest),
	newest_pending = convert(varchar(11), @newest),
	pending_trades = @total_trades
	
/* 
select
	section = "Accounts",
	style,
	trader,
	as_of_date = convert(varchar(11), @as_of_date),
	trades
from
	#sum 
order by
	trader */

select
	section = "Pending Affirmation",
	style,
	traded_date = convert(varchar(11), trade_date),
	as_of_date = convert(varchar(11), @as_of_date),
	trader,
	trades,
	age = datediff(day, trade_date, @as_of_date)
from
	#pending 
/* where
	trader = @trader */
order by
	trader,
	convert(datetime, trade_date)
	
	
create table
	#prems(
		trade_id int,
		premium_date datetime,
		currency_id int,
		currency varchar(50) NULL,
		premium float,
		trader varchar(50))
insert into
	#prems(
		trade_id,
		premium_date,
		currency_id,
		premium,
		trader)
select
	a.trade_id,
	c.transaction_date,
	c.currency_id,
	c.amount,
	d.symbol
from
	trades a,
	account_transaction_trades b,
	account_transactions c,
	traders d
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	a.trader_id = d.trader_id
and
	convert(date, a.trade_date) = convert(date, @traded_date)
and
	a.status_id = @pending_status_id
and
	d.symbol = @trader

update
	#prems
set
	a.currency = b.symbol
from
	#prems a,
	products b
where
	a.currency_id = b.product_id

select
	section = "Pending Trades",
	style = @style,
	as_of_date = convert(varchar(11), @as_of_date),
	a.trade_id,
	a.deal_id,
	a.trade_date,
	trade_type = b.name,
	a.quantity,
	symbol = c.symbol,
	a.price,
	a.value_date,
	traded_by = d.symbol,
	counterparty = e.name,
	premium = f.premium,
	prem_ccy = f.currency,
	prem_date = f.premium_date
from
	trades a,
	trade_types b,
	contracts c,
	traders d,
	counterparties e,
	#prems f
where
	a.trade_id *= f.trade_id
and
	a.trade_type_id = b.trade_type_id
and
	a.contract_id = c.contract_id
and
	a.trader_id = d.trader_id
and
	a.counterparty_id = e.counterparty_id
and
	convert(date, a.trade_date) = convert(date, @traded_date)
and
	a.status_id = @pending_status_id
and
	d.symbol = @trader
order by
	symbol,
	trade_id


go
