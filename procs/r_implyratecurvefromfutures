use
	risk_sales
go

drop procedure
	r_implyratecurvefromfutures
go

create procedure
	r_implyratecurvefromfutures
		@login varchar(50),
		@contract varchar(50),
		@price float,
		@trade_date datetime,
		@row_count int,
		@row_index int,
		@session_id varchar(100)

as


if @row_index = 0
begin
	delete

	from
		session_attributes
	where
		session_id = @session_id

	insert into
		session_attributes
	values(
		@session_id,
		"Trade Date",
		convert(char(11), @trade_date, 1))
end

insert into
	session_attributes
values(
	@session_id,
	@contract,
	convert(varchar(50), @price))

if @row_index = @row_count - 1
	exec
		e_ratesforfutures
			@login,
			@session_id



go
