drop procedure
	cn_accountsdashboard
go

create procedure
	cn_accountsdashboard
		@login varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Column Link",
	"column_name",
	"Proc Title",
	NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Format",
	"other",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"change",
	"Number",
	"#,##0.00")

select * from #meta

if @begin_date = NULL
	select
		@begin_date = max(trade_date)
	from
		external_margin_transactions

if @end_date = NULL
	select
		@end_date = @begin_date


create table
	#dashboard(
		external_account_id int,
		account varchar(50) NULL,
		source_id int,
		begin_date datetime,
		begin_balance float NULL,
		begin_liquidity_value float NULL,
		end_date datetime,
		end_liquidity_value float NULL,
		end_balance float NULL,
		deposits float NULL,
		withdrawals float NULL,
		interest float NULL,
		fees float NULL,
		other float NULL)
insert into
	#dashboard(
		external_account_id,
		source_id,
		begin_date,
		end_date)
select
	external_account_id,
	max(source_id),
	min(trade_date),
	max(trade_date)
from
	external_margin_transactions
where
	trade_date >= @begin_date
and
	trade_date <= @end_date
group by
	external_account_id

update
	#dashboard
set
	a.account = b.symbol
from
	#dashboard a,
	external_accounts b
where
	a.external_account_id = b.external_account_id


update
	#dashboard
set
	deposits = 0.0,
	withdrawals = 0.0,
	interest = 0.0,
	fees = 0.0,
	other = 0.0


create table
	#transactions(
		external_account_id int,
		transaction_type_id int,
		amount float)
insert into
	#transactions
select
	external_account_id,
	transaction_type_id,
	sum(amount)
from
	account_transactions
where
	transaction_date >= @begin_date
and
	transaction_date <= @end_date
group by
	external_account_id,
	transaction_type_id

update
	#dashboard
set
	a.deposits = b.amount
from
	#dashboard a,
	#transactions b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Deposit"


update
	#dashboard
set
	a.withdrawals = b.amount
from
	#dashboard a,
	#transactions b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Withdrawal"


update
	#dashboard
set
	a.begin_balance = b.begin_balance
from
	#dashboard a,
	external_margin_transactions b
where
	a.external_account_id = b.external_account_id
and
	convert(date, a.begin_date) = convert(date, b.trade_date)


update
	#dashboard
set
	a.end_balance = b.end_balance
from
	#dashboard a,
	external_margin_transactions b
where
	a.external_account_id = b.external_account_id
and
	convert(date, a.end_date) = convert(date, b.trade_date)


update
	#dashboard
set
	a.begin_liquidity_value = b.INPV
from
	#dashboard a,
	crossland_cash_file b
where
	a.external_account_id = b.external_account_id
and
	convert(date, a.begin_date) = convert(date, b.trade_date)

update
	#dashboard
set
	a.end_liquidity_value = b.INPV
from
	#dashboard a,
	crossland_cash_file b
where
	a.external_account_id = b.external_account_id
and
	convert(date, a.end_date) = convert(date, b.trade_date)

update
	#dashboard
set
	other = end_balance - (begin_balance + deposits + withdrawals + interest + fees)



select
	account = a.symbol,
	fcm = b.name,
	begin_date = convert(char(11), c.begin_date, 1),
	c.begin_balance,
	begin_lv = c.begin_liquidity_value,
	c.deposits,
	c.withdrawals,
	c.interest,
	c.fees,
	c.other,
	c.end_balance,
	end_lv = c.end_liquidity_value,
	end_date = convert(char(11), c.end_date, 1)
from
	external_accounts a,
	sources b,
	#dashboard c
where
	a.external_account_id = c.external_account_id
and
	b.source_id = c.source_id
order by
	a.symbol



go
