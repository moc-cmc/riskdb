
drop procedure 
	tt_resolvecptymapping
go

create procedure
	tt_resolvecptymapping
		@login varchar(50),
		@source_id int,
		@source varchar(50),
		@broker_id int,
		@identifier varchar(100),
		@mapping varchar(50),
		@mapping_error_id int=NULL,
		@counterparty_id int=NULL output,
		@counterparty varchar(30)=NULL output,
		@cpty_external_account_id int=NULL output
		
as

declare @message varchar(100)

select
        @counterparty_id = a.counterparty_id,
        @counterparty = a.name,
        @cpty_external_account_id = a.external_account_id
from
        counterparties a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id
and
        b.symbol  = @mapping

if @counterparty = NULL
begin
	select 
		@message="No counterparty mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@mapping) + "'"

        if @mapping_error_id = NULL
        begin
		select
			msg = @message
		exec
                        ag_sendfailedmappingmessage
                                @login=@login,
                                @broker_id=@broker_id,
                                @identifier=@identifier,
				@mapping_error_type="Counterparty",
                                @message = @message  
        end
	else
	begin
		select
			msg = @message,
			mapping_error_id = @mapping_error_id
		return
	end
end

if @mapping_error_id != NULL
        exec
                ag_resolvefailedmappingmessage
			@login = @login,
                        @mapping_error_id = @mapping_error_id

return

go

