
if object_id("r_editforwardsettle") != NULL
    drop procedure
        r_editforwardsettle
go

create procedure
	r_editforwardsettle
		@login char(30),
		@symbol char(50),
		@price_date datetime,
		@value_date datetime,
		@forward_price float
as

declare @product_id int
declare @product_rate_id int
declare @rate float
declare @spot_price float
declare @implied_rate float
declare @days float
declare @contract_id int
declare @price_style char(30)
declare @product varchar(50)



select
	@price_date = convert(datetime, convert(char(11), @price_date, 1)),
	@value_date = convert(datetime, convert(char(11), @value_date, 1))

select
	@price_date = dateadd(hour, 17, @price_date)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract",
		symbol = @symbol
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id
if @price_style = "Inverted"
	select
		@forward_price = 1.0 / @forward_price
exec
	r_contractproduct
		@contract_id,
		@product_id output

select
	@product = symbol
from
	products
where
	product_id = @product_id
if @product = "USD"
begin
	exec
		r_invertedcontract
			@contract_id,
			@contract_id output

	select
		@forward_price = 1.0 / @forward_price

	exec
		r_contractproduct
			@contract_id,
			@product_id output
	select
		@symbol = symbol 
	from
		contracts
	where
		contract_id = @contract_id

end	

select @product

if @product = "EUR" and @contract_id not in(select contract_id from contracts where symbol = "EURUSD")

begin
        exec
                r_invertedcontract
                        @contract_id,
                        @contract_id output

        select
                @forward_price = 1.0 / @forward_price
	select
		@symbol = symbol 
	from
		contracts
	where
		contract_id = @contract_id
end

exec
	r_priceasof
		@contract_id,
		@price_date,
		@spot_price output

exec
	x_impliedratefromforward
		@login,
		@price_date,
		@symbol,
		@spot_price,
		@value_date,
		@forward_price,
		@product_id output,
		@implied_rate output,
		@days output


select product_id = @product_id, price_date = @price_date /* TEST */
exec
	r_ratecurvewithdate
		@product_id,
		@price_date,
		@product_rate_id output





