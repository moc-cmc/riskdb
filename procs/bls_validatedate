exec
	r_prevbusinessday
		@trade_date,
		@begin_date output

exec
	r_nextbusinessday
		@begin_date,
		@end_date output

select
	@begin_date = convert(char(8), @begin_date, 112)+" 17:00",
	@end_date = convert(char(8), @end_date, 112)+" 17:00"

select
	msg = "Running for range",
	begin_date = @begin_date,
	end_date = @end_date

create table
	#deals
(
	deal_id int
)

insert into
	#deals
select
	distinct(deal_id)
from
	trades a,
	#run_internal_accounts c,
	#run_external_accounts d,
	#run_traders e,
	#run_counterparties f,
	#run_brokers g,
	#run_strategies h
where
	a.quantity != 0
and
	a.internal_account_id = c.internal_account_id
and
	a.external_account_id = d.external_account_id
and
	a.trader_id = e.trader_id
and
	a.counterparty_id = f.counterparty_id
and
	a.broker_id = g.broker_id
and
	a.strategy_id = h.strategy_id
and
	trade_date >= @begin_date
and
	trade_date < @end_date

create table
	#validation_summary
(
	deal_id int,
	status varchar(25) NULL,
	st int
)

declare
        deal_cursor
cursor for
        select
		deal_id
	from
		#deals
	order by
		deal_id


open deal_cursor
fetch deal_cursor into @next_deal_id

while @@sqlstatus = 0
begin
	select
		@validate = NULL

	exec
		bls_validatedeal
			@deal_id=@next_deal_id,
			@validated=@validate output,
			@debug=@debug

	if @validate = 'y'
	begin
		insert into
			#validation_summary
		values(
			@next_deal_id,
			"Deal Validated",
			1
		)
	end
	else if @validate = NULL
	begin
		insert into
			#validation_summary
		values(
			@next_deal_id,
			"Undetermined status",
			2
		)
	end
        else 
        begin
                insert into
                        #validation_summary
                values(
                        @next_deal_id,
                        "Deal not validated",
                        0
                )
        end

		
	fetch deal_cursor into @next_deal_id
end

close deal_cursor
deallocate deal_cursor

select
	msg="Deal Validation Complete",
	successful_count = (select count(*) from #validation_summary where st = 1),
	issue_count = (select count(*) from #validation_summary where st = 0)
	
	

go
