drop procedure bls_validatedate
go

create procedure
	bls_validatedate
		@login varchar(50),
		@run_name varchar(50)=NULL,
		@trade_date datetime=NULL,
		@deal_id int=NULL,
		@debug char(1)=NULL
	
as

if @debug != NULL
	select
		@debug = lower(@debug)

if @trade_date = NULL
	select
		@trade_date = getdate()

declare @begin_date datetime
declare @end_date datetime
declare @next_deal_id int
declare @run_id int
declare @validate char(1)

select
	@validate = NULL

if @run_name != NULL
begin
	select
        	@run_id = a.run_id
	from
        	runs a,
        	user_runs b,
        	tico_accounts c
	where
        	a.run_id = b.run_id
	and
        	b.tico_account_id = c.account_id
	and
        	c.login = @login
	and
        	a.name = @run_name
	if @@rowcount != 1
	begin
        	select
                	id = -1,
                	error = "Problem finding run with name",
                	run = @run_name
        	return
	end
end

/*
