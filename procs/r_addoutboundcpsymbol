
drop procedure
	r_addoutboundcpsymbol
go


create procedure
	r_addoutboundcpsymbol	
		@login varchar(25),
		@name varchar(50),
		@outbound_source varchar(100),
		@symbol varchar(50)
as

exec
	api_addcounterpartysymbol
			@login=@login,
			@name=@name,
			@symbol=@symbol,
			@source=@outbound_source

exec
	r_mappingoverview
			@login=@login

return

go

