
if object_id("r_futuretradeplfordate") != NULL
    drop procedure
        r_futuretradeplfordate
go

create procedure
	r_futuretradeplfordate
		@contract_id int,
		@quantity numeric(30,2),
		@end_date datetime,
		@trade_price float,
		@current_price float output,
		@p_l float output

		
as

declare @multiplier float
declare @future_type varchar(50)

declare @spot_contract_id int
declare @expiration datetime
declare @days float
declare @spot_price float
declare @give_product_rate float
declare @get_product_rate float



select
	@future_type = a.name,
	@expiration = c.expiration,
	@spot_contract_id = b.forward_id,
	@multiplier = b.quantity
from
	future_types a,
	futures b,
	future_contracts c
where
	a.future_type_id = b.future_type_id
and
	b.future_id = c.future_id
and
	c.contract_id = @contract_id

if @future_type = "Regular"
begin
	exec
		r_priceasof
			@contract_id,
			@end_date,
			@current_price output
end

if @future_type = "Val Date"
begin
	exec
		r_forwardpriceasof
			@spot_contract_id,
			@end_date,
			@expiration,
			@days output,
			@spot_price output,
			@current_price output,
			@give_product_rate output,
			@get_product_rate output
end	

	
select
	@p_l = (@current_price * @quantity * @multiplier) - (@trade_price * @quantity * @multiplier)

return

go
