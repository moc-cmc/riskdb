use
	risk_rcm
go

drop procedure
	er_populateintaccountdays
go

create procedure
	er_populateintaccountdays
		@internal_account varchar(50),
		@trade_date datetime

as

declare @internal_account_id int
declare @external_accounts int
declare @external_account_id int
declare @review_status_id int
declare @external_account_day_id int
declare @trading_day_id int

select
	@trading_day_id = trading_day_id
from
	trading_days
where
	convert(char(11), trade_date, 1) = convert(char(11), @trade_date, 1)
if @@rowcount = 0
begin
	insert into
		trading_days(
			trade_date)
	values(
		convert(datetime, convert(char(11), @trade_date, 1)))
	select
		@trading_day_id = @@identity
end

select
	@review_status_id = status_id
from
	statuses
where
	name = "Review"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Review status not found"
	return
end

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @internal_account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Internal account not found",
		internal_account = @internal_account
	return
end


select
	@external_account_id = 0

select
	@external_accounts = count(*)
from
	external_accounts
where
	internal_account_id = @internal_account_id
and
	external_account_id > @external_account_id


while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		external_accounts
	where
		internal_account_id = @internal_account_id
	and
		external_account_id > @external_account_id

	select
		@external_account_day_id = NULL

	select
		@external_account_day_id = external_account_day_id
	from
		external_account_days
	where
		external_account_id = @external_account_id
	and
		trading_day_id = @trading_day_id
	if @@rowcount != 1
	begin
		insert into
			external_account_days(
				trading_day_id,
				external_account_id,
				status_id)
			values(
				@trading_day_id,
				@external_account_id,
				@review_status_id)
	end
	
	select
		@external_accounts = count(*)
	from
		external_accounts
	where
		internal_account_id = @internal_account_id
	and
		external_account_id > @external_account_id
end



go
