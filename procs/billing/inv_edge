select
        client = "Edgewater "+rtrim(@month)+" "+rtrim(@year)+" - "+rtrim(a.source_name),
        tickets = count(*),
        billable = count(*) * a.per_ticket
from
        #notification_billing a,
        sources b,
        trade_notifications c,
        trades d
where
        a.source_name = b.name
and
        b.source_id = c.source_id
and
        c.trade_id = d.trade_id
and
        d.trade_date >= @begin_date
and
        d.trade_date < @end_date
group by
	a.source_name

