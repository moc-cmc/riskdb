create or replace procedure
	inv_gmoz
		@login varchar(50),
		@month varchar(20),
		@year varchar(10)

as 

declare @first_of_month datetime
declare @last_of_month datetime
declare @first_biz_day datetime
declare @last_biz_day datetime
declare @begin_date datetime
declare @end_date datetime
declare @begin_date_eod datetime
declare @end_date_eod datetime

exec
	r_firstandlastdayofmonth
                @month=@month,
                @year=@year,
		@first_of_month=@first_of_month output,
		@last_of_month=@last_of_month output,
		@first_biz_day=@first_biz_day output,
		@last_biz_day=@last_biz_day output


select
	first_of_month = @first_of_month,
	last_of_month = @last_of_month,
	first_biz_day = @first_biz_day,
	last_biz_day = @last_biz_day

declare @total_volume numeric(30, 4)	
declare @monthly_min numeric(20, 4)	
declare @minimum_adjustment numeric(20, 4)	
declare @invoice_amount numeric(20, 4)	
declare @tier1 numeric(30, 4)
declare @tier2 numeric(30, 4)
declare @tier3 numeric(30, 4)
declare @per_ticket_1 numeric(30, 10)
declare @per_ticket_2 numeric(30, 10)
declare @per_ticket_3 numeric(30, 10)
declare @band_1 int
declare @band_2 int
declare @band_3 int
declare @message varchar(100)
declare @aggregate_count int
declare @component_count int
declare @reg_count int
declare @aggregated_status_id int
declare @total_tickets int
declare @billed_ticket numeric(30, 10)



select
	@monthly_min = 8000,
	@per_ticket_1 = 0.01,
	@band_1 = 500000,
	@per_ticket_2 = 0.005,
	@band_2 = 1000000,
	@per_ticket_3 = 0.0025
select
	monthly_min = @monthly_min,
	per_ticket_1 = @per_ticket_1,
	band_1 = @band_1,
	per_ticket_2 = @per_ticket_2,
	band_2 = @band_2,
	per_ticket_3 = @per_ticket_3


exec
	r_prevbusinessday
		@first_biz_day,
		@begin_date output
exec
	r_nextbusinessday
		@last_biz_day,
		@end_date output

select
	@begin_date_eod = convert(varchar(8), @begin_date, 112)+" 17:00",
	@end_date_eod = convert(varchar(8), @last_biz_day, 112)+" 17:00"


select
	@reg_count = count(*)
from
	trades a
where
	a.trade_date >= @begin_date_eod
and
	a.trade_date < @end_date_eod


if @reg_count <= @band_1
begin
	select
		@tier1 = @reg_count * @per_ticket_1,
		@tier2 = 0,
		@tier3 = 0
end
if @reg_count > @band_1 and @reg_count <= @band_2
begin
	select
		@tier1 = @reg_count * @per_ticket_1
	select
		@tier2 = (@reg_count - @band_1) * @per_ticket_2,
		@tier3 = 0
end
if @reg_count > @band_2
begin
	select
		@tier1 = @reg_count * @per_ticket_1
	select
		@tier2 = (@reg_count - @band_1) * @per_ticket_2
	select
		@tier3 = (@reg_count - @band_1 - @band_2) * @per_ticket_3
end

select
	@billed_ticket = @tier1 + @tier2 + @tier3
select
	@invoice_amount = @monthly_min + @billed_ticket
	

select
	@message = "$0.01,$0.005,$0.0025 <500k,<1M,>1M "+rtrim(convert(varchar(10), @reg_count))+ " trades " + rtrim(convert(varchar(10), @tier1)) +" + "+ rtrim(convert(varchar(10), @tier2)) +" + "+ rtrim(convert(varchar(10), @tier3)) +" = total "+rtrim(convert(varchar(10), @billed_ticket))

select
	client = "GMO ZCOM "+rtrim(@month)+" "+rtrim(@year),
	invoice_amount = @invoice_amount, 
	billed_ticket = @billed_ticket, 
	monthly_min = @monthly_min, 
	message = @message

go
