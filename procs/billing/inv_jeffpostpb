create or replace procedure
	inv_jeffpostpb
		@login varchar(50),
		@month varchar(20),
		@year varchar(10)

as 

declare @first_of_month datetime
declare @last_of_month datetime
declare @first_biz_day datetime
declare @last_biz_day datetime
declare @begin_date datetime
declare @end_date datetime
declare @begin_date_eod datetime
declare @end_date_eod datetime

exec
	r_firstandlastdayofmonth
                @month=@month,
                @year=@year,
		@first_of_month=@first_of_month output,
		@last_of_month=@last_of_month output,
		@first_biz_day=@first_biz_day output,
		@last_biz_day=@last_biz_day output


select
	first_of_month = @first_of_month,
	last_of_month = @last_of_month,
	first_biz_day = @first_biz_day,
	last_biz_day = @last_biz_day

declare @total_volume numeric(30, 4)	
declare @monthly_min numeric(20, 4)	
declare @minimum_adjustment numeric(20, 4)	
declare @invoice_amount numeric(20, 4)	
declare @tier2 float
declare @per_ticket float
declare @message varchar(100)
declare @aggregate_count int
declare @component_count int
declare @reg_count int
declare @aggregated_status_id int
declare @total_tickets int
declare @total_ftp_reports int
declare @ftp_reports float
declare @per_ftp_report float


select
	@monthly_min = 9500,
	@per_ticket = 0.005,
	@per_ftp_report = 0.10


exec
	r_prevbusinessday
		@first_biz_day,
		@begin_date output
exec
	r_nextbusinessday
		@last_biz_day,
		@end_date output

exec
        r_prevbusinessday
                @end_date,
                @end_date output

select
	@begin_date_eod = convert(varchar(8), @begin_date, 112)+" 17:00",
	@end_date_eod = convert(varchar(8), @end_date, 112)+" 17:00"

select
	begin_date_eod = @begin_date_eod,
	end_date_eod = @end_date_eod
	

select 
	@component_count = count(*)
from
	aggregated_trades
where
	trade_date >= @begin_date_eod
and
	trade_date < @end_date_eod
	

select
	@aggregate_count = count(*)
from
	trades a,
	brokers b
where
	a.broker_id = b.broker_id
and
	a.trade_date >= @begin_date_eod
and
	a.trade_date < @end_date_eod
and
	b.symbol in("Netlink PB", "Netlink EB")


select
	@reg_count = count(*)
from
	trades a,
	brokers b
where
	a.broker_id = b.broker_id
and
	a.trade_date >= @begin_date_eod
and
	a.trade_date < @end_date_eod
and
	b.symbol not in("Netlink PB", "Netlink EB")


select
	@total_ftp_reports = count(*),
	@ftp_reports = count(*) * @per_ftp_report
from
	filedrop_report_logs a,
	filedrop_destinations b
where
	a.filedrop_destination_id= b.filedrop_destination_id
and
	b.name = "FXL FTP"
and
	a.capture_date >= @begin_date_eod
and
	a.capture_date < @end_date_eod

select
	@total_tickets = @aggregate_count + @component_count + @reg_count
select
	@tier2 = (@total_tickets) * @per_ticket
select
	@invoice_amount = @monthly_min + @tier2

select
	@message = "$0.005 per ticket. "+rtrim(convert(varchar(10), @aggregate_count))+ " aggs " + rtrim(convert(varchar(10), @component_count)) +" components "+ rtrim(convert(varchar(10), @reg_count)) +" non-aggs = total "+rtrim(convert(varchar(10), @total_tickets))

select
	client = "Jeff "+rtrim(@month)+" "+rtrim(@year),
	invoice_amount = @invoice_amount, 
	billed_ticket = @tier2, 
	monthly_min = @monthly_min, 
	message = @message
	/*per_mio = @per_mio,
	first_biz_day = @first_biz_day, 
	last_biz_day = @last_biz_day*/

select
        client = "Jeff "+rtrim(@month)+" "+rtrim(@year) + " File SFTP REQ10501",
        invoice_amount = @ftp_reports,
        monthly_min = 0.00,
        message = "$0.10 per report. "+rtrim(convert(varchar(10), @total_ftp_reports))+ " reports to FXL FTP" ,
	begin_date = @begin_date_eod,
	end_date= @end_date_eod


go
