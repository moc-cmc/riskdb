create or replace procedure
	inv_instinet
		@login varchar(50),
		@month varchar(20),
		@year varchar(10)

as 

declare @first_of_month datetime
declare @last_of_month datetime
declare @first_biz_day datetime
declare @last_biz_day datetime

exec
	r_firstandlastdayofmonth
                @month=@month,
                @year=@year,
		@first_of_month=@first_of_month output,
		@last_of_month=@last_of_month output,
		@first_biz_day=@first_biz_day output,
		@last_biz_day=@last_biz_day output

/*
select
	first_of_month = @first_of_month
	last_of_month = @last_of_month
	first_biz_day = @first_biz_day
	last_biz_day = @last_biz_day
*/

declare @spotfwd_volume numeric(30, 4)	
declare @swap_volume numeric(30, 4)	
declare @monthly_min numeric(20, 4)	
declare @minimum_adjustment numeric(20, 4)	
declare @invoice_amount numeric(20, 4)	
declare @tier1 float
declare @tier2 float
declare @tier3 float
declare @swap_tier1 float
declare @per_mio float
declare @message varchar(100)
declare @display_volume varchar(20)
declare @display_swap_volume varchar(20)



select
	@monthly_min = 5000

select 
	@spotfwd_volume = sum(b.volume)
from 
	trade_types a, 
	trade_type_volumes b 
where  
	a.trade_type_id = b.trade_type_id 
and 
	b.volume_date >= convert(date, @first_biz_day)
and 
	b.volume_date <= convert(date, @last_biz_day)
and 
	a.name in("Spot", "Forward")

select  
        @swap_volume = sum(b.volume)
from    
        trade_types a,
        trade_type_volumes b 
where
        a.trade_type_id = b.trade_type_id 
and 
        b.volume_date >= convert(date, @first_biz_day)
and 
        b.volume_date <= convert(date, @last_biz_day)
and 
        a.name in("Swap Far", "Swap Near")



if @spotfwd_volume <= 10000000000 
begin
	select
		@tier1 = (@spotfwd_volume / 1000000.0) * .75,
		@tier2 = 0.00,
		@tier3 = 0.00

end
if @spotfwd_volume > 10000000000 and @spotfwd_volume <= 20000000000
begin
	select
		@tier1 = (@spotfwd_volume / 1000000.0) * .75,
		@tier2 = ((@spotfwd_volume-10000000000) / 1000000.0) * .50,
		@tier3 = 0.00
end
if @spotfwd_volume > 20000000000
begin
	select
		@tier1 = (@spotfwd_volume / 1000000.0) * .75,
		@tier2 = ((@spotfwd_volume-10000000000) / 1000000.0) * .50,
		@tier3 = ((@spotfwd_volume-20000000000) / 1000000.0) * .25
end

if @swap_volume = NULL
begin
	select
		@swap_volume = 0
end

if @swap_volume >= 0
begin
	select
		@swap_tier1 = (@swap_volume / 1000000.0) * .25
end

select
	@display_volume = rtrim(convert(varchar(20), convert(int, round(@spotfwd_volume/1000000.0, 2)))),
	@display_swap_volume = rtrim(convert(varchar(20), convert(int, round(@swap_volume/1000000.0, 2))))
select
	@message = rtrim(@message)+" Spot/fwd volume: "+@display_volume+" mio - Swap Volume: " + @display_swap_volume+" mio  0-10b: $0.75, 10-20b: $0.50, 20b+: $0.25  Swap: $0.25"

select
	@invoice_amount = @monthly_min + @tier1 + @tier2 + @tier3 + @swap_tier1

select
	client = "Instinet "+rtrim(@month)+" "+rtrim(@year),
	invoice_amount = @invoice_amount, 
	variable_volume = @tier1 + @tier2 + @tier3 + @swap_tier1,
	monthly_min = @monthly_min, 
	message = @message
	/*per_mio = @per_mio,
	first_biz_day = @first_biz_day, 
	last_biz_day = @last_biz_day*/


go
