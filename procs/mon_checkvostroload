
drop procedure mon_checkvostroload 
go

create procedure
	mon_checkvostroload	

as

declare @source_id int
declare @weekday varchar(12)
declare @max_value_date datetime


select
        @source_id=source_id
from
        sources
where
        name="Spectrum"

if @@rowcount != 1
begin
        select
                Status="Error",
                msg="Could not locate source Spectrum in database"
        return
end

select
        @weekday = datename(weekday, getdate())

if (@weekday = 'Saturday' or @weekday = 'Sunday')
begin
        return
end

select
	@max_value_date=max(value_date)
from
	source_ladder
where
	source_id=@source_id


if not exists (select external_balance_id from external_balances where convert(date, balance_date) = convert(date, @max_value_date))
begin
	select
		Status = "Failed",
		message = "Vostro balances did not load"
	return
end

select
	Status = "Ok",
	message = "Vostro balances loaded"

go

