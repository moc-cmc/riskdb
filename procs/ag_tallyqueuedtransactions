drop procedure
	ag_tallyqueuedtransactions
go

create procedure
	ag_tallyqueuedtransactions
		@login varchar(50),
		@batch_id int

as


declare @queued_transaction_id int
declare @queued_transactions int
declare @entered_by int
declare @external_account_id int
declare @transaction_type_id int
declare @transaction_date datetime
declare @currency_id int
declare @amount float 
declare @note varchar(255)
declare @account_transaction_id int
declare @currency varchar(50)
declare @account varchar(50)

select
	@queued_transaction_id = 0

select
	@queued_transactions = count(*)
from
	queued_transactions
where
	batch_id = @batch_id
and
	queued_transaction_id > @queued_transaction_id

while @queued_transactions > 0
begin
	select
		@queued_transaction_id = min(queued_transaction_id)
	from
		queued_transactions
	where
		queued_transaction_id > @queued_transaction_id
	and
		batch_id = @batch_id

	select
		@entered_by = NULL,
		@external_account_id = NULL,
		@transaction_type_id = NULL,
		@transaction_date = NULL,
		@currency_id = NULL,
		@amount = NULL,
		@note = NULL,
		@account_transaction_id = NULL

	select
		@entered_by = entered_by,
		@external_account_id = external_account_id,
		@transaction_type_id = transaction_type_id,
		@transaction_date = transaction_date,
		@currency_id = currency_id,
		@amount = amount,
		@note = note
	from
		queued_transactions
	where
		queued_transaction_id = @queued_transaction_id

	/* chriso: Removing the duplicate check because we are booking
		multiple account transactions to the same credit_to account.
		Rather than have a dupe check on half of the entries, we'll
		use the commit process to manage fees and ensure it only runs
		once
	select
		@account_transaction_id = account_transaction_id
	from
		account_transactions
	where
		external_account_id = @external_account_id
	and
		currency_id = @currency_id
	and
		transaction_date = @transaction_date
	and
		transaction_type_id = @transaction_type_id
	*/

		
	if @account_transaction_id = NULL
	begin
		if @amount != 0
		begin
			exec
				j_nextkey
					"account_transactions",
					@account_transaction_id output
	
			insert into
				account_transactions(
					account_transaction_id,
					entered_by,
					external_account_id,
					transaction_type_id,
					transaction_date,
					currency_id,
					amount,
					note)
			values(
				@account_transaction_id,
				@entered_by,
				@external_account_id,
				@transaction_type_id,
				@transaction_date,
				@currency_id,
				@amount,
				@note)
		end
	end
	else
	begin
		select
			@currency = symbol
		from
			products
		where
			product_id = @currency_id

		select
			@account = symbol
		from
			external_accounts
		where
			external_account_id = @external_account_id

		select
			status = "Dupe Not Tallied",
			account = @account,
			currency = @currency,
			amount = @amount,
			transaction_date = @transaction_date
	end


	select
		@queued_transactions = count(*)
	from
		queued_transactions
	where
		queued_transaction_id > @queued_transaction_id
	and
		batch_id = @batch_id
end


go


