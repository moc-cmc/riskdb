/*
 * DISPLAY: Show normal output
 * FEATURE: exec fxa_tallymarkettrade
 
  login
- source
  trade_id out
  deal_id out
* tally_type
* deal_type = "Market Forward"
* trade_type
  internal_account
  external_account
* counterparty = "CFS NY"
* quantity
* symbol
* value_date
* price
* trade_date
* trader = "CFE FX"
  strategy
  status
* broker = broker
* identifier
  sales_code
* premium
* prem_settle_date
* pct_price
* spot_reference
* fixing_date
 
 */
select
top 500
    trade_notification_id,
    trade_notification_status,
    source_trade_id = trade_id,
    trade_symbol = trade_symbol,
    target_proc = "fxa_tallynotifiertrade",
    trade_type = case trade_type
        when "S" then "Spot"
        when "F" then "Forward"
        else trade_type
    end,
    deal_type = "Market Forward",
    tally_type = case trade_type
        when "S" then "Spot"
        when "F" then "Forward"
        else trade_type
    end,
    counterparty = @counterparty,
        /* KLS: Always use "CFS NY" as the party external_account */ 
    quantity = -quantity,
    symbol = contract,
    value_date,
    price,
    trade_date,
    trader = @trader,
    broker = @broker,
    identifier = trade_symbol,
    fixing_date
from
    #notify_trades
order by
    trade_id
    
go
