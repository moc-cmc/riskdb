
if object_id("mc_setcurrentextaccountutil") != NULL
    drop procedure
        mc_setcurrentextaccountutil
go

create procedure
    mc_setcurrentextaccountutil
        @external_account_id int,
        @external_account varchar(50),
        @nop float,
        @dsl float
as

declare @now_date datetime

select
    @now_date = getdate()

if @external_account_id = NULL and @external_account != NULL
begin
  
    select
        @external_account_id = external_account_id
    from
        external_accounts
    where
        symbol = @external_account
  
end

if @external_account_id = NULL
begin
    
    select
        status = "Error",
        message = "No external account provided",
        external_account_id = @external_account_id,
        external_account = @external_account
    
end

update
    current_ext_account_utils
set
    nop = @nop,
    dsl = @dsl
where
    external_account_id = @external_account_id

if @@rowcount = 0
begin
    
    insert into
        current_ext_account_utils (
            external_account_id,
            date,
            dsl,
            nop
        )
    values (
        @external_account_id,
        @now_date,
        @dsl,
        @nop
    )
    
end

go
