create or replace procedure
	api_notifytradestradedate
		@login varchar(50),
		@run_name varchar(50),
		@trade_d varchar(50)=NULL,
		@query_spot char(1)=NULL,
		@query_forwards char(1)=NULL,
		@query_options char(1)=NULL,
		@query_exotics char(1)=NULL,
		@format_swaps char(1)=NULL,
		@source varchar(50)=NULL
as


declare @source_id int
declare @cancelled_count int
declare @traiana_id_prefix varchar(15)
declare @netlink_broker_id int
declare @boa_pb_id int
declare @manual_tally_broker_id int
declare @min_trade_id int
declare @run_id int
declare @begin_date datetime
declare @end_date datetime
declare @trade_date datetime

if rtrim(@trade_d) in("", NULL)
begin
	select
		@trade_date = NULL
end
else
begin
	select
		@trade_date = convert(datetime, @trade_d)
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)

insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties





select
        @netlink_broker_id = broker_id
from
        brokers
where
        symbol = "Netlink"

select
        @manual_tally_broker_id = broker_id
from
        brokers
where
        symbol = "MPT Tally"

if @source !=  NULL
begin
	select
		@source_id = source_id
	from
		sources
	where
		name = @source
	begin
		select
			id = -1,
			error = "Source not found",
			source = @source
		return
	end
end

create table
	#trade_types(
		trade_type_id int,
		name varchar(20)
)

/* delete from spot since this we need the instrument license schema for this*/
insert into
	#trade_types
select
	trade_type_id,
	name
from
	trade_types
where
	name in("Forward", "Option", "Swap Near", "Swap Far")
	
	
create table
	#trades(
		trade_id int,
		deal_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		trade_type_detailed varchar(25) NULL,
		deal_type_id int NULL,
		deal_type varchar(25) NULL,
		internal_account_id int,
		internal_account varchar(30) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(15) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
                agency_vs_counterparty varchar(40) NULL,
		fund_agency_trade char(1) NULL,
		fund_agency_buy_sell varchar(8) NULL,
		client_buy_sell varchar(4) NULL,
		broker_id int,
		broker varchar(25) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		ext_account_pb varchar(25) NULL,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity float NULL,
		abs_qty float NULL,
		abs_counter_qty float NULL,
                abs_far_counter_qty float NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date varchar(15) NULL,
		fixing_date varchar(15) NULL,
		db_price float,
		std_price float NULL,
		markup_price float NULL,
		spot_reference float NULL,
		sales_code_id int,
		sales_code varchar(15) NULL,
		strategy_id int,
		strategy varchar(30) NULL,
		identifier varchar(100) NULL,
