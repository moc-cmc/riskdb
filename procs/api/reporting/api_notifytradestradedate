		option_settle_date datetime NULL,
		optcon_exercise_style_id int NULL,
		optcon_exercise_style varchar(10) NULL,
		optcon_strike float NULL,
		optcon_put_call varchar(4) NULL,
                option_expiration_id int NULL,
		optexp_symbol varchar(30) NULL,
		optexp_expiration datetime NULL,
		optexp_timezone_id int NULL,
		optexp_time_zone varchar(30) NULL,
		optexp_tz_symbol varchar(30) NULL,
		optexp_tz_expiration_time varchar(10) NULL,
		optexp_tz_display_value varchar(10) NULL,
		optexp_tz_status int NULL,
		option_id int NULL,
		opt_underlying_contract_id int NULL,
		opt_underlying_contract varchar(10) NULL,
		opt_exchange_id int NULL,
		opt_exchange varchar(20) NULL,
		opt_def_exercise_style_id int NULL,
		opt_def_exercise_style varchar(10) NULL,
		opt_quantity float NULL,
		opt_tick_size float NULL,
		/*- Exotic Info -*/
                e_timing_id int NULL,
                e_timing varchar(12) NULL,
                e_po_ccy_id int NULL, /* payout currency */
		e_po_ccy varchar(3) NULL, /* payout currency */
		e_po_amt float NULL, /* payout amount */
		e_bt_id int NULL, /* barrier type */
		e_bt varchar(15) NULL, /* barrier type */
		e_b float NULL, /* barrier */
		e_lb float NULL, /* lower_barrier */
		e_ub float NULL, /* upper_barrier */
                e_inst_id int NULL, /* instrument type id */
                e_inst varchar (20) NULL, /* instrument type */
                e_ud char(1) NULL, /* up or down */
                e_ws datetime NULL, /* up or down */
                e_we datetime NULL, /* up or down */
                /*  n/a */
		/*- Swap Info -*/
		far_quantity float NULL,
		far_price float NULL,
		far_value_date datetime NULL,
		far_fixing_date datetime NULL,
		far_markup_price float NULL,
                abs_far_qty float NULL,
		swap_symbol varchar(25) NULL,
		cl_or_lp varchar(4) NULL,
		old_qty_if_deleted float NULL,
                client_prime_broker varchar(20) NULL,
                is_ndf char(1) NULL,
		is_inverted_contract char(1) NULL,
		fc varchar(20) NULL,
                product_id int NULL,
		currency_id int NULL,
		counterparty_lei varchar(50) NULL,
		note varchar(200) NULL
		)

/*
| Insert *_ids into #trades that need to be notified 
*/
insert into
	#trades
(
	trade_id,
	deal_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	trader_id,
	counterparty_id,
	fund_agency_trade,
	contract_id,
	broker_id,
	quantity,
	trade_date,
	trade_day,
	value_date,
	fixing_date,
	db_price,
	std_price,
	spot_reference,
	sales_code_id,
	strategy_id,
	identifier,
	trade_status_id,
	abs_qty,
	cl_or_lp,
	abs_counter_qty,
        user_id
)
select 
	trade_id = a.trade_id,
	deal_id = a.deal_id,
	trade_type_id = a.trade_type_id,
	internal_account_id = a.internal_account_id,
	external_account_id = a.external_account_id,
	trader_id = a.trader_id,
	counterparty_id = a.counterparty_id,
        fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	quantity = a.quantity,
	trade_date = a.trade_date,
        trade_day = dbo.f_botradedate(a.trade_date),
	value_date = convert(varchar(12), a.value_date, 112),
	fixing_date = convert(varchar(12), a.fixing_date, 112),
	db_price = a.price,
	std_price = a.price,
	spot_reference = a.spot_reference,
	sales_code_id = a.sales_code_id,
	strategy_id = a.strategy_id,
	identifier = a.identifier,
	trade_status_id = a.status_id,
	abs_qty = abs(a.quantity),
	cl_or_lp = "LP",
	abs_counter_qty = round(abs(a.quantity) * a.price, 2),
        user_id = a.user_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	#trade_types h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_type_id = h.trade_type_id
and
	a.price != 0
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

create unique nonclustered index
        tmp_tid
on
        #trades(trade_id)

select
	@min_trade_id = min(trade_id)
from
	#trades

create table 
	#trade_edits
(
	trade_id int,
	quantity numeric(30, 2),
        price float,
	timestamp datetime
)
insert into
	#trade_edits
select
	b.trade_id,
	b.quantity,
	b.price,
	b.timestamp
from
	#trades a,
	trade_edits b
where
	a.trade_id = b.trade_id
and
	b.trade_id >= @min_trade_id
if @@rowcount > 0
begin
	/* chriso: on cancel, this allows us to get the qty prior to edit. there may have been multiple edits
		   to avoid a loop, doing the below subquery */
	update
		#trades
	set
		quantity = b.quantity,
		abs_qty = abs(b.quantity),
		abs_counter_qty = abs(b.quantity) * b.price
	from
		#trades a,
		#trade_edits b
	where
		a.trade_id = b.trade_id
	and
		b.timestamp = (select max(c.timestamp) from #trade_edits c where c.trade_id = b.trade_id)
end


/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    std_price = case 
        when d.name = "Inverted" and c.factor != NULL and a.db_price != 0 then
            (1 / a.db_price) * c.factor * d.factor
        when d.name = "Inverted" and a.db_price != 0 then
            (1 / a.db_price) * d.factor
        when c.factor != NULL then
            a.db_price * c.factor * d.factor
        else
            a.db_price * d.factor
    end
from
    #trades a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id

if @format_swaps = "Y"
begin

	create table
		#swap_symbol_trades(
			trade_id int,
			swap_symbol varchar(50))
	insert into
		#swap_symbol_trades
	select
		a.trade_id,
		c.symbol
	from
		#trades a,
		swap_symbol_trades b,
		swap_symbols c
	where
		a.trade_id = b.trade_id
	and
		b.swap_symbol_id = c.swap_symbol_id
	and
		b.trade_id >= @min_trade_id
        

	create table
        	#near_swap_trades(
                	trade_id int,
                	swap_symbol varchar(50))
	create table
        	#far_swap_trades(
                	trade_id int,
                	swap_symbol varchar(50),
                	far_quantity float,
			far_price float,
			far_value_date datetime,
			far_fixing_date datetime NULL,
			near_trade_id int NULL,
			external_account_id int,
			far_db_price float)
	insert into
        	#near_swap_trades
	select
        	a.trade_id,
        	c.symbol
	from
        	#trades a,
        	#swap_symbol_trades b,
        	swap_symbols c,
        	trade_types d
	where
        	a.trade_id = b.trade_id
	and
        	b.swap_symbol = c.symbol
	and
		a.trade_type_id = d.trade_type_id
	and
        	d.name = "Swap Near"

	
	insert into
        	#far_swap_trades
	select
        	a.trade_id,
        	c.symbol,
		a.abs_qty,
		a.std_price,
		a.value_date,
		a.fixing_date,
		NULL,
		a.external_account_id,
		a.db_price
	from
        	#trades a,
        	#swap_symbol_trades b,
        	swap_symbols c,
		trade_types d
	where
        	a.trade_id = b.trade_id
	and
        	b.swap_symbol = c.symbol
	and
		a.trade_type_id = d.trade_type_id
	and
        	d.name = "Swap Far"

	update
		#far_swap_trades
	set
		near_trade_id = a.trade_id
	from
		#near_swap_trades a,
		#far_swap_trades b
	where
		a.swap_symbol = b.swap_symbol

	
	update
        	#trades
	set
        	far_quantity = a.far_quantity,
        	far_price = a.far_price,
        	far_value_date = a.far_value_date,
        	far_fixing_date = a.far_fixing_date,
        	abs_far_qty = abs(a.far_quantity),
                abs_far_counter_qty = round((abs(a.far_quantity) * a.far_db_price), 2)
	from
        	#far_swap_trades a,
        	#trades c
	where
        	a.near_trade_id = c.trade_id
	
	delete from
        	#trades
	from
        	#trades a,
        	#far_swap_trades b
	where
        	a.trade_id = b.trade_id

end
else
begin
	update 
		#trades
	set
		swap_symbol = c.symbol
        from
                #trades a,
                swap_symbol_trades b,
                swap_symbols c
        where
                a.trade_id = b.trade_id
        and
                b.swap_symbol_id = c.swap_symbol_id
	and
                b.trade_id >= @min_trade_id
end
	

update
	#trades
set
	deal_type_id = b.deal_type_id,
	deal_status_id = b.status_id
from
	#trades a,
	deals b
where
	a.deal_id =  b.deal_id

update
	#trades
set
	deal_identifier = b.symbol
from
	#trades a,
	deal_exec_symbols b
where
	a.deal_id =  b.deal_id

update
        #trades
set
        deal_alias = b.alias
from
        #trades a,
        deal_aliases b
where
        a.deal_id =  b.deal_id
and
	b.source_id = @source_id


update
	#trades
set
	deal_type = b.name
from
	#trades a,
	deal_types b
where
	a.deal_type_id = b.deal_type_id

/*
| Query trade_types
*/
update
	#trades
set
	trade_type = b.name
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id

update
        #trades
set
        trm_product = "FX"
where
        trade_type in("Spot", "Forward", "Swap Near", "Swap Far")

if @format_swaps = "Y"
begin
	update
        	#trades
	set
        	trm_product = "SWAP"
	where
        	trade_type in("Swap Near", "Swap Far")
end

update
	#trades
set
	trm_product = "NDF",
	is_ndf = "Y"
where
	fixing_date != NULL


update
        #trades
set
        is_ndf = "N"
where
        fixing_date = NULL
and
	(traded_ccy = "RUB"
or
	counter_ccy = "RUB")


update
        #trades
set
        fc = b.symbol
from
	#trades a,
	fixing_centers b,
	trade_attributes c
where
        a.fixing_date != NULL
and	
	a.trade_id = c.trade_id
and
	b.fixing_center_id = c.fixing_center_id


update
	#trades
set
	trade_type = b.symbol
from
	#trades a,
	trade_type_symbols b
where
	a.trade_type_id = b.trade_type_id
and
	b.source_id = @source_id


/*
| Query internal_accounts
*/

update
	#trades
set
	internal_account = b.symbol
from
	#trades a,
	internal_accounts b
where
	a.internal_account_id = b.internal_account_id

/*
| Query external_accounts
*/

update 
        #trades
set
        external_account = b.symbol,
	allocation = b.symbol,
	external_account_type_id = b.external_account_type_id
from
        #trades a,
        external_accounts b
where
        a.external_account_id = b.external_account_id

update
	#trades 
set
	external_account_type = b.name
from
	#trades a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id

update
	#trades
set
	external_account = b.symbol
from
	#trades a,
	external_account_symbols b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id

update
	#trades
set
	ext_account_pb = b.symbol
from
	#trades a,
	client_give_ups b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id

update
        #trades
set
        client_prime_broker = e.symbol
from
        #trades a,
        client_give_ups  e
where
        a.external_account_id = e.external_account_id
and
        e.source_id = @source_id

update
        #trades
set
        client_prime_broker = e.symbol
from
        #trades a,
        counterparty_give_ups  e
where
        a.counterparty_id = e.counterparty_id
and
        e.source_id = @source_id
and
        client_prime_broker = NULL

	
/*
| Query traders
*/
update
	#trades
set
	trader = b.symbol
from
        #trades a,
        traders b
where
        a.trader_id = b.trader_id

update
        #trades
set
        trader = b.symbol
from
        #trades a,
        trader_symbols b
where
        a.trader_id = b.trader_id
and
        b.source_id = @source_id

/*
| Query counterparties
*/

update
	#trades
set
	counterparty = b.name,
	agency_vs_counterparty = b.name
from
	#trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
        #trades
set
        counterparty = b.symbol,
	agency_vs_counterparty = b.symbol
from
        #trades a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id

update
	#trades
set
	fund_agency_trade = "Y",
	cl_or_lp = "CL",
	agency_vs_counterparty = a.external_account
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#trades
set
	counterparty_lei = b.lei_number
from
	#trades a,
	cpty_regulatory_info b
where
	a.counterparty_id = b.counterparty_id
and
	a.cl_or_lp = "LP"
	

update
        #trades
set
        counterparty_lei = b.lei_number
from
	#trades a,
        account_regulatory_info b
where
        a.external_account_id = b.external_account_id
and
	a.cl_or_lp = "LP"

update
	#trades
set
	fund_agency_buy_sell = "SELL",
        client_buy_sell = "BUY"
where
	quantity < 0

update
        #trades
set
        fund_agency_buy_sell = "BUY",
	client_buy_sell = "SELL"
where
        quantity > 0

if @format_swaps = "Y"
begin
		update
			#trades
		set
			fund_agency_buy_sell = "SELLBUY",
			client_buy_sell = "BUYSELL"
		from
			#trades a,
			trade_types b
		where
			a.trade_type_id = b.trade_type_id
		and
			b.name in("Swap Near" , "Swap Far")
		and
			quantity < 0
	
        	update
                	#trades
        	set
                	fund_agency_buy_sell = "BUYSELL",
                	client_buy_sell = "SELLBUY"
        	from
                	#trades a,
                	trade_types b
        	where
                	a.trade_type_id = b.trade_type_id
        	and
                	b.name in("Swap Near" , "Swap Far")     
        	and
                	quantity > 0
end





