
create or replace procedure
	apiv0_updatetrader
		@user_id int,
		@trader_id int,
		@symbol varchar(50),
		@tico_account_id int,
		@default_strategy_id int,
		@external_account_id int,
		@sales_code_id int
as

declare @orig_tico_account_id int
declare @orig_default_strategy_id int
declare @orig_external_account_id int
declare @orig_sales_code_id int

declare @upd_tico_account_id int
declare @upd_default_strategy_id int
declare @upd_external_account_id int
declare @upd_sales_code_id int

declare @static_action_id int
declare @user_static_action_id int
declare @trader_log_id int

select
 	@orig_tico_account_id = tico_account_id,
	@orig_default_strategy_id = default_strategy_id,
	@orig_external_account_id = external_account_id,
	@orig_sales_code_id = sales_code_id
from
	traders
where
	trader_id = @trader_id

if (@tico_account_id != NULL and @tico_account_id != @orig_tico_account_id)
begin
	select
		@upd_tico_account_id = @tico_account_id
end
else
begin
		select
			@upd_tico_account_id = @orig_tico_account_id
end

if (@default_strategy_id != NULL and @default_strategy_id != @orig_default_strategy_id)
begin
        select  
                @upd_default_strategy_id = @default_strategy_id
end     
else    
begin   
                select
                        @upd_default_strategy_id = @orig_default_strategy_id 
end

if (@external_account_id != NULL and @external_account_id != @orig_external_account_id)
begin
        select  
                @upd_external_account_id = @external_account_id
end     
else    
begin   
                select
                        @upd_external_account_id = @orig_external_account_id
end

if (@sales_code_id != NULL and @sales_code_id != @orig_sales_code_id)
begin
        select  
                @upd_sales_code_id = @sales_code_id
end     
else    
begin   
                select
                        @upd_sales_code_id = @orig_sales_code_id
end

select
        @static_action_id = static_action_id
from
        static_actions
where
        name="Edit"

if @static_action_id = NULL
begin
        select
                status = "Error",
                message = "Static Action for Edit does not exist "
        return
end

exec 
        j_nextkey
                "trader_log",
                @trader_log_id output

exec
        j_nextkey
                "user_static_actions",
                @user_static_action_id output

begin tran

	update
		traders
	set
		tico_account_id=@upd_tico_account_id,
		default_strategy_id=@upd_default_strategy_id,
		external_account_id=@upd_external_account_id,
		sales_code_id=@upd_sales_code_id
	where
		trader_id=@trader_id

	if @@rowcount != 1
	begin
		select
			status="Error",
			message="Problem updating trader for symbol " + @symbol
		
		rollback tran
		return
	end

	insert into
		user_static_actions (
			user_static_action_id,
			user_id,
			static_action_id,
			table_name,
			timestamp)
	values(
		@user_static_action_id,
		@user_id,
		@static_action_id,
		"traders",
		getdate())      
        
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding user static action "
                
		rollback tran
		return
	end	

	insert into 
		trader_log (
			trader_log_id,
			user_static_action_id,
			trader_id,
			symbol,
			tico_account_id,
			default_strategy_id,
			external_account_id,
			sales_code_id)
	values(
		@trader_log_id,
		@user_static_action_id,
		@trader_id,
		@symbol,
		@tico_account_id,
		@default_strategy_id,
		@external_account_id,
		@sales_code_id)

	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem inserting trader log " + @symbol 
        
		rollback tran
		return
	end

commit tran

select
	status = "Success",
	message = "Trader updated " + @symbol

return

go	
