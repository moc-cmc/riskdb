create or replace procedure
	apiv0_queryaccounts
		@login varchar(50),
		@account_type varchar(50)=NULL,
		@clearing_entity varchar(50)=NULL
as

declare @tico_account_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

create table
	#external_accounts(
		external_account_id int,
		country varchar(50) NULL,
		branch_location varchar(50) NULL,
		corporate_sector varchar(50) NULL,
		party_region varchar(10) NULL,
		financial_juristiction varchar(10) NULL,
		lei_number varchar(50) NULL
)

	
if @account_type = NULL and @clearing_entity = NULL
begin
	insert into
		#external_accounts(external_account_id)
	select
		external_account_id
	from
		external_accounts
end


if @account_type != NULL and @clearing_entity = NULL
begin
	insert into
		#external_accounts(external_account_id)
	select
		a.external_account_id
	from
		external_accounts a,
		external_account_types b
	where
		a.external_account_type_id = b.external_account_type_id
	and
		b.name = @account_type
end


if @account_type = NULL and @clearing_entity != NULL
begin
	insert into
		#external_accounts(external_account_id)
	select
		a.external_account_id
	from
		external_accounts a,
		external_account_prime_brokers b,
		prime_brokers c,
		sources d
	where
		a.external_account_id = b.external_account_id
	and
		b.prime_broker_id = c.prime_broker_id
	and
		c.source_id = d.source_id
	and
		d.name  = @clearing_entity
end


if @account_type != NULL and @clearing_entity != NULL
begin
	insert into
		#external_accounts(external_account_id)
	select
		a.external_account_id
	from
		external_accounts a,
		external_account_prime_brokers b,
		prime_brokers c,
		sources d,
		external_account_types e
	where
		a.external_account_id = b.external_account_id
	and
		b.prime_broker_id = c.prime_broker_id
	and
		c.source_id = d.source_id
	and
		a.external_account_type_id = e.external_account_type_id
	and
		e.name = @account_type
	and
		d.name  = @clearing_entity
end


update 
	#external_accounts
set
	country = b.country,
	branch_location = b.branch_location,
	corporate_sector = b.corporate_sector,
	party_region = b.party_region,
	financial_juristiction = b.financial_juristiction,
	lei_number = b.lei_number
from
	#external_accounts a,
	account_regulatory_info b
where
	a.external_account_id = b.external_account_id
	

select
        symbol = b.symbol,
        name = b.name,
        account_type = c.name,
        evaluation_currency = d.symbol,
        clearing_entity = g.name,
        country = a.country,
        branch_location = a.branch_location,
        corporate_sector = a.corporate_sector,
        party_region = a.party_region,
        financial_juristiction = a.financial_juristiction,
        lei_number = a.lei_number
from
        #external_accounts a,
        external_accounts b,
        external_account_types c,
        products d,
        external_account_prime_brokers e,
        prime_brokers f,
        sources g
where
        a.external_account_id = b.external_account_id
and
        b.external_account_id = e.external_account_id
and
        b.external_account_type_id = c.external_account_type_id
and
        b.evaluation_currency_id = d.product_id
and
        e.prime_broker_id = f.prime_broker_id
and
        f.source_id = g.source_id
		
go
