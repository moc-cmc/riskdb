
create or replace procedure
	apiv0_insertsalescode	
		@user_id int,
		@sales_code varchar(25)
as

declare @sales_code_id int
declare @sales_code_log_id int
declare @static_action_id int
declare @user_static_action_id int

if @sales_code = NULL
begin
	select
		status = "Error",
		message = "Sales Code cannot be NULL "
	return
end

select
	@static_action_id = static_action_id
from
	static_actions
where
	name="Add"

if @static_action_id = NULL
begin
	select
		status = "Error",
		message = "Static Action for Add does not exist "
	return
end

exec
	j_nextkey
		"sales_codes",
		@sales_code_id output

exec 
	j_nextkey
		"sales_code_log",
		@sales_code_log_id output

exec
	j_nextkey
		"user_static_actions",
		@user_static_action_id output
begin tran

	insert into
		sales_codes(
			sales_code_id,
			name)
		values(
			@sales_code_id,
			@sales_code)

	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding sales code for name  " + @sales_code
                
		rollback tran
		return
        end

	insert into
		user_static_actions (
			user_static_action_id,
			user_id,
			static_action_id,
			table_name,
			timestamp)
	values(
		@user_static_action_id,
		@user_id,
		@static_action_id,
		"sales_codes",
		getdate())	
	
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding user static action "
		
		rollback tran
		return
	end

	insert into 
		sales_code_log (
			sales_code_log_id,
			user_static_action_id,
			sales_code_id,
			name)
	values(
		@sales_code_log_id,
		@user_static_action_id,
		@sales_code_id,
		@sales_code)

	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem inserting sales code log " + @sales_code 
	
		rollback tran
		return
	end

commit tran

select
	status = "Success",
	message = "Sales Code added " + @sales_code

return

go

