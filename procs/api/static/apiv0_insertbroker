
create or replace procedure
	apiv0_insertbroker	
		@user_id int,
		@broker varchar(25),
		@source_id int
as

declare @broker_id int
declare @brokers_log_id int
declare @static_action_id int
declare @user_static_action_id int

if @broker = NULL
begin
	select
		status = "Error",
		message = "Broker cannot be NULL "
	return
end

select
	@static_action_id = static_action_id
from
	static_actions
where
	name="Add"

if @static_action_id = NULL
begin
	select
		status = "Error",
		message = "Static Action for Add does not exist "
	return
end

exec
	j_nextkey
		"brokers",
		@broker_id output

exec 
	j_nextkey
		"brokers_log",
		@brokers_log_id output

exec
	j_nextkey
		"user_static_actions",
		@user_static_action_id output
begin tran

	insert into
		brokers(
			broker_id,
			symbol,
			source_id)
		values(
			@broker_id,
			@broker,
			@source_id)

	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding broker for name  " + @broker
                
		rollback tran
		return
        end

	insert into
		user_static_actions (
			user_static_action_id,
			user_id,
			static_action_id,
			table_name,
			timestamp)
	values(
		@user_static_action_id,
		@user_id,
		@static_action_id,
		"brokers",
		getdate())	
	
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding user static action "
		
		rollback tran
		return
	end

	insert into 
		brokers_log (
			brokers_log_id,
			user_static_action_id,
			broker_id,
			symbol,
			source_id)
	values(
		@brokers_log_id,
		@user_static_action_id,
		@broker_id,
		@broker,
		@source_id)

	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem inserting brokers log " + @broker 
	
		rollback tran
		return
	end

commit tran

select
	status = "Success",
	message = "Broker added " + @broker

return

go

