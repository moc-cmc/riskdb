create or replace procedure
	apiv0_runs	
		@login varchar(50)
as

declare @tico_account_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

create table
	#runs(
		run_id int,
		name varchar(25) NULL
)


insert into
	#runs
		(run_id)
select
	run_id
from
        runs	

update 
	#runs
set
	name = b.name
from
	#runs a,
	runs b
where
	a.run_id = b.run_id
	
select
       	name 
from
	#runs
	
go
