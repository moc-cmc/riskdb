
create or replace procedure
	apiv0_insertcptyinfo
		@user_id int,
		@counterparty_id int,
		@name varchar(50),
		@country varchar(50)=NULL,
		@branch_location varchar(50)=NULL,
		@corporate_sector varchar(50)=NULL,
		@party_region varchar(50)=NULL,
		@financial_jurisdiction varchar(50)=NULL,
                @lei_number varchar(50)=NULL,
		@lei_type varchar(50)=NULL
as

declare @cpty_regulatory_info_id int
declare @cpty_regulatory_info_log_id int
declare @static_action_id int
declare @user_static_action_id int

select
	@static_action_id = static_action_id
from
	static_actions
where
	name="Add"

if @static_action_id = NULL
begin
	select
		status = "Error",
		message = "Static Action for Add does not exist "
	return
end

exec
	j_nextkey
		"cpty_regulatory_info",
		@cpty_regulatory_info_id output

exec 
	j_nextkey
		"cpty_regulatory_info_log",
		@cpty_regulatory_info_log_id  output

exec
	j_nextkey
		"user_static_actions",
		@user_static_action_id output
begin tran

	insert into
		cpty_regulatory_info(
			cpty_regulatory_info_id,
			counterparty_id,
			country,
			branch_location,
			corporate_sector,
			party_region,
			financial_juristiction,
			lei_number,
			lei_type)
		values(
			@cpty_regulatory_info_id,
			@counterparty_id,
			@country,
			@branch_location,
			@corporate_sector,
			@party_region,
			@financial_jurisdiction,
			@lei_number,
			@lei_type)

	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding counterparty regulatory info for counterparty " + @name
                
		rollback tran
		return
        end

	insert into
		user_static_actions (
			user_static_action_id,
			user_id,
			static_action_id,
			table_name,
			timestamp)
	values(
		@user_static_action_id,
		@user_id,
		@static_action_id,
		"cpty_regulatory_info",
		getdate())	
	
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding user static action "
		
		rollback tran
		return
	end

	insert into 
		cpty_regulatory_info_log (
			cpty_regulatory_info_log_id,
			user_static_action_id,
			cpty_regulatory_info_id,
			counterparty_id,
			country,
			branch_location,
			corporate_sector,
			party_region,
		        financial_jurisdiction,
			lei_number,
			lei_type)	
	values(
		@cpty_regulatory_info_log_id,
		@user_static_action_id,
		@cpty_regulatory_info_id,
		@counterparty_id,
		@country,
		@branch_location,
		@corporate_sector,
		@party_region,
		@financial_jurisdiction,
		@lei_number,
		@lei_type)

	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem inserting counterparty regulatory info log " + @name 
	
		rollback tran
		return
	end

commit tran

select
	status = "Success",
	message = "Counterparty info added " + @name

return

go

