drop procedure
	r_deleteaggregatedtrades
go

create procedure r_deleteaggregatedtrades 
		@login varchar(25),
		@trade_id int
as

declare @del_trade_id int
declare @del_deal_id int
declare @uncommitted_status_id int

select
	@uncommitted_status_id=status_id
from
	statuses
where
	name="Uncommitted"

if(@@rowcount != 1)
begin
	select
		err=-1,
		message="Can't find uncommitted status id"
	return
end

declare del_cursor cursor for 
	select
		trade_id,
		deal_id
	from
		aggregated_trades
	where
		aggregate_trade_id=@trade_id
	and
		status_id=@uncommitted_status_id
	order by
		aggregate_trade_id

open del_cursor

fetch del_cursor into @del_trade_id, @del_deal_id

while(@@sqlstatus = 0)
begin

	delete from
			trades
	where
			trade_id=@del_trade_id

	update 
		aggregated_trades
	set
		status_id=1
	where
		trade_id=@del_trade_id

	fetch del_cursor into @del_trade_id, @del_deal_id

end
close del_cursor
deallocate del_cursor

return

go
