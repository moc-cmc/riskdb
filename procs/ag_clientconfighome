drop procedure
	ag_clientconfighome
go

create procedure
	ag_clientconfighome
		@login varchar(50),
		@mc_desktop varchar(100)
as

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)

declare @mc_desktop_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"mc_desktop",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"ti_action",
	"Configure Account MC Override",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"action",
	"Configure MC Desktop Panel",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"panels",
	"Client Configuration",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"add_panel",
	"Add MC Panel",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"add_desktop",
	"Add MC Desktop",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"override_price",
	"Number",
	 "#,##0.00000")

insert into
	#meta
values(
	"Column Format",
	"parity_value",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


select
	@mc_desktop_id = mc_desktop_id
from
	mc_desktops
where
	name = @mc_desktop

create table
	#mc_desktops(
		id int identity,
		style varchar(250) NULL,
		mc_desktop varchar(100),
		panels varchar(50) NULL)
insert into
	#mc_desktops(
		mc_desktop)
select
	name
from
	mc_desktops
order by
	name

update
	#mc_desktops
set
	style = @style,
	panels = "Panels"

update
	#mc_desktops
set
	style = @selected_style
where
	mc_desktop = @mc_desktop

create table
	#desktop_panels(
		id int identity,
		style varchar(250) NULL,
		mc_desktop_id int NULL,
		mc_desktop varchar(50) NULL,
		mc_panel_id int NULL,
		panel varchar(50) NULL,
		included varchar(10) NULL,
		action varchar(20) NULL)

insert into
	#desktop_panels(
		mc_panel_id,
		panel)
select
	mc_panel_id,
	name
from
	mc_panels
order by
	name

update
	#desktop_panels
set
	style = @style,
	action = "Add"

update
	#desktop_panels
set
	mc_desktop_id = @mc_desktop_id,
	mc_desktop = @mc_desktop

update
	#desktop_panels
set
	a.included = "Yes",
	a.action = "Remove"
from
	#desktop_panels a,
	mc_desktop_panels b
where
	a.mc_panel_id = b.mc_panel_id
and
	a.mc_desktop_id = b.mc_desktop_id
	
create table
	#associated_logins(
		id int identity,
		style varchar(250) NULL,
		mc_desktop_id int NULL,
		mc_desktop varchar(100) NULL,
		tico_account_id int NULL,
		login varchar(50) NULL,
		included varchar(10) NULL,
		ti_action varchar(20) NULL)
insert into
	#associated_logins(
		style,
		mc_desktop_id,
		mc_desktop,
		tico_account_id,
		login,
		ti_action)
select
	style = @style,
	mc_desktop_id = @mc_desktop_id,
	mc_desktop = @mc_desktop,
	account_id,
	login,
	ti_action = "Add"
from
	tico_accounts
order by
	login

update
	#associated_logins
set
	included = "Yes",
	ti_action = "Remove"
from
	#associated_logins a,
	mc_desktop_overrides b
where
	a.tico_account_id = b.tico_account_id
and
	a.mc_desktop_id = b.mc_desktop_id


/* Select out final output */

select
	style = @style,
	add_desktop = "Add New Desktop Configuration",
	add_panel = "Add New Panel"

select
	section = "Desktops",
	style,
	mc_desktop,
	desktop = mc_desktop,
	panels
from
	#mc_desktops
order by
	id

select
	section = rtrim(@mc_desktop) + " Panels",
	style,
	mc_desktop,
	panel,
	included,
	action
from
	#desktop_panels
where
	mc_desktop_id != NULL
order by
	id

select
	section = "Associated Login Types",
	style = @style,
	login_type = name
from
	login_types
where
	mc_desktop_id = @mc_desktop_id
and
	mc_desktop_id != NULL
order by
	name

select
	section = "Logins with override access to " + rtrim(@mc_desktop),
	style,
	mc_desktop,
	mc_login = login,
	included,
	ti_action
from
	#associated_logins
where
	mc_desktop_id != NULL
order by
	id



go


