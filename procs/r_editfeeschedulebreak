
if object_id("r_editfeeschedulebreak") != NULL
    drop procedure
        r_editfeeschedulebreak
go

create procedure
	r_editfeeschedulebreak
		@login varchar(50),
		@identifier varchar(50),
		@fsid int,
		@break_name varchar(50),
		@break_description varchar(200),
		@break_period varchar(50),
		@start_level float,
		@end_level float,
		@break_price float,
		@direction int
as

declare @created_by int
declare @created_at datetime
declare @break_period_id int
declare @fee_schedule_break_id int


select
	@fee_schedule_break_id = convert(int, @identifier)

select
	@break_period_id = break_period_id
from
	break_periods
where
	name = @break_period

select
        @created_by = account_id
from
        tico_accounts
where
        login = @login

select
        @created_at = getdate()


if @direction = 0
begin
	delete

	from
		fee_schedule_breaks
	where
		fee_schedule_break_id = @fee_schedule_break_id
end
else
begin
	update
		fee_schedule_breaks
	set
		name = @break_name,
		description = @break_description,
		break_period_id = @break_period_id,
		start_level = @start_level,
		end_level = @end_level,
		break_price = @break_price,
		direction = @direction,
		created_at = @created_at,
		created_by = @created_by
	where
		fee_schedule_break_id = @fee_schedule_break_id
	if @@rowcount = 0
	begin
		
		insert into
			fee_schedule_breaks
		values(
			@fsid,
        		@break_name,
        		@break_description,
			@break_period_id,
        		@start_level,
        		@end_level,
        		@break_price,
        		@direction,
			@created_at,
			@created_by)
	
	end
end
	

exec
	r_viewfeeschedule
                @login

go
