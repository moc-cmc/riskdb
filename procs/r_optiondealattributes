
if object_id("r_optiondealattributes") != NULL
    drop procedure
        r_optiondealattributes
go

create procedure
	r_optiondealattributes
		@login varchar(50),
		@deal_id int,
		@client_user varchar(50) output,
		@client_buys_sells varchar(50) output,
		@client_quantity numeric(30,4) output,
		@biproduct varchar(50) output,
		@timezone varchar(50) output,
		@expiration datetime output,
		@strike numeric(30,6) output,
		@call_put varchar(5) output,
		@client_price float output,
		@client_total_premium float output,
		@client_premium_currency varchar(50) output,
		@client_premium_settle datetime output,
		@counterparty varchar(50) output,
		@market_quantity numeric(30,4) output,
		@buy_sell varchar(10) output,
		@market_price float output,
		@market_total_premium float output,
		@market_premium_currency varchar(50) output,
		@market_premium_settle datetime output,
		@option_settlement datetime output,
		@client_price_format varchar(10) output,
		@client_pct_price float output,
		@market_price_format varchar(10) output,
		@market_pct_price float output,
		@spot_reference float output
		
as

declare @client_trade_id int
declare @market_trade_id int
declare @market_trader_id int
declare @client_trader_id int
declare @market_trader varchar(50)
declare @contract_id int
declare @underlying_contract_id int

select
	@client_user = a.symbol,
	@client_trader_id = a.trader_id
from
	traders a,
	external_accounts b,
	external_account_types c,
	trades d
where
	a.trader_id = d.trader_id
and
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
and
	d.deal_id = @deal_id


select
	@market_trader = a.symbol,
	@market_trader_id = a.trader_id
from
	traders a,
	external_accounts b,
	external_account_types c,
	trades d
where
	a.trader_id = d.trader_id
and
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Counterparty"
and
	d.deal_id = @deal_id

select
	@client_trade_id = min(trade_id)
from
	trades
where
	deal_id = @deal_id
and
	trader_id = @client_trader_id

select
	@market_trade_id = min(trade_id)
from
	trades
where	
	deal_id = @deal_id
and
	trader_id = @market_trader_id

select
	@option_settlement = value_date
from
	trades
where
	trade_id = @client_trade_id
if @option_settlement = NULL
	select
		@option_settlement = value_date
	from
		trades
	where
		trade_id = @market_trade_id


select
	@client_price = price,
	@client_quantity = quantity,
	@contract_id = contract_id,
	@client_pct_price = pct_price,
	@spot_reference = spot_reference
from
	trades
where
	trade_id = @client_trade_id
if @client_pct_price != NULL
begin
	select
		@client_price_format = "Pct"
end
else
begin
	select
		@client_price_format = "Pips"
end

if @spot_reference = NULL
	select
		@spot_reference = spot_reference 
	from
		trades
	where
		trade_id = @market_trade_id

select
	@client_total_premium = a.amount,
	@client_premium_currency = c.symbol,
	@client_premium_settle = a.transaction_date
from
	account_transactions a,
	account_transaction_trades b,
	products c
where
	a.account_transaction_id = b.account_transaction_id
and
	a.currency_id = c.product_id
and
	b.trade_id = @client_trade_id

if @client_quantity < 0
	select
		@client_buys_sells = "Client Buys"

if @client_quantity >= 0
	select
		@client_buys_sells = "Client Sells"


select
	@market_price = a.price,
	@market_quantity = a.quantity,
	@counterparty = b.name,
	@contract_id = a.contract_id,
	@market_pct_price = a.pct_price
from
	trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id
and
	a.trade_id = @market_trade_id

if @market_pct_price != NULL
begin
	select
		@market_price_format = "Pct"
end
else
begin
	select
		@market_price_format = "Pips"
end

if @market_quantity >= 0
	select
		@buy_sell = "Buy"
if @market_quantity < 0
	select
		@buy_sell = "Sell"

select
	@market_total_premium = a.amount,
	@market_premium_currency = c.symbol,
	@market_premium_settle = a.transaction_date
from
	account_transactions a,
	account_transaction_trades b,
	products c
where
	a.account_transaction_id = b.account_transaction_id
and
	a.currency_id = c.product_id
and
	b.trade_id = @market_trade_id


select
	@underlying_contract_id = a.underlying_contract_id,
	@expiration = b.expiration,
	@strike = c.strike,
	@call_put = c.put_call,
	@timezone = d.timezone
from
	options a,
	option_expirations b,
	option_contracts c,
	timezones d
where
	a.option_id = b.option_id
and
	b.option_expiration_id = c.option_expiration_id
and
	b.timezone_id = d.timezone_id
and
	c.contract_id = @contract_id

select
	@biproduct = symbol
from
	contracts
where
	contract_id = @underlying_contract_id


go
