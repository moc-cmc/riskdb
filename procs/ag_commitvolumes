use
	risk_finotec
go

drop procedure
	ag_commitvolumes
go

create procedure
	ag_commitvolumes
		@login varchar(50),
		@trade_date datetime
as

declare @revals int
declare @id int
declare @ids int
declare @account_snapshot_id int
declare @external_account_id int
declare @transaction_type_id int
declare @value float
declare @instrument_id int
declare @instrument varchar(50)
declare @evaluation_currency_id int
declare @begin_date datetime
declare @end_date datetime

declare @fund_id int

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Volume"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Volume transaction type not found"
	return
end



select
	@revals = count(*)
from
	committed_daily_revals
where
	convert(date, bo_trade_date) = convert(date, @trade_date)
if @revals = 0 or @revals = NULL
begin
	select
		status = "Error",
		message = "No revals found for date",
		trade_date = @trade_date
	return
end

create table
	#trades(
		trade_id int,
		contract_id int,
		external_account_id int,
		notional_volume float NULL,
		volume float NULL,
		bo_trade_date datetime NULL,
		native_currency_id int NULL,
		product_id int NULL,
		currency_id int NULL,
		evaluation_contract_id int NULL,
		evaluation_settle float NULL)


/*
 * Find any trades that were done during the range
 */
insert into
	#trades(
		trade_id,
		contract_id,
		external_account_id,
		notional_volume,
		volume,
                bo_trade_date,
		currency_id)
select
	a.trade_id,
	b.contract_id,
	b.external_account_id,
	a.notional_amount,
	a.evaluation_notional,
	a.bo_trade_date,
	@evaluation_currency_id
from
	committed_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	a.value_date >= @begin_date
and
	a.bo_trade_date >= @begin_date
and
	a.bo_trade_date < @end_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.evaluation_currency_id = @evaluation_currency_id



create table
	#net_volumes(
		id int identity,
		external_account_id int,
		volume float)
insert into
	#net_volumes(
		external_account_id,
		volume)
select
	external_account_id,
	sum(volume)
from
	#trades
group by
	external_account_id

select
	@id = 0
select
	@ids = count(*)
from
	#net_volumes
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#net_volumes
	where
		id > @id

	select
		@account_snapshot_id = NULL,
		@external_account_id = NULL,
		@value =NULL

	select
		@external_account_id = external_account_id,
		@value = volume
	from
		#net_volumes
	where
		id = @id

	select
		@account_snapshot_id = account_snapshot_id
	from
		account_snapshots
	where
		external_account_id = @external_account_id
	and
		transaction_type_id = @transaction_type_id
	and
		currency_id = @evaluation_currency_id
	and
		convert(date, snapshot_date) = convert(date, @trade_date)
	if @account_snapshot_id != NULL
	begin
		select
			status = "Error",
			message = "Volume already for committed for date",
			trade_date = @trade_date
	end
	else
	begin
		exec
			j_nextkey
				"account_snapshots",
				@account_snapshot_id output


		insert into
			account_snapshots
		values(
			@account_snapshot_id,
			@external_account_id,
			@transaction_type_id,
			@value,
			@evaluation_currency_id,
			@trade_date,
			NULL)
	end

	select
		@ids = count(*)
	from
		#net_volumes
	where
		id > @id
end




go
