drop procedure
	r_createdistlist
go

create procedure
	r_createdistlist
		@login varchar(50),
		@name varchar(50)

as

declare @tico_account_id int
declare @dist_list_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = -1,
		error = "Problem deterimining login"
	return
end

exec
	j_nextkey
		"dist_lists",
		@dist_list_id output

insert into 
dist_lists
	(dist_list_id, name)
values	(
	@dist_list_id,
	@name
	)

if @@rowcount != 1
begin
        select
                id = -1,
                msg = "Problem creating dist_list",
                dist_list = @name
        return
end

select
        id = 1,
        msg = "Successfully created distribution list",
        dist_list = @name

exec
        r_managedistributionlists
                        @login


go

