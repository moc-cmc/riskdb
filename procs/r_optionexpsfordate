create table
	#strike_ranges(
		underlying_contract_id int,
		min_strike float NULL,
		max_strike float NULL,
		tick_size float NULL,
		current_price float NULL,
		round int NULL)

insert into
	#strike_ranges(
		underlying_contract_id,
		min_strike,
		max_strike)
select
	b.underlying_contract_id,
	min(b.strike),
	max(b.strike)
from
	#net_positions a,
	#option_contracts b
where
	a.contract_id = b.contract_id
group by
	b.underlying_contract_id

update
	#strike_ranges
set
	a.tick_size = b.tick_size
from
	#strike_ranges a,
	options b
where
	a.underlying_contract_id = b.underlying_contract_id

update
	#strike_ranges
set
	a.current_price = b.price
from
	#strike_ranges a,
	current_prices b
where
	a.underlying_contract_id = b.contract_id

/* override if there's a manually set exp price */
update
	#strike_ranges
set
	a.current_price = b.price
from
	#strike_ranges a,
	run_expiration_prices b
where
	a.underlying_contract_id = b.contract_id
and
	b.run_id = @run_id
and
	convert(date, b.expiration) = convert(date, @expiration)

create table
	#strikes(
		underlying_contract_id int,
		strike float)

create table
	#unique_strikes(
		strike float)

select
	@underlying_contract_id = 0
select
	@underlying_contracts = count(*)
from
	#strike_ranges
where
	underlying_contract_id > @underlying_contract_id

while @underlying_contracts > 0
begin
	select
		@underlying_contract_id = min(underlying_contract_id)
	from
		#strike_ranges
	where
		underlying_contract_id > @underlying_contract_id

	select
		@min_strike = NULL,
		@max_strike = NULL,
		@tick_size = NULL,
		@current_price = NULL

	select
		@tick_size = tick_size,
		@current_price = current_price
	from
		#strike_ranges
	where
		underlying_contract_id = @underlying_contract_id


	if @tick_size = .0001
		select
			@round = 4
	if @tick_size = .01
		select
			@round = 2

	select
		@current_price = round(@current_price, @round)

	update
		#strike_ranges
	set
		round = @round
	where
		underlying_contract_id = @underlying_contract_id

	if @min_strike = NULL
		select
			@min_strike = @current_price - (@tick_size * 10.0)
	if @max_strike = NULL
		select
			@max_strike = @current_price + (@tick_size * 10.0)
	
	while @min_strike <= @max_strike
	begin
		insert into
			#strikes
		values(
			@underlying_contract_id,
			@min_strike)
		select
			@min_strike = @min_strike + @tick_size
	end

	truncate table
		#unique_strikes

	insert into
		#unique_strikes
	select
		distinct(b.strike)
	from
		#net_positions a,
		#option_contracts b
	where
		a.contract_id = b.contract_id
	and
		b.underlying_contract_id = @underlying_contract_id


	insert into
		#strikes
	select
		underlying_contract_id = @underlying_contract_id,
		strike
	from
		#unique_strikes
	where
		strike not in(
			select
				strike
			from
				#strikes
			where
				underlying_contract_id = @underlying_contract_id)

	select
		@underlying_contracts = count(underlying_contract_id)
	from
		#strike_ranges
	where
		underlying_contract_id > @underlying_contract_id

end

