create table
	#run_expiration_prices(
		run_id int NULL,
		run_name varchar(50) NULL,
		expiration datetime NULL,
		expiration_date datetime NULL,
		contract_id int,
		price float NULL,
		current_price float NULL,
		delta float NULL,
		set_price varchar(50) NULL,
		refresh varchar(50) NULL
		)
insert into
	#run_expiration_prices(
		contract_id)
select
	distinct(b.underlying_contract_id)
from
	#net_positions a,
	#option_contracts b
where
	a.contract_id = b.contract_id
	
update
	#run_expiration_prices
set
	a.current_price = b.price
from
	#run_expiration_prices a,
	current_prices b
where
	a.contract_id = b.contract_id

update
	#run_expiration_prices
set
	run_id = @run_id,
	run_name = @run_name,
	expiration_date = @expiration,
	expiration = @expiration,
	set_price = "SET",
	refresh = "REFRESH"

select
	@contract_id = 0
select
	@contracts = count(*)
from
	#run_expiration_prices
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#run_expiration_prices
	where
		contract_id > @contract_id

	select
		@price = NULL

	select
		@price = price
	from
		run_expiration_prices
	where
		run_id = @run_id
	and
		contract_id = @contract_id
	and
		expiration = @expiration
	if @price = NULL
	begin
		select
			@price = price
		from
			current_prices
		where
			contract_id = @contract_id
		if @price != NULL
			insert into
				run_expiration_prices
			values(
				@run_id,
				@expiration,
				@contract_id,
				@price)
	end

	/* Mark ITM Calls */
	update
		#option_contracts
	set
		itm_otm = "ITM"
	from
                #option_contracts b,
		option_expirations c,
		options d
	where
		b.option_expiration_id = c.option_expiration_id
	and
		c.option_id = d.option_id
	and
		b.put_call = "C"
	and
		b.strike < @price
	and
		d.underlying_contract_id = @contract_id

	/* Mark ITM Calls at 100 delta */
	update
		#net_positions
	set
		a.delta = a.quantity
	from	
		#net_positions a,
		#option_contracts b
        where
                a.contract_id = b.contract_id
	and
		b.put_call = "C"
	and
		b.itm_otm="ITM"
	/*
	update
		#net_positions
	set
		a.delta = a.quantity 
	from
		#net_positions a,
                #option_contracts b, /* was actual table, now temp table */
	where
		a.contract_id = b.contract_id
	and
		b.option_expiration_id = c.option_expiration_id
	and
		c.option_id = d.option_id
	and
		a.put_call = "C"
	and
		a.strike < @price
	and
		d.underlying_contract_id = @contract_id*/



	/* Mark ITM Puts at -100 delta */
        update
                #option_contracts
        set
                itm_otm = "ITM"
        from
                #option_contracts b,
                option_expirations c,
                options d
        where
                b.option_expiration_id = c.option_expiration_id
        and
                c.option_id = d.option_id
        and
                b.put_call = "P"
        and
                b.strike > @price
        and
                d.underlying_contract_id = @contract_id

        /* Mark ITM Puts at 100 delta */
        update
                #net_positions
        set
                a.delta = a.quantity * -1.0
        from    
                #net_positions a,
                #option_contracts b
        where
                a.contract_id = b.contract_id
	and
                b.put_call = "P"
        and
                b.itm_otm="ITM"



	select
		@contracts = count(*)
	from
		#run_expiration_prices
	where
		contract_id > @contract_id
end

