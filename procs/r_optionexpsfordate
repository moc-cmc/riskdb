/* 
 |  Begin Exercise Logic & Output
 */
declare 
	section_cursor 
cursor for
	select
		distinct(section)
	from
		#grid
	order by
		section

open section_cursor
fetch section_cursor into @grid_section

while @@sqlstatus = 0
begin
/*
	if @auto_create_batch = "Y"
	begin
		exec
			j_nextkey
				"batches",
				@batch_id output
	end
*/

	
	/*if @batch_id = NULL
	begin*/
	
		insert into
			#expiry_output
			(
				section,
				style,
				trade_type_ordering,
				trade_type,
				counterparty_id,
				/*option_contract_id,*/
				contract_id,
				contract,
				quantity,
				value_date
			)
		select
			@grid_section,
			style = "background:rgb(233,241,245);border: 1px solid white",
			trade_type_ordering=100,
			trade_type="Counterparty Aggregate",
                	a.counterparty_id,
                	/*a.contract_id,*/
			a.opt_underlying_contract_id,
			a.underlying,
                	sum(a.quantity),
                	a.value_date
		from
			#option_trades a,
			#distinct_grid b
		where
			a.opt_underlying_contract_id = b.underlying_contract_id
		and
			b.section=@grid_section
		group by
			section,
			a.counterparty_id,
                        /*a.contract_id,*/
                        a.opt_underlying_contract_id,
                        a.value_date
		order by
			a.counterparty_id
	
		insert into 
	                        #expiry_output
                        (
                                section,
				style,
				trade_type_ordering,
                                trade_type,
                                counterparty_id,
				option_contract_id,
				option_contract,
				itm_otm,
                                contract_id,
				contract,
				option_trade_id,
                                quantity,
                                value_date,
				counterparty,
				option_trade_date
                        )
		select
			@grid_section,
			style = "color:gray;background:#FFFFFF;border: 1px solid white",
			trade_type_ordering=1,
			trade_type="Original Trade",
			a.counterparty_id,
			a.contract_id,
			a.contract,
			a.itm_otm,
			a.contract_id,
			a.underlying,
			a.trade_id,
			a.quantity,
			a.value_date,
			a.counterparty,
			a.trade_date
		from
			#option_trades a,
			#distinct_grid b
		where
			b.section= @grid_section
		and
			a.opt_underlying_contract_id = b.underlying_contract_id

                insert into
                                #expiry_output
                        (
                                section,
				style,
				trade_type_ordering,
                                trade_type,
                                counterparty_id,
                                option_contract_id,
                                contract_id,
                                option_trade_id,
                                quantity,
				price,
                                value_date,
                                counterparty
				
                        )
                select
                        @grid_section,
			style = "color:gray;background:#FFFFFF;border: 1px solid white",
			trade_type_ordering=20,
                        trade_type="Option Close Out",
                        a.counterparty_id,
                        a.contract_id,
                        a.contract_id,
                        a.trade_id,
                        a.quantity * -1.0,
			0.00,
                        a.value_date,
                        a.counterparty
                from
                        #option_trades a,
                        #expiry_output b
                where
                        b.section= @grid_section
                and
                        a.trade_id = b.option_trade_id
		and
			b.trade_type = "Original Trade"


                insert into
                                #expiry_output
                        (
                                section,
				style,
				trade_type_ordering,
                                trade_type,
                                counterparty_id,
				option_contract_id,
				option_contract,
				option_trade_date,
                                contract_id,
				contract,
                                option_trade_id,
                                quantity,
                                price,
                                value_date,
                                counterparty,
				exercise_assign,
				percentage,
				edit_percentage,
				action
                        )
                select
                        @grid_section,
			 style="background:#faedee;border: 1px solid white", /* Pinkish */
			/*style="background:background:rgb(233,241,245);border: 1px solid white", /* tico */*/
			trade_type_ordering=30,
                        trade_type="Option Exercise",
                        a.counterparty_id,
                        a.contract_id,
			a.contract,
			a.trade_date,
			a.opt_underlying_contract_id,
			a.underlying,
                        a.trade_id,
                        a.quantity,
                        a.opt_contract_strike,
                        a.opt_settle_date,
                        a.counterparty,
			"",
			"100%",
			"EDIT",
			"EXERCISE"
                from
                        #option_trades a,
                        #expiry_output b
                where
                        b.section= @grid_section
                and
                        a.trade_id = b.option_trade_id
                and
                        b.trade_type = "Original Trade"
		and
			a.itm_otm = "ITM"



                update
                        #expiry_output
                set
			trade_type = "Option Assignment",
                        exercise_assign = "<i>waiting </i>",
                        percentage = "100%",
			edit_percentage = "",
			action=""
                where   
                        section=@grid_section
                and
                        trade_type = "Option Exercise"
                and
                        quantity < 0


                insert into
                        #expiry_output
                        (
                                section,
                                style,
                                trade_type_ordering,
                                trade_type,
                                contract,
                                quantity,
				counterparty
                        )
                select
                        @grid_section,
                        style = "background:rgb(233,241,245);border: 1px solid white",  /* Standard Tico Blue */
                        /* style = "background:#71a8d7;border: 1px solid white", /* Blue */ */
                        trade_type_ordering=100,
                        trade_type="Net Counterparty Delta",
                        a.contract,
                        sum(a.quantity),
			a.counterparty
                from
			#expiry_output a
                where
                        a.section=@grid_section
		and
			a.trade_type in("Option Exercise", "Option Assignment")
                group by
                        section,
			style,
			a.contract,
			a.counterparty


		insert into
			#expiry_output
			(
				section,
				style,
				trade_type_ordering,
				trade_type,
				contract,
				quantity,
				action
			)
		select
			@grid_section,
			/*style = "color:#FFFFFF;background:#000099;border: 1px solid white",*/
			style = "background:#FFFFFF;border: 1px solid white",
			/*style="background:background:rgb(233,241,245);border: 1px solid white", /* tico */*/
			trade_type_ordering = 0,
			trade_type = "Net "+upper(rtrim(a.contract))+ " Delta",
			a.contract,
			sum(a.quantity),
			"PREPARE "+upper(rtrim(a.contract))+ " EXERCISES"
		from
                        #expiry_output a
                where
                        a.section=@grid_section
                and
			 a.trade_type in("Option Exercise", "Option Assignment")
		group by
			section,
			style,
			contract

		
		
	fetch section_cursor into @grid_section
end

close section_cursor
deallocate section_cursor


