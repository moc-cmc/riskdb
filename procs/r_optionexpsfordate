create table
	#longs(
		underlying_contract_id int,
		strike float,
		call_quantity numeric(30,4) NULL,
		put_quantity numeric(30,4) NULL)
insert into
	#longs
(
        underlying_contract_id,
	strike,
        call_quantity
)
select
	underlying_contract_id,
	strike,
	sum(quantity)
from
	#net_positions
where
	quantity > 0
and
	put_call = "C"
group by
	underlying_contract_id,
	strike

update 
	#longs
set
	put_quantity = sum(a.quantity)
from
	#net_positions a,
	#longs b
where
	a.underlying_contract_id = b.underlying_contract_id 
and
	a.strike = b.strike
and
        quantity > 0
and
        put_call = "P"

insert into
        #longs
(
	underlying_contract_id,
	strike,
	put_quantity
)
select
        underlying_contract_id,
	strike,
        sum(quantity)
from
        #net_positions
where
        quantity > 0
and
        put_call = "P"
and
	strike not in(select strike from #longs)
group by
        underlying_contract_id,
	strike

