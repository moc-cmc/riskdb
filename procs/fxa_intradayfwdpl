        fxa_intradayfwdpl
go

create procedure
	fxa_intradayfwdpl
		@login char(100)
as

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)

if db_name() = "risk_jeff"
begin
	insert into
		#links
	values(
		"Column Link",
		"run_name",
		"FX Ladder PL",
		NULL,
		NULL)
end
else
begin
	insert into
		#links
	values(
		"Column Link",
		"run_name",
		"FWD P&L",
		NULL,
		NULL)
end

select * from #links

select
	run_name = a.name 
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
order by
	name

