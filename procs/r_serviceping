drop procedure r_serviceping
go

create procedure
	r_serviceping
		@name varchar(50),
		@host varchar(25)=NULL,
		@threshold int=NULL

as

declare @service_id int

if @threshold = NULL
	select
		@threshold = 120

update
	service_updates
set
	last_update = getdate()
where
	name = @name
if @@rowcount != 1
begin
	exec 
		j_nextkey 
			"service_updates",
			@service_id output
	
	insert into
		service_updates(
			service_id,
			name,
			host,
			last_update,
			ping_threshold
		)
	values(
		@service_id,
		@name,
		@host,
		getdate(),
		@threshold
	)
end

go
