	*
from
	#meta

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found for fund"
	return
end

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id


if @as_of_date = NULL
begin
	select
		@as_of_date = getdate()
end

exec
	r_daterangefordate
		@as_of_date,
		@begin_date output,
		@end_date output


