create table
	#trades(
		trade_id int,
		trade_date datetime,
		contract_id int,
		quantity numeric(30,4),
		value_date datetime,
		price float,
		contract_size int NULL,
		product_id int NULL,
		dealt_amount  numeric(30,4) NULL,
		currency_id int NULL,
		counter_amount numeric(30,4) NULL,
		counter_exposure numeric(30,4) NULL,
		option_unit_delta float NULL,
		forward_id int NULL,
		spot_price float NULL,
		forward_price float NULL)

insert into
	#trades(
		trade_id,
		trade_date,
		contract_id,
		quantity,
		value_date,
		price)
select
	a.trade_id,
	a.trade_date,
	a.contract_id,
	a.quantity,
	a.value_date,
	a.price
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#brokers e,
	#strategies f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.broker_id = e.broker_id
and
	a.strategy_id = f.strategy_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date < @end_date
and
	a.value_date >= @begin_date

	
/* Forward Contract Specs */
update
	#trades
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id,
	a.contract_size = b.quantity,
	a.forward_id = b.contract_id,
	a.option_unit_delta = 1.0
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

/* Forward Option Contract Specs */
update
	#trades
set
	a.product_id = e.product_id,
	a.currency_id = e.currency_id,
	a.contract_size = e.quantity * d.quantity,
	a.forward_id = e.contract_id
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id

/* Futures contract specs */
update
	#trades
set
	a.product_id = d.product_id,
	a.currency_id = d.currency_id,
	a.contract_size = c.quantity,
	a.forward_id = d.contract_id,
	a.option_unit_delta = 1.0
from
	#trades a,
	future_contracts b,
	futures c,
	forwards d
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id
and
	c.forward_id = d.contract_id

/* Futures options contract specs */
update
	#trades
set
	a.product_id = g.product_id,
	a.currency_id = g.currency_id,
	a.contract_size = d.quantity * f.quantity * g.quantity,
	a.forward_id = g.contract_id
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f,
	forwards g	
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.future_id = f.future_id
and
	f.forward_id = g.contract_id


update
	#trades
set
	dealt_amount = quantity * contract_size
	
update
	#trades
set
	a.option_unit_delta = b.delta
from
	#trades a,
	contract_tvs b
where
	a.contract_id = b.contract_id
and
	b.tv_date = @end_date

update
	#trades
set
	a.option_unit_delta = b.delta
from
	#trades a,
	current_contract_tvs b
where
	a.contract_id = b.contract_id
and
	a.option_unit_delta = NULL
	
update
	#trades
set
	a.spot_price = c.price
from
	#trades a,
	forwards b,
	prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	c.price_date = @end_date


update
	#trades
set
	a.spot_price = 1.0 / c.price
from
	#trades a,
	forwards b,
	prices c
where
	a.currency_id = b.product_id
and
	a.product_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	c.price_date = @end_date



update
	#trades
set
	a.spot_price = c.price
from
	#trades a,
	forwards b,
	current_prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	a.spot_price = NULL

update
	#trades
set
	a.spot_price = 1.0 / c.price
from
	#trades a,
	forwards b,
	current_prices c
where
	a.currency_id = b.product_id
and
	a.product_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	a.spot_price = NULL


create table
	#forward_prices(
		trade_id int,
		forward_id int,
		value_date datetime,
		price float NULL)
insert into
	#forward_prices(
		trade_id,
		forward_id,
		value_date)
select
	trade_id = max(trade_id),
	forward_id,
	value_date
from
	#trades
group by
	forward_id,
	value_date

select
	@trade_id = 0
select
	@trades = count(*)
from
	#forward_prices
where
	trade_id > @trade_id
while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#forward_prices
	where
		trade_id > @trade_id

	select
		@contract_id = forward_id,
		@value_date = value_date
	from
		#forward_prices
	where
		trade_id = @trade_id

	select
		@days = NULL,
		@spot_price = NULL,
		@forward_price = NULL,
		@currency_rate = NULL,
		@product_rate = NULL
	


	exec
		r_forwardpriceasof
			@contract_id,
			@end_date,
			@value_date,
			@days output,
			@spot_price output,
			@forward_price output,
			@currency_rate output,
			@product_rate output

	update
		#forward_prices
	set
		price = @forward_price
	where
		trade_id = @trade_id

	select
		@trades = count(*)
	from
		#forward_prices
	where
		trade_id > @trade_id
end


update
	#trades
set
	a.forward_price = b.price
from
	#trades a,
	#forward_prices b
where
	a.forward_id = b.forward_id
and
	a.value_date = b.value_date

update
	#trades
set
	dealt_amount = dealt_amount * option_unit_delta,
	counter_amount = dealt_amount * option_unit_delta * forward_price * -1.0

/* Counter exposure = counter amount for all forwards  and forward options*/
update
	#trades
set
	a.counter_exposure = a.counter_amount
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#trades
set
	a.counter_exposure = a.counter_amount
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id


/*
 * Default futures and futures options counter exposure to zero then
 * override for cases
 */
update
	#trades
set
	a.counter_exposure = 0.0
from
	#trades a,
	future_contracts b
where
	a.contract_id = b.contract_id

update
	#trades
set
	a.counter_exposure = 0.0
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id

/*
 * Counter exposure = counter amount for futures if it's a currency future
 * or an option on a currency future.
 */
update
	#trades
set
	a.counter_exposure = a.counter_amount
from
	#trades a,
	future_contracts b,
	products c,
	product_types d
where
	a.contract_id = b.contract_id
and
	a.product_id = c.product_id
and
	c.product_type_id = d.product_type_id
and
	d.name = "Currency"

update
	#trades
set
	a.counter_exposure = a.counter_amount
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	products f,
	product_types g
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	a.product_id = f.product_id
and
	f.product_type_id = g.product_type_id
and
	g.name = "Currency"


/*
 * Counter exposure = counter amount for futures (and options on futures)if 
 * the base currency of the future isn't the evaluation currency
 */
update
	#trades
set
	a.counter_exposure = a.counter_amount
from
	#trades a,
	future_contracts b
where
	a.contract_id = b.contract_id
and
	a.currency_id != @evaluation_currency_id

update
	#trades
set
	a.counter_exposure = a.counter_amount
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	a.currency_id != @evaluation_currency_id




