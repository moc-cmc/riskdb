go

drop procedure
	r_positionladder
go

create procedure
	r_positionladder
		@login varchar(30),
		@run_name varchar(50),
		@as_of_date datetime=NULL,
		@sorting varchar(50)=NULL

as

declare @begin_date datetime
declare @end_date datetime
declare @run_id int
declare @fund_id int
declare @evaluation_currency_id int
declare @evaluation_currency varchar(50)
declare @trade_id int
declare @trades int
declare @contract_id int
declare @value_date datetime
declare @spot_price float
declare @forward_price float
declare @days float
declare @product_rate float
declare @currency_rate float
declare @products int
declare @product_id int
declare @value_dates int
declare @value_date_index int
declare @label varchar(200)
declare @longs numeric(30,2)
declare @shorts numeric(30,2)
declare @net numeric(30,2)


