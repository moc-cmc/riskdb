create table
	#ladder(
		product_id int,
		value_date datetime,
		quantity numeric(30,4) NULL,
		equiv float NULL,
		long_equiv float NULL,
		short_equiv float NULL)
insert into
	#ladder(
		product_id,
		value_date,
		quantity)
select
	product_id,
	value_date,
	sum(quantity)
from
	#amounts
group by
	product_id,
	value_date

update
	#ladder
set
	long_equiv = 0.0,
	short_equiv = 0.0

update
	#ladder
set
	a.equiv = a.quantity * b.rate
from
	#ladder a,
	spot_rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.rate_date = @end_date

update
	#ladder
set
	a.equiv = a.quantity * b.rate
from
	#ladder a,
	current_spot_rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	a.equiv = NULL

create table
	#unresolved_equivs(
		product_id int,
		currency_id int,
		quantity numeric(30,4) NULL,
		value_date datetime,
		value_in_ccy float NULL,
		equiv float NULL)
insert into
	#unresolved_equivs(
		product_id,
		currency_id,
		quantity,
		value_date)
select
	b.product_id,
	b.currency_id,
	a.quantity,
	a.value_date
from
	#ladder a,
	forwards b
where
	a.product_id = b.product_id
and
	a.equiv = NULL

update
	#unresolved_equivs
set
	a.value_in_ccy = a.quantity * c.price
from
	#unresolved_equivs a,
	forwards b,
	prices c	
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	c.price_date = @end_date

update
	#unresolved_equivs
set
	a.value_in_ccy = a.quantity * c.price
from
	#unresolved_equivs a,
	forwards b,
	current_prices c	
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	a.value_in_ccy = NULL

update
	#unresolved_equivs
set
	a.equiv = a.value_in_ccy * b.rate
from
	#unresolved_equivs a,
	spot_rates b
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.rate_date = @end_date

update
	#unresolved_equivs
set
	a.equiv= a.value_in_ccy * b.rate
from
	#unresolved_equivs a,
	current_spot_rates b
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	a.equiv = NULL
	

update
	#ladder
set
	a.equiv = b.equiv
from
	#ladder a,
	#unresolved_equivs b
where
	a.product_id = b.product_id
and
	a.value_date = b.value_date

update
	#ladder
set
	long_equiv = equiv
where
	equiv >= 0
update
	#ladder
set
	short_equiv = equiv
where
	equiv < 0


select
	@value_date = "8/8/88"

create table
	#distinct_dates(
		value_date datetime)
insert into
	#distinct_dates
select
	distinct(value_date)
from
	#ladder

/* Select the total */
select
  @longs = convert(numeric(30,2), sum(abs(long_equiv)) / 1000000.00),
  @shorts = convert(numeric(30,2), sum(abs(short_equiv)) / 1000000.00)
from
  #ladder

select
  @net = @longs - @shorts
select
  @label = "All Dates  - (Longs " + rtrim(convert(varchar(30), @longs)) + " , Shorts " + rtrim(convert(varchar(30), @shorts)) + " , Net " + rtrim(convert(varchar(30), @net)) + ")"

select
  label = @label,
  '<div id="section"><h3 style="width:250px;text-align:center;float:left;margin:5px 0">Longs</h3><h3 style="width:250px;text-align:center;float:left;margin:5px 0">Shorts</h3><div class="longs" style="clear:left;width:250px;height:250px;float:left"></div><div class="shorts" style="width:250px;height:250px;float:left"></div></div>'
  
select
  b.symbol,
  longs = convert(numeric(30,2), sum(abs(a.long_equiv)) / 1000000.00),
  shorts = convert(numeric(30,2), sum(abs(a.short_equiv)) / 1000000.00),
  '<div class="HideTable"></div>'
from
  #ladder a,
  products b
where
  a.product_id = b.product_id
group by
  b.symbol
order by
  b.symbol

select
  '<div class="HideTable"></div>',
  '<script>var $c = jQuery(".OutputTable:eq(0)"), $t = jQuery(".OutputTable:eq(1) "); $c.find(".longs").chart($t, {plot:"pie", series:[{x1:0,y1:1}], bind:{rowStart:2}, legend:{show:true,position:"lb",background:{opacity:0}}}); $c.find(".shorts").chart($t, {plot:"pie", series:[{x1:0,y1:2}], bind:{rowStart:2}, legend:{show:false}});</script>'

select
	@value_dates = count(*),
	@value_date_index = 1
from
	#distinct_dates
where
	value_date > @value_date

while @value_dates > 0
begin
	select
		@value_date = min(value_date)
	from
		#distinct_dates
	where
		value_date > @value_date

	select
		@longs = NULL,
		@shorts = NULL,
		@net = NULL

	select
		@longs = convert(numeric(30,2), sum(abs(long_equiv)) / 1000000.00),
		@shorts = convert(numeric(30,2), sum(abs(short_equiv)) / 1000000.00)
	from
		#ladder
	where
		value_date = @value_date

	select
		@net = @longs - @shorts
	

	select 
		@label = convert(varchar(11), @value_date, 1) + " - (Longs " + rtrim(convert(varchar(30), @longs)) + " , Shorts " + rtrim(convert(varchar(30), @shorts)) + " , Net " + rtrim(convert(varchar(30), @net)) + " " + rtrim(@evaluation_currency) + ")"

  select
    label = @label,
    '<div id="section' + convert(varchar(11), @value_date_index) + '"><h3 style="width:250px;text-align:center;float:left;margin:5px 0">Longs</h3><h3 style="width:250px;text-align:center;float:left;margin:5px 0">Shorts</h3><div class="longs" style="clear:left;width:250px;height:250px;float:left"></div><div class="shorts" style="width:250px;height:250px;float:left"></div></div>'
		
	select
		b.symbol,
		longs = convert(numeric(30,2), abs(a.long_equiv) / 1000000.00),
		shorts = convert(numeric(30,2), abs(a.short_equiv) / 1000000.00),
		'<div class="HideTable"></div>'
	from
		#ladder a,
		products b
	where
		a.product_id = b.product_id
	and
		a.value_date = @value_date
	order by
		b.symbol

	select
		'<div class="HideTable"></div>',
		'<script>var $c = jQuery(".OutputTable:eq(' + convert(varchar(10), @value_date_index * 3) + ')"), $t = jQuery(".OutputTable:eq(' + convert(varchar(10), @value_date_index * 3 + 1) + ') "); $c.find(".longs").chart($t, {plot:"pie", series:[{x1:0,y1:1}], bind:{rowStart:2}, legend:{show:true,position:"lb",background:{opacity:0}}}); $c.find(".shorts").chart($t, {plot:"pie", series:[{x1:0,y1:2}], bind:{rowStart:2}, legend:{show:false}});</script>'

	select
		@value_dates = count(*),
		@value_date_index = @value_date_index + 1
	from
		#distinct_dates
	where
		value_date > @value_date
end

