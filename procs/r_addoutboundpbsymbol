
drop procedure
	r_addoutboundpbsymbol
go

create procedure
	r_addoutboundpbsymbol
			@login varchar(25),
			@name varchar(100),
			@outbound_source varchar(100),
			@symbol varchar(50)
as

exec
	api_addprimebrokersymbol
			@login=@login,
			@name=@name,
			@symbol=@symbol,
			@source=@outbound_source

exec
	r_mappingoverview
			@login=@login

return

go

							
