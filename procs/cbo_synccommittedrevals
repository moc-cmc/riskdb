drop procedure
	cbo_synccommittedrevals
go

create procedure
	cbo_synccommittedrevals
		@login varchar(50),
		@reval_date datetime
as

declare @newest_commit_date datetime
declare @oldest_trade_daily_reval datetime
declare @most_recent_commit datetime
declare @reval_archive_level_id int
declare @row_limit int
declare @table_row_count int
declare @table_name varchar(20)
declare @insertsql varchar(1000)
declare @countsql varchar(200)
declare @max_reval_archive_level int
declare @max_end_reval_date datetime

/* Reval archive levels exist for each month. Every month a new archive level is created */

select
	@max_reval_archive_level=max(reval_archive_level_id)
from
	reval_archive_levels

select 
	@reval_archive_level_id=reval_archive_level_id
from
	reval_archive_levels
where
	@reval_date between begin_reval_date and end_reval_date

if(@@rowcount != 1)
begin
	
	select
		@max_end_reval_date = (end_reval_date)
	from
		reval_archive_levels

	if(@reval_date < @max_end_reval_date)
	begin
		select
			status="Error",
			msg="Invalid reval date", @reval_date

		return
	end

	exec r_createrevalarchivelevel @reval_archive_level_id output

	/* make sure reval_date is good */

	if not exists(select reval_archive_level_id from reval_archive_levels where @reval_date between begin_reval_date and end_reval_date)
	begin
		select
			status="Error",
			msg="Invalid reval date", @reval_date

		exec r_removerevalarchivelevel @reval_archive_level_id

		return
	end
 	
		
	select @max_reval_archive_level = @reval_archive_level_id

end

/* for now, you can't reval past levels */

if(@reval_archive_level_id < @max_reval_archive_level)
begin
	select
		status="Error",
		msg="Reval date not part of latest reval archive"
	return
end

select
	@table_name=table_name
from
	reval_table_map
where
	reval_archive_level_id=@reval_archive_level_id

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find reval table for reval archive level id ", @reval_archive_level_id
	return
end

/* make sure max rows for the archive table are not exceeded */

exec r_checkrevalarchivetable @reval_archive_level_id output, @reval_date output, @table_name output

if(@table_name = NULL)
begin
	select
		status="Error",
		msg="Could not get verify archive table "

	return
end

exec 
	r_insertintorevalarchive @reval_archive_level_id, @reval_date, @table_name

go




