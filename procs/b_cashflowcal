use
	risk_elviro
go

drop procedure
	b_cashflowcal
go

create procedure
	b_cashflowcal
		@login varchar(50),
		@trade_date datetime=NULL
as


declare @fund_id int
declare @evaluation_currency_id int
declare @run_name varchar(50)
declare @run_id int
declare @runs int
declare @id int
declare @ids int

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

declare @today_begin_date datetime
declare @month_begin_date datetime
declare @month_end_date datetime
declare @year_begin_date datetime
declare @year_end_date datetime
declare @today_end_date datetime
declare @previous_date datetime

declare @option_prem_credit_equiv numeric(30,2)
declare @option_prem_debit_equiv numeric(30,2)
declare @settled_fx_equiv numeric(30,2)
declare @fees_equiv numeric(30,2)
declare @begin_fx_equiv numeric(30,2)
declare @end_fx_equiv numeric(30,2)
declare @fx_pl_equiv numeric(30,2)
declare @max_id int

declare @today_total numeric(30,2)
declare @mtd_total numeric(30,2)
declare @ytd_total numeric(30,2)


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"end_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"begin_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"trade_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"run_name",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"prev_date",
	"Cash Flows Summary",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"run",
	"Cash Activity",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"equiv",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"amount",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"today",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"month_to_date",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"year_to_date",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"



exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not configured"
	return
end


if @trade_date = NULL
	select
		@trade_date = max(price_date)
	from
		bo_prices

select
	@trade_date = convert(datetime, convert(date, @trade_date))

exec
	r_prevbusinessday
		@trade_date,
		@previous_date output

/* exec
	r_daterangefordate
		@trade_date,
		@today_begin_date output,
		@today_end_date output */


select
	@year_begin_date = convert(datetime, "1/1/" + convert(varchar(4), datepart(year, @trade_date))),
	@month_begin_date = convert(datetime, datename(month, @trade_date) + " 1 " + datename(year, @trade_date))


create table
	#dates(
		id int identity,
		date datetime NULL)
insert into
	#dates(
		date)
values(
	@year_begin_date)
insert into
	#dates(
		date)
values(
	@month_begin_date)
insert into
	#dates(
		date)
values(
	@trade_date)

create table
	#output(
		id int identity,
		display varchar(2) NULL,
		style varchar(250) NULL,
		details varchar(50) NULL,
		run_name varchar(50) NULL,
		run varchar(50) NULL,
		activity varchar(100) NULL,
		today numeric(30,4) NULL,
		month_to_date numeric(30,4) NULL,
		year_to_date numeric(30,4) NULL)


create table
	#runs(
		id int identity,
		run_id int NULL,
		run_name varchar(50) NULL)
insert into
	#runs(
		run_id,
		run_name)
	
select
	a.run_id,
	a.name
from
	runs a,
	cash_flow_runs b 
where
	a.run_id = b.run_id 
order by
	b.ordering  
	
select
	@id = 0
select
	@ids = count(*)
from
	#runs
where
	id > @id


while @ids > 0
begin
	select
		@id = min(id)
	from
		#runs
	where
		id > @id

	select
		@run_name = run_name
	from
		#runs
	where
		id = @id


	insert into
		#output(
			style,
			details,
			run_name,
			run)
	values(
		@client_style,
		"Transactions",
		@run_name,
		@run_name)

	insert into
		#output(
			style,
			run_name,
			activity)
	values(
		@style,
		@run_name,
		"Option Premium Collected")
	insert into
		#output(
			style,
			run_name,
			activity)
	values(
		@style,
		@run_name,
		"Option Premium Paid")
	insert into
		#output(
			style,
			run_name,
			activity)
	values(
		@style,
		@run_name,
		"MTM FX Positions")
	insert into
		#output(
			style,
			run_name,
			activity)
	values(
		@style,
		@run_name,
		"Settled FX")
	insert into
		#output(
			style,
			run_name,
			activity)
	values(
		@style,
		@run_name,
		"Commissions")
	

	
	/**************************** YTD End *********************************/
	select
		@evaluation_currency_id = NULL,
		@option_prem_credit_equiv = NULL,
		@option_prem_debit_equiv = NULL,
		@settled_fx_equiv = NULL,
		@fees_equiv = NULL,
		@begin_fx_equiv = NULL,
		@end_fx_equiv = NULL,
		@fx_pl_equiv = NULL
	
	exec
		u_cashflowsumforrange
			@login = @login,
			@run_name = @run_name,
			@begin_date = @year_begin_date,
			@end_date = @trade_date,
			@evaluation_currency_id = @evaluation_currency_id output,
			@option_prem_credit_equiv = @option_prem_credit_equiv output,
			@option_prem_debit_equiv = @option_prem_debit_equiv output,
			@settled_fx_equiv = @settled_fx_equiv output,
			@fees_equiv = @fees_equiv output,
			@begin_fx_equiv = @begin_fx_equiv output,
			@end_fx_equiv = @end_fx_equiv output,
			@fx_pl_equiv = @fx_pl_equiv output


	update
		#output
	set
		year_to_date = @option_prem_credit_equiv
	where
		activity = "Option Premium Collected"
	and
		run_name = @run_name
	
	update
		#output
	set
		year_to_date = @option_prem_debit_equiv
	where
		activity = "Option Premium Paid"
	and
		run_name = @run_name
	
	update
		#output
	set
		year_to_date = @settled_fx_equiv
	where
		activity = "Settled FX"
	and
		run_name = @run_name
	
	update
		#output
	set
		year_to_date = @fees_equiv
	where
		activity = "Commissions"
	and
		run_name = @run_name
	
	update
		#output
	set
		year_to_date = @fx_pl_equiv
	where
		activity = "MTM FX Positions"
	and
		run_name = @run_name
	
	/**************************** YTD End *********************************/
	
	/**************************** MTD Begin *********************************/
	select
		@evaluation_currency_id = NULL,
		@option_prem_credit_equiv = NULL,
		@option_prem_debit_equiv = NULL,
		@settled_fx_equiv = NULL,
		@fees_equiv = NULL,
		@begin_fx_equiv = NULL,
		@end_fx_equiv = NULL,
		@fx_pl_equiv = NULL
	
	exec
		u_cashflowsumforrange
			@login = @login,
			@run_name = @run_name,
			@begin_date = @month_begin_date,
			@end_date = @trade_date,
			@evaluation_currency_id = @evaluation_currency_id output,
			@option_prem_credit_equiv = @option_prem_credit_equiv output,
			@option_prem_debit_equiv = @option_prem_debit_equiv output,
			@settled_fx_equiv = @settled_fx_equiv output,
			@fees_equiv = @fees_equiv output,
			@begin_fx_equiv = @begin_fx_equiv output,
			@end_fx_equiv = @end_fx_equiv output,
			@fx_pl_equiv = @fx_pl_equiv output


	update
		#output
	set
		month_to_date = @option_prem_credit_equiv
	where
		activity = "Option Premium Collected"
	and
		run_name = @run_name
	
	update
		#output
	set
		month_to_date = @option_prem_debit_equiv
	where
		activity = "Option Premium Paid"
	and
		run_name = @run_name
	
	update
		#output
	set
		month_to_date = @settled_fx_equiv
	where
		activity = "Settled FX"
	and
		run_name = @run_name
	
	update
		#output
	set
		month_to_date = @fees_equiv
	where
		activity = "Commissions"
	and
		run_name = @run_name
	
	update
		#output
	set
		month_to_date = @fx_pl_equiv
	where
		activity = "MTM FX Positions"
	and
		run_name = @run_name
	
	/**************************** MTD End *********************************/
	
	/**************************** Today Begin *********************************/
	select
		@evaluation_currency_id = NULL,
		@option_prem_credit_equiv = NULL,
		@option_prem_debit_equiv = NULL,
		@settled_fx_equiv = NULL,
		@fees_equiv = NULL,
		@begin_fx_equiv = NULL,
		@end_fx_equiv = NULL,
		@fx_pl_equiv = NULL
	
	exec
		u_cashflowsumforrange
			@login = @login,
			@run_name = @run_name,
			@begin_date = @trade_date,
			/* @end_date = @today_end_date, */
			@end_date = NULL,
			@evaluation_currency_id = @evaluation_currency_id output,
			@option_prem_credit_equiv = @option_prem_credit_equiv output,
			@option_prem_debit_equiv = @option_prem_debit_equiv output,
			@settled_fx_equiv = @settled_fx_equiv output,
			@fees_equiv = @fees_equiv output,
			@begin_fx_equiv = @begin_fx_equiv output,
			@end_fx_equiv = @end_fx_equiv output,
			@fx_pl_equiv = @fx_pl_equiv output



	update
		#output
	set
		today = @option_prem_credit_equiv
	where
		activity = "Option Premium Collected"
	and
		run_name = @run_name
	
	update
		#output
	set
		today = @option_prem_debit_equiv
	where
		activity = "Option Premium Paid"
	and
		run_name = @run_name
	
	update
		#output
	set
		today = @settled_fx_equiv
	where
		activity = "Settled FX"
	and
		run_name = @run_name
	
	update
		#output
	set
		today = @fees_equiv
	where
		activity = "Commissions"
	and
		run_name = @run_name
	
	update
		#output
	set
		today = @fx_pl_equiv
	where
		activity = "MTM FX Positions"
	and
		run_name = @run_name
	
	/**************************** Today End *********************************/
	
	select
		@today_total = sum(today),
		@mtd_total = sum(month_to_date),
		@ytd_total = sum(year_to_date)
	from
		#output
	where
		activity != @run_name
	and
		run_name = @run_name
	
	insert into
		#output(
			style,
			run_name,
			activity,
			today,
			month_to_date,
			year_to_date)
	values(
		@style,
		@run_name,
		"Total",
		@today_total,
		@mtd_total,
		@ytd_total)
	
	select
		@ids = count(*)
	from
		#runs
	where
		id > @id

end 


