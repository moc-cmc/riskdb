if object_id("mc_editclientoption") != NULL
    drop procedure
        mc_editclientoption
go

create procedure
	mc_editclientoption
		@login char(25),
		@deal_id int,
		@client_user char(25),
		@client_buys_sells char(25),
		@quantity numeric(30,4),
		@biproduct varchar(50),
		@timezone varchar(50),
		@expiration datetime,
		@option_settledate datetime=NULL,	
		@strike float,
		@call_put char(1),
		@spot_reference float,
		@price float,
		@price_format varchar(15),
		@total_premium float=NULL,
		@premium_currency varchar(50),
		@premium_settledate datetime=NULL

as

declare @external_account varchar(50)
declare @pips_price float
declare @pct_price float
declare @contract_id int
declare @symbol varchar(50)
declare @trade_id int
declare @trade_date datetime


select
	@external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

if @price_format = "Pct"
begin
	select
		@pips_price = (@price / 100.00) * @spot_reference,
		@pct_price = @price / 100.00
end
else
begin
	select
		@pips_price = @price,
		@pct_price = NULL
end

	
if @client_buys_sells = "Client Buys"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@quantity = abs(@quantity)
end

exec
	r_spotoptioncontract
		@biproduct,
		@timezone,
		@expiration,
		@call_put,
		@strike,
		@option_settledate,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

select
	@trade_id = trade_id
from
	trades
where
	deal_id = @deal_id

select
	@trade_date = trade_date
from
	trades
where
	trade_id = @trade_id

exec
        r_inserttradeedit @trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Option",
		@deal_type = "Client Option",
		@trade_type = "Option",
		@external_account = @external_account,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @option_settledate,
		@price = @pips_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@premium = @total_premium,
		@premium_currency = @premium_currency,
		@prem_settle_date = @premium_settledate,
		@pct_price = @pct_price


if(@quantity = 0)
begin
        exec
                r_updatetradenotification @trade_id, "Cancelled"
end
else
begin
        exec
                r_updatetradenotification @trade_id, "Edit" 
end

exec
	r_inspectdealtrades
		@login,
		@deal_id

go
