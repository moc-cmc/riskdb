create or replace procedure
	ag_addboaccount
		@login varchar(50),
		@legal_entity varchar(50),
		@symbol varchar(50),
		@name varchar(150)=NULL,
		@account_type varchar(50),
		@prime_broker varchar(50),
		@evaluation_ccy varchar(10)=NULL



as

declare @external_account_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @symbol
if @external_account_id != NULL
begin
	select
		status = "Error",
		message = "Account already exists with symbol",
		symbol = @symbol
end
	
if @external_account_id = NULL
begin
	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		name = @name
	if @external_account_id != NULL
	begin
		select
			status = "Error",
			message = "Account already exists with name",
			name = @name
	end
end


if @external_account_id = NULL
begin
	exec
		api_addboaccount
			@login = @login,
			@symbol = @symbol,
			@name = @name,
			@prime_broker = @prime_broker,
			@evaluation_ccy = @evaluation_ccy,
			@legal_entity = @legal_entity,
			@account_type = @account_type
end


exec
        ag_legalentitieshome
                @login=@login,
		@legal_entity=@legal_entity


go
			
		



		
		
