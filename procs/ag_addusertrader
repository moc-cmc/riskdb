create or replace procedure
	ag_addusertrader
		@login varchar(100),
		@legal_entity varchar(100),
		@user_name varchar(50),
		@trader varchar(50)

as

declare @legal_entity_id int
declare @default_bo_master_account_id int
declare @default_bo_master_account varchar(50)
declare @trader_id int


select
        @legal_entity_id = legal_entity_id
from
        legal_entities
where
        name = @legal_entity
if @legal_entity_id = NULL
begin
        select
                status = "Error",
                message = "Problem finding legal entity provided"
        return
end



/* Choose any bo master to add thee user to for the trader external account if necessary */
select
        @default_bo_master_account_id = max(a.bo_master_account_id)
from
        bo_master_accounts a,
        external_accounts b
where
        a.external_account_id = b.external_account_id
and
        a.legal_entity_id = @legal_entity_id

if @default_bo_master_account_id = NULL
begin
        select
                status = "Error",
                message = "Must create a bo master account for legal entity before login creation"
        return
end

select
        @default_bo_master_account = b.symbol
from
        bo_master_accounts a,
        external_accounts b
where
        a.external_account_id = b.external_account_id
and
        a.legal_entity_id = @legal_entity_id
and
        a.bo_master_account_id = @default_bo_master_account_id
if @default_bo_master_account = NULL
begin
        select
                statuts = "Error",
                message = "Problem finding default bo master account"
        return
end


exec
        api_addusertrader
                @login = @login,
                @trader = @trader,
                @user_name = @user_name,
                @external_account = @default_bo_master_account,
                @sales_code = NULL,
                @trader_id = @trader_id output

/* All client accounts with a trader access have Client Front Office access */
exec
       	api_addaccessgroupforlogin
               	@login=@login,
               	@login_name = @user_name,
               	@access_group = "Client Front Office"

exec
	ag_legalentitieshome
		@login = @login,
		@legal_entity = @legal_entity

go
		



