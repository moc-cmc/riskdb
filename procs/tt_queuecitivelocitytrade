
if object_id("tt_queuecitivelocitytrade") != NULL
    drop procedure
        tt_queuecitivelocitytrade
go

create procedure
	tt_queuecitivelocitytrade
		@login varchar(25),
		@source varchar(25)=NULL,
		@identifier varchar(100),
		@trader varchar(25),
		@broker varchar(25),
		@trade_date datetime,
                @trade_day datetime=NULL,
		@type varchar(25),
		@ccy_pair varchar(25),
		@dealt_ccy varchar(10),
		@buy_sell varchar(5),
		@ccy1 varchar(10),
		@ccy1_amount1 float,
		@ccy2 varchar(10),
		@ccy2_amount1 float,
		@near_rate float,
		@near_points float,
		@near_value_date datetime,
		@ccy1_amount2 float=NULL,
		@ccy2_amount2 float=NULL,
		@far_rate float=NULL,
		@far_value_date datetime=NULL,
		@spot_rate float=NULL,
		@fwd_points float=NULL,
		@no_spot_nearleg_fwd float=NULL,
		@fwd_fwd_points float=NULL

as

declare @trade_id int
declare @deal_id int
declare @symbol varchar(50)
declare @trade_type varchar(25)
declare @contract_id int
declare @source_id int
declare @broker_id int
declare @trade_identifier varchar(100)

declare @trader_id int
declare @trader_symbol varchar(50)
declare @broker_symbol varchar(50)
declare @queued_trade_id int
declare @review_status_id int
declare @quantity numeric(30, 4)
declare @strategy_id int

select
	@trader_symbol = @trader,
	@broker_symbol = @broker

if @spot_rate = NULL
	select
		@spot_rate = @near_rate

select
        @review_status_id = status_id
from
        statuses
where
        name = "Review"
if @review_status_id = NULL
begin
        select
                error="Error",
                msg="Problem finding 'Review' status"
        return
end


if @source = NULL
	select
		@source = "Logiscope"


select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select 
		error="Error",
		msg="Problem determining source",
		source=@source
	return
end

select
	@trade_identifier = rtrim(@source)+"-"+@identifier

if exists(select queued_trade_id from queued_release_trades where identifier = @trade_identifier)
begin
	select
		status="Dupe",
		msg="Trade already tallied",
		identifier=@trade_identifier
	return
end

select
	@broker = a.symbol,
	@broker_id = a.broker_id
from
	brokers a,
	broker_symbols b
where
	a.broker_id = b.broker_id
and
	b.source_id = @source_id
and
	b.symbol = @broker_symbol
if @broker_id = NULL
begin
	select
		@broker = symbol,
		@broker_id = broker_id
	from
		brokers
	where
		symbol = @broker_symbol
	if @broker_id = NULL
	begin
		select
			error="Error",
			msg="Problem determining broker from broker symbol",
			broker_symbol =@broker_symbol
		return
	end
end

select
        @trader = a.symbol,
        @trader_id = a.trader_id
from
        traders a,
        trader_symbols b
where
        a.trader_id = b.trader_id
and
        b.source_id = @source_id
and
        b.symbol = @trader_symbol
if @trader_id = NULL
begin
        select
                @trader = symbol,
                @trader_id = trader_id
        from
                traders
        where
                symbol = @trader_symbol
        if @trader_id = NULL
        begin
                select
                        error="Error",
                        msg="Problem determining trader from trader symbol",
                        trader_symbol =@trader_symbol
                return
        end
end




if @dealt_ccy = @ccy1
begin
	select
		@quantity = @ccy1_amount1,
		@symbol = rtrim(@dealt_ccy)+rtrim(@ccy2)
end
else if @dealt_ccy = @ccy2
begin
	select
		@quantity = @ccy2_amount1,
		@symbol = rtrim(@dealt_ccy)+rtrim(@ccy1)
end
else
begin
	select 
		error="Error",
		msg="Problem determining symbol and quantity from ccys",
                dealt_ccy=@dealt_ccy,
		ccy1=@ccy1,
		ccy2=@ccy2
	return
end

if lower(@buy_sell) = "sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if lower(@buy_sell) = "buy"
begin
	select
		@quantity = abs(@quantity)
end


if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

select
    @contract_id = contract_id
from
    contracts
where
    symbol = @symbol
if @@rowcount != 1
begin
        select
            status = "Error",
            message = "Contract not found",
            symbol=@symbol

        return
end



/* ------------Value Date Adjustments --------------------
   problem:
     es-fix library will pass in a converted GMT timestamp even for value dates
     So, if the value date is "20130725T00:00:00.000Z"
     we end up tallying value date as "20130724 8:00 EST", which is incorrect
   solution: 
     if there is a timestamp, add 8 hours to value dates and then truncate timestamp.
     This will ensure proper value date w/o worrying about daylight savings
----------------------------------------------------------*/

	select
		 @near_value_date = dateadd(hh, 8, @near_value_date)
	select
		@near_value_date = convert(date, @near_value_date)
	select
		@far_value_date = dateadd(hh, 8, @far_value_date)
	select
		@far_value_date = convert(date, @far_value_date)

/*
if @near_value_date != convert(date, @near_value_date)
begin
end
if @far_value_date != convert(date, @far_value_date)
begin
end
*/

if @type = "SPOT"
begin
	select
		@trade_type = "Spot"
end
else if @type in("ON", "TN", "SN", "1W", "2W", "3W", "1M", "2M", "3M", "6M", "9M", "1Y", "BROKEN")
begin
	select
		@trade_type = "Forward"
	if @far_value_date != NULL
	begin
		select
			@trade_type = "Swap"
	end
end
else if @type like ("%-%")
begin
	select
		@trade_type = "Swap"
end
else
begin
	select
		"error"="Error",
		"msg"="Unsuppored trade type",
		"type"=@type
	return
end


exec
	j_nextkey
		"queued_trades",
		@queued_trade_id output

insert into 
	queued_release_trades
(
	queued_trade_id,
	type,
	contract_id,
	broker_id,
	trader_id,
	strategy_id,
	quantity,
	price,
	value_date,
	identifier,
	spot_price,
	far_date,
	far_price,
	trade_date,
	status_id
)
values(
        @queued_trade_id,
        @trade_type,
        @contract_id,
        @broker_id,
        @trader_id,
        @strategy_id,
        @quantity,
        @near_rate,
        @near_value_date,
        @trade_identifier,
        @spot_rate,
        @far_value_date,
        @far_rate,
        @trade_date,
        @review_status_id
)
if @@rowcount = 1
begin
	select
		status="Tallied Trade",
		queued_trade_id=@queued_trade_id,
	        trade_type=@trade_type,
        	symbol=@symbol,
        	qty=@quantity,
        	rate=@near_rate,
        	vald=@near_value_date,
        	identifie=@trade_identifier,
        	far_vald=@far_value_date,
        	far_rate=@far_rate,
        	broker=@broker,
        	trader=@trader,
        	td=@trade_date
end
else
begin
	select
		status="Error",
		msg="Problem inserting trades into queued_release_trades"
end


go
