create procedure
	ag_cfdrollreport
		@login varchar(50),
		@trade_date datetime
as

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @style varchar(250)
declare @unassigned_style varchar(250)
declare @prelim_style varchar(250)
declare @subtotal_style varchar(250)

declare @id int
declare @ids int 
declare @round_turn_id int
declare @contract_id int
declare @external_account_id int
declare @total float
declare @cfd_trade_type_id int
declare @cfd_roll_trade_type_id int
declare @begin_date datetime
declare @end_date datetime

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
