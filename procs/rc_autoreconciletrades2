
if object_id("rc_autoreconciletrades") != NULL
    drop procedure
        rc_autoreconciletrades
go

create procedure
    rc_autoreconciletrades
        @login varchar(50),
        @fund varchar(50) = NULL,
        @prime_broker varchar(50) = NULL,
        @begin_date datetime = NULL,
        @end_date datetime = NULL,
        @options varchar(100) = NULL
as

declare @matched_status_id int
declare @mismatched_status_id int
declare @review_status_id int

declare @user_id int
declare @fund_id int
declare @prime_broker_id int
declare @ext_trade_count int
declare @int_trade_count int
declare @known_match_count int
declare @new_match_count int

declare @report_commit_id int
declare @ext_trade_id int
declare @report_trade_id int
declare @trade_id int
declare @id_match char(1)
declare @match_strength float
declare @effective_strength float
declare @status_id int

/*
 * 1. LOOKUP background information
 * 2. LOOKUP #external_accounts
 * 3. FIND #ext_trades: external trades from report_trades table
 * 4. FIND #int_trades: internal trades from trades table
 * 5. FIND #known_matches: the known matches from trade_matches
 * 6. DELETE #ext_trades: that have #known_matches
 * 7. DELETE #int_trades: that have #known_matches
 * 8. FIND #byid_matches: for internal and external trades by trade_id
 * 9. UPDATE #byid_matches: calculate match strength for accounts
 * 10. UPDATE #byid_matches: calculate match strength for contracts and prices
 * 11. UPDATE #byid_matches: calculate statuses based on match_strength
 * 12. INSERT trade_matches: from new matches
 */

create table
    #messages (
        id int identity,
        subject varchar(25),
        message varchar(75)
    )

/*+---------------------------------------------------------------------------* 
 |                      1. LOOKUP background information                      | 
 *----------------------------------------------------------------------------*/

/*
 * LOOKUP @matched_status_id, @mismatched_status_id, @review_status_id
 */
select
    @matched_status_id = status_id
from
    statuses
where
    name = "Matched"

select
    @mismatched_status_id = status_id
from
    statuses
where
    name = "Mismatched"

select
    @review_status_id = status_id
from
    statuses
where
    name = "Review"

if @matched_status_id = NULL or @mismatched_status_id = NULL or @review_status_id = NULL
begin
    select
        status = "Error",
        message = "Couldn't find statuses: Matched, Mismatched and/or Review"
    return
end
 
/*
 * LOOKUP @user_id
 */

select
    @user_id = account_id
from
    tico_accounts
where
    login = @login

if @user_id = NULL
begin
    select
        status = "Error",
        message = "No such login, '" + @login + "'"
    return
end

/*
 * RESOLVE @fund_id
 */
if @fund != NULL
begin

    select
        @fund_id = fund_id
    from
        funds
    where
        name = @fund
    
    if @fund_id = NULL
    begin
        select
            status = "Error",
            message = "No such fund, '" + @fund + "'"
        return
    end
    
    /* DIAGNOSTICS */ insert into
        #messages
    select
        subject = "Fund",
        message = "Using fund, '" + @fund + "' (" + convert(varchar(10), @fund_id) + ")"
    
end
else
begin
    /* Look up the default fund */
    exec
        r_defaultfundforlogin
            @login,
            @fund_id out
    
    if @fund_id = NULL
    begin
        select
            status = "Error",
            message = "The user, '" + @login + "', does not have a default fund"
        return
    end
    
    select
        @fund = name
    from
        funds
    where
        fund_id = @fund_id
    
    /* DIAGNOSTICS */ insert into
        #messages
    select
        subject = "Fund",
        message = "Using default fund for user, '" + @login + "', named '" + @fund + "' (" + convert(varchar(10), @fund_id) + ")"
    
end

/*
 * RESOLVE @prime_broker_id
 */
if @prime_broker != NULL
begin

    select
        @prime_broker_id = a.prime_broker_id
    from
        prime_brokers a,
        sources b
    where
        a.source_id = b.source_id
    and
        b.name = @prime_broker
    
    if @prime_broker_id = NULL
    begin
        select
            status = "Error",
            message = "No such prime broker, '" + @prime_broker + "'"
        return
    end
    
    /* DIAGNOSTICS */ insert into
        #messages
    select
        subject = "Prime Broker",
        message = "Using prime broker, '" + @prime_broker + "' (" + convert(varchar(10), @prime_broker_id) + ")"
    
end
else
begin
    /* Look up the default prime broker */
    select distinct
        @prime_broker_id = d.prime_broker_id,
        @prime_broker = da.name
    from
        fund_external_accounts a,
        external_accounts b, /* join to ensure external_account exists */
        external_account_prime_brokers c,
        prime_brokers d,
        sources da
    where
        a.external_account_id = b.external_account_id
    and
        b.external_account_id = c.external_account_id
    and
        c.prime_broker_id = d.prime_broker_id
    and
        d.source_id = da.source_id
    and
        a.fund_id = @fund_id
        
    if @@rowcount > 1
    begin
        select
            status = "Error",
            message = "The fund, '" + @fund + "', has more than one prime broker (actually, " + convert(varchar(10), @@rowcount) + "). Please specify the prime broker"
        return
    end
    else if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "The fund, '" + @fund + "', has no prime brokers"
        return
    end
    
    /* DIAGNOSTICS */ insert into
        #messages
    select
        subject = "Fund",
        message = "Using default prime broker for fund, '" + @fund + "', named '" + @prime_broker + "' (" + convert(varchar(10), @prime_broker_id) + ")"
    
end

/*
 * RESOLVE @begin_date and @end_date: Default to the current date range.
 */
exec
    r_normalizedaterange
        @begin_date out,
        @end_date out

/* DIAGNOSTICS */ insert into
    #messages
select
    subject = "Date Range",
    messages = "Using date range, " + convert(varchar(20), @begin_date, 16) + " - " + convert(varchar(20), @end_date, 16)

/*+---------------------------------------------------------------------------* 
 |                        2. LOOKUP #external_accounts                        | 
 *----------------------------------------------------------------------------*/
/* 
 * Find all of the external_accounts that we'll use to qualify trades and
 * report_trades.
 */

create table
    #external_accounts (
        external_account_id int,
        symbol varchar(50)
    )

insert into
    #external_accounts (
        external_account_id,
        symbol
    )
select
    b.external_account_id,
    b.symbol
from
    fund_external_accounts a,
    external_accounts b, /* join to ensure external_account exists */
    external_account_prime_brokers c
where
    a.external_account_id = b.external_account_id
and
    b.external_account_id = c.external_account_id
and
    a.fund_id = @fund_id
and
    c.prime_broker_id = @prime_broker_id

if @@rowcount = 0
begin
    select
        status = "Error",
        message = "No external accounts for fund, '" + @fund + "', with prime broker, '" + @prime_broker + "'"
    return
end

/* DIAGNOSTICS */ insert into
    #messages
select
    subject = "External Account",
    messages = "Using external account: '" + symbol + "' (" +convert(varchar(10), external_account_id) + ")"
from
    #external_accounts



/*+---------------------------------------------------------------------------* 
 |       3. FIND #ext_trades: external trades from report_trades table        | 
 *----------------------------------------------------------------------------*/

create table
    #ext_trades (
        id int identity,
        report_trade_id int,
        used char(1) default "N",
        inverted char(1) default "N",
        contract_id int NULL,
        price float NULL,
        quantity float NULL
    )

insert into
    #ext_trades (
        report_trade_id,
        inverted,
        contract_id,
        price,
        quantity
    )
select
    a.report_trade_id,
    inverted = "N",
    a.contract_id,
    a.price,
    a.quantity
from
    report_trades a,
    #external_accounts b
where
    a.external_account_id = b.external_account_id
and
    a.trade_date >= @begin_date
and
    a.trade_date < @end_date

select
    @ext_trade_count = @@rowcount

/* DIAGNOSTICS */ insert into 
    #messages
select
    subject = "External Trades",
    messages = "Found " + convert(varchar(10), @ext_trade_count) + " external trade(s)"

/* 
 * INSERT #ext_trades: the already selected #ext_trades but add an inverted
 * version.
 */
insert into
    #ext_trades (
        report_trade_id,
        inverted,
        contract_id,
        price,
        quantity
    )
select
    a.report_trade_id,
    inverted = "Y",
    da.contract_id,
    1 / b.price,
    b.quantity / b.price
from
    #ext_trades a,
    report_trades b,
    contracts c,
        forwards ca,
            products caa,
                product_types caaa,
            products cab,
                product_types caba,
    contracts d,
        forwards da
where
    a.report_trade_id = b.report_trade_id
and
    b.contract_id = c.contract_id
        and
            c.contract_id = ca.contract_id
                and
                    ca.product_id = caa.product_id
                        and
                            caa.product_type_id = caaa.product_type_id
                and
                    ca.currency_id = cab.product_id
                        and
                            cab.product_type_id = caba.product_type_id
and
    d.contract_id = da.contract_id
and (
        da.product_id = ca.currency_id
    and
        da.currency_id = ca.product_id
    )

/* DIAGNOSTICS */ insert into 
    #messages
select
    subject = "Inverted Contracts",
    messages = "Found " + convert(varchar(10), @@rowcount) + " external trade(s) with invertable contracts"


/*+---------------------------------------------------------------------------* 
 |           4. FIND #int_trades: internal trades from trades table           | 
 *----------------------------------------------------------------------------*/

create table
    #int_trades (
        id int identity,
        trade_id int,
        used char(1) default "N"
    )

insert into
    #int_trades (
        trade_id
    )
select
    a.trade_id
from
    trades a,
    #external_accounts b
where
    a.external_account_id = b.external_account_id
and
    a.trade_date >= @begin_date
and
    a.trade_date < @end_date

select
    @int_trade_count = @@rowcount

/* DIAGNOSTICS */ insert into
    #messages
select
    subject = "Internal Trades",
    messages = "Found " + convert(varchar(10), @int_trade_count) + " internal trade(s)"

    
/*+---------------------------------------------------------------------------* 
 |        5. FIND #known_matches: the known matches from trade_matches        | 
 *----------------------------------------------------------------------------*/
 
update
    #ext_trades
set
    used = "Y"
from
    #ext_trades a,
    trade_matches b
where
    a.report_trade_id = b.report_trade_id

/* DIAGNOSTICS */ insert into 
    #messages
select
    subject = "Known Matches",
    messages = "Trimmed " + convert(varchar(10), @@rowcount) + " known external match(es)"

update
    #int_trades
set
    used = "Y"
from
    #int_trades a,
    trade_matches b
where
    a.trade_id = b.trade_id

/* DIAGNOSTICS */ insert into 
    #messages
select
    subject = "Known Matches",
    messages = "Trimmed " + convert(varchar(10), @@rowcount) + " known internal match(es)"


/*+---------------------------------------------------------------------------* 
 |    8. FIND #byid_matches: for internal and external trades by trade_id     | 
 *----------------------------------------------------------------------------*/
 
/* 
 * INSERT #matches: For trades that have an explicit report_trades.trade_id =
 * trades.trade_id. These are quoted matches as claimed by the PB. We don't
 * consider these a complete match since the trade details may not match. The
 * resulting match status may be 100% - Matched, < 100% - Mismatched, < 75%
 * Review
 */
create table
    #matches (
        report_commit_id int,
        ext_trade_id int,
        report_trade_id int,
        trade_id int,
        id_match char(1),
        match_strength float default NULL NULL,
        marks varchar(250) default "",
        status_id int default NULL NULL
    )

insert into
    #matches (
        report_commit_id,
        ext_trade_id,
        report_trade_id,
        trade_id,
        id_match,
        match_strength,
        status_id
    )
select
    aa.report_commit_id,
    ext_trade_id = a.id,
    aa.report_trade_id,
    b.trade_id,
    id_match = "Y",
    match_strength = 0.0,
    @review_status_id
from
    #ext_trades a,
    report_trades aa,
    #int_trades b,
    trades ba
where
    a.report_trade_id = aa.report_trade_id
and
    b.trade_id = ba.trade_id
and
    a.used = "N"
and
    b.used = "N"
and
    aa.trade_id = ba.trade_id

/* DIAGNOSTICS */ insert into 
    #messages
select
    subject = "ID-Based Matches",
    messages = "Identified " + convert(varchar(10), @@rowcount) + " id-based match(es)"

/* 
 * UPDATE #matches: For those ID-based matches that have the same matches:
 * 
 * Hard matches:
 * - external_account_type_id
 * - external_account_id (if specified)
 * - counterparty_id
 * - trader_id (if specified)
 * - strategy_id (if specified)
 * - broker_id (if specified)
 * - contract_id *
 * - value_date
 *
 * * - Note: We already have an extra entry in #ext_trades with the inverted 
 *     form of the trade
 * 
 * When these don't match, the match_strength is left at 0.0 and the status is
 * set to @review_status_id because these will need to be examined by hand why
 * the trade_id matches but the details don't.
 *
 * We calculate the match_strength using:
 *   - Price:    1/10th pip translates to 3+% off the match_strength
 *   - Quantity: 1 unit translates to 1% off of match_strength
 */
update
    #matches
set
    match_strength = 1.0
        - (abs(b.price - c.price) / c.price) * 5e3
        - abs(b.quantity - c.quantity) / 1e2,
    status_id = NULL
from
    #matches a,
    #ext_trades b,
    report_trades ba,
    trades c,
    external_accounts ca
where
    a.ext_trade_id = b.id
and
    b.report_trade_id = ba.report_trade_id
and
    a.trade_id = c.trade_id
and
    c.external_account_id = ca.external_account_id
and
    ba.external_account_type_id = ca.external_account_type_id
and (
        ba.external_account_id = c.external_account_id
    or
        ba.external_account_id = NULL
    )
and
    ba.counterparty_id = c.counterparty_id
and (
        ba.trader_id = c.trader_id
    or
        ba.trader_id = NULL
    )
and (
        ba.strategy_id = c.strategy_id
    or
        ba.strategy_id = NULL
    )
and (
        ba.broker_id = c.broker_id
    or
        ba.broker_id = NULL
    )
and
    ba.contract_id = c.contract_id
and
    ba.value_date = c.value_date
and
    sign(b.quantity) = sign(c.quantity)
and
    abs(b.quantity - c.quantity) < 10 
and
    abs(b.price - c.price) / b.price < 1.5e-5 /* less than 2/10 pip */ 

/* 
 * UPDATE #ext_trades, #int_trades: set used = 'Y' so that we know not to try to
 * match on details for these trades
 */
update
    #ext_trades
set
    used = "Y"
from
    #ext_trades a,
    #matches b
where
    a.id = b.ext_trade_id

update
    #int_trades
set
    used = "Y"
from
    #int_trades a,
    #matches b
where
    a.trade_id = b.trade_id

/* 
 * INSERT #matches: those with similar trade details between #ext_trades and
 * #int_trades, which haven't been used='Y', using the following match:
 * 
 * Hard matches:
 * - external_account_type_id
 * - external_account_id (if specified)
 * - counterparty_id
 * - trader_id (if specified)
 * - strategy_id (if specified)
 * - broker_id (if specified)
 * - contract_id *
 * - value_date
 *
 * Fuzzy matches:
 * - quantity: within 10 qty
 * - price: within 2/10 pip, i.e. % diff is less than 1.5e-5
 * 
 * * - Note: We already have an extra entry in #ext_trades with the inverted 
 *     form of the trade
 *
 * After this insert, we will have zero or more #matches for any trade_id or
 * report_trade_id. From this list, we want to pick out the strongest matched
 * pair of (report_trade_id and trade_id)
 *
 * We calculate the match_strength using:
 *   - Price:    1/10th pip translates to 3+% off the match_strength
 *   - Quantity: 1 unit translates to 1% off of match_strength
 */
insert into
    #matches (
        report_commit_id,
        ext_trade_id,
        report_trade_id,
        trade_id,
        id_match,
        match_strength
    )
select
    aa.report_commit_id,
    ext_trade_id = a.id,
    aa.report_trade_id,
    b.trade_id,
    id_match = "N",
    match_strength = 1.0
        - (abs(a.price - ba.price) / ba.price) * 5e3
        - abs(a.quantity - ba.quantity) / 1e2
from
    #ext_trades a,
    report_trades aa,
    #int_trades b,
    trades ba,
    external_accounts baa
where
    a.report_trade_id = aa.report_trade_id
and
    b.trade_id = ba.trade_id
and
    ba.external_account_id = baa.external_account_id
and
    a.used = "N"
and
    b.used = "N"
and
    a.report_trade_id = aa.report_trade_id
and
    b.trade_id = ba.trade_id
and
    aa.external_account_type_id = baa.external_account_type_id
and (
        aa.external_account_id = ba.external_account_id
    or
        aa.external_account_id = NULL
    )
and
    aa.counterparty_id = ba.counterparty_id
and (
        aa.trader_id = ba.trader_id
    or
        aa.trader_id = NULL
    )
and (
        aa.strategy_id = ba.strategy_id
    or
        aa.strategy_id = NULL
    )
and (
        aa.broker_id = ba.broker_id
    or
        aa.broker_id = NULL
    )
and
    a.contract_id = ba.contract_id
and
    aa.value_date = ba.value_date
and
    sign(a.quantity) = sign(ba.quantity)
and
    abs(a.quantity - ba.quantity) < 10
and
    abs(a.price - ba.price) / ba.price < 1.5e-5 /* less than 2/10 pip */ 

/* DIAGNOSTICS */ insert into 
    #messages
select
    subject = "Details-Based Matches",
    messages = "Identified " + convert(varchar(10), @@rowcount) + " details-based match(es)"

/* 
 * UPDATE #ext_trades, #int_trades: set used = 'Y' so that we know not to try to
 * match on details for these trades
 */
update
    #ext_trades
set
    used = "Y"
from
    #ext_trades a,
    #matches b
where
    a.id = b.ext_trade_id

update
    #int_trades
set
    used = "Y"
from
    #int_trades a,
    #matches b
where
    a.trade_id = b.trade_id

/*
select
    message = "Matches",
    a.report_commit_id,
    a.ext_trade_id,
    ext_trade_used = b.used,
    ext_trade_inverted = b.inverted,
    a.trade_id,
    a.id_match,
    a.match_strength,
    marks = convert(varchar(25), a.marks),
    status = aa.name
from
    #matches a
left outer join
    statuses aa
        on a.status_id = aa.status_id
join
    #ext_trades b
        on a.ext_trade_id = b.id
 */

/*
 * UPDATE #matches: set status_id based on match_strength
 */
update
    #matches
set
    status_id = case
        when match_strength > 0.9999 then @matched_status_id
        when match_strength > 0.7500 then @mismatched_status_id
        else                              @review_status_id
    end
where
    status_id = NULL

/* DIAGNOSTICS */ insert into 
    #messages
select
    subject = "Match Strength",
    messages = "Assigned statuses to " + convert(varchar(10), @@rowcount) + " match(es) based on math strength"

/* 
 * UPDATE #matches: We prefer id_match over everything else. So, increase the
 * match_strength by 2.0 so that the range of match_strengths is 2.0 - 3.0
 * instead of 0.0 - 1.0.
 */
/*
update
    #matches
set
    match_strength = match_strength + 2.0
where
    id_match = "Y"
 */

/*
select
    report_commit_id,
    ext_trade_id,
    report_trade_id,
    trade_id,
    id_match,
    match_strength,
    effective_strength = case id_match
        when "Y" then match_strength + 2.0
        else match_strength
    end,
    status_id
from
    #matches
order by
    effective_strength desc
 */


/* 
 * LOOP #matches: sorted by match_strength and pick through the matches we want
 * to record. Each time we record one, we'll claim both the #ext_trades and
 * #int_trades so that we don't use it again for another match.
 */
declare
    matches
cursor for select
    report_commit_id,
    ext_trade_id,
    report_trade_id,
    trade_id,
    id_match,
    match_strength,
    effective_strength = case id_match
        when "Y" then match_strength + 2.0
        else match_strength
    end,
    status_id
from
    #matches
order by
    effective_strength desc

open
    matches

fetch
    matches
into
    @report_commit_id,
    @ext_trade_id,
    @report_trade_id,
    @trade_id,
    @id_match,
    @match_strength,
    @effective_strength,
    @status_id

select
    @new_match_count = 0

while @@sqlstatus = 0
begin
    
    if not exists (
            select
                *
            from
                #ext_trades
            where
                report_trade_id = @report_trade_id
            and
                used = "M"
        ) and not exists (
            select
                *
            from
                #int_trades
            where
                trade_id = @trade_id
            and
                used = "M"
        )
    begin
        
        /*
         * INSERT trade_matches: The trade match we just inserted
         */
        insert into
            trade_matches (
                report_commit_id,
                trade_id,
                report_trade_id,
                match_strength,
                status_id
            )
        values (
            @report_commit_id,
            @trade_id,
            @report_trade_id,
            @match_strength,
            @status_id
        )
        
        /* UPDATE #ext_trades: Claim the @report_trade_id */
        update
            #ext_trades
        set
            used = "M"
        where
            report_trade_id = @report_trade_id
        
        /* UPDATE #int_trades: Claim the @trade_id */
        update
            #int_trades
        set
            used = "M"
        where
            trade_id = @trade_id
        
        select
            @new_match_count = @new_match_count + 1
        
    end
    
    fetch
        matches
    into
        @report_commit_id,
        @ext_trade_id,
        @report_trade_id,
        @trade_id,
        @id_match,
        @match_strength,
        @effective_strength,
        @status_id
end

/*
select
    message = "Matches",
    a.report_commit_id,
    a.ext_trade_id,
    ext_trade_used = b.used,
    ext_trade_inverted = b.inverted,
    a.trade_id,
    a.id_match,
    a.match_strength,
    marks = convert(varchar(25), a.marks),
    status = aa.name
from
    #matches a
left outer join
    statuses aa
        on a.status_id = aa.status_id
join
    #ext_trades b
        on a.ext_trade_id = b.id
 */


/* DIAGNOSTICS */ insert into 
    #messages
