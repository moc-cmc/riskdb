drop procedure r_tallytradebatch
go

create procedure
	r_tallytradebatch
		@login varchar(50),
		@batch_id int
as


declare @batch_trade_id int
declare @batch_trades int

declare @trade_id int
declare @deal_id int
declare @price float
declare @trade_date datetime
declare @price_style varchar(50)
declare @quantity numeric(30,4)
declare @contract_id int
declare @symbol varchar(50)
declare @value_date datetime
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @internal_account varchar(50)
declare @external_account varchar(50)
declare @counterparty varchar(50)
declare @trader varchar(50)
declare @strategy varchar(50)
declare @status varchar(50)
declare @broker varchar(50)
declare @identifier varchar(50)
declare @sales_code varchar(50)


exec
	j_nextkey
		"deals",
		@deal_id output

select
	@batch_trade_id = 0
select
	@batch_trades = count(*)
from
	batch_trades
where
	batch_id = @batch_id
and
	batch_trade_id > @batch_trade_id


while @batch_trades > 0
begin
	select
		@batch_trade_id = min(batch_trade_id)
	from
		batch_trades
	where
		batch_id = @batch_id
	and
		batch_trade_id > @batch_trade_id


	select
		@symbol = a.symbol,
		@price = b.price,
		@quantity = b.quantity,
		@contract_id = b.contract_id,
		@trade_date = b.trade_date,
		@value_date = b.value_date
	from
		contracts a,
		batch_trades b
	where
		a.contract_id = b.contract_id
	and
		b.batch_trade_id = @batch_trade_id

	select
		@price_style = NULL

	select
		@price_style = a.name
	from
		price_styles a,
		contract_price_styles b
	where
		a.price_style_id = b.price_style_id
	and
		b.contract_id = @contract_id

	if @price_style = "Inverted"
		select
			@price = 1.0 / @price

	select
		@trade_type = b.name,
		@tally_type = b.name,
		@internal_account = c.symbol,
		@external_account = d.symbol,
		@counterparty = e.name,
		@trader = f.symbol,
		@strategy = g.name,
		@status = h.name,
		@broker = i.symbol,
		@identifier = a.identifier,
		@sales_code = j.name
	from
		batch_trades a,
		trade_types b,
		internal_accounts c,
		external_accounts d,
		counterparties e,
		traders f,
		strategies g,
		statuses h,
		brokers i,
		sales_codes j
	where
		a.trade_type_id = b.trade_type_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.external_account_id = d.external_account_id
	and
		a.counterparty_id = e.counterparty_id
	and
		a.trader_id = f.trader_id
	and
		a.strategy_id = g.strategy_id
	and
		a.status_id = h.status_id
	and
		a.broker_id = i.broker_id
	and
		a.sales_code_id = j.sales_code_id
	and
		a.batch_trade_id = @batch_trade_id

	select
		@trade_id = NULL

	exec
		fxa_tallytrade
			@login = @login,
			@source = "MPT Manual Tally",	
			@trade_id = @trade_id output,
			@deal_id = @deal_id,
			@tally_type = @tally_type,
			@trade_type = @trade_type,
			@deal_type = "Internal",
			@quantity = @quantity,
			@symbol = @symbol,
			@trade_date = @trade_date,
			@value_date = @value_date,
			@price = @price,
			@internal_account = @internal_account,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@trader = @trader,
			@strategy = @strategy,
			@status = @status,
			@broker = @broker,
			@identifier = @identifier,
			@sales_code = @sales_code

	select
		@batch_trades = count(*)
	from
		batch_trades
	where
		batch_id = @batch_id
	and
		batch_trade_id > @batch_trade_id
end


go
