create or replace procedure
	rkv2_authsource
		@login varchar(100),
		@run_filter varchar(200),
		@source_id int = NULL output
as

/*
rkapi v2 shared preamble: resolve the outbound source linked to a run,
re-checking first that the login is granted that run. Trade
notifications are queued per source by the standard pipeline
(trade_notifiers -> trade_notifications), and run_outbound_sources
links a run to the one source that carries its notifications. Runs
after rkv2_authrun in every notifications proc and repeats the whole
grant lookup from the login and run name (tico_accounts -> user_runs
-> runs) rather than trusting a run id it was handed.

Caller contract:

	exec
		rkv2_authrun
			@login = @login,
			@run_filter = @run_filter,
			@run_id = @run_id output
	if @run_id = NULL
		return

	exec
		rkv2_authsource
			@login = @login,
			@run_filter = @run_filter,
			@source_id = @source_id output
	if @source_id = NULL
		return

No return status codes (house rule: all returns register as clean;
callers inspect output). @source_id is the success signal: NULL on
failure, after this proc emits its own error row - the caller just
returns without emitting another result set. A failed grant re-check
reads as "Could not find run" (unentitled == nonexistent); a granted
run with no link names the real condition (not configured for
notifications) instead, since the run is already known to be the
caller's.
*/

declare @run_id int

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_filter

if @run_id = NULL
begin
	select
		error = "Error",
		msg = "Could not find run"
	return
end

select
	@source_id = a.source_id
from
	run_outbound_sources a,
	sources b
where
	a.source_id = b.source_id
and
	a.run_id = @run_id

if @source_id = NULL
begin
	select
		error = "Error",
		msg = "Notifications are not configured for this run"
	return
end

return
go
