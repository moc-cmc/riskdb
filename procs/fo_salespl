create table
	#net_prems(
		product_id int,
		premium float NULL,
		equiv float NULL)
insert into
	#net_prems
select
	product_id,
	sum(premium),
	sum(equiv)
from
	#premiums
where
	product_id != NULL
group by
	product_id

create table
	#total_balances(
		id int identity,
		style varchar(250) NULL,
		product_id int NULL,
		balance float NULL,
		premium float NULL,
		total float NULL,
		currency varchar(50) NULL,
		market_rate float NULL,
		display_market_rate float NULL,
		equiv float NULL)
insert into
	#total_balances(
		product_id,
		balance)
select
	product_id,
	sum(balance)
from
	#balances
group by
	product_id

insert into
	#total_balances(
		product_id,
		premium)
select
	product_id,
	premium
from
	#net_prems
where
	product_id not in(
		select
			product_id
		from
			#balances) 


update
	#total_balances
set
	balance = 0.0
where
	balance = NULL

update
	#total_balances
set
	premium = 0.0
where
	premium = NULL

update
	#total_balances
set
	a.premium = b.premium
from
	#total_balances a,
	#net_prems b
where
	a.product_id = b.product_id 

update
	#total_balances
set
	total = balance + premium

update
	#total_balances
set
	a.market_rate = b.rate,
	a.display_market_rate = b.display_rate,
	a.equiv = a.total * b.rate
from
	#total_balances a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id


update
	#total_balances
set
	a.currency = b.symbol
from
	#total_balances a,
	products b
where
	a.product_id = b.product_id

update
	#total_balances
set
	style = @style

select
	@total_equiv = NULL
select
	@total_equiv = sum(equiv)
from
	#total_balances

insert into
	#total_balances(
		style,
		currency,
		equiv)
values(
	@total_style,
	"Total",
	@total_equiv)

