insert into
	#trades(
		trade_id,
		deal_id,
		trade_date,
		external_account_id,
		strategy_id,
		trader_id,
		counterparty_id,
		broker_id,
		contract_id,
		value_date,
		price,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		rate,
		status_id)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	a.external_account_id,
	a.strategy_id,
	a.trader_id,
	a.counterparty_id,
	a.broker_id,
	a.contract_id,
	a.value_date,
	a.price,
	h.product_id,
	a.quantity,
	h.currency_id,
	a.quantity * a.price * -1.0,
	a.price,
	a.status_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	forwards h
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
