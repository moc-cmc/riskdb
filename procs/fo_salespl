create table
	#contracts(
		contract_id int,
		product_id int NULL,
		currency_id int NULL)
insert into
	#contracts(
		contract_id)
select
	distinct(display_contract_id)
from
	#trades

update
	#contracts
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#contracts a,
	forwards b
where
	a.contract_id = b.contract_id

delete

from
	#contracts
where
	product_id = @evaluation_currency_id

delete

from
	#contracts
where
	currency_id = @evaluation_currency_id

select
	@contract_id = 0
select
	@contracts = count(*)
from
	#contracts
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#contracts
	where
		contract_id > @contract_id

	select
		@product_id = NULL,
		@currency_id = NULL,
		@product_rate = NULL,
		@currency_rate = NULL,
		@timestamp = NULL,
		@derived_timestamp = NULL,
		@product_style = NULL,
		@currency_style = NULL,
		@derived_rate = NULL

	select
		@product_id = product_id,
		@currency_id = currency_id
	from
		#contracts
	where
		contract_id = @contract_id

	select
		@product_rate = display_rate,
		@timestamp = timestamp,
		@product_style = price_style
	from
		#rates
	where
		product_id = @product_id
	and
		currency_id = @evaluation_currency_id

	select
		@currency_rate = display_rate,
		@derived_timestamp = timestamp,
		@currency_style = price_style
	from
		#rates
	where
		product_id = @currency_id
	and
		currency_id = @evaluation_currency_id

	if @product_style = @currency_style
	begin
		select
			@derived_rate = round(@product_rate, 5) / round(@currency_rate, 5)
	end
	if @product_style != @currency_style
	begin
		select
			@derived_rate = round(@product_rate, 5) * round(, @currency_rate, 5)
	end

	insert into
		#rates(
			contract_id,
			product_id,
			currency_id,
			rate,
			timestamp,
			derived_timestamp)
	values(
		@contract_id,
		@product_id,
		@currency_id,
		@derived_rate,
		@timestamp,
		@derived_timestamp)
		
	select
		@contracts = count(*)
	from
		#contracts
	where
		contract_id > @contract_id
end
		
update
	#rates
set
	display_rate = rate 

update
	#rates
set
	a.display_rate = 1.0 / a.rate,
	a.price_style = "Inverted"
from
	#rates a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"


update
	#trades
set
	product_equiv = product_qty
where
	product_id = @evaluation_currency_id
update
	#trades
set
	currency_equiv = currency_qty
where
	currency_id = @evaluation_currency_id


update
	#trades
set
	a.product_equiv = a.product_qty * b.rate
from
	#trades a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

update
	#trades
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#trades a,
	#rates b
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

update
	#trades
set
	total_equiv = product_equiv + currency_equiv

create table
	#grouped_trades(
		deal_id int,
		external_account_id int NULL,
		sales_pl float)
insert into
	#grouped_trades(
		deal_id,
		sales_pl)
select
	deal_id,
	sum(total_equiv)
from
	#trades
where
	broker_id = @manual_tally_broker_id
group by
	deal_id

update
	#grouped_trades
set
	a.external_account_id = b.external_account_id
from
	#grouped_trades a,
	#trades b
where
	a.deal_id = b.deal_id
and
	b.external_account_type = "Client"

update
	#option_trades
set
	a.volume = abs(a.quantity) * b.rate
from
	#option_trades a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

create table
	#option_volumes(
		external_account_id int,
		volume float NULL,
		sales_pl float NULL)
insert into
	#option_volumes
select
	a.external_account_id,
	sum(a.volume),
	sum(a.sales_pl)
from
	#option_trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
group by
	a.external_account_id



create table
	#client_pls(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULl,
		account varchar(50) NULL,
		fwd_volume float NULL,
		fwd_sales_pl float NULL,
		option_volume float NULL,
		option_sales_pl float NULL,
		total_volume float NULL,
		total_sales_pl float NULL)

insert into
	#client_pls(
		external_account_id,
		fwd_volume,
		fwd_sales_pl)
select
	a.external_account_id, 
	sum(abs(a.product_equiv)),
	sum(a.sales_pl)
from
	#trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
group by
	a.external_account_id

insert into
	#client_pls(
		external_account_id,
		fwd_volume,
		fwd_sales_pl)
select
	external_account_id,
	fwd_volume = 0.0,
	sales_pl = 0.0
from
	#option_volumes
where
	external_account_id not in(
		select
			external_account_id
		from
			#client_pls)
	
update
	#client_pls
set
	option_volume = 0.0,
	option_sales_pl = 0.0

update
	#client_pls
set
	a.option_volume = b.volume,
	a.option_sales_pl = b.sales_pl
from
	#client_pls a,
	#option_volumes b
where
	a.external_account_id = b.external_account_id

update
	#client_pls
set
	option_volume = 0.0
where
	option_volume = NULL

update
	#client_pls
set
	option_sales_pl = 0.0
where
	option_sales_pl = NULL
	
