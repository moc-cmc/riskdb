create table
	#option_trades(
		trade_id int,
		deal_id int,
		trade_date datetime,
		strategy_id int,
		external_account_id int,
		contract_id int,
		quantity numeric(30,4),
		price float,
		value_date datetime,
		product_id int NULL,
		volume float NULL,
		sales_pl float NULL)
insert into
	#option_trades(
		trade_id,
		deal_id,
		trade_date,
		strategy_id,
		external_account_id,
		contract_id,
		quantity,
		price,
		value_date)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	a.strategy_id,
	a.external_account_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.value_date
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	option_contracts h,
	trade_types i
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_type_id = i.trade_type_id
and
	i.name != "Option Closeout"
and
	a.value_date >= @begin_date
and
	a.trade_date >= @trades_begin
and
	a.trade_date < @end_date

update
	#option_trades
set
	a.product_id = e.product_id
from
	#option_trades a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id

update
	#option_trades
set
	sales_pl = 0.0

update
	#option_trades
set
	a.sales_pl = b.sales_pl
from
