create table
	#pb_fees(
		prime_broker_id int,
		fee_schedule varchar(100) NULL,
		fee float NULL,
		fee_schedule_id int NULL,
		currency_id int NULL)
insert into
	#pb_fees(
		prime_broker_id)
select
	prime_broker_id
from
	prime_brokers

update
	#pb_fees
set
	fee = 0.0

update
	#pb_fees
set
	a.fee = c.fee_price,
	a.fee_schedule = c.name,
	a.fee_schedule_id = c.fee_schedule_id,
	a.currency_id = c.fee_product_id
from
	#pb_fees a,
	external_account_prime_brokers b,
	fee_schedules c,
	transaction_types d,
	fee_schedule_types e
where
	a.prime_broker_id = b.prime_broker_id
and
	b.external_account_id = c.external_account_id
and
	c.fee_type_id = d.transaction_type_id
and
	d.name = "Prime Brokerage Fee"
and
	c.fee_schedule_type_id = e.fee_schedule_type_id
and
	e.name = "Agency Pips"

