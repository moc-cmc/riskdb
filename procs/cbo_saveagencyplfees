	#deals a,
	external_account_prime_brokers b,
	#pb_fees c
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = c.prime_broker_id

update
	#deals
set
	net_product = dealt_amount + fill_dealt,
	net_currency = counter_amount + fill_counter



select
	@id = 0
select
	@ids = count(*)
from
	#deals
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#deals
	where
		id > @id

	select
		@deal_id = NULL,
		@trade_id = NULL,
		@net_product = NULL,
		@net_currency = NULL,
		@ps_sched_id = NULL,
		@taker_exec_fee = NULL,
		@taker_exec = NULL,
		@taker_exec_ccy_id = NULL,
		@te_sched_id = NULL,
		@maker_exec_fee = NULL,
		@maker_exec = NULL,
		@maker_exec_ccy_id = NULL,
		@me_sched_id = NULL,
		@taker_pb_fee = NULL,
		@taker_pb = NULL,
		@taker_pb_ccy_id = NULL,
		@tp_sched_id = NULL,
		@maker_pb_fee = NULL,
		@maker_pb = NULL,
		@maker_pb_ccy_id = NULL,
		@mp_sched_id = NULL,
		@taker_broker_fee = NULL,
		@taker_broker = NULL,
		@taker_broker_ccy_id = NULL,
		@tb_sched_id = NULL,
		@maker_broker_fee = NULL,
		@maker_broker = NULL,
		@maker_broker_ccy_id = NULL,
		@mb_sched_id = NULL,
		@client_account_id = NULL,
		@fill_account_id = NULL,
		@currency_id = NULL,
		@client_trade_id = NULL,
		@fill_trade_id = NULL

	select
		@deal_id = deal_id,
		@trade_id = fill_trade_id,
		@net_product = net_product,
		@net_currency = net_currency,
		@ps_sched_id = ps_sched_id,
		@taker_exec_fee = taker_exec_fee,
		@taker_exec = taker_exec,
		@taker_exec_ccy_id = taker_exec_ccy_id,
		@te_sched_id = te_sched_id,
		@maker_exec_fee = maker_exec_fee,
		@maker_exec = maker_exec,
		@maker_exec_ccy_id = maker_exec_ccy_id,
		@me_sched_id = me_sched_id,
		@taker_pb_fee = taker_pb_fee,
		@taker_pb = taker_pb,
		@taker_pb_ccy_id = taker_pb_ccy_id,
		@tp_sched_id = tp_sched_id,
		@maker_pb_fee = maker_pb_fee,
		@maker_pb = maker_pb,
		@maker_pb_ccy_id = maker_pb_ccy_id,
		@mp_sched_id = mp_sched_id,
		@taker_broker_fee = taker_broker_fee,
		@taker_broker = taker_broker,
		@taker_broker_ccy_id = taker_broker_ccy_id,
		@tb_sched_id = tb_sched_id,
		@maker_broker_fee = maker_broker_fee,
		@maker_broker = maker_broker,
		@maker_broker_ccy_id = maker_broker_ccy_id,
		@mb_sched_id = mb_sched_id,
		@client_account_id = external_account_id,
		@fill_account_id = fill_ext_account_id,
		@currency_id = currency_id,
		@client_trade_id = trade_id,
		@fill_trade_id = fill_trade_id
	from
		#deals
	where
		id = @id

	if abs(@net_product) > 0.0
	begin
		select
			msg = "Encountered residual dealt amount",
			deal_id = @deal_id
	end

	if abs(@net_currency) > 0.0
	begin
		select
			@fee_schedule = name
		from
			fee_schedules
		where
			fee_schedule_id = @ps_sched_id

		select
			@transaction_type = name
		from
			transaction_types
		where
			transaction_type_id = @spread_transaction_type_id

		select
			@currency = symbol
		from
			products
		where
			product_id = @currency_id

		select
			@client_account = symbol
		from
			external_accounts
		where
			external_account_id = @client_account_id

		select
			@fill_account = symbol
		from
			external_accounts
		where
			external_account_id = @fill_account_id

		exec
			api_saveagencypipfees
				@login = @login,
				@fee_schedule = @fee_schedule,
				@trade_date = @trade_date,
				@client_trade_id = @client_trade_id,
				@fill_trade_id = @fill_trade_id,
				@client_account = @client_account,
				@fill_account = @fill_account,
				@amount = @net_currency,
				@currency = @currency,
				@client_transaction_id = @client_transaction_id output,
				@fill_transaction_id = @fill_transaction_id output

	end
		
	if abs(@taker_exec_fee) > 0.0
	begin
		select
			@fee_schedule = @taker_exec

		select
			@currency = symbol
		from
			products
		where
			product_id = @taker_exec_ccy_id

		select
			@client_account = symbol
		from
			external_accounts
		where
			external_account_id = @client_account_id

		select
			@fill_account = symbol
		from
			external_accounts
		where
			external_account_id = @fill_account_id

		/* flip sign to charge client */
		select
			@taker_exec_fee = @taker_exec_fee * -1.0 
		exec
			api_saveagencypipfees
				@login = @login,
				@fee_schedule = @fee_schedule,
				@trade_date = @trade_date,
				@client_trade_id = @client_trade_id,
