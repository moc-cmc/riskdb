create table
	#client_deals(
		deal_id int NULL,
		trade_id int NULL,
		internal_account_id int NULL,
		external_account_id int NULL,
		account_type varchar(50) NULL,
		counterparty_id int NULL,
		trader_id int NULL,
		strategy_id int NULL,
		broker_id int NULL,
		product_id int NULL,
		currency_id int NULL,
		value_date datetime NULL,
		dealt_amount float NULL,
		counter_amount float NULL,
		legs int NULL)
insert into
	#client_deals(
		deal_id,
		trade_id,
		internal_account_id,
		external_account_id,
		account_type,
		counterparty_id,
		trader_id,
		strategy_id,
		broker_id,
		product_id,
		currency_id,
		value_date,
		dealt_amount,
		counter_amount,
		legs)
select
	a.deal_id,
	min(a.trade_id),
	a.internal_account_id,
	a.external_account_id,
	d.name,
	a.counterparty_id,
	a.trader_id,
	a.strategy_id,
	a.broker_id,
	b.product_id,
	b.currency_id,
	a.value_date,
	sum(a.quantity),
	sum(a.quantity * a.price * -1.0),
	count(a.trade_id)
from
	trades a,
	forwards b,
	external_accounts c,
	external_account_types d
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	c.external_account_type_id = d.external_account_type_id
and
	d.name = "Client"
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.value_date > @begin_date
group by
	a.deal_id,
	a.internal_account_id,
	a.external_account_id,
	d.name,
	a.counterparty_id,
	a.trader_id,
	a.strategy_id,
	a.broker_id,
	b.product_id,
	b.currency_id,
	a.value_date


