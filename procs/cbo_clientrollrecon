drop procedure
	cbo_clientrollrecon
go

create procedure
	cbo_clientrollrecon
		@login varchar(50),
		@value_date datetime=NULL
as


declare @fund_id int
declare @fund varchar(100)
declare @roll_trader_id int
declare @roll_trader varchar(50)
declare @roll_trader_login varchar(50)
declare @roll_trader_account_id int

declare @total_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

declare @ids int
declare @id int
declare @contract_id int
declare @closing_quantity numeric(30,4)
declare @roll_quantity numeric(30,4)
declare @roll_native_value float
declare @closing_native_value float

declare @batch_id int
declare @queued_roll_id int
declare @account varchar(50)
declare @near_quantity numeric(30,4)
declare @far_quantity numeric(30,4)
declare @dealt_currency varchar(50)
declare @counter_currency varchar(50)
declare @ccy varchar(50)
declare @near_date datetime
declare @far_date datetime
declare @near_price float
declare @far_price float
declare @deal_id int
declare @trade_date datetime



exec
	cbo_setdefinedrollrates
		@login,
		@value_date

exec
	cbo_clientrollreconlinks
		@login


select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold",
	@total_style = "background:#FFFFFF;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@selected_trade_style = "background:#F7F4C1;border: 1px solid white"


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@fund = name
from
	funds
where
	fund_id = @fund_id

select	
	@roll_trader_id = roll_trader_id
from
	fund_roll_traders
where
	fund_id = @fund_id


select
	@roll_trader = symbol,
	@roll_trader_account_id = tico_account_id
from
	traders
where
	trader_id = @roll_trader_id
if @roll_trader = NULL
begin
	select
		status = "Error",
		message = "Roll trader not found"
	return
end

select
	@roll_trader_login = login
from
	tico_accounts
where
	account_id = @roll_trader_account_id


create table
	#market_rolls(
		style varchar(250) NULL,
		deal_id int,
		trade_date datetime NULL,
		external_account_id int,
		account_type varchar(50) NULL,
		closing_trade_id int,
		closing_quantity numeric(30,4),
		contract_id int,
		closing_rate float,
		closing_date datetime,
		roll_trade_id int NULL,
		roll_quantity numeric(30,4) NULL,
		roll_rate float NULL,
		roll_date datetime NULL)

insert into
	#market_rolls(
		deal_id,
		trade_date, 
		external_account_id,
		account_type,
		closing_trade_id,
		contract_id,
		closing_quantity,
		closing_rate,
		closing_date)
select
	a.deal_id,
	a.trade_date,
	a.external_account_id,
	c.name,
	a.trade_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.value_date
from
	trades a,
	external_accounts b,
	external_account_types c,
	trade_types d
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	a.trade_type_id = d.trade_type_id
/* and
	c.name = "Counterparty" */
and
	d.name = "Swap Near"
and
	a.trader_id = @roll_trader_id
and
	convert(date, a.value_date) = convert(date, @value_date)

update
	#market_rolls
set
	style = @pb_style
where
	account_type = "Counterparty"

update
	#market_rolls
set
	style = @client_style
where
	account_type = "Client"


create table
	#roll_legs(
		deal_id int,
		trade_id int)
insert into
	#roll_legs
select
	a.deal_id,
	a.trade_id
from
	trades a,
	#market_rolls b
where
	a.deal_id = b.deal_id

delete
	#roll_legs
from
	#roll_legs a,
	#market_rolls b
where
	a.trade_id = b.closing_trade_id

update
	#market_rolls
set
	a.roll_trade_id = b.trade_id
from
	#market_rolls a,
	#roll_legs b
where
	a.deal_id = b.deal_id


update
	#market_rolls
set
	a.roll_date = b.value_date,
	a.roll_rate = b.price,
	a.roll_quantity = b.quantity
from
	#market_rolls a,
	trades b
where
	a.roll_trade_id = b.trade_id



create table
	#client_accounts(
		external_account_id int)

insert into
	#client_accounts
select
	a.external_account_id
from
	external_accounts a,
	external_account_prime_brokers b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	a.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"





create table
	#trades(
		trade_id int,
		contract_id int,
		external_account_id int,
		trader_id int,
		status_id int,
		quantity numeric(30, 4),
		price float
		)

insert into
	#trades
select
	a.trade_id,
	a.contract_id,
	a.external_account_id,
	a.trader_id,
	a.status_id,
	a.quantity,
	a.price
from
	trades a,
	#client_accounts b
where
	a.external_account_id = b.external_account_id
and 
	convert(date, a.value_date) = convert(date, @value_date)


create table
	#client_positions(
		id int identity,
		external_account_id int,
		contract_id int,
		quantity numeric(30,4),
		closing_date datetime NULL,
		closing_rate float NULL,
		roll_date datetime NULL,
		roll_rate float NULL)
insert into
	#client_positions(
		external_account_id,
		contract_id,
		quantity)
select
	a.external_account_id,
	a.contract_id,
	sum(a.quantity)
from
	#trades a,
	forwards b,
	#client_accounts d,
	statuses e
where
	a.contract_id = b.contract_id
and
	a.external_account_id = d.external_account_id
and
	a.status_id = e.status_id
and
	e.name != "Resid"
group by
	a.external_account_id,
	a.contract_id

update
	#client_positions
set
	closing_date = @value_date


create table
	#client_balances(
		id int identity,
		section varchar(250) NULL,
		style varchar(250) NULL,
		trade_date datetime NULL,
		external_account_id int NULL,
		roll_spread_group_id int NULL,
		spread varchar(50) NULL,
		account varchar(50) NULL,
		settlement_style varchar(50) NULL,
		contract_id int NULL,
		product_id int NULL,
		dealt_currency varchar(50) NULL,
		currency_id int NULL,
		counter_currency varchar(50) NULL,
		symbol varchar(50) NULL,
		position numeric(30,4) NULL,
		roll_amount numeric(30,4) NULL,
		closing_date varchar(11) NULL,
		closing_rate float NULL,
		rolled_amount numeric(30,4) NULL,
		roll_date varchar(11) NULL,
		roll_rate float NULL,
		spread_rate float NULL,
		allocate varchar(50) NULL)
insert into
	#client_balances(
		section,
		style,
		external_account_id,
		account,
		settlement_style,
		contract_id,
		symbol,
		position,
		roll_amount,
		closing_date,
		closing_rate,
		roll_date,
		roll_rate)
select
	section = "Client Balances",
	style = "background:#FFFFFF;border: 1px solid white",
	c.external_account_id,
	account = c.symbol,
	d.name,
	a.contract_id,
	a.symbol,
	position = b.quantity,
	roll_amount = b.quantity,
	closing_date = convert(varchar(11), b.closing_date, 1),	
	b.closing_rate,
	roll_date = convert(varchar(11), b.roll_date, 1),
	b.roll_rate
from
	contracts a,
	#client_positions b,
	external_accounts c,
	settlement_methods d
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	c.settlement_method_id = d.settlement_method_id
order by
	c.symbol,
	a.symbol

update
	#client_balances
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#client_balances a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#client_balances
set
	a.dealt_currency = b.symbol
from
	#client_balances a,
	products b
where
	a.product_id = b.product_id

update
	#client_balances
set
	a.counter_currency = b.symbol
from
	#client_balances a,
	products b
where
	a.currency_id = b.product_id


/* default the spread group to No Spread */
update
	#client_balances
set
	a.roll_spread_group_id = b.roll_spread_group_id
from
	#client_balances a,
	roll_spread_groups b
where
	b.name = "No Spread"

update
	#client_balances
set
	a.roll_spread_group_id = b.roll_spread_group_id
from
	#client_balances a,
	account_roll_spread_groups b
where
	a.external_account_id = b.external_account_id


update
	#client_balances
set
	a.spread = b.name
from
	#client_balances a,
	roll_spread_groups b
where
	a.roll_spread_group_id = b.roll_spread_group_id


delete

from
	#client_balances
where
	settlement_style != "Roll"


create table
	#roll_rates(
		contract_id int,
		trade_date datetime NULL,
		closing_date datetime NULL,
		net_long numeric(30,4) NULL,
		long_pbs int NULL,
		closing_rate_long float NULL,
		net_short numeric(30,4) NULL,
		short_pbs int NULL,
		closing_rate_short float NULL,
		roll_date datetime NULL,
		roll_rate_long float NULL,
		roll_rate_short float NULL)
insert into
	#roll_rates(
		contract_id,
		trade_date,
		closing_date,
		net_long,
		closing_rate_long,
		net_short,
		closing_rate_short,
		roll_date,
		roll_rate_long,
		roll_rate_short)
select
	contract_id,
	trade_date,
	closing_date,
	net_long,
	closing_rate_long,
	net_short,
	closing_rate_short,
	roll_date,
	roll_rate_long,
	roll_rate_short
from
	defined_roll_rates
where
	convert(date, closing_date) = convert(date, @value_date)
		
update
	#roll_rates
set
	a.trade_date = b.trade_date,
	a.closing_date = b.closing_date,
	a.closing_rate_long = b.closing_rate_long,
	a.closing_rate_short = b.closing_rate_short,
	a.roll_date = b.roll_date,
	a.roll_rate_long = b.roll_rate_long,
	a.roll_rate_short = b.roll_rate_short
from
	#roll_rates a,
	roll_rate_overrides b
where
	a.contract_id = b.contract_id
and
	a.closing_date = b.closing_date


/* Use defined roll rates rather than the market rolls */
update
	#client_balances
set
	a.trade_date = b.trade_date,
	a.closing_rate = b.closing_rate_long,
	a.roll_date = b.roll_date,
	a.roll_rate = b.roll_rate_short
from
	#client_balances a,
	#roll_rates b
where
	a.contract_id = b.contract_id
and
	a.closing_date = b.closing_date
and
	sign(a.roll_amount) > 0.0


update
	#client_balances
set
	a.trade_date = b.trade_date,
	a.closing_rate = b.closing_rate_short,
	a.roll_date = b.roll_date,
	a.roll_rate = b.roll_rate_long
from
	#client_balances a,
	#roll_rates b
where
	a.contract_id = b.contract_id
and
	a.closing_date = b.closing_date
and
	sign(a.roll_amount) < 0.0



update
	#client_balances
set
	a.spread_rate = a.roll_rate - b.spread
from
	#client_balances a,
	contract_roll_spreads b
where
	a.contract_id = b.contract_id
and
	a.roll_spread_group_id = b.roll_spread_group_id
and
	sign(a.position) > 0


update
	#client_balances
set
	a.spread_rate = a.roll_rate + b.spread
from
	#client_balances a,
	contract_roll_spreads b
where
	a.contract_id = b.contract_id
and
	a.roll_spread_group_id = b.roll_spread_group_id
and
	sign(a.position) < 0


/* create an output table for roll display */
create table
	#roll_output(
		id int identity,
		style varchar(250) NULL,
		deal_id int NULL,
		account varchar(50) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		closing_native_value float NULL,
		closing_native_pl float NULL,
		closing_quantity numeric(30,4) NULL,
		closing_date datetime NULL,
		closing_rate float NULL,
		roll_rate float NULL,
		roll_date datetime NULL,
		roll_quantity numeric(30,4) NULL,
		roll_native_value float NULL,
		roll_native_pl float NULL,
		ccy varchar(50) NULL)


/* create a summary table of market roll data */
create table
	#roll_data(
		style varchar(250) NULL,
		contract_id int,
		symbol varchar(50) NULL,
		closing_date datetime NULL,
		closing_rate_long float NULL,
		closing_rate_short float NULL,
		set_close varchar(25) NULL,
		roll_date datetime NULL,
		roll_rate_long float NULL,
		set_long varchar(25) NULL,
		roll_rate_short float NULL,
		set_short varchar(25) NULL)

insert into
	#roll_data(
		contract_id)
select
	distinct(contract_id)
from
	#client_balances

update
	#roll_data
set
	a.symbol = b.symbol
from
	#roll_data a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#roll_data
set
	style = @style,
	closing_date = @value_date

update
	#roll_data
set
	a.closing_rate_short = b.closing_rate,
	a.roll_date = b.roll_date,
	a.roll_rate_long = b.roll_rate
from
	#roll_data a,
	#market_rolls b
where
	a.contract_id = b.contract_id
and
	b.account_type = "Counterparty"
and
	sign(b.closing_quantity) > 0

		
update
	#roll_data
set
	a.closing_rate_long = b.closing_rate,
	a.roll_date = b.roll_date,
	a.roll_rate_short = b.roll_rate
from
	#roll_data a,
	#market_rolls b
where
	a.contract_id = b.contract_id
and
	b.account_type = "Counterparty"
and
	sign(b.closing_quantity) < 0

		

/* Create a net rolls summary table */
create table
	#booked_rolls(
		id int identity,
		style varchar(250) NULL,
		deal_id int NULL,
		account varchar(50) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		closing_native_value float NULL,
		closing_quantity numeric(30,4) NULL,
		closing_date datetime NULL,
		closing_rate float NULL,
		roll_rate float NULL,
		roll_date datetime NULL,
		roll_quantity numeric(30,4) NULL,
		roll_native_value float NULL)
insert into
	#booked_rolls(
		style,
		deal_id,
		account,
		contract_id,
		symbol,
		closing_quantity,
		closing_date,
		closing_rate,
		roll_rate,
		roll_date,
		roll_quantity)
select
	a.style,
	a.deal_id,
	account = b.symbol,
	c.contract_id,
	c.symbol,
	a.closing_quantity,
	closing_date = convert(varchar(12), a.closing_date),
	a.closing_rate,
	a.roll_rate,
	roll_date = convert(varchar(12), a.roll_date),
	a.roll_quantity
from
	#market_rolls a,
	external_accounts b,
	contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
order by
	c.symbol,
	a.account_type desc,
	b.symbol

update
	#booked_rolls
set
	roll_native_value = roll_quantity * roll_rate * -1.0,
	closing_native_value = closing_quantity * closing_rate * -1.0

create table
	#contracts(
		id int identity,
		contract_id int NULL,
		symbol varchar(50))
insert into
	#contracts(
		symbol)
select
	distinct(symbol)
from
	#booked_rolls
order by
	symbol

update
	#contracts
set
	a.contract_id = b.contract_id
from
	#contracts a,
	contracts b
where
	a.symbol = b.symbol

select
	@id = 0
select
	@ids = count(*)
from
	#contracts
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#contracts
	where
		id > @id

	select
		@contract_id = NULL,
		@closing_native_value = NULL,
		@closing_quantity = NULL,
		@closing_native_value = NULL,
		@roll_quantity = NULL,
		@roll_native_value = NULL

	select
		@contract_id = contract_id
	from
		#contracts
	where
		id = @id

	insert into
		#roll_output(
			style,
			deal_id,
			account,
			contract_id,
			symbol,
			closing_native_value,
			closing_quantity,
			closing_date,
			closing_rate,
			roll_rate,
			roll_date,
			roll_quantity,
			roll_native_value)
	select
		style,
		deal_id,
		account,
		contract_id,
		symbol,
		closing_native_value,
		closing_quantity,
		closing_date,
		closing_rate,
		roll_rate,
		roll_date,
		roll_quantity,
		roll_native_value
	from
		#booked_rolls
	where
		contract_id = @contract_id
	order by
		id

	select
		@closing_native_value = sum(closing_native_value),
		@closing_quantity = sum(closing_quantity),
		@roll_quantity = sum(roll_quantity),
		@roll_native_value = sum(roll_native_value)
	from
		#roll_output
	where
		contract_id = @contract_id

	select
		@ccy = b.symbol
	from
		forwards a,
		products b
	where
		a.currency_id = b.product_id
	and
		a.contract_id = @contract_id

		
	insert into
		#roll_output(
			style,
			account,
			closing_native_pl,
			closing_quantity,
			roll_quantity,
			roll_native_pl,
			ccy)
	values(
		@total_style,
		"Total",
		@closing_native_value,
		@closing_quantity,
		@roll_quantity,
		@roll_native_value,
		@ccy)

	select
		@ids = count(*)
	from
		#contracts
	where
		id > @id
end

exec
	j_nextkey
		"batches",
		@batch_id output

/* queue up valid rolls */
create table
	#valid_rolls(
		id int)
insert into
	#valid_rolls
select
	id
from
	#client_balances
where
	abs(position) > 0
and
	closing_rate != NULL
and
	roll_date != NULL
and
	roll_rate != NULL
and
	spread_rate != NULL
	
select
	@id = 0
select
	@ids = count(*)
from
	#valid_rolls
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#valid_rolls
	where
		id > @id

	select
		@account = NULL,
		@near_quantity = NULL,
		@far_quantity = NULL,
		@dealt_currency = NULL,
		@counter_currency = NULL,
		@near_date = NULL,
		@near_price = NULL,
		@far_date = NULL,
		@far_price = NULL,
		@deal_id = NULL,
		@queued_roll_id = NULL,
		@trade_date = NULL

	select
		@trade_date = trade_date,
		@account = account,
		@near_quantity = roll_amount * -1.0,
		@far_quantity = roll_amount,
		@dealt_currency = dealt_currency,
		@counter_currency = counter_currency,
		@near_date = closing_date,
		@near_price = closing_rate,
		@far_date = roll_date,
		@far_price = spread_rate
	from
		#client_balances
	where
		id = @id

	exec
		j_nextkey
			"queued_rolls",
			@queued_roll_id output

	insert into
		queued_rolls(
			queued_roll_id,
			batch_id,
			trade_date,
			account,
			near_quantity,
			far_quantity,
			dealt_currency,
			counter_currency,
			near_date,
			near_price,
			far_date,
			far_price)
	values(
		@queued_roll_id,
		@batch_id,
		@trade_date,
		@account,
		@near_quantity,
		@far_quantity,
		@dealt_currency,
		@counter_currency,
		@near_date,
		@near_price,
		@far_date,
		@far_price)


	select
		@ids = count(*)
	from
		#valid_rolls
	where
		id > @id
end
	

/****** end queue up valid rolls ***********/


select
	@trade_date = min(trade_date)
from
	#market_rolls

select
	style = @style,
	clear_rolls = "Clear Client Rolls",
	trade_date = @trade_date

select
	section = "Roll Data",
	style = @style,
	b.symbol,
	set_rates = "SET",
	trade_date = convert(varchar(12), a.trade_date),
	closing_date = convert(varchar(12), a.closing_date),
	a.net_long,
	a.closing_rate_long,
	a.net_short,
	a.closing_rate_short,
	roll_date = convert(varchar(12), a.roll_date),
	a.roll_rate_long,
	a.roll_rate_short
from
	#roll_rates a,
	contracts b
where
	a.contract_id = b.contract_id
and
	convert(date, a.closing_date) = convert(date, @value_date)
order by
	b.symbol

select
	section = "Booked Rolls",
	style,
	deal_id,
	account,
	symbol,
	closing_quantity,
	closing_date = convert(varchar(12), closing_date),
	closing_rate,
	closing_spread_pl = closing_native_pl,
	roll_rate,
	roll_date = convert(varchar(12), roll_date),
	roll_quantity,
	roll_spread_pl = roll_native_pl,
	total_spread_pl = closing_native_pl + roll_native_pl,
	ccy
from
	#roll_output
order by
	id

select
	section,
	style,
	account,
	spread,
	symbol,
	position,
	roll_amount,
	closing_date,
	closing_rate,
	roll_date,
	roll_rate,
	spread_rate,
	value_date = convert(varchar(11), @value_date, 1)
from
	#client_balances
where
	abs(position) > 0 
order by
	id

select
	section = "Suggested Client Rolls",
	style = @style,
	account,
	near_quantity,
	far_quantity,
	dealt_currency,
	counter_currency,
	near_date = convert(varchar(12), near_date),
	near_price,
	far_date = convert(varchar(12), far_date),
	far_price
from
	queued_rolls
where
	batch_id = @batch_id
if @@rowcount > 0
	select
		tally_queued_rolls = "Tally Suggested Rolls",
		batch_id = @batch_id


go
