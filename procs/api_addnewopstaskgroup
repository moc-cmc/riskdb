drop procedure api_addnewopstasktype
go

create procedure
	api_addnewopstasktype
		@login varchar(50),
		@name varchar(50)

as

declare @ops_task_type_id int


select
	@ops_task_type_id = ops_task_type_id
from
	ops_task_types
where
	name = @name
if @ops_task_type_id != NULL
begin
	select
		status = "Error",
		message = "Task type already exists",
		name = @name
	return
end

exec 
	j_nextkey 
		"ops_task_types",
		@ops_task_type_id output

insert into
	ops_task_types(
		ops_task_type_id,
		name)
values(
	@ops_task_type_id,
	@name
)
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem adding new task type"
	return
end

select
	status = "success",
	message = "Successfully added new task type",
	name = @name

go
