drop procedure
	r_passengerladder
go

create procedure
	r_passengerladder
		@login varchar(50),
		@session_id varchar(100)
as

declare @min_date datetime
declare @max_date datetime
declare @date datetime
declare @begin_date datetime
declare @end_date datetime
declare @min_value_date datetime
declare @max_value_date datetime

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Column Format",
	"difference",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"quantity",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"report_quantity",
	"Number",
	"#,##0.00")


insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)


select * from #meta

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	a.external_account_id
from
	external_account_prime_brokers a,
	prime_brokers b,
	sources c	
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = c.source_id
and
	c.name = "Morgan Stanley"

	

create table
	#report_balances(
		style varchar(200) NULL,
		product_id int,
		value_date datetime,
		report_quantity numeric(30,4),
		quantity numeric(30,4) NULL,
		difference numeric(30,4) NULL)

insert into
	#report_balances(
		product_id,
		value_date,
		report_quantity)
select
	product_id,
	value_date,
	sum(quantity)
from
	session_report_balances
where
	session_id = @session_id
group by
	product_id,
	value_date


select
	@min_value_date = min(value_date),
	@max_value_date = max(value_date)
from
	session_report_balances
where
	session_id = @session_id

select
	@min_date = min(trade_date)
from
	session_report_balances
where
	session_id = @session_id
exec
	r_daterangefordate
		@min_date,
		@begin_date output,
		@date output

select
	@date = NULL
select
	@max_date = max(trade_date)
from
	session_report_balances
where
	session_id = @session_id
exec
	r_daterangefordate
		@max_date,
		@date output,
		@end_date output


create table
	#product_balances(
		product_id int,
		value_date datetime,
		quantity numeric(30,4))
insert into
	#product_balances
select
	a.product_id,
	b.value_date,
	sum(b.quantity)
from
	forwards a,
	trades b,
	#external_accounts c
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	b.value_date >= @min_value_date
and
	b.value_date <= @max_value_date
and
	b.trade_date >= @begin_date
and
	b.trade_date < @end_date
group by
	a.product_id,
	b.value_date

insert into
	#product_balances
select
	a.currency_id,
	b.value_date,
	sum(b.quantity * price * -1.0)
from
	forwards a,
	trades b,
	#external_accounts c
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	b.value_date >= @min_value_date
and
	b.value_date <= @max_value_date
and
	b.trade_date >= @begin_date
and
	b.trade_date < @end_date
group by
	a.currency_id,
	b.value_date

create table
	#balances(
		product_id int,
		value_date datetime,
		quantity numeric(30,4))
insert into
	#balances
select
	product_id,
	value_date,
	sum(quantity)
from
	#product_balances
group by
	product_id,
	value_date

update
	#report_balances
set
	a.quantity = b.quantity
from
	#report_balances a,
	#balances b
where
	a.product_id = b.product_id
and
	a.value_date = b.value_date


delete
	#balances
from
	#report_balances a,
	#balances b
where
	a.product_id = b.product_id
and
	a.value_date = b.value_date



insert into
	#report_balances(
		product_id,
		value_date,
		report_quantity,
		quantity)
select
	product_id,
	value_date,
	report_quantity = 0.0,
	quantity
from
	#balances	
	
update
	#report_balances
set
	difference = report_quantity - quantity

update
	#report_balances
set
	style = "background:#FFCC99;border: 1px solid white"
where
	abs(difference) >= 0.01

select
	b.style,	
	a.symbol,
	value_date = convert(char(11), b.value_date, 1),
	b.report_quantity,
	b.quantity,
	b.difference
from
	products a,
	#report_balances b
where
	a.product_id = b.product_id
order by
	convert(datetime, b.value_date),
	a.symbol

go
