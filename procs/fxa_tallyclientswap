
if object_id("fxa_tallyclientswap") != NULL
    drop procedure
        fxa_tallyclientswap
go

create procedure
	fxa_tallyclientswap
		@login char(25),
		@client_user varchar(25),
		@client_buys_sells varchar(25),
		@quantity numeric(30,4),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@near_date datetime = NULL,
		@near_price float,	
		@far_date datetime = NULL,
		@far_price float
		
as

declare @deal_id int

exec api_tallyclientswap
		@login,
		@client_user,
		@client_buys_sells,
		@quantity,
		@dealt_currency,
		@counter_currency,
		@near_date,
		@near_price,
		@far_date,
		@far_price,
		@deal_id output,
		NULL,
		NULL


exec
	r_inspectdealtrades
		@login,
		@deal_id


go
