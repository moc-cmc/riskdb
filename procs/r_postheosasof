use
	risk_ram
go

if object_id("r_postheosasof") != NULL
    drop procedure
	r_postheosasof
go


create procedure
	r_postheosasof
		@contract_id int,
		@as_of_date datetime,
		@tv float output,
		@delta float output,
		@gamma float output,
		@theta float output,
		@tau float output
as

declare @timestamp datetime
declare @is_expired int

select @tv = NULL

exec
	r_isexpired
		@contract_id,
		@as_of_date,
		@is_expired output

if @is_expired = 1
begin
	select
		@tv = 0.0,
		@delta = 0.0,
		@gamma = 0.0,
		@theta = 0.0,
		@tau = 0.0
	return
end

/* if @as_of_date < getdate()
begin */
	select
		@tv = tv,
		@delta = delta, 
		@gamma = gamma,
		@theta = theta,
		@tau = tau
	from
		contract_tvs
	where
		contract_id = @contract_id
	and
		tv_date = @as_of_date
/* end */
if @tv = NULL
begin
	select
		@timestamp = timestamp
	from
		current_contract_tvs
	where
		contract_id = @contract_id

	if @as_of_date > dateadd(hour, -7, @timestamp)
	begin
		select
			@tv = tv,
			@delta = delta,
			@gamma = gamma,
			@theta = theta,
			@tau = tau
		from
			current_contract_tvs
		where
			contract_id = @contract_id
	end
end

if @tv = NULL
begin
	select
		@tv = tv,
		@delta = delta,
		@gamma = gamma,
		@theta = theta,
		@tau = tau
	from
		contract_tvs
	where
		contract_id = @contract_id
	and
		tv_date = (select
				max(tv_date)
			from
				contract_tvs
			where
				contract_id = @contract_id
			and
				tv_date <= @as_of_date)
end
			
if @tv = NULL
begin
	select
		@tv = tv,
		@delta = delta,
		@gamma = gamma,
		@theta = theta,
		@tau = tau
	from
		current_contract_tvs
	where
		contract_id = @contract_id
end
go
