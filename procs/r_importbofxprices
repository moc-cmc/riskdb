use
	risk_cc
go

drop procedure
	r_importbofxprices
go

create procedure
	r_importbofxprices
		@login varchar(50),
		@source varchar(50),
		@trade_date datetime,
		@ccy1 varchar(20),
		@ccy2 varchar(20),
		@value_date datetime,
		@price float
as

declare @contract_id int
declare @source_id int
declare @symbol varchar(50)
declare @bo_price_id int


select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end


select
	@symbol = rtrim(@ccy1) + rtrim(@ccy2)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end


if convert(date, @trade_date) = convert(date, @value_date)
begin
	exec
		r_editsettle
			@symbol,
			@trade_date,
			@price

	insert into
		bo_spot_settles(
			contract_id,
			source_id,
			price_date,
			price)
	values(
		@contract_id,
		@source_id,
		@trade_date,
		@price)
end

update
	bo_prices
set
	price = @price
where
	contract_id = @contract_id
and
	source_id = @source_id
and
	convert(date, price_date) = convert(date, @trade_date)
and
	convert(date, value_date) = convert(date, @value_date)
if @@rowcount = 0
begin
	exec
		j_nextkey
			"bo_prices",
			@bo_price_id output

	insert into
		bo_prices(
			bo_price_id,
			contract_id,
			source_id,
			price_date,
			price)
	values(
		@bo_price_id,
		@contract_id,
		@source_id,
		@trade_date,
		@price)
end


go
			

