
drop procedure
	wrap_addextaccountsymbol
go

create procedure
	wrap_addextaccountsymbol
		@login varchar(25),
		@name varchar(150),
		@symbol varchar(100),
		@source varchar(100)

as

exec
	api_addextaccountsymbol
			@login=@login,
			@name=@name,
			@symbol=@symbol,
			@source=@source


exec
	r_mappingoverview
			@login=@login


