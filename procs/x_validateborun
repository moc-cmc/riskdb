drop procedure
	x_validateborun
go

create procedure
	x_validateborun
		@login varchar(50),
		@run_name varchar(50),
		@is_valid char(1) output
as

declare @run_id int
declare @filters int

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @run_id = NULL
begin
	select
		@is_valid = "N"
	return
end

create table
	#filters(
		run_id int,
		id int)

insert into 
	#filters
select
	*
from
	run_traders
where
	run_id = @run_id

insert into
	#filters
select
	*
from
	run_brokers
where
	run_id = @run_id

insert into
	#filters
select
	*
from
	run_counterparties
where
	run_id = @run_id

insert into
	#filters
select
	*
from
	run_strategies
where
	run_id = @run_id

select
	@filters = count(*)
from
	#filters

if @filters != 0
	select
		@is_valid = "N"
else
	select
		@is_valid = "Y"

go

	
