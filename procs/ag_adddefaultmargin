use
	risk_finotec
go

drop procedure
	ag_adddefaultmargin
go

create procedure
	ag_adddefaultmargin
		@login varchar(50),
		@symbol varchar(50),
		@margin float,
		@as_of_date datetime
as

declare @contract_id int
declare @fund_id int
declare @default_margin_id int
declare @most_recent_commit datetime

	
select
	@most_recent_commit = max(reval_date)
from
	committed_daily_revals

if @as_of_date <= @most_recent_commit
begin
	select
		status = "Error",
		message = "P&L Commits before as of date, margin can not be added"
	return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

update
	default_margins
set
	margin = @margin
where
	contract_id = @contract_id
and
	as_of_date = @as_of_date
and
	fund_id = @fund_id
if @@rowcount = 0
begin
	exec
		j_nextkey
			"default_margins",
			@default_margin_id output

	insert into
		default_margins
	values(
		@default_margin_id,
		@fund_id,
		@contract_id,
		@margin,
		@as_of_date)
end


exec
	ag_margins
		@login

go


