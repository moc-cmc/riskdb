drop procedure tt_processdoneorder
go

create procedure
	tt_processdoneorder
		@login varchar(50),
		@order_id int,
		@deal_id int,
		@status_id int=NULL,
		@status varchar(50)=NULL

as

declare @trade_count int
declare @contract_count int
declare @trader_count int
declare @broker_count int
declare @counterparty_count int
declare @external_acct_count int
declare @value_date datetime
declare @trade_date datetime
declare @total_deal_qty numeric(30, 4)
declare @none_agg_style_id int
declare @none_agg_style_accounts int

declare @unagg_status_id int
declare @processed_status_id int
declare @aggregated_status_id int
declare @order_type int


if @status_id=NULL and @status=NULL
begin
	select
		"err"="Error",
		"msg"="Must provide either @status_id or @status"
	return
end

select
	@unagg_status_id = status_id
from
	statuses
where
	name = "Unaggregated"
select
	@processed_status_id = status_id
from
	statuses
where
	name = "Processed"
select
	@aggregated_status_id = status_id
from
	statuses
where
	name = "Aggregated"

if @status_id = NULL
begin
	select
		@status_id = status_id
	from
		statuses
	where
		name = @status
	if @status_id = NULL
	begin
		select 
 			err="Error",
                	msg="Problem determining status from",
			status=@status
		return
	end
end

select
	"Order was "+ rtrim(@status) +" ... Aggregating tickets"

create table
	#deal_trades
(
	deal_id int,
	trade_id int,
	contract_id int,
	trade_qty numeric(30,4),
	price float,
	external_account_id int,
	trader_id int,
	broker_id int,
	counterparty_id int,
	status_id int,
	trade_date datetime,
	value_date datetime
)


create table 
    #netting_trades (
        deal_id int,
        external_account varchar(50) NULL,
        symbol varchar(50) NULL,
        value_date datetime NULL,
        quantity float NULL,
        price float,
        trader varchar(50) NULL,
        broker varchar(25) NULL,
        counterparty varchar(50) NULL,
	trade_date datetime
    )


insert into
	#deal_trades
select
	a.deal_id,
	a.trade_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.external_account_id,
	a.trader_id,
	a.broker_id,
	a.counterparty_id,
	a.status_id,
        case
                when a.trade_date > convert(char(8), getdate(), 112) +' 17:00' then
                        dateadd(day, 1, convert(char(15), a.trade_date, 110))
                else
                        convert(char(12), a.trade_date, 110)
        end,
	/*convert(datetime, convert(char(8), a.trade_date, 112)),*/
	a.value_date
from
	trades a
where
	a.deal_id = @deal_id

	
/*
 | Perform a few check on #deal_trades to make sure deal is ready for aggregation
 */

select 
	@trade_count = count(trade_id)
from
	#deal_trades

select
	@contract_count = count(distinct(contract_id))
from
	#deal_trades


if @contract_count = 1
begin
	select
		@total_deal_qty = sum(trade_qty)
	from
		#deal_trades
	
	if @total_deal_qty != 0
	begin
		select
			msg="Order not ready for aggregation, mismatched qty",
			order_id=@order_id,
			deal_id=@deal_id
		return
	end
end
else
begin
	select
		warn="Warning",
		msg="More than one contract in order",
                order_id=@order_id,
                deal_id=@deal_id
	return
end

/*
 | After b2b checks are done, delete out trades that will not be included in the aggregation
 */ 
delete from
	#deal_trades
where
	status_id != @unagg_status_id
and
	counterparty_id not in(select counterparty_id from fund_agency_counterparties)

declare @int_ext_account_type_id int

select
	@int_ext_account_type_id = external_account_type_id
from
	external_account_types
where
	name = "Internal"

delete
	#deal_trades
from
	#deal_trades a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = @int_ext_account_type_id

select
        @trade_count = count(trade_id)
from
        #deal_trades

/*if @trade_count = 1
begin
	select 
		msg = "Single fill order, committing without aggregation",
		order_id = @order_id,
		deal_id = @deal_id

	exec
        	r_manageticketgroup
            		@login = @login,
            		@trade_date = @trade_date,
            		@action = "COMMIT",
            	@group_deal_id = @deal_id

	update
		orders
	set
		processing_status_id = @processed_status_id
	where
		deal_id = @deal_id
	
	
	return
end*/
/*
 | Perform a few check on #deal_trades to make sure deal is ready for aggregation
 */

select
	@none_agg_style_id = aggregation_style_id
from
	aggregation_styles
where
	name = "None"

select 
	@none_agg_style_accounts = count(*)
from
	#deal_trades a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.aggregation_style_id = @none_agg_style_id
if @none_agg_style_accounts > 0
begin
	select
                warn="Warning",
                msg="External account in order with aggregation style 'None'",
                order_id=@order_id,
                deal_id=@deal_id
        return
end

select
	@trader_count = count(distinct(trader_id))
from
	#deal_trades
if @trader_count > 1
begin
	select
		warn="Warning",
		msg="More than one trader for unaggregated trades in deal",
		order_id=@order_id,
		deal_id=@deal_id
	return
end

select
	@broker_count = count(distinct(broker_id))
from
	#deal_trades
if @broker_count > 1
begin
	select
		warn="Warning",
		msg="More than one broker for unaggregated trades in deal",
		order_id=@order_id,
		deal_id=@deal_id
	return
end

select
	@counterparty_count = count(distinct(counterparty_id))
from
	#deal_trades
if @counterparty_count > 1
begin
	select
		warn="Warning",
		msg="More than one counterparty for unaggregated trades in deal",
		order_id=@order_id,
		deal_id=@deal_id
	return
end

select
	@external_acct_count = count(distinct(external_account_id))
from
	#deal_trades
if @external_acct_count > 1
begin
	select
		warn="Warning",
		msg="More than one external_account for unaggregated trades in deal",
		order_id=@order_id,
		deal_id=@deal_id
	return
end



/* 
 | Trades are already grouped so net and commit them
 */
insert into
	#netting_trades
	(
		deal_id,
		quantity,
		price,
		value_date,
		trade_date
	)
select
	a.deal_id,
	sum(a.trade_qty),
	sum(a.price * a.trade_qty) / sum(a.trade_qty),
	a.value_date,
	a.trade_date
from
	#deal_trades a
group by
	a.deal_id,
	a.trade_date,
	a.value_date

	
update
	#netting_trades
set
	external_account = c.symbol
from
	#deal_trades a,
	external_accounts c
where
	a.external_account_id = c.external_account_id


update
	#netting_trades
set
	trader = b.symbol
from
	#deal_trades a,
	traders b
where
	a.trader_id = b.trader_id

update
	#netting_trades
set
	broker = b.symbol
from
	#deal_trades a,
	brokers b
where
	a.broker_id = b.broker_id

update
	#netting_trades
set
	counterparty = b.name
from
	#deal_trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#netting_trades
set
	symbol = b.symbol
from
	#deal_trades a,
	contracts b
where
	a.contract_id = b.contract_id	

select 
	*
from
	#netting_trades

declare @contract varchar(50)
declare @quantity numeric(30, 4)
declare	@price float
declare @external_account varchar(50)
declare @trader varchar(50)
declare @broker varchar(50)
declare @counterparty varchar(50)

select
	@trade_date = trade_date,
	@contract = symbol,
	@value_date = value_date,
	@quantity = quantity,
	@price = price,
	@external_account = external_account,
	@trader = trader,
	@broker = broker,
	@counterparty = counterparty
from
	#netting_trades

if @trade_count > 1
begin
	exec
        	r_manageticketgroup
            	@login = @login,
            	@trade_date = @trade_date,
            	@action = "NET",
            	@group_deal_id = @deal_id,
            	@symbol = @contract,
            	@value_date = @value_date,
            	@quantity = @quantity,
            	@price = @price,
            	@external_account = @external_account,
            	@trader = @trader,
            	@broker = @broker,
            	@counterparty = @counterparty
end
else if @trade_count = 1
begin
	
        select
                msg = "Single fill order, committing without aggregation",
                order_id = @order_id,
                deal_id = @deal_id
end

	

update
        orders
set
        processing_status_id = @aggregated_status_id
where
        deal_id = @deal_id

    exec
        r_manageticketgroup
            @login = @login,
            @trade_date = @trade_date,
            @action = "COMMIT",
            @group_deal_id = @deal_id


	
go
