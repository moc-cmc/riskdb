
drop procedure r_setopstaskstatus
go

create procedure
	r_setopstaskstatus
		@login varchar(50),
		@task_id int,
		@status varchar(25),
		@task_name varchar(150)=NULL,
		@as_of_date datetime=NULL


as

declare @tico_account_id int
declare @status_id int
declare @ops_task_id int

select
	@ops_task_id = @task_id

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = @status
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining status",
		provided_status = @status
	return
end

begin tran
	update
		ops_tasks
	set
		status_id = @status_id
	where
		ops_task_id = @ops_task_id
	if @@rowcount != 1
	begin	
		select
			status = "Error",
			message = "Problem updating status for task",
			ops_task_id = @ops_task_id,
			provided_status = @status
		rollback
		return
	end
commit tran

/* If provided an as_of_date via tico, call the manage page */
if @as_of_date != NULL
begin
	exec
		r_manageopstasks
			@login=@login,
			@as_of_date=@as_of_date
end

go

