
if object_id("r_contractcurrency") != NULL
    drop procedure
        r_contractcurrency
go
 
create procedure
	r_contractcurrency
		@contract_id int,
		@currency_product_id int output
as

declare @instrument char(100)

select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @contract_id

select
	@currency_product_id = NULL

if @instrument = "Forward"
	select
		@currency_product_id = currency_id
	from
		forwards
	where
		contract_id = @contract_id
if @currency_product_id != NULL
	return


if @instrument = "Future"
	select
		@currency_product_id = a.currency_id
	from
		forwards a,
		futures b,
		future_contracts c
	where
		a.contract_id = b.forward_id
	and
		b.future_id = c.future_id
	and
		c.contract_id = @contract_id
if @currency_product_id != NULL
	return

if @instrument = "Option"
begin
	select
		@currency_product_id = a.currency_id
	from
		forwards a,
		options b,
		option_expirations c,
		option_contracts d
	where
		a.contract_id = b.underlying_contract_id
	and
		b.option_id = c.option_id
	and
		c.option_expiration_id = d.option_expiration_id
	and
		d.contract_id = @contract_id
	if @currency_product_id != NULL
		return

	select
		@currency_product_id = a.currency_id
	from
		forwards a,
		futures b,
		future_contracts c,
		options d,
		option_expirations e,
		option_contracts f
	where
		a.contract_id = b.forward_id
	and
		b.future_id = c.future_id
	and
		c.contract_id = d.underlying_contract_id
	and
		d.option_id = e.option_id
	and
		e.option_expiration_id = f.option_expiration_id
	and
		f.contract_id = @contract_id
end

if @instrument = "Exotic"
begin
	select
		@currency_product_id = a.currency_id
	from
		forwards a,
		options b,
		option_expirations c,
		exotic_contracts d
	where
		a.contract_id = b.underlying_contract_id
	and
		b.option_id = c.option_id
	and
		c.option_expiration_id = d.option_expiration_id
	and
		d.contract_id = @contract_id
	if @currency_product_id != NULL
		return

	select
		@currency_product_id = a.currency_id
	from
		forwards a,
		futures b,
		future_contracts c,
		options d,
		option_expirations e,
		exotic_contracts f
	where
		a.contract_id = b.forward_id
	and
		b.future_id = c.future_id
	and
		c.contract_id = d.underlying_contract_id
	and
		d.option_id = e.option_id
	and
		e.option_expiration_id = f.option_expiration_id
	and
		f.contract_id = @contract_id
end




go
