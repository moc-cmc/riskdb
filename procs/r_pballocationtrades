update
	#trade_output
set
	working_deal = @deal_id

update
	#trade_output
set
	section = "Working",
	select_deal = ""
where
	deal_id = @deal_id

update
	#trade_output
set
	select_deal = "Remove",
	group_action = "Ungroup"
from
	#trade_output a,
	trade_origin_deals b
where
	a.trade_id = b.trade_id
and
	a.deal_id = @deal_id


if @deal_id != NULL
begin
	declare @working_contract_id int

	select
		@working_contract_id = contract_id
	from
		#trade_output
	where
		deal_id = @deal_id
	group by
		contract_id
	
	update 
		#trade_output
	set
		style="color:#333333;background:#CCCCCC",
		select_deal = ""
	where
		section != "Working"
	and
		trade_id = NULL
	and
		contract_id != @working_contract_id
end


	
update
        #trade_output
set
        section = "Allocated",
	allocate_trade = "RE-ALLOCATE"
where
        status = "Allocated"

update
	#trade_output
set
	trade_price = round(trade_price, 5)
where
	trade_id = NULL

/* remove rounding on JPY
update
        #trade_output 
set
        trade_price = round(trade_price, 4)
where
        symbol like "%JPY"
*/

delete from 
	#trade_output
where
	status = "Allocated"
and
	trade_id = NULL

insert into
	#allocated_trade_output
(
        section,
        style,
        run,
        working_deal,
        deal_id,
        trade_id,
        trade_type,
        trade_date,
        trade_time,
        trades_trade_date,
        value_date,
        symbol,
        quantity,
        trade_price,
        trader,
        broker,
        external_account,
        counterparty,
        status,
        select_deal,
        allocate_trade,
        agg_and_alloc,
        num_agg_trades,
	abs_qty,
	buy_sell,
	group_action
)
select
        section,
        style,
