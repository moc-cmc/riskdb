use
	risk_elviro
go

drop procedure
	ag_importspectrumprices
go

create procedure
	ag_importspectrumprices
		@login varchar(50), /* Always make this the first arg in any tico proc */
		@date varchar(100)=NULL, /* I always use varchar(100)=NULL and convert later.*/ 
		@currency1 varchar(100)=NULL,
		@currency2 varchar(100)=NULL,
		@rate varchar(100)=NULL,
		@terms varchar(100)=NULL

as

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

declare @source_id   int
declare @contract_id int
declare @contract varchar(100)
declare @product1 varchar(100)
declare @product2 varchar(100)
declare @price_style varchar(50)
declare @symbol varchar(50)
declare @price_date datetime
declare @price float
declare @price_id int
declare @bo_spot_settle_id int

declare @inverted_contract_id int
declare @inverted_symbol varchar(50)
declare @message varchar(400)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"old_value_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"pb_products",
	"Prime Broker Products",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"tally_queued_settlements",
	"Tally Queued Settlements",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"net_vs_clients",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"net_vs_market",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"net",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"closed_fx",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"net_balance",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"unsettled_fx",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"settled_fx",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"balance",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

if @date="DATE" /* ignore header row */
begin
	return
end

select
	@source_id=source_id
from
	sources
where
	name="Spectrum"

if(@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find source ",
		source="Spectrum"
	return
end

select
	@price_date = dateadd(hour, 17, convert(datetime, convert(date, @date)))
select 
	@product1=substring(@terms,1,3),
	@product2=substring(@terms,5,7)
select
	@symbol = rtrim(@product1) + rtrim(@product2)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id != NULL
begin

	select
		@price = convert(float, @rate)
	
	select
		@price_style = a.name
	from
		price_styles a,
		contract_price_styles b,
		contracts c
	where
		a.price_style_id = b.price_style_id
	and
		b.contract_id = c.contract_id
	
	if @price_style = "Inverted"
	begin
		exec
			r_invertedcontract
				@contract_id,
				@inverted_contract_id output

		select
			@inverted_symbol = symbol
		from
			contracts
		where
			contract_id = @inverted_contract_id
		select
			@contract_id = @inverted_contract_id,
			@symbol = @inverted_symbol
	end
	
	update
		prices
	set
		price = @price
	where
		contract_id = @contract_id
	and
		price_date = @price_date
	if @@rowcount = 0
	begin
		exec
			j_nextkey
				"prices",
				@price_id output
	
		insert into
			prices(
				price_id,
				status_id,
				contract_id,
				price_date,
				price_type_id,
				price)
		values(
			@price_id,
			1,
			@contract_id,
			@price_date,
			2,
			@price)
	end

	update
		bo_spot_settles
	set
		price = @price
	where
		contract_id = @contract_id
	and
		price_date = @price_date

	if @@rowcount = 0
	begin
		insert into
			bo_spot_settles(
				contract_id,
				source_id,
				price_date,
				price)
			values(
				@contract_id,
				@source_id,
				@price_date,
				@price)

	end
	
end


go
