create procedure
	r_priceasof
		@contract_id int,
		@as_of_date datetime,
		@price float output
as

declare @timestamp datetime
declare @inverted_contract_id int
declare @price_date datetime
	
exec
	r_optionexpprice
		@contract_id,
		@as_of_date,
		@price output
if @price != NULL
	return

exec
	r_invertedcontract
		@contract_id,
		@inverted_contract_id output
select
	@price = price,
	@price_date = price_date
from
	prices
where
	contract_id = @contract_id
and
	price_date = @as_of_date

/* if @price_date > getdate()
	select
		@price = NULL */

select
	@price = 1.0 / price,
	@price_date = price_date
from
	prices
where
	contract_id = @inverted_contract_id
and
	price_date = @as_of_date

if @price = NULL
begin
	select
		@price = 1.0 / price,
		@price_date = price_date
	from
		prices
	where
		contract_id = @inverted_contract_id
	and
		price_date = @as_of_date

	if @price_date > getdate()
		select
			@price = NULL
end


if @price = NULL
begin
	/* select
		@timestamp = timestamp
	from
		current_prices
	where
		contract_id = @contract_id

	if @as_of_date > dateadd(hour, -7, @timestamp)
	begin */
		select
			@price = price
		from
			current_prices
		where
			contract_id = @contract_id
	/* end */

end
if @price = NULL
begin
	/* select
		@timestamp = timestamp
	from
		current_prices
	where
		contract_id = @inverted_contract_id

	/* if @as_of_date > @timestamp */
	if @as_of_date > dateadd(hour, -7, @timestamp)
	begin */
		select
			@price = 1 / price
		from
			current_prices
		where
			contract_id = @inverted_contract_id
	/* end
	/* if @price != NULL
		if @contract_id = 163
			select msg = "T3"  */ */
end


if @price = NULL
begin
	select
		@price = a.price
	from
		prices a,
		price_types b
	where
		a.price_type_id = b.price_type_id
	and
		b.name = "Close"
	and
		a.contract_id = @contract_id
	and
		a.price_date = (select
				max(a.price_date)
			from
				prices a,
				price_types b
			where
				a.price_type_id = b.price_type_id
			and
				b.name = "Close"
			and
				a.contract_id = @contract_id
			and
				a.price_date <= @as_of_date)
	 /* if @price != NULL
		if @contract_id = 163
			select msg = "T4"  */
end
			

if @price = NULL
begin
	select
		@price = 1 / a.price
	from
		prices a,
		price_types b
	where
		a.price_type_id = b.price_type_id
	and
		b.name = "Close"
	and
		a.contract_id = @inverted_contract_id
	and
		a.price_date = (select
				max(a.price_date)
			from
				prices a,
				price_types b
			where
				a.price_type_id = b.price_type_id
			and
				b.name = "Close"
			and
				a.contract_id = @inverted_contract_id
			and
				a.price_date <= @as_of_date)
end
			
if @price = NULL
begin
	select
		@price = price
	from
		current_prices
	where
		contract_id = @contract_id
end

if @price = NULL
begin
	select
		@price = 1 / price
	from
		current_prices
	where
		contract_id = @inverted_contract_id

end

