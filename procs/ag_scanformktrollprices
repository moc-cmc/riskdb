drop procedure
	ag_scanformktrollprices
go

create procedure
	ag_scanformktrollprices
		@login varchar(50),
		@trade_date datetime,
		@clearing_entity varchar(50)
as

declare @total_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)
declare @deficit_style varchar(250)
declare @client_style varchar(250)

declare @prime_broker_id int
declare @evaluation_currency_id int
declare @fund_id int
declare @begin_date datetime
declare @end_date datetime

declare @id int
declare @ids int
declare @deal_id int
declare @contract_id int
declare @inverted_contract_id int
declare @inverted_closing_price float
declare @inverted_roll_price float
declare @inverted_points float
declare @closing_quantity float
declare @closing_price numeric(30,8)
declare @roll_quantity float
declare @roll_price_id int
declare @roll_price numeric(30,8)
declare @closing_date datetime
declare @roll_date datetime
declare @points numeric(30,8)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"clearing_entity",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"back_to_dashboard",
	"Client Rolls Dashboard",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"points",
	"Number",
	"#,##0.0000")

insert into
	#meta
values(
	"Column Format",
	"closing_price",
	"Number",
	"#,##0.00000000")

insert into
	#meta
values(
	"Column Format",
	"roll_price",
	"Number",
	"#,##0.00000000")

insert into
	#meta
values(
	"Column Format",
	"net_equiv",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"net_pct",
	"Number",
	"#,##0.000000;<span style=""color:red"">(#,##0.000000)</span>")

insert into
	#meta
values(
	"Column Format",
	"roll_quantity",
	"Number",
	"#,##0;<span style=""color:red"">(#,##0)</span>")

insert into
	#meta
values(
	"Column Format",
	"closing_quantity",
	"Number",
	"#,##0;<span style=""color:red"">(#,##0)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@deficit_style = "background:#F5F3CE;color:#FF0000;border: 1px solid white",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold", 
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@selected_trade_style = "background:#F7F4C1;border: 1px solid white"



exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#conversion_rates( 
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	product_id
from
	products

update
	#conversion_rates
set
	rate = 1.0
where 
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and 
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and 
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = a.product_id 
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL


select
	@prime_broker_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = @clearing_entity
if @prime_broker_id = NULL
begin
	select
		status = "Error",
		message = "Clearing entity not found",
		clearing_entity = @clearing_entity
	return
end


create table
	#rolls(
		style varchar(250) NULL,
		deal_id int,
		use_price int NULL,
		external_account_id int NULL,
		closing_trade_id int NULL,
		closing_quantity numeric(30,4) NULL,
		roll_trade_id int NULL,
		roll_quantity numeric(30,4) NULL,
		contract_id int,
		product_id int NULL,
		currency_id int NULL,
		closing_date datetime NULL,
		closing_price float NULL,
		roll_date datetime NULL,
		roll_price float NULL,
		closing_dealt float NULL,
		closing_counter float NULL,	
		closing_dealt_equiv float NULL,
		closing_counter_equiv float NULL,
		roll_dealt float NULL,
		roll_counter float NULL,
		roll_dealt_equiv float NULL,
		roll_counter_equiv float NULL,
		closing_equiv float NULL,
		roll_equiv float NULL,
		net_equiv float NULL,
		net_pct float NULL,
		position varchar(15) NULL)
insert into
	#rolls(
		style,
		use_price,
		deal_id,
		external_account_id,
		closing_trade_id,
		closing_quantity,
		contract_id,
		closing_date,
		closing_price)
select
	style = @style,
	use_price = 0,
	a.deal_id,
	a.external_account_id,
	a.trade_id,
	a.quantity,
	a.contract_id,
	a.value_date,
	a.price
from
	trades a,
	roll_prices b,
	trade_types c,
	external_account_prime_brokers d
where
	a.contract_id = b.contract_id
and
	a.value_date = b.closing_date
and
	a.trade_type_id = c.trade_type_id
and
	a.external_account_id = d.external_account_id
and
	d.prime_broker_id = @prime_broker_id
and
	c.name = "Swap Near"
and
	b.trade_date = @trade_date

update
	#rolls
set
	a.roll_date = b.roll_date
from
	#rolls a,
	roll_prices b
where
	a.contract_id = b.contract_id
and
	b.trade_date = @trade_date

update
	#rolls
set
	a.roll_trade_id = b.trade_id,
	a.roll_price = b.price,
	a.roll_quantity = b.quantity
from
	#rolls a,
	trades b,
	trade_types c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = b.contract_id
and
	a.roll_date = b.value_date
and
	b.trade_type_id = c.trade_type_id
and
	c.name = "Swap Far"
and
	a.deal_id = b.deal_id

delete

from
	#rolls
where
	roll_trade_id = NULL

update
	#rolls
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#rolls a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#rolls
set
	closing_dealt = closing_quantity,
	closing_counter = closing_quantity * closing_price * -1.0,
	roll_dealt = roll_quantity,
	roll_counter = roll_quantity * roll_price * -1.0

	
update
	#rolls
set
	a.closing_dealt_equiv = a.closing_dealt * b.rate,
	a.roll_dealt_equiv = a.roll_dealt * b.rate
from
	#rolls a,
	#conversion_rates b
where
	a.product_id = b.product_id


update
	#rolls
set
	a.closing_counter_equiv = a.closing_counter * b.rate,
	a.roll_counter_equiv = a.roll_counter * b.rate
from
	#rolls a,
	#conversion_rates b
where
	a.currency_id = b.product_id

update
	#rolls
set
	closing_equiv = closing_dealt_equiv + closing_counter_equiv,
	roll_equiv = roll_dealt_equiv + roll_counter_equiv


update
	#rolls
set
	net_equiv = closing_equiv + roll_equiv

update
	#rolls
set
	net_pct = (abs(net_equiv / closing_quantity) * sign(net_equiv)) * 100.00
where
	closing_quantity != 0.0
	
update
	#rolls
set
	position = "Long"
where
	closing_quantity < 0.0

update
	#rolls
set
	position = "Short"
where
	closing_quantity > 0.0

create table
	#tightest(
		id int identity,
		contract_id int,
		position varchar(25),
		net_pct float)
insert into
	#tightest(
		contract_id,
		position,
		net_pct)
select
	contract_id,
	position,
	min(net_pct)
from
	#rolls
group by
	contract_id,
	position

update
	#rolls
set
	a.style = @selected_style,
	use_price = 1
from
	#rolls a,
	#tightest b
where
	a.contract_id = b.contract_id
and
	a.net_pct = b.net_pct
	
create table
	#save_prices(
		id int identity,
		deal_id int)
insert into
	#save_prices(
		deal_id)
select
	deal_id
from
	#rolls
where
	use_price = 1

select
	@id = 0
select
	@ids = count(*)
from
	#save_prices
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#save_prices
	where
		id > @id

	select
		@roll_price_id = NULL,
		@contract_id = NULL,
		@closing_quantity = NULL,
		@closing_price = NULL,
		@roll_quantity = NULL,
		@roll_price = NULL,
		@closing_date = NULL,
		@roll_date = NULL,
		@deal_id = NULL,
		@points = NULL

	select
		@deal_id = deal_id
	from
		#save_prices
	where
		id = @id

	select
		@contract_id = contract_id,
		@closing_quantity = closing_quantity,
		@closing_price = closing_price,
		@roll_quantity = roll_quantity,
		@roll_price = roll_price,
		@closing_date = closing_date,
		@roll_date = roll_date
	from
		#rolls
	where
		deal_id = @deal_id

	select
		@points = @roll_price - @closing_price

	exec
		r_invertedcontract
			@contract_id,
			@inverted_contract_id output

	select
		@inverted_closing_price = 1.0 / @closing_price,
		@inverted_roll_price = 1.0 / @roll_price
	select
		@inverted_points = @inverted_roll_price - @inverted_closing_price
	select
		@roll_price_id = roll_price_id
	from
		roll_prices
	where
		trade_date = @trade_date
	and
		contract_id = @contract_id


	if @roll_quantity > 0.0
	begin
		update
			roll_prices
		set
			buy_roll_price = near_price + @points
		where
			roll_price_id = @roll_price_id
		and
			near_price != NULL
		if @@rowcount = 0
		begin
			update
				roll_prices
			set
				near_price = @closing_price,
				buy_roll_price = @roll_price
			where
				roll_price_id = @roll_price_id
		end

		update
			roll_prices
		set
			sell_roll_price = near_price + @inverted_points
		where
			contract_id = @inverted_contract_id
		and
			trade_date = @trade_date
		and
			near_price != NULL
		if @@rowcount = 0
		begin
			update
				roll_prices
			set
				near_price = @inverted_closing_price,
				sell_roll_price = @inverted_roll_price
			where
				contract_id = @inverted_contract_id
			and
				trade_date = @trade_date
		end
	end
	if @roll_quantity < 0.0
	begin
		update
			roll_prices
		set
			sell_roll_price = near_price + @points
		where
			roll_price_id = @roll_price_id
		and
			near_price != NULL
		if @@rowcount = 0
		begin
			update
				roll_prices
			set
				near_price = @closing_price,
				sell_roll_price = @roll_price
			where
				roll_price_id = @roll_price_id
		end
                update
                        roll_prices
                set
                        buy_roll_price = near_price + @inverted_points
                where
                        contract_id = @inverted_contract_id
                and
                        trade_date = @trade_date
                and
                        near_price != NULL
                if @@rowcount = 0
                begin
                        update
                                roll_prices
                        set
                                near_price = @inverted_closing_price,
                                buy_roll_price = @inverted_roll_price
                        where
                                contract_id = @inverted_contract_id
                        and
                                trade_date = @trade_date
                end

	end

	select
		@ids = count(*)
	from
		#save_prices
	where
		id > @id
		
end


select
	style = @style,
	back_to_dashboard = "Back To Dashboard",
	trade_date = @trade_date

select
	a.style,
	a.deal_id,
	a.use_price,
	account = b.symbol,
	c.symbol,
	a.closing_quantity,
	closing_date = convert(varchar(11), a.closing_date),
	a.closing_price,
	a.roll_quantity,
	a.roll_price,
	roll_date = convert(varchar(11), a.roll_date),
	points = (a.roll_price - a.closing_price) * 10000.00,
	a.position,
	a.net_equiv,
	net_pct = (abs(a.net_equiv / a.closing_quantity) * sign(a.net_equiv)) * 100.00
from
	#rolls a,
	external_accounts b,
	contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
order by
	c.symbol,
	b.symbol


