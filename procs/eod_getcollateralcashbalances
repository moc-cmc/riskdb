create or replace procedure
	eod_getcollateralcashbalances
		@login varchar(50),
		@run_name varchar(50),
		@trade_date datetime = NULL

as

declare @run_id int
declare @currency_id int
declare @begin_date datetime
declare @end_date datetime
declare @begin_day_string varchar(50)
declare @end_day_string varchar(50)

if @trade_date = NULL
begin
    	select
        	@trade_date = convert(date, getdate())
	select
		@trade_date = convert(date, @trade_date)
end

select
        @run_id = a.run_id
from
        runs a
where
        a.name = @run_name
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Problem finding run with name",
                run = @run_name
        return
end

create table
        #external_accounts(
                external_account_id int)
insert into
        #external_accounts(
		external_account_id)
select
        external_account_id
from
        run_external_accounts
where
        run_id = @run_id
if @@rowcount = 0
begin
        select
                status = "Error",
                message = "Run external account not found",
                run = @run_name
        return
end


create table
	#fss_cash_balances(
		trade_date datetime NULL,
		external_account_id int NULL,
		routing_number int NULL,
		account_number varchar(50) NULL,
		owner varchar(50) NULL,
		bank_name varchar(50) NULL,
		product_id int NULL,
		balance numeric(30,4) NULL)

insert into
	#fss_cash_balances(
		trade_date,
                external_account_id,
		product_id,
                balance)
select
	trade_date = convert(date, @trade_date),
        b.external_account_id,
	a.product_id,
	a.closing_balance
from
	fss_cash_balances a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	convert(date, a.trade_date) = convert(date, @trade_date)

update
	#fss_cash_balances
set
        routing_number = b.routing_number,
        account_number = b.account_number,
        owner = b.owner,
        bank_name = b.bank_name
from
        #fss_cash_balances a,
        nfa_mappings b
where
        a.external_account_id =  b.external_account_id
and
        b.spectrum_file = "Cash Account Balances"

create table
        #tlm_collateral(
                trade_date datetime NULL,
                external_account_id int NULL,
		routing_number int NULL,
                account_number varchar(50) NULL,
                owner varchar(50) NULL,
                bank_name varchar(50) NULL,
                product_id int NULL,
                balance numeric(30,4) NULL)
insert into
        #tlm_collateral(
                trade_date,
                external_account_id,
                product_id,
                balance)
select
        trade_date = convert(date, @trade_date),
        b.external_account_id,
        a.currency_id,
        sum(a.notional)
from
        tlm_collateral a,
        #external_accounts b
where
        a.client_account_id = b.external_account_id
and
	convert(date, a.trade_date) = convert(date, @trade_date)
group by
        a.currency_id

update
	#tlm_collateral
set
	routing_number = b.routing_number,
	account_number = b.account_number,
	owner = b.owner,
	bank_name = b.bank_name
from
	#tlm_collateral a,
	nfa_mappings b
where
	a.external_account_id =  b.external_account_id
and
	b.spectrum_file = "TLM Collateral"

create table
        #output(
                trade_date datetime,
                external_account_id int,
                product_id int,
                product varchar(50) NULL,
                routing_number int NULL,
                account_number varchar(50) NULL,
                owner varchar(50) NULL,
                bank_name varchar(50) NULL,
		balance float)

insert into
        #output(
                trade_date,
                external_account_id,
                product_id,
		balance,
		routing_number,
		account_number,
		owner,
		bank_name)
select
        trade_date,
        external_account_id,
        product_id,
        balance,
        routing_number,
        account_number,
        owner,
        bank_name
from
        #tlm_collateral

insert into
        #output(
                trade_date,
                external_account_id,
                product_id,
                balance,
                routing_number,
                account_number,
                owner,
                bank_name)
select
        trade_date,
        external_account_id,
        product_id,
        balance,
        routing_number,
        account_number,
        owner,
        bank_name
from
	#fss_cash_balances

update
	#output
set
	product = b.symbol
from
	#output a,
	products b
where
	a.product_id = b.product_id
	
select
	trade_date,
        bank_name,
	routing_number,
        account_number,
        owner,
        product,
	booked = balance,
	available = balance
from
	#output

go
