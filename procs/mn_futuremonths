create procedure
	mn_futuremonths
		@login varchar(50),
		@name varchar(50)
as

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"not_currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"mappings",
	"Future Contract Mappings",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"new_contract",
	"Add New Future Contract",
	NULL) 

insert into
        #meta
values(
        "Column Link",
        "new_vald_contract",
        "Add New ValDate Future Contract",
        NULL)


insert into
	#meta
values(
	"Column Format",
	"total_pl",
	"Number",
	"#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

declare @future_id int

select
	@future_id = future_id
from
	futures
where
	name = @name

select
	section = "Add Future Contract",
	style = "background:#FFFFFF;border: 1px solid white",
	new_contract = "Add new contract",
	new_vald_contract = "Add new value date contract", 
	name = @name

select
	section = "Contracts",
	style = "background:#FFFFFF;border: 1px solid white",
	a.name,
	a.root_symbol,
	b.expiration,
	c.symbol,
	mappings = "Mappings"
from
	futures a,
	future_contracts b,
	contracts c
where
	a.future_id = b.future_id
and
	b.contract_id = c.contract_id
and
	a.name = @name
order by
	b.expiration



