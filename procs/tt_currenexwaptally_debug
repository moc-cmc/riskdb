    'exec'='tt_processdealtags',
        @login = @default_login
 */
 
/* 
 * AUTOCOMMIT
 *
 * If there is a client trade in this deal and the account type is set for
 * Autocommit, then push through this deal automatically.
 */
if @trd_deal_id != NULL and @cli_trade_id != NULL and @cli_aggregation_style = "Autocommit"
begin

    select
        'update'='deals',
        deal_id = deal_id,
        status_id = @committed_status_id
    from
        deals
    where
        deal_id = @trd_deal_id
    
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for client external account, '" + @cli_external_account + "', an aggregation style, '" + @cli_aggregation_style + "'"
/*        return*/
    end

end
else
begin
    select
        message = "No autocommitted",
        trd_deal_id = @trd_deal_id,
        cli_trade_id = @cli_trade_id,
        cli_aggregation_style = @cli_aggregation_style
end

/*
 * SHOW trades: Dump information about these trades
 */
select
    action = "Tallied",
    a.deal_id,
    a.trade_id,
    int_account = convert(varchar(50), b.symbol),
    ext_account = convert(varchar(50), c.symbol),
    trader = convert(varchar(50), d.symbol),
    broker = convert(varchar(50), e.symbol),
    counterparty = convert(varchar(50), f.name),
    symbol = convert(varchar(50), g.symbol),
    a.value_date,
    quantity = a.quantity,
    price = a.price,
    status = convert(varchar(25), h.name)
from
    trades a,
    internal_accounts b,
    external_accounts c,
    traders d,
    brokers e,
    counterparties f,
    contracts g,
    statuses h
where
    a.internal_account_id = b.internal_account_id
and
    a.external_account_id = c.external_account_id
and
    a.trader_id = d.trader_id
and
    a.broker_id = e.broker_id
and
    a.counterparty_id = f.counterparty_id
and
    a.contract_id = g.contract_id
and
    a.status_id = h.status_id
and
    a.trade_id in (
        @cli_trade_id,
        @cli_far_trade_id,
        @mkt_trade_id,
        @mkt_far_trade_id
    )

/*
 * Acknoweldge this trade report
 */
select
    trade_report_id=@trade_report_id,
    symbol="NA"

go
