create or replace procedure
	r_aggandallocatedeal
		@login varchar(50),
		@run varchar(50)=NULL,
		@deal_id int,
		@account varchar(50),
		@symbol varchar(50),
		@quantity numeric(30,4),
		@trade_price float = NULL,
		@trade_date datetime,
		@value_date datetime,
		@trader varchar(25),
		@broker varchar(25),
		@status varchar(25),
		@external_account varchar(25),
		@counterparty varchar(25),
		@trade_type varchar(25),
		@num_agg_trades int=NULL
as


/* WD 20191101 hack for vd issue over daylight savings */
select
        @value_date = dateadd(hour, 3, @value_date)
select
        @value_date = convert(datetime, convert(varchar(11), @value_date))



if @trade_price = NULL and @quantity != 0
begin
	select
		"error" = "Must provide trade price when quantity is not zero"
	return

end

declare @trade_type_id int
declare @old_external_account_id int
declare @contract_id int
declare @trader_id int
declare @broker_id int
declare @counterparty_id int
declare @status_id int
declare @strategy_id int
declare @strategy varchar(25)
declare @new_external_account_id int
declare @allocated_status_id int
declare	@new_trade_id int
declare	@partial_trade_id int
declare @now_date datetime
declare @new_agg_count int
declare @new_summed_qty numeric(30, 4)
declare @new_tally_qty numeric(30, 4)


/* query ids */
select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = @trade_type
if @trade_type_id = NULL
begin
        select
                "error"="Problem finding trade_type",
                "trade_type"=@trade_type
        return
end

select
        @trader_id = trader_id
from
        traders
where
        symbol = @trader
if @trader_id = NULL
begin
        select
                "error"="Problem finding trader",
                "trader"=@trader
        return
end

select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @broker_id = NULL
begin
        select
                "error"="Problem finding broker",
                "broker"=@broker
        return
end

select
        @old_external_account_id = external_account_id
from
        external_accounts
where
        symbol = @external_account
if @old_external_account_id = NULL
begin
        select
                "error"="Problem finding external account",
                "external_account"=@external_account
        return
end

select
        @status_id = status_id
from
        statuses
where
        name = @status
if @status_id = NULL
begin
	select
		"error"="Problem finding status",
		"status"=@status
	return
end

select
        @counterparty_id = counterparty_id
from
        counterparties
where
        name = @counterparty
if @counterparty_id = NULL
begin
        select
                "error"="Problem finding counterparty",
                "status"=@counterparty
        return
end

select
        @contract_id = contract_id
from
        contracts
where
        symbol = @symbol
if @contract_id = NULL
begin
	select
		"error"="Problem finding contract",
		"contract"=@symbol
	return
end


/* Calculate aggregate details again to ensure deal has not been modified by another user */

create table
        #deal_info
(
        deal_id int NULL,
        trade_id int NULL,
        trade_type varchar(25) NULL,
        value_date varchar(25) NULL,
        symbol varchar(25) NULL,
        quantity float NULL,
        trade_price float NULL,
        trader varchar(25) NULL,
        broker varchar(25) NULL,
        external_account varchar(25) NULL,
        counterparty varchar(25) NULL,
        status varchar(25) NULL
)

insert into
	#deal_info
(
		deal_id,
		trade_id,
		value_date,
		quantity,
		trade_price
)
select
	deal_id,
	trade_id,
	value_date,
	quantity,
	price
from
	trades
where
	deal_id = @deal_id
and
	trade_type_id = @trade_type_id
and
	contract_id = @contract_id
and
	trader_id = @trader_id
and
	broker_id = @broker_id
and
	external_account_id = @old_external_account_id
and
	counterparty_id = @counterparty_id
and
	status_id = @status_id

/* Do some checks to make sure the deal was not edited */
select
	@new_agg_count = count(*)
from
	#deal_info

if @new_agg_count != @num_agg_trades
begin
	select
		"error"="Did not match tradecounts. Deal may have been recently modified. Please re-try aggregation",
		"deal_id"=@deal_id,
		"old_count"=@num_agg_trades,	
		"new_count"=@new_agg_count
	return
end

if @num_agg_trades = 1
begin
	select
        	@strategy_id = a.strategy_id
	from
		trades a,
		#deal_info b
	where
		a.trade_id = b.trade_id

	select
        	@strategy = name
	from
        	strategies
	where
		strategy_id = @strategy_id 
	if @strategy_id = NULL
	begin
        	select
                	"error"="Problem finding strategy",
                	"strategy_id"=@strategy_id
        	return
	end
end
	

select
	@new_summed_qty = sum(quantity)
from
	#deal_info

if @quantity != @new_summed_qty	and @new_summed_qty != 0
begin
	create table    
        	#new_deal_info(
        		deal_id int NULL,
        		trade_id int NULL,
        		trade_type varchar(25) NULL, 
        		value_date varchar(25) NULL,
        		symbol varchar(25) NULL,
        		quantity float NULL,
        		trade_price float NULL,
        		trader varchar(25) NULL,
        		broker varchar(25) NULL,
        		external_account varchar(25) NULL,
        		counterparty varchar(25) NULL,
        		status varchar(25) NULL)

       	insert into
               	#new_deal_info
               	(
                       	deal_id,
                       	trade_id,
                       	value_date,
                       	quantity,
                       	trade_price
               	)
       	select
               	deal_id,
               	trade_id,
               	value_date,
               	quantity,
               	price
       	from
		trades 
       	where
               	deal_id = @deal_id
       	and
               	external_account_id != @old_external_account_id


        select
                @new_tally_qty = (sum(quantity) + @quantity) * -1
        from
                #new_deal_info


	/*
	if @new_summed_qty < 0
	begin
                select
                        @new_tally_qty = @new_summed_qty + @quantity
	end
	else if @new_summed_qty > 0
	begin
                select
                        @new_tally_qty = @new_summed_qty - @quantity

	end
		select
			@new_tally_qty = @new_summed_qty - @quantity
	end
	else if @quantity < 0 and @new_summed_qty > 0
	begin
		select
			@new_tally_qty = @new_summed_qty + @quantity
	end
        else if @quantity > 0 and @new_summed_qty > 0
        begin
                select
                        @new_tally_qty = @new_summed_qty + @quantity
        end
        else if @quantity > 0 and @new_summed_qty > 0
        begin
                select
                        @new_tally_qty = @new_summed_qty + @quantity
        end
	*/

end

	

		
	
		

/* Allocate child trades */

select
	@allocated_status_id = status_id
from
	statuses
where
	name = "Allocated"

select
	@new_external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @@rowcount != 1
begin	
	select
		status = "Error",
		msg = "Account " + @account + " not found"
	return
end

if @quantity = 0
begin
	select
		"msg"="Buys and Sells netted to zero, allocating to internal account selected"
	if upper(@account) like "%INTERNA%"
	begin
		update
			trades
		set 
			external_account_id = @new_external_account_id,
			status_id = @allocated_status_id,
			quantity = 0
		from
			trades a,
			#deal_info b
		where
			a.trade_id = b.trade_id
	end
	else
	begin
	        select
 	               "error"="Did not select and INTERNAL account, can not allocation deal with net quantity 0 to a non internal account"
		return
	end
end
else
begin
	/* Tally aggregate trade */
	select
		@now_date = getdate()
	
	exec
		fxa_tallytrade
			@login = @login,
			@source = "MPT Manual Tally",
			@trade_id = @new_trade_id out,
			@deal_id = @deal_id,
			@deal_type = "B2B Forward",
			@tally_type = @trade_type,
			@trade_type = @trade_type,
			@external_account = @account,
			@trader = @trader,
			@broker = @broker,
			@counterparty = @counterparty,
			@symbol = @symbol,
			@value_date = @value_date,
			@trade_date = @now_date,
			@quantity = @quantity,
			@price = @trade_price,
			@status = "Allocated",
			@strategy = @strategy
	
	/* If the trade was tallied, then delete the trades */
	if @new_trade_id != NULL
	begin

		/* If quantities do not match, create a new ticket with the difference */
		select new_tally_qty = @new_tally_qty
                if @new_tally_qty not in(0, NULL)
		begin
			exec
                		fxa_tallytrade
                        		@login = @login,
                        		@source = "MPT Manual Tally",
                        		@trade_id = @partial_trade_id out,
                        		@deal_id = @deal_id,
                        		@deal_type = "B2B Forward",
                        		@tally_type = @trade_type,
                        		@trade_type = @trade_type,
                        		@external_account = @external_account,
                        		@trader = @trader,
                        		@broker = @broker,
                        		@counterparty = @counterparty,
                        		@symbol = @symbol,
                        		@value_date = @value_date,
                        		@trade_date = @now_date,
                        		@quantity = @new_tally_qty,
                        		@price = @trade_price,
                        		@status = "Partially Allocated",
					@strategy = @strategy
		end

		
		/* Delete all trades */
		insert into
			aggregated_trades (
				aggregate_trade_id,
				trade_id,
				deal_id,
				user_id,
				trade_type_id,
				internal_account_id,
				external_account_id,
				counterparty_id,
				quantity,
				contract_id,
				value_date,
				fixing_date,
				price,
				trade_date,
				trader_id,
				strategy_id,
				status_id,
				broker_id,
				sales_code_id,
				identifier,
				pct_price,
				spot_reference
			)
		select
			@new_trade_id,
			b.trade_id,
			b.deal_id,
			b.user_id,
			b.trade_type_id,
			b.internal_account_id,
			b.external_account_id,
			b.counterparty_id,
			b.quantity,
			b.contract_id,
			b.value_date,
			b.fixing_date,
			b.price,
			b.trade_date,
			b.trader_id,
			b.strategy_id,
			b.status_id,
			b.broker_id,
			b.sales_code_id,
			b.identifier,
			b.pct_price,
			b.spot_reference
		from
			#deal_info a,
			trades b
		where
			a.trade_id = b.trade_id
	
	
		delete
			trades
		from
			trades a,
			#deal_info b
		where
			a.trade_id = b.trade_id
	
		/* we don't need to know who it was allocated to in the child trades
		update 
			aggregated_trades
		set
			a.external_account_id = @new_external_account_id,
			a.status_id = @allocated_status_id
		from
			aggregated_trades a,
			#deal_info b
		where
			a.trade_id = b.trade_id
		we dont want to update but delete instead
		update
			trades
		set
			quantity = 0 
		from
			trades a,
			#deal_info b
		where
			a.trade_id = b.trade_id
		*/
	
		exec
			r_inserttradenotification
				@new_trade_id
	end
end
	
		
exec
	r_allocationtrades
		@login,
		@run



go 
