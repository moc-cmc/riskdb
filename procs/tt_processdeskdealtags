if object_id("tt_processdeskdealtags") != null
    drop procedure
        tt_processdeskdealtags
go


create proc
	tt_processdeskdealtags
        @login varchar(50),
        @deal_id int = NULL,
        @deal_tag_id int = NULL
as

declare @bench_start datetime
select
    @bench_start = getdate()

declare @committed_status_id int

declare @deal_tag varchar(50)

declare @group_deal_id int
declare @deal_count int

declare @trade_date datetime
declare @symbol varchar(50)
declare @value_date datetime
declare @quantity numeric(30,4)
declare @price float
declare @external_account varchar(50)
declare @trader varchar(50)
declare @broker varchar(50)
declare @counterparty varchar(50)

if @login = NULL
begin
    select
        status = "Error",
        message = "Login required"
    return
end

/* 
 * FIND @committed_status_id = "Committed" status
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = null
begin
    select
        status = "Error",
        message = "Couldn't find 'Committed' status",
        committed_status_id = @committed_status_id
    return
end

create table
    #messages (
        id int identity,
        subject varchar(25),
        message varchar(125)
    )

/* insert into #messages select "Process Deal Tags", "M1 took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" */

/*
 * TABLE #trades: Holds all trades 
 */
create table
    #trades (
        trade_id int,
        trade_tag_id int NULL,
        deal_id int,
        deal_tag_id int,
        deal_tag_status_id int,
    )

/* 
 * TABLE #deal_x_deal_tags: holds all matching deals x matching deal_tags. This
 * table is then used to find any invalid deal tags, onces matching more than
 * one deal. Also used to generate #deals rows.
 */
create table
    #deal_x_deal_tags (
        deal_id int,
        deal_tag_id int,
        deal_tag_status_id int,
        match_count int
    )

/* 
 * TABLE #multitag_deals: This table is then used to find any invalid deal tags,
 * onces matching more than one deal. Derived from #deal_x_deal_tags
 */
create table
    #multitag_deals (
        deal_id int,
        deal_tag_count int
    )

/* 
 * TABLE #deals: Derived from #deal_x_deal_tags, is a list of deals that need to
 * be processed.
 */
create table
    #deals (
        deal_id int,
        deal_tag_id int,
        deal_tag_status_id int,
        trade_count int NULL,
        trade_tag_count int NULL
    )

/* 
 * TABLE #netting_trades: Holds all group-by results for (deal, trade details)
 * that need to be netted provided to r_manageticketgroup as parameters.
 * Generated from #deals and trades table using a group-by + having
 */
create table 
    #netting_trades (
        deal_id int,
        external_account varchar(50),
        symbol varchar(50),
        value_date datetime,
        quantity float,
        price float,
        trader varchar(50),
        broker varchar(25),
        counterparty varchar(50)
    )

begin tran

    /* 
     * FIND #trades: All trades whose deal's status is not "Committed" and
     * matches some trade_tags.tag. These trades are known to be matched off.
     * We'll use these #trades to see what deals need to be modified.
     */
    insert into
        #trades (
            trade_id,
            trade_tag_id,
            deal_id,
            deal_tag_id,
            deal_tag_status_id
        )
    select
        a.trade_id,
        b.trade_tag_id,
        a.deal_id,
        b.deal_tag_id,
        ba.status_id
    from
        trades a,
        deals aa,
        statuses aaa,
        trade_tags b,
        deal_tags ba
    where
        a.deal_id = aa.deal_id
    and
        aa.status_id = aaa.status_id
    and
        b.deal_tag_id = ba.deal_tag_id
    and
        aaa.name != "Committed"
    and
        b.tag = a.identifier
        /* charindex(b.tag, a.identifier) = 1 / * a.identifier starts with b.tag */
        

    /* insert into #messages select "Process Deal Tags", "M2 took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" */

    /*
     * FIND #deals: from #trades by deal_id and match off with deal_tag_id
     */
    insert into
        #deal_x_deal_tags (
            deal_id,
            deal_tag_id,
            deal_tag_status_id,
            match_count
        )
    select
        deal_id,
        deal_tag_id,
        deal_tag_status_id,
        count(*)
    from
        #trades
    group by
        deal_id,
        deal_tag_id,
        deal_tag_status_id


    /* insert into #messages select "Process Deal Tags", "M2 took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" */

    /* DEBUG * / select msg="M1", * from #deal_x_deal_tags order by deal_id / * DEBUG */

    /* 
     * FIND #multitag_deals: from #deal_x_deal_tags by deal_id that have more
     * than one tag
     */
    insert into
        #multitag_deals
    select
        deal_id,
        count(*)
    from
        #deal_x_deal_tags
    group by
        deal_id
    having
        count(*) > 1

    /*
     * DELETE #deal_x_deal_tags that have #multitag_deals
     */
    if exists(
        select
            *
        from
            #multitag_deals
    )
    begin

        insert into
            #messages
        select
            subject = "Multitag Deals",
            message = "Ignoring deal " + convert(varchar(10), deal_id) + ", has trades associated with " + convert(varchar(10), deal_tag_count) + " deal tags"
        from
            #multitag_deals
        order by
            deal_id

        delete 
            #deal_x_deal_tags
        from
            #deal_x_deal_tags a,
            #multitag_deals b
        where
            a.deal_id = b.deal_id

    end

    /* insert into #messages select "Process Deal Tags", "M3 took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" */

    /* DEBUG * / select msg="M2", * from #deal_x_deal_tags order by deal_id / * DEBUG */



    /*+-----------------------------------------------------------------------* 
     |                    PERFORM Step #1: "Add To Group"                     | 
     *------------------------------------------------------------------------*/

    /* 
     * Group deals together. This is equivalent to the "Add To Group" step in
     * the Assign Trades tico page. We'll do this by finding all of the
     * #deal_x_deal_tags with the same deal_tag_id and
     */
    declare
        grouping_deal_tags
    cursor for select
        deal_tag_id,
        count(*)
    from
        #deal_x_deal_tags
    group by
        deal_tag_id
    having
        count(*) > 1
    order by
        deal_tag_id

    open
        grouping_deal_tags

    fetch
        grouping_deal_tags
    into
        @deal_tag_id,
        @deal_count

    /* 
     * LOOP grouping_deal_tags. For each @deal_tag_id that is associated with
     * more than one deal...
     */
    while @@sqlstatus = 0
    begin

        select
            @group_deal_id = min(deal_id)
        from
            #deal_x_deal_tags
        where
            deal_tag_id = @deal_tag_id
        
        declare
            grouping_deals
        cursor for select
            deal_id
        from
            #deal_x_deal_tags
        where
            deal_tag_id = @deal_tag_id
        and
            deal_id > @group_deal_id
        group by
            deal_id
        order by
            deal_id
        
        open
            grouping_deals
        
        fetch
            grouping_deals
        into
            @deal_id
        
        while @@sqlstatus = 0
        begin
            
            insert into
                #messages
            select
                subject = "Grouping Deals",
                message = "Grouping deal " + convert(varchar(10), @deal_id) + " into group deal " + convert(varchar(10), @group_deal_id)
                
            /*
             * EXEC r_manageticketgroup to group @deal_id into @group_deal_id
             */
            exec
                r_manageticketgroup
                    @login,
                    @trade_date,
                    @action = "Add to Group",
                    @group_deal_id = @group_deal_id,
                    @deal_id = @deal_id

            /* 
             * UPDATE #deal_x_deal_tags: Take on the @group_deal_id since that's
             * what's now reflected in the trades.deal_id
             */
            update
                #deal_x_deal_tags
            set
                deal_id = @group_deal_id
            where
                deal_tag_id = @deal_tag_id
            and
                deal_id = @deal_id
            
            fetch
                grouping_deals
            into
                @deal_id
            
        end
        
        close
            grouping_deals
        deallocate cursor
            grouping_deals


        fetch
            grouping_deal_tags
        into
            @deal_tag_id,
            @deal_count

    end

    close
        grouping_deal_tags
    deallocate cursor
        grouping_deal_tags

    /* insert into #messages select "Process Deal Tags", "M4 took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" */

    /* DEBUG * / select msg="M3", * from #deal_x_deal_tags order by deal_id / * DEBUG */

    /*+-----------------------------------------------------------------------* 
     |                             COLLECT #deals                             | 
     *------------------------------------------------------------------------*/
     /* 
      * FIND #deals: from #deal_x_deal_tags now that all (group_deal_id,
      * deal_tag_id) has become the natural key of deals we want to deal with
      * for steps #2 and #3.
      */
    insert into
        #deals (
            deal_id,
            deal_tag_id,
            deal_tag_status_id
        )
    select distinct
        deal_id,
        deal_tag_id,
        deal_tag_status_id
    from
        #deal_x_deal_tags

    /* DEBUG * / select msg="M4", * from #deals order by deal_id / * DEBUG */

    /*
     * VALIDATE #deals: #deals.deal_id should be unique
     */
    if exists (
        select
            deal_id
        from
            #deals
        group by
            deal_id
        having
            count(*) > 1
    )
    begin
        select
            status = "Error",
            message = "Implementation error: There should be no deals with multiple rows in #deals"
        select
            *
        from
            #deals

        select
            subject,
            message
        from
            #messages
        order by
            id

        return
    end

    /*
     * VALIDATE #deals: #deals.deal_tag-id should be unique
     */
    if exists (
        select
            deal_tag_id
        from
            #deals
        group by
            deal_tag_id
        having
            count(*) > 1
    )
    begin
        select
            status = "Error",
            message = "Implementation error: There should be no deal tags with multiple rows in #deals"
        select
            *
        from
            #deals

        select
            subject,
            message
        from
            #messages
        order by
            id

        return
    end

    /* insert into #messages select "Process Deal Tags", "M5 took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" */

    /* 
     * UPDATE #deals with the number of trades for the deal_id and number of
     * trade_tags for the deal_tag_id. These numbers should match for deal tags
     * that are committed.
     */
    update
        #deals
    set
        trade_count = (
            select
                count(*)
            from
                trades b
            where
                b.deal_id = a.deal_id
        ),
        trade_tag_count = (
            select
                count(*)
            from
                trade_tags c
            where
                c.deal_tag_id = a.deal_tag_id
        )
    from
        #deals a

    /* DEBUG * / select msg="M5", * from #deals order by deal_id / * DEBUG */

    /*+-----------------------------------------------------------------------* 
     |   TRIM Cut down the deals that are incosistent or are not yet ready    | 
     *------------------------------------------------------------------------*/
     
    /* Delete any #deals whose deal_tag_status_id is not "Committed". These
     * deals will receive new trades and thus won't be */

    /* 
     * DELETE #deals whose deal_tag_status_id is not "Committed"
     */
    insert into
        #messages
    select
        subject = "Unfinished Deals",
        message = "Ignoring deal " + convert(varchar(10), a.deal_id) + ", deal tag " + convert(varchar(10), a.deal_tag_id) + ", with a status of '" + convert(varchar(25), b.name) + "'"
    from
        #deals a,
        statuses b
    where
        a.deal_tag_status_id = b.status_id
    and
        b.name not in ("Committed", "Cancelled")
    order by
        deal_id

    delete 
        #deals
    from
        #deals a,
        statuses b
    where
        a.deal_tag_status_id = b.status_id
    and
        b.name not in ("Committed", "Cancelled")

    /* 
     * DELETE #deals whose trade_count != trade_tag_count
     */
    insert into
        #messages
    select
        subject = "Missing Trades",
        message = "Ignoring deal " + convert(varchar(10), a.deal_id) + ", deal tag " + convert(varchar(10), a.deal_tag_id) + ", with #trades = " + convert(varchar(10), a.trade_count) + ", #trade_tags = " + convert(varchar(10), a.trade_tag_count)
    from
        #deals a
    where
        a.trade_count != a.trade_tag_count
    order by
        a.deal_id

    delete 
        #deals
    from
        #deals a
    where
        a.trade_count != a.trade_tag_count
    
commit tran

/* insert into #messages select "Process Deal Tags", "M6 took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" */

/* DEBUG * / select msg="M6", * from #deals order by deal_id / * DEBUG */






/*+---------------------------------------------------------------------------* 
 |                      PERFORM Step #3: "Commit" deals                       | 
 *----------------------------------------------------------------------------*/
 
declare
    committing_deals
cursor for select
    deal_id
from
    #deals
order by
    deal_id

open
    committing_deals

fetch
    committing_deals
into
    @deal_id

while @@sqlstatus = 0
begin
    
    /*
     * EXEC r_manageticketgroup to group @deal_id into @group_deal_id
     */
    exec
        r_manageticketgroup
            @login = @login,
            @trade_date = @trade_date,
            @action = "COMMIT",
            @group_deal_id = @deal_id
    
    insert into
        #messages
    select
        subject = "Committed Deal",
        message = "Committed deal " + convert(varchar(10), @deal_id)
   

    /*
     * COPY trade_tags into processed_trade_tags
     */
    insert into
        processed_trade_tags
    select
	trade_tag_id,
	deal_tag_id, 
	tag,
	quantity,
	tag_date
    from
        trade_tags a,
        #deals b
    where
        a.deal_tag_id = b.deal_tag_id
    and
        b.deal_id = @deal_id
 
    /*
     * DELETE trade_tags for this deal
     */
    delete
        trade_tags
    from
        trade_tags a,
        #deals b
    where
        a.deal_tag_id = b.deal_tag_id
    and
        b.deal_id = @deal_id
    
    insert into
        #messages
    select
        subject = "Deleted Trade Tags",
        message = "Deleted " + convert(varchar(10), @@rowcount) + " trade tag(s) for deal " + convert(varchar(10), @deal_id)
    

    /*
     * COPY deal_tags into processed_deal_tags
     */
    insert into 
        processed_deal_tags
    select 
        deal_tag_id,
        tag,
        quantity,
        status_id,
        tag_date
    from
        deal_tags a,
        #deals b
    where
        a.deal_tag_id = b.deal_tag_id
    and
        b.deal_id = @deal_id


    /*
     * DELETE deal_tags for this deal
     */
    delete
        deal_tags
    from
        deal_tags a,
        #deals b
    where
        a.deal_tag_id = b.deal_tag_id
    and
        b.deal_id = @deal_id
    
    insert into
        #messages
    select
        subject = "Deleted Deal Tags",
        message = "Deleted " + convert(varchar(10), @@rowcount) + " deal tag(s) for deal " + convert(varchar(10), @deal_id)
        
    fetch
        committing_deals
    into
        @deal_id

end

insert into
    #messages
select
    "Process Deal Tags",
    "Total took " + convert(varchar(11), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms"

/*
 * DISPLAY: #messages
 */
if exists (
    select
        *
    from
        #messages
)
begin
    select
        subject,
        message
    from
        #messages
    order by
        id
end

go
