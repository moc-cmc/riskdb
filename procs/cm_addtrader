
if object_id("cm_addtrader") != NULL
    drop procedure
        cm_addtrader
go

create procedure
	cm_addtrader
		@login varchar(30),
		@trader varchar(50),
		@sales_code varchar(50),
		@external_account varchar(50)
as


declare @trader_id int
declare @tico_account_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)
declare @sales_code_id int
declare @external_account_id int
declare @external_account_type varchar(50)


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error", 
		message = "Login not found"
	return
end

select
	@sales_code_id = sales_code_id
from
	sales_codes
where
	name = @sales_code
if @@rowcount != 1
begin
	exec
		j_nextkey
			"sales_codes",
			@sales_code_id output

	insert into
		sales_codes
	values(
		@sales_code_id,
		@sales_code)
end

select
	@external_account_id = a.external_account_id,
	@external_account_type = b.name
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	a.symbol = @external_account
if @@rowcount != 1
begin
	select
		status= "Error",
		message = "External account not found",
		external_account = @external_account
	return
end

if @external_account_type = "Client"
begin
	select
		@tico_account_id = 0
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 0
begin
	select
		status = "Dupe",
		message = "Trader already exists",
		trader = @trader
	return
end

exec
	j_nextkey
		"traders",
		@trader_id output


insert into
	traders
values(
	@trader_id,
	@trader,
	@tico_account_id,
	1,
	@external_account_id,
	@sales_code_id)


select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds


select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string


exec
	cm_traders
		@login

go
