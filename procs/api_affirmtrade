
create or replace procedure
	api_affirmtrade
		@login varchar(25),
		@trade_id int
as


declare	@trade_status_id int
declare @tico_account_id int
declare @affirmation_log_id int
declare @active_status_id int
declare @trade_notification_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login=@login

if @@rowcount != 1
begin
	select
		error="Error",
		msg="Login not found",
		login=@login

	return
end

select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"

exec
	j_nextkey "affirmation_log", @affirmation_log_id out

if(@affirmation_log_id = NULL)
begin
	select
		status="Error",
		msg="Could not get id for affirmation_log"
	return
end

select
	@trade_status_id = status_id
from
	statuses
where
	name="Affirmed"

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Trade Status does not exist",
		trade_status="Affirmed"

	return
end

begin tran

	update 
		trades  
	set
		status_id=@trade_status_id
	where
		trade_id=@trade_id

	if @@rowcount !=1
	begin
		select
			status="Error",
			msg="Could not update trade status for id",
			trade_id=@trade_id

		rollback tran
		return
	end

	insert into
		affirmation_log(
			affirmation_log_id,
			trade_id,
			tico_account_id,
			affirm_date)
	values(
		@affirmation_log_id,
		@trade_id,
		@tico_account_id,
		getdate())

	if @@rowcount !=1
	begin
		select
			status="Error",
			msg="Could not create affirmation log record",
			affirmation_log_id=@affirmation_log_id

		rollback tran
		return
	end

				
commit tran


/* chriso: this wont work if there are multiple affirmation notifications/sources
 *         but generally affirmation only need to be notified to a single
 *         regulatory source so leaving for now. Not great hardcoding.
 */
select
	@trade_notification_id = trade_notification_id
from
	trade_notifications a,
	sources b
where
	a.trade_id = @trade_id
and
	a.source_id = b.source_id
and
	b.name like "%Affirmation"

if @trade_notification_id = NULL
begin
	exec
        	r_inserttradenotification
			@trade_id = @trade_id
end
else
begin
	begin tran
		update
			trade_notifications
		set
			status_id = @active_status_id
		where
			trade_notification_id = @trade_notification_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem setting previously affirmed trade notifiation status to active"
			rollback
			return
		end
	commit tran
end




go 

