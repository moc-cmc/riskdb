drop procedure
	ag_processfssadjustments
go

create procedure
	ag_processfssadjustments
		@login varchar(50),
		@trade_date datetime
as

declare @fund_id int
declare @tico_account_id int
declare @evaluation_currency_id int
declare @transaction_type_id int
declare @account varchar(50)
declare @external_account_id int
declare @product_id int 
declare @fss_balance numeric(30,4)
declare @balance numeric(30,4) 
declare @adjustment numeric(30,4)
declare @account_transaction_id int
declare @transaction_date datetime
declare @id int
declare @ids int

exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

select
	@transaction_date = convert(datetime, convert(date, @trade_date))

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Net Cash Activity"
if @transaction_type_id = NULL
begin
	exec
		j_nextkey
			"transaction_types",
			@transaction_type_id output

	insert into
		transaction_types(
			transaction_type_id,
			name,
			direction)
	values(
		@transaction_type_id,
		"Net Cash Activity",
		1)
end

create table
	#balances(
		external_account_id int,
		product_id int,
		balance float NULL,
		equiv float NULL)
insert into
	#balances(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	products b,
	product_types c
where
	a.currency_id = b.product_id
and
	b.product_type_id = c.product_type_id
and
	a.transaction_date <= dateadd(hour, 17, convert(datetime, convert(date, @trade_date)))
and
	c.name = "Currency"
group by
	a.external_account_id,
	a.currency_id


create table
	#net_fss_balances(
		id int identity,
		external_account_id int,
		product_id int,
		balance float NULL)

insert into
	#net_fss_balances(
		external_account_id,
		product_id,
		balance)
select
	external_account_id,
	product_id,
	sum(closing_balance)
from
	fss_cash_balances
where
	convert(date, trade_date) = convert(date, @trade_date)
group by
	external_account_id,
	product_id


create table
	#external_accounts(
		id int identity,
		external_account_id int)
insert into
	#external_accounts(
		external_account_id)
select
	distinct(external_account_id)
from
	trades
where
	convert(date, value_date) = convert(date, @trade_date)


create table
	#products(
		product_id int)

select
	@id = 0
select
	@ids = count(*)
from
	#external_accounts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#external_accounts
	where
		id > @id

	select
		@external_account_id = NULL

	select
		@external_account_id = external_account_id
	from
		#external_accounts
	where
		id = @id


	truncate table
		#products

	insert into
		#products(
			product_id)
	select
		a.product_id
	from
		products a,
		product_types b
	where
		a.product_type_id = b.product_type_id
	and
		b.name = "Currency"

	delete
		#products
	from
		#products a,
		#net_fss_balances b
	where
		a.product_id = b.product_id
	and
		b.external_account_id = @external_account_id


	insert into
		#net_fss_balances(
			external_account_id,
			product_id,
			balance)
	select
		external_account_id = @external_account_id,
		product_id,
		balance = 0.0
	from
		#products
		

	select
		@ids = count(*)
	from
		#external_accounts
	where
		id > @id
end

select
	@id = 0
select
	@ids = count(*)
from
	#net_fss_balances
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#net_fss_balances
	where
		id > @id

	select
		@external_account_id = NULL,
		@fss_balance = NULL,
		@balance = NULL,
		@adjustment = NULL,
		@account = NULL,
		@account_transaction_id = NULL

	select
		@external_account_id = external_account_id,
		@product_id = product_id,
		@fss_balance = balance
	from
		#net_fss_balances
	where
		id = @id

	select
		@balance = balance
	from
		#balances
	where
		external_account_id = @external_account_id
	and
		product_id = @product_id
	if @balance = NULL
		select
			@balance = 0.0

	select
		@account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id


	select
		fss_balance = @fss_balance,
		balance = @balance /* MARKR */
	select
		@adjustment = @fss_balance - @balance

	if @adjustment = NULL
	begin
		select
			status = "Error",
			message = "Unable to calculate adjustment for account",
			account = @account
	end
	else
	begin
		if abs(@adjustment) >= .01
		begin
			exec
				j_nextkey
					"account_transactions",
					@account_transaction_id output

			insert into
				account_transactions(
					account_transaction_id,
					entered_by,
					external_account_id,
					transaction_type_id,
					transaction_date,
					currency_id,
					amount)
			values(
				@account_transaction_id,
				@tico_account_id,
				@external_account_id,
				@transaction_type_id,
				@transaction_date,
				@product_id,
				@adjustment)
		end
	end 


	select
		@ids = count(*)
	from
		#net_fss_balances
	where
		id > @id
end


go

