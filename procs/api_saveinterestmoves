drop procedure
	api_saveinterestmoves
go

create procedure
	api_saveinterestmoves
		@login varchar(50),
		@trade_date datetime,
		@display_queued varchar(10)=NULL
as


declare @fund_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int 
declare @ids int
declare @product_id int
declare @product varchar(10)
declare @rate float
declare @balance float
declare @days float
declare @external_account_id int
declare @interest float
declare @transaction_type_id int
declare @tico_account_id int
declare @queued_transaction_id int
declare @batch_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Interest Accrual"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Interest transaction type not found"
	return
end



select
	@trade_date = convert(datetime, convert(date, @trade_date))

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output


create table
	#balances(
		id int identity,
		external_account_id int,
		product_id int,
		balance float)
insert into
	#balances(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date < @end_date
group by
	a.external_account_id,
	a.currency_id


exec
	j_nextkey
		"batches",
		@batch_id output
delete

from
	queued_transactions
where
	tico_account_id = @tico_account_id
and
	convert(date, transaction_date) = convert(date, @trade_date)

create table
	#rates(
		id int identity,
		product_id int,
		rate float NULL)

insert into
	#rates(
		product_id)
select
	distinct(product_id)
from
	#balances

select
	@id = 0
select
	@ids = count(*)
from
	#rates
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#rates
	where
		id > @id

	select
		@rate = NULL,
		@product_id = NULL

	select
		@product_id = product_id
	from
		#rates
	where
		id = @id

	exec
		r_rateasof
			@product_id = @product_id,
			@as_of_date = @end_date,
			@rate_date = @end_date,
			@rate = @rate output

	update
		#rates
	set
		rate = @rate
	where
		product_id = @product_id

	select
		@ids = count(*)
	from
		#rates
	where
		id > @id

end

select
	@id = 0
select
	@ids = count(*)
from
	#balances
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#balances
	where
		id > @id

	select
		@product_id = NULL,
		@balance = NULL,
		@rate = NULL,
		@interest = NULL,
		@external_account_id = NULL,
		@product = NULL,
		@queued_transaction_id = NULL,
		@days = NULL

	select
		@product_id = product_id,
		@balance = balance,
		@external_account_id = external_account_id
	from
		#balances
	where
		id = @id

	select
		@days = 1.0

	select
		@rate = rate
	from
		#rates
	where
		product_id = @product_id

	select
		@product = symbol
	from
		products
	where
		product_id = @product_id

	if @rate = NULL
	begin
		select
			status = "Error",
			message = "No rate found for product",
			product = @product
	end
	else
	begin
		select
			@interest = (@balance * exp(@rate * (@days/360.0))) - @balance

		if @interest != NULL and abs(@interest) >= 0.01
		begin
			exec
				j_nextkey
					"queued_transactions",
					@queued_transaction_id output

			insert into
				queued_transactions(
					queued_transaction_id,
					tico_account_id,
					batch_id,
					entered_by,
					external_account_id,
					transaction_type_id,
					transaction_date,
					currency_id,
					amount,
					balance,
					rate,
					days)
			values(
				@queued_transaction_id,
				@tico_account_id,
				@batch_id,
				@tico_account_id,
				@external_account_id,
				@transaction_type_id,
				@trade_date,
				@product_id,
				convert(numeric(30,2), @interest),
				@balance,
				@rate,
				@days)
		end
				
	end


	select
		@ids = count(*)
	from
		#balances
	where
		id > @id
end

if @display_queued = "Yes"
begin
	exec
		ag_queuedinterestmoves
			@login = @login,
			@batch_id = @batch_id
end








go
