create procedure
	eod_pbpositionsfromtrades
		@login varchar(50),
		@prime_broker varchar(50),
		@source varchar(50)=NULL,
		@trade_date datetime=NULL,
		@mark_to_market char(1)=NULL
		
as

declare @source_id int
declare @begin_date datetime
declare @end_date datetime
declare @prime_id int
declare @fund_id int
declare @evaluation_currency_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end


create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50)
)
insert into
	#external_accounts
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	external_account_prime_brokers b,
	prime_brokers c,
	sources d,
	external_account_types e
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = c.prime_broker_id
and
	c.source_id = d.source_id
and
	d.name = @prime_broker
and
	a.external_account_type_id = e.external_account_type_id
and
	e.name = "Client"



select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1 and @source != NULL
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

select
	@trade_date = convert(date, @trade_date)

exec
	r_daterangefordate 
		@trade_date,
		@begin_date output,
		@end_date output


