/*
|  Query contracts, dealt ccy, counter ccy
*/
update 
	#trades
set
	std_contract = b.symbol,
        traded_ccy = g.symbol,
        counter_ccy = f.symbol
from
	#trades a,
	contracts b,
	forwards e,
	products f,
	products g
where
	a.contract_id = b.contract_id
and
	b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#trades
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy)
from
	#trades a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

update
	#trades
set
	std_contract = b.symbol
from
	#trades a,
	contracts b,
	instruments c
where
	a.contract_id =b.contract_id
and
	b.instrument_id = c.instrument_id
and
	c.name in("Option", "Exotic")


update
	#trades
set
	prime_broker_id = d.prime_broker_id,
	prime_broker = c.name
from
	#trades a,
	external_account_prime_brokers b,
	prime_brokers d,
	sources c
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = d.prime_broker_id
and
	c.source_id = d.source_id

update
	#trades
set
	prime_broker = b.symbol
from
	#trades a,
	prime_broker_symbols b
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = @source_id


update
	#trades
set
	is_inverted_contract = "Y"
from
	#trades a,
	contracts b,
        contract_price_styles c,
        price_styles d
where
	convert(varchar(3), a.traded_ccy)+convert(varchar(3), a.counter_ccy) = b.symbol
and
        b.contract_id = c.contract_id
and
        c.price_style_id = d.price_style_id
and
        d.name = "Inverted"


if @mark_to_market = "Y"
begin
	/* set product id */
	update
        	#trades
	set
        	product_id = b.product_id,
        	currency_id = b.currency_id
	from
        	#trades a,
        	forwards b
	where
        	a.contract_id = b.contract_id

	/* get the eval ccy */	
	create table
        	#eval_ccys(
                	product_id int,
                	symbol varchar(10) NULL
	)
	insert into
        	#eval_ccys(
                	product_id)
	select
        	distinct(evaluation_currency_id)
	from
        	funds

	/* Find out what products have been traded */
	create table
		#traded_products(
			product_id int
	)
	
	insert into
		#traded_products
	select
		distinct(product_id)
	from
		#trades
	
	insert into 
		#traded_products
	select
		distinct(currency_id)
	from
		#trades
	where
		currency_id not in(select product_id from #traded_products)

	/* Get the conversion rated from traded products to eval ccy */	
	create table
		#conversion_contracts
	(
		contract_id int NULL,
		product_id int,
		currency_id int,
		inverse_contract_id int NULL,
		standard_price float NULL,
		conversion_price float NULL
	)
	
	insert into 
		#conversion_contracts(
			contract_id,
			product_id,
			currency_id
		)
	select
		a.contract_id,
		a.product_id,
		a.currency_id
	from
		forwards a,
		#traded_products b,
		#eval_ccys c
	where
		a.product_id = b.product_id
	and
		a.currency_id = c.product_id

	update
		#conversion_contracts
	set
		inverse_contract_id = a.contract_id
	from
		forwards a,
		#conversion_contracts b
	where
		a.product_id = b.currency_id
	and
		a.currency_id = b.product_id

	/* create temp table of current prices so price ticks dont affect conversion rates */
	create table
		#current_prices(
			contract_id int,
			price float
	)
	insert into
		#current_prices
	select
		contract_id,
		price
	from
		current_prices

	/* set conversion rates from current prices */	
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		#current_prices a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	#current_prices a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
		b.standard_price = NULL

	/* ensure a rate of 1.0 exists for the eval to eval conversion */
	insert into
		#conversion_contracts
	(
		product_id,
		currency_id,
		conversion_price
	)
	select
		product_id,
		product_id,
		1.0
	from
		#eval_ccys


	update 
		#trades
	set
		pd1_eq = quantity * conversion_price,
                vo_rate = conversion_price
	from
		#trades a,
		#conversion_contracts b
	where
		a.product_id = b.product_id
	
	update
        	#trades
	set
        	pd2_eq = (quantity * db_price * -1) * conversion_price
	from
        	#trades a,
        	#conversion_contracts b
	where
        	a.currency_id = b.product_id
	
	update
		#trades
	set
		vo = abs(pd1_eq)

end

