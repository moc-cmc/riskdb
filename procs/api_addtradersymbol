
drop procedure
	api_addtradersymbol
go

create procedure
	api_addtradersymbol 
			@login varchar(25),
			@name varchar(50),
			@symbol varchar(50),
			@source varchar(100)
as

declare @trader_id int
declare @source_id int
declare @source_type_id int
declare @source_type varchar(50)

select 
	@symbol = ltrim(rtrim(@symbol))

select
	@trader_id=trader_id
from
	traders
where
	symbol=@name

if(@@rowcount != 1)
begin
	select
		status="Error",
		msg="Trader name does not exist",
		trader_name=@name
	
	return
end

select
        @source_id = source_id,
	@source_type_id = source_type_id
from
        sources
where
        name=@source

if (@@rowcount !=1)
begin
        select
                status="Error",
                msg="Source does not exist",
                source=@source

        return
end

select
        @source_type=name
from
        source_types
where
        source_type_id=@source_type_id

if (@source_type="Outbound")
begin
        if exists (select 
                        trader_id
                   from
                        trader_symbols
                   where
                        source_id=@source_id
                   and
                        trader_id=@trader_id)

        begin
                select
                        status="Error",
                        msg="Trader already has an Outbound Source",
                        name=@name

                return
        end
end


insert into
	trader_symbols (
		trader_id,
		source_id,
		symbol )
values (
	@trader_id,
	@source_id,
	@symbol )

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Problem adding Trader Symbol",
		trader_symbol=@symbol
	
	return
end

select
	status="OK",
	msg="Successfully added Trader Symbol",
	trader_symbol=@symbol

return

go
	
