drop procedure
	fxa_editb2bforward
go

create procedure
	fxa_editb2bforward
		@login varchar(50),
		@deal_id int,
		@tally_type varchar(25),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@client_price float,
		@client_val_date datetime,
		@client_fixing_date datetime,
		@market_price float,
		@market_val_date datetime,
		@market_fixing_date datetime

as


declare @symbol varchar(50)
declare @client_trade_id int
declare @market_trade_id int
declare @trade_date datetime

declare @client_quantity numeric(30,4)
declare @market_quantity numeric(30,4)

declare @client_external_account varchar(50)
declare @market_external_account varchar(50)
declare @market_sales_code varchar(25)


if @client_buys_sells = "Client Buys"
begin
	select
		@client_quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@client_quantity = abs(@quantity)
end

select
	@market_quantity = @client_quantity * -1.0

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)

select
	@trade_date = getdate()

if @client_val_date != NULL
begin
	if @market_val_date = NULL
		select
			@market_val_date = @client_val_date
end

select
	@client_external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

select
	@market_external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end

select
	@market_sales_code = "None"

select
	@client_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
and
	a.deal_id = @deal_id

select
	@market_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Counterparty"
and
	a.deal_id = @deal_id

exec
	r_inserttradeedit @client_trade_id

exec
	fxa_edittrade
		@login				=@login,
		@source				="MPT Manual Tally",
		@trade_id			=@client_trade_id output,
		@deal_id			=@deal_id output,
		@tally_type			=@tally_type,
		@deal_type			="B2B Forward",
		@trade_type			=@tally_type,
		@internal_account	=NULL,
		@external_account	=@client_external_account,
		@counterparty		=NULL,
		@quantity			=@client_quantity,
		@symbol				=@symbol,
		@value_date			=@client_val_date,
		@fixing_date		=@client_fixing_date,
		@price				=@client_price,
		@trade_date			=@trade_date,
		@trader				=@client_user,
		@strategy			=NULL,
		@status				=NULL,
		@broker				=NULL,
		@identifer			=NULL,
		@sales_code			=NULL,
		@premium			=NULL,
		@premium_currency	=NULL,
		@premium_settledate	=NULL,
		@pct_price			=NULL,
		@spot_reference		=NULL

if(@quantity = 0)
begin
	exec 
    	r_updatetradenotification @client_trade_id, "Cancelled"
end
else
begin
	exec
		r_updatetradenotification @client_trade_id, "Edit"
end

exec
    r_inserttradeedit @market_trade_id 

exec
	fxa_edittrade
		@login				=@login,
		@source				="MPT Manual Tally",
		@trade_id			=@market_trade_id output,
		@deal_id			=@deal_id,
		@tally_type			=@tally_type,
		@deal_type			="B2B Forward",
		@trade_type			=@tally_type,
		@internal_account	=NULL,
		@external_account	=@market_external_account,
		@counterparty		=@counterparty,
		@quantity			=@market_quantity,
		@symbol				=@symbol,
		@value_date			=@market_val_date,
		@fixing_date		=@market_fixing_date,
		@price				=@market_price,
		@trade_date			=@trade_date,
		@trader				=NULL,
		@strategy			=NULL,
		@status				=NULL,
		@broker				=NULL,
		@identifier			=NULL,
		@sales_code			=@market_sales_code,
		@premium			=NULL,
		@premium_currency	=NULL,
		@premium_settledate	=NULL,
		@pct_price			=NULL,
		@spot_reference		=NULL
	

if(@quantity = 0)
begin
    exec
        r_updatetradenotification @market_trade_id, "Cancelled"
end
else
begin
    exec
        r_updatetradenotification @market_trade_id, "Edit"
end


exec
	r_inspectdealtrades
		@login,
		@deal_id


go



