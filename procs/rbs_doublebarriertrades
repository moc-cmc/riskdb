update
	#option_trades
set
	expiration_zone=b.symbol,
	expiration_time=b.display_value
from
	#option_trades a,
	timezones b
where
	a.timezone_id=b.timezone_id

update
	#option_trades
set
	counter_amount = a.traded_amount * 1/a.strike
from
	#option_trades a,
	#newoptions b
where
	a.trade_ref=b.trade_id 
and
	b.price_style="Inverted"
	
select
	product_group,
	action,
	message_type,
	process,
	trade_ref,
	entity,
	portfolio,
	reporting_system,
	reporter_ticket_number,
	trader_name,
	counterparty,
	prime_broker,
	"trade_date" = convert(varchar(15), trade_date, 110),
	product_type,
	putcall,
	style,
	underlying_product,
	traded_currency,
	counter_currency,
	traded_amount,
	counter_amount,
	trade_price,
	value_date,
	settle_date,
	pct_price,
	spot_reference,
	strike,
	price_style,
	"expiration" = convert(varchar(15),expiration,110),
	premium_currency,
	premium_amount,
	premium_payment_date,
	fixing_date,
	expiration_time,
	expiration_zone,
	barrier_type,
	barrier,
	lower_barrier,
	upper_barrier,
	trade_notification_id
from
	#option_trades
order by
	trade_ref

