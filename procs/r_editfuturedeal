
if object_id("r_editfuturedeal") != NULL
    drop procedure
        r_editfuturedeal
go

create procedure
	r_editfuturedeal
		@login char(30),
		@deal_id int,
		@trade_date datetime,
		@symbol char(50),
		@value_date datetime=NULL,
		@trade_quantity numeric(30,0),
		@trade_price float,
		@trader char(100),
		@broker char(100),
		@strategy char(100)
as

declare @mode varchar(15)

declare @tico_account_id int
declare @fund_id int
declare @contract_id int
declare @strategy_id int
declare @broker_id int
declare @trader_id int
declare @price_style char(100)
declare @remainder_quantity numeric(30,0)
declare @new_trade_count int
declare @new_trade_id int

if @trade_quantity = 0
begin
	update
		trades
	set
		quantity = 0
	where
		deal_id = @deal_id

	update
		account_transactions
	set
		amount = 0.0
	from
		account_transactions a,
		account_transaction_trades b,
		trades c
	where
		a.account_transaction_id = b.account_transaction_id
	and
		b.trade_id = c.trade_id
	and
		c.deal_id = @deal_id

	exec
		r_inspectdealtrades
			@login,
			@deal_id

	exec
		r_intradayfwdpl
			@login

	return
end

select
    @mode = "update-only"
    /* KLS: Set to "update" to add/remove deals. This supports having no trades,
     * some trades or too many trades for a @deal_id, allowing you to reedit the
     * deal if you change allocations. */

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output
if @fund_id = NULL
begin
	select
		id = -1,
		error = "Problem finding default fund for user"
	return
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract for symbol",
		symbol = @symbol
	return
end

select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding strategy",
		strategy = @strategy
	return
end


select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding broker",
		broker = @broker
	return
end

select
	@value_date = convert(datetime, convert(date, @value_date))

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding trader with initials",
		trader = @trader
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id

if @price_style = "Inverted"
begin
	select
		@trade_price = 1 / @trade_price 

end

create table
    #allocations (
	status char(1),
	trade_id int NULL,
	trade_date datetime,
	internal_account_id int,
	external_account_id int,
	contract_id int,
	value_date datetime NULL,
	quantity numeric(30,0),
	price float,
	trader_id int,
	broker_id int,
	strategy_id int
    )
    
insert into
    #allocations
select
    status = "?",
    trade_id = NULL,
    trade_date = @trade_date,
    internal_account_id,
    external_account_id,
    contract_id = @contract_id,
    value_date = @value_date,
    quantity = convert(numeric(30,0), round(@trade_quantity * percentage, 0)),
    price = @trade_price,
    trader_id = @trader_id,
    broker_id = @broker_id,
    strategy_id = @strategy_id
from    
    external_future_allocations
where
    fund_id = @fund_id
    
select
    @remainder_quantity = @trade_quantity - sum(quantity)
from
    #allocations
    
if @remainder_quantity != 0
begin

    insert into
	#allocations
    select
	"?",
	NULL,
	@trade_date,
	min(remainder_int_account_id),
	min(remainder_ext_account_id),
	@contract_id,
	@value_date,
	@remainder_quantity,
	@trade_price,
	@trader_id,
	@broker_id,
	@strategy_id
    from
	external_future_allocations
    where
	fund_id = @fund_id
    
end

/* Check to make sure that there is only one trade per tuple [deal_id,
 * internal_account_id, external_future_allocations] */
if exists (
    select
	*
    from
	trades
    where
	deal_id = @deal_id
    group by
	internal_account_id,
	external_account_id
    having
	count(*) > 1
)
begin
    select
	id = -1,
	error = "Deal #" + convert(varchar(30), @deal_id) + ", has more than one trade for a combination of internal account and external account"
    return
end

/* Associate the #allocations with existing trades by internal_account_id,
 * external_account_id */
update
    #allocations
set
    status = "E",
    trade_id = b.trade_id
from
    #allocations a,
    trades b
where
    b.deal_id = @deal_id
and
    a.internal_account_id = b.internal_account_id
and
    a.external_account_id = b.external_account_id
    
if exists ( /* new allocations */
    select
	*
    from
	#allocations
    where
	status = "?"
    ) or exists ( /* old allocations */
    select
	*
    from
	trades
    where
	deal_id = @deal_id
    and
	trade_id not in (
	    select
		trade_id
	    from
		#allocations
	)
    )
begin
    select
	id = -1,
	error = "Allocations have changed. Please rebook this deal."
end

/* Save changes */
begin tran
    
    /* Reconcile #allocations against trades */
    update
	trades
    set
	trade_date = b.trade_date,
	contract_id = b.contract_id,
	quantity = b.quantity,
	price = b.price,
	trader_id = b.trader_id,
	broker_id = b.broker_id,
	strategy_id = b.strategy_id
    from
	trades a,
	#allocations b
    where
	a.trade_id = b.trade_id
	
    /* Update value dates */
    update
	trade_value_dates
    set
	value_date = b.value_date
    from
	trade_value_dates a,
	#allocations b
    where
	a.trade_id = b.trade_id
	
    update
	account_transactions
    set
	amount = - c.price * c.quantity * d.quantity * b.conversion_rate
    from
	account_transactions a,
	account_transaction_trades b,
	#allocations c,
	contract_details d,
	instruments e
    where
	a.account_transaction_id = b.account_transaction_id
    and
	b.trade_id = c.trade_id
    and
	c.contract_id = d.contract_id
    and
	d.instrument_id = e.instrument_id
    and
	e.name in ("Option", "Exotic")
	
    if @mode = "update"
    begin

	/* 
	 * Delete any extraneous trade_value_dates and trades
	 */

	delete
	    trade_value_dates
	from 
	    trade_value_dates a,
	    trades b
	where
	    a.trade_id = b.trade_id
	and
	    b.deal_id = @deal_id
	and
	    b.trade_id not in (
		select
		    trade_id
		from
		    #allocations
	    )

	delete
	    trades
	where
	    trade_id not in (
		select
		    trade_id
		from
		    #allocations
	    )
	    
	/*
	 * Insert any missing trades
	 */
	create table
	    #new_trades (
		id int identity,
		trade_id int NULL,
		trade_date datetime,
		internal_account_id int,
		external_account_id int,
		contract_id int,
		value_date datetime NULL,
		quantity numeric(30,0),
		price float,
		trader_id int,
		broker_id int,
		strategy_id int
	    )

	insert into
	    #new_trades
	select
	    NULL,
	    trade_date,
	    internal_account_id,
	    external_account_id,
	    contract_id,
	    value_date,
	    quantity,
	    price,
	    trader_id,
	    broker_id,
	    strategy_id
	from
	    #allocations
	where
	    status = "?"
	 
	select
	    @new_trade_count = count(*)
	from
	    #new_trades

	select
	    @new_trade_id = last_id + 1
	from
	    keys
	where
	    relation = "trades"

	update
	    keys
	set
	    last_id = last_id + @new_trade_count
	where
	    relation = "trades"

	update
	    #new_trades
	set
	    trade_id = @new_trade_id + id - 1

	insert into
	    trades (
		trade_id,
		deal_id,
		user_id,
		internal_account_id,
		external_account_id,
		quantity,
		contract_id,
		price,
		trade_date,
		trader_id,
		strategy_id,
		status_id,
		broker_id
	    )
	select
	    trade_id,
	    @deal_id,
	    @tico_account_id,
	    internal_account_id,
	    external_account_id,
	    quantity,
	    contract_id,
	    price,
	    trade_date,
	    trader_id,
	    strategy_id,
	    1,
	    broker_id
	from
	    #new_trades
    
    end

commit
    
exec
	r_inspectdealtrades
		@login,
		@deal_id

exec
	r_intradayfwdpl
		@login


go
