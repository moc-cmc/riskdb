
if object_id("cm_addstrategy") != NULL
    drop procedure
        cm_addstrategy
go

create procedure
	cm_addstrategy
		@login varchar(30),
		@strategy varchar(50)
as


declare @strategy_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)


select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 0
begin
	select
		status = "Dupe",
		message = "Strategy already exists",
		strategy = @strategy
	return
end

exec
	j_nextkey
		"strategies",
		@strategy_id output


insert into
	strategies
values(
	@strategy_id,
	@strategy)

select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds


select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string



exec
	cm_strategies
		@login

go
