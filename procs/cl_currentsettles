
if object_id("cl_currentsettles") != NULL
    drop procedure
        cl_currentsettles
go

create procedure
	cl_currentsettles	
		@login char(30),
		@trade_date datetime=NULL
as


declare @begin_date datetime
declare @end_date datetime


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)

insert into
	#links
values(
	"Column Link",
	"amend",
	"Edit Settle",
	"suppressAutoexecute=YES")

insert into
	#links
values(
	"Column Link",
	"change_date",
	"Settles",
	"suppressAutoexecute=YES")

insert into
        #links
values(
        "Column Hidden",
        "trade_date",
	"",
	NULL)





select #links.meta_type, #links.column, #links.link, #links.arguments from #links

if @trade_date = NULL
	select
		@trade_date = getdate()	
else
	select
		@trade_date = convert(datetime, convert(char(12), @trade_date, 112)+" 17:00", 112)

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


create table
	#prices(
		symbol char(50),
		price_date char(11),
		price char(30) NULL,
		amend char(30))

insert into
	#prices
select
	a.symbol,
	price_date = convert(char(11), @begin_date, 1),
	price = convert(char(30), convert(numeric(30,6), b.price)),
	amend = "EDIT SETTLE"
from
	contracts a,
	prices b,
	forwards c
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	b.price_date = @begin_date
order by
	a.symbol

insert into
	#prices
select
	a.symbol,
	price_date = convert(char(11), @begin_date, 1),
	price = convert(char(30), convert(numeric(30,6), b.price)),
	amend = "EDIT SETTLE"
from
	contracts a,
	prices b,
	option_contracts c,
	option_expirations d
where
	a.contract_id *= b.contract_id
and
	a.contract_id = c.contract_id
and
	c.option_expiration_id = d.option_expiration_id
and
	d.expiration >= @begin_date
and
	price_date = @begin_date


select 
	change_date="Change Date"

select 
	symbol, 
	price_date, 
	price, 
	amend 
from 
	#prices 
order by 
	symbol

go
