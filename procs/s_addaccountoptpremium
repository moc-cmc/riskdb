
if object_id("s_addaccountoptpremium") != NULL
    drop procedure
        s_addaccountoptpremium
go

create procedure
	s_addaccountoptpremium
		@login char(25),
		@account char(25),
		@date datetime,
		@amount float,
		@trade_id int,
		@conversion_rate float
as

declare @account_transaction_id int
declare @account_id int
declare @account_transaction_type_id int
declare @external_account_id int
declare @opt_transaction_type_id int

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"edit",
	"Edit Account Transaction",
	"suppressAutoexecute=YES",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

if @login = "CS"
begin
	select
		msg = "This Feature is not active for demo users"
	return
end

select
	@opt_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Option Premium"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding option premium transaction type"
	return
end

select
	@account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding account",
		account = @account
	return
end

begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "account_transactions"
	select
		@account_transaction_id = last_id
	from
		keys
	where
		relation = "account_transactions"
commit tran

begin tran
	insert into
		account_transactions
	values(
		@account_transaction_id,
		@account_id,
		@external_account_id,
		@opt_transaction_type_id,
		@date,
		@amount,
		NULL)
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem adding transaction",
			account = @account,
			date = @date,
			amount = @amount
		rollback tran
		return
	end

	insert into
		account_transaction_trades
	values(
		@account_transaction_id,
		@trade_id,
		@conversion_rate)

commit tran

select
	msg = "Successfully added transaction",
	transaction_id = @account_transaction_id,
	account = @account,
	settle_date = @date,
	amount = @amount,
	edit = "EDIT"

go
