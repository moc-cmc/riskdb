select
	@risk_class_id = risk_class_id
from
	risk_classes
where
	name = @risk_class
if @risk_class_id = NULL
begin
	select
		status = "Error",
		message = "Risk class not found",
		risk_class = @risk_class
	return
end

select
	section = "Included Runs",
	style = "background:#FFFFFF;border: 1px solid white",
	risk_class = @risk_class,
	run_name = c.name,
	exclude = "Exclude"
from
	risk_classes a,
	risk_class_runs b,
	runs c
where
	a.risk_class_id = b.risk_class_id
and
	b.run_id = c.run_id
and
	a.name = @risk_class
order by
	c.name


select
	section = "Excluded Runs",
	style = "background:#FFFFFF;border: 1px solid white",
	risk_class = @risk_class,
	run_name = name,
	include = "Include"
from
	runs
where
	run_id not in(
		select
			run_id
		from
			risk_class_runs
		where
			risk_class_id = @risk_class_id)
order by
	name

	

