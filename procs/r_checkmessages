
if object_id("r_checkmessages") != NULL
    drop procedure
        r_checkmessages
go

create procedure
    r_checkmessages
as

/* MARK: VARIABLES */
declare @new_status_id int
declare @pending_status_id int
declare @active_status_id int
declare @now_date datetime
declare @next_date datetime

/* MARK: - FIND @new_status_id, @pending_status_id, @active_status_id */
select
    @new_status_id = a.status_id
from
    statuses a
where
    a.name = "New"

select
    @pending_status_id = a.status_id
from
    statuses a
where
    a.name = "Pending"

select
    @active_status_id = a.status_id
from
    statuses a
where
    a.name = "Active"
    
if @new_status_id = NULL or @pending_status_id = NULL or @active_status_id = NULL
begin
    select
        status = "Error",
        message = "One of the statuses not found: New, Pending, Active",
        new_status_id = @new_status_id,
        pending_status_id = @pending_status_id,
        active_status_id = @active_status_id
    return
end

/* MARK: FIND @pending_status_id */
select
    @pending_status_id = a.status_id
from
    statuses a
where
    a.name = "Pending"
    
if @pending_status_id is NULL
begin
    select
        status = "Error",
        message = "No status found named, 'Pending'"
    return
end

select
    @now_date = getdate()


/* MARK: - UPDATE message_receipts: set status to "Pending" after delay
 *
 * Message receipts are created with a "New" status. Update the status to 
 * Change the status of message_receipts  
 */
update
    message_receipts
set
    status_id = @pending_status_id
from
    message_receipts a,
    messages b,
    channel_subscriptions c,
    channels d
where
    a.message_id = b.message_id
and
    b.channel_id = c.channel_id
and
    c.channel_id = d.channel_id
and (
        b.item_relation_id = d.item_relation_id
    or  (
            b.item_relation_id = NULL
        and
            d.item_relation_id = NULL
        )
    )
and (
        c.item_id = NULL
    or
        b.item_id = c.item_id
    )
and
    a.status_id = @new_status_id
and
    b.status_id = @active_status_id
and
    dateadd(second, c.delay, b.date) <= @now_date

/* MARK: - FIND @next_date: The earliest date when we should check again */
select
    @next_date = min(dateadd(second, c.delay, b.date))
from
    message_receipts a,
    messages b,
    channel_subscriptions c,
    channels d
where
    a.message_id = b.message_id
and
    b.channel_id = c.channel_id
and
    c.channel_id = d.channel_id
and (
        b.item_relation_id = d.item_relation_id
    or  (
            b.item_relation_id = NULL
        and
            d.item_relation_id = NULL
        )
    )
and (
        c.item_id = NULL
    or
        b.item_id = c.item_id
    )
and
    a.status_id = @new_status_id
and
    b.status_id = @active_status_id

/* MARK: IF @next_date: we have more messages to check at a later date */
if @next_date != NULL
begin
    /* MARK: | SHOW @next_date */
    select
        message = "Scheduling timer for next date: ",
        next_date = @next_date
        
    /* MARK: | EXEC r_managetimer: to schedule ourselves for the @next_date */
    exec
        r_managetimer
            @name = "r_checkmessages",
            @next_date = @next_date,
            @iterations = -1 /* indefinite */,
            @interval = 3600 /* minimum every hour */,
            @sql = "exec r_checkmessages"
end

/* KLS: Don't need this output 
else
begin
    select
        message = "There are no messages that requires a timer",
        next_date = @next_date
end
 */

go
