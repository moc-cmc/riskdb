create procedure
	ag_creditdashboard
		@login varchar(50),
		@trade_date datetime=NULL
as

declare @begin_date datetime
declare @end_date datetime
declare @usd_product_id int
declare @max_dsl float
declare @dsl_credit_profile int
declare @fund_id int
declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @disabled_style varchar(250)
declare @debug char(1)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Column Link",
