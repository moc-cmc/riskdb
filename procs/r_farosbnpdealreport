/*
| Set trading day to EST 17:00-17:00 market standard
*/
update
	#trades
set
	trade_day = case
		when a.trade_date > convert(char(8), getdate(), 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 112))
		else
			convert(char(12), a.trade_date, 112)
	end
from
	#trades a

update
	#trades
set
	counterparty = external_account
where
	fund_agency_trade = 'Y'

select
	deal_id,
	trade_id,
	trade_day = rtrim(convert(varchar(10), trade_day, 112)),
	trade_time = right(convert(char(25), trade_date, 0), 13),
	value_date = rtrim(convert(varchar(10), value_date, 112)),
	symbol=rtrim(traded_ccy) + rtrim(counter_ccy),
	quantity,
	trade_price = std_price,
	counterparty,
	trade_type
from
	#trades
order by
	deal_id

