
drop procedure api_tallyb2bsnglbarrier
go

create procedure
	api_tallyb2bsnglbarrier	
		@login varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(25),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@biproduct varchar(50),
		@timezone varchar(25),
		@expiration datetime,
		@option_settlement datetime,
		@strike numeric(30,6),
		@call_put varchar(10),
		@implied_volatility float,
		@spot_reference float,
		@client_price float,
		@client_format varchar(10),
		@client_premium float,
		@client_premium_currency varchar(25),
		@client_premium_settle datetime,
		@market_price float,
		@market_format varchar(10),
		@market_premium float,
		@market_premium_currency varchar(25),
		@market_premium_settle datetime,
		@barrier_type varchar(12),
		@barrier float,
		@deal_id int output

as

declare @client_external_account varchar(50)
declare @client_quantity numeric(30,4)
declare @client_pips_price float
declare @client_pct_price float
declare @market_external_account varchar(50)
declare @market_quantity numeric(30,4)
declare @market_pips_price float
declare @market_pct_price float
declare @contract_id int
declare @symbol varchar(50)
declare @client_trade_id int
declare @market_trade_id int
declare @trade_date datetime
declare @market_sales_code varchar(25)

select
	@trade_date = getdate()

select
	@client_external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

if @client_format = "Pct"
begin
	select
		@client_pips_price = (@client_price / 100.0) * @spot_reference,
		@client_pct_price = @client_price / 100.0
end
else
begin
	select
		@client_pips_price = @client_price,
		@client_pct_price = NULL
end


if @client_buys_sells = "Client Buys"
begin
	select
		@client_quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@client_quantity = abs(@quantity)
end

select
	@market_quantity = @client_quantity * -1.0


if @market_format = "Pct"
begin
	select
		@market_pips_price = (@market_price / 100.0) * @spot_reference,
		@market_pct_price = @market_price / 100.0
end
else
begin
	select
		@market_pips_price = @market_price,
		@market_pct_price = NULL
end

/* select
	@market_external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end */

select
	@market_sales_code = "None"

exec
	r_exoticoptioncontract
		@biproduct,
		@timezone,
		@expiration,
		@call_put,
		@strike,
		@option_settlement,
		"Single Barrier",
		NULL,
		NULL,
		NULL,
		@barrier_type,
		NULL,
		NULL,
		@barrier,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Option",
		@deal_type = "B2B Option",
		@trade_type = "Option",
		@external_account = @client_external_account,
		@quantity = @client_quantity,
		@symbol = @symbol,
		@value_date = @option_settlement,
		@price = @client_pips_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@premium = @client_premium,
		@premium_currency = @client_premium_currency,
		@prem_settle_date = @client_premium_settle,
		@pct_price = @client_pct_price,
		@spot_reference = @spot_reference

exec
        r_inserttradenotification @client_trade_id

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @market_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Option",
		@deal_type = "B2B Option",
		@trade_type = "Option",
		@external_account = @market_external_account,
		@counterparty = @counterparty,
		@quantity = @market_quantity,
		@symbol = @symbol,
		@value_date = @option_settlement,
		@price = @market_pips_price,
		@trade_date = @trade_date,
		@sales_code = @market_sales_code,
		@premium = @market_premium,
		@premium_currency = @market_premium_currency,
		@prem_settle_date = @market_premium_settle,
		@pct_price = @market_pct_price,
		@spot_reference = @spot_reference


exec
        r_inserttradenotification @market_trade_id

select
	@implied_volatility = @implied_volatility / 100.00

exec
	r_initializeoptcontract
		@symbol,
		@implied_volatility



go
