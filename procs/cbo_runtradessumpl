update
	#cash_ladder
set
	a.equivalent_value = a.balance * c.price,
	a.rate = c.price
from
	#cash_ladder a,
	forwards b,
	prices c
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	c.price_date = @end_date

