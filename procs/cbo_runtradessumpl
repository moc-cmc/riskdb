create table
	#premium_ladder_output(
		id int identity,
		symbol varchar(50) NULL,
		prem_val_date datetime NULL,
		balance float NULL,
		product_id int NULL,
		equivalent_value float NULL,
		subtotal float NULL,
		currency varchar(50) NULL,
		evaluation_currency varchar(50) NULL,
		rate float NULL)

select
	@product_id = 0
select
	@products = count(*)
from
	#premium_ladder
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#premium_ladder
	where
		product_id > @product_id


	select
		@product = symbol
	from
		products
	where
		product_id = @product_id

	select
		@rate = rate
	from
		#premium_ladder
	where
		product_id = @product_id

	insert into
		#premium_ladder_output(
			symbol,
			prem_val_date,
			balance,
			product_id)
	select
		symbol,
		prem_val_date,
		balance,
		product_id
	from
		#premium_ladder
	where
		product_id = @product_id
	order by
		id

	select
		@product_total = sum(balance),
		@product_equiv_total = sum(equivalent_value)
	from
		#premium_ladder
	where
		product_id = @product_id

	insert into
		#premium_ladder_output(
			subtotal,
			equivalent_value,
			currency,
			evaluation_currency,
			rate)
	values(
		@product_total,
		@product_equiv_total,
		@product,
		@evaluation_currency,
		@rate)


	select
		@products = count(*)
	from
		#premium_ladder
	where
		product_id > @product_id
end

select
	@product_equiv_total = sum(equivalent_value)
from
	#premium_ladder
if @product_equiv_total = NULL
	select
		@product_equiv_total = 0.0

insert into
	#premium_ladder_output(
		symbol,
		equivalent_value,
		evaluation_currency)
