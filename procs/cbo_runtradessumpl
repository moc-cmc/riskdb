	b.value_date,
	b.quantity
from
	forwards a,
	#trades b,
	#products c
where
	a.product_id = c.product_id
and
	a.contract_id = b.contract_id

insert into
	#balances
select
	a.currency_id,
	b.value_date,
	b.quantity * b.price * -1.0
from
	forwards a,
	#trades b,
	#products c
where
	a.contract_id = b.contract_id
and
	a.currency_id = c.product_id
	

insert into
	#cash_ladder(
		product_id,
		value_date,
		balance)
select
	product_id,
	value_date,
	sum(balance)
from
	#balances
group by
	product_id,
	value_date
order by
	product_id,
	value_date


