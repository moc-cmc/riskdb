create table
	#fo_prices(
		id int identity,
		contract_id int,
		value_date datetime,
		price float NULL)
insert into
	#fo_prices(
		contract_id,
		value_date)
select
	contract_id,
	value_date
from
	#trades
group by
	contract_id,
	value_date

select
	@id = 0
select
	@ids = count(*)
from
	#fo_prices
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#fo_prices
	where
		id > @id

	select
		@value_date = NULL,
		@contract_id = NULL,
		@price = NULL,
		@spot_price = NULL,
		@currency_rate = NULL,
		@product_rate = NULL,
		@days = NULL

	select
		@value_date = value_date,
		@contract_id = contract_id
	from
		#fo_prices
	where
		id = @id

	select
		@instrument = a.name
	from
		instruments a,
		contracts b
	where
		a.instrument_id = b.instrument_id
	and
		b.contract_id = @contract_id

	if @instrument = "Forward"
	begin

		exec
			r_forwardpriceasof
				@contract_id,
				@end_date,
				@value_date,
				@days output,
				@spot_price output,
				@price output,
				@currency_rate output,
				@product_rate output
	end
	if @instrument = "Option"
	begin
		exec
			r_contracttheoasof
				@contract_id,
				@end_date,
				@price output,
				@delta output,
				@gamma output,
				@theta output,
				@tau output
	end
	if @instrument = "Exotic"
	begin
		exec
			r_exotipostheoasof
				@contract_id,
				@end_date,
				@price output,
				@delta output,
				@gamma output,
				@theta output,
				@tau output
	end

	update
		#fo_prices
	set
		price = @price
	where
		id = @id


	select
		@ids = count(*)
	from
		#fo_prices
	where
		id > @id
end

