	#cash_ladder
set
	equivalent_value = balance,
	rate = 1.0
where
	product_id = @evaluation_currency_id

create table
	#cash_ladder_output(
		id int identity,
		symbol varchar(50) NULL,
		value_date datetime NULL,
		balance float NULL,
		product_id int NULL,
		equivalent_value float NULL,
		subtotal float NULL,
		currency varchar(50) NULL,
		evaluation_currency varchar(50) NULL,
		rate float NULL)

select
	@product_id = 0
select
	@products = count(*)
from
	#cash_ladder
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#cash_ladder
	where
		product_id > @product_id

	select
		@rate = rate
	from
		#cash_ladder
	where
		product_id = @product_id

	select
		@product = symbol
	from
		products
	where
		product_id = @product_id

	insert into
		#cash_ladder_output(
			symbol,
			value_date,
			balance,
			product_id)
	select
		symbol,
		value_date,
		balance,
		product_id
	from
		#cash_ladder
	where
		product_id = @product_id
	order by
		id

	select
		@product_total = sum(balance),
		@product_equiv_total = sum(equivalent_value)
	from
		#cash_ladder
	where
		product_id = @product_id

	insert into
		#cash_ladder_output(
			subtotal,
			equivalent_value,
			currency,
			evaluation_currency,
			rate)
	values(
		@product_total,
		@product_equiv_total,
		@product,
		@evaluation_currency,
		@rate)


	select
		@products = count(*)
	from
		#cash_ladder
	where
		product_id > @product_id
end

select
	@product_equiv_total = sum(equivalent_value)
from
	#cash_ladder

if @product_equiv_total = NULL
	select
		@product_equiv_total = 0.0

insert into
	#cash_ladder_output(
		symbol,
		equivalent_value,
		evaluation_currency)
values(
	"TOTAL",
	@product_equiv_total,
	@evaluation_currency)

update
	#summary_output
set
	total_spot_fwd = @product_equiv_total

update
	#summary_output
set
	total = total_premium + total_spot_fwd


select
	run,
	begin_date,
	end_date,
	run_date,
	total_premium,
	total_spot_fwd,
	total_balances = total,
	equiv_ccy
