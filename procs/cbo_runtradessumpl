/* Get the forward trades */
insert into
	#trades(
		deal_id,
		trade_id,
		trade_date,
		external_account_id,
		contract_id,
		quantity,
		value_date,
		price,
		counterparty_id,
		broker_id)
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	a.external_account_id,
	a.contract_id,
	a.quantity,
	a.value_date,
	a.price,
	a.counterparty_id,
	a.broker_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#fwds g,
	#counterparties h
where
	a.contract_id = g.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = h.counterparty_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

/* Get the linked fwd trades */
insert into
	#trades(
		deal_id,
		trade_id,
		trade_date,
		external_account_id,
		contract_id,
		quantity,
		value_date,
		price,
		counterparty_id,
		broker_id)
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	a.external_account_id,
	a.contract_id,
	a.quantity,
	a.value_date,
	a.price,
	a.counterparty_id,
	a.broker_id
from
	trades a,
	#fwds b
where
	a.contract_id = b.contract_id
and
	a.deal_id in(
		select
			distinct(a.deal_id)
		from
			#trades a,
			#fwds b
		where
			a.contract_id = b.contract_id)
and
	a.trade_id not in(
		select
			trade_id
		from
			#trades)

