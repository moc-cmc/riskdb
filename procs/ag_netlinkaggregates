update
	#trades
set
	identifier = left(identifier, char_length(identifier) - 2)
where
	identifier like "%.c" */


update
	#trades
set
	a.amount_usd = b.volume
from
	#trades a,
	trade_volumes b
where
	a.trade_id = b.trade_id
and
	convert(date, b.volume_date) = convert(date, @end_date)
and
	b.product_id = @evaluation_currency_id

update
	#trades
set
	buy_sell = "BUY"
where
	base_amount >= 0.0
update
	#trades
set
	buy_sell = "SELL"
where
	base_amount < 0.0


create table
	#output(
		trade_id int,
		identifier varchar(100) NULL,
		trade_date datetime NULL,
		pair varchar(25) NULL,
		buy_sell varchar(10) NULL,
		price numeric(30,8) NULL,
		base_amount numeric(30,4) NULL,
		counter_amount numeric(30,4) NULL,
		amount_usd numeric(30,4) NULL,
		external_account varchar(50) NULL)
insert into
	#output(
		trade_id,
		identifier,
		trade_date,
		pair,
		buy_sell,
		price,
		base_amount,
		counter_amount,
		amount_usd,
		external_account)
select
	trade_id = a.aggregate_trade_id,
	a.identifier,
	a.trade_date,
	b.pair,
	b.buy_sell,
	b.price,
	b.base_amount,
	b.counter_amount,
	b.amount_usd,
	b.external_account
from
	aggregated_trades a,
	#trades b
where
	a.aggregate_trade_id = b.trade_id


update
	#output
set
	identifier = left(identifier, char_length(identifier) - 2)
where
	identifier like "%.m"

update
	#output
set
	identifier = left(identifier, char_length(identifier) - 2)
where
	identifier like "%.c"


select
	trade_id,
	identifier,
	trade_date,
	pair,
	buy_sell,
	price,
	base_amount,
	counter_amount,
	amount_usd,
	external_account
from
	#output



go
