drop procedure
	c_clientcontacts
go

create procedure
	c_clientcontacts
		@login varchar(50)
as

declare @style varchar(250)
declare @fund_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"not_currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_info",
	"Edit Client Contact Info",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"ytd",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"mtd",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"daily",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"value",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@style = "background:#FFFFFF;border: 1px solid white"



exec
	r_defaultfundforlogin
		@login,
		@fund_id output


create table
	#client_contacts(
		external_account_id int,
		symbol varchar(50) NULL,
		name varchar(200) NULL,
		phone varchar(200) NULL,
		email varchar(200) NULL,
		address_line1 varchar(200) NULL,
		address_line2 varchar(200) NULL,
		additional1 varchar(200) NULL,
		additional2 varchar(200) NULL,
		additional3 varchar(200) NULL)
insert into
	#client_contacts(
		external_account_id,
		symbol)
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.fund_id = @fund_id

update
	#client_contacts
set
	a.name = b.name,
	a.phone = b.phone,
	a.email = b.email,
	a.address_line1 = b.address_line1,
	a.address_line2 = b.address_line2,
	a.additional1 = b. additional1,
	a.additional2 = b. additional2,
	a.additional3 = b. additional3
from
	#client_contacts a,
	client_contacts b
where
	a.external_account_id = b.external_account_id


select
	section = "Accounts",
	style = @style,
	account = symbol,
	edit_info = "EDIT",
	name,
	phone,
	email,
	address_line1,
	address_line2,
	additional1,
	additional2,
	additional3
from
	#client_contacts 
order by
	symbol


go

	



