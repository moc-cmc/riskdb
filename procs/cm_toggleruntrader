
if object_id("cm_toggleruntrader") != NULL
    drop procedure
        cm_toggleruntrader
go

create procedure
	cm_toggleruntrader
		@login varchar(30),
		@run_name varchar(50),
		@trader varchar(50)
as


declare @tico_account_id int
declare @run_id int
declare @trader_id int
declare @is_included int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Login not found"
	return
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b
where
	a.run_id = b.run_id
and
	b.tico_account_id = @tico_account_id
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run Not Found"
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Trader not found",
		trader = @trader
	return
end


select
	@is_included = count(*)
from
	run_traders
where
	run_id = @run_id
and
	trader_id = @trader_id

if @is_included > 0
begin
	delete

	from
		run_traders
	where
		run_id = @run_id
	and
		trader_id = @trader_id
end
else
begin
	insert into
		run_traders
	values(
		@run_id,
		@trader_id)
end

exec
	cm_runtraderfilters
		@login,
		@run_name,
		"Trader"



go
