drop procedure
	r_removeemailfromdistlist
go

create procedure
	r_removeemailfromdistlist
		@login varchar(50),
		@dist_list varchar(50),
		@email varchar(50)

as

declare @tico_account_id int
declare @email_id int
declare @dist_list_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = -1,
		error = "Problem deterimining login"
	return
end

select
	@email_id = email_id
from
	emails
where
	email = @email
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding email for removal",
		email = @email
	return
end

select
        @dist_list_id = dist_list_id
from
        dist_lists
where
        name = @dist_list
if @@rowcount != 1
begin
        select
                id = -1,
                msg = "Problem finding dist_list",
                dist_list = @dist_list
        return
end


begin tran
	delete from 
		dist_list_emails
	where
		email_id = @email_id
	and
		dist_list_id = @dist_list_id
	if @@rowcount != 1 
	begin
		select
			id = -1,
			msg = "Problem removing email from distribution list",
			dist_list = @dist_list,
			email = @email
		rollback tran
		return
	end
	
	
	if not exists(select email_id from dist_list_emails where email_id = @email_id)
	begin
		delete from
			emails
		where
			email_id = @email_id
		if @@rowcount != 1 
        	begin
                	select
                	        id = -1,
                       	 	msg = "Problem deleting email",
                        	email = @email
                	rollback tran
                	return
		end
        end
commit tran

	
select
        id = 1,
        msg = "Successfully removed email from distribution list",
        email = @email,
	dist_list = @dist_list

exec 
	r_distlistdetails
		@login,
		@dist_list
go

