create or replace procedure
	api_editoutsideaccount
		@login varchar(50),
		@outside_account_id int,
		@outside_account_type varchar(100)=NULL,
		@provider_name varchar(100)=NULL,
		@name varchar(100)=NULL,
		@account_number varchar(100)=NULL,
		@account_code varchar(100)=NULL,
		@account_code_type varchar(50)=NULL

as

declare @orig_outside_account_type_id int
declare @orig_provider_id int
declare @orig_name varchar(50)
declare @orig_account_number varchar(100)
declare @orig_account_code varchar(50)
declare @orig_account_code_type_id int
declare @orig_checksum varchar(100)
declare @orig_checksum_user_id int
declare @orig_approval_user_id int

declare @orig_outside_account_type varchar(50)
declare @orig_provider varchar(50)
declare @orig_account_code_type varchar(50)

declare @outside_account_type_id int
declare @legal_entity_id int
declare @provider_id int
declare @account_code_type_id int
declare @checksum_user_id int
declare @approval_user_id int
declare @provider varchar(50)

declare @pending char(1)
declare @tico_account_id int
declare @legal_entity varchar(150)
declare @has_permission char(1)

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end

exec
        r_checkaccessgrouppermission
                @login=@login,
                @access_group="Wire Admin",
                @show_perm_denied = "N",
                @has_permission = @has_permission output

if @has_permission != "Y"
begin
	select
		status = "Error",
		message = "Permission to modify denied"
        return
end


select
	@provider = @provider_name

select
	@orig_outside_account_type_id = outside_account_type_id,
	@orig_provider_id = provider_id,
	@orig_name = name,
	@legal_entity_id = legal_entity_id,
	@pending = "Y"
from
	pending_outside_accounts 
where
	outside_account_id = @outside_account_id
if @orig_name = NULL
begin
	/* This feature that will be removed once
 	* all hashes have been created for existing outside accounts
 	*/
	declare @allow_edit_pending_only char(1)
	select
        	@allow_edit_pending_only = "N"

        if @allow_edit_pending_only = "N"
        begin
                select
                        @orig_outside_account_type_id = outside_account_type_id,
                        @orig_provider_id = provider_id,
			@orig_name = name,
			@legal_entity_id = legal_entity_id,
			@pending = "N"
                from
                        outside_accounts
                where
                        outside_account_id = @outside_account_id
		if @orig_name = NULL
		begin
			select
				status = "Error",
				message = "Problem finding outside acccount"
			return
		end
        end
	else
	begin
		select
			status = "Error",
			messasge = "Can not edit an acccount unless it is pending"
		return
	end
end

/* User must have access to the legal entity of the tico account */
select
	@legal_entity = a.name
from
	legal_entities a,
	legal_entity_tico_accounts b
where
	a.legal_entity_id = b.legal_entity_id
and
	a.legal_entity_id = @legal_entity_id
and
	b.tico_account_id = @tico_account_id
if @legal_entity = NULL
begin
	select
		status = "Error", 
		message = "Permission denied for user"
	return
end

select
	@orig_account_number = account_number,
	@orig_account_code = account_code,
	@orig_account_code_type_id = account_code_type_id,
	@orig_checksum = checksum
from
	outside_account_info
where
	outside_account_id = @outside_account_id


select
	@orig_outside_account_type = name
from
	outside_account_types
where
	outside_account_type_id = @orig_outside_account_type_id

select
	@orig_provider = name
from
	providers
where
	provider_id = @orig_provider_id

select
	@orig_account_code_type = name
from
	outside_account_code_types
where
	outside_account_code_type_id = @orig_account_code_type_id

	
select
	@outside_account_type_id = outside_account_type_id
from
	outside_account_types
where
	name = @outside_account_type

select
	@provider_id = provider_id
from
	providers
where
	name = @provider

select
	@account_code_type_id = outside_account_code_type_id
from
	outside_account_code_types
where
	name = @account_code_type

if @account_code_type_id = NULL and @account_code != NULL
begin
	select
		status = "Error",
		messsage = "Problem finding account code type"
	return
end
		

if @outside_account_type_id = NULL
	select
		@outside_account_type_id = @orig_outside_account_type_id,
		@outside_account_type = @orig_outside_account_type
if @provider_id = NULL 
	select
		@provider_id = @orig_provider_id,
		@provider = @orig_provider
if @name = NULL
	select
		@name = @orig_name
if @account_number = NULL
	select
		@account_number = @orig_account_number
if @account_code = NULL
	select
		@account_code = @orig_account_code
if @account_code_type_id = NULL
	select
		@account_code_type_id = @orig_account_code_type_id,
		@account_code_type = @orig_account_code_type



if  @orig_outside_account_type_id = @outside_account_type_id and
    @orig_provider_id = @provider_id and
    @orig_name = @name and
    @orig_account_number = @account_number and
    @orig_account_code = @account_code and
    @orig_account_code_type_id = @account_code_type_id
begin
        select
            status = "OK",
            message = "No change in account details. Account not modified"
        return
end

/* DEBUG
select
	orig_outside_account_type_id = @orig_outside_account_type_id,
	outside_account_type_id = @outside_account_type_id,
	orig_provider_id = @orig_provider_id,
	provider_id = @provider_id,
	orig_name = @orig_name,
	name = @name,
	orig_account_number = @orig_account_number,
	account_number = @account_number,
	orig_account_code = @orig_account_code,
	account_code = @account_code,
	orig_account_code_type_id = @orig_account_code_type_id,
	account_code_type_id = @account_code_type_id
*/
	

begin tran
	if @pending = "Y"
	begin
		update
			pending_outside_accounts
		set
			outside_account_type_id = @outside_account_type_id,
			provider_id = @provider_id,
			name = @name
		where
			outside_account_id = @outside_account_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem updating pending account"
			rollback tran
			return
		end
	end
	else
	begin
                update
                        outside_accounts
                set
                        outside_account_type_id = @outside_account_type_id,
                        provider_id = @provider_id,
                        name = @name
                where
                        outside_account_id = @outside_account_id
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                message = "Problem updating account"
                        rollback tran
                        return
                end
	end

	update
		outside_account_info
	set
		account_number = @account_number,
		account_code = @account_code,
		account_code_type_id = @account_code_type_id
	where
		outside_account_id = @outside_account_id
	if @@rowcount != 1
	begin  
		insert into
			outside_account_info(
				outside_account_id,
				account_number,
				account_code,
				account_code_type_id)
		values(
			@outside_account_id,
			@account_number,
			@account_code,
			@account_code_type_id
		)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem updating account info"
			rollback tran
			return
		end
	end
commit tran

select
	status = "Success",
	messasge = "Updated outside account with properties",
	outside_account_type = @outside_account_type,
	provider = @provider,
	name = @name,
	account_number = @account_number,
	account_code = @account_code,
	account_code_type = @account_code_type

go






