drop procedure py_fxmccreditviewsum
go

create procedure
	py_fxmccreditviewsum
		@login varchar(50),
		@external_account varchar(50)=NULL
as

declare @external_account_id int
declare @nop_limit float
declare @dsl_limit float
declare @net_equiv float
declare @longs_equiv float
declare @shorts_equiv float
declare @nop_type varchar(50)
declare @value_date datetime
declare @dsl_type varchar(50)
declare @evaluation_currency_id int
declare @evaluation_currency varchar(50)
declare @fund_id int

declare @search_string varchar(50)


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Could not find evaluation currency"
	return
end

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

if @external_account = NULL
begin
	select
		@search_string = "%"
end
else
begin
	select
		@search_string = "%" + rtrim(@external_account) + "%"

	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @external_account
end

declare @agency_client_source_id int

select
	@agency_client_source_id = source_id
from
	sources
where
	name = "Agency Client"

select
	ext_account = f.symbol,
	currency = c.symbol,
	nop_type = d.name,
	nop_limit = convert(float, a.nop_limit),
	dsl_type = e.name,
	dsl_limit = convert(float,  a.dsl_limit)/*,
	notice_level =  rtrim(convert(varchar(30), a.notice_level),
	warning_level =  rtrim(convert(varchar(30), a.warning_level),
	blocked_leve =  rtrim(convert(varchar(30), a.blocked_level)*/
from
	ext_account_limits a,
	external_accounts b,
	products c,
	nop_types d,
	dsl_types e,
	external_account_symbols f
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
and
	a.nop_type_id = d.nop_type_id
and
	a.dsl_type_id = e.dsl_type_id
and
	b.external_account_id = f.external_account_id
and	
	b.symbol = @external_account
and
	f.source_id = @agency_client_source_id



go

