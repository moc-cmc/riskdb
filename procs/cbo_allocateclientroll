
drop procedure
	cbo_allocateclientroll
go

create procedure
	cbo_allocateclientroll
		@login varchar(50),
		@account varchar(50),
		@symbol varchar(50),
		@roll_amount numeric(30,4),
		@closing_date datetime,
		@closing_rate float,
		@roll_date datetime,
		@roll_rate float,
		@trade_date datetime,
		@return_to_recon varchar(10)
as


declare @fund_id int
declare @roll_trader varchar(50)
declare @roll_trader_id int
declare @roll_trader_account_id int
declare @roll_trader_login varchar(50)
declare @near_quantity numeric(30,4)
declare @far_quantity numeric(30,4)
declare @dealt_currency varchar(50)
declare @counter_currency varchar(50)
declare @deal_id int
declare @prime_broker varchar(50)

if convert(datetime, convert(varchar(8), @closing_date, 112)) = convert(datetime, convert(varchar(8), @roll_date, 112))
begin
	select
		"error" = "ERROR",
		"msg" = "Must have different closing date and roll date",
		"closing_date" = @closing_date,
		"roll_date" = @roll_date
	return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@roll_trader_id = roll_trader_id
from
	fund_roll_traders
where
	fund_id = @fund_id

select
	@roll_trader = symbol,
	@roll_trader_account_id = tico_account_id
from
	traders
where
	trader_id = @roll_trader_id
if @roll_trader = NULL
begin
	select
		status = "Error",
		message = "Roll trader not found"
	return
end

select
	@roll_trader_login = login
from
	tico_accounts
where
	account_id = @roll_trader_account_id

if @roll_trader_login = NULL
begin
	select
		@roll_trader_login = @login
end


select
	@near_quantity = @roll_amount * -1.0,
	@far_quantity = @roll_amount

select
	@dealt_currency = a.symbol
from
	products a,
	forwards b,
	contracts c
where
	a.product_id = b.product_id
and
	b.contract_id = c.contract_id
and
	c.symbol = @symbol
if @dealt_currency = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve forward",
		symbol = @symbol
	return
end

select
	@counter_currency = a.symbol
from
	products a,
	forwards b,
	contracts c
where
	a.product_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	c.symbol = @symbol
if @counter_currency = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve counter currency",
		symbol = @symbol
	return
end


exec
	api_tallyclientroll
		@login = @roll_trader_login,
		@account = @account,
		@trader = @roll_trader,
		@near_quantity = @near_quantity,
		@far_quantity = @far_quantity,
		@dealt_currency = @dealt_currency,
		@counter_currency = @counter_currency,
		@near_date = @closing_date,
		@near_price = @closing_rate,
		@far_date = @roll_date,
		@far_price = @roll_rate,
		@deal_id = @deal_id output,
		@trade_date = @trade_date
		
if @return_to_recon = "Yes"
begin
	select
		@prime_broker = a.name
	from
		sources a,
		prime_brokers b,
		external_account_prime_brokers c,
		external_accounts d
	where
		a.source_id = b.source_id
	and
		b.prime_broker_id = c.prime_broker_id
	and
		c.external_account_id = d.external_account_id
	and
		d.symbol = @account

	exec
		cbo_positionsandrolls
			@login,
			@closing_date,
			@prime_broker
end

go		
		

