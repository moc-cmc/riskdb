drop procedure r_addcreditprofileaccount
go

create procedure
	r_addcreditprofileaccount
		@login varchar(50),
		@credit_profile varchar(50),
		@external_account varchar(50)

as

declare @credit_profile_id int
declare @external_account_id int

select
	@credit_profile_id = credit_profile_id
from
	credit_profiles
where
	name=@credit_profile
if @credit_profile_id = NULL
begin
	select
		error="Error",
		msg="Credit profile not found", @credit_profile
	return
end

select
        @external_account_id = external_account_id
from
        external_accounts
where
        symbol=@external_account
if @external_account_id = NULL
begin
        select
                error="Error",
                msg="external_account not found", @external_account
        return
end

declare @already_created varchar(1)

select
	@already_created = "Y"
from 
	credit_profile_accounts
where
	credit_profile_id = @credit_profile_id
and
	external_account_id = @external_account_id

if @already_created = "Y"
begin
	select
		error = "Account has already been assigned to Credit Profile",
		credit_profile = @credit_profile,
		external_account = @external_account_id
	return
end

insert into
	credit_profile_accounts(
		credit_profile_id,
		external_account_id)
values(
	@credit_profile_id,
	@external_account_id
)
if @@rowcount != 1
begin
	select
		status = "Error adding account to credit profile",
		credit_profile = @credit_profile,
		external_account = @external_account
	return
end

select
	status = "Successfully created added account to credit profile",
	credit_profile = @credit_profile,
	external_account = @external_account


exec
	r_viewcreditprofile
		@login,
		@credit_profile

go

	
