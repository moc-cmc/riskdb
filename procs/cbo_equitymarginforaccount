create procedure
	cbo_equitymarginforaccount
		@login varchar(30),
		@account varchar(50),
		@trade_date datetime=NULL
as

declare @debug char(1)
select
	@debug = "N"

declare @begin_date datetime
declare @end_date datetime
declare @value_date datetime

declare @evaluation_currency_id int
declare @fund_id int
declare @front_office_commit_id int
declare @run_id int
declare @external_account_id int
declare @external_account varchar(50)

select
	@external_account = @account

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		error="Error",
		msg="Problem determining external account",
		external_account=@external_account
	return
end

exec
        r_defaultfundforlogin
                @login,
                @fund_id output

select
        @evaluation_currency_id = evaluation_currency_id
from
        funds
where
        fund_id = @fund_id

select
	@front_office_commit_id = transaction_type_id
from
	transaction_types
where
	name = "Front Office Commit"

if @trade_date = NULL
begin
	select
		@trade_date = convert(date, max(transaction_date))
	from
		int_account_transactions
	where
		transaction_type_id = @front_office_commit_id
end

select
	@value_date = @trade_date
exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output

if @debug = "Y"
	select debug="dates",value_date=@value_date,trade_date=@trade_date,begin_date=@begin_date,end_date=@end_date



