declare @month char(2)
declare @day char(2)
declare @year char(4)
declare @recent_transaction_date datetime

select
	@day = "01",
	@month = convert(char(2), datepart(month, @trade_date)),
	@year = convert(char(4), datepart(year, @trade_date))

if convert(int, @month) < 10
	select
		@month = "0"+@month
select
	@recent_transaction_date = @year+@month+@day

exec
	r_prevbusinessday 
		@recent_transaction_date,
		@recent_transaction_date output
select
	@recent_transaction_date = convert(char(8), @recent_transaction_date, 112)+" 17:00"
			

select
	section="Recent Transactions",
	style="background:#fff;border: 1px solid white",
	account_transaction_id,
	entered_by,
	transaction_type,
	transaction_date,
	currency,
	amount,
	note
from
	#ext_account_transactions 
where
	transaction_date > @recent_transaction_date

select
	section="Product Balances",
        style,
	value_date=convert(char(12), convert(datetime, value_date, 11)),
	product,
	quantity,
	equiv,
	rate=price
from
	#ladder
order by
	ordering,
	value_date,
	product

select
	section="Pair Balances",
	style="background:#fff;border: 1px solid white",
	value_date=convert(char(12), convert(datetime, value_date, 11)),
	contract=symbol,
	quantity,
	equiv,
	rate
from
	#contract_acct_vald_summary
order by
	value_date,
	symbol
	
	
	

