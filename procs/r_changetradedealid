
if object_id("r_changetradedealid") != NULL
    drop procedure
        r_changetradedealid
go

create procedure
	r_changetradedealid
		@login varchar(50),
		@trade_id int,
		@deal_id int,
		@new_deal_id int
as


update
	trades
set
	deal_id = @new_deal_id
where
	trade_id = @trade_id


exec
	r_inspectdealtrades
		@login,
		@new_deal_id


go
