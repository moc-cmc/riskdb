create or replace procedure
	cbo_copyrealizedpl
		@login varchar(50),
		@trade_date datetime

as

declare @tico_account_id int
declare @begin_date datetime
declare @end_date datetime
declare @transaction_date datetime
declare @id int
declare @ids int
declare @transaction_type_id int
declare @deal_type_id int
declare @deal_id int
declare @contract_id int
declare @contract_symbol varchar(50)
declare @currency_id int
declare @external_account_id int
declare @account_transaction_id int

declare @longs float
declare @avg_long float
declare @short float
declare @avg_short float
declare @open_pos float
declare @close_price float
declare @realized_pl float
declare @unrealized_pl float
declare @status_id int
declare @account varchar(50)
declare @identifier varchar(100)
declare @source_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
 		status = "Error",
       		message = "Unable to resolve login"
   	return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Realized P&L"

if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Unable to find transaction_type",
		type = "Realized P&L"
	return
end

select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = "Realized P&L"

if @deal_type_id  = NULL
begin
        select
                status = "Error",
                message = "Unable to find deal_type",
                type = "Realized P&L"
        return
end

select
	@status_id = status_id
from
	statuses
where
	name = "User Review"

if @status_id = NULL
begin
	select
		error = "Error",
		msg = "Could not find status",
		status = "User Review"
	return
end

select
	@source_id = source_id
from
	sources
where
	name = "MPT"

if @source_id = NULL
begin
	select
		error = "Error",
		msg = "Could not find source",
		source = "MPT"
	return
end

select
	@trade_date = convert(datetime, convert(date, @trade_date))
exec
	r_daterangefordate
 		@trade_date,
       		@begin_date output,
       		@end_date output
select
	@transaction_date = convert(datetime, convert(date, @end_date))


create table
	#realized_pls(
		id int identity,
		realized_pl_id int,
		trade_date datetime,
		external_account_id int,
		contract_id int,
		contract_symbol varchar(50) NULL,
		longs float  NULL,
		avg_long float NULL,
		short float NULL,
		avg_short float NULL,
		open_pos float NULL,
		close_price float NULL,
		realized_pl float NULL,
		unrealized_pl float NULL,
		currency_id int NULL)

insert into
	#realized_pls(
		realized_pl_id,
		trade_date,
		external_account_id,
		contract_id,
		longs,
		avg_long,
		short,
		avg_short,
		open_pos,
		close_price,
		realized_pl,
		unrealized_pl)
select
	realized_pl_id,
	trade_date,
	external_account_id,
	contract_id,
	longs,
	avg_long,
	short,
	avg_short,
	open_pos,
	close_price,
	realized_pl,
	unrealized_pl
from
	realized_pls
where
	trade_date = @end_date

update
	#realized_pls
set
	currency_id = d.currency_id
from
        eod_open_trades a,
        future_contracts b,
        futures c,
        forwards d
where
        a.contract_id = b.contract_id
and
        b.future_id = c.future_id
and     
        c.forward_id = d.contract_id

update
	#realized_pls
set
	contract_symbol = b.symbol
from
	#realized_pls a,
	contracts b
where
	a.contract_id = b.contract_id

delete from
	#realized_pls 
where
	realized_pl = NULL
or
        realized_pl = 0 

select
        @id = 0
select
        @ids = count(*)
from
        #realized_pls
where
        id > @id


while @ids > 0
begin

        select
                @id = min(id)
        from
                #realized_pls
        where
                id > @id

	select
		@external_account_id = NULL,
		@contract_id = NULL,
		@longs = NULL,
		@avg_long = NULL,
		@short = NULL,
		@avg_short = NULL,
		@open_pos = NULL,
		@close_price = NULL,
		@realized_pl = NULL,
		@unrealized_pl = NULL,
		@currency_id = NULL,
		@identifier = NULL,
		@contract_symbol = NULL,
		@account = NULL,
		@deal_id = NULL,
		@account_transaction_id = NULL

	select
                @external_account_id = external_account_id,
                @contract_id = contract_id,
                @longs = longs,
                @avg_long = avg_long,
                @short = short,
                @avg_short = avg_short,
                @open_pos = open_pos,
                @close_price = close_price,
                @realized_pl = realized_pl,
                @unrealized_pl = unrealized_pl,
		@currency_id = currency_id,
		@contract_symbol = contract_symbol
	from
		#realized_pls
	where
		id = @id
	
	select
		@account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	select        
        	@identifier = rtrim(@account) + rtrim(@contract_symbol) + convert(varchar(11), @trade_date) + "TEST"

	select
        	@account_transaction_id = account_transaction_id
	from
        	account_transaction_identifiers
	where
        	source_id = @source_id
	and
        	identifier = @identifier

	if @account_transaction_id != NULL
	begin
        	select     
                	status = "Dupe",
                	message = "Transaction already tallied",
                	account_transaction_id = @account_transaction_id,
                	source = "MPT",
                	identifer = @identifier
        	return
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

        exec   
                j_nextkey
                        "account_transactions",
                        @account_transaction_id output

	begin tran

		insert into
			deals(
				deal_id,
				deal_type_id,
				timestamp,
				status_id)
		select
			@deal_id,
			@deal_type_id,
			getdate(),
			@status_id
	
	if @@rowcount !=1
	begin
		select
			error = "Error",
			msg = "Problem adding deal"
		rollback tran
		return
	end

	insert into
		account_transactions(
			account_transaction_id,
			entered_by,
			external_account_id,
			transaction_date,
			transaction_type_id,
			currency_id,
			amount,
			note,
			deal_id)
	select
		@account_transaction_id,
		@tico_account_id,
		@external_account_id,
		@trade_date,
		@transaction_type_id,
		@currency_id,
		@realized_pl,
		@contract_symbol,
		@deal_id

        if @@rowcount != 1
        begin
                select
                        error = "Error",
                        msg = "Problem adding account transaction"
                rollback tran
                return
        end

        insert into
                account_transaction_identifiers(
                        account_transaction_id,
                        source_id,
                        identifier)
        values(
                @account_transaction_id,
                @source_id,
                @identifier)
        if @@rowcount != 1
        begin
        	select
                        id = -1,
                        error = "Problem adding transaction identifier",
                        source_id = @source_id,
                        identifier = @identifier,
                        account_transaction_id = @account_transaction_id
                rollback tran
                return
        end


	commit tran

        select
                @ids = count(*)
        from
                #realized_pls
        where
                id > @id

end


go
