drop procedure cbo_runsnapshotcommit
go

create procedure
	cbo_runsnapshotcommit
		@login varchar(50),
		@trade_date datetime

as


declare @commit_session_id int
declare @bench_start datetime
declare @volume_status varchar(10)

create table
	#messages
(
	id int,
	message varchar(50),
        duration varchar(16) NULL
)

insert into #messages values(1, "Starting commit for date: "+ convert(varchar(8), @trade_date, 112), "")
insert into #messages values(2, "Ensuring all settle prices are saved in back office", NULL)
select @bench_start = getdate()
exec
	cm_savebospotsettles 
		"markr", 
		@trade_date, 
		"MPT"
exec 
	cbo_copyfopricestobo 
		"markr", 
		@trade_date
update #messages set duration = convert(varchar(12), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" where id = 2
select @bench_start = NULL


insert into #messages values(3, "Calculating per trade volumes", NULL)
select @bench_start = getdate()
exec
	cbo_savetradevolumes
		@login=@login,
		@trade_date=@trade_date,
		@run_status=@volume_status output
update #messages set duration = convert(varchar(12), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" where id = 3
select @bench_start = NULL
if @volume_status != "OK"
begin
	insert into #messages values(4, "Error: Could not calculate volumes. Not finishing commit", "")
--Adaptive Server has expanded all '*' elements in the following statement

        select #messages.id, #messages.message, #messages.duration from #messages
	select 
		status = "Error",
		msg = "Error Running Commit",
		message = "Error Running Commit"
	return
end

insert into #messages values(40, "Calculating trade nets", NULL)
select @bench_start = getdate()
exec
        cbo_savetradenets
                @login,
                @trade_date
update #messages set duration = convert(varchar(12), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" where id = 40
select @bench_start = NULL

insert into #messages values(50, "Calculating volume cache", NULL)
select @bench_start = getdate()
exec
	cbo_savevolumecache
		@login,
		@trade_date
update #messages set duration = convert(varchar(12), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" where id = 50
select @bench_start = NULL

/* no fees in stadia
insert into #messages values(5, "Calculating fees", NULL)
select @bench_start = getdate()
exec
        cbo_commitcommissionfees
                @login,
                @trade_date
update #messages set duration = convert(varchar(12), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" where id = 5
select @bench_start = NULL
*/


insert into #messages values(6, "Calculating total and attributed PL values", NULL)
select @bench_start = getdate()
exec
	cbo_savepls
		@login,
		@trade_date
update #messages set duration = convert(varchar(12), convert(numeric(10, 2), datediff(millisecond, @bench_start, getdate()))) + " ms" where id = 6
select @bench_start = NULL



--Adaptive Server has expanded all '*' elements in the following statement
select
	#messages.id, #messages.message, #messages.duration 
from
	#messages

go
