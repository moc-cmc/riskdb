
if object_id("r_channelsubscribe") != NULL
    drop procedure
        r_channelsubscribe
go

create procedure
    r_channelsubscribe
        @login varchar(25),
        @user varchar(50),
        @channel varchar(50),
        @priority varchar(50),
        @delivery_platform varchar(25),
        @address varchar(100),
        @delay float
as

declare @user_id int
declare @channel_id int
declare @priority_id int
declare @delivery_platform_id int
declare @channel_subscription_id int
declare @message varchar(30)

select
    @user_id = account_id
from
    tico_accounts
where
    login = @user

if @user_id = NULL
begin
    select
        status = "Error",
        message = "No user found for login, '" + @user + "'",
        login = @user
    return
end
    
select
    @channel_id = channel_id
from
    channels
where
    name = @channel

if @channel_id = NULL
begin
    select
        status = "Error",
        message = "No channel found named, '" + @channel + "'",
        channel = @channel
    return
end
    
select
    @priority_id = priority_id
from
    priorities
where
    name = @priority

if @priority_id = NULL
begin
    select
        status = "Error",
        message = "No priority found named, '" + @priority + "'",
        priority = @priority
    return
end
    
select
    @delivery_platform_id = delivery_platform_id
from
    delivery_platforms
where
    name = @delivery_platform

if @delivery_platform_id = NULL
begin
    select
        status = "Error",
        message = "No delivery_platform found named, '" + @delivery_platform + "'",
        delivery_platform = @delivery_platform
    return
end

select
    @channel_subscription_id = channel_subscription_id
from
    channel_subscriptions
where
    tico_account_id = @user_id
and
    channel_id = @channel_id
and
    priority_id = @priority_id
and
    delivery_platform_id = @delivery_platform_id
and
    address = @address

if @channel_subscription_id = NULL
begin

    insert into
        channel_subscriptions
    values (
        @user_id,
        @channel_id,
        @priority_id,
        @delivery_platform_id,
        @address,
        @delay
    )
    
    select
        @channel_subscription_id = @@identity,
        @message = "Added channel subscription"
    
end
else
begin

    update
        channel_subscriptions
    set
        delay = @delay

    select
        @message = "Updated channel subscription"
    
end
    
select
    status = "OK",
    message = @message,
    "user" = b.login,
    channel = c.name,
    priority = d.name,
    delivery_platform = e.name,
    a.address,
    a.delay
from
    channel_subscriptions a
join
    tico_accounts b on a.tico_account_id = b.account_id
join
    channels c on a.channel_id = c.channel_id
join
    priorities d on a.priority_id = d.priority_id
join
    delivery_platforms e on a.delivery_platform_id = e.delivery_platform_id
where
    channel_subscription_id = @channel_subscription_id
    
go
