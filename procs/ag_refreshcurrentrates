
drop procedure
	ag_refreshcurrentrates
go

create procedure
	ag_refreshcurrentrates
		@product varchar(50)
as

declare @product_id int
declare @rate_date datetime
declare @current_product_rate_id int
declare @product_rate_id int

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@rate_date = max(rate_date)
from
	product_rates
where
	product_id = @product_id
if @rate_date = NULL
begin
	select
		status = "Error",
		message = "No rate curves found for product",
		product = @product
	return
end


select
	@product_rate_id = product_rate_id
from
	product_rates
where
	product_id = @product_id
and
	rate_date = @rate_date


select
	@current_product_rate_id = product_rate_id
from
	current_product_rates
where
	product_id = @product_id
if @product_rate_id = NULL
begin
	exec
		j_nextkey
			"current_product_rates",
			@current_product_rate_id output

	insert into
		current_product_rates(
			product_rate_id,
			product_id)
	values(
		@current_product_rate_id,
		@product_id)
end

delete

from
	current_product_rate_points
where
	product_rate_id = @current_product_rate_id

insert into
	current_product_rate_points(
		product_rate_id,
		days,
		rate)
select
	product_rate_id,
	days,
	rate
from
	product_rate_points
where
	product_rate_id = @product_rate_id


go







