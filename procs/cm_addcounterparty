
if object_id("cm_addcounterparty") != NULL
    drop procedure
        cm_addcounterparty
go

create procedure
	cm_addcounterparty
		@login varchar(30),
		@counterparty varchar(50),
		@external_account varchar(50),
		@credit_limit numeric(30, 4)

as


declare @counterparty_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)
declare @external_account_id int
declare @fund_id int
declare @evaluation_currency_id int
declare @shorts_nop_type_id int
declare @shorts_dsl_type_id int

select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds

select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount != 0
begin
	select
		status = "Dupe",
		message = "Broker already exists",
		counterparty = @counterparty
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message= "External account not found",
		external_account = @external_account
	return
end

exec
	j_nextkey
		"counterparties",
		@counterparty_id output


insert into
	counterparties
values(
	@counterparty_id,
	@counterparty,
	@external_account_id)

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@shorts_nop_type_id = nop_type_id
from
	nop_types
where
	name = "Shorts"
if @shorts_nop_type_id = NULL 
begin
        select
                status = "Error",
                message = "No NOP type for 'Shorts'"
        return
end
select
        @shorts_dsl_type_id = dsl_type_id
from
        dsl_types
where
        name = "Shorts"
if @shorts_dsl_type_id = NULL
begin
        select
                status = "Error",
                message = "No DSL type for 'Shorts'"
        return
end



if @counterparty_id != NULL and @evaluation_currency_id != NULL
begin
	insert into
		counterparty_limits(
			counterparty_id,
			currency_id,
			nop_type_id,
                        nop_limit,
                        dsl_type_id,
			dsl_limit,
			notice_level,
			warning_level,
			blocked_level)
	values(
		@counterparty_id,
		@evaluation_currency_id,
                @shorts_nop_type_id,
		@credit_limit,
		@shorts_dsl_type_id,
		@credit_limit,
		.50,
		.75,
		1.00)
end


select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string

exec
	cm_counterparties
		@login

go
