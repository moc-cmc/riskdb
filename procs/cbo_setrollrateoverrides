use
	risk_stad
go

drop procedure
	cbo_setrollrateoverrides
go

create procedure
	cbo_setrollrateoverrides
		@login varchar(50),
		@symbol varchar(50),
		@trade_date datetime,
		@closing_date datetime,
		@closing_rate_long float=NULL,
		@closing_rate_short float=NULL,
		@roll_date datetime=NULL,
		@roll_rate_long float=NULL,
		@roll_rate_short float=NULL
as

declare @tico_account_id int
declare @roll_rate_override_id int
declare @contract_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

select
	@roll_rate_override_id = roll_rate_override_id
from
	roll_rate_overrides
where
	contract_id = @contract_id
and
	convert(date, closing_date) = convert(date, @closing_date)
if @roll_rate_override_id = NULL
begin
	exec
		j_nextkey
			"roll_rate_overrides",
			@roll_rate_override_id output
	
	insert into
		roll_rate_overrides(
			roll_rate_override_id,
			tico_account_id,
			contract_id,
			trade_date,
			closing_date,
			closing_rate_long,
			closing_rate_short,
			roll_date,
			roll_rate_long,
			roll_rate_short,
			timestamp)
	values(
		@roll_rate_override_id,
		@tico_account_id,
		@contract_id,
		@trade_date,
		@closing_date,
		@closing_rate_long,
		@closing_rate_short,
		@roll_date,
		@roll_rate_long,
		@roll_rate_short,
		getdate())
end
else
begin
	update
		roll_rate_overrides
	set
		trade_date = @trade_date,
		closing_rate_long = @closing_rate_long,
		closing_rate_short = @closing_rate_short,
		roll_date = @roll_date,
		roll_rate_long = @roll_rate_long,
		roll_rate_short = @roll_rate_short,
		timestamp = getdate()
	where
		roll_rate_override_id = @roll_rate_override_id
end
		
exec
	cbo_clientrollrecon
		@login = @login,
		@value_date = @closing_date


go

