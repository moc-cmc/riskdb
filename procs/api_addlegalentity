create or replace procedure
	api_addlegalentity
		@login varchar(50),
		@name varchar(255),
		@lei varchar(100)=NULL

as

declare @legal_entity_id int
declare @run_id int
declare @lei_exists char(1)
declare @pending_status_id int

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @name
if @legal_entity_id != NULL
begin
	select
		status = "Error",
		message = "Legal entity has already been created",
		legal_entity = @name
	return
end

select
	@pending_status_id = status_id
from
	statuses
where
	name = "Pending"
if @pending_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding 'Pending' status"
	return
end

select
	@lei_exists = "Y"
from
	legal_entities
where
	lei = @lei
and
	lei != NULL
if @lei_exists = "Y"
begin
	select
		status = "Error",
		message = "LEI already exists",
		lei = @lei
	return
end

select
        @run_id = run_id
from
        runs
where
        name = @name
if @run_id != NULL
begin
        select
                status = "Error",
                message = "Run name already exists",
                run_name = @name
        return
end



/* Get IDs before transaction */
exec
	j_nextkey
		"legal_entities",
		@legal_entity_id output
exec
	j_nextkey
		"runs",
		@run_id output

begin tran
	insert into
		legal_entities(
			legal_entity_id,
			name,	
			lei,
			status_id)
	values(
		@legal_entity_id,
		@name,
		@lei,
		@pending_status_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem inserting legal entity",
			leg_entity_id = @legal_entity_id,
			name = @name,
			lei = @lei
		rollback tran
		return
	end
	
	
	insert into
		runs(
			run_id,
			name)
	values(
		@run_id,
		@name)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem inserting run",
			run_id = @run_id,
			run_name = @name
		rollback tran
		return
	end
commit tran
	
select
	status = "Success",
	msg = "Legal entitiy has been created"
	

go	
