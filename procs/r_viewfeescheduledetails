		end_level float NULL,
		break_price float NULL,
		order_by_fee_schedule_id int
	)

create table
	#fee_schedule_breaks(
		section varchar(50) NULL,
		fee_schedule_break_id int NULL,
                break_name varchar(50) NULL,
                break_period_id int NULL,
                break_period varchar(50) NULL,
                start_level float NULL,
                end_level float NULL,
                break_price float NULL)
insert into
