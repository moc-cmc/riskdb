
if object_id("cm_addsource") != NULL
    drop procedure
        cm_addsource
go

create procedure
	cm_addsource
		@login varchar(50),
		@external_mapping_source varchar(50)
as

declare @source_id int
declare @status_id int

select
	@source_id = source_id
from
	sources
where
	name = @external_mapping_source
if @source_id != NULL
begin
	select
		status = "Dupe",
		message = "Source name already exists"
end

select
	@status_id = status_id
from
	statuses
where
	name = "New"
if @status_id = NULL
begin
	exec
		j_nextkey
			"statuses",
			@status_id output

	insert into
		statuses
	values(
		@status_id,
		"New")
end

exec
	j_nextkey
		"sources",
		@source_id output

insert into
	sources
values(
	@source_id,
	@external_mapping_source,
	@status_id)

exec
	cm_sources
		@login
go
