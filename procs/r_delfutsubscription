
if object_id("r_delfutsubscription") != NULL
    drop procedure
        r_delfutsubscription
go

create procedure
	r_delfutsubscription
		@login varchar(50),
		@future varchar(50),
		@root_symbol varchar(10),
		@exchange varchar(50),
		@evaluation_currency varchar(30)
as


declare @db_name varchar(30)
declare @servername varchar(30)
declare @sql_string varchar(255)

select
	@db_name = db_name(),
	@servername = @@servername

select
        @sql_string = "exec contracts.dbo.ct_delfutsubscription '" +
                rtrim(@db_name)+"', '"+
                rtrim(@servername)+"', '"+
                rtrim(@future)+"', '"+
                rtrim(@root_symbol)+"', '"+
                rtrim(@exchange)+ "'"

exec
        sp_remotesql
                "CONTRACTS",
                @sql_string

/*exec
        CONTRACTS.contracts.dbo.ct_futures
                @login,
		@db_name,
		@servername,
		@evaluation_currency*/

select
        @sql_string = "exec contracts.dbo.ct_futures '" +
                rtrim(@login)+"', '"+
                rtrim(@db_name)+"', '"+
                rtrim(@servername)+"', '"+
                rtrim(@evaluation_currency)+ "'"

exec
        sp_remotesql
                "CONTRACTS",
                @sql_string

go
