use
	risk_admis
go

drop procedure
	ag_tallypendingwires
go

create procedure
	ag_tallypendingwires
		@login varchar(50),
		@value_date datetime

as

declare @pb_wire_signoffs int
declare @pb_wire_signoff_id int


create table
	#pb_wire_signoffs(
		pb_wire_signoff_id int)

insert into
	#pb_wire_signoffs(
		pb_wire_signoff_id)
select
	a.pb_wire_signoff_id
from
	pb_wire_signoffs a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Pending"
and
	convert(date, a.value_date) = convert(date, @value_date)


select
	@pb_wire_signoff_id = 0
select
	@pb_wire_signoffs = count(*)
from
	#pb_wire_signoffs
where
	pb_wire_signoff_id > @pb_wire_signoff_id

while @pb_wire_signoffs > 0
begin
	select
		@pb_wire_signoff_id = min(pb_wire_signoff_id)
	from
		#pb_wire_signoffs
	where
		pb_wire_signoff_id > @pb_wire_signoff_id


	exec
		ag_processqueuedwire
			@login = @login,
			@pb_wire_signoff_id = @pb_wire_signoff_id

	select
		@pb_wire_signoffs = count(*)
	from
		#pb_wire_signoffs
	where
		pb_wire_signoff_id > @pb_wire_signoff_id
end




go
