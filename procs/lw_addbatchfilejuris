use
	risk_firsel
go

drop procedure
	lw_addbatchfilejuris
go

create procedure
	lw_addbatchfilejuris
		@login varchar(50),
		@batch_file_identifier varchar(50),
		@jurisdiction varchar(50),
		@state varchar(50),
		@city varchar(50),
		@county varchar(50),
		@postal_code varchar(20),
		@amount float

as

declare @batch_file_id int
declare @identifier varchar(50)
declare @jurisdiction_id int
declare @accounts int
declare @state_id int
declare @county_id int
declare @city_id int

select
	@batch_file_id = batch_file_id
from
	batch_files
where
	identifier = @batch_file_identifier
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Batch file not found",
		batch_file_identifier = @batch_file_identifier
	return
end


select
	@jurisdiction_id = jurisdiction_id
from
	jurisdictions
where
	name = @jurisdiction
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Jurisdiction not found",
		jurisdiction = @jurisdiction
	return
end

select
	@accounts = count(*)
from
	batch_file_accounts
where
	batch_file_id = @batch_file_id
if @accounts = NULL
	select
		@accounts = 0

select
	@state_id = state_id
from
	states
where
	lower(name) = lower(@state)
if @state_id = NULL
begin
	exec
		j_nextkey
			"states",
			@state_id output

	insert into
		states
	values(
		@state_id,
		@state,
		convert(char(2), @state))
end

select
	@city_id = city_id
from
	cities
where
	lower(name) = lower(@city)
and
	state_id = @state_id
if @city_id = NULL
begin
	exec
		j_nextkey
			"cities",
			@city_id output

	insert into
		cities
	values(
		@city_id,
		@city,
		@state_id)
end

select
	@county_id = county_id
from
	counties
where
	lower(name) = lower(@county)
and
	state_id = @state_id
if @county_id = NULL
begin
	exec
		j_nextkey
			"counties",
			@county_id output

	insert into
		counties
	values(
		@county_id,
		@county,
		@state_id)
end


select
	@accounts = @accounts + 1

select
	@identifier = @batch_file_identifier + "-" + rtrim(convert(varchar(25), @accounts))

insert into
	batch_file_accounts
values(
	@batch_file_id,
	@identifier,
	@jurisdiction_id,
	@amount,
	@city_id,
	@state_id,
	@county_id,
	@postal_code)


go

