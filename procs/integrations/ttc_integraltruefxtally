select
	@ack_required = "N"

/* PB customer tallies are different than standard FIX connection for Agency Flow 
* this fix connection is NOT AN ELYSIUM CUSTOMER'S FIX CONNECTION, this is the FIX connection of our
* client's client. Therefore, we book two trades for every ONE message we recieve. One trade
* to represent our customer vs their customer and one trade to represent our customer vs their customers' lp */
 

/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
	@source_id = source_id
from
	sources
where
	name = @source


/* --------------------------------------------------------------------------
 * STEP: Eval client or market
 * Determine if the trade is a client trade or if the trade is a market trade
 * some platforms provide an explicit tag. evaluate that tag here and set 
 * @client_or_market to either "C" or "M". Raise an error message if you can't
 * determine. If no tag (or combination of tags) are provided, then set the
 * the @client_or_market_lookup and check to see if it maps to a fund agency 
 * counterparty by calling tt_isfundagency. 
 * This logic usually differs platform by platform
 */

if @cover_exec_id != NULL and @covered_exec_id != NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "Workflow not supported. Both @cover_exec_id and @covered_exec_id are populated"
        return
end

if @cover_exec_id = NULL and @covered_exec_id = NULL  /* This is disclosed flow. Only receiving 1 message */
begin
	select
		@disclosed_or_undisclosed = "D"
end


if @cover_exec_id != NULL and @covered_exec_id = NULL /*Taker Trade*/
begin
	select
		@client_or_market = "C",
		@disclosed_or_undisclosed = "U"
end

if @covered_exec_id != NULL and @cover_exec_id = NULL /*Maker Trade*/
begin
	select
		@client_or_market = "M",
		@disclosed_or_undisclosed = "U"
end



/* --------------------------------------------------------------------------
 * STEP: Map proc parameters to common tally variable name
 * This mapping allows us to use common variable names in all tallies. It also
 * helps with debugging, as you can look here to see what is mapped
 * For multi-prime setups that don't have a pb tag, set the prime_broker_lookup to ""
 *
 */


if @client_or_market = "C"
begin
        select
                @c_deal_exec_symbol = rtrim(@execution_id),
                @m_deal_exec_symbol = rtrim(@cover_exec_id),
                @c_platform_identifier = rtrim(@execution_id)+".c",
                @m_platform_identifier = rtrim(@execution_id)+".m"

	select
        	@c_trader_lookup = rtrim(@deliver_to_comp_id),
        	@c_counterparty_lookup = rtrim(@on_behalf_of_comp_id),
        	@m_trader_lookup = rtrim(@target_comp),
        	@m_counterparty_lookup = rtrim(@target_comp)+"-"+rtrim(@deliver_to_comp_id)

	select
        	@m_suppression_lookup = @m_counterparty_lookup,
		@c_suppression_lookup = @c_trader_lookup
	
	/* Not using trigger symbols, ticket creation values not currently supported
	select
        	@trigger_symbol = @m_trader_lookup,
		@trigger_symbol = @c_counterparty_lookup
	*/
end

if @client_or_market = "M"
begin
	select
                @c_deal_exec_symbol = rtrim(@execution_id),
                @m_deal_exec_symbol = rtrim(@covered_exec_id),
                @c_platform_identifier = rtrim(@execution_id)+".c",
                @m_platform_identifier = rtrim(@execution_id)+".m"

	select
                @c_trader_lookup = rtrim(@on_behalf_of_comp_id),
                @c_counterparty_lookup = rtrim(@deliver_to_comp_id),
                @m_trader_lookup = rtrim(@target_comp),
                @m_counterparty_lookup = rtrim(@target_comp)+"-"+rtrim(@on_behalf_of_comp_id)

        select
                @m_suppression_lookup = @m_counterparty_lookup,
                @c_suppression_lookup = @c_trader_lookup

        /* Not using trigger symbols, ticket creation values not currently supported
        select
                @trigger_symbol = @m_trader_lookup,
                @trigger_symbol = @c_counterparty_lookup
	*/
end

if @disclosed_or_undisclosed = "D"
begin
	select
        	@deal_exec_symbol = rtrim(@execution_id),
        	@c_platform_identifier = rtrim(@execution_id)+".c",
        	@m_platform_identifier = rtrim(@execution_id)+".m"

	select
                @c_trader_lookup = rtrim(@deliver_to_comp_id),
                @c_counterparty_lookup = rtrim(@on_behalf_of_comp_id),
                @m_trader_lookup = rtrim(@target_comp)+"-"+rtrim(@deliver_to_comp_id),
                @m_counterparty_lookup = rtrim(@target_comp)+"-"+rtrim(@on_behalf_of_comp_id)

        select
                @m_suppression_lookup = @m_counterparty_lookup,
                @c_suppression_lookup = @c_trader_lookup
	
	select
                @deal_exec_symbol_2 = rtrim(@execution_id) + "_auto",
                @c2_platform_identifier = rtrim(@execution_id)+"_auto.c",
                @m2_platform_identifier = rtrim(@execution_id)+"_auto.m"
        select
                @c2_trader_lookup = rtrim(@on_behalf_of_comp_id),
                @c2_counterparty_lookup = rtrim(@deliver_to_comp_id),
                @m2_trader_lookup = rtrim(@target_comp)+"-"+rtrim(@on_behalf_of_comp_id),
                @m2_counterparty_lookup = rtrim(@target_comp)+"-"+rtrim(@deliver_to_comp_id)

        select
                @m2_suppression_lookup = @m2_counterparty_lookup,
                @c2_suppression_lookup = @c2_trader_lookup
	
end



