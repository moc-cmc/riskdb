drop procedure
	tts_trtntally
go

create procedure
	tts_trtntally
		@source varchar(50),
                @default_login varchar(50),
                @broker varchar(50),
                @granularity varchar(15)=NULL,
                /* Parsed from FIX message and provided by mapping.xml */
                /* session variables */
		@sender_comp varchar(50),
		@target_comp varchar(50),
    		/* identifiers */
    		@trade_report_id varchar(50)=NULL,
    		@order_id varchar(50)=NULL,
		@cl_order_id varchar(50)=NULL,
		@safra_trade_id varchar(50)=NULL,
    		/* financials */
    		@trade_date datetime=NULL,           
    		@trade_day datetime=NULL,            
    		@value_date datetime=NULL,           
		@fixing_date datetime=NULL,
    		@price float=NULL,                
    		@symbol varchar(50)=NULL,               
    		@side varchar(50)=NULL,                 
    		@ccy1 varchar(50)=NULL,             
		@ccy2 varchar(50)=NULL,
    		@qty float=NULL,             
		@counter_qty float=NULL,
    		@last_spot_rate float=NULL,       
		@last_fwd_points float=NULL,
		@security_type varchar(50)=NULL,
		@product varchar(50)=NULL,
		@settle_ccy varchar(50)=NULL,
		/*swaps*/
		@near_price float=NULL,
                @far_price float=NULL,
		@near_spot_price float=NULL,
		@far_spot_price float=NULL,
		@near_value_date datetime=NULL,
                @far_value_date datetime=NULL,
		@near_fixing_date datetime=NULL,
                @far_fixing_date datetime=NULL,
		@far_quantity float=NULL,
		/* options */
		@strike varchar(20)=NULL,
		@option_quantity float=NULL,
		@option_expiry_date datetime=NULL,
		@option_leg_side varchar(10)=NULL,
		@option_exercise_style varchar(10)=NULL,
		@option_premium float=NULL,
		@option_premium_side varchar(10)=NULL,
		@option_premium_date datetime=NULL,
		@option_premium_ccy varchar(10)=NULL,
		@option_cut_zone varchar(50)=NULL,
		@option_maturity_time varchar(10)=NULL,
		@option_vol float=NULL,
		@option_pips_price float=NULL,
		@option_strike_ccy varchar(50)=NULL,
		@option_symbol varchar(10)=NULL,
		@call_put varchar(10)=NULL,
		@option_settle_date datetime=NULL, /*
		@option_quote_basis varchar(50)=NULL,
		@option_premium_basis varchar(50)=NULL, */
    		/* parties */
                @executing_firm varchar(50)=NULL,
    		@client_id varchar(50)=NULL,
                @executing_system varchar(50)=NULL,
		@order_orig_trader varchar(50)=NULL,
		/* Extra */
		@trade_alloc_indicator varchar(50)=NULL,
		@alloc_account varchar(50)=NULL,
		@alloc_qty float=NULL,
		@alloc_settl_ccy varchar(50)=NULL,
		@aggressor_indicator varchar(50)=NULL,
		@symbol_suffix varchar(50)=NULL,
		@fixing_center_symbol varchar(50)=NULL,
		@fixing_currency varchar(3)=NULL,
		@price_type varchar(50)=NULL
as

declare @client_or_market char(1)
declare @platform_identifier varchar(100)
declare @far_platform_identifier varchar(100)
declare @deal_exec_symbol varchar(100)

declare @broker_id int
declare @source_id int
declare @trade_id int
declare @deal_id int

declare @fund_agency_lookup varchar(30)
declare @is_fund_agency char(1)

declare @quantity numeric(30, 2)
declare @contract varchar(20)
declare @dealt_ccy varchar(3)
declare @counter_ccy varchar(3)

declare @prime_broker_lookup varchar(50)
declare @trader_lookup varchar(50)
declare @counterparty_lookup varchar(50)
declare @trader_mapping_error_id int
declare @cpty_mapping_error_id int
declare @trader_id int
declare @counterparty_id int
declare @trader_external_account_id int
declare @cpty_external_account_id int
declare @ea_external_account_id int
declare @ea_external_account varchar(50)
declare @ea_external_account_type varchar(50)
declare @ea_aggregation_style varchar(50)
declare @external_account varchar(50)
declare @suppress_trade varchar(50)
declare @suppression_lookup varchar(50)
declare @ack_required varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @lookup_trader varchar(50)
declare @counterparty varchar(50)
declare @external_account_id int
declare @external_account_type varchar(50)
declare @trader_login varchar(50)
declare @trader varchar(50)
declare @far_trade_id int
declare @far_trade_type varchar(50)
declare @deal_status varchar(50)
declare @aggregation_style varchar(50)
declare @contract_id int
declare @inverted varchar(50)
declare @tally_status varchar(10)
declare @tally_message varchar(25)
declare @far_tally_status varchar(10)
declare @far_tally_message varchar(25)

declare @trigger_symbol varchar(50)
declare @timezone varchar(50)
declare @timezone_symbol varchar(50)
declare @strike_char varchar(20)
declare @quantity_char varchar(50)
declare @option_premium_char varchar(50)
declare @cl_or_lp varchar(5)
declare @fixing_center_id int
declare @fixing_center varchar(50)
declare @total_days float
declare @begin_date datetime
declare @end_date datetime
declare @fixing_currency_id int
declare @two_business_days datetime
declare @four_business_days datetime
declare @gmt_offset int
declare @bo_trade_date datetime
declare @next_business_day datetime
declare @last_spot_rate_provided float


/* --------------------------------------------------------------------------
 * STEP: Set ACKs to True
 */
select
	@ack_required = "Y"

/* --------------------------------------------------------------------------
 * STEP: Initial MAP proc parameters to common tally params
 * It may be that additional parameters are mapped further down in the 
 * stored procedure based on the result of @client_or_market
 */
select
	@fund_agency_lookup = @executing_firm

/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */
select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
	@source_id = source_id
from
	sources
where
	name = @source


/* --------------------------------------------------------------------------
 * STEP: Eval client or market
 * Determine if the trade is a client trade or if the trade is a market trade
 * some platforms provide an explicit tag. evaluate that tag here and set 
 * @client_or_market to either "C" or "M". Raise an error message if you can't
 * determine. If no tag (or combination of tags) are provided, then set the
 * the @client_or_market_lookup and check to see if it maps to a fund agency 
 * counterparty by calling tt_isfundagency. 
 * This logic usually differs platform by platform
 *
 */ 

/* If this connection is determining client or market based of data value, then use this block */
exec
	tt_isfundagency
		@source_id=@source_id,
		@mapping=@fund_agency_lookup,
		@is_fund_agency=@is_fund_agency output
select
	@client_or_market = "M"

if @is_fund_agency = "N"
	select
		@client_or_market = "M"

/* If this connection is determining client or market based of specific tags, then use this block - COMING BACK TO THIS
if @some_tag = "xxx" and @some_other_tag = NULL
begin
	select
		@client_or_market = "M"
end
else if @some_tag = NULL and @some_other_tag = "xxx"
begin
	select
		@client_or_market = "C"
end
if @client_or_market = NULL
begin
	select
		status = "Error",
		message = "Could not determine if message was client or market trade"
	return
end
*/

/* --------------------------------------------------------------------------
 * STEP: Map proc parameters to common tally variable name
 * This mapping allows us to use common variable names in all tallies. It also
 * helps with debugging, as you can look here to see what is mapped
 * For multi-prime setups that don't have a pb tag, set the prime_broker_lookup to ""
 *
 */

if @client_or_market = "C"
begin
	select
		@platform_identifier = rtrim(@trade_report_id)+"_"+convert(char(8), @trade_date, 112)+".c",
		@deal_exec_symbol = @order_id

	/*
	select
		@prime_broker_lookup = rtrim(@sponsoring_firm)+"-"
                /*@prime_broker_lookup = ""*/
	*/

	select
		@counterparty_lookup = rtrim(@prime_broker_lookup)+@client_id,
		@trader_lookup = rtrim(@prime_broker_lookup)+@executing_firm

	/* Set suppression and trigger_symbol variables */
        select
                @suppression_lookup = @trader_lookup,
                @trigger_symbol = @trader_lookup	
end
else /* @client_or_market = "M" */
begin
        select
                @platform_identifier = rtrim(@trade_report_id)+"_"+convert(char(8), @trade_date, 112)+".m",
                @deal_exec_symbol = @order_id
                
	/*
        select
                @prime_broker_lookup = rtrim(@sponsoring_firm)+"-"
                /*@prime_broker_lookup = ""*/
	*/

        select
                @counterparty_lookup = @executing_firm,
                @trader_lookup = rtrim(@prime_broker_lookup)+@order_orig_trader

        /* Set suppression and trigger_symbol variables */
        select
                @suppression_lookup = @counterparty_lookup,
                @trigger_symbol = @counterparty_lookup

end


/* --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 * |     WARNING ------- WARNING -------- WARNING -------- WARNING          |
 * |                                                                        |
 * |                                                                        |
 * |  Do not make changes below this point                                  |
 * |  If you make changes, place comments about what was changed.           |
 * |                                                                        |
 * |                                                                        |
 * --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 */

/* CHANGE COMMENTS:
 * adding logic to handle swap
 * adding logic to handle options
 */



/* --------------------------------------------------------------------------
 * STEP: Dupe check on the identifier 
 *
 */

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@platform_identifier,
		@trade_id=@trade_id output

if @trade_id != NULL
begin
	/* tt_isdupe would throw error message, just return */
	return
end



/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error. 
 */
exec
	ag_pendingmappingerrors
		@login = @default_login,
        	@broker_id = @broker_id,
        	@identifier = @platform_identifier,
        	@trader_mapping_error_id = @trader_mapping_error_id output,
		@cpty_mapping_error_id = @cpty_mapping_error_id output

exec
	tt_resolvetradermapping
		@login=@default_login,
		@source_id=@source_id,
		@source=@source,
		@broker_id=@broker_id,
		@identifier=@platform_identifier,
		@mapping_error_id=@trader_mapping_error_id,
		@mapping=@trader_lookup,
		@trader_id=@trader_id output,
		@trader=@trader output,
		@trader_login=@trader_login output,
		@external_account_id=@trader_external_account_id output

exec
	tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@platform_identifier,
                @mapping_error_id=@cpty_mapping_error_id,
		@mapping = @counterparty_lookup,
		@counterparty_id=@counterparty_id output,
		@counterparty=@counterparty output,
		@cpty_external_account_id=@cpty_external_account_id output

if @trader_id = NULL
begin
	select 
		status = "Error",
		error = "Error",
		message = "trader mapping error trade not processed"
        return
end

if @counterparty_id = NULL
begin
	select 
		status = "Error",
		error = "Error",
		message = "counterparty mapping error trade not processed"
        return
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from the trader or counterparty, 
 *
 * On a client trade, the external account is determined by the trader
 * On a market trade, the external account is determined by the counterparty
 */

if @client_or_market = "C"
begin
	select
		@external_account_id = @trader_external_account_id
end
else /* @client_or_market = "M" */
begin
	select
		@external_account_id = @cpty_external_account_id
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from mapped symbol 
 * 
 * If a symbol exists, then overwrite whatever was determined by the counterparty or trader.
 * Since a mapping is not required, send @mapping_error_id = 0 so that we do not send a message
 */
/* - for now, dont worry about any external account mappings. Might add back in later
exec
	tt_resolveextacctmapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
		@identifier=@platform_identifier,
		@mapping_error_id=0, /* sending as 0 will ensure a message is never sent */
		@external_account_id = @ea_external_account_id output,
		@external_account = @ea_external_account output,
		@external_account_type=@ea_external_account_type output,
		@aggregation_style=@ea_aggregation_style output
*/

if @ea_external_account_id != NULL
begin
	select
		@external_account_id =  @ea_external_account_id,
                @external_account = @ea_external_account,
                @external_account_type = @ea_external_account_type,
                @aggregation_style = @ea_aggregation_style
end
else
begin
	select
                @external_account = a.symbol,
                @external_account_type = b.name,
                @aggregation_style = c.name
	from
		external_accounts a,
		external_account_types b,
		aggregation_styles c
	where
		a.external_account_type_id = b.external_account_type_id
	and
		a.aggregation_style_id = c.aggregation_style_id
	and
		a.external_account_id = @external_account_id
end

if @fixing_date != NULL
begin
	select
                @fixing_center_id = b.fixing_center_id,
                @fixing_center = b.symbol
        from
                fixing_centers a,
                fixing_center_symbols b
        where
                a.fixing_center_id = b.fixing_center_id
        and
                b.source_id = @source_id
        and
                b.symbol = @fixing_center_symbol
        if @fixing_center = NULL
        begin
                select
                        status = "Error",
                        message = "Fixing Center " + @fixing_center + "not found"
                return
        end

	select
		@fixing_currency_id = product_id
	from
		products
	where
		symbol = @fixing_currency
	
	if @fixing_currency_id = NULL
	begin
		select
			status = "Error",
			message = "Fixing currency " + @fixing_currency + "not found"
		return
	end
end

/* --------------------------------------------------------------------------
 * STEP: Check for suppression 
 *
 */
select
	@suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id
and
	symbol = @suppression_lookup

if @suppress_trade = "Y"
begin
	select
		status = "Suppressing trade",
		platform_identifier = @platform_identifier,
		source = @source,
		suppression_lookup = @suppression_lookup

	if @ack_required = "Y"
	begin
        	select
                	trade_report_id=@trade_report_id,
                	symbol="NA"
	end

	/* We may store this data later on, but for now we will return out of tally */
	return
end

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 *
 */

select
	@deal_type = "Market Forward"


/* Safra specific - they require t+2 and under to be SPOT, regardless of ccy pair
* trade_date >2bizdays and trade_date <=4bizdays and spot rate = all in rate, then its SPOT
*  t+3 and over and spot rate != all in rate, set to FORWARD 
* THE ABOVE IS OLD LOGIC AS OF 2022-11-09 - SAFRA CHANGE for WORKORDER REQ10729 Calypso Adapter Adjustment CAD TRY
* Safra  would like to request 2 changes we have been discussing:
*     1.       Change logic for FX trades for CAD and TRY – to be  considered as spot for T+1,  and forwards for  T+2 or greater. 
*              For the rest of the currencies existing  logic you have in the adapter should still hold.
*
*/

/* The below logic may be overwritten for CAD and TRY trades so there is another section to set these after we do symbol determination */

select
	@bo_trade_date = dbo.f_botradedate(@trade_date)

exec
	r_nextbusinessday
		@bo_trade_date,
		@next_business_day output
select
	@last_spot_rate_provided = @last_spot_rate

exec
	r_twobusinessdays
		@date = @trade_date,
		@two_business_days = @two_business_days output

exec
        r_twobusinessdays
                @date = @two_business_days,
                @two_business_days = @four_business_days output

if @value_date <= @two_business_days
begin
        select
                @trade_type = "Spot",
                @tally_type = "Spot",
		@last_spot_rate = @price
end
else if @value_date > @two_business_days and @value_date <= @four_business_days and @last_spot_rate = @price
begin
	select
		@trade_type = "Spot",
                @tally_type = "Spot",
                @last_spot_rate = @price
end
else 
begin
	select
                @trade_type = "Forward",
                @tally_type = "Forward"
end

if @fixing_date != NULL
begin
        select
                @trade_type = "Forward",
                @tally_type = "Forward"
end



if @far_price != NULL
begin
        select
                @deal_type = "Market Swap",
                @trade_type = "Swap Near",
                @far_trade_type = "Swap Far",
                @tally_type = "Swap",
		@far_platform_identifier=@platform_identifier + ".f",
		@price = @near_price,
		@value_date = @near_value_date,
		@last_spot_rate = @near_spot_price

	/*
	if @near_value_date <= @two_business_days 
	begin
		select
			@last_spot_rate = @near_price
	end
	*/
end



if @strike != NULL
begin

	select
		@deal_type = "Market Option",
		@trade_type = "Option",
		@tally_type = "Option"
end



/* --------------------------------------------------------------------------
 * STEP: Manage neccesary option variables
 *
 */

if @trade_type = "Option"
begin
	select
                @strike_char = @strike,
                @quantity_char = convert(varchar(50), @option_quantity),
                @option_premium_char = convert(varchar(50), @option_premium),
		@option_vol = @option_vol / 100

	select
		@timezone_symbol  = @option_cut_zone + " " + @option_maturity_time
	select
		@timezone = a.timezone
	from
		timezones a,
		timezone_symbols b,
		sources c
	where
		a.timezone_id = b.timezone_id
	and
		b.source_id = c.source_id
	and
		c.source_id = @source_id
	and
		b.symbol = @timezone_symbol
	
	if @timezone = NULL
	begin
		select
			status = "Error",
			msg = "No timezone mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@timezone_symbol) + "'"	
		return
	end

	if @client_or_market = "C"
	begin
		select 
			@cl_or_lp = "CL",
			@deal_type = "Client Option"
	end
	else
	begin
		select
			@cl_or_lp = "LP",
			@deal_type = "Market Option"
	end
end


/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * 
 * Default all trades right now to assume a 'B2B *' deal type
 */



exec
	tt_resolvedeal
		@deal_exec_symbol = @deal_exec_symbol,
		@deal_id = @deal_id output,
		@deal_type = @deal_type output,
		@deal_status = @deal_status output
if @deal_id = NULL
begin
	exec
		tt_newdeal
			@deal_type = @deal_type,
			@deal_status = @deal_status,
			@deal_exec_symbol = @deal_exec_symbol,
			@deal_id = @deal_id output
end


/* --------------------------------------------------------------------------
 * STEP: Determine the contract for non option. Determine dealt_ccy and counter_ccy for option
 *
 */

if @trade_type != "Option"
begin
	exec
		r_validateccypair
			@login=@default_login,
			@symbol=@symbol,
			@ccy1=@ccy1,
			@ccy2=@ccy2,
			@contract_id = @contract_id output,
			@contract = @contract output,
			@inverted = @inverted output

	/* OVERWRITE TRADE TYPE FOR CAD AND TRY SPOT/FWD, IGNORE SWAP, OPTION */

        if @trade_type in("Spot", "Forward") and @contract in("USDCAD", "CADUSD", "USDTRY", "TRYUSD")
	begin
		/* If T+1 for CAD and TRY set to spot, else set to Forward */
		if @value_date <= @next_business_day
		begin
			select
				@trade_type = "Spot",
				@tally_type = "Spot",
				@last_spot_rate = @price
		end
		else
		begin
			select
				@trade_type = "Forward",
				@tally_type = "Forward",
				@last_spot_rate = @last_spot_rate_provided /* we may have overwritten so using provided */
		end
	end
end
else
begin
	if @option_strike_ccy = substring(@option_symbol, 1, 3)
    	begin
		select
			@dealt_ccy = @option_strike_ccy,
			@counter_ccy = substring(@option_symbol, 4, 6)
	end
	else
	begin
		select
			@dealt_ccy = substring(@option_symbol, 4, 6),
			@counter_ccy = @option_strike_ccy
	end
end

if @inverted = "Y"
begin
	if @price_type = "Normal"
	begin
		select
			@price = 1/@price,
			@last_spot_rate = 1/@last_spot_rate
	end
end

if @inverted = "N"
begin
	if @price_type = "Inverse"
	begin
		select
			@price = 1/@price,
			@last_spot_rate = 1/@last_spot_rate
	end
end
	

/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the FIX message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund 
 * or agency so set the direction accordingly
 */


if @client_or_market = "C"
begin
	if @side = "BUY"
	begin
		select
			@quantity = @qty
	end

	if @side = "SELL"
	begin
                select
                        @quantity = @qty * -1
        end

	
end
else /* if @client_or_market = "M" */
begin
	if @side = "BUY"
	begin
		select
			@quantity = @qty
	end

	if @side = "SELL"
	begin
                select
                        @quantity = @qty * -1
        end

end

/* --------------------------------------------------------------------------
 * STEP: Tally the trade. Check for Spot/Fwd/NDF or Option
 *
 */

if @trade_type != "Option"
begin
	exec
		fxa_tallytrade
			@login = @trader_login,
			@source = @source,
			@trade_id = @trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @tally_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@quantity = @quantity,
			@symbol = @contract,
			@value_date = @value_date,
			@fixing_date = @fixing_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @trader,
			@broker = @broker,
			@identifier = @platform_identifier,
			@spot_reference = @last_spot_rate

	if @trade_id = NULL
	begin
		select
			@tally_status = "Error",
			@tally_message = "Problem tallying trade"
	end
	else
	begin
		if @fixing_date != NULL
		begin
			insert into 
				trade_attributes(
					trade_id,
					fixing_center_id,
					fixing_currency_id
				)
			select
				@trade_id,
				@fixing_center_id,
				@fixing_currency_id
		end

		exec
        		r_inserttradenotification
                		@trade_id = @trade_id

		select
			@tally_status = "Success",
			@tally_message = "Tallied trade"
