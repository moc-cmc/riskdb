drop procedure tt_isdupe
go

create procedure 
	tt_isdupe
		@broker_id int,
		@identifier varchar(100),
		@trade_id int=NULL output

as

/*
 *  This proc will get called alot. Therefore, sending codes for tags:
 *     i:d -> id_check:dupe
 *     i:n -> id_check:new
 *     c:h -> cache:hit
 *     c:m -> cache:miss
 */
declare @start_time datetime
declare @end_time datetime
declare @tags varchar(8)
select
        @start_time = getdate()

select
	@trade_id = trade_id
from
	recent_identifiers
where
	broker_id = @broker_id
and
	identifier = @identifier
if @trade_id != NULL
begin
	select
		@tags = "i:d,c:h"
end
else
begin
	select
		@trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id
	and
		identifier = @identifier
	if @trade_id != NULL
	begin
		select
			@tags = "i:d,c:m"
	end
	else
	begin
		select
			@tags = "i:n"
	end
end

if @trade_id != NULL
begin
	select
		status = "Dupe",
		message = "Already tallied",
		trade_identifier = @identifier,
		trade_id = @trade_id
end



select
        @end_time = getdate()

exec
        sp_dogstatsdtimer
                @metric_name="ase.proc.tt_isdupe",
                @start_time=@start_time,
                @end_time=@end_time,
                @tags=@tags,
                @sample_rate="1.0"
go
