begin
        select
		@long_trade_id = @c_trade_id,
		@short_trade_id = @c2_trade_id
end
else
begin
        select
                @short_trade_id = @c_trade_id,
		@long_trade_id = @c2_trade_id
end

exec
	j_nextkey
		"exchange_matches",
		@exchange_match_id output

insert into
	exchange_matches(
		exchange_match_id,
		symbol,
		long_trade_id,
		short_trade_id,
		match_timestamp,
		processing_timestamp)
values(
	@exchange_match_id,
	@execution_id,
	@long_trade_id,
	@short_trade_id,
	@trade_date,
	getdate())

