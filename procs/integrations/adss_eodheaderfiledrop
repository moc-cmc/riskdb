
create or replace procedure
	adss_eodheaderfiledrop
		@login varchar(25),
		@source varchar(50),
		@transaction_date datetime=NULL
as

declare @batch_id varchar(12)

if @transaction_date = NULL
        /* runs on a 12pm-12pm schedule */
        select
                @transaction_date = convert(date, getdate())

select
	@batch_id = convert(varchar(12), getdate(), 112) + "01"

create table
	#headerfile (
		transaction_number int,
		transaction_date varchar(12),
                value_date datetime)


insert into
	#headerfile (
		transaction_number,
		transaction_date,
		value_date )
	select
		account_transaction_id,
		convert(varchar(12), transaction_date, 112),
		convert(varchar(12), @transaction_date)
        from
		account_transactions
        where
                convert(varchar(12), transaction_date, 112) = convert(varchar(12), @transaction_date, 112)
 	
