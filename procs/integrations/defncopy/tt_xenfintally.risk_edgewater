
create procedure
        tt_xenfintally
                @default_login varchar(50),
                @agent varchar(50),
                @source varchar(50),
                @broker varchar(50),
                @sender_comp varchar(50),
                @target_comp varchar(50),
                @transaction_time datetime,
                @execution_id varchar(50),
                @secondary_exec_id varchar(50),
                @client_id varchar(50),
                @exec_firm varchar(50),
                @exec_system varchar(50),
                @order_id varchar(50),
                @cl_order_id varchar(50),
                @symbol varchar(50),
                @side varchar(50),
                @value_date datetime,
                @price float,
                @last_qty numeric(30,6),
                @order_status varchar(50),
		@trade_report_id varchar(50),
                @exec_type varchar(50),
                @ord_qty1 numeric(30,6),
                @market_indicator varchar(50),
                @avg_price float,
                @cum_qty numeric(30,6),
                @ccy1 varchar(50),
                @leaves_qty numeric(30,6),
                @trading_day varchar(50),
		@full_order_id varchar(50)
as

declare @ord_amount numeric(30, 4)
declare @client_aggressor char(1)
declare @mpt_order_id int
declare @substring1 varchar(50)
declare @substring2 varchar(50)
declare @quoted_price float
declare @cpty_ext_acct_id int
declare @aggregation_style varchar(50)
declare @committed_status_id int
declare @is_agency_trade varchar(1)
declare @tallied int
declare @lookup_trader varchar(50)
declare @inverted char(1)
declare @lookup_cpty varchar(50)
declare @lookup_mkt_trdr varchar(50)
declare @trader varchar(50)
declare @user varchar(50)
declare @user_account_id int
declare @counterparty varchar(50)
declare @counterparty_id int
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trader_login varchar(50)
declare @deal_alias varchar(100)
declare @source_id int
declare @external_account varchar(50)
declare @internal_account varchar(50)

declare @trader_id int
declare @tico_account_id int
declare @external_account_id int
declare @deal_id int
declare @trade_id int
declare @suppressed_deal_id int
declare @suppressed_trade_id int
declare @external_account_type varchar(30)
declare @contract_id int
declare @inverted_price_style_id int
declare @strategy_id int
declare @status_id int
declare @broker_id int
declare @trade_status_id int
declare @notification_source varchar(50)
declare @notification_source_id int
declare @active_status_id int
declare @msg varchar(200)

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @deal_type_id int
declare @deal_status_id int
declare @trd_spot_ref float

declare @sales_code_id int
declare @do_not_tally_salescode_id int

declare @fund_agency_counterparty_id int

declare @suppress_client_trade char(1)
declare @tally_type varchar(50)

declare @deal_identifier varchar(50)
declare @validity_type varchar(50)
declare @suppress_trade varchar(1)

declare @fund_agency_trader varchar(50)
declare @check_lookup_trader varchar(50)
declare @check_trader_id int
declare @qty numeric(30,4)
declare @mkt_trade_id int
declare @mkt_trade_identifier varchar(50) 
declare @mkt_lookup_trader varchar(50)
declare @mkt_counterparty_id int
declare @mkt_counterparty varchar(50)
declare @mkt_lookup_cpty varchar(50)
declare @mkt_external_account varchar(50)
declare @mkt_external_account_id int
declare @mkt_trader_login varchar(50)
declare @mkt_trader_id int
declare @mkt_trader varchar(50)
declare @mkt_external_account_type varchar(50)
declare @mkt_qty numeric(30,4)


select
	@suppress_trade = "N"
select
	@fund_agency_trader = "N"

if @price = 0 and @last_qty = 0
begin
	select
		@suppress_trade = "Y"
end

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
        @trade_type = "Spot",
        @tally_type = "Spot",
        @deal_type = "B2B Forward"


select
    @deal_status_id = status_id
from
    statuses
where
    name = "User Review"
if @deal_status_id = NULL
begin
        select
                status = "Error",
                message = "No status found named, 'User Review'"
        return
end

select
        @deal_type_id = deal_type_id
from
        deal_types
where
        name = @deal_type
if @deal_type_id = NULL
begin
        select
                status = "Error",
                msg = "No deal type found for",
                deal_type = @deal_type
        return
end

select
        @source_id = source_id
from
        sources
where
        name = @source
if @@rowcount != 1
begin
        select
                status = "Error",
                message = "Source not found",
                source = @source
        return
end

if @side = "SELL"
begin   
    select      
        @last_qty = -@last_qty
end


if @ccy1 != NULL
begin
	select
		@substring1 = substring(@symbol, 1, 3),
		@substring2 = substring(@symbol, 4, 6)
	
	if @substring1 != @ccy1
	begin
		select
			@symbol = @substring2 + @substring1,
			@inverted = "Y"
	end
	
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"

	declare @ccy1_determined varchar(3)
	declare @ccy2_determined varchar(3)

	select 
		@ccy1_determined =  substring(@symbol, 1, 3),
		@ccy2_determined = substring(@symbol, 5, 7)
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1_determined,
                	@ccy2_determined,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end




/*
 * DETERMINE @external_account_type, @counterparty, @trader based on @market_indicator
 */
   /*-------------------------------------------------------------------------------,
   | Client vs Counterparty Flow
   |
   | if @client_id is a fund_agency_trader, this is a counterparty trade
   | if @client_id is not a fund_agency_trader, this is a client trade 
   | message is always in @client_id perspective. if @client_id = client, flip QTY
   '-------------------------------------------------------------------------------*/
select
	@check_lookup_trader = @client_id
select
        @check_trader_id = a.trader_id
from
        traders a,
        trader_symbols b,
        sources ba
where
        a.trader_id = b.trader_id
and
        b.source_id = ba.source_id
and
        ba.name = @source
and
        b.symbol = @check_lookup_trader

if @check_trader_id = NULL
begin
        select
                @check_trader_id = a.trader_id
        from
                traders a
        where
                a.symbol = @check_lookup_trader

        if @check_trader_id = NULL
                begin
                        select
                         status = "Error",
                         message = "Couldn't find trader and user for @check_lookup_trader, '" + @check_lookup_trader + "'",
                         check_lookup_trader = @check_lookup_trader
                        return
                end
end

select
	@fund_agency_trader = "Y"
from
	fund_agency_traders
where
	trader_id = @check_trader_id

if @fund_agency_trader = "Y"
begin
        /* This is a market/street trade */

	select
		/*@trade_identifier = rtrim(@execution_id)+"-"+@trading_day+".m",*/
		@trade_identifier = rtrim(@trade_report_id),
		@lookup_cpty = @exec_system,
		@lookup_trader = @client_id,
		@deal_exec_symbol = rtrim(@secondary_exec_id)
	select
		@trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id
	and
		identifier = @trade_identifier
	if @trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Trade is already tallied",
			trade_identifier = @trade_identifier
		return
	end


	/*
 	* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 	*/ 
	
	select
		@trader_id = a.trader_id,
		@trader = a.symbol,
		@trader_login = c.login,
		@external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	sources ba,
        	tico_accounts c
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = ba.source_id
	and
        	a.tico_account_id = c.account_id
	and
        	ba.name = @source
	and 
        	b.symbol = @lookup_trader
	
	if @trader_id = NULL or @trader_login = NULL
	begin
    		select
            		@trader_id = a.trader_id,
            		@trader = a.symbol,
            		@trader_login = c.login,
            		@external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @lookup_trader
	
    		if @trader_id = NULL or @trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            			mkt_lookup_trader = @lookup_trader
        			return
    			end		
	end
	
	/*
 	* LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 	*/
	
	select
		@counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b,
        	sources ba
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = ba.source_id
	and
        	ba.name = @source
	and
        	b.symbol = @lookup_cpty
	if @counterparty = NULL
	begin
        	select
                	@counterparty_id = a.counterparty_id,
			@counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
        	
        	if @counterparty = NULL
        	begin
               		select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
				mkt_lookup_cpty = @lookup_cpty
                	return
        	end
	end


	/*
 	* LOOKUP @external_account, @external_account_type based on  @cpty_ext_acct_id
 	*/
	select
    		@external_account = a.symbol,
    		@external_account_type = b.name,
    		@aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @cpty_ext_acct_id
	if @external_account = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find external_account from @external_account_id",
			mkt_external_account_id = @external_account_id
		return
	end
end /* market trade details */

if @fund_agency_trader = "N"
begin
	/* book B2B */

	select
		@trade_identifier = rtrim(@trade_report_id)+".c",
		@lookup_cpty = @target_comp,
		@lookup_trader = @client_id,
		@last_qty = -@last_qty,
		@mkt_trade_identifier = rtrim(@trade_report_id)+ ".m",
		@mkt_lookup_cpty = @exec_system,
		@mkt_lookup_trader = @exec_firm,
		@deal_exec_symbol = rtrim(@trade_report_id),
		@mkt_qty = @last_qty



	/*
 	* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 	*/ 
	
	select
		@trader_id = a.trader_id,
		@trader = a.symbol,
		@trader_login = c.login,
		@external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	sources ba,
        	tico_accounts c
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = ba.source_id
	and
        	a.tico_account_id = c.account_id
	and
        	ba.name = @source
	and 
        	b.symbol = @lookup_trader
	
	if @trader_id = NULL or @trader_login = NULL
	begin
    		select
            		@trader_id = a.trader_id,
            		@trader = a.symbol,
            		@trader_login = c.login,
            		@external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @lookup_trader
	
    		if @trader_id = NULL or @trader_login = NULL
    		begin
			select
            		status = "Error",
            		message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            		cli_lookup_trader = @lookup_trader
        		return
    		end		
	end
	
	/*
 	* LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 	*/
	
	select
		@counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b,
        	sources ba
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = ba.source_id
	and
        	ba.name = @source
	and
        	b.symbol = @lookup_cpty
	if @counterparty = NULL
	begin
        	select
                	@counterparty_id = a.counterparty_id,
			@counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
        	
        	if @counterparty = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
				cli_lookup_cpty = @lookup_cpty
                	return
        	end
	end
	
	
	/*
 	* LOOKUP @external_account, @external_account_type based on @external_account_id
 	*/
	select
    		@external_account = a.symbol,
    		@external_account_type = b.name,
    		@aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @external_account_id
	if @external_account = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find external_account from @external_account_id",
			cli_external_account_id = @external_account_id
		return
	end

	/* End of Client lookups */
	
	/* Begin MKT lookups */

	select
		@mkt_trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id
	and
		identifier = @mkt_trade_identifier
	if @mkt_trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Trade is already tallied",
			trade_identifier = @mkt_trade_identifier
		return
	end


	/*
 	* LOOKUP @mkt_trader_id, @mkt_trader, @mkt_trader_login, @mkt_external_account_id 
 	*/ 
	
	select
		@mkt_trader_id = a.trader_id,
		@mkt_trader = a.symbol,
		@mkt_trader_login = c.login,
		@mkt_external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	sources ba,
        	tico_accounts c
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = ba.source_id
	and
        	a.tico_account_id = c.account_id
	and
        	ba.name = @source
	and 
        	b.symbol = @mkt_lookup_trader
	
	if @mkt_trader_id = NULL or @mkt_trader_login = NULL
	begin
    		select
            		@mkt_trader_id = a.trader_id,
            		@mkt_trader = a.symbol,
            		@mkt_trader_login = c.login,
            		@mkt_external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @mkt_lookup_trader
	
    		if @mkt_trader_id = NULL or @mkt_trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @mkt_lookup_trader, '" + @mkt_lookup_trader + "'",
            			mkt_lookup_trader = @mkt_lookup_trader
        			return
    			end		
	end
	
	/*
 	* LOOKUP @mkt_counterparty_id, @mkt_counterparty_symbol, @cpty_ext_acct_id from @mkt_lookup_cpty
 	*/
	
	select
		@mkt_counterparty_id = a.counterparty_id,
		@mkt_counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b,
        	sources ba
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = ba.source_id
	and
        	ba.name = @source
	and
        	b.symbol = @mkt_lookup_cpty
	if @mkt_counterparty = NULL
	begin
        	select
                	@mkt_counterparty_id = a.counterparty_id,
			@mkt_counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @mkt_lookup_cpty
        	
        	if @mkt_counterparty = NULL
        	begin
               		select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @mkt_lookup_cpty, '" + @mkt_lookup_cpty + "'",
				mkt_lookup_cpty = @mkt_lookup_cpty
                	return
        	end
	end


	/*
 	* LOOKUP @mkt_external_account, @mkt_external_account_type based on  @cpty_ext_acct_id
 	*/
	select
    		@mkt_external_account = a.symbol,
    		@mkt_external_account_type = b.name,
    		@aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @cpty_ext_acct_id
	if @mkt_external_account = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find external_account from @mkt_external_account_id",
			mkt_external_account_id = @mkt_external_account_id
		return
	end
	/* End of mkt lookups */
end


select
	@suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id 
and
	symbol = @lookup_trader


/*
select
	@is_agency_trade = "N"
select
	@is_agency_trade = "Y"
from
	fund_agency_traders
where
	trader_id = @trader_id

if @is_agency_trade = 'N'
begin
        select
                @client_aggressor = "Y"
end
*/



select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_exec_symbol

if @suppress_trade = "N"	
begin
	if @deal_id = NULL
	begin
	
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    	insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    		)
	end
	else
	if @deal_id != NULL
	begin
	select
		msg = "Appending to existing deal"
	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = 'B2B Forward'
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for 'B2B Forward'"
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
	end
end


if @suppress_trade = "Y"
begin
exec
	fxa_suppresstrade	
                @login = @default_login,
                @source = @source,
                @suppressed_trade_id = @suppressed_trade_id out,
                @deal_id = @suppressed_deal_id out,
		@deal_identifier = @deal_exec_symbol,
                @tally_type = @trade_type,
                @deal_type = @deal_type,
                @trade_type = @trade_type,
                @external_account = @external_account,
                @counterparty = @counterparty,
                @quantity = @last_qty,
                @symbol = @symbol,
                @value_date = @value_date,
                @price = @price,
                @trade_date = @transaction_time,
                @trader = @trader,
                @broker = @broker,
      		@identifier = @trade_identifier,
                @spot_reference = @price
	if @suppressed_trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to suppress trade"
        end
        select
                status = "Suppressed",
                message = "Trade successfully suppressed",
                trade_id = @suppressed_trade_id,
                deal_id = @suppressed_deal_id,
                account = @external_account,
                symbol = @symbol,
                side = @side,
                quantity = @last_qty,
                price = @price,
                val_date = @value_date
        return
end
else
begin	
	exec
		fxa_tallytrade
			@login = @trader_login,
			@source = @source,
			@trade_id = @trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @tally_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@quantity = @last_qty,
			@symbol = @symbol,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @transaction_time,
			@trader = @trader,
			@broker = @broker,
			@identifier = @trade_identifier,
			@spot_reference = @price	


	if @trade_id = NULL
	begin
		select
			status = "Error",
			message = "Failed to tally trade"
		return
	end		
	else
	begin
		insert into
			trade_quoted_prices (	
				trade_id,
				price)
		values(
			@trade_id,
			@price
			)
		exec
			r_inserttradenotification
			@trade_id
	end
end

if @mkt_qty != NULL
begin
        exec
                fxa_tallytrade
                        @login = @mkt_trader_login,
                        @source = @source,
                        @trade_id = @mkt_trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @tally_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @mkt_external_account,
                        @counterparty = @mkt_counterparty,
                        @quantity = @mkt_qty,
                        @symbol = @symbol,
                        @value_date = @value_date,
                        @price = @price,
                        @trade_date = @transaction_time,
                        @trader = @mkt_trader,
                        @broker = @broker,
                        @identifier = @mkt_trade_identifier,
                        @spot_reference = @price


        if @mkt_trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally mkt trade"
                return
        end
        else
        begin
                insert into
                        trade_quoted_prices (
                                trade_id,
                                price)
                values(
                        @mkt_trade_id,
                        @price
                        )
                exec
                        r_inserttradenotification
                        @mkt_trade_id
        end
end


	/* 
	* AUTOCOMMIT
	*
	* If there is a mktent trade in this deal and the account type is set for
	* Autocommit, then push through this deal automatically.
	*/	if @deal_id != NULL and @trade_id != NULL and @aggregation_style = "Autocommit" and  @tallied != NULL	begin	
    	update
        	deals
    	set
        	status_id = @committed_status_id
    	where
        	deal_id = @deal_id
    	if @@rowcount != 1
    	begin
        	select
            	status = "Error",
            	message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    		end
	end
	else
	begin
    		select
        		message = "No autocommitted",
        		deal_id = @deal_id,
        		trade_id = @trade_id,
        		aggregation_style = @aggregation_style
	end

		
if @trade_id != NULL
begin
	select
		status = "Tallied",
		message = "Trade successfully tallied",
