if @client_trade = "N"   /* COUNTERPARTY */
begin
        select
                @trade_identifier = @execution_id + ".m",
                @deal_exec_symbol = @cl_order_id,
                @deal_type = "B2B Forward"


		
        /*
         * CHECK if this is a market trade where the counterparty = the agency. If it is, set the cpty = sender sub and requery
         *       as this is a client vs client trade 
         */
        if exists(select counterparty_id from fund_agency_counterparties where counterparty_id = @counterparty_id)
        begin
		select
			msg="Identified client v client. Updating cpty to sender_sub_id",
			sender_sub_id = @sender_sub_id

		select
			@lookup_cpty = @sender_sub_id,
			@qty1 = -@qty1
	
		select
        		@counterparty_id = a.counterparty_id,
        		@clvcl_counterparty = a.name,
        		@cpty_ext_acct_id = a.external_account_id
		from
        		counterparties a,
        		counterparty_symbols b,
        		sources ba
		where
        		a.counterparty_id = b.counterparty_id
		and
        		b.source_id = ba.source_id
		and
        		ba.name = @source
		and
        		b.symbol = @lookup_cpty
		if @clvcl_counterparty = NULL
		begin
        		select
                		@counterparty_id = a.counterparty_id,
                		@clvcl_counterparty = a.name,
                		@cpty_ext_acct_id = a.external_account_id
        		from
                		counterparties a
        		where
                		a.name = @lookup_cpty
		
        		if @clvcl_counterparty = NULL
        		begin
                		select
                        		status = "Error",
                        		message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
                        		lookup_cpty = @lookup_cpty
                		return
        		end
		end
		select 
			@counterparty = @clvcl_counterparty
	end

	
	/*
 	 * OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
 	 */ 
	select
		@external_account_id = @cpty_ext_acct_id
end


/*
 * VERIFY @broker exist and check for dupe
 */
select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @@rowcount != 1
begin
        select
                "error"="Error",
                "msg"="Broker not found",
                "broker"=@broker
        return
end

if exists(select trade_id from trades where identifier = @trade_identifier and broker_id = @broker_id)
begin
        select
                status="Dupe",
                msg="Trade already tallied",
                identifier=@trade_identifier,
                broker= @broker
        return
end


/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Couldn't find external_account from @external_account_id",
		external_account_id = @external_account_id
	return
end


select
	@trade_type = "Spot",
	@tally_type = "Spot"
	
if @last_fwd_points != 0 and @last_fwd_points != NULL
begin
	select
		@trade_type = "Forward",	
		@tally_type = "Forward"
		
end

/* 
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @ccy1 != NULL and @ccy2 != NULL and @symbol = @ccy2 + @ccy1
begin
    select
        @symbol = @ccy1 + @ccy2,
	@inverted = "Y"
end


if @side = "SELL"
begin
    select
        @qty1 = -@qty1
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1,
                	@ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end


if @deal_id = NULL
begin
	select
		@deal_id = deal_id
	from
		deal_exec_symbols
	where
		symbol = @deal_exec_symbol
end

if @deal_id = NULL
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
	insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
	)

end
else
begin
	select
		msg = "Appending to existing deal"

	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = 'B2B Forward'
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for 'B2B Forward'"
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
end

/* IF SWAP @SIDE IS IN FAR LEG PERSPECTIVE SO WE FLIP */
if @value_date2 != NULL
begin
        select
                @qty1 = -@qty1

	select
		@trade_type = "Swap Near",
		@far_trade_type = "Swap Far",
		@tally_type = "Forward",
		@far_tally_type = "Forward"
		
end


if @cl_create = "Y" and @lp_create = "Y"
begin
        select
                msg = "Creating new deal to separate auto-generated tickets"


        select
                @auto_b2b_deal_status_id = status_id
        from
                statuses
        where
                name = "User Review"
        if @auto_b2b_deal_status_id = NULL
        begin
                select
                        status = "Error",
                        message = "No status found named, 'User Review'"
                return
        end
        select
                @auto_b2b_deal_type_id = deal_type_id
        from
                deal_types
        where
                name = @deal_type
        if @auto_b2b_deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for @deal_type",
                        deal_type = @deal_type
                return
        end

        exec
                j_nextkey
                        "deals",
                        @auto_b2b_deal_id output

        insert into
                deals(
                        deal_id,
                        deal_type_id,
                        timestamp,
                        status_id
                        )
                values(
                        @auto_b2b_deal_id,
                        @auto_b2b_deal_type_id,
                        getdate(),
                        @auto_b2b_deal_status_id
                        )

        insert into
                deal_exec_symbols
        values(
                @auto_b2b_deal_id,
                rtrim(@deal_exec_symbol)+".autob2b"
        )
end

		
if  @create_deal_alias = "Y"
begin
	select
		msg="Creating deal alias",
		deal_id = @deal_id,
		alias = @order_id

	insert into
		deal_aliases(
			deal_id,
			source_id,
			alias
	)
	values(
		@deal_id,
		@source_id,
		@order_id
	)
end

if  @check_to_update_mkt_deals = "Y"
begin
	select
		@prev_mkt_deal_id = deal_id
	from
		deal_exec_symbols
	where
		symbol = @deal_exec_symbol
	select
		msg = "Checking to update market deals",
		prev_mkt_deal_id = @prev_mkt_deal_id,
		deal_exec_symbol = @deal_exec_symbol,
		deal_id = @deal_id,
		order_id = @order_id
	if @prev_mkt_deal_id != NULL and @prev_mkt_deal_id != @deal_id
	begin
		update
			trades
		set
			deal_id = @deal_id
		where
			deal_id = @prev_mkt_deal_id
		if @@rowcount > 0
		begin
			select
				msg = "Updated previous market deals to client deal",
				from_deal = @prev_mkt_deal_id,
				to_deal = @deal_id
		end
	end
end

if @suppress_trade = "Y"
begin
        exec
                fxa_suppresstrade
                        @login = @trader_login,
                        @source = @source,
                        @suppressed_trade_id = @suppressed_trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @tally_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @external_account,
                        @counterparty = @counterparty,
                        @quantity = @qty1,
                        @symbol = @symbol,
                        @value_date = @value_date,
			@fixing_date = @fixing_date,
                        @price = @price,
