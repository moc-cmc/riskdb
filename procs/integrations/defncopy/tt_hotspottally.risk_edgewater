
create procedure
        tt_hotspottally
                @agent varchar(50),
                @source varchar(50),
                @client_source varchar(50),
                @sender_comp varchar(50),
                @target_comp varchar(50),
                @account varchar(50), /* sometimes NULL */
                @trader varchar(50),
                @collateral_id varchar(50),
                @exec_broker varchar(50),
                @contra_broker varchar(50),
                @transaction_time datetime,
                @trade_date datetime,
                @trading_day datetime,
                @order_id varchar(50),
                @client_order_id varchar(50),
                @execution_id varchar(50), /* sometimes NULL */
                @client_execution_id varchar(50), /* sometimes NULL */
                @trade_link varchar(50),
                @symbol varchar(50),
                @ccy1 varchar(10),
                @ccy2 varchar(10),
                @value_date datetime,
                @side varchar(10),
                @qty1 float,
                @qty2 float,
                @price float,
                @time_in_force varchar(50),
                @ord_qty1 float,
                @ord_qty2 float,
                @leaves_qty float,
                @cum_qty float,
                @last_qty float,
                @avg_price float,
                @last_price float,
                @aggressive_flag varchar(2),
		@spread varchar(1)


as


/******************************************************

Commmission(No Spread): 1 Ticket

-------------------------------------------
    CLIENT 
-------------------------------------------

@trader --> trader -->  external account --> counterparty
@execution_id = trades.identifier + ".c"
/*@execution_id = deal_exec_symbol	chriso: move to order_id*/
@execution_id = @order_id

--------------------------------------------
    COUNTERPARTY
--------------------------------------------

@contra_broker --> counterparty --> external account
@target_comp --> trader
@execution_id = trades.identifier + ".m"
/*@execution_id = deal_exec_symbol	chriso: move to order_id*/
@execution_id = @order_id





Spreading: 3 Tickets
        Client vs Entity
        Entity vs Client
        Entity vs Street

On Mar 3, 2010, at 12:53 PM, Reidy, Paul wrote:

The following should enable you to recognise if upon reciving a tkt you should expect 2 more (as it is spread) or it is the only tkt (as it is not spread).
1. Tag#820 is populated, this indicates a spread trade as the value of tag#820 is common across all 3 trades.
2. For a non spread trade ADMclient will always face JPMC (tag#375=JPMC).
    For a spread trade ADMclient will always face ADMspread (tag#375=ADMspread).

So for the 3 trades above the value of #375 will be.
1. ADMclient vs ADMspread (tag#375=ADMspread)
2. ADMspread vs ADMclient (tag#375=ADMclient)
3. ADMspread vs street      (tag#375=JPMC)




******************************************************/



declare @committed_status_id int
declare @dont_tally_salescode_id int
declare @inverted_price_style_id int

declare @trade_type varchar(25)
declare @trade_type_id int
declare @tally_type varchar(25)
declare @deal_type varchar(25)
declare @deal_id int
declare @deal_exec_symbol varchar(100)
declare @deal_type_id int
declare @deal_status_id int
declare @inverted char(1)
declare @broker varchar(25)
declare @mkt_trade_id int
declare @mkt_trade_identifier varchar(100)
declare @mkt_trader_login varchar(50)
declare @mkt_external_account varchar(25)
declare @mkt_external_account_id int
declare @mkt_external_account_type varchar(25)
declare @mkt_cpty_ext_acct_id int
declare @mkt_aggregation_style_id int
declare @mkt_aggregation_style varchar(25)
declare @mkt_counterparty varchar(25)
declare @mkt_counterparty_id int
declare @mkt_trader varchar(25)
declare @mkt_trader_id int
declare @mkt_qty1 numeric(30, 4)
declare @mkt_price float
declare @mkt_quoted_price float

declare @cli_trade_id int
declare @cli_trade_identifier varchar(100)
declare @cli_trader_login varchar(50)
declare @cli_external_account varchar(25)
declare @cli_external_account_id int
declare @cli_external_account_type varchar(25)
declare @cli_cpty_ext_acct_id int
declare @cli_aggregation_style_id int
declare @cli_aggregation_style varchar(25)
declare @cli_counterparty varchar(25)
declare @cli_counterparty_id int
declare @cli_trader varchar(25)
declare @cli_trader_id int
declare @cli_qty1 numeric(30, 4)
declare @cli_price float
declare @cli_quoted_price float

declare @spread_trade_id int
declare @lookup_trade_identifier varchar(100)
declare @lookup_trader_login varchar(50)
declare @lookup_external_account varchar(25)
declare @lookup_external_account_id int
declare @lookup_external_account_type varchar(25)
declare @lookup_cpty_ext_acct_id int
declare @lookup_aggregation_style_id int
declare @lookup_aggregation_style varchar(25)
declare @lookup_counterparty varchar(25)
declare @lookup_counterparty_id int
declare @lookup_trader_id int
declare @lookup_qty1 numeric(30, 4)
declare @lookup_price float
declare @lookup_quoted_price float


declare @mkt_lookup_cpty varchar(50)
declare @mkt_lookup_trader varchar(50)
declare @cli_lookup_cpty varchar(50)
declare @cli_lookup_trader varchar(50)
declare @lookup_cpty varchar(50)
declare @lookup_trader varchar(50)


declare @cli_tallied int
declare @mkt_tallied int
declare @spread_tallied int

declare @clientormarket varchar(1)

declare @default_login varchar(50)
declare @hotspot_queued_trade_id int
declare @trade_link_id int

declare @contract_id int

select
	@default_login = @agent

select
	@broker = "Hotspot",
	@trade_type = "Spot",
	@tally_type = "Spot"
	

/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end


if @side = "SELL"
begin
    select
        @qty1 = -@qty1
end

select 
	@contract_id = contract_id 
from 
	contracts 
where 
	symbol = @symbol
if @contract_id = NULL
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"

	declare @ccy1_determined varchar(3)
	declare @ccy2_determined varchar(3)

	select 
		@ccy1_determined =  substring(@symbol, 1, 3),
		@ccy2_determined = substring(@symbol, 5, 7)
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1_determined,
                	@ccy2_determined,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

	select 
        	@contract_id = contract_id
	from 
        	contracts 
	where 
        	symbol = @symbol
	if @contract_id = NULL
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end

/*
 | Determine if trade is inverted
 */


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = 'Y'
begin
	select 
		@inverted_price_style_id = c.price_style_id
	from
		contracts a,
		contract_price_styles b,
		price_styles c
	where
		a.contract_id = b.contract_id
	and
		b.price_style_id = c.price_style_id
	and
		a.contract_id = @contract_id
	and
		c.name = "Inverted"

	if @inverted_price_style_id = NULL
	begin
		insert into
        		contract_price_styles (
            			contract_id,
            			price_style_id,
            			factor
        			)
		values(
        		@contract_id,
			@inverted_price_style_id,
			1.0
			)
	end
end
    		

/* Check @spread - WD 7/18/14 */
if @spread = "N"
begin
	select 	
		@trade_link = "0"
end


/*
*--------------------------------------------------------------
*
* COMMISSION CLIENT -- 	NO SPREADING 
*			Recieve 1 Ticket, tally 2 trades
*--------------------------------------------------------------
*/
if @trade_link = "0" or @trade_link = NULL
begin

	select
		/* @deal_exec_symbol = @execution_id, 		chriso: move to order_id*/
		@deal_exec_symbol = @order_id + "_" + rtrim(convert(char(10), convert(datetime, @trade_date), 112)),
		@deal_type = "B2B Forward",
		@mkt_trade_identifier = rtrim(@execution_id)+".m",
		@mkt_lookup_cpty = @contra_broker,
		@mkt_lookup_trader = @target_comp,
		@mkt_price = @price,
		@mkt_qty1 = @qty1,
		@mkt_quoted_price = @price,
		@cli_trade_identifier = rtrim(@execution_id)+".c",
		@cli_lookup_cpty = @target_comp,
		@cli_lookup_trader = @trader,
		@cli_price = @price,
		@cli_qty1 = -@qty1, /* Reverse qty to correct client trade perspective */
		@cli_quoted_price = @price


	select
		@cli_trade_id = trade_id
	from
		trades
	where
		identifier = @cli_trade_identifier
	if @cli_trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Client trade is already tallied",
			trade_identifier = @cli_trade_identifier,
			lookup_cpty = @cli_lookup_cpty,
			lookup_trdr = @cli_lookup_trader,
			price = @cli_price,
			qty1 = @cli_qty1
	end
	
	
	select
		@mkt_trade_id = trade_id
	from
		trades
	where
		identifier = @mkt_trade_identifier
	if @mkt_trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Market trade is already tallied",
			trade_identifier = @mkt_trade_identifier,
                	lookup_cpty = @mkt_lookup_cpty,
                	lookup_trdr = @mkt_lookup_trader,
                	price = @mkt_price,
                	qty1 = @mkt_qty1
	end
	
	
	
	/*
 	,-------------------,
 	| CLIENT LOOKUPS    |
 	'-------------------'
	*/
	if @cli_trade_id  = NULL
	begin
		/*
 		* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 		*/ 
		
		select
			@cli_trader_id = a.trader_id,
			@cli_trader = a.symbol,
			@cli_trader_login = c.login,
			@cli_external_account_id = a.external_account_id
		from
        		traders a,
        		trader_symbols b,
        		sources ba,
        		tico_accounts c
		where    
        		a.trader_id = b.trader_id
		and
        		b.source_id = ba.source_id
		and
        		a.tico_account_id = c.account_id
		and
        		ba.name = @source
		and 
        		b.symbol = @cli_lookup_trader
		
		if @cli_trader_id = NULL or @cli_trader_login = NULL
		begin
    		select
            		@cli_trader_id = a.trader_id,
            		@cli_trader = a.symbol,
            		@cli_trader_login = c.login,
            		@cli_external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @cli_lookup_trader
		
    		if @cli_trader_id = NULL or @cli_trader_login = NULL
    		begin
			select
            		status = "Error",
            		message = "Couldn't find trader and user for @cli_lookup_trader, '" + @cli_lookup_trader + "'",
            		cli_lookup_trader = @cli_lookup_trader
        		return
    		end		
		end
		
		/*
 		* LOOKUP @cli_counterparty_id, @cli_counterparty_symbol, @cli_cpty_ext_acct_id from @cli_lookup_cpty
 		*/
		
		select
			@cli_counterparty_id = a.counterparty_id,
			@cli_counterparty = a.name,
			@cli_cpty_ext_acct_id = a.external_account_id
		from
        		counterparties a,
        		counterparty_symbols b,
        		sources ba
		where
        		a.counterparty_id = b.counterparty_id
		and
        		b.source_id = ba.source_id
		and
        		ba.name = @source
		and
        		b.symbol = @cli_lookup_cpty
		if @cli_counterparty = NULL
		begin
        		select
                		@cli_counterparty_id = a.counterparty_id,
				@cli_counterparty = a.name,
				@cli_cpty_ext_acct_id = a.external_account_id
        		from
                		counterparties a
        		where
                		a.name = @cli_lookup_cpty
        		
        		if @cli_counterparty = NULL
        		begin
                		select
                        		status = "Error",
                        		message = "Couldn't find counterparty for @cli_lookup_cpty, '" + @cli_lookup_cpty + "'",
					cli_lookup_cpty = @cli_lookup_cpty
                		return
        		end
		end
		
		
		/*
 		* LOOKUP @cli_external_account, @cli_external_account_type based on @cli_external_account_id
 		*/
		select
    			@cli_external_account = a.symbol,
    			@cli_external_account_type = b.name,
    			@cli_aggregation_style = c.name
		from
    			external_accounts a,
    			external_account_types b,
    			aggregation_styles c
		where
    			a.external_account_type_id = b.external_account_type_id
		and
    			a.aggregation_style_id = c.aggregation_style_id
		and
    			a.external_account_id = @cli_external_account_id
		if @cli_external_account = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find external_account from @cli_external_account_id",
				cli_external_account_id = @cli_external_account_id
			return
		end
	end
	
	/*
 	,-------------------,
 	| MARKET LOOKUPS    |
 	'-------------------'
	*/
	
	if @mkt_trade_id = NULL
	begin
		/*
 		* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 		*/ 
		
		select
			@mkt_trader_id = a.trader_id,
			@mkt_trader = a.symbol,
			@mkt_trader_login = c.login,
			@mkt_external_account_id = a.external_account_id
		from
        		traders a,
        		trader_symbols b,
        		sources ba,
        		tico_accounts c
		where    
        		a.trader_id = b.trader_id
		and
        		b.source_id = ba.source_id
		and
        		a.tico_account_id = c.account_id
		and
        		ba.name = @source
		and 
        		b.symbol = @mkt_lookup_trader
		
		if @mkt_trader_id = NULL or @mkt_trader_login = NULL
		begin
    		select
            		@mkt_trader_id = a.trader_id,
            		@mkt_trader = a.symbol,
            		@mkt_trader_login = c.login,
            		@mkt_external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @mkt_lookup_trader
		
    			if @mkt_trader_id = NULL or @mkt_trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @mkt_lookup_trader, '" + @mkt_lookup_trader + "'",
            			mkt_lookup_trader = @mkt_lookup_trader
        			return
    			end		
		end
		
		/*
 		* LOOKUP @mkt_counterparty_id, @mkt_counterparty_symbol, @mkt_cpty_ext_acct_id from @mkt_lookup_cpty
 		*/
		
		select
			@mkt_counterparty_id = a.counterparty_id,
			@mkt_counterparty = a.name,
			@mkt_cpty_ext_acct_id = a.external_account_id
		from
        		counterparties a,
        		counterparty_symbols b,
        		sources ba
		where
        		a.counterparty_id = b.counterparty_id
		and
        		b.source_id = ba.source_id
		and
        		ba.name = @source
		and
        		b.symbol = @mkt_lookup_cpty
		if @mkt_counterparty = NULL
		begin
        		select
                		@mkt_counterparty_id = a.counterparty_id,
				@mkt_counterparty = a.name,
				@mkt_cpty_ext_acct_id = a.external_account_id
        		from
                		counterparties a
        		where
                		a.name = @mkt_lookup_cpty
        		
        		if @mkt_counterparty = NULL
        		begin
                		select
                        		status = "Error",
                        		message = "Couldn't find counterparty for @mkt_lookup_cpty, '" + @mkt_lookup_cpty + "'",
					mkt_lookup_cpty = @mkt_lookup_cpty
                		return
        		end
		end
		
		
		/*
 		* LOOKUP/OVERWRITE @mkt_external_account, @mkt_external_account_type based on @mkt_cpty_ext_account_id
 		*/
		select
    			@mkt_external_account = a.symbol,
    			@mkt_external_account_type = b.name,
    			@mkt_aggregation_style = c.name
		from
    			external_accounts a,
    			external_account_types b,
   			aggregation_styles c
		where
    			a.external_account_type_id = b.external_account_type_id
		and
    			a.aggregation_style_id = c.aggregation_style_id
		and
    			a.external_account_id = @mkt_cpty_ext_acct_id
		if @mkt_external_account = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find external_account from @mkt_external_account_id",
				mkt_external_account_id = @mkt_external_account_id
			return
		end
	end
	
	
	
	select
		@deal_id = deal_id
	from
		deal_exec_symbols
	where
		symbol = @deal_exec_symbol
	
	
	if @deal_id = NULL
	begin
		select
			msg = "Creating new deal"
		
		select
			@deal_status_id = status_id
		from
			statuses
		where
			name = "User Review"
		if @deal_status_id = NULL
		begin
			select
				status = "Error",
				message = "No status found named, 'User Review'"
			return
		end
		select
			@deal_type_id = deal_type_id
		from
			deal_types
		where
			name = @deal_type
		if @deal_type_id = NULL
		begin
			select
				status = "Error",
				message = "No deal type found for @deal_type",
				deal_type = @deal_type
			return	
		end
	
		exec
			j_nextkey
				"deals",
				@deal_id output
	
		insert into
			deals(
				deal_id,   
				deal_type_id,
				timestamp,  
				status_id  
		 		)      
			values( 
				@deal_id,
				@deal_type_id,
				getdate(),
				@deal_status_id
				)
    	
    	insert into
			deal_exec_symbols
		values(
			@deal_id,
			@deal_exec_symbol
    	)
	end
	else
	begin
		select
			msg = "Appending to existing deal"
	
		/*  Below to support management of deal_type. 
	    	This tally is currently purposed for B2B deals. This will be inserted B2B */	
		/*
        	select
                	@deal_type_id = deal_type_id
        	from
                	deal_types
        	where
                	name = 'B2B Forward'
        	if @deal_type_id = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "No deal type found for 'B2B Forward'"
                	return
        	end
	
		update
			deals
		set
			deal_type_id = @deal_type_id
		where
			deal_id = @deal_id
		*/
	end
			
	if @cli_trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @cli_trader_login,
				@source = @source,
				@trade_id = @cli_trade_id out,
				@deal_id = @deal_id out,
				@tally_type = @tally_type,
				@deal_type = @deal_type,
				@trade_type = @trade_type,
				@external_account = @cli_external_account,
				@counterparty = @cli_counterparty,
				@quantity = @cli_qty1,
				@symbol = @symbol,
				@value_date = @value_date,
				@price = @cli_price,
				@trade_date = @trade_date,
				@trader = @cli_trader,
				@broker = @broker,
				@identifier = @cli_trade_identifier,
				@spot_reference = @cli_quoted_price
	
		if @cli_trade_id = NULL
		begin
			select
				status = "Error",
				message = "Failed to tally trade"
			return
		end

	
		insert into
			trade_quoted_prices (	trade_id,
						price)
			values(
				@cli_trade_id,
				@cli_quoted_price
				)
	
		exec
			r_inserttradenotification
						@cli_trade_id
		select
			@cli_tallied = 1
	end
	
	if @mkt_trade_id = NULL
	begin
		exec
        		fxa_tallytrade
                		@login = @mkt_trader_login,
                		@source = @source,
                		@trade_id = @mkt_trade_id out,
                		@deal_id = @deal_id out,
                		@tally_type = @tally_type,
                		@deal_type = @deal_type,
                		@trade_type = @trade_type,
                		@external_account = @mkt_external_account,
                		@counterparty = @mkt_counterparty,
                		@quantity = @mkt_qty1,
                		@symbol = @symbol,
                		@value_date = @value_date,
                		@price = @mkt_price,
                		@trade_date = @trade_date,
                		@trader = @mkt_trader,
                		@broker = @broker,
                		@identifier = @mkt_trade_identifier,
                		@spot_reference = @mkt_quoted_price
		
		if @mkt_trade_id = NULL
		begin
        		select
                		status = "Error",
                		message = "Failed to tally trade"
        		return
		end
		
		insert into
        		trade_quoted_prices (   trade_id,
                                		price)
        		values(
                		@mkt_trade_id,
                		@mkt_quoted_price
                		)
		
		exec
        		r_inserttradenotification
                                		@mkt_trade_id
		select
			@mkt_tallied = 1
	end


	/*
 	* AUTOCOMMIT
 	*
 	* If there is a client trade in this deal and the account type is set for
 	* Autocommit, then push through this deal automatically.
 	*/
	
	if @deal_id != NULL and @cli_trade_id != NULL and @cli_aggregation_style = "Autocommit"
	begin
	
    		update
        		deals
    		set
        		status_id = @committed_status_id
    		where
        		deal_id = @deal_id
    		if @@rowcount != 1
    		begin
        		select
            		status = "Error",
            		message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @cli_external_account + "', an aggregation style, '" + @cli_aggregation_style + "'"
    		end
	end
	else
	begin
    		select
        		message = "No autocommitted",
        		deal_id = @deal_id,
        		trade_id = @cli_trade_id,
        		aggregation_style = @cli_aggregation_style
	end
	
	if @cli_tallied != NULL
		select
        		status = "Tallied",
        		message = "Trade successfully tallied",
        		trade_id = @cli_trade_id,
        		deal_id = @deal_id,
        		account = @cli_external_account,
        		cpty = @cli_counterparty,
        		symbol = @symbol,
        		quantity = @cli_qty1,
        		price = @cli_price,
        		val_date = @value_date
	
	if @mkt_tallied != NULL
		select
        		status = "Tallied",
        		message = "Trade successfully tallied",
        		trade_id = @mkt_trade_id,
        		deal_id = @deal_id,
        		account = @mkt_external_account,
        		cpty = @mkt_counterparty,
        		symbol = @symbol,
        		quantity = @mkt_qty1,
        		price = @mkt_price,
        		val_date = @value_date


end	

/*
*--------------------------------------------------------------
*
* SPREAD CLIENT
*       Recieve 3 Tickets, 1 trade per ticket, tally 2 tickets
*       Note: Only Tally one ticket per proc call
*--------------------------------------------------------------
*/

if @trade_link != "0"
begin
        select
		/* @deal_exec_symbol = "TRD_" + @trade_link,       chriso: move from trade_link to order_id */
		@deal_exec_symbol = "ORD_" + @order_id + "_" + rtrim(convert(char(10), convert(datetime, @trade_date), 112)),
		@deal_type = "B2B Forward",
       		@lookup_trader = @trader
	
		
	/*
 	* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 	*/ 

	select
		@lookup_trader_id = a.trader_id,
		@lookup_trader = a.symbol,
		@lookup_trader_login = c.login,
		@lookup_external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	sources ba,
        	tico_accounts c
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = ba.source_id
	and
        	a.tico_account_id = c.account_id
	and
        	ba.name = @source
	and 
        	b.symbol = @lookup_trader
	
	if @lookup_trader_id = NULL or @lookup_trader_login = NULL
	begin
    		select
            		@lookup_trader_id = a.trader_id,
            		@lookup_trader = a.symbol,
            		@lookup_trader_login = c.login,
            		@lookup_external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @lookup_trader
		
    		if @lookup_trader_id = NULL or @lookup_trader_login = NULL
    		begin
			select
            		status = "Error",
            		message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            		lookup_trader = @lookup_trader
        		return
   		end	
	end
	select
		@clientormarket = "M"
	from	
		fund_agency_traders
	where
		trader_id = @lookup_trader_id
	if @clientormarket = NULL
		begin
			select 
				@clientormarket = "C"
		end
	
	
	if @clientormarket = "C"
		select
			@lookup_cpty = @target_comp,
                	@lookup_price = @price,
                	@lookup_trade_identifier = rtrim(@execution_id) + ".c",
                	@lookup_qty1 = -@qty1,
                	@lookup_quoted_price = @price
	
	if @clientormarket = "M"
		select 
			@lookup_cpty = @contra_broker,
                               @lookup_price = @price,
                               @lookup_trade_identifier = rtrim(@execution_id) + ".m",
                               @lookup_qty1 = @qty1,
                               @lookup_quoted_price = @price
			

	/*
 	* LOOKUP @lookup_counterparty_id, @lookup_counterparty_symbol, @lookup_cpty_ext_acct_id from @lookup_cpty
 	*/
	
	select
		@lookup_counterparty_id = a.counterparty_id,
		@lookup_counterparty = a.name,
		@lookup_cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b,
        	sources ba
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = ba.source_id
	and
        	ba.name = @source
	and
        	b.symbol = @lookup_cpty
	if @lookup_counterparty = NULL
	begin
        	select
                	@lookup_counterparty_id = a.counterparty_id,
			@lookup_counterparty = a.name,
			@lookup_cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
        	
        	if @lookup_counterparty = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
				lookup_cpty = @lookup_cpty
                	return
        	end
	end
	
	/*
 	* LOOKUP @lookup_external_account, @lookup_external_account_type based on @lookup_external_account_id
 	*/
	select
    		@lookup_external_account = a.symbol,
    		@lookup_external_account_type = b.name,
    		@lookup_aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @lookup_external_account_id
	if @lookup_external_account = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find external_account from @lookup_external_account_id",
			lookup_external_account_id = @lookup_external_account_id
		return
	end
               if @clientormarket = "M"
               begin
                       select
                               @lookup_external_account = symbol
                       from
                               external_accounts
                       where
                               external_account_id = @lookup_cpty_ext_acct_id
               end
		

	/*
	*  Insert into queued_hotspot_trades and hotspot_queue **
	*/

	
	select
                @hotspot_queued_trade_id = trade_id
        from
                trades
        where
                identifier = @lookup_trade_identifier

        if @hotspot_queued_trade_id != NULL
        begin
                select
                        status = "Dupe",
                        message = "Trade is already tallied",
                        trade_identifier = @lookup_trade_identifier,
                        lookup_cpty = @lookup_cpty,
                        lookup_trdr = @lookup_trader,
                        price = @lookup_price,
                        qty1 = @lookup_qty1
	end


	if @hotspot_queued_trade_id = NULL
	begin
	
		exec
			j_nextkey
				"hotspot_queued_trades",
				@hotspot_queued_trade_id output
				
		
	
		insert into
			hotspot_queue
		values(
			@trade_link,
			@hotspot_queued_trade_id
			)

	
		insert into
			hotspot_queued_trades
		values(
			@hotspot_queued_trade_id,
			@lookup_trader_login,
                	@source,
                	@tally_type,
                	@deal_type,
                	@trade_type,
                	@lookup_external_account,
                	@lookup_counterparty,
                	@lookup_qty1,
                	@symbol,
                	@value_date,
                	@lookup_price,
                	@trade_date,
                	@lookup_trader,
                	@broker,
                	@lookup_trade_identifier,
                	@lookup_price,
			@clientormarket,
			@deal_exec_symbol
			)


		select
        		status = "Trade Inserted Into Queued Trades",
        		queued_trade_id = @hotspot_queued_trade_id,
			trade_link = @trade_link,
        		account = @lookup_external_account,
        		cpty = @lookup_counterparty,
        		symbol = @symbol,
        		quantity = @lookup_qty1,
        		price = @lookup_price,
        		val_date = @value_date
	end


	exec
        	tt_processhotspottrades
                	@trade_link
		
end


