
create procedure
        tt_360ttally
                @agent varchar(50),
                @source varchar(50),
                @default_login varchar(50),
		@identifier_prefix varchar(50),
                @sender_comp varchar(50),
                @target_comp varchar(50),
		@on_behalf_of_comp_id varchar(50),
                @on_behalf_of_sub_id varchar(50),
		@deliver_to_comp_id varchar(50),
		@deliver_to_sub_id varchar(50),
                @account varchar(50), 
                @trade_date datetime,
                @execution_id varchar(50),
                @sec_ord_id varchar(50), /* references cover ticket */
                @sec_cl_ord_id varchar(50), /* references client ticket */
                @order_id varchar(50),
                @client_order_id varchar(50),
                @symbol varchar(50),
                @ccy1 varchar(10),
                @value_date datetime,
		@fixing_date datetime=NULL,
                @trade_date2 datetime=NULL,
                @side varchar(10),
                @qty1 numeric(30, 4),
                @price float,
                @last_qty float=NULL,
                @avg_price float=NULL,
                @order_qty2 float=NULL,
                @settle_date2 datetime=NULL,
                @last_px_2 float=NULL,
                @last_price float,
		@product_type varchar(25)


as

/*
select
	agent=@agent,
	source=@source,
	default_login=@default_login,
	identifier_prefix=@identifier_prefix,
	sender_comp=@sender_comp,
	target_comp=@target_comp,
	account=@account,
	trade_date=@trade_date,
	execution_id=@execution_id,
	order_id=@order_id,
	client_order_id=@client_order_id,
	symbol=@symbol,
	ccy1=@ccy1,
	value_date=@value_date,
	side=@side,
	qty1=@qty1,
	price=@price,
	ord_qty2=@ord_qty2,
	last_qty=@last_qty,
	avg_price=@avg_price,
	last_price=@last_price

*/
declare @committed_status_id int
declare @dont_tally_salescode_id int

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @broker varchar(25)
declare @counterparty varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @aggregation_style varchar(25)
declare @external_account_type varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @stnd_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_login varchar(50)
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int
declare @external_account_id int
declare @last_spot_rate float

declare @symbol_price_style varchar(15)
declare @ccy1_determined char(3)
declare @ccy2_determined char(3)

declare @clientormarket char(1)
declare @lookup_cpty varchar(50)
declare @lookup_trader varchar(50)

declare @tally_status varchar(15)
declare @tally_status_message varchar(25)

select
	@broker = "360T SST",
	@quoted_price = @price,
	@last_spot_rate = @price


/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

select
	@lookup_trader = @on_behalf_of_sub_id,
	@lookup_cpty = @deliver_to_comp_id
	
/*
 * LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 */

select
	@counterparty_id = a.counterparty_id,
	@counterparty = a.name,
	@cpty_ext_acct_id = a.external_account_id
from
        counterparties a,
        counterparty_symbols b,
        sources ba
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = ba.source_id
and
        ba.name = @source
and
        b.symbol = @lookup_cpty
if @counterparty = NULL
begin
        select
                @counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
        from
                counterparties a
        where
                a.name = @lookup_cpty
        
        if @counterparty = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
			lookup_cpty = @lookup_cpty
                return
        end
end


/*
 * MARK ticket at client or market trade
 */
if exists (select counterparty_id from fund_agency_counterparties where counterparty_id = @counterparty_id)
begin
	select
		@clientormarket = "C"
end
else 
begin
	select
		@clientormarket = "M"
end

if @clientormarket = "C"
begin
	select
		@lookup_trader = @on_behalf_of_comp_id
end


/*
else
begin
	select
		error = "ERROR",
		msg = "Problem determining client or market from fund_agency_counterparties"
	return
end
*/

	

/*
 * LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 */ 

select
	@trader_id = a.trader_id,
	@trader = a.symbol,
	@trader_login = c.login,
	@external_account_id = a.external_account_id
from
        traders a,
        trader_symbols b,
        sources ba,
        tico_accounts c
where    
        a.trader_id = b.trader_id
and
        b.source_id = ba.source_id
and
        a.tico_account_id = c.account_id
and
        ba.name = @source
and 
        b.symbol = @lookup_trader

if @trader_id = NULL or @trader_login = NULL
begin
    select
            @trader_id = a.trader_id,
            @trader = a.symbol,
            @trader_login = c.login,
            @external_account_id = a.external_account_id
    from
            traders a,
            tico_accounts c
    where    
            a.tico_account_id = c.account_id
    and 
            a.symbol = @lookup_trader

    if @trader_id = NULL or @trader_login = NULL
    begin
	select
            status = "Error",
            message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            lookup_trader = @lookup_trader
        return
    end		
end


/*
 * DETERMIN trade_type
 */
if @product_type = "FX-SPOT"
begin
	select
		@trade_type = "Spot"
end
else if @product_type in("FX-FWD", "FX-NDF")
begin
	select
		@trade_type = "Forward",
		@last_spot_rate = @avg_price /* avg price = spot rate from spec */
end
else if @product_type = "FX_SWAP"
begin
	select
		"Swap Trade"
end
/* 
 * DETERMINE other values based of client or market
 */

if @clientormarket = "C"  /* CLIENT */
begin
	select
		@trade_identifier = rtrim(@identifier_prefix) + @execution_id +".c",
		@deal_exec_symbol = rtrim(@identifier_prefix) + @execution_id,
                @deal_type = "B2B Forward",
		@qty1 = -@qty1 /* Flip qty because ticket is from perpective of client. So client BUY is really agency/fund SELL */
		/*@deal_lookup = @sec_ord_id*/

	select
       		@deal_id = deal_id
	from
       		deal_exec_symbols
	where
       		symbol = rtrim(@identifier_prefix) + @sec_ord_id
end

if @clientormarket = "M"  /* COUNTERPARTY */
begin
        select
                @trade_identifier = rtrim(@identifier_prefix) + @execution_id + ".m",
		@deal_exec_symbol = rtrim(@identifier_prefix) + @execution_id, 
                @deal_type = "B2B Forward"

        select
        	@deal_id = deal_id
	from
        	deal_exec_symbols
	where
        	symbol = rtrim(@identifier_prefix) + @sec_cl_ord_id

	
	/*
 	 * OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
 	 */ 
	select
		@external_account_id = @cpty_ext_acct_id
end


/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Couldn't find external_account from @external_account_id",
		external_account_id = @external_account_id
	return
end



/*
| 360T symbol is non standard. If user deals USD on EURUSD, we will see USDEUR.
| 
| The price is also non standard. Since fxa_tallytrade takes standard quotes, we
| need to invert to standard quoting if the contract is an invert
*/
select
	@symbol_price_style = a.name
from
	price_styles a,
	contract_price_styles b,
	contracts c
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = c.contract_id
and
	c.symbol = @symbol

if @symbol_price_style = "Inverted"
begin
	select
		@inverted = "Y",
		@price = 1/@price  /* price for 360T not standard quoted on inverts */
end
else
begin
	select
		@inverted = "N",
		@price = @price
end

select 
	@ccy1_determined =  substring(@symbol, 1, 3),
	@ccy2_determined = substring(@symbol, 4, 6)
select
	symbol = @symbol,
	ccy1_det = @ccy1_determined,
	ccy2_det = @ccy2_determined

if @ccy1 = @ccy2_determined
begin
	select
		@symbol = @ccy2_determined + @ccy1_determined

	if @side = "BUY"
	begin
		select
			@qty1 = -@qty1
	end
end
else if @ccy1 = @ccy1_determined
begin
	if @side = "SELL"
	begin
    		select
  		      @qty1 = -@qty1
	end
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"


	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1_determined,
                	@ccy2_determined,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 3 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/*
select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_exec_symbol
*/

if @deal_id = NULL
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    )
end
else
begin
	select
		msg = "Appending to existing deal"

	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = @deal_type
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for",
			deal_type = @deal_type
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
end
		
exec
	fxa_tallytrade
		@login = @trader_login,
		@source = @source,
		@trade_id = @trade_id out,
		@deal_id = @deal_id out,
		@tally_type = @trade_type,
		@deal_type = @deal_type,
		@trade_type = @trade_type,
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @qty1,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@trader = @trader,
		@broker = @broker,
		@identifier = @trade_identifier,
		@spot_reference = @last_spot_rate,
		@fixing_date=@fixing_date

if @trade_id = NULL
begin
	select
		status = "Error",
		message = "Failed to tally trade"
	select
		@tally_status = "Failed",
		@tally_status_message = "Failed to tally trade"
end
else
begin


	insert into
		trade_quoted_prices (	trade_id,
					price)
		values(
			@trade_id,
			@quoted_price
			)

	exec
		r_inserttradenotification
					@trade_id


	/* 
 	* AUTOCOMMIT
 	*
 	* If there is a client trade in this deal and the account type is set for
 	* Autocommit, then push through this deal automatically.
 	*/
	if @deal_id != NULL and @clientormarket="C" and @aggregation_style = "Autocommit"
	begin
	
    	update
        	deals
    	set
        	status_id = @committed_status_id
    	where
        	deal_id = @deal_id
    	if @@rowcount != 1
    	begin
        	select
            	status = "Error",
            	message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    	end
	end
	else
	begin
    	select
        	message = "No autocommitted",
        	deal_id = @deal_id,
        	trade_id = @trade_id,
        	aggregation_style = @aggregation_style
	end

	 select
                @tally_status = "Tallied",
                @tally_status_message = "Trade successfully tallied"

end

select
	status = @tally_status,
	message = @tally_status_message,
    	trade_id = @trade_id,
    	deal_id = @deal_id,
	account = @external_account,
	trader = @trader,
	counterparty = @counterparty,
	symbol = @symbol,
	side = @side,
	quantity = @qty1,
	price = @price,
	val_date = @value_date
/* ### DEFNCOPY: END OF DEFINITION */
