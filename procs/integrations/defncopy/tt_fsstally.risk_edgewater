
create procedure
	tt_fsstally
                @source varchar(50),
                @default_login varchar(50),
		@broker varchar(50),
                @sender_comp varchar(50),
                @target_comp varchar(50),
                @account varchar(50), 
                @transaction_time datetime,
                @trade_date datetime,
                @trading_day datetime,
                @execution_id varchar(100),
		@secondary_exec_id varchar(100),
		@exec_type varchar(50),
		@client_order_id varchar(50),
		@mm_entry_id varchar(50),
		@order_status varchar(50),
                @order_id varchar(100),
		@secondary_order_id varchar(100),
                @client_id varchar(50),
		@last_mkt varchar(50),
		@exec_firm varchar(50),
                @symbol varchar(50),
                @ccy1 varchar(10),
                @ccy2 varchar(10),
                @value_date datetime,
                @side varchar(10),
                @qty1 numeric(30, 4),
                @price float,
                @leaves_qty float=NULL,
                @cum_qty float=NULL,
                @last_price float


as

/*
select
	agent=@agent,
	source=@source,
	default_login=@default_login,
	identifier_prefix=@identifier_prefix,
	sender_comp=@sender_comp,
	target_comp=@target_comp,
	account=@account,
	exec_broker=@exec_broker,
	transaction_time=@transaction_time,
	trade_date=@trade_date,
	trading_day=@trading_day,
	execution_id=@execution_id,
	order_id=@order_id,
	client_order_id=@client_order_id,
	cfs_entity=@cfs_entity,
	cfs_entity_type=@cfs_entity_type,
	cfs_trade_link=@cfs_trade_link,
	symbol=@symbol,
	ccy1=@ccy1,
	ccy2=@ccy2,
	value_date=@value_date,
	side=@side,
	qty1=@qty1,
	qty2=@qty2,
	price=@price,
	ord_qty1=@ord_qty1,
	ord_qty2=@ord_qty2,
	leaves_qty=@leaves_qty,
	cum_qty=@cum_qty,
	last_qty=@last_qty,
	avg_price=@avg_price,
	last_price=@last_price
*/


declare @committed_status_id int
declare @dont_tally_salescode_id int
declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @counterparty varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @aggregation_style varchar(25)
declare @external_account_type varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_login varchar(50)
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int
declare @external_account_id int
declare @last_spot_rate float

declare @clientormarket char(1)
declare @lookup_cpty varchar(50)
declare @lookup_trader varchar(50)

declare @tally_status varchar(15)
declare @tally_status_message varchar(25)


declare @substring1 varchar(3)
declare @substring2 varchar(3)

declare @suppress_trade char(1)
declare @suppressed_trade_id int
declare @suppressed_deal_id int
declare @source_id int
declare @contract_id int

declare @trigger_symbol varchar(50)
declare @cl_create char(1)
declare @lp_create char(1)



declare @auto_b2b_deal_status_id int
declare @auto_b2b_deal_type_id int
declare @auto_b2b_deal_id int

declare @original_exec_id varchar(100)

declare @cli_lookup_trader varchar(50)
declare @cli_trader_id int
declare @cli_trader varchar(50)
declare @cli_trader_login varchar(50)
declare @cli_suppress_trade varchar(5)

declare @cli_counterparty_id int
declare @cli_counterparty varchar(50)
declare @cli_external_account_type varchar(50)
declare @cli_lookup_ctpy varchar(50)
declare @cli_lookup_cpty varchar(50)
declare @cli_external_account varchar(50)
declare @cli_external_account_id int

declare @mkt_trader_id int
declare @mkt_trader varchar(50)
declare @mkt_lookup_trader varchar(50)
declare @mkt_trader_login varchar(50)
declare @mkt_suppress_trade varchar(5)
declare @mkt_counterparty_id int
declare @mkt_counterparty varchar(50)
declare @mkt_lookup_cpty varchar(50)
declare @mkt_external_account varchar(50)
declare @mkt_external_account_id int
declare @cli_cpty_ext_acct_id int
declare @cli_aggregation_style varchar(50)
declare @mkt_lookup_ctpy varchar(50)
declare @mkt_cpty_ext_acct_id int
declare @mkt_external_account_type varchar(50)
declare @cli_trade_identifier varchar(50)
declare @mkt_aggregation_style varchar(50)
declare @mkt_trade_identifier varchar(50)
declare @cli_suppressed_trade_id int
declare @cli_trade_id int
declare @mkt_suppressed_trade_id int
declare @mkt_trade_id int



/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin	
	select
		error = "ERROR",
		msg = "source not found - " + @source
	return
end


declare @check_trader varchar(50)
declare @fund_agency_trader varchar(1)
declare @sub_account varchar(50)

select
	@check_trader = @client_id

if @check_trader = NULL
begin
	select
		@check_trader = @exec_firm,
		@client_id = @exec_firm
end

select
	@fund_agency_trader = "Y"
from
	traders a,
	fund_agency_traders b,
	trader_symbols c
where
	a.trader_id = b.trader_id
and
	a.trader_id = c.trader_id
and
	c.symbol = @check_trader
and
	c.source_id = @source_id

if @fund_agency_trader = "Y"
begin
	/* GUI TRADE */
	select
		@sub_account = @account,
		@mkt_lookup_trader= @client_id,
        	@mkt_lookup_cpty = @last_mkt
end
else
begin
	/* API TRADE */
	select
		@cli_lookup_trader = @client_id,
		@cli_lookup_cpty = @sender_comp,
		@mkt_lookup_trader= @target_comp,
		@mkt_lookup_cpty = @last_mkt
end

if @fund_agency_trader = "Y"
begin
	select
		"Trade Type" = "GUI/Desk Trade"
end
else
begin
	select
		"Trade Type" = "API/Client Trade"
end
	

if @cli_lookup_trader != NULL
begin
	/*
 	* LOOKUP Client @cli_trader_id, @cli_trader, @cli_trader_login, @cli_external_account_id 
 	*/ 
	declare @cli_trader_login_id int
	
	select
		@cli_trader_id = a.trader_id,
		@cli_trader = a.symbol,
		@cli_trader_login_id = a.tico_account_id,
		@cli_external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = @source_id
	and
        	b.symbol = @cli_lookup_trader
	if @cli_trader_id = NULL
	begin
    		select
            		@cli_trader_id = a.trader_id,
            		@cli_trader = a.symbol,
            		@cli_trader_login_id = a.tico_account_id,
            		@cli_external_account_id = a.external_account_id
    		from
            		traders a
    		where    
            		a.symbol = @cli_lookup_trader
    		if @cli_trader_id = NULL
    		begin
			select
            			status = "Error",
            			message = "Couldn't find trader and user for @cli_lookup_trader, '" + @cli_lookup_trader + "'",
            			lookup_trader = @cli_lookup_trader
        		return
    		end		
	end

	select
        	@cli_trader_login = login
	from
        	tico_accounts
	where
        	account_id = @cli_trader_login_id
	if @cli_trader_login = NULL
	begin
        	select
                	status = "Error",
                	message = "Problem determining login from trader",
                	trader = @cli_trader,
                	lookup_trader = @cli_lookup_trader
        	return
	end

	

	/* Check for Suppression on client side*/
	select 
		@cli_suppress_trade = "N"

	select
		@cli_suppress_trade = "Y"
	from
		suppression_symbols
	where
		source_id = @source_id 
	and
		symbol = @cli_lookup_trader


	/*
	* CHECK to see if this requires a manufactured B2B
	*/
	select 
		@cl_create = cl_create,
		@lp_create = lp_create
	from 
		ticket_creation_values 
	where 
		trigger_symbol = @cli_lookup_trader
	and
 		source_id = @source_id
	if @@rowcount != 0
	begin
       		select
               		@trigger_symbol = @cli_lookup_trader
	end


	/*
 	* LOOKUP Client @cli_counterparty_id, @cli_counterparty_symbol, @cli_cpty_ext_acct_id from @cli_lookup_cpty
 	*/

	select
		@cli_counterparty_id = a.counterparty_id,
		@cli_counterparty = a.name,
		@cli_cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = @source_id
	and
        	b.symbol = @cli_lookup_cpty
	if @cli_counterparty = NULL
	begin
        	select
                	@cli_counterparty_id = a.counterparty_id,
			@cli_counterparty = a.name,
			@cli_cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @cli_lookup_cpty
        	if @cli_counterparty = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @cli_lookup_cpty, '" + @cli_lookup_cpty + "'",
				lookup_cpty = @cli_lookup_cpty
                	return
        	end
	end

	/*
 	* LOOKUP @cli_external_account, @cli_external_account_type based on @cli_external_account_id
 	*/
	select
    		@cli_external_account = a.symbol,
    		@cli_external_account_type = b.name,
    		@cli_aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @cli_external_account_id
	if @cli_external_account = NULL
	begin
        	select
                	status = "Error",
                	message = "Couldn't find external_account from @cli_external_account_id",
                	external_account_id = @cli_external_account_id
        	return
	end
end

/*End Client Lookups */

/*
 * LOOKUP Market @mkt_trader_id, @mkt_trader, @mkt_trader_login, @mkt_external_account_id 
 */ 

declare @mkt_trader_login_id int

select
	@mkt_trader_id = a.trader_id,
	@mkt_trader = a.symbol,
	@mkt_trader_login_id = a.tico_account_id,
	@mkt_external_account_id = a.external_account_id
from
        traders a,
        trader_symbols b
where    
        a.trader_id = b.trader_id
and
        b.source_id = @source_id
and
        b.symbol = @mkt_lookup_trader
if @mkt_trader_id = NULL
begin
    select
            @mkt_trader_id = a.trader_id,
            @mkt_trader = a.symbol,
            @mkt_trader_login_id = a.tico_account_id,
            @mkt_external_account_id = a.external_account_id
    from
            traders a
    where    
            a.symbol = @mkt_lookup_trader
    if @mkt_trader_id = NULL
    begin
	select
            status = "Error",
            message = "Couldn't find trader and user for @mkt_lookup_trader, '" + @mkt_lookup_trader + "'",
            lookup_trader = @mkt_lookup_trader
        return
    end		
end

select
        @mkt_trader_login = login
from
        tico_accounts
where
        account_id = @mkt_trader_login_id
if @mkt_trader_login = NULL
begin
        select
                status = "Error",
                message = "Problem determining login from trader",
                trader = @mkt_trader,
                lookup_trader = @mkt_lookup_trader
        return
end



/* Check for Suppression on mktent side*/
select 
	@mkt_suppress_trade = "N"

select
	@mkt_suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id 
and
	symbol = @mkt_lookup_ctpy


/*
 * LOOKUP Client @mkt_counterparty_id, @mkt_counterparty_symbol, @mkt_cpty_ext_acct_id from @mkt_lookup_cpty
 */

select
	@mkt_counterparty_id = a.counterparty_id,
	@mkt_counterparty = a.name,
	@mkt_cpty_ext_acct_id = a.external_account_id
from
        counterparties a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id
and
        b.symbol = @mkt_lookup_cpty
if @mkt_counterparty = NULL
begin
        select
                @mkt_counterparty_id = a.counterparty_id,
		@mkt_counterparty = a.name,
		@mkt_cpty_ext_acct_id = a.external_account_id
        from
                counterparties a
        where
                a.name = @mkt_lookup_cpty
        if @mkt_counterparty = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find counterparty for @mkt_lookup_cpty, '" + @mkt_lookup_cpty + "'",
			lookup_cpty = @mkt_lookup_cpty
                return
        end

	/*
         * OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
        select
                @mkt_external_account_id = @mkt_cpty_ext_acct_id
         */

end

/*
 * LOOKUP @mkt_external_account, @mkt_external_account_type based on @mkt_cpty_ext_acct_id
 */

select
    @mkt_external_account = a.symbol,
    @mkt_external_account_type = b.name,
    @mkt_aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @mkt_cpty_ext_acct_id
if @mkt_external_account = NULL
begin
        select
                status = "Error",
                message = "Couldn't find external_account from @mkt_external_account_id",
                external_account_id = @mkt_external_account_id
        return
end

/*End market Lookups */


if @cli_lookup_trader != NULL
begin
	select
        	@cli_trade_identifier = rtrim(@execution_id) +convert(char(8), @trading_day, 112) + ".c",
        	@mkt_trade_identifier = rtrim(@execution_id) +convert(char(8), @trading_day, 112) + ".m",
        	@deal_exec_symbol = rtrim(@client_order_id),
        	@deal_type = "B2B Forward",
        	@trade_type = "Spot",
        	@qty1 = -@qty1 /*  Flip qty because ticket is from perpective of client. So client BUY is really agency/fund SELL */
end
else
begin
	select 
		@mkt_trade_identifier = rtrim(@execution_id) +convert(char(8), @trading_day, 112) + ".m",
                @deal_exec_symbol = rtrim(@client_order_id),
                @deal_type = "Market Forward",
                @trade_type = "Spot"
end

	


if @side = "SELL"
begin
    select
        @qty1 = -@qty1
end

declare @mkt_qty1 numeric(30,4)

select
	@mkt_qty1 = @qty1 * -1



/* They provide CCY1, check for inverted pair */
if @ccy1 != NULL and @ccy2 = NULL
begin
	select
		@substring1 = substring(@symbol, 1, 3),
		@substring2 = substring(@symbol, 4, 6)
	
	if @substring1 != @ccy1
	begin
		select
			@symbol = @substring2 + @substring1,
			@inverted = "Y"
	end
	
end



select
        @contract_id = contract_id
from
        contracts
where
        symbol = @symbol

if @contract_id = NULL
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1,
                	@ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 3 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
			message = "Contract not found",
                        symbol=@symbol
                return
        end
        select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end


select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_exec_symbol

if @deal_id = NULL
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    )
end
else if @deal_id != NULL
begin
	select
		msg = "Appending to existing deal"

	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = @deal_type
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for",
			deal_type = @deal_type
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
end

if @cli_suppress_trade = "Y"
begin
exec
	fxa_suppresstrade	
                @login = @default_login,
                @source = @source,
                @suppressed_trade_id = @cli_suppressed_trade_id out,
                @deal_id = @suppressed_deal_id out,
		@deal_identifier = @deal_exec_symbol,
                @tally_type = @trade_type,
                @deal_type = @deal_type,
                @trade_type = @trade_type,
                @external_account = @cli_external_account,
                @counterparty = @cli_counterparty,
                @quantity = @qty1,
                @symbol = @symbol,
                @value_date = @value_date,
                @price = @price,
                @trade_date = @trade_date,
                @trader = @cli_trader,
                @broker = @broker,
      		@identifier = @cli_trade_identifier,
                @spot_reference = @price
	if @suppressed_trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to suppress trade"
        end
        select
                status = "Suppressed",
                message = "Trade successfully suppressed",
                trade_id = @suppressed_trade_id,
                deal_id = @suppressed_deal_id,
                account = @cli_external_account,
                symbol = @symbol,
                quantity = @qty1,
                price = @price,
                val_date = @value_date
        return
end

if @cli_lookup_trader != NULL
begin
	exec
		fxa_tallytrade
			@login = @cli_trader_login,
			@source = @source,
			@trade_id = @cli_trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @trade_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @cli_external_account,
			@counterparty = @cli_counterparty,
			@quantity = @qty1,
			@symbol = @symbol,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @cli_trader,
			@broker = @broker,
			@identifier = @cli_trade_identifier,
			@spot_reference = @price


	if @cli_trade_id = NULL
	begin
		select
			status = "Error",
			message = "Failed to tally trade"
		select
			@tally_status = "Failed",
			@tally_status_message = "Failed to tally trade"
	end
end

if @cli_trade_id != NULL
begin

	exec
		r_inserttradenotification
			@cli_trade_id

	/* Generally, we should not be creating new tickets if we are suppressing the trade above*/
	if @cl_create = "Y" or @lp_create = "Y"
	begin
		if @cl_create = "Y"
		begin
			declare @t2_cl_ext_account varchar(50)
			declare @t2_cl_trader varchar(50)
			declare @t2_cl_counterparty varchar(50)
			declare @t2_cl_trade_id int
			declare @t2_cl_identifier varchar(100)
			declare @t2_cl_quantity numeric(30, 4)
			declare @t2_cl_inv_qty char(1)
				
			select
				@t2_cl_ext_account = cl_ext_account,
				@t2_cl_trader = cl_trader,
				@t2_cl_counterparty = cl_counterparty,
				@t2_cl_inv_qty = cl_inv_qty
			from
				ticket_creation_values
			where
	        		trigger_symbol = @trigger_symbol
	
			select
				@t2_cl_identifier = rtrim(@cli_trade_identifier)+".t2cl_autob2b",
                       		@t2_cl_quantity = @qty1
	
				
			if @t2_cl_inv_qty = "Y"
			begin
				select
					@t2_cl_quantity = -@qty1 
			end
	
			exec
				fxa_tallytrade
					@login = @trader_login,
					@source = @source,
					@trade_id = @t2_cl_trade_id out,
					@deal_id = @deal_id out,
					@tally_type = @trade_type,
					@deal_type = @deal_type,
					@trade_type = @trade_type,
					@external_account = @t2_cl_ext_account,
					@counterparty = @t2_cl_counterparty,
					@quantity = @t2_cl_quantity,
					@symbol = @symbol,
					@value_date = @value_date,
					@price = @price,
					@trade_date = @trade_date,
					@trader = @t2_cl_trader,
					@broker = @broker,
					@identifier = @t2_cl_identifier,
					@spot_reference = @last_spot_rate
	
	
			if @t2_cl_trade_id = NULL
			begin
    				select
       					status = "Error",
       					message = "Failed to tally trade"
    				return
			end
		
	
			exec
   					r_inserttradenotification
       						@t2_cl_trade_id
	
			select
       				status = "Tallied",
       				message = "Trade successfully tallied",
       				trade_id = @t2_cl_trade_id,
       				deal_id = @deal_id,
       				account = @t2_cl_ext_account,
       				symbol = @symbol,
       				quantity = @t2_cl_quantity,
       				price = @price,
       				val_date = @value_date
 	
			
	
		end
		if @lp_create = "Y"
		begin
        		declare @t2_lp_ext_account varchar(50)
               		declare @t2_lp_trader varchar(50)
               		declare @t2_lp_counterparty varchar(50)
               		declare @t2_lp_trade_id int
               		declare @t2_lp_identifier varchar(100)
               		declare @t2_lp_quantity numeric(30, 4)
			declare @t2_lp_inv_qty char(1)
                	declare @t2_deal_id int
	
               		select
                       		@t2_lp_ext_account = lp_ext_account,
                       		@t2_lp_trader = lp_trader,
                       		@t2_lp_counterparty = lp_counterparty,
				@t2_lp_inv_qty = lp_inv_qty
               		from
                       		ticket_creation_values
               		where
                       		trigger_symbol = @trigger_symbol
	
               		select
                       		@t2_lp_identifier = rtrim(@cli_trade_identifier)+".t2lp_autob2b",
				@t2_lp_quantity = @qty1

			if @t2_lp_inv_qty = "Y"
               		begin
                       		select
                               		@t2_lp_quantity = -@qty1
               		end
			
			if @cl_create = "Y"
			begin
				select
					@t2_deal_id = @auto_b2b_deal_id
			end
			else
			begin
				select
					@t2_deal_id = @deal_id
			end
               		exec
                       		fxa_tallytrade
                               		@login = @trader_login,
                               		@source = @source,
                               		@trade_id = @t2_lp_trade_id out,
                               		@deal_id = @t2_deal_id out,
                               		@tally_type = @trade_type,
                               		@deal_type = @deal_type,
                               		@trade_type = @trade_type,
                               		@external_account = @t2_lp_ext_account,
                               		@counterparty = @t2_lp_counterparty,
                               		@quantity = @t2_lp_quantity,
                               		@symbol = @symbol,
                               		@value_date = @value_date,
                               		@price = @price,
                               		@trade_date = @trade_date,
                               		@trader = @t2_lp_trader,
                               		@broker = @broker,
                               		@identifier = @t2_lp_identifier,
                               		@spot_reference = @last_spot_rate
	
	
               		if @t2_lp_trade_id = NULL
               		begin
                       		select
                               		status = "Error",
                               		message = "Failed to tally trade"
                       		return
               		end
	
	
               		exec
                       		r_inserttradenotification
                               		@t2_lp_trade_id
	
               		select
                       		status = "Tallied",
                       		message = "Trade successfully tallied",
                       		trade_id = @t2_lp_trade_id,
                       		deal_id = @t2_deal_id,
                       		account = @t2_lp_ext_account,
                       		symbol = @symbol,
                       		quantity = @t2_lp_quantity,
                       		price = @price,
                       		val_date = @value_date
	
		end
	end
	

	/* 
 	* AUTOCOMMIT
 	*
 	* If there is a client trade in this deal and the account type is set for
 	* Autocommit, then push through this deal automatically.
	if @deal_id != NULL and @clientormarket="C" and @aggregation_style = "Autocommit"
	begin
	
    	update
        	deals
    	set
        	status_id = @committed_status_id
    	where
        	deal_id = @deal_id
    	if @@rowcount != 1
    	begin
        	select
            	status = "Error",
            	message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    	end
	end
	else
	begin
    	select
        	message = "No autocommitted",
        	deal_id = @deal_id,
        	trade_id = @trade_id,
        	aggregation_style = @aggregation_style
	end

 	*/
	 select
                @tally_status = "Tallied",
                @tally_status_message = "Trade successfully tallied"


	select
		status = @tally_status,
		message = @tally_status_message,
