select
	#trade_output.status, #trade_output.ttype, #trade_output.trade_id, #trade_output.deal_id, #trade_output.ext_acct, #trade_output.cpty, #trade_output.ct, #trade_output.qty, #trade_output.price, #trade_output.trader, #trade_output.identifier, #trade_output.vald                                                                                                                                                                                              
from
	#trade_output

/*
 * Acknoweldge this trade report
 */
select
    trade_report_id=@trade_report_id,
    symbol="NA"


