
create procedure
	tt_currenex11tally
        	@agent varchar(50),
        	@source varchar(50),
        	@cli_source varchar(50),
        	@default_login varchar(50),
		/*@connection_broker varchar(50),*/
        	
        	/*@prime_broker varchar(50),*/
        	
        	@trade_report_id varchar(50),
        	/* @exec_id varchar(50), */
        	@trade_id varchar(50),
        	@trade_request_id varchar(50),
        	@trade_type varchar(10),
        	@trade_match_id varchar(50),
        	@secondary_exec_id varchar(50),
        	@previously_reported char(1),
        	@exec_type varchar(15),
        	@exec_firm varchar(50),
        	@exec_trader varchar(50),
        	@order_orig_firm varchar(50),
        	@order_orig_trader varchar(50),
        	@giveup_clearing_firm varchar(50),
        	@intermediary_firm varchar(50),
        	@intermediary_trader varchar(50),
        	@symbol varchar(50),
		@leg_side varchar(50),
		@leg_currency varchar(50),
        	@symbol_suffix varchar(15),
        	@product varchar(15),
        	@quantity numeric(30,6),
        	@price float,
        	@calc_ccy_last_qty float,
        	@currency varchar(5),
        	@settle_currency varchar(5),
        	@spot_ref float,
        	@trade_date datetime,
        	
        	@leg1_price float,
        	@leg1_qty numeric(30,6),
        	@leg1_report_id varchar(50),
        	@leg1_exec_firm varchar(50),
        	@leg1_exec_trader varchar(50),
        	@leg1_order_orig_firm varchar(50),
        	@leg1_order_orig_trader varchar(50),
        	@leg1_giveup_clearing_firm varchar(50),
        	@leg1_intermediary_firm varchar(50),
        	@leg1_intermediary_trader varchar(50),
        	@leg1_forward_points float,
        	@leg1_calc_ccy_last_qty float,
        	@leg1_last_qty numeric(30,6),
        	@leg1_last_swap_points float,
        	@leg1_calc_ccy_last_qty2 float,
        	
        	@leg2_price float,
        	@leg2_qty numeric(30,6),
        	@leg2_report_id varchar(50),
        	@leg2_exec_firm varchar(50), /* In 11.0 release, non null when FXTrades */
        	@leg2_exec_trader varchar(50), /* In 11.0 release, non null when FXTrades */
        	@leg2_order_orig_firm varchar(50),
        	@leg2_order_orig_trader varchar(50),
        	@leg2_giveup_clearing_firm varchar(50),
        	@leg2_intermediary_firm varchar(50),
        	@leg2_intermediary_trader varchar(50),
        	@leg2_forward_points float,
        	@leg2_calc_ccy_last_qty float,
        	@leg2_last_qty numeric(30,6),
        	@leg2_last_swap_points float,
        	@leg2_calc_ccy_last_qty2 float,
        	
        	@transact_date datetime,
        	@value_date datetime,
        	@side varchar(5),
        	@cl_order_id varchar(50),
        	@account varchar(50),
        	@alloc_account varchar(50),
        	@alloc_id varchar(50),
        	@alloc_qty numeric(30,6),
        	@secondary_alloc_id varchar(50),
        	@alloc_side varchar(5),
        	@alloc_settle_date datetime,
        	@alloc_points float,
        	@alloc_calc_qty numeric(30,6),
        	@alloc_qty2 numeric(30,6),
        	@alloc_calc_far_qty numeric(30,6),
        	@aggressor varchar(15),
        	@order_qty2 numeric(30,6),
        	@far_date datetime,
        	@last_swap_points numeric(30, 10),
        	@calc_ccy_last_qty2 numeric(30,6),
		@invert_leg_currency varchar(1)=NULL
as





	
/*
 * https://ourwiki.elysiumtechgroup.com/projects/fxa-faros/wiki/Currenex_Trades
 *
 *  1. Client B2B ESP spot client ticket
 *  2. Client B2B ESP spot street ticket
 *  3. Street ESP spot
 *  4. Client B2B RFQ spot client ticket
 *  5. Client B2B RFQ spot street ticket
 *  6. Street RFQ spot street ticket
 *  7. Client B2B RFQ forward client ticket
 *  8. Client B2B RFQ forward street ticket
 *  9. Street RFQ forward street ticket
 * 10. Client B2B RFQ swap client ticket
 * 11. Client B2B RFQ swap street ticket
 * 12a. Street RFQ swap street ticket
 * 12b. Street RFQ swap street ticket - Customer Defined Next Day
 * 13. Client B2B RFQ NDF client ticket \__- 
 * 14. Client B2B RFQ NDF street ticket /  
 * 15. Street RFQ NDF street ticket
 *
 *                 +------+---------------------------------+
 *                 | ESP  | RFQ                             |
 *                 +------+------+---------+----------+-----+
 *                 | Spot | Spot | Forward |   Swap   | NDF |
 * +------+--------+------+------+---------+----------+-----+
 * | B2B  | Client | 1    | 4    | 7       | 10       | 13  |
 * |      +--------+------+------+---------+----------+-----+
 * |      | Street | 2    | 5    | 8       | 11       | 14  |
 * +------+--------+------+------+---------+----------+-----+
 * | Desk | Street | 3    | 6    | 9       | 12a/12b  | 15  |
 * +------+--------+------+------+---------+----------+-----+
 *
 */
 
declare @committed_status_id int

declare @external_account_id int
declare @external_account_type varchar(25)
declare @quote_symbol varchar(50)
declare @trd_symbol varchar(50)
declare @mkt_trd_symbol varchar(50)
declare @inv_symbol varchar(50)
declare @mkt_inv_symbol varchar(50)
declare @inverted char(1)
declare @sign int
declare @trd_trade_date datetime
declare @trd_broker varchar(25)
declare @trd_spot_ref float

/*declare @prime_broker_id int*/

declare @tkt_qty numeric(30,4)
declare @leg_qty numeric(30,4)
declare @far_qty numeric(30,4)
declare @tkt_price float
declare @leg_price float
declare @far_price float

declare @trd_deal_id int
declare @trd_deal_type varchar(25)
declare @trd_tally_type varchar(25)
declare @leg1_exec_firm_type varchar(25)
    
declare @cli_lookup_trader varchar(50)
declare @cli_lookup_counterparty varchar(50)
declare @cli_lookup_external_account varchar(50)

declare @cli_user varchar(50)
declare @cli_trader varchar(50)
declare @cli_sales_code varchar(25)
declare @cli_counterparty varchar(50)
declare @cli_external_account varchar(50)
declare @cli_external_account_type varchar(25)
declare @cli_aggregation_style varchar(25)
declare @cli_trade_id int
declare @cli_trade_type varchar(25)
declare @cli_trade_status varchar(25)
declare @cli_value_date datetime
declare @cli_price float
declare @cli_qty numeric(30,4)
declare @cli_identifier varchar(50)
declare @cli_far_trade_id int
declare @cli_far_trade_type varchar(25)
declare @cli_far_date datetime
declare @cli_far_price float
declare @cli_far_qty numeric(30,4)
declare @cli_far_identifier varchar(50)

declare @mkt_lookup_trader varchar(50)
declare @mkt_lookup_counterparty varchar(50)
declare @mkt_lookup_external_account varchar(50)

declare @mkt_user varchar(50)
declare @mkt_trader varchar(50)
declare @mkt_counterparty varchar(50)
declare @mkt_external_account varchar(50)
declare @mkt_trade_id int
declare @mkt_trade_type varchar(25)
declare @mkt_value_date datetime
declare @mkt_price float
declare @mkt_qty numeric(30,4)
declare @mkt_identifier varchar(50)
declare @mkt_far_trade_id int
declare @mkt_far_trade_type varchar(25)
declare @mkt_far_date datetime
declare @mkt_far_price float
declare @mkt_far_qty numeric(30,4)
declare @mkt_far_identifier varchar(50)

declare @external_account_type_id int

declare @order_orig_trader_sales_code varchar(50)
declare @leg1_exec_trader_sales_code varchar(50)
declare @b2b_fwd_deal_type_id int
declare @deal_status_id int

declare @sql varchar(250)

declare @client_swap_symbol_id int
declare @client_swap_symbol varchar(50)
declare @market_swap_symbol_id int
declare @market_swap_symbol varchar(50)

/* 
   @check_suppress_cli is for the LEGACY way of processing with salescode=DONT TALLY
   @suppress_client_trade is for using the table suppressed_symbols and calling fxa_suppresstrade
*/
declare @check_suppress_cli char(1)
declare @suppress_client_trade char(1)
declare @suppressed_cli_trade_id int
declare @suppressed_cli_deal_id int
declare @cli_far_suppress_trade_id int

declare @source_id int

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin	
	select
		error = "ERROR",
		msg = "source not found - " + @source
	return
end


/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

/*
 * LOOKUP @external_account_id, @external_account_type based on @account
 */

select
    @external_account_id = a.external_account_id,
    @external_account_type = b.name
from
    external_accounts a,
    external_account_types b,
    external_account_symbols c,
    sources ca
where
    a.external_account_type_id = b.external_account_type_id
and
    a.external_account_id = c.external_account_id
and
    c.source_id = ca.source_id
and
    ca.name = @source
and
    c.symbol = @account
    
if @external_account_id = NULL
begin
    select
        @external_account_id = a.external_account_id,
        @external_account_type_id = a.external_account_type_id
    from
        external_accounts a
    where
        a.symbol = @account
    or
        a.name = @account

    select
        @external_account_type = a.name
    from
        external_account_types a
    where
        a.external_account_type_id = @external_account_type_id
end

/*
 * LOOKUP @leg1_exec_firm_type = "Agency", NULL
 */
if exists (
    select
        *
    from
        counterparty_symbols a,
        sources aa,
        fund_agency_counterparties b
    where
        a.source_id = aa.source_id
    and
        a.counterparty_id = b.counterparty_id
    and
        aa.name = @source
    and
        a.symbol = @leg1_exec_firm
) or exists (
    select
        *
    from
        counterparties a,
        fund_agency_counterparties b
    where
        a.counterparty_id = b.counterparty_id
    and
        a.name = @leg1_exec_firm
)
begin
    select
        @leg1_exec_firm_type = "Agency"
end



/* DEBUG */
select 
	external_account_id = @external_account_id,
	external_account_type = @external_account_type,
	source = @source,
	account = @account,
    leg1_exec_firm_type = @leg1_exec_firm_type
/* END DEBUG */


if @external_account_id = NULL
begin
    select
        status = "Error",
        message = "Couldn't find external account for @account, '" + @account + "'",
        account = @account
    return
end


/*
 * Determine the common trade attributes
 */
select
    @quote_symbol = substring(@symbol, 1, 3) + substring(@symbol, 5, 3),
    @trd_symbol = @currency + @settle_currency,
    @inv_symbol = @settle_currency + @currency,
    @mkt_trd_symbol = @currency + @settle_currency,
    @mkt_inv_symbol = @settle_currency + @currency


if @invert_leg_currency = "N"
begin
	if @leg_currency = @currency
	begin
		select
			@mkt_trd_symbol = @currency + @settle_currency,
			@mkt_inv_symbol = @settle_currency + @currency
	end
	
	if @leg_currency = @settle_currency
	begin
		select
			@mkt_trd_symbol = @settle_currency + @currency,
			@mkt_inv_symbol = @currency + @settle_currency
	end
end

	

if not exists(select contract_id from contracts where symbol = @trd_symbol)
begin
	select
		message = "Contract not found",
		contract = @trd_symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @trd_symbol,
                        @currency,
                	@settle_currency,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:01.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@trd_symbol
                return
        end
	select "Contract Successfully Created"
end

select
    @inverted = case when @quote_symbol = @inv_symbol then "Y" else "N" end,
    @sign = case @side when "SELL" then -1 else 1 end,
    @trd_trade_date = @transact_date,
    @trd_broker = "Currenex",
    @trd_spot_ref = @spot_ref,
    @cli_trade_status = "User Review"

/*if @connection_broker != NULL
begin
	select
mkt_		@trd_broker = @connection_broker
end*/


/* 
 * INSERT contract_price_styles if this contract is inverted and we don't have
 * any contract price styles set up yet.
 */
if @inverted = "Y" and not exists(
    select
        c.*
    from
        contracts a,
        contract_price_styles b,
        price_styles c
    where
        a.contract_id = b.contract_id
    and
        b.price_style_id = c.price_style_id
    and
        a.symbol = @trd_symbol
    and
        c.name = "Inverted"
)
begin
    
    insert into
        contract_price_styles (
            contract_id,
            price_style_id,
            factor
        )
    select
        a.contract_id,
        b.price_style_id,
        1.0
    from
        contracts a,
        price_styles b
    where
        a.symbol = @trd_symbol
    and
        b.name = "Inverted"
    
end

/* KLS: There's no need to invert since fxa_tallytrade does it already */
/* if @inverted != "Y" */
    select
        @tkt_price = @price,
        @leg_price = @leg1_price,
        @far_price = @spot_ref + @leg1_last_swap_points,
        @tkt_qty = @quantity * @sign,
        @leg_qty = @leg1_qty * @sign,
        @far_qty = @leg1_last_qty * @sign * -1

    /*
     * KLS: Thu Jun  9 11:47:02 CDT 2011
     * +3   To support M13 message type.
     */
    if @far_qty = NULL
        select
            @far_qty = @order_qty2 * @sign * -1

/* else
    select
        @tkt_price = 1 / @price,
        @leg_price = 1 / @leg1_price,
        @far_price = 1 / (@price + @leg1_last_swap_points),
        @tkt_qty = @quantity / @price * @sign,
        @leg_qty = @leg1_qty / @leg1_price * @sign */

/*
 * One of the following cases:
 *  1. Client B2B ESP spot client ticket
 *  2. Client B2B ESP spot street ticket
 *  3. Street ESP spot
 */
if      @trade_type = "ESP" and @symbol_suffix = "SPOT"
begin
    
    /*
     *  1. Client B2B ESP spot client ticket
     *  2. Client B2B ESP spot street ticket
     */
    if @leg1_qty != NULL
    begin
        
        select
            @trd_deal_type = "B2B Forward",
            @trd_tally_type = "Spot",

            @cli_lookup_trader = @order_orig_trader,
            @cli_lookup_counterparty = @intermediary_firm,
            @cli_lookup_external_account = @order_orig_firm,
            @cli_trade_type = "Spot",
            @cli_value_date = @value_date,
            @cli_price = @tkt_price,
            @cli_qty = -@tkt_qty,
            @cli_identifier = @trade_id + ".c",
            @cli_trade_status = NULL /* Default to aggregation_style */,
            @mkt_lookup_trader = @leg1_intermediary_trader,
            @mkt_lookup_counterparty = @leg1_exec_firm,
            @mkt_trade_type = "Spot",
            @mkt_value_date = @value_date,
            @mkt_price = @leg_price,
            @mkt_qty = @leg_qty,
            @mkt_identifier = @trade_id + ".m"

        if @leg2_exec_firm = "FXTrades"
        begin
		select 
			@mkt_lookup_counterparty = @leg2_exec_firm,
			@mkt_lookup_trader = @leg2_exec_firm
                select
			@check_suppress_cli = "Y"
	end	
	else if @leg1_exec_firm = "FXTrades"
	begin
		select
			@mkt_lookup_counterparty  = @leg1_exec_firm,
			@mkt_lookup_trader = @order_orig_trader
                /* Supress client ticket */
                select
			@check_suppress_cli = "Y"
	end

	if @check_suppress_cli = "Y"
	begin
		/* lookup FXTrades trader, if desk, then set  @cli_qty = NULL to suppress client ticket */
		select
			@cli_trader = a.symbol
		from
			traders a,
			trader_symbols b,
			fund_agency_traders c,
			sources d
		where
			a.trader_id = b.trader_id
		and
			b.trader_id = c.trader_id
		and
			b.source_id = d.source_id
		and
			b.symbol = @cli_lookup_trader
		and
			d.name = @source
		if @cli_trader = NULL
		begin
			select
				@cli_trader = a.symbol
			from
				traders a,
				fund_agency_traders c
			where
				a.trader_id = c.trader_id
			and
				a.symbol =  @cli_lookup_trader
		end
		if @cli_trader != NULL
		begin
			/* Supress client ticket */
			select
				@cli_qty= NULL 
		end
	end
    end
    /*
     *  3. Street ESP spot
     */
    else
    begin
        
        select
            @trd_deal_type = "Market Forward",
            @trd_tally_type = "Spot",

            @mkt_lookup_trader = @order_orig_trader,
            @mkt_lookup_counterparty = @exec_firm,
            @mkt_trade_type = "Spot",
            @mkt_value_date = @value_date,
            @mkt_price = @tkt_price,
            @mkt_qty = @tkt_qty,
            @mkt_identifier = @trade_id

        /*if @exec_firm = NULL and  @giveup_clearing_firm != NULL*/
        if @leg2_exec_firm != NULL
	begin
		if @leg2_exec_firm = "FXTrades"
        	begin
			select 
				@mkt_lookup_counterparty = @leg2_exec_firm
		end
		else
		begin
			select 
				 @mkt_lookup_counterparty = @leg1_exec_firm 
		end
	end

    end
    
end
/*
 * One of the following cases:
 *  4. Client B2B RFQ spot client ticket
 *  5. Client B2B RFQ spot street ticket
 *  6. Street RFQ spot street ticket
 */
else if @trade_type = "RFQ" and @symbol_suffix = "SPOT"
begin

    /*
     *  Ticket #5: Client B2B RFQ spot client ticket
     *    Trade a: Client:
     *    Trade b: Street
     */
    if @external_account_type in("Client", "Master", "Managed")  and @leg1_exec_firm_type != "Agency"
    begin
        
        select
            @trd_deal_type = "B2B Forward",
            @trd_tally_type = "Spot",
            
            @cli_lookup_external_account = @order_orig_firm,
            @cli_lookup_trader = @order_orig_trader,
            @cli_lookup_counterparty = @intermediary_firm,
            @cli_trade_type = "Spot",
            @cli_value_date = @value_date,
            @cli_price = @tkt_price,
            @cli_qty = -@tkt_qty,
            @cli_identifier = @trade_id + ".c",
        
            @mkt_lookup_trader = @order_orig_trader,
            @mkt_lookup_counterparty = @leg1_exec_firm,
            @mkt_trade_type = "Spot",
            @mkt_value_date = @value_date,
            @mkt_price = @leg_price,
            @mkt_qty = @leg_qty,
            @mkt_identifier = @trade_id + ".m"
        
    end
    /*
     *  4. Client B2B RFQ spot client ticket
     */
    else if @external_account_type in("Client", "Master","Managed")
    begin
        
        select
            @trd_deal_type = "Client Forward",
            @trd_tally_type = "Forward",

            @cli_lookup_trader = @order_orig_trader,
            @cli_lookup_counterparty = @intermediary_firm,
            @cli_lookup_external_account = @order_orig_firm,
            @cli_trade_type = "Spot",
            @cli_value_date = @value_date,
            @cli_price = @tkt_price,
            @cli_qty = -@tkt_qty,
            @cli_identifier = @trade_id
        
    end
    /*
     *  5. Client B2B RFQ spot street ticket
     *  6. Street RFQ spot street ticket
     */
    else if @external_account_type = "Counterparty" or @external_account_type = "Regular"
    begin
        
        select
            @trd_deal_type = "Market Forward",
            @trd_tally_type = "Forward",

            @mkt_lookup_trader = @order_orig_trader,
            @mkt_lookup_counterparty = @exec_firm,
            @mkt_trade_type = "Spot",
            @mkt_value_date = @value_date,
            @mkt_price = @tkt_price,
            @mkt_qty = @tkt_qty,
            @mkt_identifier = @trade_id
        
    end
    else
    begin
        select
            status = "Error",
            message = "Unsupported external account type",
            external_account_type = @external_account_type,
            trade_type = @trade_type,
            symbol_suffix = @symbol_suffix
        return
    end
    
end
/*
 * One of the following cases:
 *  7. Client B2B RFQ forward client ticket
 *  8. Client B2B RFQ forward street ticket
 *  9. Street RFQ forward street ticket
 * 13. Client B2B RFQ NDF client ticket
 * 14. Client B2B RFQ NDF street ticket
 * 15. Street RFQ NDF street ticket
 */
else if @trade_type = "RFQ" and @symbol_suffix = "FORWARD"
begin

    /*
     */
    if @external_account_type in("Client" , "Master", "Managed") and @leg1_exec_firm_type != "Agency"
    begin
        
        select
            @trd_deal_type = "B2B Forward",
            @trd_tally_type = "Forward",
            
            @cli_lookup_external_account = @order_orig_firm,
            @cli_lookup_trader = @order_orig_trader,
            @cli_lookup_counterparty = @intermediary_firm,
            @cli_trade_type = "Forward",
            @cli_value_date = @value_date,
            @cli_price = @tkt_price,
            @cli_qty = -@tkt_qty,
            @cli_identifier = @trade_id + ".c",
        
            @mkt_lookup_trader = @order_orig_trader,
            @mkt_lookup_counterparty = @leg1_exec_firm,
            @mkt_trade_type = "Forward",
            @mkt_value_date = @value_date,
            @mkt_price = @leg_price + @leg1_forward_points,
            @mkt_qty = @leg_qty,
            @mkt_identifier = @trade_id + ".m"
        
    end
    /*
     * 13. Client B2B RFQ NDF client ticket
     * 14. Client B2B RFQ NDF street ticket
     *
     * B2B NDF RFQs are single tickets containing client and street whereas non-NDF RFQs come in double-tickets. The only distinguishing mark between a non-NDF RFQ (forward) and a 
     */
    
    /*
     *  7. Client B2B RFQ forward client ticket
     * 13. Client B2B RFQ NDF client ticket
     */
    else if @external_account_type in("Client" , "Master", "Managed") 
    begin

        select
            @trd_deal_type = "Client Forward",
            @trd_tally_type = "Forward",

            @cli_lookup_trader = @order_orig_trader,
            @cli_lookup_counterparty = @leg1_exec_firm,
            @cli_lookup_external_account = @order_orig_firm,
            @cli_trade_type = "Forward",
            @cli_value_date = @value_date,
            @cli_price = @tkt_price,
            @cli_qty = -@tkt_qty,
            @cli_identifier = @trade_id
        
    end
    /*
     *  8. Client B2B RFQ forward street ticket
     *  9. Street RFQ forward street ticket
     * 14. Client B2B RFQ NDF street ticket
     * 15. Street RFQ NDF street ticket
     */
    else if @external_account_type = "Counterparty"
    begin
        
        select
            @trd_deal_type = "Market Forward",
            @trd_tally_type = "Forward",

            @mkt_lookup_trader = @order_orig_trader,
            @mkt_lookup_counterparty = @exec_firm,
            @mkt_lookup_external_account = @order_orig_firm,
            @mkt_trade_type = "Forward",
            @mkt_value_date = @value_date,
            @mkt_price = @tkt_price,
            @mkt_qty = @tkt_qty,
            @mkt_identifier = @trade_id
        
    end
    else
    begin
        select
            status = "Error",
            message = "Unsupported external account type",
            external_account_type = @external_account_type,
	    trade_type = @trade_type,
            symbol_suffix = @symbol_suffix
        return
    end
    
end
/*
 * One of the following cases:
 * 10. Client B2B RFQ swap client ticket
 * 11. Client B2B RFQ swap street ticket
 * 12. Street RFQ swap street ticket
 */
else if @trade_type = "RFQ" and @symbol_suffix = "SWAP"
begin
    
    /*
     */
    if @external_account_type in("Client" , "Master", "Managed")  and @leg1_exec_firm_type != "Agency"
    begin
        
        select
            @trd_deal_type = "B2B Forward",
            @trd_tally_type = "Forward",
            
            @cli_lookup_external_account = @order_orig_firm,
            @cli_lookup_trader = @order_orig_trader,
            @cli_lookup_counterparty = @intermediary_firm,
            @cli_trade_type = "Swap Near",
            @cli_value_date = @value_date,
            @cli_price = @tkt_price,
            @cli_qty = -@tkt_qty,
            @cli_identifier = @trade_id + ".cn",
            @cli_far_trade_type = "Swap Far",
            @cli_far_date = @far_date,
            @cli_far_price = @far_price,
            @cli_far_qty = -@far_qty,
            @cli_far_identifier = @trade_id + ".cf",

            @mkt_lookup_external_account = @leg1_intermediary_firm,
            @mkt_lookup_trader = @order_orig_trader,
            @mkt_lookup_counterparty = @leg1_exec_firm,
            @mkt_trade_type = "Swap Near",
            @mkt_value_date = @value_date,
            @mkt_price = @tkt_price,
            @mkt_qty = @tkt_qty,
            @mkt_identifier = @trade_id + ".mn",
            @mkt_far_trade_type = "Swap Far",
            @mkt_far_date = @far_date,
            @mkt_far_price = @far_price,
            @mkt_far_qty = @far_qty,
            @mkt_far_identifier = @trade_id + ".mf"

        /* 10.b */
        if @last_swap_points != NULL
        begin	
            select
                @cli_far_price = @spot_ref + @last_swap_points,
                @mkt_far_price = @spot_ref + @last_swap_points
        end
        
    end
    /*
     * 10. Client B2B RFQ swap client ticket
     */
    else if @external_account_type in("Client" , "Master", "Managed") 
    begin
        
        /* 10.a */
        select
            @trd_deal_type = "Client Swap",
            @trd_tally_type = "Swap",

            @cli_lookup_trader = @order_orig_trader,
            @cli_lookup_counterparty = @leg1_exec_firm,
            @cli_lookup_external_account = @order_orig_firm,
            @cli_trade_type = "Swap Near",
            @cli_value_date = @value_date,
            @cli_price = @tkt_price,
            @cli_qty = -@tkt_qty,
            @cli_identifier = @trade_id + ".n",
            @cli_far_trade_type = "Swap Far",
            @cli_far_date = @far_date,
            @cli_far_price = @far_price,
            @cli_far_qty = -@far_qty,
            @cli_far_identifier = @trade_id + ".f"
        
        /* 10.b */
        if @last_swap_points != NULL
        begin	
            select
                @cli_far_price = @spot_ref + @last_swap_points
        end
        
    end
    /*
     * 11. Client B2B RFQ swap street ticket
     * 12. Street RFQ swap street ticket
     */
    else if @external_account_type = "Counterparty"
    begin
        /* 12.a */
        select
            @trd_deal_type = "Market Swap",
            @trd_tally_type = "Swap",

            @mkt_lookup_trader = @order_orig_trader,
            @mkt_lookup_counterparty = @exec_firm,
            @mkt_lookup_external_account = @order_orig_firm,
            @mkt_trade_type = "Swap Near",
            @mkt_value_date = @value_date,
            @mkt_price = @tkt_price,
            @mkt_qty = @tkt_qty,
            @mkt_identifier = @trade_id + ".n",
            @mkt_far_trade_type = "Swap Far",
            @mkt_far_date = @far_date,
            @mkt_far_price = @far_price,
            @mkt_far_qty = @far_qty,
            @mkt_far_identifier = @trade_id + ".f"

        /* 12.b */
        if @last_swap_points != NULL
        begin	
            select
                @mkt_far_price = @spot_ref + @last_swap_points
        end
        
    end
    else
    begin
        select
            status = "Error",
            message = "Unsupported external account type",
            external_account_type = @external_account_type,
            trade_type = @trade_type,
	    symbol_suffix = @symbol_suffix
        return
    end
    
end

if @cli_lookup_trader != NULL
begin
    select
        @cli_user = c.login,
        @cli_trader = a.symbol,
        @cli_sales_code = d.name
    from
        traders a,
        trader_symbols b,
        sources ba,
        tico_accounts c,
        sales_codes d
    where    
        a.trader_id = b.trader_id
    and
        b.source_id = ba.source_id
    and
        a.tico_account_id = c.account_id
    and
        a.sales_code_id = d.sales_code_id
    and
        ba.name = @source
    and 
        b.symbol = @cli_lookup_trader

    if @cli_user = NULL or @cli_trader = NULL
        select
            @cli_user = b.login,
            @cli_trader = a.symbol
        from
            traders a,
            tico_accounts b
        where    
            a.tico_account_id = b.account_id
        and 
            a.symbol = @cli_lookup_trader
        
    if @cli_user = NULL or @cli_trader = NULL
    begin
        select
            status = "Error",
            message = "Couldn't find client trader and user for @cli_lookup_trader, '" + @cli_lookup_trader + "'",
            cli_lookup_trader = @cli_lookup_trader
        return
    end
    
    /* For traders that have a @cli_sales_code of "DONT TALLY", we won't want to
     * tally the client leg. Any @trd_deal_type of "B2B Forward" will be
     * converted to "Market Forward". 
       
       The method of using DONT TALLY is LEGACY. New method is to check the table suppression_symbols
     */
    if @cli_sales_code = "DONT TALLY"
    begin
    
        select
            @cli_qty = NULL, /* Our trigger not to tally client leg */
            @cli_trade_type = NULL,
            @cli_external_account = NULL,
            @cli_counterparty = NULL,
            @cli_value_date = NULL,
            @cli_price = NULL,
            @cli_trader = NULL,
            @cli_trade_status = NULL,
            @cli_identifier = NULL
        
        if @trd_deal_type = "B2B Forward"
            select
                @trd_deal_type = "Market Forward"
        
    end
    select 
       @suppress_client_trade = "N"
    
    select
       @suppress_client_trade = "Y"
    from
       suppression_symbols
    where
       source_id = @source_id 
    and
       symbol = @cli_lookup_trader

    if @suppress_client_trade = "Y"
    begin
	if @trd_deal_type like "%Swap"
        begin
            select
                @trd_deal_type = "Market Swap"
        end
        else 
        begin
	    select
	        @trd_deal_type = "Market Forward"
	end
     end
end

if @cli_lookup_counterparty != NULL
begin
    select
        @cli_counterparty = a.name
    from
        counterparties a,
        counterparty_symbols b,
        sources ba
    where
        a.counterparty_id = b.counterparty_id
    and
        b.source_id = ba.source_id
    and
        ba.name = @source
    and
        b.symbol = @cli_lookup_counterparty

    if @cli_counterparty = NULL
        select
            @cli_counterparty = a.name
        from
            counterparties a
        where
            a.name = @cli_lookup_counterparty
        
    if @cli_counterparty = NULL
    begin
        select
            status = "Error",
            message = "Couldn't find client's counterparty for @cli_lookup_counterparty, '" + @cli_lookup_counterparty + "'",
            cli_lookup_counterparty = @cli_lookup_counterparty
        return
    end

 
end

if @cli_lookup_external_account != NULL
begin
    select
        @cli_external_account = a.symbol,
        @cli_external_account_type = c.name,
        @cli_aggregation_style = d.name
    from
        external_accounts a,
        external_account_symbols b,
        sources ba,
        external_account_types c,
        aggregation_styles d
    where
        a.external_account_id = b.external_account_id
    and
        b.source_id = ba.source_id
    and
        a.external_account_type_id = c.external_account_type_id
    and
        a.aggregation_style_id = d.aggregation_style_id
    and
        ba.name = @source
    and
        b.symbol = @cli_lookup_external_account
        
    if @cli_external_account = NULL
        select
            @cli_external_account = a.symbol,
            @cli_external_account_type = b.name,
            @cli_aggregation_style = c.name
        from
            external_accounts a,
            external_account_types b,
            aggregation_styles c
        where
            a.external_account_type_id = b.external_account_type_id
        and 
            a.aggregation_style_id = c.aggregation_style_id
        and (
                a.symbol = @cli_lookup_external_account
            or
                a.name = @cli_lookup_external_account
            )

    if @cli_external_account = NULL
    begin
        select
            status = "Error",
            message = "Couldn't find client's external account for order orig firm, '" + @cli_lookup_external_account + "'",
            cli_lookup_external_account = @cli_lookup_external_account
        return
    end
end

if @mkt_lookup_trader != NULL
begin
    select
        @mkt_user = c.login,
        @mkt_trader = a.symbol
    from
        traders a,
        trader_symbols b,
        sources ba,
        tico_accounts c
    where    
        a.trader_id = b.trader_id
    and
        b.source_id = ba.source_id
    and
        a.tico_account_id = c.account_id
    and
        ba.name = @source
    and 
        b.symbol = @mkt_lookup_trader

    if @mkt_user = NULL or @mkt_trader = NULL
    begin
        select
            @mkt_user = b.login,
            @mkt_trader = a.symbol
        from
            traders a,
            tico_accounts b
        where    
            a.tico_account_id = b.account_id
        and 
            a.symbol = @mkt_lookup_trader
    end

    if @mkt_lookup_trader != NULL and (@mkt_user = NULL or @mkt_trader = NULL)
    begin
        select
            status = "Error",
            message = "Couldn't find market trader and user for @mkt_lookup_trader, '" + @mkt_lookup_trader + "'",
            mkt_lookup_trader = @mkt_lookup_trader
        return
    end


end

if @mkt_lookup_counterparty != NULL
begin
    select
        @mkt_counterparty = a.name,
        @mkt_external_account = c.symbol
    from
        counterparties a,
        counterparty_symbols b,
        sources ba,
        external_accounts c
    where
        a.counterparty_id = b.counterparty_id
    and
        b.source_id = ba.source_id
    and
        a.external_account_id = c.external_account_id
    and
        ba.name = @source
    and
        b.symbol = @mkt_lookup_counterparty

    if @mkt_counterparty = NULL
        select
            @mkt_counterparty = a.name,
            @mkt_external_account = b.symbol
        from
            counterparties a,
            external_accounts b
        where
            a.external_account_id = b.external_account_id
        and
            a.name = @mkt_lookup_counterparty

    if @mkt_counterparty = NULL or @mkt_external_account = NULL
    begin
        select
            status = "Error",
            message = "Couldn't find market's counterparty and external account for @mkt_lookup_counterparty, '" + @mkt_lookup_counterparty + "'",
            mkt_lookup_counterparty = @mkt_lookup_counterparty
        return
    end
end

if @mkt_lookup_external_account != NULL
begin
    select
        @mkt_external_account = a.symbol
    from
        external_accounts a,
        external_account_symbols b,
        sources ba
    where
        a.external_account_id = b.external_account_id
    and
        b.source_id = ba.source_id
    and
        ba.name = @source
    and
        b.symbol = @mkt_lookup_external_account
        
    if @mkt_external_account = NULL
        select
            @mkt_external_account = a.symbol
        from
            external_accounts a
        where
            a.symbol = @mkt_lookup_external_account
        or
            a.name = @mkt_lookup_external_account

    if @mkt_external_account = NULL
    begin
        select
            status = "Error",
            message = "Couldn't find market's external account for order orig firm, '" + @mkt_lookup_external_account + "'",
            mkt_lookup_external_account = @mkt_lookup_external_account
        return
    end
end

create table
	#trade_output
(
	status varchar(25) NULL,
	ttype varchar(15) NULL,
	trade_id int NULL,
	deal_id int NULL,
	ext_acct varchar(25) NULL,
	cpty varchar(25) NULL,
	ct varchar(25) NULL,
	qty float NULL,
	price float NULL,
	trader varchar(50) NULL,
	identifier varchar(50) NULL,
	vald datetime NULL
)

if @invert_leg_currency = "Y"
begin
	if @leg_currency = @settle_currency
	begin
        	select
			@mkt_qty = @mkt_qty * @mkt_price,
			@mkt_far_qty = @mkt_far_qty * @mkt_far_price
	end
end

if @invert_leg_currency = "N"
begin
	if @leg_currency = @settle_currency
	begin
        	select
                	@mkt_qty = @mkt_qty * -1,
			@mkt_far_qty = @mkt_far_qty * -1
	end
end
	

/* -- removed transaction for swaps for the 11.0 upgrade --*/
    /* 
     * Now that we've calculated the information we need, then tally the 4
     * different kinds of trades we might need:
     * 
     * A. Client or Client Near trade
     */
    if @cli_qty != NULL
    begin
        if @suppress_client_trade = 'Y'
        begin
            exec
            	fxa_suppresstrade
                    @login = @cli_user,
                    @source = @source,
                    @suppressed_trade_id = @suppressed_cli_trade_id out,
                    @deal_id = @suppressed_cli_deal_id out,
                    @tally_type = @trd_tally_type,
                    @deal_type = @trd_deal_type,
                    @trade_type = @cli_trade_type,
                    @external_account = @cli_external_account,
                    @counterparty = @cli_counterparty,
                    @quantity = @cli_qty,
                    @symbol = @trd_symbol,
                    @value_date = @cli_value_date,
                    @price = @cli_price,
                    @trade_date = @trd_trade_date,
                    @trader = @cli_trader,
                    @status = @cli_trade_status,
                    @broker = @trd_broker,
                    @identifier = @cli_identifier,
                    @spot_reference = @trd_spot_ref
	    if @suppressed_cli_trade_id = NULL
            begin
                    select
                            status = "Error",
                            message = "Failed to suppress trade"
            end
            insert into
                #trade_output
            values(
                "Suppressed",
                "CLI",
                @suppressed_cli_trade_id,
                @suppressed_cli_deal_id,
                @cli_external_account,
                @cli_counterparty,
                @trd_symbol,
                @cli_qty,
                @cli_price,
                @cli_trader,
                @cli_identifier,
                @cli_value_date
            )
        end
        else
        begin
            exec
                fxa_tallytrade
                    @login = @cli_user,
                    @source = @source,
                    @trade_id = @cli_trade_id out,
                    @deal_id = @trd_deal_id out,
                    @tally_type = @trd_tally_type,
                    @deal_type = @trd_deal_type,
                    @trade_type = @cli_trade_type,
                    @external_account = @cli_external_account,
                    @counterparty = @cli_counterparty,
                    @quantity = @cli_qty,
                    @symbol = @trd_symbol,
                    @value_date = @cli_value_date,
                    @price = @cli_price,
                    @trade_date = @trd_trade_date,
                    @trader = @cli_trader,
                    @status = @cli_trade_status,
                    @broker = @trd_broker,
                    @identifier = @cli_identifier,
                    @spot_reference = @trd_spot_ref
    
            if @cli_trade_id = NULL
            begin
                select
                    status = "Error",
                    message = "Failed to tally client trade"
                return
            end
	    insert into
		    #trade_output
	    values(
		    "Trade Tallied",
		    "CLI",
		     @cli_trade_id,
	       	     @trd_deal_id,
		     @cli_external_account,
		    @cli_counterparty,
		    @trd_symbol,
		    @cli_qty,
		    @cli_price,
		    @cli_trader,
		    @cli_identifier,
		    @cli_value_date
	    )
       end
    end

    /* 
     * B. Client Far trade
     */
    if @cli_far_qty != NULL
    begin
       if @suppress_client_trade = 'Y'
       begin
            exec
                fxa_suppresstrade
                    @login = @cli_user,
                    @source = @source,
                    @suppressed_trade_id = @cli_far_suppress_trade_id out,
                    @deal_id = @suppressed_cli_deal_id out,
                    @tally_type = @trd_tally_type,
                    @deal_type = @trd_deal_type,
                    @trade_type = @cli_far_trade_type,
                    @external_account = @cli_external_account,
                    @counterparty = @cli_counterparty,
                    @quantity = @cli_far_qty,
                    @symbol = @trd_symbol,
                    @value_date = @cli_far_date,
                    @price = @cli_far_price,
                    @trade_date = @trd_trade_date,
                    @trader = @cli_trader,
                    @status = @cli_trade_status,
                    @broker = @trd_broker,
                    @identifier = @cli_far_identifier,
                    @spot_reference = @trd_spot_ref

            if @cli_far_suppress_trade_id = NULL
            begin
                select
                    status = "Error",
                    message = "Failed to suppress client far trade"
                return
            end

            insert into
                    #trade_output
            values(
                    "Suppressed",
                    "CLI Far",
                    @cli_far_suppress_trade_id,
                    @suppressed_cli_deal_id,
                    @cli_external_account,
                    @cli_counterparty,
                    @trd_symbol,
                    @cli_far_qty,
                    @cli_far_price,
                    @cli_trader,
                    @cli_far_identifier,
                    @cli_far_date
            )
       end
       else
       begin 
            exec
                fxa_tallytrade
                    @login = @cli_user,
                    @source = @source,
                    @trade_id = @cli_far_trade_id out,
                    @deal_id = @trd_deal_id out,
                    @tally_type = @trd_tally_type,
                    @deal_type = @trd_deal_type,
                    @trade_type = @cli_far_trade_type,
                    @external_account = @cli_external_account,
                    @counterparty = @cli_counterparty,
                    @quantity = @cli_far_qty,
                    @symbol = @trd_symbol,
                    @value_date = @cli_far_date,
                    @price = @cli_far_price,
                    @trade_date = @trd_trade_date,
                    @trader = @cli_trader,
                    @status = @cli_trade_status,
                    @broker = @trd_broker,
                    @identifier = @cli_far_identifier,
                    @spot_reference = @trd_spot_ref
    
            if @cli_far_trade_id = NULL
            begin
                select
                    status = "Error",
                    message = "Failed to tally client far trade"
                return
            end
    
            insert into 
                    #trade_output
            values(
                    "Trade Tallied",
		    "CLI Far",
                    @cli_far_trade_id,
                    @trd_deal_id,
                    @cli_external_account,
                    @cli_counterparty,
                    @trd_symbol,
                    @cli_far_qty,
                    @cli_far_price,
                    @cli_trader,
                    @cli_far_identifier,
		    @cli_far_date
            )
       end
    end

    /* 
     * C. Market or Market Near trade
     */
    if @mkt_qty != NULL
    begin
        
        exec
            fxa_tallytrade
                @login = @mkt_user,
                @source = @source,
                @trade_id = @mkt_trade_id out,
                @deal_id = @trd_deal_id out,
                @tally_type = @trd_tally_type,
                @deal_type = @trd_deal_type,
                @trade_type = @mkt_trade_type,
                @external_account = @mkt_external_account,
                @counterparty = @mkt_counterparty,
                @quantity = @mkt_qty,
                @symbol = @mkt_trd_symbol,
                @value_date = @mkt_value_date,
                @price = @mkt_price,
                @trade_date = @trd_trade_date,
                @trader = @mkt_trader,
                @status = "User Review",
                @broker = @trd_broker,
                @identifier = @mkt_identifier,
                @spot_reference = @trd_spot_ref

        if @mkt_trade_id = NULL
        begin
            select
                status = "Error",
                message = "Failed to tally market trade"
            return
        end
        insert into
                #trade_output
        values(
                "Trade Tallied",
		"MKT",
                 @mkt_trade_id,
                 @trd_deal_id,
                 @mkt_external_account, 
                @mkt_counterparty,
                @mkt_trd_symbol,
                @mkt_qty,
                @mkt_price,
                @mkt_trader,
                @mkt_identifier,
		@mkt_value_date
        )

    end

    /* 
     * C. Market Far trade
     */
    if @mkt_far_qty != NULL
    begin
        
        exec
            fxa_tallytrade
                @login = @mkt_user,
                @source = @source,
                @trade_id = @mkt_far_trade_id out,
                @deal_id = @trd_deal_id out,
                @tally_type = @trd_tally_type,
                @deal_type = @trd_deal_type,
                @trade_type = @mkt_far_trade_type,
                @external_account = @mkt_external_account,
                @counterparty = @mkt_counterparty,
                @quantity = @mkt_far_qty,
                @symbol = @mkt_trd_symbol,
                @value_date = @mkt_far_date,
                @price = @mkt_far_price,
                @trade_date = @trd_trade_date,
                @trader = @mkt_trader,
                @status = "User Review",
                @broker = @trd_broker,
                @identifier = @mkt_far_identifier,
                @spot_reference = @trd_spot_ref

        if @mkt_far_trade_id = NULL
        begin
            select
                status = "Error",
                message = "Failed to tally market far trade"
            return
        end
        insert into
                #trade_output
        values(
                "Trade Tallied",
		"MKT Far",
                 @mkt_far_trade_id,
                 @trd_deal_id,
                 @mkt_external_account, 
                @mkt_counterparty,
                @mkt_trd_symbol,
                @mkt_far_qty,
                @mkt_far_price,
                @mkt_trader,
                @mkt_far_identifier,
		@mkt_far_date
        )

    end

/*
 * Swap Symbols 
 */

if @mkt_far_trade_id != NULL
begin
	/* Create and assign market swap symbol */
	exec
		j_nextkey
			"swap_symbols",
			@market_swap_symbol_id output
	select
		@market_swap_symbol = rtrim(convert(varchar(50), @trd_deal_id)) + ".M"
	
	insert into
		swap_symbols
	(
		swap_symbol_id,
		symbol,
		timestamp
	)
	values
	(
		@market_swap_symbol_id,
		@market_swap_symbol,
		getdate()
	)
	
	/* Tie bothe legs to the swap symbol */
	insert into 
		swap_symbol_trades
	(
		swap_symbol_id,
		trade_id
	)
	values
	(
		@market_swap_symbol_id,
		@mkt_trade_id
	)
	insert into 
		swap_symbol_trades
	(
		swap_symbol_id,
		trade_id
	)
	values
	(
		@market_swap_symbol_id,
		@mkt_far_trade_id
	)
end

if @cli_far_trade_id != NULL
begin 
	/* Create and assign client swap symbol */
	exec
		j_nextkey
			"swap_symbols",
			@client_swap_symbol_id output
	select
		@client_swap_symbol = rtrim(convert(varchar(50), @trd_deal_id)) + ".C"
	
	insert into
		swap_symbols
	(
		swap_symbol_id,
		symbol,
		timestamp
	)
	values
	(
		@client_swap_symbol_id,
		@client_swap_symbol,
		getdate()
	)
	
	/* Tie both legs to the swap symbol */
	insert into 
		swap_symbol_trades
	(
		swap_symbol_id,
		trade_id
	)
	values
	(
		@client_swap_symbol_id,
		@cli_trade_id
	)
	insert into 
		swap_symbol_trades
	(
		swap_symbol_id,
		trade_id
	)
	values
	(
		@client_swap_symbol_id,
		@cli_far_trade_id
	)
end


/*
 * EXEC r_inserttradenotification: Send out trade notifications
 */

if @cli_trade_id != NULL
    exec
        r_inserttradenotification
            @cli_trade_id

if @cli_far_trade_id != NULL
    exec
        r_inserttradenotification
            @cli_far_trade_id

if @mkt_trade_id != NULL
    exec
        r_inserttradenotification
            @mkt_trade_id

if @mkt_far_trade_id != NULL
    exec
        r_inserttradenotification
            @mkt_far_trade_id

/*
 * Process any deal tags
 * Schedule a tt_processdealtags 
   ---- dont call

declare @next_date datetime
select
    @sql = "exec tt_processdealtags '" + @default_login + "'",
    @next_date = getdate()
exec
    r_managetimer
        @login = @default_login,
        @name = "tt_processdealtags",
        @next_date =  @next_date,
        @interval = 30,
        @iterations = -1,
        @sql = @sql
*/ 
/*
exec
    tt_processdealtags
        @login = @default_login
 */
 
/* 
 * AUTOCOMMIT
 *
 * If there is a client trade in this deal and the account type is set for
 * Autocommit, then push through this deal automatically.
 */
if @trd_deal_id != NULL and @cli_trade_id != NULL and @cli_aggregation_style = "Autocommit"
begin

    update
        deals
    set
        status_id = @committed_status_id
    where
        deal_id = @trd_deal_id
    
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for client external account, '" + @cli_external_account + "', an aggregation style, '" + @cli_aggregation_style + "'"
/*        return*/
    end

end
else
begin
    select
        message = "No autocommitted",
        trd_deal_id = @trd_deal_id,
        cli_trade_id = @cli_trade_id,
        cli_aggregation_style = @cli_aggregation_style
end
