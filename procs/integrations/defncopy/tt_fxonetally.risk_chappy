
create procedure
	tt_fxonetally
        	@agent varchar(50),
        	@source varchar(50),
        	@cli_source varchar(50)=NULL,
        	@default_login varchar(50)=NULL,
		@sender_comp varchar(50)=NULL,
		@target_comp varchar(50)=NULL,
        	@trade_report_id varchar(100)=NULL,
		@order_id varchar(50)=NULL,
		@previously_reported varchar(50)=NULL,
        	@trade_match_id varchar(50)=NULL,
        	@symbol varchar(50)=NULL,
        	@quantity numeric(30,6)=NULL,
        	@price float=NULL,
        	@currency varchar(5)=NULL,
        	@settle_currency varchar(5)=NULL,
        	@trade_date datetime=NULL,
        	@value_date datetime=NULL,
        	@side varchar(5)=NULL,
        	@account varchar(50)=NULL,
		@contra_firm varchar(50)=NULL,
		@transact_date datetime=NULL,
		@transact_time datetime=NULL,
		@trd_sub_type int
		
as

declare @cl_or_lp varchar(50)

declare @committed_status_id int
declare @dont_tally_salescode_id int

declare @contract_symbol varchar(10)

declare @trade_type varchar(25)
declare @trade_type_id int
declare @tally_type varchar(25)
declare @deal_type varchar(25)
declare @deal_id int
declare @deal_exec_symbol varchar(100)
declare @deal_type_id int
declare @deal_status_id int
declare @inverted char(1)
declare @broker varchar(25)
declare @mkt_trade_id int
declare @mkt_trade_identifier varchar(100)
declare @mkt_trader_login varchar(50)
declare @mkt_external_account varchar(25)
declare @mkt_external_account_id int
declare @mkt_external_account_type varchar(25)
declare @mkt_cpty_ext_acct_id int
declare @mkt_aggregation_style_id int
declare @mkt_aggregation_style varchar(25)
declare @mkt_counterparty varchar(25)
declare @mkt_counterparty_id int
declare @mkt_trader varchar(25)
declare @mkt_trader_id int
declare @mkt_quantity numeric(30, 4)
declare @mkt_price float
declare @mkt_quoted_price float

declare @cli_trade_id int
declare @cli_trade_identifier varchar(100)
declare @cli_trader_login varchar(50)
declare @cli_external_account varchar(25)
declare @cli_external_account_id int
declare @cli_external_account_type varchar(25)
declare @cli_cpty_ext_acct_id int
declare @cli_aggregation_style_id int
declare @cli_aggregation_style varchar(25)
declare @cli_counterparty varchar(25)
declare @cli_counterparty_id int
declare @cli_trader varchar(25)
declare @cli_trader_id int
declare @cli_quantity numeric(30, 4)
declare @cli_price float
declare @cli_quoted_price float


declare @mkt_lookup_cpty varchar(50)
declare @mkt_lookup_trader varchar(50)
declare @cli_lookup_cpty varchar(50)
declare @cli_lookup_trader varchar(50)

declare @cli_tallied int
declare @mkt_tallied int

declare @suppress_trade varchar(1)

declare @substring1 varchar(3)
declare @substring2 varchar(3)

declare @cli_cancelled_trade_id int
declare @cli_cancelled_deal_id int
declare @cli_cancelled_qty numeric(30,6)
declare @cli_cancelled_price float
declare @cli_cancelled_vd datetime

declare @mkt_cancelled_trade_id int
declare @mkt_cancelled_deal_id int
declare @mkt_cancelled_qty numeric(30,6)
declare @mkt_cancelled_price float
declare @mkt_cancelled_vd datetime

declare @cancelled_trade_id int
declare @cancelled_deal_id int
declare @cancelled_qty numeric(30,6)
declare @cancelled_price float
declare @cancelled_vd datetime

declare @contra_broker_symbol varchar(50)
declare @contra_broker varchar(50)
declare @fund_agency_trader varchar(50)
declare @source_id int

declare @trigger_symbol varchar(50)
declare @cl_create char(1)
declare @lp_create char(1)
declare @t2_cl_ext_account varchar(50)
declare @t2_cl_trader varchar(50)
declare @t2_cl_counterparty varchar(50)
declare @t2_cl_trade_id int
declare @t2_cl_identifier varchar(100)
declare @t2_cl_quantity numeric(30, 4)
declare @t2_cl_inv_qty char(1)

declare @t2_lp_ext_account varchar(50)
declare @t2_lp_trader varchar(50)
declare @t2_lp_counterparty varchar(50)
declare @t2_lp_trade_id int
declare @t2_lp_identifier varchar(100)
declare @t2_lp_quantity numeric(30, 4)
declare @t2_lp_inv_qty char(1)
declare @t2_deal_id int

declare @auto_b2b_deal_status_id int
declare @auto_b2b_deal_type_id int
declare @auto_b2b_deal_id int


select
	@default_login = @agent

select
	@broker = "FXOne",
	@trade_type = "Spot",
	@tally_type = "Spot"

if @trd_sub_type = 1
begin
	select 
		@cl_or_lp = "CL"
end
else if @trd_sub_type = 2
begin
	select 
		@cl_or_lp = "LP"
end
else
begin
	select
		"error" = "Error",
		"msg" = "Could not determine CL or LP from TrdSubType",
		"trd_sub_type" =  @trd_sub_type
	return
end

	

select
	@source_id = source_id
from
	sources
where
	name = @source
	

declare @gmt_adjustment int
select
        @gmt_adjustment = 0

if @gmt_adjustment != 0
	select
       		 @trade_date = dateadd(hour, @gmt_adjustment, @trade_date)


/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end


if @side = "SELL"
begin
    select
        @quantity = -@quantity
end

select
	@contract_symbol = rtrim(@currency) + rtrim(@settle_currency)

if not exists(select contract_id from contracts where symbol = @contract_symbol)

begin
	select
		message = "Contract not found",
		contract = @contract_symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"

	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @currency,
                	@settle_currency,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@contract_symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@contract_symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @contract_symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @contract_symbol
	and
       		b.name = "Inverted"
   	
end


select "debug"="debug", "cl_or_lp"=@cl_or_lp

if @cl_or_lp = "LP"
begin

	select
		@deal_type = "Client Forward",
		@deal_exec_symbol = rtrim(@order_id) + convert(varchar(8), @trade_date, 112),
		@mkt_trade_identifier = rtrim(@trade_report_id) + ".m",
		@mkt_lookup_cpty = @contra_firm,
		@mkt_lookup_trader = @sender_comp,
		@mkt_price = @price,
		@mkt_quantity = @quantity, 
		@mkt_quoted_price = @price

	/*
        * CHECK FOR SUPPRESSION
        */
        select
                @suppress_trade = "Y"
        from
                suppression_symbols
        where
                source_id = @source_id
        and
                symbol = @mkt_lookup_cpty

        if @suppress_trade = "Y"
        begin
		/*      
                * Acknoweldge this trade report
                */
                select
                        trade_report_id=@trade_report_id,
                        symbol=@symbol,
                        exec_type="TRADE"

                select
                        msg = "Suppressing Trade",
                        lookup_cpty = @mkt_lookup_cpty
		return
        end

	/*
	* CHECK to see if this requires a manufactured B2B
	*/

	select 
		@cl_create = cl_create,
		@lp_create = lp_create
	from 
		ticket_creation_values 
	where 
		trigger_symbol = @mkt_lookup_cpty
	and
 		source_id = @source_id
	if @@rowcount != 0
	begin
       		select
               		@trigger_symbol = @mkt_lookup_cpty
	end

	select
		@mkt_trade_id = trade_id
	from
		trades
	where
		identifier = @mkt_trade_identifier
	if @mkt_trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Mkt trade is already tallied",
			trade_identifier = @mkt_trade_identifier,
			lookup_cpty = @mkt_lookup_cpty,
			lookup_trdr = @mkt_lookup_trader,
			price = @mkt_price,
			quantity = @mkt_quantity

	end

	/*
 	,-------------------,
 	| TRADE LOOKUPS    |
 	'-------------------'
	*/
	if @mkt_trade_id  = NULL
	begin
		/*
 		* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 		*/ 
		
		select
			@mkt_trader_id = a.trader_id,
			@mkt_trader = a.symbol,
			@mkt_trader_login = c.login,
			@mkt_external_account_id = a.external_account_id
		from
        		traders a,
        		trader_symbols b,
        		sources ba,
        		tico_accounts c
		where    
        		a.trader_id = b.trader_id
		and
        		b.source_id = ba.source_id
		and
        		a.tico_account_id = c.account_id
		and
        		ba.name = @source
		and 
        		b.symbol = @mkt_lookup_trader
		
		if @mkt_trader_id = NULL or @mkt_trader_login = NULL
		begin
    			select
            			@mkt_trader_id = a.trader_id,
            			@mkt_trader = a.symbol,
            			@mkt_trader_login = c.login,
            			@mkt_external_account_id = a.external_account_id
    			from
            			traders a,
            			tico_accounts c
    			where    
            			a.tico_account_id = c.account_id
    			and 
            			a.symbol = @mkt_lookup_trader
		
    			if @mkt_trader_id = NULL or @mkt_trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @mkt_lookup_trader, '" + @mkt_lookup_trader + "'",
            			mkt_lookup_trader = @mkt_lookup_trader
        			return
    			end		
		end
		
		/*
 		* LOOKUP @mkt_counterparty_id, @mkt_counterparty_symbol, @mkt_cpty_ext_acct_id from @mkt_lookup_cpty
 		*/
		
		select
			@mkt_counterparty_id = a.counterparty_id,
			@mkt_counterparty = a.name,
			@mkt_cpty_ext_acct_id = a.external_account_id
		from
        		counterparties a,
        		counterparty_symbols b,
        		sources ba
		where
        		a.counterparty_id = b.counterparty_id
		and
        		b.source_id = ba.source_id
		and
        		ba.name = @source
		and
        		b.symbol = @mkt_lookup_cpty
		if @mkt_counterparty = NULL
		begin
        		select
                		@mkt_counterparty_id = a.counterparty_id,
				@mkt_counterparty = a.name,
				@mkt_cpty_ext_acct_id = a.external_account_id
        		from
                		counterparties a
        		where
                		a.name = @mkt_lookup_cpty
        		
        		if @mkt_counterparty = NULL
        		begin
               			select
                        		status = "Error",
                        		message = "Couldn't find counterparty for @mkt_lookup_cpty, '" + @mkt_lookup_cpty + "'",
					mkt_lookup_cpty = @mkt_lookup_cpty
                		return
        		end
		end
	
	
		/*
 		* LOOKUP @mkt_external_account, @mkt_external_account_type based on @mkt_external_account_id
 		*/
		select
    			@mkt_external_account = a.symbol,
    			@mkt_external_account_type = b.name,
    			@mkt_aggregation_style = c.name
		from
    			external_accounts a,
    			external_account_types b,
    			aggregation_styles c
		where
    			a.external_account_type_id = b.external_account_type_id
		and
    			a.aggregation_style_id = c.aggregation_style_id
		and
    			a.external_account_id =  @mkt_cpty_ext_acct_id
		if @mkt_external_account = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find external_account from @mkt_external_account_id",
				mkt_external_account_id = @mkt_external_account_id
			return
		end
	end

	select
		@deal_id = deal_id
	from
		deal_exec_symbols
	where
		symbol = @deal_exec_symbol
	if @deal_id = NULL
	begin
		select
			msg = "Creating new deal"
		
		select
			@deal_status_id = status_id
		from
			statuses
		where
			name = "User Review"
		if @deal_status_id = NULL
		begin
			select
				status = "Error",
				message = "No status found named, 'User Review'"
			return
		end

		select
			@deal_type_id = deal_type_id
		from
			deal_types
		where
			name = @deal_type
		if @deal_type_id = NULL
		begin
			select
				status = "Error",
				message = "No deal type found for @deal_type",
				deal_type = @deal_type
			return	
		end
	
		exec
			j_nextkey
				"deals",
				@deal_id output
			
			insert into
				deals(
					deal_id,   
					deal_type_id,
					timestamp,  
					status_id  
		 			)      
				values( 
					@deal_id,
					@deal_type_id,
					getdate(),
					@deal_status_id
					)
    		
    			insert into
				deal_exec_symbols
			values(
				@deal_id,
				@deal_exec_symbol
    				)
	end
	else
	begin
		select
			msg = "Appending to existing deal"
	
		/*  Below to support management of deal_type. 
	    	This tally is currently purposed for B2B deals. This will be inserted B2B */	
		/*
        	select
                	@deal_type_id = deal_type_id
        	from
                	deal_types
        	where
                	name = 'B2B Forward'
        	if @deal_type_id = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "No deal type found for 'B2B Forward'"
                	return
        	end
	
		update
			deals
		set
			deal_type_id = @deal_type_id
		where
			deal_id = @deal_id
		*/
	end
				
	select "debug"="debug", mkt_trade_id = @mkt_trade_id

	if @mkt_trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @mkt_trader_login,
				@source = @source,
				@trade_id = @mkt_trade_id out,
				@deal_id = @deal_id out,
				@tally_type = @tally_type,
				@deal_type = @deal_type,
				@trade_type = @trade_type,
				@external_account = @mkt_external_account,
				@counterparty = @mkt_counterparty,
				@quantity = @mkt_quantity,
				@symbol = @contract_symbol,
				@value_date = @value_date,
				@price = @mkt_price,
				@trade_date = @trade_date,
				@trader = @mkt_trader,
				@broker = @broker,
				@identifier = @mkt_trade_identifier,
				@spot_reference = @mkt_quoted_price
	
		if @mkt_trade_id = NULL
		begin
			select
				status = "Error",
				message = "Failed to tally trade"
			return
		end
	
	
		insert into
			trade_quoted_prices (	
				trade_id,
				price)
		values(
			@mkt_trade_id,
			@mkt_quoted_price
			)

		exec
			r_inserttradenotification
			@mkt_trade_id
		select		
			@mkt_tallied = 1
	end

	if @cl_create = "Y" or @lp_create = "Y"
	begin
		if @cl_create = "Y"
		begin
				
			select
				@t2_cl_ext_account = cl_ext_account,
				@t2_cl_trader = cl_trader,
				@t2_cl_counterparty = cl_counterparty,
				@t2_cl_inv_qty = cl_inv_qty
			from
				ticket_creation_values
			where
	        		trigger_symbol = @trigger_symbol
	
			select
				@t2_cl_identifier = rtrim(@mkt_trade_identifier)+".t2cl_autob2b",
                       		@t2_cl_quantity = @mkt_quantity
	
				
			if @t2_cl_inv_qty = "Y"
			begin
				select
					@t2_cl_quantity = -@mkt_quantity
			end
	
			exec
				fxa_tallytrade
					@login = @mkt_trader_login,
					@source = @source,
					@trade_id = @t2_cl_trade_id out,
					@deal_id = @deal_id out,
					@tally_type = @trade_type,
					@deal_type = @deal_type,
					@trade_type = @trade_type,
					@external_account = @t2_cl_ext_account,
					@counterparty = @t2_cl_counterparty,
					@quantity = @t2_cl_quantity,
					@symbol = @contract_symbol,
					@value_date = @value_date,
					@price = @mkt_price,
					@trade_date = @trade_date,
					@trader = @t2_cl_trader,
					@broker = @broker,
					@identifier = @t2_cl_identifier,
					@spot_reference = @mkt_quoted_price
	
	
			if @t2_cl_trade_id = NULL
			begin
    				select
       					status = "Error",
       					message = "Failed to tally trade"
    				return
			end
		
	
			exec
   					r_inserttradenotification
       					@t2_cl_trade_id
	
			select
       				status = "Tallied",
       				message = "Trade successfully tallied",
       				trade_id = @t2_cl_trade_id,
       				deal_id = @deal_id,
       				account = @t2_cl_ext_account,
       				symbol = @contract_symbol,
       				quantity = @t2_cl_quantity,
       				price = @mkt_price,
       				val_date = @value_date
	
		end
		if @lp_create = "Y"
		begin
	
               		select
                       		@t2_lp_ext_account = lp_ext_account,
                       		@t2_lp_trader = lp_trader,
                       		@t2_lp_counterparty = lp_counterparty,
				@t2_lp_inv_qty = lp_inv_qty
               		from
                       		ticket_creation_values
               		where
                       		trigger_symbol = @trigger_symbol
	
               		select
                       		@t2_lp_identifier = rtrim(@cli_trade_identifier)+".t2lp_autob2b",
				@t2_lp_quantity = @mkt_quantity
	
               		if @t2_lp_inv_qty = "Y"
               		begin
                       		select
                               		@t2_lp_quantity = -@mkt_quantity
               		end
			
			if @cl_create = "Y"
			begin
				select
					@t2_deal_id = @auto_b2b_deal_id
			end
			else
			begin
				select
					@t2_deal_id = @deal_id
			end
               		exec
                       		fxa_tallytrade
                               		@login = @mkt_trader_login,
                               		@source = @source,
                               		@trade_id = @t2_lp_trade_id out,
                               		@deal_id = @t2_deal_id out,
                               		@tally_type = @trade_type,
                               		@deal_type = @deal_type,
                               		@trade_type = @trade_type,
                               		@external_account = @t2_lp_ext_account,
                               		@counterparty = @t2_lp_counterparty,
                               		@quantity = @t2_lp_quantity,
                               		@symbol = @contract_symbol,
                               		@value_date = @value_date,
                               		@price = @mkt_price,
                               		@trade_date = @trade_date,
                               		@trader = @t2_lp_trader,
                               		@broker = @broker,
                               		@identifier = @t2_lp_identifier,
                               		@spot_reference = @mkt_quoted_price
	
	
               		if @t2_lp_trade_id = NULL
               		begin
                       		select
                               		status = "Error",
                               		message = "Failed to tally trade"
                       		return
               		end
	
	
               		exec
                       		r_inserttradenotification
                               		@t2_lp_trade_id
	
               		select
                       		status = "Tallied",
                       		message = "Trade successfully tallied",
                       		trade_id = @t2_lp_trade_id,
                       		deal_id = @t2_deal_id,
                       		account = @t2_lp_ext_account,
                       		symbol = @contract_symbol,
                       		quantity = @t2_lp_quantity,
                       		price = @mkt_price,
                       		val_date = @value_date
	
		end
	end


	/* 
 	* AUTOCOMMIT
 	*
 	* If there is a mktent trade in this deal and the account type is set for
 	* Autocommit, then push through this deal automatically.
 	*/
	if @deal_id != NULL and @mkt_trade_id != NULL and @mkt_aggregation_style = "Autocommit" and  @mkt_tallied != NULL
	begin
	
    		update
        		deals
    		set
        		status_id = @committed_status_id
    		where
        		deal_id = @deal_id
    		if @@rowcount != 1
    		begin
        		select
            		status = "Error",
            		message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @mkt_external_account + "', an aggregation style, '" + @mkt_aggregation_style + "'"
    		end
	end
	else
	begin
    		select
        		message = "No autocommitted",
        		deal_id = @deal_id,
        		trade_id = @mkt_trade_id,
        		aggregation_style = @mkt_aggregation_style
	end
		
	if @mkt_tallied != NULL
	begin
		select
			status = "Tallied",
			message = "Trade successfully tallied",
    			trade_id = @mkt_trade_id,
    			deal_id = @deal_id,
			account = @mkt_external_account,
			trader = @mkt_trader,
			cpty = @mkt_counterparty,
			symbol = @contract_symbol,
			side = @side,
			quantity = @mkt_quantity,
			price = @mkt_price,
			val_date = @value_date
	end
end
	



if @cl_or_lp = "CL"
begin

	select
		@deal_exec_symbol = rtrim(@order_id) + convert(varchar(8), @trade_date, 112),
		@deal_type = "B2B Forward",
		@cli_trade_identifier = rtrim(@trade_report_id) +".c",
		@cli_lookup_cpty = @target_comp ,
		@cli_lookup_trader = @account,
		@cli_price = @price,
		@cli_quantity = -@quantity /* Reverse qty */,
		@cli_quoted_price = @price

	/*
        * CHECK FOR SUPPRESSION
        */
        select
                @suppress_trade = "Y"
        from
                suppression_symbols
        where
                source_id = @source_id
        and
                symbol = @cli_lookup_trader

        if @suppress_trade = "Y"
        begin
                /*
                * Acknoweldge this trade report
                */
                select
                        trade_report_id=@trade_report_id,
                        symbol=@symbol,
                        exec_type="TRADE"

                select
                        msg = "Suppressing Trade",
                        lookup_cpty = @cli_lookup_trader
                return
        end

	/*              
	* CHECK to see if this requires a manufactured B2B
	*/              

	select          
        	@cl_create = cl_create,
        	@lp_create = lp_create
	from            
        	ticket_creation_values 
	where           
        	trigger_symbol = @cli_lookup_trader
	and             
        	source_id = @source_id
	if @@rowcount != 0
	begin           
        	select  
                	@trigger_symbol = @cli_lookup_trader
	end             

	select
		@cli_trade_id = trade_id
	from
		trades
	where
		identifier = @cli_trade_identifier
	if @cli_trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Client trade is already tallied",
			trade_identifier = @cli_trade_identifier,
			lookup_cpty = @cli_lookup_cpty,
			lookup_trdr = @cli_lookup_trader,
			price = @cli_price,
			quantity = @cli_quantity
	end
	
	
	
	/*
 	,-------------------,
 	| CLIENT LOOKUPS    |
 	'-------------------'
	*/
	if @cli_trade_id  = NULL
	begin
		/*
 		* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 		*/ 
		
		select
			@cli_trader_id = a.trader_id,
			@cli_trader = a.symbol,
			@cli_trader_login = c.login,
			@cli_external_account_id = a.external_account_id
		from
        		traders a,
        		trader_symbols b,
        		sources ba,
        		tico_accounts c
		where    
        		a.trader_id = b.trader_id
		and
        		b.source_id = ba.source_id
		and
        		a.tico_account_id = c.account_id
		and
        		ba.name = @source
		and 
        		b.symbol = @cli_lookup_trader
		
		if @cli_trader_id = NULL or @cli_trader_login = NULL
		begin
    			select
            			@cli_trader_id = a.trader_id,
            			@cli_trader = a.symbol,
            			@cli_trader_login = c.login,
            			@cli_external_account_id = a.external_account_id
    			from
            			traders a,
            			tico_accounts c
    			where    
            			a.tico_account_id = c.account_id
    			and 
            			a.symbol = @cli_lookup_trader
		
    			if @cli_trader_id = NULL or @cli_trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @cli_lookup_trader, '" + @cli_lookup_trader + "'",
            			cli_lookup_trader = @cli_lookup_trader
        			return
    			end		
		end
		
		/*
 		* LOOKUP @cli_counterparty_id, @cli_counterparty_symbol, @cli_cpty_ext_acct_id from @cli_lookup_cpty
 		*/
		
		select
			@cli_counterparty_id = a.counterparty_id,
			@cli_counterparty = a.name,
			@cli_cpty_ext_acct_id = a.external_account_id
		from
        		counterparties a,
        		counterparty_symbols b,
        		sources ba
		where
        		a.counterparty_id = b.counterparty_id
		and
        		b.source_id = ba.source_id
		and
        		ba.name = @source
		and
        		b.symbol = @cli_lookup_cpty
		if @cli_counterparty = NULL
		begin
        		select
                		@cli_counterparty_id = a.counterparty_id,
				@cli_counterparty = a.name,
				@cli_cpty_ext_acct_id = a.external_account_id
        		from
                		counterparties a
        		where
                		a.name = @cli_lookup_cpty
        		
        		if @cli_counterparty = NULL
        		begin
                		select
                        		status = "Error",
                        		message = "Couldn't find counterparty for @cli_lookup_cpty, '" + @cli_lookup_cpty + "'",
					cli_lookup_cpty = @cli_lookup_cpty
                		return
        		end
		end
		
		
		/*
 		* LOOKUP @cli_external_account, @cli_external_account_type based on @cli_external_account_id
 		*/
		select
    			@cli_external_account = a.symbol,
    			@cli_external_account_type = b.name,
    			@cli_aggregation_style = c.name
		from
    			external_accounts a,
    			external_account_types b,
    			aggregation_styles c
		where
    			a.external_account_type_id = b.external_account_type_id
		and
    			a.aggregation_style_id = c.aggregation_style_id
		and
    			a.external_account_id = @cli_external_account_id
		if @cli_external_account = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find external_account from @cli_external_account_id",
				cli_external_account_id = @cli_external_account_id
			return
		end
	end
	
	

	select
                @deal_id = deal_id
        from
                deal_exec_symbols
        where
                symbol = @deal_exec_symbol

	
	if @deal_id = NULL
	begin
		select
			msg = "Creating new deal"
		
		select
			@deal_status_id = status_id
		from
			statuses
		where
			name = "User Review"
		if @deal_status_id = NULL
		begin
			select
				status = "Error",
				message = "No status found named, 'User Review'"
			return
		end
		select
			@deal_type_id = deal_type_id
		from
			deal_types
		where
			name = @deal_type
		if @deal_type_id = NULL
		begin
			select
				status = "Error",
				message = "No deal type found for @deal_type",
				deal_type = @deal_type
			return	
		end
	
		exec
			j_nextkey
				"deals",
				@deal_id output
	
		insert into
			deals(
				deal_id,   
				deal_type_id,
				timestamp,  
				status_id  
		 		)      
			values( 
				@deal_id,
				@deal_type_id,
				getdate(),
				@deal_status_id
				)
    	
    		insert into
			deal_exec_symbols
		values(
			@deal_id,
			@deal_exec_symbol
    			)
	end
	else
	begin
		select
			msg = "Appending to existing deal"
	
		/*  Below to support management of deal_type. 
	    	This tally is currently purposed for B2B deals. This will be inserted B2B */	
		/*
        	select
                	@deal_type_id = deal_type_id
        	from
                	deal_types
        	where
                	name = 'B2B Forward'
        	if @deal_type_id = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "No deal type found for 'B2B Forward'"
                	return
        	end
	
		update
			deals
		set
			deal_type_id = @deal_type_id
		where
			deal_id = @deal_id
		*/
	end
			
	if @cli_trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @cli_trader_login,
				@source = @source,
				@trade_id = @cli_trade_id out,
				@deal_id = @deal_id out,
				@tally_type = @tally_type,
				@deal_type = @deal_type,
				@trade_type = @trade_type,
				@external_account = @cli_external_account,
				@counterparty = @cli_counterparty,
				@quantity = @cli_quantity,
				@symbol = @contract_symbol,
				@value_date = @value_date,
				@price = @cli_price,
				@trade_date = @trade_date,
				@trader = @cli_trader,
				@broker = @broker,
				@identifier = @cli_trade_identifier,
				@spot_reference = @cli_quoted_price
	
		if @cli_trade_id = NULL
		begin
			select
				status = "Error",
				message = "Failed to tally trade"
			return
		end

	
		insert into
			trade_quoted_prices (	trade_id,
						price)
			values(
				@cli_trade_id,
				@cli_quoted_price
				)
	
		exec
			r_inserttradenotification
						@cli_trade_id
		select
			@cli_tallied = 1
	end
	
	if @cl_create = "Y" or @lp_create = "Y"
	begin
		if @cl_create = "Y"
		begin
				
			select
				@t2_cl_ext_account = cl_ext_account,
				@t2_cl_trader = cl_trader,
				@t2_cl_counterparty = cl_counterparty,
				@t2_cl_inv_qty = cl_inv_qty
			from
				ticket_creation_values
			where
	        		trigger_symbol = @trigger_symbol
	
			select
				@t2_cl_identifier = rtrim(@cli_trade_identifier)+".t2cl_autob2b",
                       		@t2_cl_quantity = @cli_quantity
	
				
			if @t2_cl_inv_qty = "Y"
			begin
				select
					@t2_cl_quantity = -@cli_quantity
			end
	
			exec
				fxa_tallytrade
					@login = @cli_trader_login,
					@source = @source,
					@trade_id = @t2_cl_trade_id out,
					@deal_id = @deal_id out,
					@tally_type = @trade_type,
					@deal_type = @deal_type,
					@trade_type = @trade_type,
					@external_account = @t2_cl_ext_account,
					@counterparty = @t2_cl_counterparty,
					@quantity = @t2_cl_quantity,
					@symbol = @contract_symbol,
					@value_date = @value_date,
					@price = @cli_price,
					@trade_date = @trade_date,
					@trader = @t2_cl_trader,
					@broker = @broker,
					@identifier = @t2_cl_identifier,
					@spot_reference = @cli_quoted_price
	
	
			if @t2_cl_trade_id = NULL
			begin
    				select
       					status = "Error",
       					message = "Failed to tally trade"
    				return
			end
		
	
			exec
   					r_inserttradenotification
       					@t2_cl_trade_id
	
			select
       				status = "Tallied",
       				message = "Trade successfully tallied",
       				trade_id = @t2_cl_trade_id,
       				deal_id = @deal_id,
       				account = @t2_cl_ext_account,
       				symbol = @contract_symbol,
       				quantity = @t2_cl_quantity,
       				price = @cli_price,
       				val_date = @value_date
 	
			
	
		end
		if @lp_create = "Y"
		begin
	
               		select
                       		@t2_lp_ext_account = lp_ext_account,
                       		@t2_lp_trader = lp_trader,
                       		@t2_lp_counterparty = lp_counterparty,
				@t2_lp_inv_qty = lp_inv_qty
               		from
                       		ticket_creation_values
               		where
                       		trigger_symbol = @trigger_symbol
	
               		select
                       		@t2_lp_identifier = rtrim(@cli_trade_identifier)+".t2lp_autob2b",
				@t2_lp_quantity = @cli_quantity
	
               		if @t2_lp_inv_qty = "Y"
               		begin
                       		select
                               		@t2_lp_quantity = -@cli_quantity
               		end
			
			if @cl_create = "Y"
			begin
				select
					@t2_deal_id = @auto_b2b_deal_id
			end
			else
			begin
				select
					@t2_deal_id = @deal_id
			end
               		exec
                       		fxa_tallytrade
                               		@login = @cli_trader_login,
                               		@source = @source,
                               		@trade_id = @t2_lp_trade_id out,
                               		@deal_id = @t2_deal_id out,
                               		@tally_type = @trade_type,
                               		@deal_type = @deal_type,
                               		@trade_type = @trade_type,
                               		@external_account = @t2_lp_ext_account,
                               		@counterparty = @t2_lp_counterparty,
                               		@quantity = @t2_lp_quantity,
                               		@symbol = @contract_symbol,
                               		@value_date = @value_date,
                               		@price = @cli_price,
                               		@trade_date = @trade_date,
                               		@trader = @t2_lp_trader,
                               		@broker = @broker,
                               		@identifier = @t2_lp_identifier,
                               		@spot_reference = @cli_quoted_price
	
	
               		if @t2_lp_trade_id = NULL
               		begin
                       		select
                               		status = "Error",
                               		message = "Failed to tally trade"
                       		return
               		end
	
	
               		exec
                       		r_inserttradenotification
                               		@t2_lp_trade_id
	
               		select
                       		status = "Tallied",
                       		message = "Trade successfully tallied",
                       		trade_id = @t2_lp_trade_id,
                       		deal_id = @t2_deal_id,
                       		account = @t2_lp_ext_account,
                       		symbol = @contract_symbol,
                       		quantity = @t2_lp_quantity,
                       		price = @cli_price,
                       		val_date = @value_date
	
		end
	end

	/*
 	* AUTOCOMMIT
 	*
 	* If there is a client trade in this deal and the account type is set for
 	* Autocommit, then push through this deal automatically.
 	*/

	if @deal_id != NULL and @cli_trade_id != NULL and @cli_aggregation_style = "Autocommit"
	begin
	
    		update
        		deals
    		set
        		status_id = @committed_status_id
    		where
        		deal_id = @deal_id
    		if @@rowcount != 1
    		begin
        		select
            		status = "Error",
            		message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @cli_external_account + "', an aggregation style, '" + @cli_aggregation_style + "'"
    		end
	end
	else
	begin
    		select
        		message = "No autocommitted",
        		deal_id = @deal_id,
        		trade_id = @cli_trade_id,
        		aggregation_style = @cli_aggregation_style
	end
	
	if @cli_tallied != NULL
	begin
		select
        		status = "Tallied",
        		message = "Trade successfully tallied",
        		trade_id = @cli_trade_id,
        		deal_id = @deal_id,
        		account = @cli_external_account,
			trader = @cli_trader,
        		cpty = @cli_counterparty,
        		symbol = @contract_symbol,
        		quantity = @cli_quantity,
        		price = @cli_price,
        		val_date = @value_date
	
	end
end


 /*
 * Acknoweldge this trade report
 */
select
    trade_report_id=@trade_report_id,
    symbol=@symbol,
    exec_type="TRADE"

/* ### DEFNCOPY: END OF DEFINITION */
