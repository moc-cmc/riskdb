
create or replace procedure
	tts_oandahedgertally
		@source varchar(50), /* Provided by FIX server config.properties & spring.xml */
		@default_login varchar(50),
		@broker varchar(50)=NULL,
		@msg_type varchar(50)=NULL, /* identifiers */
		@transaction_id varchar(50)=NULL,
		@deal_reference varchar(50)=NULL,
		@ccy1 varchar(50),
		@ccy2 varchar(50),
		@qty varchar(50),
		@price varchar(50),
		@trade_date varchar(50),
		@value_date varchar(10),
		@fixing_date varchar(10)=NULL,
		@oa_lp varchar(50)=NULL,
		@oa_pb varchar(50)=NULL,
		@oa_account varchar(50)=NULL,
		@oa_username varchar(50)=NULL,
		@far_value_date varchar(10)=NULL,
		@far_price varchar(50)=NULL,
		@to_oa_lp varchar(50)=NULL,
		@to_oa_pb varchar(50)=NULL,
		@to_oa_account varchar(50)=NULL,
		@method varchar(50)=NULL
as


declare @book_switch char(1)
declare @client_or_market char(1)
declare @platform_identifier varchar(100)
declare @far_platform_identifier varchar(100)
declare @deal_exec_symbol varchar(100)

declare @broker_id int
declare @source_id int
declare @trade_id int
declare @deal_id int

declare @fund_agency_lookup varchar(30)
declare @is_fund_agency char(1)

declare @flip_quantity numeric(30, 2)
declare @quantity numeric(30, 2)
declare @far_quantity numeric(30, 2)
declare @contract varchar(20)

declare @prime_broker_lookup varchar(50)
declare @trader_lookup varchar(50)
declare @counterparty_lookup varchar(50)
declare @mapping_error_id int
declare @trader_id int
declare @counterparty_id int
declare @trader_mapping_error_id int
declare @cpty_mapping_error_id int
declare @trader_external_account_id int
declare @cpty_external_account_id int
declare @ea_external_account_id int
declare @ea_external_account varchar(50)
declare @ea_external_account_type varchar(50)
declare @ea_aggregation_style varchar(50)
declare @external_account varchar(50)
declare @suppress_trade varchar(50)
declare @suppression_lookup varchar(50)
declare @ack_required varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @lookup_trader varchar(50)
declare @counterparty varchar(50)
declare @external_account_id int
declare @external_account_type varchar(50)
declare @trader_login varchar(50)
declare @trader varchar(50)
declare @far_trade_id int
declare @far_trade_type varchar(50)
declare @deal_status varchar(50)
declare @aggregation_style varchar(50)
declare @last_spot_rate float
declare @contract_id int
declare @inverted varchar(50)
declare @tally_status varchar(50)
declare @tally_message varchar(50)
declare @trigger_symbol varchar(50)
declare @symbol varchar(50)
/* convert string params */
declare @tally_qty numeric(30, 4)
declare @tally_price float
declare @tally_cover_price float
declare @tally_trade_date datetime
declare @tally_trade_day datetime
declare @tally_value_date datetime
declare @tally_fixing_date datetime
declare @tally_far_quantity numeric(30, 4)
declare @tally_far_price float
declare @tally_far_cover_price float
declare @tally_far_value_date datetime
declare @tally_far_fixing_date datetime
declare @individual_swap_legs char(1)
declare @swap_symbol_id int
declare @swap_symbol varchar(50)
declare @strategy_id int
declare @strategy varchar(50)
declare @strategy_lookup varchar(50)
declare @sales_code_id int
declare @sales_code varchar(50)
declare @sales_code_lookup varchar(50)
declare @leg_number varchar(50)
declare @ttl float
declare @waitfor_delay varchar(11)
declare @deal_exec_symbol_eb_to_pb varchar(100)
declare @should_tally_eb_to_pb char(1)
declare @should_tally_eb_to_pb_ls char(1)
declare @eb_to_pb_trader varchar(50)
declare @eb_to_pb_trader_ls varchar(50)
declare @should_tally_eb_to_pb_tfx char(1)
declare @to_quantity numeric(30, 4)
declare @switch_trade_id int
declare @to_trade_id int
declare @future_lookup varchar(100)
declare	@provided_value_date datetime



select
	@ack_required = "N"


/* --------------------------------------------------------------------------
 * STEP: Initial MAP proc parameters to common tally params
 * It may be that additional parameters are mapped further down in the 
 * stored procedure based on the result of @client_or_market
 */
select
	@tally_qty = convert(numeric(30, 4), @qty),
	@tally_price = convert(float, @price),
	@tally_trade_date = dbo.f_utctoeastern(convert(datetime, @trade_date)),
	@tally_value_date = convert(datetime, @value_date),
	@tally_fixing_date = convert(datetime, @fixing_date),
	@tally_far_value_date = convert(datetime, @far_value_date),
	@tally_far_price = convert(float, @far_price)



/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified. This tally will 
 * autocreate brokers and tie them back to the single source via source_id in
 * brokers table via tt_resolvesourcebroker
 */

select
	@broker = "Oanda Hedger",
	@source = "Oanda Hedger"

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @broker_id = NULL
begin
	select
		status = "Error",
		error = "Error",
		message = "broker not found",
		broker = @broker
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "source not found",
                source = @source
        return
end


/* --------------------------------------------------------------------------
 * STEP: Eval client or market
 * Determine if the trade is a client trade or if the trade is a market trade
 * some platforms provide an explicit tag. evaluate that tag here and set 
 * @client_or_market to either "C" or "M". Raise an error message if you can't
 * determine. If no tag (or combination of tags) are provided, then set the
 * the @client_or_market_lookup and check to see if it maps to a fund agency 
 * counterparty by calling tt_isfundagency. 
 * This logic usually differs platform by platform
 *
 */ 

select
	@client_or_market = "M"

/* --------------------------------------------------------------------------
 * STEP: Eval message type for switches
 * If the trade is a switch, it is likely coming back from the oanda hedger
 * and we do not want to book it. To transitio to prod, we need a toggle
 * on booking switches
 */

select
	@book_switch = "N"

if @book_switch = "N" and @msg_type = "switch"
begin
	select
		status = "Error",
		message = "Not able to book switch yet, will change this to not be an error later"
	return
end

/* --------------------------------------------------------------------------
 * STEP: Map proc parameters to common tally variable name
 * This mapping allows us to use common variable names in all tallies. It also
 * helps with debugging, as you can look here to see what is mapped
 * For multi-prime setups that don't have a pb tag, set the prime_broker_lookup to ""
 *
 */
select
	@platform_identifier = rtrim(@transaction_id),
	@far_platform_identifier = rtrim(@transaction_id)+".f",
	@deal_exec_symbol = rtrim(@deal_reference)

if @deal_reference in(NULL, "RESIDUAL")
begin
	select
		@deal_exec_symbol = rtrim(@transaction_id)+".d"
end

if @msg_type = "swap"
begin
	select 
		@oa_pb = @oa_lp
end

select
	@counterparty_lookup = rtrim(@oa_account)+"-"+rtrim(@oa_pb)+"-"+@oa_lp,
        @trader_lookup = rtrim(@oa_username)

if @msg_type = "trade"
begin
	if @method = "QUICK"
	begin
		select
			@trader_lookup = "autohedger"
	end
end

if @msg_type = "switch"
begin
	select
		@counterparty_lookup = rtrim(@to_oa_account)+"-"+rtrim(@to_oa_pb)+"-"+@to_oa_lp
end

select
	@suppression_lookup = @counterparty_lookup,
	@trigger_symbol = @counterparty_lookup
	



/* --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 * |     WARNING ------- WARNING -------- WARNING -------- WARNING          |
 * |                                                                        |
 * |                                                                        |
 * |  Do not make changes below this point                                  |
 * |  If you make changes, place comments about what was changed.           |
 * |                                                                        |
 * |                                                                        |
 * --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 */

/* CHANGE COMMENTS:
 *
 */



/* --------------------------------------------------------------------------
 * STEP: Dupe check on the identifier 
 *
 */

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@platform_identifier,
		@trade_id=@trade_id output

if @trade_id != NULL
begin
        if @ack_required = "Y"
        begin
                select
                        trade_report_id=@platform_identifier,
                        symbol=@symbol,
			exec_type="TRADE"
        end
	return
end



/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error. 
 */
exec
        ag_pendingmappingerrors
                @login = @default_login,
                @broker_id = @broker_id,
                @identifier = @platform_identifier,
                @trader_mapping_error_id = @trader_mapping_error_id output,
                @cpty_mapping_error_id = @cpty_mapping_error_id output

exec
        tt_resolvetradermapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@platform_identifier,
                @mapping_error_id=@trader_mapping_error_id,
                @mapping=@trader_lookup,
                @trader_id=@trader_id output,
                @trader=@trader output,
                @trader_login=@trader_login output,
                @external_account_id=@trader_external_account_id output

exec
        tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@platform_identifier,
                @mapping_error_id=@cpty_mapping_error_id,
                @mapping = @counterparty_lookup,
                @counterparty_id=@counterparty_id output,
                @counterparty=@counterparty output,
                @cpty_external_account_id=@cpty_external_account_id output


if @trader_id = NULL
begin
	select 
		status = "Error",
		error = "Error",
		message = "trader mapping error trade not processed"
        return
end

if @counterparty_id = NULL
begin
	select 
		status = "Error",
		error = "Error",
		message = "counterparty mapping error trade not processed"
        return
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from the trader or counterparty, 
 *
 * On a client trade, the external account is determined by the trader
 * On a market trade, the external account is determined by the counterparty
 */

if @client_or_market = "C"
begin
	select
		@external_account_id = @trader_external_account_id
end
else /* @client_or_market = "M" */
begin
	select
		@external_account_id = @cpty_external_account_id
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from mapped symbol 
 * 
 * If a symbol exists, then overwrite whatever was determined by the counterparty or trader.
 * Since a mapping is not required, send @mapping_error_id = 0 so that we do not send a message
 */
/* - for now, dont worry about any external account mappings. Might add back in later
exec
	tt_resolveextacctmapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
		@identifier=@platform_identifier,
		@mapping_error_id=0, /* sending as 0 will ensure a message is never sent */
		@external_account_id = @ea_external_account_id output,
		@external_account = @ea_external_account output,
		@external_account_type=@ea_external_account_type output,
		@aggregation_style=@ea_aggregation_style output
*/

if @ea_external_account_id != NULL
begin
	select
		@external_account_id =  @ea_external_account_id,
                @external_account = @ea_external_account,
                @external_account_type = @ea_external_account_type,
                @aggregation_style = @ea_aggregation_style
end
else
begin
	select
                @external_account = a.symbol,
                @external_account_type = b.name,
                @aggregation_style = c.name
	from
		external_accounts a,
		external_account_types b,
		aggregation_styles c
	where
		a.external_account_type_id = b.external_account_type_id
	and
		a.aggregation_style_id = c.aggregation_style_id
	and
		a.external_account_id = @external_account_id
end



/* --------------------------------------------------------------------------
 * STEP: Check for suppression 
 *
 */
select
	@suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id
and
	symbol = @suppression_lookup

if @counterparty_lookup = "OAU-CIF-CIF"
begin
	select
		status = "Success",
		message = "Suppresssed OAU-CIF-CIF"
	return
end

if @deal_reference = "RESIDUAL"
begin
	select
		status = "Success",
		message = "Suppressed RESIDUAL trade based on deal reference field",
                platform_identifier = @platform_identifier,
                source = @source
	return
end


if @suppress_trade = "Y"
begin
	select
		status = "Suppressing trade",
		platform_identifier = @platform_identifier,
		source = @source,
		suppression_lookup = @suppression_lookup

	if @ack_required = "Y"
	begin
        	select
                	trade_report_id=@platform_identifier,
                	symbol=@symbol,
                	exec_type="TRADE"
		return
	end
	return
end

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 *
 */

select
	@deal_type = "Market Forward",
	@trade_type = "Spot",
	@tally_type = "Spot"


if @fixing_date != NULL
	select
		@trade_type = "Forward",
		@tally_type = "Forward"

if @tally_far_price != NULL
	select
		@deal_type = "Market Swap",
		@tally_type = "Swap",
		@trade_type = "Swap Near",
		@far_trade_type = "Swap Far"

if @oa_pb = "UBSF"
begin
	select
		@deal_type = "Market Future",
		@trade_type = "Future",
		@tally_type = "Future"
end



/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * 
 * This tally supports many different types of flows. One flow is Internal trades
 * that transfer strategies. The adaptor calling this proc is async so we don't
 * know the ordering in which we will make the 2 calls. Therefore, on the 2ng leg of
 * an internal trade, we implement a time to live (ttl) loop to re-check for the deal
 * grouping id. 
 */



exec
	tt_resolvedeal
		@deal_exec_symbol = @deal_exec_symbol,
		@deal_id = @deal_id output,
		@deal_type = @deal_type output,
		@deal_status = @deal_status output
if @deal_id = NULL
begin
	exec
		tt_newdeal
			@deal_type = @deal_type,
			@deal_status = @deal_status,
			@deal_exec_symbol = @deal_exec_symbol,
			@deal_id = @deal_id output
end


/* --------------------------------------------------------------------------
 * STEP: Determine the contract
 *
 */

if @tally_type != "Future"
begin
	exec
		r_validateccypair
			@login=@default_login,
			@symbol=@symbol,
			@ccy1=@ccy1,
			@ccy2=@ccy2,
			@contract_id = @contract_id output,
			@contract = @contract output,
			@inverted = @inverted output
end
else
begin
	
	select
		@future_lookup = rtrim(@ccy1)+rtrim(@ccy2)+convert(varchar(8), convert(datetime, @tally_value_date), 112)
	select
        	@contract_id = b.contract_id,
        	@contract = b.symbol
	from
        	contract_symbols a,
        	contracts b
	where
        	a.contract_id = b.contract_id 
	and
        	a.source_id = @source_id
	and
		a.symbol = @future_lookup
	
	if @contract_id = NULL
	begin
		select
			status = "Error",
			message = "Problem finding contract",
			future_lookup = @future_lookup,
		 	value_date = @value_date
		return
	end

	select
		@provided_value_date = @value_date

	select
		@tally_value_date = expiration
	from
		future_contracts
	where
		contract_id = @contract_id
end	

/* --------------------------------------------------------------------------
 * STEP: In process of decomissioning the hedger, swaps will be booked by 
 * 360T. Metals will remain booked by hedger
 */

/* Un-Comment this out for release */
create table
	#metals(
		symbol varchar(15)
)
insert into
	#metals
select
	symbol = a.symbol
from
	products a,
	metal_ccys b
where
	a.product_id = b.product_id

if @tally_type = "Swap"
begin
	if @ccy1 not in(select symbol from #metals) and @ccy2 not in(select symbol from #metals)
	begin
		select
			status = "Success",
			message = "Supressing a non metal swap that should be booked by 360T"
		return
	end
	else
	begin
		if @external_account in("OC DB FXPB", "OCAN DB FXPB", "OC SCB FXPB", "OCAN SCB FXPB", "OC UBS FXPB", "OCAN UBS FXPB")
		begin
			select
				status = "Success",
				message = "Supressing a metal swap that should be booked by DB Autobahn"
	         	return
		end
	end
	
end





/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the FIX message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund 
 * or agency so set the direction accordingly
 */
select
	@quantity = @tally_qty

if @msg_type = "swap"
begin
	/* Flip the quantity since oanda reporting swaps backwards*/
	select
		@quantity = @quantity * -1
end
else if @msg_type = "switch"
begin
	/* The first leg we book is the From counterparty, the second leg will
         * be the To counterparty */
	select
		@quantity = @quantity * -1
end

exec
	fxa_tallytrade
                @login = @trader_login,
                @source = @source,
                @trade_id = @trade_id out,
                @deal_id = @deal_id out,
                @tally_type = @tally_type,
                @deal_type = @deal_type,
                @trade_type = @trade_type,
                @external_account = @external_account,
                @counterparty = @counterparty,
                @quantity = @quantity,
                @symbol = @contract,
                @value_date = @tally_value_date,
                @fixing_date = @tally_fixing_date,
                @price = @tally_price,
                @trade_date = @tally_trade_date,
                @trader = @trader,
                @broker = @broker,
		@strategy = @strategy,
                @identifier = @platform_identifier,
                @spot_reference = @last_spot_rate,
		@sales_code = @sales_code,
		@mid_mark = @tally_cover_price

if @trade_id = NULL
begin
        select
                @tally_status = "Error",
                @tally_message = "Problem tallying trade"
end
else
begin
        select
                @tally_status = "Success",
                @tally_message = "Tallied trade"
end

select
        status = @tally_status,
        message = @tally_message,
        trade_id = @trade_id,
        login = @trader_login,
        source = @source,
        deal_id = @deal_id,
        tally_type = @trade_type,
        deal_type = @deal_type,
        trade_type = @trade_type,
        external_account = @external_account,
        counterparty = @counterparty,
        quantity = @quantity,
        symbol = @contract,
        value_date = @tally_value_date,
        fixing_date = @tally_fixing_date,
        price = @price,
        trade_date = @tally_trade_date,
        trader = @trader,
        broker = @broker,
        identifier = @platform_identifier,
        spot_reference = @last_spot_rate,
	mid_mark = @tally_cover_price

if @tally_status = "Error"
begin
        return
end

if @tally_far_price != NULL
begin
	select
		@far_quantity = @quantity * -1

	exec
        	fxa_tallytrade
                	@login = @trader_login,
                	@source = @source,
                	@trade_id = @far_trade_id out,
                	@deal_id = @deal_id out,
                	@tally_type = @tally_type,
                	@deal_type = @deal_type,
                	@trade_type = @far_trade_type,
                	@external_account = @external_account,
                	@counterparty = @counterparty,
                	@quantity = @far_quantity,
                	@symbol = @contract,
                	@value_date = @tally_far_value_date,
                	@fixing_date = @tally_fixing_date,
                	@price = @tally_far_price,
                	@trade_date = @tally_trade_date,
                	@trader = @trader,
                	@broker = @broker,
			@strategy = @strategy,
                	@identifier = @far_platform_identifier,
                	@spot_reference = @last_spot_rate,
			@sales_code = @sales_code,
			@mid_mark = @tally_cover_price
	
	if @far_trade_id = NULL
	begin
        	select
                	@tally_status = "Error",
                	@tally_message = "Problem tallying trade"
	end
	else
	begin
        	select
                	@tally_status = "Success",
                	@tally_message = "Tallied trade"
	end

	select
        	status = @tally_status,
        	message = @tally_message,
        	trade_id = @far_trade_id,
        	login = @trader_login,
        	source = @source,
        	deal_id = @deal_id,
        	tally_type = @far_trade_type,
        	deal_type = @deal_type,
        	trade_type = @trade_type,
        	external_account = @external_account,
        	counterparty = @counterparty,
        	quantity = @far_quantity,
        	symbol = @contract,
        	value_date = @tally_far_value_date,
        	fixing_date = @tally_fixing_date,
        	price = @far_price,
        	trade_date = @tally_trade_date,
        	trader = @trader,
        	broker = @broker,
        	identifier = @far_platform_identifier,
        	spot_reference = @last_spot_rate,
		mid_mark = @tally_cover_price
	
	if @tally_status = "Error"
	begin
        	return
	end

	exec
		tt_resolveswapsymbol
			@deal_id=@deal_id,
			@near_trade_id=@trade_id,
			@far_trade_id=@far_trade_id,
			@client_or_market="M"
end


if @msg_type = "switch"
begin
        select
                @to_quantity = @to_quantity * -1

        exec
                fxa_tallytrade
                        @login = @trader_login,
                        @source = @source,
                        @trade_id = @to_trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @tally_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @external_account,
                        @counterparty = @counterparty,
                        @quantity = @to_quantity,
                        @symbol = @contract,
                        @value_date = @tally_value_date,
                        @fixing_date = @tally_fixing_date,
                        @price = @tally_price,
                        @trade_date = @tally_trade_date,
                        @trader = @trader,
                        @broker = @broker,
                        @strategy = @strategy,
                        @identifier = @platform_identifier,
                        @spot_reference = @last_spot_rate,
                        @sales_code = @sales_code,
                        @mid_mark = @tally_cover_price

        if @to_trade_id = NULL
        begin
                select
                        @tally_status = "Error",
                        @tally_message = "Problem tallying 'to' switch trade"
        end
        else
        begin
                select
                        @tally_status = "Success",
                        @tally_message = "Tallied trade"
        end

        select
                status = @tally_status,
                message = @tally_message,
                trade_id = @to_trade_id,
                login = @trader_login,
                source = @source,
                deal_id = @deal_id,
                tally_type = @trade_type,
                deal_type = @deal_type,
                trade_type = @trade_type,
                external_account = @external_account,
                counterparty = @counterparty,
                quantity = @to_quantity,
                symbol = @contract,
                value_date = @tally_value_date,
                fixing_date = @tally_fixing_date,
                price = @tally_price,
                trade_date = @tally_trade_date,
                trader = @trader,
                broker = @broker,
                identifier = @platform_identifier,
                spot_reference = @last_spot_rate,
                mid_mark = @tally_cover_price

        if @tally_status = "Error"
        begin
                return
        end

        exec
		j_nextkey
			"switch_trades",
			@switch_trade_id output

	if @to_quantity > 0
	begin
		insert into
			switch_trades(
				switch_trade_id,
				long_trade_id,
				short_trade_id)
		values(
			@switch_trade_id,
			@to_trade_id,
			@trade_id
		)
	end
	else
	begin
		insert into
			switch_trades(
				switch_trade_id,
				long_trade_id,
				short_trade_id)
		values(
			@switch_trade_id,
			@trade_id,
			@to_trade_id
		)
	end
end
		

