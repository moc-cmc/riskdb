
create or replace procedure
	adss_eodtransactionfiledrop	
		@login varchar(25),
		@source varchar(25),
		@transaction_date datetime=NULL
as

if @transaction_date = NULL
        /* runs on a 12pm-12pm schedule */
	select
		@transaction_date = convert(date, getdate())

create table
	#transaction_table (
		transaction_number int,
		line_number numeric(5,0) identity,
		default_currency varchar(20) NULL,
		account_category varchar(20) NULL,
		account_name varchar(50) NULL,
                account_type varchar(30) NULL,
   		debit_credit varchar(3) NULL,
		default_amount float NULL,
		note varchar(255) NULL )
		

insert into
	#transaction_table (
	 	transaction_number,
		default_currency,
		account_category,
		account_name,
		account_type,
		debit_credit,
		default_amount,
		note )
select
	a.account_transaction_id,
	b.symbol,
	c.name,
	d.name,
        e.name,
	"C",
	a.amount,
	a.note
from
	account_transactions a,
	products b,
	transaction_types c,
	external_accounts d,
        external_account_types e
where
	a.currency_id=b.product_id
and
	a.transaction_type_id=c.transaction_type_id
and
	a.external_account_id=d.external_account_id
and
	d.external_account_type_id = e.external_account_type_id
and
	convert(varchar(12), a.transaction_date, 112) = convert(varchar(12), @transaction_date, 112)

update
	#transaction_table
set
	debit_credit="D"
where
	default_amount < 0

update 
	#transaction_table
set
	default_amount = abs(default_amount)

