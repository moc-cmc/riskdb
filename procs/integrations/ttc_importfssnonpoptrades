create or replace procedure
	ttc_importfssnonpoptrades
		@login varchar(50),
		@tnum varchar(50)=NULL,
		@snum varchar(50)=NULL,
		@prod_type varchar(50)=NULL,
		@cparty varchar(50)=NULL,
		@bs char(1)=NULL,
		@cur varchar(3)=NULL,
		@cou_cur varchar(3)=NULL,
		@amount varchar(50)=NULL,
		@price varchar(50)=NULL,
		@tdate varchar(50)=NULL,
		@mat_date varchar(50)=NULL,
		@bank varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@fixing_date varchar(50)=NULL,
		@put_call varchar(15)=NULL,
		@strike varchar(50)=NULL,
		@premium_cur varchar(15)=NULL,
		@premium_amt varchar(50)=NULL,
		@value_date varchar(50)=NULL,
		@settle_date varchar(50)=NULL,
		@cut_time varchar(25)=NULL

as


declare @tally_amount numeric(30, 4)
declare @tally_price float
declare @quantity numeric(30, 4)
declare @trade_date datetime
declare @tally_value_date datetime
declare @mature_date datetime
declare @tally_fixing_date datetime
declare @last_spot_rate float
declare @ccy1 varchar(50)
declare @ccy2 varchar(50)
declare @side varchar(10)
declare @opt_settle_date datetime
declare @opt_prem_date datetime
declare @opt_exp_date datetime
declare @opt_strike_price float
declare @opt_pct_price float
declare @opt_spot_ref float
declare @opt_prem_amount numeric(30, 8)
declare @timezone varchar(50)
declare @timezone_symbol varchar(50)



declare @platform_identifier varchar(100)
declare @default_login varchar(50)
declare @source varchar(50)
declare @broker varchar(50)
declare @source_id int
declare @broker_id int
declare @trade_identifier varchar(100)
declare @trade_id int
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @tally_status varchar(10)
declare @tally_message varchar(25)
declare @external_account varchar(50)
declare @counterparty varchar(50)
declare @cpty_external_account_id int
declare @external_account_type varchar(50)
declare @suppress_trade varchar(50)
declare @ack_required varchar(50)
declare @trade_report_id varchar(50)
declare @aggregation_style varchar(50)
declare @suppression_lookup varchar(50)
declare @contract_id int
declare @trader_id int
declare @trader_login varchar(50)
declare @trader_lookup varchar(50)
declare @trader_mapping_error_id int
declare @trader_external_account_id int
declare @counterparty_id int
declare @counterparty_lookup varchar(50)
declare @cpty_mapping_error_id int
declare @external_account_id int
declare @deal_id int
declare @deal_exec_symbol varchar(100)
declare @deal_type varchar(50)
declare @deal_status varchar(50)
declare @contract varchar(20)
declare @inverted varchar(50)
declare @symbol varchar(50)
declare @swap_symbol varchar(50)
declare @swap_symbol_id int
declare @swap_near_id int
declare @swap_far_id int
declare @is_int_roll char(1)
declare @tallied_swap_leg_id int
declare @tallied_leg_val_date datetime 
declare @client_or_market char(1)
declare @is_spot_trade char(1)
declare @strategy varchar(50)

declare @fund_agency_lookup varchar(10)
declare @is_fund_agency varchar(10)
declare @waitfor_delay varchar(20)

declare @m_client_or_market char(1)
declare @m_platform_identifier varchar(100)
declare @m_far_platform_identifier varchar(100)
declare @m_deal_exec_symbol varchar(100)

declare @m_broker_id int
declare @m_source_id int
declare @m_trade_id int
declare @m_deal_id int

declare @m_fund_agency_lookup varchar(30)
declare @m_is_fund_agency char(1)

declare @m_quantity float
declare @m_far_quantity numeric(30, 2)
declare @m_contract varchar(20)

declare @m_prime_broker_lookup varchar(50)
declare @m_trader_lookup varchar(50)
declare @m_counterparty_lookup varchar(50)
declare @m_trader_mapping_error_id int
declare @m_cpty_mapping_error_id int
declare @m_trader_id int
declare @m_counterparty_id int
declare @m_trader_external_account_id int
declare @m_cpty_external_account_id int
declare @m_ea_external_account_id int
declare @m_ea_external_account varchar(50)
declare @m_ea_external_account_type varchar(50)
declare @m_ea_aggregation_style varchar(50)
declare @m_external_account varchar(50)
declare @m_suppress_trade varchar(50)
declare @m_suppression_lookup varchar(50)
declare @m_ack_required varchar(50)
declare @m_deal_type varchar(50)
declare @m_trade_type varchar(50)
declare @m_tally_type varchar(50)
declare @m_lookup_trader varchar(50)
declare @m_counterparty varchar(50)
declare @m_external_account_id int
declare @m_external_account_type varchar(50)
declare @m_trader_login varchar(50)
declare @m_trader varchar(50)
declare @m_far_trade_id int
declare @m_far_trade_type varchar(50)
declare @m_deal_status varchar(50)
declare @m_aggregation_style varchar(50)
declare @m_contract_id int
declare @m_inverted varchar(50)
declare @m_tally_status varchar(10)
declare @m_tally_message varchar(25)
declare @m_far_tally_status varchar(10)
declare @m_far_tally_message varchar(25)


declare @c_client_or_market char(1)
declare @c_platform_identifier varchar(100)
declare @c_far_platform_identifier varchar(100)
declare @c_deal_exec_symbol varchar(100)

declare @c_broker_id int
declare @c_source_id int
declare @c_trade_id int
declare @c_deal_id int

declare @c_fund_agency_lookup varchar(30)
declare @c_is_fund_agency char(1)

declare @c_quantity float
declare @c_far_quantity numeric(30, 2)
declare @c_contract varchar(20)

declare @c_prime_broker_lookup varchar(50)
declare @c_trader_lookup varchar(50)
declare @c_counterparty_lookup varchar(50)
declare @c_trader_mapping_error_id int
declare @c_cpty_mapping_error_id int
declare @c_trader_id int
declare @c_counterparty_id int
declare @c_trader_external_account_id int
declare @c_cpty_external_account_id int
declare @c_ea_external_account_id int
declare @c_ea_external_account varchar(50)
declare @c_ea_external_account_type varchar(50)
declare @c_ea_aggregation_style varchar(50)
declare @c_external_account varchar(50)
declare @c_suppress_trade varchar(50)
declare @c_suppression_lookup varchar(50)
declare @c_ack_required varchar(50)
declare @c_deal_type varchar(50)
declare @c_trade_type varchar(50)
declare @c_tally_type varchar(50)
declare @c_lookup_trader varchar(50)
declare @c_counterparty varchar(50)
declare @c_external_account_id int
declare @c_external_account_type varchar(50)
declare @c_trader_login varchar(50)
declare @c_trader varchar(50)
declare @c_far_trade_id int
declare @c_far_trade_type varchar(50)
declare @c_deal_status varchar(50)
declare @c_aggregation_style varchar(50)
declare @c_contract_id int
declare @c_inverted varchar(50)
declare @c_tally_status varchar(10)
declare @c_tally_message varchar(25)
declare @c_far_tally_status varchar(10)
declare @c_far_tally_message varchar(25)
declare @single_ticket varchar(10)

declare @c_status varchar(50)


if @prod_type = "MADJ"
begin
	return
end

/* PB customer tallies are different than standard FIX connection for Agency Flow 
* this fix connection is NOT AN ELYSIUM CUSTOMER'S FIX CONNECTION, this is the FIX connection of our
* client's client. Therefore, we book two trades for every ONE message we recieve. One trade
* to represent our customer vs their customer and one trade to represent our customer vs their customers' lp */

/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */

select
        @source = "Spectrum NonPOP",
        @broker = "Spectrum"

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
	@source_id = source_id
from
	sources
where
	name = @source


/* --------------------------------------------------------------------------

 * STEP: Initial MAP proc parameters to common tally params
 * It may be that additional parameters are mapped further down in the
 * stored procedure based on the result of @client_or_market
 */


/* --------------------------------------------------------------------------
 * STEP: Eval client or market
 * Determine if the trade is a client trade or if the trade is a market trade
 * some platforms provide an explicit tag. evaluate that tag here and set
 * @client_or_market to either "C" or "M". Raise an error message if you can't
 * determine. If no tag (or combination of tags) are provided, then set the
 * the @client_or_market_lookup and check to see if it maps to a fund agency
 * counterparty by calling tt_isfundagency.
 * This logic usually differs platform by platform
 *
 */


/* --------------------------------------------------------------------------
 * STEP: Convert parameters to appropriate datatypes
 */

select
	@tally_amount = abs(convert(numeric(30, 4), @amount)),
	@tally_price = convert(float, @price),
	@trade_date = convert(datetime, @tdate),
	@tally_value_date = convert(datetime, @mat_date),
	@tally_fixing_date = convert(datetime, @fixing_date),
	@opt_settle_date = convert(datetime, @value_date),
	@opt_prem_date = convert(datetime, @settle_date),
	@opt_prem_amount = abs(convert(numeric(30, 8), @premium_amt)),
	@opt_exp_date = @tally_value_date
	

select
        @quantity = @tally_amount,
        /*@tally_value_date = @mature_date,*/
        @ccy1 = @cur,
        @ccy2 = @cou_cur,
        @default_login=@login,
        @side=@bs

if @prod_type = "OPTION"
begin
        /* NOTE: we are using the strike price as the spot reference but that is
         *       not correct. Spectrum said they can not send a spot reference
         */

	/* Removing 1/100 logic on 5/12/19. Spectrum has corrected their file. WDD */
	/*
	if @ccy2 = @premium_cur
	begin
		select
			@opt_pct_price = @tally_price * (1.0/100),
			@opt_spot_ref = convert(float, @strike)
	end
	else
	*/

	select
		@opt_pct_price = @tally_price,
		@opt_spot_ref = convert(float, @strike)

end
	
	

/* --------------------------------------------------------------------------
 * STEP: Map proc parameters to common tally variable name
 * This mapping allows us to use common variable names in all tallies. It also
 * helps with debugging, as you can look here to see what is mapped
 */

/* This is pb cust reverse giveup flow. We expect only client trades over this
 * pipe, and we will create a back to back trade
 */

select	
	@client_or_market = "C"

if @cparty = NULL
begin
	select
		status = "Error",
		msg = "Counterparty provided was empty",
		cparty = @cparty
	return
end

/* Handle for cases where @bank is NULL in a BilateralPBClientTrades file */
if @bank = NULL and (@snum = "F1" or @snum = "N1")
begin
        select
                @bank=rtrim("JEFF EB")
end

if @bank = NULL and (@snum = "FW" or @snum = "SP")
begin
        select
                @single_ticket = "Y",
                @bank=rtrim("JEFFERIES")
end

if @bank = NULL and @snum = "1"
begin
	if @trader = "CORP"
	begin
		select
			@bank = "JEFF EB"
	end
	else
	begin
        	select
                	status = "Error",
                	error = "Error",
                	message = "bank should never be NULL on option exercise"
        	return
	end
end

/* C2C flow  */
if @bank = NULL and @snum = "0"
begin
	select
		@bank="C2C-"+rtrim(@trader)
end


select
        @deal_exec_symbol = rtrim(@tnum)

/*
select
	@c_platform_identifier = rtrim(@tnum)+"-"+rtrim(@snum)+".c",
	@c_trader_lookup =  rtrim(@cparty),
	@c_counterparty_lookup = rtrim(@bank),
        @m_platform_identifier = rtrim(@tnum)+"-"+rtrim(@snum)+".m",
        @m_counterparty_lookup = rtrim(@cparty)+"-"+rtrim(@bank),
        @m_trader_lookup = rtrim(@cparty)+"-"+rtrim(@cparty)
*/

select
        @c_platform_identifier = rtrim(@tnum)+"-"+rtrim(@snum)+".c",
        @c_trader_lookup =  rtrim(@cparty),
        @c_counterparty_lookup = rtrim(@bank),
        @m_platform_identifier = rtrim(@tnum)+"-"+rtrim(@snum)+".m",
        @m_counterparty_lookup = rtrim(@source)+"-"+rtrim(@bank),
        @m_trader_lookup = rtrim(@source)

if @single_ticket = "Y"
begin
       select
                @m_counterparty_lookup = "STATIC",
                @m_trader_lookup = "STATIC"
end


select
        @m_suppression_lookup = @m_counterparty_lookup,
	@c_suppression_lookup = @c_trader_lookup




/* --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 * |     WARNING ------- WARNING -------- WARNING -------- WARNING          |
 * |                                                                        |
 * |                                                                        |
 * |  Do not make changes below this point                                  |
 * |  If you make changes, place comments about what was changed.           |
 * |                                                                        |
 * |                                                                        |
 * --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 */

/* CHANGE COMMENTS:
 *
 */


/* --------------------------------------------------------------------------
 * STEP: Dupe check on the identifier
 */

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@c_platform_identifier,
		@trade_id=@c_trade_id output

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@m_platform_identifier,
		@trade_id=@m_trade_id output


if @c_trade_id != NULL and @m_trade_id != NULL
begin
	/* tt_isdupe would throw error message, just return */
	return
end


/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error. 
 */

/* Checking on client side */
exec
	ag_pendingmappingerrors
		@login = @default_login,
        	@broker_id = @broker_id,
        	@identifier = @c_platform_identifier,
        	@trader_mapping_error_id = @c_trader_mapping_error_id output,
		@cpty_mapping_error_id = @c_cpty_mapping_error_id output

exec
	tt_resolvetradermapping
		@login=@default_login,
		@source_id=@source_id,
		@source=@source,
		@broker_id=@broker_id,
		@identifier=@c_platform_identifier,
		@mapping_error_id=@c_trader_mapping_error_id,
		@mapping=@c_trader_lookup,
		@trader_id=@c_trader_id output,
		@trader=@c_trader output,
		@trader_login=@c_trader_login output,
		@external_account_id=@c_trader_external_account_id output

exec
	tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@c_platform_identifier,
                @mapping_error_id=@c_cpty_mapping_error_id,
		@mapping = @c_counterparty_lookup,
		@counterparty_id=@c_counterparty_id output,
		@counterparty=@c_counterparty output,
		@cpty_external_account_id=@c_cpty_external_account_id output

if @c_trader_id = NULL
begin
	select 
		status = "Error",
   		error = "Error",
   		message = "trader mapping error trade not processed for client side"
        return
end

if @c_counterparty_id = NULL
begin
	select 
		status = "Error",
		error = "Error",
		message = "counterparty mapping error trade not processed for client side"
        return
end

/* Checking on market side */
exec
        ag_pendingmappingerrors
                @login = @default_login,
                @broker_id = @broker_id,
                @identifier = @m_platform_identifier,
                @trader_mapping_error_id = @m_trader_mapping_error_id output,
                @cpty_mapping_error_id = @m_cpty_mapping_error_id output

exec
        tt_resolvetradermapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@m_platform_identifier,
                @mapping_error_id=@m_trader_mapping_error_id,
                @mapping=@m_trader_lookup,
                @trader_id=@m_trader_id output,
                @trader=@m_trader output,
                @trader_login=@m_trader_login output,
                @external_account_id=@m_trader_external_account_id output

exec
        tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@m_platform_identifier,
                @mapping_error_id=@m_cpty_mapping_error_id,
                @mapping = @m_counterparty_lookup,
                @counterparty_id=@m_counterparty_id output,
                @counterparty=@m_counterparty output,
                @cpty_external_account_id=@m_cpty_external_account_id output

if @m_trader_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "trader mapping error trade not processed for market side"
        return
end

if @m_counterparty_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "counterparty mapping error trade not processed for market side"
        return
end


/* --------------------------------------------------------------------------
 * STEP: Lookup external account from the trader or counterparty,
 *
 * On a client trade, the external account is determined by the trader
 * On a market trade, the external account is determined by the counterparty
 */

select
	@c_external_account_id = @c_trader_external_account_id,
	@m_external_account_id = @m_cpty_external_account_id


/* --------------------------------------------------------------------------
 * STEP: Lookup external account from mapped symbol 
 * 
 * If a symbol exists, then overwrite whatever was determined by the counterparty or trader.
 * Since a mapping is not required, send @mapping_error_id = 0 so that we do not send a message
 */

select
        @c_external_account = a.symbol,
        @c_external_account_type = b.name,
        @c_aggregation_style = c.name
from
        external_accounts a,
        external_account_types b,
        aggregation_styles c
where
        a.external_account_type_id = b.external_account_type_id
and
        a.aggregation_style_id = c.aggregation_style_id
and
        a.external_account_id = @c_external_account_id

select
        @m_external_account = a.symbol,
        @m_external_account_type = b.name,
        @m_aggregation_style = c.name
from
        external_accounts a,
        external_account_types b,
        aggregation_styles c
where
        a.external_account_type_id = b.external_account_type_id
and
        a.aggregation_style_id = c.aggregation_style_id
and
        a.external_account_id = @m_external_account_id



/* --------------------------------------------------------------------------
 * STEP: Check for suppression 
 *
 */
select
	@c_suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id
and
	symbol = @c_suppression_lookup

select
        @m_suppress_trade = "Y"
from
        suppression_symbols
where
        source_id = @source_id
and
        symbol = @m_suppression_lookup

if @c_suppress_trade = "Y" or @m_suppress_trade = "Y"
begin
	select
		status = "Suppressing trade",
		c_platform_identifier = @c_platform_identifier,
		m_platform_identifier = @m_platform_identifier,
		source = @source,
		c_suppression_lookup = @c_suppression_lookup,
		m_suppression_lookup = @m_suppression_lookup

	/* We may store this data later on, but for now we will return out of tally */
	return
end

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 *
 * The file we are loading from has 9 combinations. $2 = SNUM  $3 = PROD_TYPE
 * 
 * $ cat BilateralPBClientTrades_20190118_163822.csv | awk '{FS=","; print $2" "$3}' | sort -u
 * 0 FORWARD 
 * 0 NDF     
 * 0 OPTION  
 * 0 SPOT    
 * 1 SPOT    
 * F1 SWAPFAR 
 * FW SWAPFAR 
 * N1 SWAPNEAR
 * SP SWAPNEAR
 */

if @prod_type = "SPOT"
begin
        select
                @deal_type = "B2B Forward",
                @tally_type = "Spot",
                @trade_type = "Spot",
                @is_spot_trade = "Y"
end
else if @prod_type = "FORWARD"
begin
        select
                @deal_type = "B2B Forward",
                @tally_type = "Forward",
                @trade_type = "Forward",
                @is_spot_trade = "N"
end
else if @prod_type = "NDF"
begin
        select
                @deal_type = "B2B Forward",
                @tally_type = "Forward",
                @trade_type = "Forward",
                @is_spot_trade = "N"
end
else if @prod_type = "OPTION"
begin
        select
                @deal_type = "B2B Option",
                @tally_type = "Option",
                @trade_type = "Option",
                @is_spot_trade = "N"

end
else if @prod_type = "SWAPNEAR"
begin
        select
                @deal_type = "B2B Swap",
                @tally_type = "Swap",
                @trade_type = "Swap Near",
                @is_spot_trade = "N"
end
else if @prod_type = "SWAPFAR"
begin
        select
                @deal_type = "B2B Swap",
                @tally_type = "Swap",
                @trade_type = "Swap Far",
                @is_spot_trade = "N"
end


/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * 
 * Default all trades right now to assume a 'B2B *' deal type
 */

exec
    tt_resolvedeal
        @deal_exec_symbol = @deal_exec_symbol,
        @deal_id = @deal_id output,
        @deal_type = @deal_type output,
        @deal_status = @deal_status output

if @deal_id = NULL
begin
    exec
        tt_newdeal
            @deal_type = @deal_type,
            @deal_status = @deal_status,
            @deal_exec_symbol = @deal_exec_symbol,
            @deal_id = @deal_id output
end


/* --------------------------------------------------------------------------
 * STEP: Determine the contract
 *
 */

if @trade_type != "Option"
begin
	exec
    		r_validateccypair
        		@login=@default_login,
        		@symbol=@symbol,
        		@ccy1=@ccy1,
        		@ccy2=@ccy2,
        		@contract_id = @contract_id output,
        		@contract = @contract output,
        		@inverted = @inverted output
end
else
begin

	
	select
		@timezone_symbol  = @cut_time
	select
		@timezone = a.timezone
	from
		timezones a,
		timezone_symbols b,
		sources c
	where
		a.timezone_id = b.timezone_id
	and
		b.source_id = c.source_id
	and
		c.source_id = @source_id
	and
		b.symbol = @timezone_symbol
	if @timezone = NULL
	begin
		select
			status = "Error",
			msg = "No timezone mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@timezone_symbol) + "'"	
		return
	end
end



/* NOTE: Options wont use the above info for symbol or contract or anything*/


/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 *   convert 'L' (Long) into 'B' (Buy), for options
 */
if @side = "L"
begin
	select
		@side = "B"
end

if @client_or_market = "C"
begin
    if @side = "S"
        select
        	@c_quantity = @quantity * -1,
		@m_quantity = @quantity
           
    if @side = "B"
        select
		@c_quantity = @quantity,
                @m_quantity = @quantity * -1
end
else /* if @client_or_market = "M" */
begin
	if @side = "B"
        select
                @c_quantity = @quantity,
                @m_quantity = @quantity * -1

	if @side = "S"
        select
                @c_quantity = @quantity * -1,
                @m_quantity = @quantity


end

/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the FIX message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund 
 * or agency so set the direction accordingly

select
	@c_quantity = @quantity,
	@m_quantity = @quantity*-1

 */


/* --------------------------------------------------------------------------
