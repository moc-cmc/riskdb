                @source varchar(50),
                @default_login varchar(50),
                @broker varchar(50),
                @granularity varchar(15)=NULL,
                @sender_comp varchar(50),
                @target_comp varchar(50),
                @execution_id varchar(100)=NULL,
		@order_id varchar(100)=NULL,
		@cl_order_id varchar(100)=NULL, 
                @trade_report_id varchar(50),
		@cover_exec_id varchar(100)=NULL,
		@covered_exec_id varchar(100)=NULL,
                @symbol varchar(50)=NULL,
                @ccy1 varchar(50)=NULL,
                @ccy2 varchar(50)=NULL,
                @qty float,
		@counter_qty float=NULL,
                @price float,
		@last_spot_rate float=NULL,
                @side varchar(10),
                @trade_date datetime,
                @trade_day datetime,
                @value_date datetime,
		@fixing_date datetime=NULL,
		@trade_report_type varchar(50)=NULL,
		@trade_input_source varchar(50)=NULL,
		@security_type varchar(50)=NULL,
                @far_price float=NULL,
