
/* Converted ttc_bloombergtally to template style 
 * proc is still custom at this time 
*/


drop procedure ttc_bloombergtally 
go

create procedure
	ttc_bloombergtally	
		/* Provided by FIX server config.properties & spring.xml */
                @agent varchar(50),
		@source varchar(50),
                @default_login varchar(50),
                @broker varchar(50),
                @granularity varchar(15)=NULL,
                /* Parsed from FIX message and provided by mapping.xml */
                /* session variables */
                @sender_comp varchar(50),
                @target_comp varchar(50),
                /* identifiers */
                @execution_id varchar(100)=NULL,
                @trade_report_id varchar(50),
                @order_id varchar(50),
                @cl_order_id varchar(50)=NULL,
                @account varchar(50),
		/*financials*/
                @symbol varchar(50)=NULL,
                @ccy1 varchar(50)=NULL,
                @ccy2 varchar(50)=NULL,
                @qty1 float,
		@qty float,
		@counter_qty float=NULL,
                @price float,
                @side varchar(10),
                @trade_date datetime,
                @transact_date datetime,
		@transact_time datetime,
		@trade_day datetime,
                @value_date datetime,
		@fixing_date datetime=NULL,
                /*swaps*/
                @far_price float=NULL,
		@far_value_date datetime=NULL,
		@far_fixing_date datetime=NULL,
                /*parties*/
                @trader varchar(50),
		@executing_trader varchar(50)=NULL,
                @exec_trader varchar(50),
		@executing_firm varchar(50)=NULL,
                @exec_firm varchar(50),
		@executing_system varchar(50)=NULL,
                @contra_firm varchar(50)=NULL,
                @contra_broker varchar(50),
		@clearing_firm varchar(50)=NULL,
                @sponsoring_firm varchar(50)=NULL


as

declare @c_platform_identifier varchar(100)
declare @m_platform_identifier varchar(100)
declare @deal_exec_symbol varchar(100)

declare @broker_id int
declare @source_id int
declare @c_trade_id int
declare @m_trade_id int
declare @deal_id int

declare @c_quantity numeric(30, 2)
declare @m_quantity numeric(30, 2)
declare @contract varchar(20)

declare @c_trader_lookup varchar(50)
declare @m_trader_lookup varchar(50)
declare @c_counterparty_lookup varchar(50)
declare @m_counterparty_lookup varchar(50)
declare @trader_mapping_error_id int
declare @cpty_mapping_error_id int
declare @c_trader_id int
declare @m_trader_id int
declare @c_counterparty_id int
declare @m_counterparty_id int
declare @trader_external_account_id int
declare @cpty_external_account_id int
declare @suppress_trade_c varchar(50)
declare @suppress_trade_m varchar(50)
declare @suppression_lookup_c varchar(50)
declare @suppression_lookup_m varchar(50)
declare @ack_required varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @c_lookup_trader varchar(50)
declare @m_lookup_trader varchar(50)
declare @c_counterparty varchar(50)
declare @m_counterparty varchar(50)
declare @c_external_account_id int
declare @m_external_account_id int
declare @c_external_account varchar(50) 
declare @m_external_account varchar(50)
declare @c_trader_login varchar(50)
declare @m_trader_login varchar(50)
declare @c_trader varchar(50)
declare @m_trader varchar(50)
declare @deal_status varchar(50)
declare @contract_id int
declare @inverted varchar(50)
declare @tally_status varchar(10)
declare @tally_message varchar(25)
declare @database varchar(50)

select
	@qty = @qty1

select
	@database = db_name()

/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */

select 
	@qty = @qty1

if @broker = NULL
begin
	select
		@broker = "Bloomberg"
end

if @default_login = NULL
begin
	select
		@default_login = @agent
end

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

if @default_login = NULL
begin
	select
		@default_login = @agent
end

select
	@source_id = source_id
from
	sources
where
	name = @source

/* 
 * Removed Eval client or market step
 * this proc tallies both client and market at the 
 * same time
 *
*/

select
	@trade_date = @transact_date

select
	@c_platform_identifier = rtrim(@order_id)+".c",
	@deal_exec_symbol = @order_id

select
	@c_counterparty_lookup = rtrim(@sender_comp),
	@c_trader_lookup = rtrim(@exec_trader) + "-" + rtrim(@account)

select
	@suppression_lookup_c = rtrim(@c_trader_lookup) 

select
        @m_platform_identifier = rtrim(@order_id)+".m"

select
        @m_counterparty_lookup = rtrim(@contra_firm),
        @m_trader_lookup = rtrim(@exec_firm)

if (@database = "risk_bgc")
begin
	select 
		@c_trader_lookup = (@exec_trader),
		@m_trader_lookup = rtrim(@exec_trader)
end
	
/* --------------------------------------------------------------------------
 * STEP: Dupe check on the client and market identifiers 
 *
 */

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@c_platform_identifier,
		@trade_id=@c_trade_id output

if @c_trade_id != NULL
begin
	/* tt_isdupe would throw error message, just return */
	return
end

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@m_platform_identifier,
		@trade_id=@m_trade_id output

if @m_trade_id != NULL
begin
	return
end


/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error. 
 */
exec
	ag_pendingmappingerrors
		@login = @default_login,
        	@broker_id = @broker_id,
        	@identifier = @c_platform_identifier,
        	@trader_mapping_error_id = @trader_mapping_error_id output,
		@cpty_mapping_error_id = @cpty_mapping_error_id output

exec
	tt_resolvetradermapping
		@login=@default_login,
		@source_id=@source_id,
		@source=@source,
		@broker_id=@broker_id,
		@identifier=@c_platform_identifier,
		@mapping_error_id=@trader_mapping_error_id,
		@mapping=@c_trader_lookup,
		@trader_id=@c_trader_id output,
		@trader=@c_trader output,
		@trader_login=@c_trader_login output,
		@external_account_id=@trader_external_account_id output

exec
	tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@c_platform_identifier,
                @mapping_error_id=@cpty_mapping_error_id,
		@mapping = @c_counterparty_lookup,
		@counterparty_id=@c_counterparty_id output,
		@counterparty=@c_counterparty output,
		@cpty_external_account_id=@cpty_external_account_id output

if @c_trader_id = NULL
begin
        return
end

if @c_counterparty_id = NULL
begin
	return
end

select @trader_mapping_error_id=NULL
select @cpty_mapping_error_id=NULL

exec
        ag_pendingmappingerrors
                @login = @default_login,
                @broker_id = @broker_id,
                @identifier = @m_platform_identifier,
                @trader_mapping_error_id = @trader_mapping_error_id output,
                @cpty_mapping_error_id = @cpty_mapping_error_id output

exec
        tt_resolvetradermapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@m_platform_identifier,
                @mapping_error_id=@trader_mapping_error_id,
                @mapping=@m_trader_lookup,
                @trader_id=@m_trader_id output,
                @trader=@m_trader output,
                @trader_login=@m_trader_login output,
                @external_account_id=@trader_external_account_id output

exec
        tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@m_platform_identifier,
                @mapping_error_id=@cpty_mapping_error_id,
                @mapping = @m_counterparty_lookup,
                @counterparty_id=@m_counterparty_id output,
                @counterparty=@m_counterparty output,
                @cpty_external_account_id=@cpty_external_account_id output

select
	@c_external_account_id = @trader_external_account_id
select
	@m_external_account_id = @cpty_external_account_id


select
	@c_external_account = a.symbol
from
	external_accounts a,
	external_account_types b,
	aggregation_styles c
where
	a.external_account_type_id = b.external_account_type_id
and
	a.aggregation_style_id = c.aggregation_style_id
and
	a.external_account_id = @c_external_account_id

select
	@m_external_account = a.symbol
from
	external_accounts a,
	external_account_types b,
	aggregation_styles c
where
	a.external_account_type_id = b.external_account_type_id
and
	a.aggregation_style_id = c.aggregation_style_id
and
	a.external_account_id = @m_external_account_id

/* --------------------------------------------------------------------------
 * STEP: Check for suppression 
 *
 */
select
	@suppress_trade_c = "Y"
from
	suppression_symbols
where
	source_id = @source_id
and
	symbol = @suppression_lookup_c

if @suppress_trade_c = "Y"
begin
	select
		status = "Suppressing Client Trade",
		platform_identifier = @c_platform_identifier,
		source = @source,
		suppression_lookup = @suppression_lookup_c

	if @ack_required = "Y"
	begin
        	select
                	trade_report_id=@trade_report_id,
                	symbol="NA"
	end

end

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 *
 */

select
	@deal_type = "B2B Forward",
	@trade_type = "Spot",
	@tally_type = "Spot"

/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * 
 * Default all trades right now to assume a 'B2B *' deal type
 */

exec
	tt_resolvedeal
		@deal_exec_symbol = @deal_exec_symbol,
		@deal_id = @deal_id output,
		@deal_type = @deal_type output,
		@deal_status = @deal_status output
if @deal_id = NULL
begin
	exec
		tt_newdeal
			@deal_type = @deal_type,
			@deal_status = @deal_status,
			@deal_exec_symbol = @deal_exec_symbol,
			@deal_id = @deal_id output
end


/* --------------------------------------------------------------------------
 * STEP: Determine the contract
 *
 */

exec
	r_validateccypair
		@login=@default_login,
		@symbol=@symbol,
		@ccy1=@ccy1,
		@ccy2=@ccy2,
		@contract_id = @contract_id output,
		@contract = @contract output,
		@inverted = @inverted output



/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the FIX message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund 
 * or agency so set the direction accordingly
 */

if @side = "SELL"
	select
		@qty = @qty * -1

select
	m_quantity=@qty
select
	c_quantity=-@qty

/* --------------------------------------------------------------------------
 * STEP: Tally the client trade
 *
 */

if (@suppress_trade_c != "Y")
begin
	exec
		fxa_tallytrade
			@login = @c_trader_login,
			@source = @source,
			@trade_id = @c_trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @tally_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @c_external_account,
			@counterparty = @c_counterparty,
			@quantity = @c_quantity,
			@symbol = @contract,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @c_trader,
			@broker = @broker,
			@identifier = @c_platform_identifier,
			@spot_reference = @price

	if @c_trade_id = NULL
	begin
		select
			@tally_status = "Error",
			@tally_message = "Problem tallying client trade"
	end
	else
	begin
		select
			@tally_status = "Success",
			@tally_message = "Tallied client trade"
	end

	select 
		status = @tally_status,
		message = @tally_message,
		trade_id = @c_trade_id,
		login = @c_trader_login,
		source = @source,
		deal_id = @deal_id,
		tally_type = @tally_type,
		deal_type = @deal_type,
		trade_type = @trade_type,
		external_account = @c_external_account,
		counterparty = @c_counterparty,
		quantity = @c_quantity,
		symbol = @contract,
		value_date = @value_date,
		price = @price,
		trade_date = @trade_date,
		trader = @c_trader,
		broker = @broker,
		identifier = @c_platform_identifier,
		spot_reference = @price

	if (@tally_status != "Error")
	begin
		exec
        		r_inserttradenotification
                		@trade_id = @c_trade_id
	end

end

/* tally the Market trade */

if (@suppress_trade_m != "Y")
begin

	exec
        	fxa_tallytrade
                	@login = @m_trader_login,
                	@source = @source,
                	@trade_id = @m_trade_id out,
                	@deal_id = @deal_id out,
                	@tally_type = @tally_type,
                	@deal_type = @deal_type,
                	@trade_type = @trade_type,
                	@external_account = @m_external_account,
                	@counterparty = @m_counterparty,
                	@quantity = @m_quantity,
                	@symbol = @contract,
                	@value_date = @value_date,
                	@price = @price,
                	@trade_date = @trade_date,
                	@trader = @m_trader,
                	@broker = @broker,
                	@identifier = @m_platform_identifier,
                	@spot_reference = @price

	if @m_trade_id = NULL
	begin
        	select
                	@tally_status = "Error",
                	@tally_message = "Problem tallying market trade"
	end
	else
	begin
        	select
                	@tally_status = "Success",
                	@tally_message = "Tallied market trade"
	end

	select
        	status = @tally_status,
        	message = @tally_message,
        	trade_id = @m_trade_id,
        	login = @m_trader_login,
        	source = @source,
        	deal_id = @deal_id,
        	tally_type = @trade_type,
        	deal_type = @deal_type,
        	trade_type = @trade_type,
        	external_account = @m_external_account,
        	counterparty = @m_counterparty,
        	quantity = @m_quantity,
        	symbol = @contract,
        	value_date = @value_date,
        	price = @price,
        	trade_date = @trade_date,
        	trader = @m_trader,
        	broker = @broker,
        	identifier = @m_platform_identifier,
        	spot_reference = @price

	if @tally_status != "Error"
	begin
		exec
			r_inserttradenotification
				@trade_id = @m_trade_id
	end

end

/* --------------------------------------------------------------------------
 * STEP: Send an acknowledgement that this trade processed through
 * 
 * The data required to send an ack must also be defined in the mapping.xml
 * and may differ platform to platform. If you change the below code, remember
 * to change the code above by the suppressed trade section
 */

if @ack_required = "Y"
begin
	select
		trade_report_id=@trade_report_id,
		symbol="NA"
	return
end

go
