drop procedure ttm_hotspottally 
go

create procedure
	ttm_hotspottally	
		/* Provided by FIX server config.properties & spring.xml */
                @agent varchar(50),
		@source varchar(50),
                @default_login varchar(50),
                @broker varchar(50),
                /* Parsed from FIX message and provided by mapping.xml */
                /* session variables */
                @sender_comp varchar(50),
                @target_comp varchar(50),
                /* identifiers */
                @execution_id varchar(100)=NULL,
                @trade_report_id varchar(50),
                @order_id varchar(50),
		@trade_link varchar(50),
                /*financials*/
                @symbol varchar(50)=NULL,
                @ccy1 varchar(50)=NULL,
                @ccy2 varchar(50)=NULL,
                @qty1 float,
                @price float,
                @side varchar(10),
                @trade_date datetime,
                @trade_day datetime,
                @value_date datetime,
		@fixing_date datetime=NULL,
                /*parties*/
                @trader varchar(50),
                @contra_broker varchar(50),
		@spread varchar(1)


as

declare @database varchar(30)
declare @client_or_market varchar(1)
declare @deal_type varchar(50)
declare @deal_exec_symbol varchar(100)
declare @deal_status varchar(50)
declare @tally_type varchar(50)
declare @trade_type varchar(50)
declare @suppress_trade varchar(1)

declare @broker_id int
declare @source_id int
declare @deal_id int

declare @fund_agency_lookup varchar(30)
declare @is_fund_agency char(1)
declare @contract varchar(20)

declare @qty float
declare @last_spot_rate float
declare @contract_id int
declare @inverted varchar(50)

declare @c_platform_identifier varchar(100)
declare @m_platform_identifier varchar(100)
declare @platform_identifier   varchar(100)

declare @c_trade_id int
declare @m_trade_id int
declare @hotspot_trade_id   int

declare @c_quantity numeric(30, 2)
declare @m_quantity numeric(30, 2)
declare @quantity   numeric(30, 2)

declare @c_trader_lookup varchar(50)
declare @m_trader_lookup varchar(50)
declare @trader_lookup   varchar(50)

declare @c_counterparty_lookup varchar(50)
declare @m_counterparty_lookup varchar(50)
declare @counterparty_lookup   varchar(50)

declare @c_trader_mapping_error_id int
declare @m_trader_mapping_error_id int
declare @trader_mapping_error_id   int

declare @c_cpty_mapping_error_id int
declare @m_cpty_mapping_error_id int
declare @cpty_mapping_error_id   int

declare @c_trader_id int
declare @m_trader_id int
declare @trader_id   int

declare @c_counterparty_id int
declare @m_counterparty_id int
declare @counterparty_id   int

declare @c_trader_external_account_id int
declare @m_trader_external_account_id int
declare @trader_external_account_id   int

declare @c_cpty_external_account_id int
declare @m_cpty_external_account_id int
declare @cpty_external_account_id   int

declare @c_external_account varchar(50)
declare @m_external_account varchar(50)
declare @external_account   varchar(50)

declare @c_counterparty varchar(50)
declare @m_counterparty varchar(50)
declare @counterparty   varchar(50)

declare @c_external_account_id int
declare @m_external_account_id int
declare @external_account_id   int

declare @c_trader_login varchar(50)
declare @m_trader_login varchar(50)
declare @trader_login   varchar(50)

declare @c_trader varchar(50)
declare @m_trader varchar(50)

declare @c_tally_status varchar(10)
declare @m_tally_status varchar(10)

declare @c_tally_message varchar(25)
declare @m_tally_message varchar(25)


/* --------------------------------------------------------------------------
 * STEP: Initial MAP proc parameters to common tally params
 * It may be that additional parameters are mapped further down in the 
 * stored procedure based on the result of @client_or_market
 */
select
	@fund_agency_lookup = @contra_broker,
	@qty = @qty1,
	@last_spot_rate = @price,
	@database = db_name()

if (@database = "risk_cresco" or @database = "risk_itg")
	select
		@trade_date = dateadd(hour, -5, @trade_date)

/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */

select
	@broker = "Hotspot"

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
	@source_id = source_id
from
	sources
where
	name = @source

if @spread = "N"
begin
	select
		@trade_link = "0"
end

if @trade_link = "0" or @trade_link = NULL
begin
        
	if (@database = "risk_edgewater")
		select
			@deal_exec_symbol = @order_id + "_" + rtrim(convert(char(10), convert(datetime, @trade_date), 112))
	else
		select
			@deal_exec_symbol = @order_id	
	select
		@deal_type = "B2B Forward"
	
	select
                @c_platform_identifier = rtrim(@execution_id)+".c",
                @c_counterparty_lookup = rtrim(@target_comp),
                @c_trader_lookup = rtrim(@trader)

	if (@database =  "risk_cresco" or @database = "risk_itg")
	begin
		select
			@suppress_trade = "Y"
		from
			suppression_symbols
		where
	        	source_id = @source_id
		and
			symbol = @c_trader_lookup

	end

        select
                @m_platform_identifier = rtrim(@execution_id)+".m",
		@m_counterparty_lookup = rtrim(@contra_broker)
	
	if (@suppress_trade = "Y")
	begin
		select
			@m_trader_lookup = rtrim(@c_trader_lookup)	
	end

	exec
		tt_isdupe
			@broker_id=@broker_id,
			@identifier=@c_platform_identifier,
			@trade_id=@c_trade_id output

	if @c_trade_id != NULL
	begin
		select
			status="Dupe",
			message="Client trade already tallied",
			trade_identifier = @c_platform_identifier
	end
	
	exec
		tt_isdupe
			@broker_id=@broker_id,
			@identifier=m_platform_identifier,
			@trade_id=@m_trade_id output

	if @m_trade_id != NULL
	begin
		select
			status="Dupe",
			message="Market trade already tallied",
			trade_identifier=@m_platform_identifier
	end

	exec
		ag_pendingmappingerrors
			@login = @default_login,
			@broker_id = @broker_id,
			@identifier = @c_platform_identifier,
			@trader_mapping_error_id = @c_trader_mapping_error_id output,
			@cpty_mapping_error_id = @c_cpty_mapping_error_id output

	exec
		tt_resolvetradermapping
			@login=@default_login,
			@source_id=@source_id,
			@source=@source,
			@broker_id=@broker_id,
			@identifier=@c_platform_identifier,
			@mapping_error_id=@c_trader_mapping_error_id,
			@mapping=@c_trader_lookup,
			@trader_id=@c_trader_id output,
			@trader=@c_trader output,
			@trader_login=@c_trader_login output,
			@external_account_id=@c_trader_external_account_id output

	exec
		tt_resolvecptymapping
			@login=@default_login,
			@source_id=@source_id,
			@source=@source,
			@broker_id=@broker_id,
			@identifier=@c_platform_identifier,
			@mapping_error_id=@c_cpty_mapping_error_id,
			@mapping = @c_counterparty_lookup,
			@counterparty_id=@c_counterparty_id output,
			@counterparty=@c_counterparty output,
			@cpty_external_account_id=@c_cpty_external_account_id output

	if @c_trader_id = NULL
	begin
		return
	end

	if @c_counterparty_id = NULL
	begin
		return
	end

	exec
		ag_pendingmappingerrors
			@login = @default_login,
			@broker_id = @broker_id,
			@identifier = @m_platform_identifier,
			@trader_mapping_error_id = @m_trader_mapping_error_id output,
			@cpty_mapping_error_id = @m_cpty_mapping_error_id output

	exec
		tt_resolvetradermapping
			@login=@default_login,
			@source_id=@source_id,
			@source=@source,
			@broker_id=@broker_id,
			@identifier=@m_platform_identifier,
			@mapping_error_id=@m_trader_mapping_error_id,
			@mapping=@m_trader_lookup,
			@trader_id=@m_trader_id output,
			@trader=@m_trader output,
			@trader_login=@m_trader_login output,
			@external_account_id=@m_trader_external_account_id output

	exec
		tt_resolvecptymapping
			@login=@default_login,
			@source_id=@source_id,
			@source=@source,
			@broker_id=@broker_id,
			@identifier=@m_platform_identifier,
			@mapping_error_id=@m_cpty_mapping_error_id,
			@mapping = @m_counterparty_lookup,
			@counterparty_id=@m_counterparty_id output,
			@counterparty=@m_counterparty output,
			@cpty_external_account_id=@m_cpty_external_account_id output

        if @m_trader_id = NULL
        begin
                return
        end

        if @m_counterparty_id = NULL
        begin
                return
        end
	
	select
		@c_external_account_id = @c_trader_external_account_id,
		@m_external_account_id = @m_cpty_external_account_id

	select
                @c_external_account = symbol
	from
		external_accounts 
	where	
		external_account_id = @c_external_account_id

	select
		@m_external_account = symbol
	from
		external_accounts
	where
		external_account_id = @m_external_account_id

	select
		@trade_type = "Spot",
		@tally_type = "Spot"

	exec
		tt_resolvedeal
			@deal_exec_symbol = @deal_exec_symbol,
			@deal_id = @deal_id output,
			@deal_type = @deal_type output,
			@deal_status = @deal_status output
	if @deal_id = NULL
	begin
		exec
			tt_newdeal
				@deal_type = @deal_type,
				@deal_status = @deal_status,
				@deal_exec_symbol = @deal_exec_symbol,
				@deal_id = @deal_id output
	end

	exec
		r_validateccypair
			@login=@default_login,
			@symbol=@symbol,
			@ccy1=@ccy1,
			@ccy2=@ccy2,
			@contract_id = @contract_id output,
			@contract = @contract output,
			@inverted = @inverted output


	if @side = "BUY"
	begin
		select
			@c_quantity = @qty * -1,
			@m_quantity = @qty
	end
	else 
 	begin
		select
			@c_quantity = @qty,
			@m_quantity = @qty * -1
	end

	exec
		fxa_tallytrade
			@login = @c_trader_login,
			@source = @source,
			@trade_id = @c_trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @trade_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @c_external_account,
			@counterparty = @c_counterparty,
			@quantity = @c_quantity,
			@symbol = @contract,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @c_trader,
			@broker = @broker,
			@identifier = @c_platform_identifier,
			@spot_reference = @last_spot_rate

	if @c_trade_id = NULL
	begin
		select
			@c_tally_status = "Error",
			@c_tally_message = "Problem tallying Client trade"
	end
	else
	begin
		select
			@c_tally_status = "Success",
			@c_tally_message = "Tallied Client trade"
	end

	select 
		status = @c_tally_status,
		message = @c_tally_message,
		trade_id = @c_trade_id,
		login = @c_trader_login,
		source = @source,
		deal_id = @deal_id,
		tally_type = @trade_type,
		deal_type = @deal_type,
		trade_type = @trade_type,
		external_account = @c_external_account,
		counterparty = @c_counterparty,
		quantity = @c_quantity,
		symbol = @contract,
		value_date = @value_date,
		price = @price,
		trade_date = @trade_date,
		trader = @c_trader,
		broker = @broker,
		identifier = @c_platform_identifier,
		spot_reference = @last_spot_rate

		if @c_tally_status = "Error"
		begin
			return
		end

	exec
		r_inserttradenotification
			@trade_id = @c_trade_id
	
	/* tally market trade */
	
	exec
		fxa_tallytrade
			@login = @m_trader_login,
			@source = @source,
			@trade_id = @m_trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @trade_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @m_external_account,
			@counterparty = @m_counterparty,
			@quantity = @m_quantity,
			@symbol = @contract,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @m_trader,
			@broker = @broker,
			@identifier = @m_platform_identifier,
			@spot_reference = @last_spot_rate
	
	if @m_trade_id = NULL
	begin
		select
			@m_tally_status = "Error",
			@m_tally_message = "Problem tallying Market trade"
	end
	else
	begin
		select
			@m_tally_status = "Success",
			@m_tally_message = "Tallied Market trade"
	end

	select 
		status = @m_tally_status,
		message = @m_tally_message,
		trade_id = @m_trade_id,
		login = @m_trader_login,
		source = @source,
		deal_id = @deal_id,
		tally_type = @trade_type,
		deal_type = @deal_type,
		trade_type = @trade_type,
		external_account = @m_external_account,
		counterparty = @m_counterparty,
		quantity = @m_quantity,
		symbol = @contract,
		value_date = @value_date,
		price = @price, 
		trade_date = @trade_date,
		trader = @m_trader,
		broker = @broker,
		identifier = @m_platform_identifier,
		spot_reference = @last_spot_rate 

	if @m_tally_status = "Error"
	begin
		return	
	end

	exec 
		r_inserttradenotification
			@trade_id = @m_trade_id
end

if (@trade_link != "0")
begin

	if (@database = "risk_edgewater" or @database = "risk_mint" or @database = "risk_itg")
		select
                	@deal_exec_symbol = "ORD_" + @order_id + "_" + rtrim(convert(char(10), convert(datetime, @trade_date), 112))
	else
		select
			@deal_exec_symbol = "ORD_" + @order_id
 
	select
		@deal_type = "B2B Forward",
                @trader_lookup = @trader

	exec
        
	tt_isfundagency
                @source_id=@source_id,
                @mapping=@trader_lookup,
                @is_fund_agency=@is_fund_agency output
	select
        	@client_or_market = "M"

	if @is_fund_agency = "Y"
        	select
                	@client_or_market = "C"

	if @client_or_market = "C"
	begin
		select
			@counterparty_lookup = rtrim(@target_comp),
			@platform_identifier = rtrim(@execution_id) + ".c",
			@quantity = -@qty
	end
	else 
	begin
		select
			@counterparty_lookup = rtrim(@contra_broker),
			@platform_identifier = rtrim(@execution_id) + ".m",
			@quantity = @qty
	end

	exec
		ag_pendingmappingerrors
			@login = @default_login,
			@broker_id = @broker_id,
			@identifier = @platform_identifier,
			@trader_mapping_error_id = @trader_mapping_error_id output,
			@cpty_mapping_error_id = @cpty_mapping_error_id output

	exec
		tt_resolvetradermapping
			@login=@default_login,
			@source_id=@source_id,
			@source=@source,
			@broker_id=@broker_id,
			@identifier=@platform_identifier,
			@mapping_error_id=@trader_mapping_error_id,
			@mapping=@trader_lookup,
			@trader_id=@trader_id output,
                        @trader=@trader output,
			@trader_login=@trader_login output,
			@external_account_id=@trader_external_account_id output

	exec
		tt_resolvecptymapping
			@login=@default_login,
			@source_id=@source_id,
			@source=@source,
			@broker_id=@broker_id,
			@identifier=@platform_identifier,
			@mapping_error_id=@cpty_mapping_error_id,
			@mapping = @counterparty_lookup,
			@counterparty_id=@counterparty_id output,
			@counterparty=@counterparty output,
			@cpty_external_account_id=@cpty_external_account_id output

	if @trader_id = NULL
	begin
		return
	end

	if @counterparty_id = NULL
	begin
		return
	end

	select
		@external_account_id = @trader_external_account_id

	select
		@external_account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	exec
		tt_isdupe
			@broker_id=@broker_id,
			@identifier=@platform_identifier,
			@trade_id=@hotspot_trade_id output

        if @hotspot_trade_id != NULL
        begin
                select
                        status="Dupe",
                        message="Trade already tallied",
                        trade_identifier=@platform_identifier
        		return
	end	

	exec
		j_nextkey
			"hotspot_queued_trades",
			@hotspot_trade_id output

		insert into
			hotspot_queue
		values(
			@trade_link,
			@hotspot_trade_id
			)

		insert into
			hotspot_queued_trades
		values(
			@hotspot_trade_id,
			@trader_login,
			@source,
			@tally_type,
			@deal_type,
			@trade_type,
			@external_account,
			@counterparty,
			@quantity,
			@symbol,
			@value_date,
			@price,
			@trade_date,
			@trader,
			@broker,
			@platform_identifier,
			@price,
			@client_or_market,
			@deal_exec_symbol
			)

                select
			status = "Trade Inserted Into Queued Trades",
			queued_trade_id = @hotspot_trade_id,
			trade_link = @trade_link,
			account = @external_account,
			cpty = @counterparty,
			symbol = @symbol,
			quantity = @quantity,
			price = @price,
			val_date = @value_date

	exec
		tt_processhotspottrades
			@trade_link
end

go
