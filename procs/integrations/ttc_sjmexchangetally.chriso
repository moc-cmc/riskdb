create or replace procedure
	ttc_sjmexchangetally
  		/* Provided by FIX server config.properties & spring.xml */
                @source varchar(50),
                @default_login varchar(50),
                @broker varchar(50),
                /* Parsed from FIX message and provided by mapping.xml */
                /* session variables */
                @sender_comp varchar(50),
                @target_comp varchar(50),
                /* identifiers */
                @execution_id varchar(100)=NULL,
		@trade_report_id varchar(50)=NULL,
		@leg1_order_id varchar(50)=NULL,
		@leg2_order_id varchar(50)=NULL,
                /*financials*/
                @symbol varchar(50)=NULL,
                @ccy1 varchar(50)=NULL,
                @ccy2 varchar(50)=NULL,
                @qty float,
                @price float,
                @leg1_side varchar(10),
		@leg2_side varchar(10),
                @trade_date datetime,
                @trading_day datetime=NULL,
                @value_date datetime,
                @symbol_suffix varchar(50)=NULL,
                @exec_type varchar(50)=NULL,
		@leg1_misc_exch_fee_amt float=NULL,
		@leg1_misc_exch_fee_ccy varchar(10)=NULL,
		@leg1_misc_exch_fee_type varchar(50)=NULL,
		@leg1_misc_oth_fee_amt float=NULL,
		@leg1_misc_oth_fee_ccy varchar(10)=NULL,
		@leg1_misc_oth_fee_type varchar(50)=NULL,
                @leg2_misc_exch_fee_amt float=NULL,
                @leg2_misc_exch_fee_ccy varchar(10)=NULL,
		@leg2_misc_exch_fee_type varchar(50)=NULL,
                @leg2_misc_oth_fee_amt float=NULL,
                @leg2_misc_oth_fee_ccy varchar(10)=NULL,
		@leg2_misc_oth_fee_type varchar(50)=NULL,
                /*parties*/
		@leg1_exec_firm varchar(50)=NULL,
		@leg1_exec_trader varchar(50)=NULL,
		@leg1_exec_system varchar(50)=NULL,
		@leg1_account varchar(50)=NULL,
		@leg2_exec_firm varchar(50)=NULL,
		@leg2_exec_trader varchar(50)=NULL,
		@leg2_exec_system varchar(50)=NULL,
		@leg2_account varchar(50)=NULL,
                /* extra */
                @aggressor varchar(50)=NULL

as

declare @client_or_market char(1)
declare @platform_identifier varchar(100)
declare @far_platform_identifier varchar(100)
declare @deal_exec_symbol varchar(100)

declare @broker_id int
declare @source_id int
declare @trade_id int
declare @deal_id int

declare @fund_agency_lookup varchar(30)
declare @is_fund_agency char(1)

declare @quantity numeric(30, 2)
declare @far_quantity numeric(30, 2)
declare @contract varchar(20)

declare @prime_broker_lookup varchar(50)
declare @trader_lookup varchar(50)
declare @counterparty_lookup varchar(50)
declare @trader_mapping_error_id int
declare @cpty_mapping_error_id int
declare @trader_id int
declare @counterparty_id int
declare @trader_external_account_id int
declare @cpty_external_account_id int
declare @ea_external_account_id int
declare @ea_external_account varchar(50)
declare @ea_external_account_type varchar(50)
declare @ea_aggregation_style varchar(50)
declare @external_account varchar(50)
declare @suppress_trade varchar(50)
declare @suppression_lookup varchar(50)
declare @ack_required varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @lookup_trader varchar(50)
declare @counterparty varchar(50)
declare @external_account_id int
declare @external_account_type varchar(50)
declare @trader_login varchar(50)
declare @trader varchar(50)
declare @far_trade_id int
declare @far_trade_type varchar(50)
declare @deal_status varchar(50)
declare @aggregation_style varchar(50)
declare @contract_id int
declare @inverted varchar(50)
declare @tally_status varchar(10)
declare @tally_message varchar(25)
declare @far_tally_status varchar(10)
declare @far_tally_message varchar(25)
declare @trigger_symbol varchar(50)
declare @last_spot_rate float
declare @fixing_date datetime

declare @c_client_or_market char(1)
declare @c_platform_identifier varchar(100)
declare @c_far_platform_identifier varchar(100)
declare @c_deal_exec_symbol varchar(100)
declare @c_broker_id int
declare @c_broker varchar(50)
declare @c_source_id int
declare @c_trade_id int
declare @c_deal_id int
declare @c_fund_agency_lookup varchar(30)
declare @c_is_fund_agency char(1)
declare @c_quantity float
declare @c_far_quantity numeric(30, 2)
declare @c_contract varchar(20)
declare @c_prime_broker_lookup varchar(50)
declare @c_trader_lookup varchar(50)
declare @c_external_account_lookup varchar(50)
declare @c_counterparty_lookup varchar(50)
declare @c_trader_mapping_error_id int
declare @c_cpty_mapping_error_id int
declare @c_trader_id int
declare @c_counterparty_id int
declare @c_trader_external_account_id int
declare @c_cpty_external_account_id int
declare @c_ea_external_account_id int
declare @c_ea_external_account varchar(50)
declare @c_ea_external_account_type varchar(50)
declare @c_ea_aggregation_style varchar(50)
declare @c_external_account varchar(50)
declare @c_suppress_trade varchar(50)
declare @c_suppression_lookup varchar(50)
declare @c_ack_required varchar(50)
declare @c_deal_type varchar(50)
declare @c_trade_type varchar(50)
declare @c_tally_type varchar(50)
declare @c_lookup_trader varchar(50)
declare @c_counterparty varchar(50)
declare @c_external_account_id int
declare @c_external_account_type varchar(50)
declare @c_trader_login varchar(50)
declare @c_trader varchar(50)
declare @c_far_trade_id int
declare @c_far_trade_type varchar(50)
declare @c_deal_status varchar(50)
declare @c_aggregation_style varchar(50)
declare @c_contract_id int
declare @c_inverted varchar(50)
declare @c_tally_status varchar(10)
declare @c_tally_message varchar(25)
declare @c_far_tally_status varchar(10)
declare @c_far_tally_message varchar(25)
declare @c_trigger_symbol varchar(50)
declare @c_ext_account_mapping_error_id int

declare @c2_client_or_market char(1)
declare @c2_platform_identifier varchar(100)
declare @c2_far_platform_identifier varchar(100)
declare @c2_deal_exec_symbol varchar(100)
declare @c2_broker_id int
declare @c2_broker varchar(50)
declare @c2_source_id int
declare @c2_trade_id int
declare @c2_deal_id int
declare @c2_fund_agency_lookup varchar(30)
declare @c2_is_fund_agency char(1)
declare @c2_quantity float
declare @c2_far_quantity numeric(30, 2)
declare @c2_contract varchar(20)
declare @c2_prime_broker_lookup varchar(50)
declare @c2_trader_lookup varchar(50)
declare @c2_external_account_lookup varchar(50)
declare @c2_counterparty_lookup varchar(50)
declare @c2_trader_mapping_error_id int
declare @c2_cpty_mapping_error_id int
declare @c2_trader_id int
declare @c2_counterparty_id int
declare @c2_trader_external_account_id int
declare @c2_cpty_external_account_id int
declare @c2_ea_external_account_id int
declare @c2_ea_external_account varchar(50)
declare @c2_ea_external_account_type varchar(50)
declare @c2_ea_aggregation_style varchar(50)
declare @c2_external_account varchar(50)
declare @c2_suppress_trade varchar(50)
declare @c2_suppression_lookup varchar(50)
declare @c2_ack_required varchar(50)
declare @c2_deal_type varchar(50)
declare @c2_trade_type varchar(50)
declare @c2_tally_type varchar(50)
declare @c2_lookup_trader varchar(50)
declare @c2_counterparty varchar(50)
declare @c2_external_account_id int
declare @c2_external_account_type varchar(50)
declare @c2_trader_login varchar(50)
declare @c2_trader varchar(50)
declare @c2_far_trade_id int
declare @c2_far_trade_type varchar(50)
declare @c2_deal_status varchar(50)
declare @c2_aggregation_style varchar(50)
declare @c2_contract_id int
declare @c2_inverted varchar(50)
declare @c2_tally_status varchar(10)
declare @c2_tally_message varchar(25)
declare @c2_far_tally_status varchar(10)
declare @c2_far_tally_message varchar(25)
declare @c2_trigger_symbol varchar(50)
declare @c2_ext_account_mapping_error_id int

declare @exchange_match_id int
declare @long_trade_id int
declare @short_trade_id int

declare @leg1_misc_exch_fee_ccy_id int
declare @leg1_misc_exch_fee_type_id int
declare @leg1_misc_exch_trade_fee_id int
declare @leg1_misc_exch_fee_amt_offset float

declare @leg1_misc_oth_fee_ccy_id int
declare @leg1_misc_oth_fee_type_id int
declare @leg1_misc_oth_trade_fee_id int
declare @leg1_misc_oth_fee_amt_offset float

declare @leg2_misc_exch_fee_ccy_id int
declare @leg2_misc_exch_fee_type_id int
declare @leg2_misc_exch_trade_fee_id int
declare @leg2_misc_exch_fee_amt_offset float

declare @leg2_misc_oth_fee_ccy_id int
declare @leg2_misc_oth_fee_type_id int
declare @leg2_misc_oth_trade_fee_id int
declare @leg2_misc_oth_fee_amt_offset float

declare @fund_settlement_ext_account_id int
declare @fund_settlement_ext_account varchar(50)

declare @tico_account_id int
declare @account_transaction_id int

declare @status_id int
declare @otc_match_status_id int
declare @booked_status_id int
declare @otc_match_id int


declare @start_time datetime
declare @end_time datetime

declare @utc_time datetime

select
	@utc_time = GETUTCDATE() 

select
        @trade_date = dateadd(hour, datediff(hour, @trade_date, @utc_time), @trade_date)

/*
select
	@start_time = getdate()
*/

/*
select
	@trade_date  = convert(date, @trade_date)
*/

select
	@ack_required = "Y"

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @default_login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "New"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to find status 'New'"
	return
end

select
        @fund_settlement_ext_account_id = settlement_ext_account_id
from
        funds

select
        @fund_settlement_ext_account = symbol
from
        external_accounts
where
        external_account_id = @fund_settlement_ext_account_id
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "Could not fund fund settlement external account"
	return
end


/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified.
 * ----------------------------------------------------------------------- */

select
	@c_broker = @broker + " " + @leg1_exec_system,
	@c2_broker = @broker + " " + @leg2_exec_system

select
	@c_broker_id = broker_id
from
	brokers
where
	symbol = @c_broker
if @@rowcount != 1
begin
	select
		msg = "Could not find broker",
		broker = @c_broker
	return
end

select
        @c2_broker_id = broker_id
from
        brokers
where
        symbol = @c2_broker
if @@rowcount != 1
begin
        select
                msg = "Could not find broker",
                broker = @c2_broker
        return
end



select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		msg = "Could not find source",
		source = @source
	return
end



/* ----------------------------------------------------------------------------------
 * STEP: Map proc parameters to common tally variable name
 * This mapping allows us to use common variable names in all tallies. It also
 * helps with debugging, as you can look here to see what is mapped
 * For multi-prime setups that don't have a pb tag, set the prime_broker_lookup to ""
 * --------------------------------------------------------------------------------- */


/* Begin leg1 parameters */

select
	@c_deal_exec_symbol = @leg1_order_id+convert(char(8), @trading_day, 112)

select
	@c_platform_identifier = rtrim(@trade_report_id)+"-"+rtrim(@leg1_order_id) /* +convert(char(8), @trade_date, 112)"  */

select
	@c_trader_lookup = rtrim(@leg1_exec_trader),
	@c_external_account_lookup = rtrim(@leg1_account),
	@c_counterparty_lookup = rtrim(@sender_comp)

/* Set suppression variables */
select
        @c_suppression_lookup = @c_trader_lookup

/* End leg1 parameters */

/* Begin leg2 parameters */

select
        @c2_deal_exec_symbol = @leg2_order_id+convert(char(8), @trading_day, 112)
select
        @c2_platform_identifier = rtrim(@trade_report_id)+"-"+rtrim(@leg2_order_id) /* +convert(char(8), @trade_date, 112) */


select
	@c2_trader_lookup = rtrim(@leg2_exec_trader),
	@c2_external_account_lookup = rtrim(@leg2_account),
        @c2_counterparty_lookup = rtrim(@sender_comp)


/* Set suppression variables */
select
        @c2_suppression_lookup = @c2_trader_lookup

/* End leg2 parameters */


/* ----------------------------------------------------------------------------------
 * Fee Lookups
 * --------------------------------------------------------------------------------- */

if @leg1_misc_exch_fee_amt != NULL or @leg1_misc_exch_fee_amt != 0
begin
        select
                @leg1_misc_exch_fee_ccy_id = product_id
        from
                products
        where
                symbol = @leg1_misc_exch_fee_ccy

        select
                @leg1_misc_exch_fee_type_id = a.transaction_type_id
        from
                transaction_types a,
                transaction_type_symbols b
        where
                a.transaction_type_id = b.transaction_type_id
        and
                b.source_id = @source_id
        and
                b.symbol = @leg1_misc_exch_fee_type

        select
                @leg1_misc_exch_fee_amt_offset = @leg1_misc_exch_fee_amt
        select
                @leg1_misc_exch_fee_amt = @leg1_misc_exch_fee_amt * -1
end


if @leg1_misc_oth_fee_amt != NULL and @leg1_misc_oth_fee_amt != 0
begin
 	select
                @leg1_misc_oth_fee_ccy_id = product_id
        from
                products
        where
                symbol = @leg1_misc_oth_fee_ccy

        select
                @leg1_misc_oth_fee_type_id = a.transaction_type_id
        from
                transaction_types a,
                transaction_type_symbols b
        where
                a.transaction_type_id = b.transaction_type_id
        and
                b.source_id = @source_id
        and
                b.symbol = @leg1_misc_oth_fee_type

        select
                @leg1_misc_oth_fee_amt_offset = @leg1_misc_oth_fee_amt
        select
                @leg1_misc_oth_fee_amt = @leg1_misc_oth_fee_amt * -1
end

if @leg2_misc_exch_fee_amt != NULL and @leg2_misc_exch_fee_amt != 0
begin
        select
                @leg2_misc_exch_fee_ccy_id = product_id
        from
                products
        where
                symbol = @leg2_misc_exch_fee_ccy

        select
                @leg2_misc_exch_fee_type_id = a.transaction_type_id
        from
                fee_transaction_types a,
                transaction_type_symbols b
        where
                a.transaction_type_id = b.transaction_type_id
        and
                b.source_id = @source_id
        and
                b.symbol = @leg2_misc_exch_fee_type

        select
                @leg2_misc_exch_fee_amt_offset = @leg2_misc_exch_fee_amt
        select
                @leg2_misc_exch_fee_amt = @leg2_misc_exch_fee_amt * -1
end

if @leg2_misc_oth_fee_amt != NULL and @leg2_misc_oth_fee_amt != 0
begin
        select
                @leg2_misc_oth_fee_ccy_id = product_id
        from
                products
        where
                symbol = @leg2_misc_oth_fee_ccy

        select
                @leg2_misc_oth_fee_type_id = a.transaction_type_id
        from
                fee_transaction_types a,
                transaction_type_symbols b
        where
                a.transaction_type_id = b.transaction_type_id
        and
                b.source_id = @source_id
        and
                b.symbol = @leg2_misc_oth_fee_type

        select
                @leg2_misc_oth_fee_amt_offset = @leg2_misc_oth_fee_amt
        select
                @leg2_misc_oth_fee_amt = @leg2_misc_oth_fee_amt * -1
end

/* --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 * |     WARNING ------- WARNING -------- WARNING -------- WARNING          |
 * |                                                                        |
 * |                                                                        |
 * |  Do not make changes below this point                                  |
 * |  If you make changes, place comments about what was changed.           |
 * |                                                                        |
 * |                                                                        |
 * --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 */

/* CHANGE COMMENTS:
 *
 */



/* --------------------------------------------------------------------------
 * STEP: Dupe check on the identifier 
 *       Only need to check one ID
 *
 */

exec
	tt_isdupe
		@broker_id=@c_broker_id,
		@identifier=@c_platform_identifier,
		@trade_id=@trade_id output



if @trade_id != NULL
begin
	if @ack_required = "Y"
	begin
        	select
                	trade_report_id=@trade_report_id,
                	symbol="ACCEPTED"
        	return
	end
	
	/* tt_isdupe would throw error message, just return */
	return
end



/* --------------------------------------------------------------------------
 * STEP: Lookup trader, counterparty and ext account symbols for both legs
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will only send a message about the failed mapping if there is not an existing
 * mapping error. 
 */

/* Checking on leg1 side */
exec
	ag_pendingmappingerrors
		@login = @default_login,
        	@broker_id = @c_broker_id,
        	@identifier = @c_platform_identifier,
        	@trader_mapping_error_id = @c_trader_mapping_error_id output,
		@cpty_mapping_error_id = @c_cpty_mapping_error_id output,
		@ext_account_mapping_error_id = @c_ext_account_mapping_error_id output

exec
	tt_resolvetradermapping
		@login=@default_login,
		@source_id=@source_id,
		@source=@source,
		@broker_id=@c_broker_id,
		@identifier=@c_platform_identifier,
		@mapping_error_id=@c_trader_mapping_error_id,
		@mapping=@c_trader_lookup,
		@trader_id=@c_trader_id output,
		@trader=@c_trader output,
		@trader_login=@c_trader_login output,
		@external_account_id=@c_trader_external_account_id output

exec
	tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@c_broker_id,
                @identifier=@c_platform_identifier,
                @mapping_error_id=@c_cpty_mapping_error_id,
		@mapping = @c_counterparty_lookup,
		@counterparty_id=@c_counterparty_id output,
		@counterparty=@c_counterparty output,
		@cpty_external_account_id=@c_cpty_external_account_id output

exec
	tt_resolveexternalaccountmapping
		@login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@c_broker_id,
                @identifier=@c_platform_identifier,
                @mapping_error_id=@c_ext_account_mapping_error_id,
                @mapping = @c_external_account_lookup,
                @external_account_id=@c_external_account_id output,
		@external_account=@c_external_account output,
		@external_account_type=@c_external_account_type output,
		@aggregation_style=@c_aggregation_style output

if @c_trader_id = NULL
begin
	select 
		status = "Error",
   		error = "Error",
   		message = "trader mapping error trade not processed for leg1 side",
		lookup_trader = @c_trader_lookup
        return
end

if @c_counterparty_id = NULL
begin
	select 
		status = "Error",
		error = "Error",
		message = "counterparty mapping error trade not processed for leg1 side",
		lookup_ctpy = @c_counterparty_lookup
        return
end

if @c_external_account_id = NULL
begin
	select
		status = "Error",
		error = "Error",
		message = "external account mapping error trade not processed for leg1 side",
		lookup_ext_account = @c_external_account_lookup
	return
end

/* Checking on leg2 side */
exec
        ag_pendingmappingerrors
                @login = @default_login,
                @broker_id = @c2_broker_id,
                @identifier = @c2_platform_identifier,
                @trader_mapping_error_id = @c2_trader_mapping_error_id output,
                @cpty_mapping_error_id = @c2_cpty_mapping_error_id output,
		@ext_account_mapping_error_id = @c2_ext_account_mapping_error_id output

exec
        tt_resolvetradermapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@c2_broker_id,
                @identifier=@c2_platform_identifier,
                @mapping_error_id=@c2_trader_mapping_error_id,
                @mapping=@c2_trader_lookup,
                @trader_id=@c2_trader_id output,
                @trader=@c2_trader output,
                @trader_login=@c2_trader_login output,
                @external_account_id=@c2_trader_external_account_id output

exec
        tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@c2_broker_id,
                @identifier=@c2_platform_identifier,
                @mapping_error_id=@c2_cpty_mapping_error_id,
                @mapping = @c2_counterparty_lookup,
                @counterparty_id=@c2_counterparty_id output,
                @counterparty=@c2_counterparty output,
                @cpty_external_account_id=@c2_cpty_external_account_id output

exec
        tt_resolveexternalaccountmapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@c2_broker_id,
                @identifier=@c2_platform_identifier,
                @mapping_error_id=@c2_ext_account_mapping_error_id,
                @mapping = @c2_external_account_lookup,
                @external_account_id=@c2_external_account_id output,
                @external_account=@c2_external_account output,
                @external_account_type=@c2_external_account_type output,
                @aggregation_style=@c2_aggregation_style output

if @c2_trader_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "trader mapping error trade not processed for client side",
		lookup_trader = @c2_trader_lookup
        return
end

if @c2_counterparty_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "counterparty mapping error trade not processed for client side",
		lookup_ctpy = @c2_counterparty_lookup
        return
end

if @c2_external_account_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "external account mapping error trade not processed for leg2 side",
		lookup_ext_account = @c2_external_account_lookup
        return
end

/* --------------------------------------------------------------------------
 * STEP: Check for suppression - not enabled
 --------------------------------------------------------------------------- */
/*
select
	@c_suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id
and
	symbol = @c_suppression_lookup

select
        @c2_suppress_trade = "Y"
from
        suppression_symbols
where
        source_id = @source_id
and
        symbol = @c2_suppression_lookup

if @c_suppress_trade = "Y" and @c2_suppress_trade = "Y"
begin
	select
		status = "Suppressing trade",
		c_platform_identifier = @c_platform_identifier,
		c2_platform_identifier = @c2_platform_identifier,
		source = @source,
		c_suppression_lookup = @c_suppression_lookup,
		c2_suppression_lookup = @c2_suppression_lookup

	if @ack_required = "Y"
	begin
        	select
                	trade_report_id=@trade_report_id,
                	symbol="ACCEPTED"
	end

	/* We may store this data later on, but for now we will return out of tally */
	return
end
*/

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 */

select
	@c_deal_type = "Exchange Match",
	@c_trade_type = "Spot",
	@c_tally_type = "Spot",
	@c2_deal_type = "Exchange Match",
        @c2_trade_type = "Spot",
        @c2_tally_type = "Spot"

/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * Booking two deals_ids for this flow
 */


/* leg1 deal info */
exec
	tt_resolvedeal
		@deal_exec_symbol = @c_deal_exec_symbol,
		@deal_id = @c_deal_id output,
		@deal_type = @c_deal_type output,
		@deal_status = @c_deal_status output

if @c_deal_id = NULL
begin
	exec
		tt_newdeal
			@deal_type = @c_deal_type,
			@deal_status = @c_deal_status,
			@deal_exec_symbol = @c_deal_exec_symbol,
			@deal_id = @c_deal_id output
end

/* leg2 deal info */
exec
        tt_resolvedeal
                @deal_exec_symbol = @c2_deal_exec_symbol,
                @deal_id = @c2_deal_id output,
                @deal_type = @c2_deal_type output,
                @deal_status = @c2_deal_status output

if @c2_deal_id = NULL
begin
        exec
                tt_newdeal
                        @deal_type = @c2_deal_type,
                        @deal_status = @c2_deal_status,
                        @deal_exec_symbol = @c2_deal_exec_symbol,
                        @deal_id = @c2_deal_id output
end


/* --------------------------------------------------------------------------
 * STEP: Determine the contract
 *
 */

exec
	r_validateccypair
		@login=@default_login,
		@symbol=@symbol,
		@ccy1=@ccy1,
		@ccy2=@ccy2,
		@contract_id = @contract_id output,
		@contract = @contract output,
		@inverted = @inverted output

/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the FIX message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund 
 * or agency so set the direction accordingly
 */

if @leg1_side = "SELL"
begin
	select
		@c_quantity = @qty,
		@c2_quantity = @qty*-1
end
else
begin
	select
                @c_quantity = @qty*-1,
                @c2_quantity = @qty
end

/* --------------------------------------------------------------------------
 * STEP: Look up OTC match info so we can set the OTC match
 * 
 * Trades that are entered via an otc_match take the following workflo
 *  -> entered in otc tradepunch -> double affirmed -> marked status submitted
 *  -> send to exchange for credit check -> mark accepted or rejected
 *  -> mark the otc match as 'Booked' once the trades are tallied
 *
 * The trade report id is what we get back when submitting to sjm settlement api
 */
select
	@otc_match_id = otc_match_id,
	@otc_match_status_id = execution_status_id
from
	otc_matches
where
	execution_id = @trade_report_id

select
	@booked_status_id = status_id
from
	statuses
where
	name = "Booked"


/* --------------------------------------------------------------------------
 * STEP: Tally leg1
 */

begin tran

if @c_suppress_trade != "Y"
begin
        exec
                fxa_tallytrade
                        @login = @c_trader_login,
                        @source = @source,
                        @trade_id = @c_trade_id out,
                        @deal_id = @c_deal_id out,
                        @tally_type = @c_trade_type,
                        @deal_type = @c_deal_type,
                        @trade_type = @c_trade_type,
                        @external_account = @c_external_account,
                        @counterparty = @c_counterparty,
                        @quantity = @c_quantity,
                        @symbol = @contract,
                        @value_date = @value_date,
                        @fixing_date = @fixing_date,
                        @price = @price,
                        @trade_date = @trade_date,
                        @trader = @c_trader,
                        @broker = @c_broker,
                        @identifier = @c_platform_identifier,
                        @spot_reference = @last_spot_rate

        if @c_trade_id = NULL
        begin
                select
                        @tally_status = "Error",
                        @tally_message = "Problem tallying client trade"
		rollback tran
		return
        end
        else
        begin
                select
                        @tally_status = "Success",
                        @tally_message = "Tallied client trade"

        	select
                	status = @tally_status,
                	message = @tally_message,
                	trade_id = @c_trade_id,
                	deal_id = @c_deal_id,
                	login = @c_trader_login,
                	source = @source,
                	tally_type = @c_trade_type,
                	deal_type = @c_deal_type,
                	trade_type = @c_trade_type,
                	external_account = @c_external_account,
                	counterparty = @c_counterparty,
                	quantity = @c_quantity,
                	symbol = @contract,
                	value_date = @value_date,
                	price = @price,
                	trade_date = @trade_date,
                	trader = @c_trader,
                	broker = @c_broker,
                	identifier = @c_platform_identifier,
                	spot_reference = @last_spot_rate
	end
end

/* --------------------------------------------------------------------------
 * STEP: Tally leg2 
 */

if @c2_suppress_trade != "Y"
begin
        exec
                fxa_tallytrade
                        @login = @c2_trader_login,
                        @source = @source,
                        @trade_id = @c2_trade_id out,
                        @deal_id = @c2_deal_id out,
                        @tally_type = @c2_trade_type,
                        @deal_type = @c2_deal_type,
                        @trade_type = @c2_trade_type,
                        @external_account = @c2_external_account,
                        @counterparty = @c2_counterparty,
                        @quantity = @c2_quantity,
                        @symbol = @contract,
                        @value_date = @value_date,
                        @fixing_date = @fixing_date,
                        @price = @price,
                        @trade_date = @trade_date,
                        @trader = @c2_trader,
                        @broker = @c2_broker,
                        @identifier = @c2_platform_identifier,
                        @spot_reference = @last_spot_rate

        if @c2_trade_id = NULL
        begin
                select
                        @tally_status = "Error",
                        @tally_message = "Problem tallying market trade"
		rollback tran
		return
        end
        else
        begin
                select
                        @tally_status = "Success",
                        @tally_message = "Tallied market trade"

        	select
                	status = @tally_status,
                	message = @tally_message,
                	trade_id = @c2_trade_id,
                	deal_id = @c2_deal_id,
                	login = @c2_trader_login,
                	source = @source,
                	tally_type = @c2_trade_type,
                	deal_type = @c2_deal_type,
                	trade_type = @c2_trade_type,
                	external_account = @c2_external_account,
                	counterparty = @c2_counterparty,
                	quantity = @c2_quantity,
                	symbol = @contract,
                	value_date = @value_date,
                	price = @price,
                	trade_date = @trade_date,
                	trader = @c2_trader,
                	broker = @c2_broker,
                	identifier = @c2_platform_identifier,
                	spot_reference = @last_spot_rate
	end
end

/* --------------------------------------------------------------------------
 * STEP: We want to tie both trades to a single executionID for drill down info
 ----------------------------------------------------------------------------*/

if @c_suppress_trade != "Y" and @c2_suppress_trade != "Y"
begin
	if @leg1_side = "SELL"
	begin
        	select
                	@long_trade_id = @c_trade_id,
                	@short_trade_id = @c2_trade_id
	end
	else
	begin
        	select
                	@short_trade_id = @c_trade_id,
                	@long_trade_id = @c2_trade_id
	end
	
	exec
		j_nextkey
			"exchange_matches",
			@exchange_match_id output
		
	insert into
		exchange_matches(
			exchange_match_id,
			symbol,
			long_trade_id,
			short_trade_id,
			match_timestamp,
			processing_timestamp)
	values(
		@exchange_match_id,
		@execution_id,
		@long_trade_id,
		@short_trade_id,
		@trade_date,
		getdate())
	if @@rowcount != 1
	begin
		select
			status = "Error",
			msg = "Could not insert exchange match data into exchange_matches"
		rollback tran
		return
	end
end
	
/* --------------------------------------------------------------------------
 * STEP: Book fees for both legs
  -------------------------------------------------------------------------- */

if @c_suppress_trade != "Y"
begin
	if @leg1_misc_exch_fee_amt != NULL and @leg1_misc_exch_fee_amt != 0
	begin

	exec
        	j_nextkey
                	"account_transactions",
                	@account_transaction_id output	
	
	insert into
		pending_transactions(
        		account_transaction_id,
        		entered_by,
        		external_account_id,
        		transaction_type_id,
        		transaction_date,
        		currency_id,
        		amount,
        		create_date,
        		status_id)
      		values(
              		@account_transaction_id,
              		@tico_account_id,
              		@c_external_account_id,
              		@leg1_misc_exch_fee_type_id,
              		@trade_date,
              		@leg1_misc_exch_fee_ccy_id,
              		@leg1_misc_exch_fee_amt,
              		getdate(),
              		@status_id)
	if @@rowcount != 1
	begin
		select
        		status = "Error",
        		messsage = "Unable to book pending transaction",
        		account_transaction_id = @account_transaction_id,
        		account = @c_external_account,
        		transaction_type = @leg1_misc_exch_fee_type,
        		transaction_date = @trade_date,
        		product = @leg1_misc_exch_fee_ccy,
        		amount = @leg1_misc_exch_fee_amt
		rollback tran
		return
	end
	
	exec
        	j_nextkey
                  	"account_transactions",
                  	@account_transaction_id output
	
	insert into
		pending_transactions(
        		account_transaction_id,
        		entered_by,
        		external_account_id,
        		transaction_type_id,
        		transaction_date,
        		currency_id,
        		amount,
        		create_date,
        		status_id)
	values(
		@account_transaction_id,
		@tico_account_id,
		@fund_settlement_ext_account_id,
		@leg1_misc_exch_fee_type_id,
		@trade_date,
		@leg1_misc_exch_fee_ccy_id,
		@leg1_misc_exch_fee_amt_offset,
		getdate(),
		@status_id)
	if @@rowcount != 1
	begin
		select
        		status = "Error",
        		messsage = "Unable to book pending transaction",
        		account_transaction_id = @account_transaction_id,
        		account = @fund_settlement_ext_account,
        		transaction_type = @leg1_misc_exch_fee_type,
        		transaction_date = @trade_date,
        		product = @leg1_misc_exch_fee_ccy,
        		amount = @leg1_misc_exch_fee_amt_offset
		rollback tran
		return
	end
	end

	if @leg1_misc_oth_fee_amt != NULL and @leg1_misc_oth_fee_amt != 0
	begin
	
	exec
        	j_nextkey
                	"account_transactions",
                  	@account_transaction_id output
	
	insert into
		pending_transactions(
         		account_transaction_id,
         		entered_by,
         		external_account_id,
         		transaction_type_id,
         		transaction_date,
         		currency_id,
         		amount,
         		create_date,
         		status_id)
	values(
		@account_transaction_id,
		@tico_account_id,
		@c_external_account_id,
		@leg1_misc_oth_fee_type_id,
		@trade_date,
		@leg1_misc_oth_fee_ccy_id,
		@leg1_misc_oth_fee_amt,
		getdate(),
		@status_id)
	if @@rowcount != 1
	begin
		select
        		status = "Error",
        		messsage = "Unable to book pending transaction",
        		account_transaction_id = @account_transaction_id,
        		account = @c_external_account,
        		transaction_type = @leg1_misc_oth_fee_type,
        		transaction_date = @trade_date,
        		product = @leg1_misc_oth_fee_ccy,
        		amount = @leg1_misc_oth_fee_amt
		rollback tran
		return
	end

	exec
		j_nextkey
        		"account_transactions",
        		@account_transaction_id output
	insert into
		pending_transactions(
        		account_transaction_id,
        		entered_by,
        		external_account_id,
        		transaction_type_id,
        		transaction_date,
        		currency_id,
        		amount,
        		create_date,
        		status_id)
	values(
		@account_transaction_id,
		@tico_account_id,
		@fund_settlement_ext_account_id,
		@leg1_misc_oth_fee_type_id,
		@trade_date,
		@leg1_misc_oth_fee_ccy_id,
		@leg1_misc_oth_fee_amt_offset,
		getdate(),
		@status_id)
	if @@rowcount != 1
	begin
		select
        		status = "Error",
        		messsage = "Unable to book pending transaction",
        		account_transaction_id = @account_transaction_id,
        		account = @fund_settlement_ext_account,
        		transaction_type = @leg1_misc_oth_fee_type,
        		transaction_date = @trade_date,
        		product = @leg1_misc_oth_fee_ccy,
             		amount = @leg1_misc_oth_fee_amt_offset
		rollback tran
     		return
	end
	end
end

if @c2_suppress_trade != "Y"
begin
	if @leg2_misc_exch_fee_amt != NULL and @leg2_misc_exch_fee_amt != 0
	begin

	exec
		j_nextkey
        		"account_transactions",
        		@account_transaction_id output
	
	insert into
		pending_transactions(
        		account_transaction_id,
        		entered_by,
        		external_account_id,
        		transaction_type_id,
        		transaction_date,
        		currency_id,
        		amount,
        		create_date,
        		status_id)
	values(
		@account_transaction_id,
        	@tico_account_id,
        	@c2_external_account_id,
        	@leg2_misc_exch_fee_type_id,
        	@trade_date,
        	@leg2_misc_exch_fee_ccy_id,
        	@leg2_misc_exch_fee_amt,
        	getdate(),
        	@status_id)
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	messsage = "Unable to book pending transaction",
                	account_transaction_id = @account_transaction_id,
                	account = @c2_external_account,
                	transaction_type = @leg2_misc_exch_fee_type,
                	transaction_date = @trade_date,
                	product = @leg2_misc_exch_fee_ccy,
                	amount = @leg2_misc_exch_fee_amt
		rollback tran
        	return
	end
	
	exec
        	j_nextkey
                	"account_transactions",
                	@account_transaction_id output
	
	insert into
        	pending_transactions(
                	account_transaction_id,
                	entered_by,
                	external_account_id,
                	transaction_type_id,
                	transaction_date,
                	currency_id,
                	amount,
                	create_date,
                	status_id)
	values(
        	@account_transaction_id,
        	@tico_account_id,
        	@fund_settlement_ext_account_id,
        	@leg2_misc_exch_fee_type_id,
        	@trade_date,
        	@leg2_misc_exch_fee_ccy_id,
        	@leg2_misc_exch_fee_amt_offset,
        	getdate(),
        	@status_id)
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	messsage = "Unable to book pending transaction",
                	account_transaction_id = @account_transaction_id,
                	account = @fund_settlement_ext_account,
                	transaction_type = @leg2_misc_exch_fee_type,
                	transaction_date = @trade_date,
                	product = @leg2_misc_exch_fee_ccy,
                	amount = @leg2_misc_exch_fee_amt_offset
		rollback tran
        	return
	end
	end

	if @leg2_misc_oth_fee_amt != NULL and @leg2_misc_oth_fee_amt != 0
	begin

	exec
        	j_nextkey
                	"account_transactions",
                	@account_transaction_id output
	
	insert into
        	pending_transactions(
                	account_transaction_id,
                	entered_by,
                	external_account_id,
                	transaction_type_id,
                	transaction_date,
                	currency_id,
                	amount,
                	create_date,
                	status_id)
	values(
        	@account_transaction_id,
        	@tico_account_id,
        	@c2_external_account_id,
        	@leg2_misc_oth_fee_type_id,
        	@trade_date,
        	@leg2_misc_oth_fee_ccy_id,
        	@leg2_misc_oth_fee_amt,
        	getdate(),
        	@status_id)
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	messsage = "Unable to book pending transaction",
                	account_transaction_id = @account_transaction_id,
                	account = @c2_external_account,
                	transaction_type = @leg2_misc_oth_fee_type,
                	transaction_date = @trade_date,
                	product = @leg2_misc_oth_fee_ccy,
                	amount = @leg2_misc_oth_fee_amt
		rollback tran
        	return
	end
	
	exec
        	j_nextkey
                	"account_transactions",
                	@account_transaction_id output
	
	insert into
        	pending_transactions(
                	account_transaction_id,
                	entered_by,
                	external_account_id,
                	transaction_type_id,
                	transaction_date,
                	currency_id,
                	amount,
                	create_date,
                	status_id)
	values(
        	@account_transaction_id,
        	@tico_account_id,
        	@fund_settlement_ext_account_id,
        	@leg2_misc_oth_fee_type_id,
        	@trade_date,
        	@leg2_misc_oth_fee_ccy_id,
        	@leg2_misc_oth_fee_amt_offset,
        	getdate(),
        	@status_id)
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	messsage = "Unable to book pending transaction",
                	account_transaction_id = @account_transaction_id,
                	account = @fund_settlement_ext_account,
                	transaction_type = @leg2_misc_oth_fee_type,
                	transaction_date = @trade_date,
                	product = @leg2_misc_oth_fee_ccy,
                	amount = @leg2_misc_oth_fee_amt_offset
		rollback tran
        	return
	end
	end
end

if @otc_match_id != NULL
begin
	update
		otc_matches
	set
		execution_status_id = @booked_status_id,
		buyer_trade_id = @long_trade_id,
		seller_trade_id = @short_trade_id
	where	
		otc_match_id = @otc_match_id
end

commit tran
	
/* --------------------------------------------------------------------------
 * STEP: Send trade notifications
 *
 */

if @c_trade_id != NULL
begin
        exec
                 r_inserttradenotification
                             @trade_id = @c_trade_id
end

if @c2_trade_id != NULL
begin
        exec
                 r_inserttradenotification
                             @trade_id = @c2_trade_id
end


/* --------------------------------------------------------------------------
 * STEP: Send an acknowledgement that this trade processed through
 * 
 * The data required to send an ack must also be defined in the mapping.xml
 * and may differ platform to platform. If you change the below code, remember
 * to change the code above by the suppressed trade section
 */

if @ack_required = "Y"
begin
	select
		trade_report_id=@trade_report_id,
		symbol="ACCEPTED"
end

/*
select
	@end_time = getdate()
select
	@start_time,
	@end_time
*/


go
