
create or replace procedure
	tte_krakentally
		@default_login varchar(50),
		@source varchar(50),
		@broker varchar(50),
		@account varchar(100)=NULL,
		@apikey varchar(100)=NULL,
		@_id varchar(50) = NULL,
		@_trade_id varchar(50) = NULL,
		@_ordertxid varchar(50) = NULL,
		@_posstatus varchar(50) = NULL,
		@_pair varchar(50) = NULL,
		@_time varchar(50) = NULL,
		@_type varchar(50) = NULL,
		@_ordertype varchar(50) = NULL,
		@_cost varchar(50) = NULL,
		@_fee varchar(50) = NULL,
		@_vol varchar(50) = NULL,
		@_vol_closed varchar(50) = NULL,
		@_margin varchar(50) = NULL,
		@_value varchar(50) = NULL,
		@_net varchar(50) = NULL,
		@_terms varchar(50) = NULL,
		@_rollovertm varchar(50) = NULL,
		@_misc varchar(50) = NULL,
		@_oflags varchar(50) = NULL
as

/* select out all the parameters received and return them as a result set */

select
    @source as source,
    @default_login as default_login,
    @broker as broker,
    @account as account,
    @apikey as apikey,
    @_id as _id,
    @_ordertxid as _ordertxid,
    @_posstatus as _posstatus,
    @_pair as _pair,
    @_time as _time,
    @_type as _type,
    @_ordertype as _ordertype,
    @_cost as _cost,
    @_fee as _fee,
    @_vol as _vol,
    @_vol_closed as _vol_closed,
    @_margin as _margin,
    @_value as _value,
    @_net as _net,
    @_terms as _terms,
    @_rollovertm as _rollovertm,
    @_misc as _misc,
    @_oflags as _oflags

declare @mapped_symbol varchar(50)
declare @sender_comp varchar(50)
declare @target_comp varchar(50)
declare @exec_type varchar(50)
declare @execution_id varchar(100)
declare @trade_report_id varchar(50)
declare @order_id varchar(50)
declare @trade_link_id varchar(50)
declare @sender_trade_id varchar(50)
declare @symbol varchar(50)
declare @ccy1 varchar(50)
declare @ccy2 varchar(50)
declare @qty float
declare @counter_qty float
declare @price float
declare @last_spot_rate float
declare @side varchar(10)
declare @trade_date datetime
declare @trade_day datetime
declare @value_date datetime
declare @fixing_date datetime
declare @far_price float
declare @far_value_date datetime
declare @far_fixing_date datetime
declare @executing_trader varchar(50)
declare @executing_firm varchar(50)
declare @executing_system varchar(50)
declare @contra_firm varchar(50)
declare @clearing_firm varchar(50)
declare @giveup_clearing_firm varchar(50)
declare @entering_trader varchar(50)
declare @venue varchar(50)
declare @symbol_suffix varchar(20)

declare @client_or_market char(1)
declare @platform_identifier varchar(100)
declare @far_platform_identifier varchar(100)
declare @deal_exec_symbol varchar(100)

declare @broker_id int
declare @source_id int
declare @trade_id int
declare @deal_id int

declare @fund_agency_lookup varchar(30)
declare @is_fund_agency char(1)

declare @quantity numeric(30, 10)
declare @far_quantity numeric(30, 10)
declare @counter_quantity numeric(30, 10)
declare @contract varchar(50)

declare @prime_broker_lookup varchar(50)
declare @trader_lookup varchar(50)
declare @counterparty_lookup varchar(50)
declare @trader_mapping_error_id int
declare @cpty_mapping_error_id int
declare @trader_id int
declare @counterparty_id int
declare @trader_external_account_id int
declare @cpty_external_account_id int
declare @ea_external_account_id int
declare @ea_external_account varchar(50)
declare @ea_external_account_type varchar(50)
declare @ea_aggregation_style varchar(50)
declare @external_account varchar(50)
declare @suppress_trade varchar(50)
declare @suppression_lookup varchar(50)
declare @ack_required varchar(50)
