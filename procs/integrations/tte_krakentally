declare @far_tally_status varchar(10)
declare @far_tally_message varchar(25)

declare @trigger_symbol varchar(50)

declare @m_client_or_market char(1)
declare @m_platform_identifier varchar(100)
declare @m_far_platform_identifier varchar(100)
declare @m_deal_exec_symbol varchar(100)

declare @m_broker_id int
declare @m_source_id int
declare @m_trade_id int
declare @m_deal_id int

declare @m_fund_agency_lookup varchar(30)
declare @m_is_fund_agency char(1)

declare @m_quantity numeric(30, 10)
declare @m_far_quantity numeric(30, 10)
declare @m_contract varchar(20)

declare @m_prime_broker_lookup varchar(50)
declare @m_trader_lookup varchar(50)
declare @m_counterparty_lookup varchar(50)
declare @m_trader_mapping_error_id int
declare @m_cpty_mapping_error_id int
declare @m_trader_id int
declare @m_counterparty_id int
declare @m_trader_external_account_id int
declare @m_cpty_external_account_id int
declare @m_ea_external_account_id int
declare @m_ea_external_account varchar(50)
declare @m_ea_external_account_type varchar(50)
declare @m_ea_aggregation_style varchar(50)
declare @m_external_account varchar(50)
declare @m_suppress_trade varchar(50)
declare @m_suppression_lookup varchar(50)
declare @m_ack_required varchar(50)
declare @m_deal_type varchar(50)
declare @m_trade_type varchar(50)
declare @m_tally_type varchar(50)
declare @m_lookup_trader varchar(50)
declare @m_counterparty varchar(50)
declare @m_external_account_id int
declare @m_external_account_type varchar(50)
declare @m_trader_login varchar(50)
declare @m_trader varchar(50)
declare @m_far_trade_id int
declare @m_far_trade_type varchar(50)
declare @m_deal_status varchar(50)
declare @m_aggregation_style varchar(50)
declare @m_contract_id int
declare @m_inverted varchar(50)
declare @m_tally_status varchar(10)
declare @m_tally_message varchar(25)
declare @m_far_tally_status varchar(10)
declare @m_far_tally_message varchar(25)

declare @m_trigger_symbol varchar(50)

declare @c_client_or_market char(1)
declare @c_platform_identifier varchar(100)
declare @c_far_platform_identifier varchar(100)
declare @c_deal_exec_symbol varchar(100)

declare @c_broker_id int
declare @c_source_id int
declare @c_trade_id int
declare @c_deal_id int

declare @c_fund_agency_lookup varchar(30)
declare @c_is_fund_agency char(1)

declare @c_quantity numeric(30, 10)
declare @c_far_quantity numeric(30, 10)
declare @c_contract varchar(20)

declare @c_prime_broker_lookup varchar(50)
declare @c_trader_lookup varchar(50)
declare @c_counterparty_lookup varchar(50)
declare @c_trader_mapping_error_id int
declare @c_cpty_mapping_error_id int
declare @c_trader_id int
declare @c_counterparty_id int
declare @c_trader_external_account_id int
declare @c_cpty_external_account_id int
declare @c_ea_external_account_id int
declare @c_ea_external_account varchar(50)
declare @c_ea_external_account_type varchar(50)
declare @c_ea_aggregation_style varchar(50)
declare @c_external_account varchar(50)
declare @c_suppress_trade varchar(50)
declare @c_suppression_lookup varchar(50)
declare @c_suppression_lookup_cpty varchar(50)
declare @c_ack_required varchar(50)
declare @c_deal_type varchar(50)
declare @c_trade_type varchar(50)
declare @c_tally_type varchar(50)
declare @c_lookup_trader varchar(50)
declare @c_counterparty varchar(50)
declare @c_external_account_id int
declare @c_external_account_type varchar(50)
declare @c_trader_login varchar(50)
declare @c_trader varchar(50)
declare @c_far_trade_id int
declare @c_far_trade_type varchar(50)
declare @c_deal_status varchar(50)
declare @c_aggregation_style varchar(50)
declare @c_contract_id int
declare @c_inverted varchar(50)
declare @c_tally_status varchar(10)
declare @c_tally_message varchar(25)
declare @c_far_tally_status varchar(10)
declare @c_far_tally_message varchar(25)

declare @c_trigger_symbol varchar(50)
declare @c_strategy varchar(50)
declare @c_strategy_id int
declare @m_strategy varchar(50)
declare @m_strategy_id int

declare @deal_alias varchar(100)
declare @existing_alias varchar(100)
declare @netlink_pb_source_id int

declare @future_id int
declare @contract_size float
declare @determined_value_date datetime

declare @fee numeric(30, 10)
declare @fee_ccy varchar(50)
declare @account_transaction_id int

select
	@ack_required = "N"

if @ack_required = "Y" 
begin
        select
                trade_report_id=@trade_report_id,
                trade_report_status="ACCEPTED",
                exec_type="TRADE"
end





declare @message varchar(255)


/* --------------------------------------------------------------------------
 * STEP: Initial MAP proc parameters to common tally params
 * It may be that additional parameters are mapped further down in the 
 * stored procedure based on the result of @client_or_market
-------------------------------------------------------------------------- */
/* Defaults */
select
        @exec_type = "NEW"


/* Converted */
select
        @fee = convert(numeric(30, 10), @_fee) * -1,
        @platform_identifier = rtrim(@_pair)+"-"+rtrim(@_ordertxid)+"-"+rtrim(@_id),
        @price = convert(float, @_cost)/convert(float, @_vol),
        @quantity = convert(numeric(30, 10), @_vol),
        @trade_date = dbo.f_utctoeastern(dbo.f_datefromepochms(convert(bigint, convert(float, @_time) * 1000)))

/* Re-assigned */
select
        @fee_ccy = NULL,
        @deal_exec_symbol = @_ordertxid,
        @deal_alias = NULL,
        @side = @_type,
        @symbol = str_replace(@_pair, "ZUSD", "USD") /* Kraken calls USD, ZUSD so swap out here instead of mapping */

/* Dervived */
select
	@value_date = dbo.f_botradedate(@trade_date)

/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
	@source_id = source_id
from
	sources
where
	name = @source

if (@exec_type not in ("NEW", "REPLACE", "CANCELED"))
begin
	select
		@exec_type = "NEW"
end

/* --------------------------------------------------------------------------
 * STEP: Eval client or market
 * Determine if the trade is a client trade or if the trade is a market trade
 *      ALL TRADES ARE MAPPED TO MARKET
------------------------------------------------------------------------------ */
select
	    @client_or_market = "M",
        @m_platform_identifier = @platform_identifier


if @client_or_market = "M"
begin
    select
        @m_counterparty_lookup = rtrim(@account),
        @m_trader_lookup = rtrim(@apikey)
end
/* Set suppression and trigger_symbol variables */
select
        @m_suppression_lookup = @m_counterparty_lookup,
        @trigger_symbol = @m_counterparty_lookup



/* --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 * |     WARNING ------- WARNING -------- WARNING -------- WARNING          |
 * |                                                                        |
 * |                                                                        |
 * |  Do not make changes below this point                                  |
 * |  If you make changes, place comments about what was changed.           |
 * |                                                                        |
 * |                                                                        |
 * --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 */

/* CHANGE COMMENTS:
 *
 */



/* --------------------------------------------------------------------------
 * STEP: Dupe check on the identifier 
 *       Only need to check one ID
 *
 */

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@m_platform_identifier,
		@trade_id=@trade_id output



if @trade_id != NULL and @exec_type = "NEW"
begin
	/* tt_isdupe would throw error message, just return */
	return
end


/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols on market
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error. 
 */

/* Checking on market side */
exec
        ag_pendingmappingerrors
                @login = @default_login,
                @broker_id = @broker_id,
                @identifier = @m_platform_identifier,
                @trader_mapping_error_id = @m_trader_mapping_error_id output,
                @cpty_mapping_error_id = @m_cpty_mapping_error_id output
select m_trader_lookup = @m_trader_lookup, m_counterparty_lookup = @m_counterparty_lookup
exec
        tt_resolvetradermapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@m_platform_identifier,
                @mapping_error_id=@m_trader_mapping_error_id,
                @mapping=@m_trader_lookup,
                @trader_id=@m_trader_id output,
                @trader=@m_trader output,
                @trader_login=@m_trader_login output,
                @external_account_id=@m_trader_external_account_id output
exec
        tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@m_platform_identifier,
                @mapping_error_id=@m_cpty_mapping_error_id,
                @mapping = @m_counterparty_lookup,
                @counterparty_id=@m_counterparty_id output,
                @counterparty=@m_counterparty output,
                @cpty_external_account_id=@m_cpty_external_account_id output

if @m_trader_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "trader mapping error trade not processed for market side"
        return
end

if @m_counterparty_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "counterparty mapping error trade not processed for market side"
        return
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from the trader or counterparty, 
 *
 * On a client trade, the external account is determined by the trader
 * On a market trade, the external account is determined by the counterparty
 */

if @client_or_market = "M"
	select
		@m_external_account_id = @m_cpty_external_account_id
if @client_or_market = "C"
	select
		@m_external_account_id = @m_trader_external_account_id

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from mapped symbol 
 * 
 * If a symbol exists, then overwrite whatever was determined by the counterparty or trader.
 * Since a mapping is not required, send @mapping_error_id = 0 so that we do not send a message
 */
/* - for now, dont worry about any external account mappings. Might add back in later
exec
	tt_resolveextacctmapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
		@identifier=@platform_identifier,
		@mapping_error_id=0, /* sending as 0 will ensure a message is never sent */
		@external_account_id = @ea_external_account_id output,
		@external_account = @ea_external_account output,
		@external_account_type=@ea_external_account_type output,
		@aggregation_style=@ea_aggregation_style output
*/
/*
if @ea_external_account_id != NULL
begin
	select
		@external_account_id =  @ea_external_account_id,
                @external_account = @ea_external_account,
                @external_account_type = @ea_external_account_type,
                @aggregation_style = @ea_aggregation_style
end
else
begin
*/


select
        @m_external_account = a.symbol,
        @m_external_account_type = b.name,
        @m_aggregation_style = c.name
from
        external_accounts a,
        external_account_types b,
        aggregation_styles c
where
        a.external_account_type_id = b.external_account_type_id
and
        a.aggregation_style_id = c.aggregation_style_id
and
        a.external_account_id = @m_external_account_id



/* --------------------------------------------------------------------------
 * STEP: Autocreate strategy if strategy not found
 *
 */

select
    @m_strategy_id = b.strategy_id,
    @m_strategy = b.name
from
	account_strategies a,
	strategies b
where
	a.strategy_id = b.strategy_id
and
	a.external_account_id = @m_external_account_id
if @m_strategy_id = NULL
begin
    select
        @m_strategy_id = strategy_id,
	@m_strategy = name
    from    
        strategies
    where
        name = "Unknown"
    if @m_strategy_id = NULL
    begin
	    exec
		    j_nextkey
			    "strategies",
			    @m_strategy_id output
	    insert into
		    strategies(strategy_id,
		    	name)
	    values(
		    @m_strategy_id,
		    "Unknown")
		select
			@m_strategy = "Unknown"
    end
end


/* --------------------------------------------------------------------------
 * STEP: Check for suppression 
 *
 */
select
        @m_suppress_trade = "Y"
from
        suppression_symbols
where
        source_id = @source_id
and
        symbol = @m_suppression_lookup

if @m_suppress_trade = "Y"
begin
	select
		status = "Suppressing trade",
		m_platform_identifier = @m_platform_identifier,
		source = @source,
		m_suppression_lookup = @m_suppression_lookup

	/* We may store this data later on, but for now we will return out of tally */
	return
end

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 *      
 */

select
    @deal_type = "Market Forward",
    @trade_type = "Spot",
    @tally_type = "Spot"


/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * 
 * Default all trades right now to assume a 'B2B *' deal type
 */

exec
	tt_resolvedeal
		@deal_exec_symbol = @deal_exec_symbol,
		@deal_id = @deal_id output,
		@deal_type = @deal_type output,
		@deal_status = @deal_status output
if @deal_id = NULL
begin
	exec
		tt_newdeal
			@deal_type = @deal_type,
			@deal_status = @deal_status,
			@deal_exec_symbol = @deal_exec_symbol,
			@deal_id = @deal_id output
end

 

/* --------------------------------------------------------------------------
 * STEP: Determine the contract
 *
 */

if @trade_type = "Spot"
begin

	select
		@mapped_symbol = a.symbol
	from
		contracts a,
		contract_symbols b
	where
		a.contract_id = b.contract_id
	and
		b.source_id = @source_id
	and
		b.symbol = @symbol
	if @mapped_symbol != NULL
	begin
		select
			@symbol = @mapped_symbol
	end

	exec
		r_validateccypair
			@login=@default_login,
			@symbol=@symbol,
			@ccy1=@ccy1,
			@ccy2=@ccy2,
			@contract_id = @contract_id output,
			@contract = @contract output,
			@inverted = @inverted output

	if @contract_id = NULL
	begin
               select
                     @message="No contract mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@symbol) + "'"

                select
                        msg = @message

		if not exists(select message_id from messages  where content = @message)
		begin
 			exec
 				ag_sendfailedmappingmessage
 					@login=@default_login,
 					@broker_id=@broker_id,
 					@identifier=@m_platform_identifier,
 					@mapping_error_type="Contract",
 					@message = @message
		end
 		return

	end
	select
		@fee_ccy = a.symbol
	from
		products a,
		contracts b,
		forwards c
	where
		b.contract_id = c.contract_id
	and
		c.currency_id = a.product_id
	and
		b.contract_id = @contract_id
	if @fee_ccy = NULL
	begin
		select
			@message="No unable to determine fee ccy for " + rtrim(@source) + " for mapping value '" + rtrim(@symbol) + "'"
                if not exists(select message_id from messages  where content = @message)
                begin
                        exec
                                ag_sendfailedmappingmessage
                                        @login=@default_login,
                                        @broker_id=@broker_id,
                                        @identifier=@m_platform_identifier,
                                        @mapping_error_type="Contract",
                                        @message = @message
                end
		return
	end
end
else
begin
	if @trade_type = "Perpetual"
	begin 
		select 
			step = "Looking up ccy pair for perpetual contract",
			trade_type = @trade_type,
			symbol_suffix = @symbol_suffix
		/* lookup contract_symbols */
		select
			@contract_id = a.contract_id,
			@contract = a.symbol,
			@future_id = c.future_id,
			@inverted = "N"
		from
			contracts a,
			contract_symbols b,
			future_contracts c
		where
	 		a.contract_id = b.contract_id
		and
			a.contract_id = c.contract_id
		and
			c.expiration = NULL
		and
			b.symbol = @symbol
		and
			b.source_id = @source_id
		if @contract_id = NULL
		begin
			/* if not found look up in in contracts */
			select
				@contract_id = a.contract_id,
				@contract = a.symbol,
		        	@future_id = b.future_id
			from
				contracts a,
				future_contracts b
			where
				a.contract_id = b.contract_id
			and
				a.symbol = @symbol
			and
				b.expiration = NULL
			if @contract_id = NULL
			begin
				/* if not found try and find the future name */
				select
					@contract_id  = a.contract_id,
					@contract = a.symbol,
					@future_id = c.future_id
				from
					contracts a,
					future_contracts b,
					futures c
				where
					a.contract_id = b.contract_id
				and
					b.future_id = c.future_id
				and
					c.root_symbol = @symbol
				and
					b.expiration = NULL
				if @contract = NULL
				begin
					select
						status = "Error",
						message = "Contract symbol not found"



        				select
                				@message="No contract mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@symbol) + "'"
	
                			select
                        			msg = @message
                			if not exists(select message_id from messages  where content = @message)
                			begin
                				exec
                        				ag_sendfailedmappingmessage
                                				@login=@default_login,
                                				@broker_id=@broker_id,
                                				@identifier=@m_platform_identifier,
                                				@mapping_error_type="Contract",
                                				@message = @message
					end
					return
				end
			end
		end
	end

	if @trade_type = "Future"
	begin 
		select 
			step = "Looking up ccy pair for future contract",
			trade_type = @trade_type,
			symbol_suffix = @symbol_suffix
		/* lookup contract_symbols */
		select
			@contract_id = a.contract_id,
			@contract = a.symbol,
			@future_id = c.future_id,
			@value_date = c.expiration,
			@inverted = "N"
		from
			contracts a,
			contract_symbols b,
			future_contracts c
		where
	 		a.contract_id = b.contract_id
		and
			a.contract_id = c.contract_id
		/*and
			c.expiration = @value_date*/
		and
			b.symbol = @symbol
		and
			b.source_id = @source_id
		if @contract_id = NULL
		begin
			/* if not found look up in in contracts */
			select
				@contract_id = a.contract_id,
				@contract = a.symbol,
				@value_date = b.expiration,
		        	@future_id = b.future_id
			from
				contracts a,
				future_contracts b
			where
				a.contract_id = b.contract_id
			and
				a.symbol = @symbol
			/*and
				b.expiration = NULL*/
			if @contract_id = NULL
			begin
				/* if not found try and find the future name */
				select
					@contract_id  = a.contract_id,
					@contract = a.symbol,
					@value_date = b.expiration,
					@future_id = c.future_id
				from
					contracts a,
					future_contracts b,
					futures c
				where
					a.contract_id = b.contract_id
				and
					b.future_id = c.future_id
				and
					c.root_symbol = @symbol
				/*and
					b.expiration = NULL*/
				if @contract = NULL
				begin
					select
						status = "Error",
						message = "Contract symbol not found"
					return
				end
			end
		end
	end

end

if @future_id != NULL
begin
	select
		@contract_size = quantity
	from
		futures
	where
		future_id = @future_id
	
	if @contract_size not in(NULL, 0)
	begin
		select 
			action = "Converting quantity provided as asset value to contracts via the contract_size",
			pre_qty = @qty,
			contract_size = @contract_size,
			future_id = @future_id
		select
			@qty = @qty / @contract_size
	end	
end

/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the FIX message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund 
 * or agency so set the direction accordingly
 */


if @side = "buy"
begin
	select
		@m_quantity = @quantity
end
else if @side = "sell"
begin
	select
        @m_quantity = @quantity * -1
end
else
begin
    select
        status = "Error",
        message = "Side not recognized",
        side = @side
    return
end


/* --------------------------------------------------------------------------
 * STEP: Tally the trade market trade
 *
 */
if @m_suppress_trade != "Y"
begin
	if @exec_type="NEW"
	begin 
		exec
               		fxa_tallytrade
                       		@login = @default_login,
                       		@source = @source,
                       		@trade_id = @m_trade_id out,
                       		@deal_id = @deal_id out,
                       		@tally_type = @tally_type,
                       		@deal_type = @deal_type,
                       		@trade_type = @trade_type,
                       		@external_account = @m_external_account,
                       		@counterparty = @m_counterparty,
                       		@quantity = @m_quantity,
                       		@symbol = @contract,
                       		@value_date = @value_date,
                       		@fixing_date = @fixing_date,
                       		@price = @price,
                       		@trade_date = @trade_date,
                       		@trader = @m_trader,
                       		@broker = @broker,
				            @strategy = @m_strategy,
                       		@identifier = @m_platform_identifier,
                       		@spot_reference = @last_spot_rate
		select
                        @tally_status = "Success",
                        @tally_message = "Tallied market trade"

        exec
            api_addaccounttransaction
                @login = @default_login,
                @account = @account,
                @transaction_type = "Execution Fee",
                @amount = @fee,
                @product = @fee_ccy,
                @date = @trade_date,
                @note = @m_platform_identifier,
                @identifier = @m_platform_identifier,
                @source = @source,
                @account_transaction_id = @account_transaction_id output

        if @account_transaction_id = NULL
        begin
            select
                status = "Warning",
                message = "Problem adding account transaction for Execution Fee"
        end

	end
	if @exec_type in("REPLACE")
        begin

                exec
                        mc4_edittrade
                                @login=@default_login,
                                 @trade_id = @m_trade_id,
                                 @deal_id = @deal_id,
                                 @trade_type = @trade_type,
                                 @external_account = @m_external_account,
                                 @counterparty = @m_counterparty,
                                 @quantity = @m_quantity,
                                 @symbol = @contract,
                                 @value_date = @value_date,
                                 @fixing_date = @fixing_date,
                                 @price = @price,
                                 @trade_date = @trade_date,
                                 @trader = @m_trader
                select
                        @tally_status = "Success",
                        @tally_message = "Modified trade"
        end
        if @exec_type = "CANCELED"
        begin
                 exec
                         mc4_edittrade
                                 @login=@default_login,
                                 @trade_id = @m_trade_id,
                                 @quantity = 0
                select
                        @tally_status = "Success",
                        @tally_message = "Cancelled trade"
        end	
        if @m_trade_id = NULL
        begin
                select
                        @tally_status = "Error",
                        @tally_message = "Problem tallying market trade"
        end
        else
        begin

        	select
                	status = @tally_status,
                	message = @tally_message,
                	trade_id = @m_trade_id,
                	deal_id = @deal_id,
                	login = @m_trader_login,
                	source = @source,
                	tally_type = @tally_type,
                	deal_type = @deal_type,
                	trade_type = @trade_type,
                	external_account = @m_external_account,
                	counterparty = @m_counterparty,
                	quantity = @m_quantity,
                	symbol = @contract,
                	value_date = @value_date,
                	fixing_date = @fixing_date,
                	price = @price,
                	trade_date = @trade_date,
                	trader = @m_trader,
                	broker = @broker,
			strategy = @m_strategy,
                	identifier = @m_platform_identifier,
                	spot_reference = @last_spot_rate
	end
end

