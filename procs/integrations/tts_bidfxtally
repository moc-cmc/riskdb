create or replace procedure
	tts_bidfxtally
		/* Provided by FIX server config.properties & spring.xml */
                @source varchar(50),
                @default_login varchar(50),
                @broker varchar(50),
                @granularity varchar(15)=NULL,
                /* Parsed from FIX message and provided by mapping.xml */
                /* session variables */
                @sender_comp varchar(50),
                @target_comp varchar(50),
		@target_sub varchar(50)=NULL,
		@sender_sub varchar(50)=NULL,
                /* identifiers */
                @execution_id varchar(100)=NULL,
                @trade_report_id varchar(50),
                @order_id varchar(50),
                @cl_order_id varchar(50)=NULL,
		@cl_orig_order_id varchar(50)=NULL,
		@sec_order_id varchar(50)=NULL,
                /*financials*/
                @symbol varchar(50)=NULL,
                @ccy1 varchar(50)=NULL,
                @ccy2 varchar(50)=NULL,
                @qty float,
		@counter_qty float=NULL,
                @price float,
                @side varchar(10),
                @trade_date datetime,
                @trade_day datetime,
                @value_date datetime,
		@fixing_date datetime=NULL,
		@order_status varchar(50)=NULL,
		@time_in_force varchar(50)=NULL,
                /*swaps*/
                @swap_leg varchar(10),
                @far_price float=NULL,
		@far_value_date datetime=NULL,
		@far_fixing_date datetime=NULL,
                /*options*/
                @strike varchar(20)=NULL,
                @option_vol float=NULL,
                @opt_cut_time varchar(50)=NULL,
                @opt_premium_ccy varchar(50)=NULL,
                @opt_hedge varchar(50)=NULL,
                @call_put varchar(10)=NULL,
                @option_expiry_date datetime=NULL,
                @option_premium_settle datetime=NULL,
                /*parties*/
		@account varchar(50)=NULL,
                @executing_trader varchar(50)=NULL,
                @executing_firm varchar(50)=NULL,
                @contra_firm varchar(50)=NULL,
		@sponsoring_firm varchar(50)=NULL,
                @on_behalf_of_sub_id varchar(50)=NULL,
                @on_behalf_of_comp_id varchar(50)=NULL,
                @deliver_to_comp_id varchar(50)=NULL,
		@text varchar(50)=NULL

as

declare @client_or_market char(1)
declare @platform_identifier varchar(100)
declare @far_platform_identifier varchar(100)
declare @deal_exec_symbol varchar(100)

declare @broker_id int
declare @source_id int
declare @trade_id int
declare @deal_id int

declare @fund_agency_lookup varchar(30)
declare @is_fund_agency char(1)

declare @quantity numeric(30, 2)
declare @far_quantity numeric(30, 2)
declare @contract varchar(20)

declare @prime_broker_lookup varchar(50)
declare @trader_lookup varchar(50)
declare @counterparty_lookup varchar(50)
declare @trader_mapping_error_id int
declare @cpty_mapping_error_id int
declare @trader_id int
declare @counterparty_id int
declare @trader_external_account_id int
declare @cpty_external_account_id int
declare @ea_external_account_id int
declare @ea_external_account varchar(50)
declare @ea_external_account_type varchar(50)
declare @ea_aggregation_style varchar(50)
declare @external_account varchar(50)
declare @suppress_trade varchar(50)
declare @suppression_lookup varchar(50)
declare @ack_required varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @lookup_trader varchar(50)
declare @counterparty varchar(50)
declare @external_account_id int
declare @external_account_type varchar(50)
declare @trader_login varchar(50)
declare @trader varchar(50)
declare @far_trade_id int
declare @far_trade_type varchar(50)
declare @deal_status varchar(50)
declare @aggregation_style varchar(50)
declare @last_spot_rate float
declare @contract_id int
declare @inverted varchar(50)
declare @tally_status varchar(10)
declare @tally_message varchar(25)
declare @far_tally_status varchar(10)
declare @far_tally_message varchar(25)
declare @trigger_symbol varchar(50)
declare @swap_symbol_id int
declare @swap_symbol varchar(50)
declare @timezone varchar(50)
declare @timezone_symbol varchar(50)
declare @strike_char varchar(20)
declare @quantity_char varchar(50)
declare @option_premium_char varchar(50)
declare @cl_or_lp varchar(5)
declare @dealt_ccy varchar(3)
declare @counter_ccy varchar(3)
declare @deal_type_id int


/* Do not evaluate option hedges on naked options */
if @opt_hedge != NULL and @qty = 0
begin
        select
                msg = "Option hedge quantity is 0. Not tallying"
        return
end


/* --------------------------------------------------------------------------
 * STEP: Initial MAP proc parameters to common tally params
 * It may be that additional parameters are mapped further down in the 
 * stored procedure based on the result of @client_or_market
 */
select
	@fund_agency_lookup = @on_behalf_of_comp_id

/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * Broker and source should be passed in via the the fix engine
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */
select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
	@source_id = source_id
from
	sources
where
	name = @source


/* --------------------------------------------------------------------------
 * STEP: Eval client or market
 * Determine if the trade is a client trade or if the trade is a market trade
 * some platforms provide an explicit tag. evaluate that tag here and set 
 * @client_or_market to either "C" or "M". Raise an error message if you can't
 * determine. If no tag (or combination of tags) are provided, then set the
 * the @client_or_market_lookup and check to see if it maps to a fund agency 
 * counterparty by calling tt_isfundagency. 
 * This logic usually differs platform by platform
 *
 */ 

/* If this connection is determining client or market based of data value, then use this block */
exec
	tt_isfundagency
		@source_id=@source_id,
		@mapping=@fund_agency_lookup,
		@is_fund_agency=@is_fund_agency output
select
	@client_or_market = "M"

if @is_fund_agency = "Y"
	select
		@client_or_market = "C"

/* --------------------------------------------------------------------------
 * STEP: Map proc parameters to common tally variable name
 * This mapping allows us to use common variable names in all tallies. It also
 * helps with debugging, as you can look here to see what is mapped
 * For multi-prime setups that don't have a pb tag, set the prime_broker_lookup to ""
 *
 */

select
	@deal_exec_symbol = rtrim(@cl_order_id)+'-'+convert(char(8), @trade_date, 112)

if @client_or_market = "C"
begin
	select
		@platform_identifier = rtrim(@execution_id)+convert(char(8), @trade_date, 112)+".c"

	select
		@counterparty_lookup = rtrim(@sender_comp),
		@trader_lookup = @account+"-"+rtrim(@on_behalf_of_sub_id)

	/* Set suppression and trigger_symbol variables */
        select
                @suppression_lookup = @trader_lookup,
                @trigger_symbol = @trader_lookup	
end
else /* @client_or_market = "M" */
begin
	select
		@platform_identifier = rtrim(@execution_id)+convert(char(8), @trade_date, 112)+".m"

        select
                @counterparty_lookup = @account+"-"+rtrim(@on_behalf_of_comp_id),
                @trader_lookup = rtrim(@sender_comp)

        /* Set suppression and trigger_symbol variables */
        select
                @suppression_lookup = @counterparty_lookup,
                @trigger_symbol = @counterparty_lookup

end


/* --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 * |     WARNING ------- WARNING -------- WARNING -------- WARNING          |
 * |                                                                        |
 * |                                                                        |
 * |  Do not make changes below this point                                  |
 * |  If you make changes, place comments about what was changed.           |
 * |                                                                        |
 * |                                                                        |
 * --------------------------------------------------------------------------
 * --------------------------------------------------------------------------
 */

/* CHANGE COMMENTS:
 * Added logic to handle messages containing single leg of swap
 * Added logic to handle option messages
 */


/* --------------------------------------------------------------------------
 * STEP: Dupe check on the identifier 
 *
 */

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@platform_identifier,
		@trade_id=@trade_id output

if @trade_id != NULL
begin
	/* tt_isdupe would throw error message, just return */
	return
end



/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error. 
 */
exec
	ag_pendingmappingerrors
		@login = @default_login,
        	@broker_id = @broker_id,
        	@identifier = @platform_identifier,
        	@trader_mapping_error_id = @trader_mapping_error_id output,
		@cpty_mapping_error_id = @cpty_mapping_error_id output

exec
	tt_resolvetradermapping
		@login=@default_login,
		@source_id=@source_id,
		@source=@source,
		@broker_id=@broker_id,
		@identifier=@platform_identifier,
		@mapping_error_id=@trader_mapping_error_id,
		@mapping=@trader_lookup,
		@trader_id=@trader_id output,
		@trader=@trader output,
		@trader_login=@trader_login output,
		@external_account_id=@trader_external_account_id output

exec
	tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@platform_identifier,
                @mapping_error_id=@cpty_mapping_error_id,
		@mapping = @counterparty_lookup,
		@counterparty_id=@counterparty_id output,
		@counterparty=@counterparty output,
		@cpty_external_account_id=@cpty_external_account_id output

if @trader_id = NULL
begin
	select 
		status = "Error",
   		error = "Error",
   		message = "trader mapping error trade not processed"
        return
end

if @counterparty_id = NULL
begin
	select 
		status = "Error",
		error = "Error",
		message = "counterparty mapping error trade not processed"
        return
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from the trader or counterparty, 
 *
 * On a client trade, the external account is determined by the trader
 * On a market trade, the external account is determined by the counterparty
 */

if @client_or_market = "C"
begin
	select
		@external_account_id = @trader_external_account_id
end
else /* @client_or_market = "M" */
begin
	select
		@external_account_id = @cpty_external_account_id
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from mapped symbol 
 * 
 * If a symbol exists, then overwrite whatever was determined by the counterparty or trader.
 * Since a mapping is not required, send @mapping_error_id = 0 so that we do not send a message
 */
/* - for now, dont worry about any external account mappings. Might add back in later
exec
	tt_resolveextacctmapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
		@identifier=@platform_identifier,
		@mapping_error_id=0, /* sending as 0 will ensure a message is never sent */
		@external_account_id = @ea_external_account_id output,
		@external_account = @ea_external_account output,
		@external_account_type=@ea_external_account_type output,
		@aggregation_style=@ea_aggregation_style output
*/

if @ea_external_account_id != NULL
begin
	select
		@external_account_id =  @ea_external_account_id,
                @external_account = @ea_external_account,
                @external_account_type = @ea_external_account_type,
                @aggregation_style = @ea_aggregation_style
end
else
begin
	select
                @external_account = a.symbol,
                @external_account_type = b.name,
                @aggregation_style = c.name
	from
		external_accounts a,
		external_account_types b,
		aggregation_styles c
	where
		a.external_account_type_id = b.external_account_type_id
	and
		a.aggregation_style_id = c.aggregation_style_id
	and
		a.external_account_id = @external_account_id
end

/* --------------------------------------------------------------------------
 * STEP: Check for suppression 
 *
 */
select
	@suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id
and
	symbol = @suppression_lookup

if @suppress_trade = "Y"
begin
	select
		status = "Suppressing trade",
		platform_identifier = @platform_identifier,
		source = @source,
		suppression_lookup = @suppression_lookup

	if @ack_required = "Y"
	begin
        	select
                	trade_report_id=@trade_report_id,
                	symbol="NA"
	end

	/* We may store this data later on, but for now we will return out of tally */
	return
end

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 *
 */

select
	@deal_type = "B2B Forward",
	@trade_type = "Spot",
	@tally_type = "Spot"

if @fixing_date != NULL
	select
		@trade_type = "Forward",
		@tally_type = "Forward"

if @far_price != NULL
begin
        select
                @deal_type = "B2B Swap",
                @trade_type = "Swap Near",
                @far_trade_type = "Swap Far",
                @tally_type = "Swap",
		@far_platform_identifier=@platform_identifier + ".f"
end

if @swap_leg = "NEAR"
begin
        select
                @deal_type = "B2B Swap",
                @trade_type = "Swap Near",
                @tally_type = "Swap"
end
if @swap_leg = "FAR"
begin
        select
                @deal_type = "B2B Swap",
                @trade_type = "Swap Far",
                @tally_type = "Swap",
                @fixing_date = @far_fixing_date
end

if @strike != null
begin
        select
                @deal_type = "Market Option",
                @trade_type = "Option",
                @tally_type = "Option"
end

/* --------------------------------------------------------------------------
 * STEP: Manage neccesary option variables
 *
 */

if @trade_type = "Option"
begin
        if @price < 0
        begin
                select
                        @price = @price * -1
        end
	select
                @quantity_char = convert(varchar(50), @qty),
                @option_premium_char = convert(varchar(50), @price),
                @option_vol = @option_vol / 100

	select
		@timezone_symbol = @opt_cut_time
	select
		@timezone = a.timezone
	from
		timezones a,
		timezone_symbols b,
		sources c
	where
		a.timezone_id = b.timezone_id
	and
		b.source_id = c.source_id
	and
		c.source_id = @source_id
	and
		b.symbol = @timezone_symbol
	
	if @timezone = NULL
	begin
		select
			status = "Error",
			msg = "No timezone mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@timezone_symbol) + "'"	
		return
	end

	if @client_or_market = "C"
	begin
		select 
			@cl_or_lp = "CL",
			@deal_type = "Client Option"
	end
	else
	begin
		select
			@cl_or_lp = "LP",
			@deal_type = "Market Option"
	end


	if @call_put = "Call"
	begin
		select
			@call_put = "C"
	end
	else
	begin
		select
			@call_put = "P"
	end

end

/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * 
 * Default all trades right now to assume a 'B2B *' deal type
 */



exec
	tt_resolvedeal
		@deal_exec_symbol = @deal_exec_symbol,
		@deal_id = @deal_id output,
		@deal_type = @deal_type output,
		@deal_status = @deal_status output
if @deal_id = NULL
begin
	exec
		tt_newdeal
			@deal_type = @deal_type,
			@deal_status = @deal_status,
			@deal_exec_symbol = @deal_exec_symbol,
			@deal_id = @deal_id output
end
else /* Override deal type to be option in case we recieved the option hedge first */
begin
        if @trade_type = "Option"
        begin
                if @deal_type = "B2B Forward"
                begin
                        if @client_or_market = "C"
                        begin
                                select
                                        @deal_type = "Client Option"
                        end
                        else
                        begin
                                select
                                        @deal_type = "Market Option"
                        end

                        select
                                @deal_type_id = deal_type_id
                        from
                                deal_types
                        where
                                name = @deal_type
                        if @deal_type_id = NULL
                        begin
                                select
                                        status = "Error",
                                        deal_id = @deal_id,
                                        deal_type = @deal_type,
                                        msg = "Cannot find deal type to override deal_type_id"
                                return
                        end
                        else
                        begin
                                begin tran
                                        update
                                                 deals
                                        set
                                                 deal_type_id = @deal_type_id
                                        where
                                                 deal_id = @deal_id

                                        if @@rowcount != 1
                                        begin
                                                select
                                                        status = "Error",
                                                        msg = "Problem overriding deal type to " + @deal_type
                                                rollback tran
                                                return
                                        end

                                commit tran

                        end
                end
        end
end


/* --------------------------------------------------------------------------
 * STEP: Determine the contract for non option. Determine dealt_ccy and counter_ccy for option
 *
 */

if @trade_type != "Option"
begin
	exec
		r_validateccypair
			@login=@default_login,
			@symbol=@symbol,
			@ccy1=@ccy1,
			@ccy2=@ccy2,
			@contract_id = @contract_id output,
			@contract = @contract output,
			@inverted = @inverted output
end
else
begin
	if @ccy1 = substring(@symbol, 1, 3)
    	begin
		select
			@dealt_ccy = @ccy1,
			@counter_ccy = substring(@symbol, 4, 6)
	end
	else
	begin
		select
			@dealt_ccy = @ccy1,
			@counter_ccy = substring(@symbol, 1, 3)
	end
end


/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the FIX message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund 
 * or agency so set the direction accordingly
 */

if @client_or_market = "C"
begin
	if @side = "BUY"
		select
			@quantity = @qty
	if @side = "SELL"
                select
                        @quantity = @qty * -1 
end
else /* if @client_or_market = "M" */
begin
	if @side = "SELL"
		select
			@quantity = @qty * -1 
	if @side = "BUY"
                select
                        @quantity = @qty

end

/* --------------------------------------------------------------------------
 * STEP: Tally the trade
 *
 */
if @trade_type != "Option"
begin
        exec
	        fxa_tallytrade
		        @login = @trader_login,
		        @source = @source,
		        @trade_id = @trade_id out,
		        @deal_id = @deal_id out,
		        @tally_type = @tally_type,
		        @deal_type = @deal_type,
		        @trade_type = @trade_type,
		        @external_account = @external_account,
		        @counterparty = @counterparty,
		        @quantity = @quantity,
		        @symbol = @contract,
		        @value_date = @value_date,
		        @fixing_date = @fixing_date,
		        @price = @price,
		        @trade_date = @trade_date,
		        @trader = @trader,
		        @broker = @broker,
		        @identifier = @platform_identifier,
		        @spot_reference = @last_spot_rate

        if @trade_id = NULL
                begin
	                select
		                @tally_status = "Error",
		                @tally_message = "Problem tallying trade"
                end
        else
        begin
	        select
		        @tally_status = "Success",
		        @tally_message = "Tallied trade"
        end

        select 
	        status = @tally_status,
	        message = @tally_message,
	        trade_id = @trade_id,
	        login = @trader_login,
	        source = @source,
	        deal_id = @deal_id,
	        tally_type = @trade_type,
	        deal_type = @deal_type,
	        trade_type = @trade_type,
	        external_account = @external_account,
	        counterparty = @counterparty,
	        quantity = @quantity,
	        symbol = @contract,
	        value_date = @value_date,
	        fixing_date = @fixing_date,
	        price = @price,
	        trade_date = @trade_date,
	        trader = @trader,
	        broker = @broker,
	        identifier = @platform_identifier,
	        spot_reference = @last_spot_rate

        if @tally_status = "Error"
        begin
	        return
        end

        if @swap_leg in("NEAR","FAR")
        begin
	        select
		        @swap_symbol = symbol
	        from
		        swap_symbols
	        where
		        symbol = rtrim(convert(varchar(50), @deal_id)) +"."+@client_or_market

	        if @swap_symbol = NULL
	        begin
		        exec
			        j_nextkey
				        "swap_symbols",
				        @swap_symbol_id output
		        select
			        @swap_symbol = rtrim(convert(varchar(50), @deal_id)) +"."+@client_or_market
		        insert into
			        swap_symbols
		        (
			        swap_symbol_id,
			        symbol,
			        timestamp
		        )
		        values
		        (
			        @swap_symbol_id,
			        @swap_symbol,
			        getdate()
		        )
	        end
	        else
	        begin
		        select
			        @swap_symbol_id =  swap_symbol_id
		        from
			        swap_symbols
		        where
			        symbol = @swap_symbol
	        end

	        insert into 
		        swap_symbol_trades
	        (
		        swap_symbol_id,
		        trade_id
	        )
	        values
	        (
		        @swap_symbol_id,
		        @trade_id
	        )
        end
end

if @trade_type = "Option"
begin
	
	exec
		api_tallyoptionsimple
			@login = @trader_login,
			@source = @source,
			@broker = @broker,
			@deal_type = @deal_type,
			@buy_sell = @side,
			@counterparty = @counterparty,
			@dealt_ccy = @dealt_ccy,
			@counter_ccy = @counter_ccy,
			@strike = @strike,
			@call_put = @call_put,
 			@timezone = @timezone,
			@expiration = @option_expiry_date,
			@option_settle = @value_date,
			@quantity = @quantity_char,
			@premium_ccy = @opt_premium_ccy,
			@premium_amount = @option_premium_char,
			@premium_settle = @option_premium_settle,
			@trade_date = @trade_date,
			@vol = @option_vol,
			@cl_or_lp = @cl_or_lp,
			@identifier = @platform_identifier,
			@trade_id = @trade_id output,
			@deal_id = @deal_id output

	if @trade_id = NULL
        begin
                select
                        @tally_status = "Error",
                        @tally_message = "Problem tallying trade"
        end
        else
        begin
                select
                        @tally_status = "Success",
                        @tally_message = "Tallied trade"
        end

        select
                status = @tally_status,
                message = @tally_message,
                trade_id = @trade_id,
                login = @trader_login,
                source = @source,
                deal_id = @deal_id,
                tally_type = @trade_type,
                deal_type = @deal_type,
                trade_type = @trade_type,
                external_account = @external_account,
                counterparty = @counterparty,
                quantity = @quantity_char,
                dealt_ccy = @dealt_ccy,
                counter_ccy = @counter_ccy,
                value_date = @value_date,
                expiry_date = @option_expiry_date,
                trade_date = @trade_date,
                strike = @strike,
                trader = @trader,
                broker = @broker,
                identifier = @platform_identifier
end

/* --------------------------------------------------------------------------
 * STEP: Book internal tickets if needed using @trigger_symbol
 *
 */
if @trade_id != NULL
begin
        exec
                r_ticketcreationvalues
                        @trigger_symbol = @trigger_symbol,
                        @login = @trader_login,
                        @source = @source,
                        @deal_id = @deal_id,
                        @deal_exec_symbol = @deal_exec_symbol,
                        @tally_type = @trade_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
