create or replace procedure
        ttm_importubsposinvswaps
		@login varchar(50),
		@ccy_pair varchar(15)=NULL,
		@instrument varchar(15)=NULL,
		@l_s varchar(10)=NULL,
		@position varchar(50)=NULL,
		@dealt_amount varchar(30)=NULL,
		@dealt_product varchar(30)=NULL,
		@contra_amount varchar(30)=NULL,
		@contra_product varchar(30)=NULL,
		@strike varchar(20)=NULL,
		@expiration varchar(10)=NULL,
		@cut varchar(10)=NULL,
		@settlement varchar(20)=NULL,
		@fixing_date varchar(20)=NULL,
		@premium varchar(30)=NULL,
		@premium_product varchar(20)=NULL,
		@premium_settlement_date varchar(20)=NULL,
		@bar_level_1 varchar(10)=NULL,
		@bar_type_1 varchar(10)=NULL,
		@bar_level_2 varchar(10)=NULL,
		@bar_type_2 varchar(10)=NULL,
		@trade_date varchar(20)=NULL,
		@deal varchar(50)=NULL,
		@account varchar(50)=NULL,
		@broker varchar(50)=NULL
as

declare @source varchar(50)
declare @source_id int
declare @symbol varchar(50)
declare @ccy1 varchar(50)
declare @ccy2 varchar(50)
declare @tally_qty float
declare @tally_price float
declare @tally_trade_date datetime
declare @tally_value_date datetime
declare @tally_fixing_date datetime

declare @quantity numeric(30, 2)

declare @account_lookup varchar(50)
declare @counterparty_lookup varchar(50)

declare @internal_account varchar(50)
declare @counterparty_id int
declare @counterparty varchar(50)
declare @external_account_id int
declare @external_account varchar(50)

declare @contract_id int
declare @inverted varchar(50)
declare @tally_status varchar(10)
declare @tally_message varchar(25)

declare @remote_trade_symbol_id int
declare @identifier varchar(100)
declare @contract varchar(50)
declare @side varchar(50)

declare @leg_value_date datetime
declare @swap_far_trade_type_id int
declare @leg_trade_id int
declare @near_trade_id int
declare @far_trade_id int
declare @trade_id int
declare @trade_type varchar(25)
declare @trader varchar(50)
declare @deal_type varchar(50)
declare @deal_status varchar(50)
declare @deal_id int

select @source = "UBS Pos File Import"

select
        @source_id = source_id
from
        sources
where
        name = @source

if @source_id = NULL
begin
	select
		status = "Error",
		message = "Missing source '"+rtrim(@source)+"'"
	return
end

if @instrument != "Swap"
begin
	select
		status = "Error",
		message = "Instruments must be Swaps",
		instrument=@instrument
	return
end


/* STEP: Stub
 *
select
	status="STUB - Not Loading",
	source = @source,
	ccy_pair=@ccy_pair,
	instrument=@instrument,
	l_s=@l_s,
	position=@position,
	dealt=@dealt_amount,
	deal_product=@dealt_product,
	contra=@contra_amount,
	contra_product=@contra_product,
	strike=@strike,
	expiration=@expiration,
	cut=@cut,
	settlement=@settlement,
	fixing_date=@fixing_date,
	premium=@premium,
	prem_product=@premium_product,
	prem_settle_date=@premium_settlement_date,
	trade_date=@trade_date,
	deal_id=@deal,
	account=@account,
	broker=@broker

return
*/

/* --------------------------------------------------------------------------
 * STEP: Map params and convert
 *
 */

if @fixing_date = ""
begin
	select
		@fixing_date = NULL
end
select
	@tally_qty = convert(numeric(30, 4), @dealt_amount),
	@tally_price = convert(float, @strike),
	@tally_trade_date = convert(datetime, @trade_date),
	@tally_value_date = convert(datetime, @settlement),
	@tally_fixing_date = convert(datetime, @fixing_date),
	@ccy1 = @dealt_product,
	@ccy2 = @contra_product,
	@identifier = rtrim(@deal)

exec
        tt_resolvedeal
                @deal_exec_symbol = @identifier,
                @deal_id = @deal_id output,
                @deal_type = @deal_type output,
                @deal_status = @deal_status output

if @deal_id = NULL
begin
        exec
                tt_newdeal
                        @deal_type = "Market Swap",
                        @deal_status = "User Review",
                        @deal_exec_symbol = @identifier,
                        @deal_id = @deal_id output
end


if @tally_qty > 0 
begin
	select
		@identifier = rtrim(@identifier)+"_B"
end
else
begin
	select
		@identifier = rtrim(@identifier)+"_S"
end


select
	@account_lookup = rtrim(@account),
	@counterparty_lookup = rtrim(@account)+"-"+rtrim(@broker)


/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error.
 */

select
	@external_account_id = a.external_account_id,
	@external_account = a.symbol
from
	external_accounts a,
	external_account_symbols b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id
and
	b.symbol = @account_lookup
if @external_account_id  = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "account mapping error trade not processed",
		account_lookup = @account_lookup
        return
end

select
        @counterparty_id = a.counterparty_id,
        @counterparty = a.name
from
        counterparties a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id
and
        b.symbol  = @counterparty_lookup
if @counterparty_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "counterparty mapping error trade not processed",
		counterparty_lookup = @counterparty_lookup
        return
end

select
	@trader = a.symbol
from
        traders a,
        trader_symbols b,
        tico_accounts c
where
        a.trader_id = b.trader_id
and
        b.source_id = @source_id
and
        a.tico_account_id = c.account_id
and
        b.symbol = @account_lookup

if @trader = NULL
begin
	select
		status="Error",
                message="No trader mapping for source " + rtrim(@source) + " for mapping value '" + rtrim(@account_lookup) + "'"

	return
end

/* --------------------------------------------------------------------------
 * STEP: Determine the contract
 *
 */

exec
        r_validateccypair
                @login=@login,
                @symbol=@symbol,
                @ccy1=@ccy1,
                @ccy2=@ccy2,
                @contract_id = @contract_id output,
                @contract = @contract output,
                @inverted = @inverted output


/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 * The direction of the trade can be affected by the side and the perspective
 * of the message. Some platforms have different perspectives for client
 * messages vs market messages. We tally trades in perspective of the fund
 * or agency so set the direction accordingly
 */

select
		@quantity = @tally_qty * 1


/* --------------------------------------------------------------------------
 * STEP: Tally the trade
 *
 */

select
	@leg_trade_id = trade_id
from
	trades
where
	deal_id = @deal_id
if @@rowcount > 1
	begin
		select
			error = "Error",
			msg = "More than 1 trade in this deal, can not do swap determination"
			return
	end

if @leg_trade_id != NULL
begin	
	select
		@leg_value_date = value_date
	from
		trades
	where
		trade_id = @leg_trade_id
	
	if @tally_value_date > @leg_value_date
	begin
		select
			@trade_type = "Swap Far",
			@near_trade_id = @leg_trade_id,
			@far_trade_id = NULL /* will be set to @trade_id */
	end
	else
	begin

		select
			@trade_type = "Swap Near",
			@near_trade_id = NULL, /* will be set to @trade_id */
			@far_trade_id = @leg_trade_id
		
		begin tran
			select
				@swap_far_trade_type_id = trade_type_id
			from	
				trade_types
			where
				name="Swap Far"

			if @@rowcount !=1
			begin
				select
					status="Error",
					message="Could not locate far swap trade type",
					trade_type="Swap Far"
				return
			end

			update
				trades
			set
				trade_type_id = @swap_far_trade_type_id
			where
				trade_id = @leg_trade_id
			
			if @@rowcount != 1
			begin
				select
					error = "Error",
					msg = "Problem updating far leg trade type",
					deal_id = @deal_id,
					leg_trade_id = @leg_trade_id,
					leg_value_date = @leg_value_date	
				rollback
				return
			end
		commit tran
	end
end
else
begin
	/* assume first record is near */
	select
		@trade_type="Swap Near"
end

/* --------------------------------------------------------------------------
 * STEP: Tally the trade
 *
 */
exec
	fxa_tallytrade
		@login = @login,
		@source = @source,
		@trade_id = @trade_id out,
		@deal_id = @deal_id out,
		@tally_type = @instrument,
		@deal_type = "Market Swap",
		@trade_type = @trade_type,
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @tally_qty,
		@symbol = @contract,
		@value_date = @tally_value_date,
		@fixing_date = @tally_fixing_date,
		@price = @tally_price,
		@trade_date = @tally_trade_date,
		@trader = @trader,
		@broker = @broker,
		@identifier = @identifier

if @trade_id = NULL
begin
	select
		@tally_status = "Error",
		@tally_message = "Problem tallying trade"
end
else
begin
	select
		@tally_status = "Success",
		@tally_message = "Tallied trade"

	if @far_trade_id = NULL
	begin
		select
			@far_trade_id = @trade_id
	end
	if @near_trade_id = NULL
	begin
		select
			@near_trade_id = @trade_id
	end
end

if @tally_status = "Error"
begin
	return
end

select
        status = @tally_status,
        message = @tally_message,
        login = @login,
        source = @source,
        external_account = @external_account,
        counterparty = @counterparty,
        quantity = @quantity,
        symbol = @symbol,
        value_date = @tally_value_date,
        fixing_date = @tally_fixing_date,
        price = @tally_price,
        trade_date = @tally_trade_date,
        identifier = @identifier

go
