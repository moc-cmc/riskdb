drop procedure
	ag_importfsscurvefile
go

create procedure
	ag_importfsscurvefile
		@login varchar(50),
		@trade_date varchar(50),
		@currency varchar(50),
		@tenor varchar(20),
		@value_date varchar(20),
		@usd_interest varchar(50),
		@fcy_interest varchar(50),
		@forward_rate varchar(50),
		@forward_points varchar(50)
as

declare @tico_account_id int
declare @rate_date datetime
declare @val_date datetime
declare @product_id int
declare @days int
declare @rate float
declare @product_rate_id int
declare @source_id int 
declare @price float
declare @bo_price_id int
declare @status_id int

declare @usd_product_id int
declare @usd_rate float
declare @usd_product_rate_id int

declare @spot_price float
declare @contract_id int
declare @standard_contract_id int
declare @price_style varchar(50)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@source_id = source_id
from
	sources
where
	name = "MPT"
if @source_id = NULL
begin
	select
		status = "Error",
		message = "MPT Source not found"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "Active"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Active status not found"
	return
end


select
	@rate_date = convert(datetime, @trade_date),
	@val_date = convert(datetime, @value_date),
	@usd_rate = convert(float, @usd_interest) / 100.00,
	@rate = convert(float, @fcy_interest) / 100.00,
	@price = convert(numeric(30,10), @forward_rate)

select
	@days = datediff(day, @rate_date, @val_date)

select
	@rate_date = dateadd(hour, 17, convert(datetime, convert(date, @rate_date)))


select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"
if @usd_product_id = NULL
begin
	select
		status = "Error",
		message = "USD product not found"
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = @currency
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @currency
	return
end

select
	@contract_id = contract_id
from
	forwards
where
	product_id = @product_id
and
	currency_id = @usd_product_id
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found for product vs USD",
		product = @currency
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id
if @price_style = "Inverted"
begin
	exec
		r_invertedcontract
			@contract_id = @contract_id,
			@inverted_contract_id = @standard_contract_id output
end
else
begin
	select
		@standard_contract_id = @contract_id
end


/* Adjusting logic to use @tenor instead of @rate_date = @valued_date. This was saving @tenor = "TDY" instead of "SPOT". WD 5/7/19 */
/* if @rate_date = @val_date */

if @tenor="SPT"
begin
	update
		bo_spot_settles
	set
		price = @price
	where
		contract_id = @standard_contract_id
	and
		source_id = @source_id
	and
		convert(date, price_date) = convert(date, @rate_date)
	if @@rowcount = 0
	begin
		insert into
			bo_spot_settles(
				contract_id,
				source_id,
				price_date,
				price)
		values(
			@standard_contract_id,
			@source_id,
			@rate_date,
			@price)
	end
end

update
	bo_prices
set
	price = @price
where
	contract_id = @standard_contract_id
and
	convert(date, price_date) = convert(date, @rate_date)
and
	source_id = @source_id
if @@rowcount = 0
begin
	exec
		j_nextkey
			"bo_prices",
			@bo_price_id output

	insert into
		bo_prices(
			bo_price_id,
			status_id,
			contract_id,
			price_date,
			value_date,
			source_id,
			price)
	values(
		@bo_price_id,
		@status_id,
		@standard_contract_id,
		@rate_date,
		@val_date,
		@source_id,
		@price)
end


if @fcy_interest = NULL or @usd_interest = NULL
	return

select
	@product_rate_id = product_rate_id
from
	product_rates
where
	product_id = @product_id
and
	rate_date = @rate_date
if @product_rate_id = NULL
begin
	exec
		j_nextkey
			"product_rates",
			@product_rate_id output
	insert into
		product_rates(
			product_rate_id,
			product_id,
			rate_date)
	values(
		@product_rate_id,
		@product_id,
		@rate_date)
end

update
	product_rate_points
set
	rate = @rate
where
	product_rate_id = @product_rate_id
and
	days = @days
if @@rowcount = 0
begin
	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
		@product_rate_id,
		@days,
		@rate)
end

select
	@usd_product_rate_id = product_rate_id
from
	product_rates
where
	product_id = @usd_product_id
and
	rate_date = @rate_date
if @usd_product_rate_id = NULL
begin
	exec
		j_nextkey
			"product_rates",
			@usd_product_rate_id output

	insert into
		product_rates(
			product_rate_id,
			product_id,
			rate_date)
	values(
		@usd_product_rate_id,
		@usd_product_id,
		@rate_date)
end

update
	product_rate_points
set
	rate = @usd_rate
where
	product_rate_id = @usd_product_rate_id
and
	days = @days
if @@rowcount = 0
begin
	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
		@usd_product_rate_id,
		@days,
		@usd_rate)
end


/* select
	login = @login,
	trade_date = @trade_date,
	currency = @currency,
	tenor = @tenor,
	value_date = @value_date,
	usd_interest = @usd_interest,
	fcy_interest = @fcy_interest,
	forward_rate = @forward_rate,
	forward_points = @forward_points */


go

