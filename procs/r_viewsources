
if object_id("r_viewsources") != NULL
    drop procedure
	r_viewsources
go

create procedure
	r_viewsources
		@login varchar(30)
as

declare @style varchar(250)
select
        @style = "background:#FFFFFF;border: 1px solid white"



create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)
insert into
	#meta
values(
	"Column Hidden",
	"sid",
	NULL,
	NULL)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "edit_source",
        "Edit Source / Source Type",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "add_source",
        "Add Source",
        NULL)


select * From #meta



select
	style=@style,
	add_source = "ADD SOURCE"

select
	section = "Inbound / Outbound",
	style = @style,
	source=a.name,
	source_type = b.name,
	sid=a.source_id,
	edit_source = "EDIT"
from
	sources a,
	source_types b
where
	a.source_type_id = b.source_type_id
and 
	b.name in("Inbound", "Outbound")
order by
	b.name,
	a.name

select
        section = "System Sources",
        style = @style,
        source=a.name,
        source_type = b.name,
        sid=a.source_id,
        edit_source = "" 
from
        sources a,
        source_types b
where
        a.source_type_id = b.source_type_id
and
	b.name in("Internal", "Prime Broker")
order by
        b.name,
        a.name



go
