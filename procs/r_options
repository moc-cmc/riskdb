select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@expired_style = "background:#FBF836;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white"


create table
	#options(
		id int identity,
		style varchar(250) NULL, 
		contract_id int,
		symbol varchar(50) NULL,
		tv float NULL,
		delta float NULL,
		gamma float NULL,
		theta float NULL,
		tau float NULL,
		underlying_price float NULL,
		vol float NULL,
		days float NULL,
		interest_rate float NULL,
		carry_cost float NULL,
		timestamp datetime NULL,
		expire varchar(50) NULL)
insert into
	#options(
		style,
		contract_id,
		symbol)
select
	style = @style,
	a.contract_id,
	b.symbol
from
	current_contract_tvs a,
	contracts b
where
	a.contract_id = b.contract_id
order by
	b.symbol


update
	#options
set
	a.tv = b.tv,
	a.delta = b.delta,
	a.gamma = b.gamma,
	a.theta = b.theta,
	a.tau = b.tau,
	a.underlying_price = b.underlying_price,
	a.vol = b.volatility,
	a.days = b.days,
	a.interest_rate = b.interest_rate,
	a.carry_cost = b.carry_cost,
	a.timestamp = b.timestamp
from
	#options a,
	current_contract_tvs b
where
	a.contract_id = b.contract_id

update
	#options
set
	style = @error_style
where
	tv = NULL

update
	#options
set
	style = @expired_style,
	expire = "Expire"
from
	#options a,
	option_contracts b,
	option_expirations c
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.expiration < getdate()

select
	section = "Admin",
	style = @style,
	refresh = "Refresh",
	vols_for_date = "Vols For Trade Date",
	import_vols = "Import Trade Date Vols"

select
	section = "Options",
	style,
	symbol,
	tv,
	delta,
	gamma,
	theta,
	tau,
	underlying_price,
	vol,
	days,
	interest_rate,
	carry_cost,
	expire
from
	#options
order by
	id


