drop procedure
	r_importlcgsettles
go

create procedure
	r_importlcgsettles
		@login varchar(50),
		@source varchar(50)=NULL,
		@trade_date varchar(50)=NULL,
		@cur varchar(10)=NULL, 
		@spot_bid varchar(50)=NULL

as

declare @symbol_check1 varchar(10)
declare @symbol_check2 varchar(10)
declare @is_inverted varchar(1)
declare @tally_spot_bid float
declare @tally_trade_date datetime


select
	@tally_spot_bid = convert(float, @spot_bid),
	@tally_trade_date = convert(datetime, @trade_date)

select
	@symbol_check1 = rtrim(@cur) + 'USD',
	@symbol_check2 = 'USD' + rtrim(@cur)


select
	@is_inverted = 'Y'
from
	contracts a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
and
	a.symbol = @symbol_check1

if @is_inverted != 'Y'
begin
        exec
                r_editsettle
                        @symbol_check1,
                        @tally_trade_date,
                        @tally_spot_bid

        return        
end

if @is_inverted = 'Y'
begin
	select
		@is_inverted = NULL

	select
        	@is_inverted = 'Y'
	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
	where
        	a.contract_id = b.contract_id
	and
        	b.price_style_id = c.price_style_id
	and
        	c.name = "Inverted"
	and
        	a.symbol = @symbol_check2

	if @is_inverted = 'Y'
	begin
		select
			status="Error",
			msg = "Both pairs are marked inverted",
			cur = @cur
		return
	end
	
	if @is_inverted != 'Y'
	begin
		exec
			r_editsettle
				@symbol_check2,
				@tally_trade_date,
				@tally_spot_bid
                return
	end
end

select
	status = "Warning",
	msg = "Contracts do not exist",
	symbol_check1 = @symbol_check1,
	symbol_check2 = @symbol_check2


go
