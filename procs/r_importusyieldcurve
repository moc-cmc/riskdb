use
	risk_walrus
go

drop procedure
	r_importusyieldcurve
go

create procedure
	r_importusyieldcurve
		@login varchar(50),
		@date varchar(50)=NULL,
		@1mo varchar(50)=NULL,
		@3mo varchar(50)=NULL,
		@6mo varchar(50)=NULL,
		@1yr varchar(50)=NULL,
		@2yr varchar(50)=NULL,
		@3yr varchar(50)=NULL,
		@5yr varchar(50)=NULL,
		@7yr varchar(50)=NULL,
		@10yr varchar(50)=NULL,
		@20yr varchar(50)=NULL,
		@30yr varchar(50)=NULL
as

declare @product_id int
declare @days int
declare @product_rate_id int
declare @rate_date datetime
declare @one_month float
declare @three_month float
declare @six_month float
declare @one_year float
declare @two_year float
declare @three_year float
declare @five_year float
declare @seven_year float
declare @ten_year float
declare @twenty_year float
declare @thirty_year float

if lower(left(@date, 1)) = "d"
	return

select
	@rate_date = convert(datetime, convert(date, @date))
select
	@rate_date = dateadd(hour, 17, @rate_date)

select
	@product_id = product_id
from
	products
where
	symbol = "USD"
if @product_id = NULL
begin
	select
		status = "Error",
		message = "USD product not found"
	return
end


select
	@one_month = convert(float, @1mo) / 100.00,
	@three_month = convert(float, @3mo) / 100.00,
	@six_month = convert(float, @6mo) / 100.00,
	@one_year = convert(float, @1yr) / 100.00,
	@two_year = convert(float, @2yr) / 100.00,
	@three_year = convert(float, @3yr) / 100.00,
	@five_year = convert(float, @5yr) / 100.00,
	@seven_year = convert(float, @7yr) / 100.00,
	@ten_year = convert(float, @10yr) / 100.00,
	@twenty_year = convert(float, @20yr) / 100.00,
	@thirty_year = convert(float, @30yr) / 100.00


select
	@product_rate_id = product_rate_id
from
	product_rates
where
	product_id = @product_id
and
	convert(date, rate_date) = convert(date, @date)

if @product_rate_id != NULL
begin
	select
		status = "Error",
		message = "Rate curve already exists for date",
		rate_date = @rate_date
	return
end

exec
	j_nextkey
		"product_rates",
		@product_rate_id output

begin tran
	insert into
		product_rates(
			product_rate_id,
			product_id,
			rate_date)
	values(
		@product_rate_id,
		@product_id,
		@rate_date)
	
	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(month, 1, @rate_date)),
			@one_month)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(month, 3, @rate_date)),
			@three_month)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(month, 6, @rate_date)),
			@six_month)


	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 1, @rate_date)),
			@one_year)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 2, @rate_date)),
			@two_year)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 3, @rate_date)),
			@three_year)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 5, @rate_date)),
			@five_year)
	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 7, @rate_date)),
			@seven_year)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 10, @rate_date)),
			@ten_year)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 20, @rate_date)),
			@twenty_year)

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
			@product_rate_id,
			datediff(day, @rate_date, dateadd(year, 30, @rate_date)),
			@thirty_year)


commit tran


go
	


