drop procedure csv_aggregatetrades
go


create procedure
	csv_aggregatetrades
		@login varchar(50),
                @run_symbol varchar(50),
                @begin_date datetime = NULL,
		@end_date datetime = NULL

as

declare @run_id int
declare @begin_date_string char(20)
declare @end_date_string char(20)


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_symbol
	return
end

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)

insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties


create table
	#aggregated_trade_ids(
		trade_id int,
		total_trades int
)


insert into
	#aggregated_trade_ids
select 
	a.aggregate_trade_id,
	count(*)
from 
	aggregated_trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g

where 
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date
group by 
	aggregate_trade_id





create table
	#trades(
		section varchar(50) NULL,	
		deal_id int NULL,
		trade_id int NULL,
		aggregate_trade_id int,
		original_trade_id int NULL,
		trade_date datetime,
		contract_id int,
		value_date datetime,
		quantity numeric(30,4),
		trade_price float,
		trader_id int,
		broker_id int,
		external_account_id int,
		counterparty_id int,
		total_aggregated_trades int NULL
)


insert into
	#trades
select
	"aggregate",
	a.deal_id,
	a.trade_id,
	a.trade_id,
	NULL,
	a.trade_date,
	a.contract_id,
	a.value_date,
	a.quantity,
	a.price,
	a.trader_id,
	a.broker_id,
	a.external_account_id,
	a.counterparty_id,
	b.total_trades
from
	trades a,
	#aggregated_trade_ids b
where
	a.trade_id = b.trade_id

insert into
	#trades
select
	"component",
        NULL,
        NULL,
	a.aggregate_trade_id,
	a.trade_id,
        a.trade_date,
        a.contract_id,
        a.value_date,
        a.quantity,
        a.price,
        a.trader_id,
        a.broker_id,
        a.external_account_id,
        a.counterparty_id,
	NULL
from
	aggregated_trades a,
	#aggregated_trade_ids b
where        
	a.aggregate_trade_id = b.trade_id


update
	#trades
set
	a.trade_price = 1.0 / a.trade_price
from
	#trades a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
	


select
	section = "summary",
        run_name = @run_symbol,
        begin_date = @begin_date,
        end_date = @end_date,
        total_aggregate_trades = count(*),
        total_component_trades = sum(total_trades)
from
        #aggregated_trade_ids


select
	section,
	a.deal_id,
	trade_id = a.aggregate_trade_id,
	a.original_trade_id,
	trade_date =  a.trade_date,
	value_date = convert(varchar(8), a.value_date, 112),
	b.symbol,
	a.quantity,
	a.trade_price,
	trader = c.symbol,
	broker = d.symbol,
	external_account = e.symbol,
	counterparty = g.name,
	component_trades = a.total_aggregated_trades
from
	#trades a,
	contracts b,
	traders c,
	brokers d,
	external_accounts e,
	counterparties g
where
	a.contract_id = b.contract_id
and
	a.trader_id = c.trader_id
and
	a.broker_id = d.broker_id
and
	a.external_account_id = e.external_account_id
and
	a.counterparty_id = g.counterparty_id
order by
	a.aggregate_trade_id,
	a.section,
	a.trade_date


go
