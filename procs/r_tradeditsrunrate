use
	risk_faros
go

drop procedure
	r_tradeditsrunrate
go

create procedure
	r_tradeditsrunrate
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as


declare @run_id int
declare @style varchar(200)
declare @current_style varchar(200)
declare @trade_id int
declare @trades int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"not_currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_fwd_price",
	"Edit Statement Fwd Price",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	 "#,##0.000000")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@style = "background:#FFFFFF;border: 1px solid white",
	@current_style = "background:#FAF7A5;border: 1px solid white"

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_date = convert(datetime, convert(date, @begin_date))

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

select
	@end_date = convert(datetime, convert(date, @end_date))

select
	@end_date = dateadd(hour, 17, @end_date)


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#trades(
		trade_id int)

insert into
	#trades
select
	a.trade_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	trade_edits h
where
	a.trade_id = h.trade_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date

create table
	#output(
		id int identity,
		style varchar(250) NULL,
		trade_id int NULL,
		deal_id int NULL,
		login varchar(50) NULL,
		trade_type varchar(50) NULL,
		external_account varchar(50) NULL,
		counterparty varchar(50) NULL,
		quantity numeric(30,4) NULL,
		symbol varchar(50) NULL,
		value_date datetime NULL,
		fixing_date datetime NULL,
		price float NULL,
		trade_date datetime NULL,
		trader varchar(50) NULL,
		strategy varchar(50) NULL,
		status varchar(50) NULL,
		broker varchar(50) NULL,
		sales_code varchar(50) NULL,
		identifier varchar(100) NULL,
		pct_price float NULL,
		spot_reference float NULL,
		timestamp datetime NULL,
		mid_mark float NULL)

select
	@trade_id = 0
select
	@trades = count(*)
from
	#trades
where
	trade_id > @trade_id

while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#trades
	where
		trade_id > @trade_id


	insert into
		#output(
		style,
		trade_id,
		deal_id,
		login,
		trade_type,
		external_account,
		counterparty,
		quantity,
		symbol,
		value_date,
		fixing_date,
		price,
		trade_date,
		trader,
		strategy,
		broker,
		sales_code,
		identifier,
		pct_price,
		spot_reference,
		mid_mark)
	select
		style = @current_style,
		a.trade_id,
		a.deal_id,
		b.login,
		c.name,
		d.symbol,
		e.name,
		a.quantity,
		f.symbol,
		a.value_date,
		a.fixing_date,
		a.price,
		a.trade_date,
		g.symbol,
		h.name,
		i.symbol,
		j.name,
		a.identifier,
		a.pct_price,
		a.spot_reference,
		k.mid_mark
	from
		trades a,
		tico_accounts b,
		trade_types c,
		external_accounts d,
		counterparties e,
		contracts f,
		traders g,
		strategies h,
		brokers i,
		sales_codes j,
		trade_attributes k
	where
		a.user_id = b.account_id
	and
		a.trade_type_id = c.trade_type_id
	and
		a.external_account_id = d.external_account_id
	and
		a.counterparty_id = e.counterparty_id
	and
		a.contract_id = f.contract_id
	and
		a.trader_id = g.trader_id
	and
		a.strategy_id = h.strategy_id
	and
		a.broker_id = i.broker_id
	and
		a.sales_code_id = j.sales_code_id
	and
		a.trade_id = k.trade_id
	and
		a.trade_id = @trade_id

	insert into
		#output(
		style,
		trade_id,
		deal_id,
		login,
		trade_type,
		external_account,
		counterparty,
		quantity,
		symbol,
		value_date,
		fixing_date,
		price,
		trade_date,
		trader,
		strategy,
		broker,
		sales_code,
		identifier,
		pct_price,
		spot_reference,
		mid_mark,
		timestamp)
	select
		style = @style,
		a.trade_id,
		a.deal_id,
		b.login,
		c.name,
		d.symbol,
		e.name,
		a.quantity,
		f.symbol,
		a.value_date,
		a.fixing_date,
		a.price,
		a.trade_date,
		g.symbol,
		h.name,
		i.symbol,
		j.name,
		a.identifier,
		a.pct_price,
		a.spot_reference,
		a.mid_mark,
		a.timestamp
	from
		trade_edits a,
		tico_accounts b,
		trade_types c,
		external_accounts d,
		counterparties e,
		contracts f,
		traders g,
		strategies h,
		brokers i,
		sales_codes j
	where
		a.user_id = b.account_id
	and
		a.trade_type_id = c.trade_type_id
	and
		a.external_account_id = d.external_account_id
	and
		a.counterparty_id = e.counterparty_id
	and
		a.contract_id = f.contract_id
	and
		a.trader_id = g.trader_id
	and
		a.strategy_id = h.strategy_id
	and
		a.broker_id = i.broker_id
	and
		a.sales_code_id = j.sales_code_id
	and
		a.trade_id = @trade_id
	order by
		a.timestamp desc

	select
		@trades = count(*)
	from
		#trades
	where
		trade_id > @trade_id
end


select
	section = "Edited Trades",
	style,
	trade_id,
	deal_id,
	login,
	trade_type,
	external_account,
	counterparty,
	quantity,
	symbol,
	value_date = convert(varchar(11), value_date, 1),
	fixing_date,
	price,
	trade_date,
	trader,
	/* strategy, */
	broker,
	sales_code,
	/* identifier, */
	pct_price,
	spot_reference,
	mid_mark,
	timestamp
from
	#output
order by
	id

	

go
