use
	risk_faros
go

drop procedure
	x_batchcommitagency
go

create procedure
	x_batchcommitagency
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime,
		@end_date datetime

as


declare @total_volume float
declare @total_pl float
declare @trade_date datetime
declare @run_agency_commit_id int
declare @run_id int

select
	@run_id = run_id
from
	runs
where
	name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end

select
	@trade_date = @begin_date

while @trade_date <= @end_date
begin

	select
		@total_volume = NULL,
		@total_pl = NULL

	exec
		xcbo_agencyrunpl
 			"markr",
			@run_name,
			@trade_date,
			NULL,
 			@total_pl output,
 			@total_volume output,
 			"N"

	if @total_volume != NULL and @total_pl != NULL
	begin
		exec
			j_nextkey
				"run_agency_commits",
				@run_agency_commit_id output

		
		insert into
			run_agency_commits
		values(
			@run_agency_commit_id,
			@run_id,
			@trade_date,
			@total_volume,
			@total_pl)
	end

	exec
		r_nextbusinessday
			@trade_date,
			@trade_date output



end


go
