create or replace procedure
	ag_approveoa
		@login varchar(50),
		@legal_entity varchar(150),
		@outside_account varchar(50)

as

declare @has_permission varchar(10)


exec
	r_checkaccessgrouppermission
		@login=@login,
		@access_group="Wire Admin",
		@show_perm_denied = "N",
		@has_permission = @has_permission output

if @has_permission != "Y"
begin
	select
		status = "Error",
		message = "Permission denied"
	return
end


exec
	api_approveoa
		@login = @login,
		@legal_entity = @legal_entity,
		@outside_account = @outside_account


exec
        ag_viewaccountinstructions
                @login=@login,
                @legal_entity=@legal_entity,
                @outside_account=@outside_account

go
