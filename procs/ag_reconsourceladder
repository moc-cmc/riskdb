create table
	#product_balances(
		external_account_id int,
		product_id int,
		value_date datetime,
		balance float)
insert into
	#product_balances(
		external_account_id,
		product_id,
		value_date,
		balance)
select
	a.external_account_id,
	b.product_id,
	a.value_date,
	sum(a.quantity)
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	convert(date, a.value_date) = convert(date, @value_date)
group by
	a.external_account_id,
	b.product_id,
	a.value_date

	
insert into
	#product_balances(
		external_account_id,
		product_id,
		value_date,
		balance)
select
	a.external_account_id,
	b.currency_id,
	a.value_date,
	sum(a.quantity * a.price * -1.0)
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	convert(date, a.value_date) = convert(date, @value_date)
group by
	a.external_account_id,
	b.currency_id,
	a.value_date
	
