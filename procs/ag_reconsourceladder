create table
	#output(
		id int identity,
		style varchar(250) NULL,
		source varchar(50) NULL,
		match_factor int NULL,
		account varchar(50) NULL,
		acct varchar(50) NULL,
		external_account_id int NULL,
		product_id int NULL,
		product varchar(50) NULL,
		begin_balance numeric(30,4) NULL,	
		begin_balance_diff numeric(30,4) NULL,
		maturing_fx numeric(30,4) NULL,
		maturing_fx_diff numeric(30,4) NULL,
		settled_fx numeric(30,4) NULL,
		settled_fx_diff numeric(30,4) NULL,
		commissions numeric(30,4) NULL,
		commissions_diff numeric(30,4) NULL,
		net_activity numeric(30,4) NULL,
		net_activity_diff numeric(30,4) NULL,
		end_balance numeric(30,4) NULL,
		end_balance_diff numeric(30,4) NULL)

select
	@id = 0
select
	@ids = count(*)
from
	#ordered_accounts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ordered_accounts
	where
		id > @id

	select
		@external_account_id = NULL,
		@account = NULL,
		@begin_balance = NULL,
		@maturing_fx = NULL,
		@commissions = NULL,
		@net_activity = NULL,
		@end_balance = NULL,
		@settled_fx = NULL

	select
		@external_account_id = external_account_id,
		@account = account
	from
		#ordered_accounts
	where
		id = @id

	insert into
		#output(
			style,
			account)
	values(
		@total_style,
		@account)

	select
		@p_id = 0
	select
		@p_ids = count(*)
	from
		#products
	where
		id > @p_id

	while @p_ids > 0
	begin
		select
			@p_id = min(id)
		from
			#products
		where
			id > @p_id

		select
			@product_id = product_id,
			@product = symbol
		from
			#products
		where
			id = @p_id

		select
			@begin_balance = NULL,
			@maturing_fx = NULL,
			@commissions = NULL,
			@net_activity = NULL,
			@end_balance = NULL,
			@settled_fx = NULL

		select
			@begin_balance = balance
		from
			external_balances
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		and
			convert(date, balance_date) = convert(date, @previous_date)
		if @begin_balance = NULL
			select
				@begin_balance = 0.0

		select
			@maturing_fx = balance
		from
			#source_balances
		where
			product_id = @product_id
		and
			external_account_id = @external_account_id
		if @maturing_fx = NULL
			select
				@maturing_fx = 0.0

		select
			@commissions = sum(amount)
		from
			external_commissions
		where
			product_id = @product_id
		and
			external_account_id = @external_account_id
		if @commissions = NULL
			select
				@commissions = 0.0

		select
			@end_balance = balance
		from
			external_balances
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		and
			convert(date, balance_date) = convert(date, @value_date)
		if @end_balance = NULL
			select
				@end_balance = 0.0


		insert into
			#output(
				style,
				source,
				match_factor,
				acct,
				external_account_id,
				product_id,
				product,
				begin_balance,
				maturing_fx,
				settled_fx,
				commissions,
				net_activity,
				end_balance)
		values(
			@style,
			"Velocity",
			-1,
			@account,
			@external_account_id,
			@product_id,
			@product,
			@begin_balance,
			@maturing_fx,
			0.0,
			@commissions,
			0.00,
			@end_balance)
				
		select
			@begin_balance = NULL,
			@maturing_fx = NULL,
			@commissions = NULL,
			@net_activity = NULL,
			@end_balance = NULL,
			@settled_fx = NULL

		select
			@begin_balance = balance
		from
			#begin_balances
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		if @begin_balance = NULL
			select
				@begin_balance = 0.0

		select
			@maturing_fx = balance
		from
			#balances
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		if @maturing_fx = NULL
			select
				@maturing_fx = 0.0

		select
			@settled_fx = balance
		from
			#fx_settlement
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		if @settled_fx = NULL
			select
				@settled_fx = 0.0

		select
			@commissions = balance
		from
			#commissions
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		if @commissions = NULL
			select
				@commissions = 0.0

		select
			@end_balance = balance
		from
			#end_balances
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		if @end_balance = NULL
			select
				@end_balance = 0.0

		insert into
			#output(
				style,
				source,
				match_factor,
				acct,
				external_account_id,
				product_id,
				product,
				begin_balance,
				maturing_fx,
				settled_fx,
				commissions,
				net_activity,
				end_balance)
		values(
			@style,
			@fund,
			1,
			@account,
			@external_account_id,
			@product_id,
			@product,
			@begin_balance,
			@maturing_fx,
			@settled_fx,
			@commissions,
			0.00,
			@end_balance)	

		select
			@p_ids = count(*)
		from
			#products
		where
			id > @p_id

		select
			@begin_balance = sum(match_factor * begin_balance)
		from
			#output
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		update
			#output
		set
			begin_balance_diff = @begin_balance
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id

		select
			@maturing_fx = sum(match_factor * maturing_fx)
		from
			#output
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		update
			#output
		set
			maturing_fx_diff = @maturing_fx
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id

		select
			@commissions = sum(match_factor * commissions)
		from
			#output
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		update
			#output
		set
			commissions_diff = @commissions
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id

		select
			@net_activity = sum(match_factor * net_activity)
		from
			#output
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		update
			#output
		set
			net_activity_diff = @net_activity
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id

		select
			@end_balance = sum(match_factor * end_balance)
		from
			#output
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		update
			#output
		set
			end_balance_diff = @end_balance
		where
			product_id = @product_id
		and
			external_account_id = @external_account_id
	end
	

	select
		@ids = count(*)
	from
		#ordered_accounts
	where
		id > @id
end


update
	#output
set
	settled_fx = maturing_fx
where
	source = "Velocity"
and
	product_id = @evaluation_currency_id

update
	#output
set
	net_activity = settled_fx + commissions
where
	product_id = @evaluation_currency_id

update
	#output
set
	style = "background:#decafc"
where
	begin_balance_diff > 0.01

update
	#output
set
	style = "background:#decafc"
where
	end_balance_diff > 0.01

select
	style,
	account,
	acct,
	product,
	source,
	begin_balance,
	maturing_fx,
	settled_fx,
	commissions,
	net_activity,
	end_balance /* ,
	begin_balance_diff,
	maturing_fx_diff,
	commissions_diff,
	net_activity_diff,
	end_balance_diff */
from
	#output
order by
	id
		

