create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	a.product_id
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"

update
	#conversion_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

/* get the begin rates */

update
	#conversion_rates
set
	a.rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @value_date)

update
	#conversion_rates
set
	a.rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @value_date)
and
	a.rate = NULL

