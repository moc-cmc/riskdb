drop procedure
	ag_toggleticooverride
go

create procedure
	ag_toggleticooverride
		@login varchar(50),
		@mc_desktop varchar(100),
		@mc_login varchar(50)
as


declare @tico_account_id int
declare @mc_desktop_id int

select
	@tico_account_id = account_id 
from
	tico_accounts
where
	login = @mc_login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Login not found"
	return
end

select
	@mc_desktop_id = mc_desktop_id
from
	mc_desktops
where
	name = @mc_desktop
if @mc_desktop_id = NULL
begin
	select
		status = "Error",
		message = "MC Desktop not found",
		mc_desktop = @mc_desktop
	return
end

delete

from
	mc_desktop_overrides
where
	tico_account_id = @tico_account_id
and
	mc_desktop_id = @mc_desktop_id
if @@rowcount = 0
begin
	insert into
		mc_desktop_overrides(
			tico_account_id,
			mc_desktop_id)
	values(
		@tico_account_id,
		@mc_desktop_id)
end

exec
	ag_clientconfighome
		@login = @login,
		@mc_desktop = @mc_desktop

go



