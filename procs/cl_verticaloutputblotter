create procedure
	cl_verticaloutputblotter
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@trade_id int=NULL

as



declare @run_id int
declare @tico_account_id int

declare @date datetime
declare @trade_date datetime

/*
create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Format Number",
	"spot_rate",
	NULL,
	NULL,
	"#,##0.00####")
insert into
	#links
values(
	"Format Number",
	"price",
	NULL,
	NULL,
	"#,##0.00####")
insert into
        #links
values(
        "Format Number",
        "mid",
        NULL,
        NULL,
        "#,##0.00####")



if @trade_id = NULL /* notifications can not receive tico formatting data */
	select * from #links

*/
select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "login not found"
	return
end

select
	@run_id = a.run_id
from
	user_runs a,
	runs b
where
	a.run_id = b.run_id
and
	b.name = @run_name
and
	a.tico_account_id = @tico_account_id
if @run_id = NULL
begin
	select
		id = -1,
		error = "No run configured for user"
	return
end


exec
    r_normalizedaterange
        @begin_date out,
        @end_date out

/*
select 
	'begin' = @begin_date, 
	'end' = @end_date
*/
create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#traders
	select
		trader_id
	from
		traders

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select  
	internal_account_id
from    
	run_internal_accounts
where   
	run_id = @run_id 
if @@rowcount = 0
	insert into
		#internal_accounts
	select  
		internal_account_id
	from    
		internal_accounts

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#strategies
	select
		strategy_id
	from
		strategies


create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers


create table
	#trades(
		currency_pair varchar(20) NULL,
		trade_date datetime NULL,
		provider_name varchar(30) NULL,
		customer_trader varchar(30) NULL,
		trade_id int,
		value_date varchar(11) NULL,
		fixing_date varchar(11) NULL,
		product varchar(30) NULL,
		buy_sell varchar(10) NULL,
		dealt_currency varchar(20) NULL,
		dealt_amount numeric(30,2) NULL,
		contra_currency varchar(20) NULL,
		contra_amount numeric(30,2) NULL,
		spot_date varchar(11) NULL,
		spot_rate float NULL,
		forward_points float NULL,
		price float NULL,
        min_scale int NULL,
        max_scale int NULL
		)

if @trade_id = NULL
begin
	insert into
		#trades(
			trade_id,
			dealt_amount,
			contra_amount,
			price,
			value_date,
			trade_date,
			fixing_date,
			spot_rate)
	select
		a.trade_id,
		a.quantity * -1.0,     /* quantity goes in with client view and is updated to abs value with update */
		a.quantity * a.price,
		a.price,
		value_date = convert(varchar(11), a.value_date, 1),
		a.trade_date,
		fixing_date = convert(varchar(11), a.fixing_date, 1),
		a.spot_reference
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        statuses g,
        trade_notifications h,
        sources ha
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
    and
        a.status_id = g.status_id
    and
        a.trade_id = h.trade_id
    and
        h.source_id = ha.source_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
	and
		a.quantity != 0
    and
        ha.name = "Agency Client"
end
else   /* Identical to above query with @trade_id qualifier, and dateranges for trade_id */
begin
	select
		@trade_date = trade_date
	from
		trades
	where
		trade_id = @trade_id
        if @trade_date = NULL
	begin
		select
			"status" = "Error",
			"error" = "Trade ID does not exist"
		return
	end
			
	select
		@begin_date = convert(datetime, convert(char(11), @trade_date, 1))

	exec
		r_nextbusinessday
			@begin_date,
			@end_date output


	insert into
		#trades(
			trade_id,
			dealt_amount,
			contra_amount,
			price,
			value_date,
			trade_date,
			fixing_date,
			spot_rate)
	select
		a.trade_id,
		a.quantity * -1.0,     /* quantity goes in with client view and is updated to abs value with update */
		a.quantity * a.price,
		a.price,
		value_date = convert(varchar(11), a.value_date, 1),
		a.trade_date,
		fixing_date = convert(varchar(11), a.fixing_date, 1),
		a.spot_reference
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        statuses g,
        trade_notifications h,
        sources ha
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
    and
        a.status_id = g.status_id
    and
        a.trade_id = h.trade_id
    and
        h.source_id = ha.source_id
/*	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date*/
	and
		a.trade_id = @trade_id
	and
		a.quantity != 0
    and
        ha.name = "Agency Client"
end

