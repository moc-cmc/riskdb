create procedure
	ag_riskclasspl
		@login varchar(50),
		@trade_date datetime=NULL
as


declare @fund_id int
declare @evaluation_currency_id int

declare @runs int
declare @run_id int
declare @begin_date datetime
declare @end_date datetime

declare @account varchar(50)
declare @product varchar(50)
declare @risk_class varchar(50)
declare @risk_class_id int
declare @rcm_id int
declare @external_account_id int
declare @product_id int


declare @volume float
declare @net float
declare @equiv float
declare @saved_net float
declare @saved_volume float

declare @risk_classes int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

declare @exposure_by_product varchar(250)

declare @product_sql varchar(1000)
declare @product_long_select varchar(500)
declare @product_long_qualifier varchar(500)
declare @product_short_select varchar(500)
declare @product_short_qualifier varchar(500)
declare @product_group_by varchar(50)

declare @original_trade_date datetime

select
	@original_trade_date = @trade_date



