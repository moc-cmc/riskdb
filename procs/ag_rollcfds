
drop procedure
	ag_rollcfds
go

create procedure
	ag_rollcfds
		@login varchar(50),
		@trade_date datetime
as

declare @id int
declare @ids int

select
	@id = 0
select
	@ids = count(*)
from
	open_trades
where
	convert(date, value_date) = convert(date, @trade_date)
and
	id > @id


while @ids > 0
begin
	select
		@id = min(id)
	from
		open_trades
	where
		convert(date, value_date) = convert(date, @trade_date)
	and
		id > @id

	exec
		ag_rollopencfdtrade
			@login = @login,
			@open_trade_id = @id

	select
		@ids = count(*)
	from
		open_trades
	where
		convert(date, value_date) = convert(date, @trade_date)
	and
		id > @id
end
	
		
