
if object_id("r_dealhedgecandidates") != NULL
    drop procedure
        r_dealhedgecandidates
go

create procedure
	r_dealhedgecandidates
		@login varchar(50),
		@deal_id int,
		@symbol varchar(50),
		@net_position numeric(30,4)

as



declare @sign int
declare @contract_id int
declare @trade_date datetime
declare @trade_id int
declare @trades int
declare @deal_count int
declare @deal_net_quantity numeric(30,4)
declare @candidate_deal_id int
declare @inverted_contract_id int

create table
	#meta(
		meta_type char(50),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)


insert into
	#meta
values(
	"Column Link",
	"delink_deal",
	"Create New Deal From Trade",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"link_deal",
	"Change Trade Deal Id",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta


select
	@sign = sign(@net_position)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol

exec
	r_invertedcontract
		@contract_id,
		@inverted_contract_id output

select
	@trade_date = max(trade_date)
from
	trades
where
	deal_id = @deal_id

create table
	#trades(
		trade_id int,
		deal_count int NULL,
		deal_net_quantity numeric(30,4) NULL)

insert into
	#trades(
		trade_id)
select
	trade_id
from
	trades
where
	contract_id = @contract_id
and
	sign(quantity) = @sign * -1.0
and
	trade_date >= dateadd(day, -3, @trade_date)
and
	trade_date <= dateadd(day, 3, @trade_date)

insert into
	#trades(
		trade_id)
select
	trade_id
from
	trades
where
	contract_id = @inverted_contract_id
and
	sign(quantity) = @sign
and
	trade_date >= dateadd(day, -3, @trade_date)
and
	trade_date <= dateadd(day, 3, @trade_date)

select
	@trade_id = 0
select
	@trades = count(*)
from
	#trades
where
	trade_id > @trade_id

while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#trades
	where
		trade_id > @trade_id

	select
		@candidate_deal_id = deal_id
	from
		trades
	where
		trade_id = @trade_id

	select
		@deal_count = count(trade_id),
		@deal_net_quantity = sum(quantity)
	from
		trades
	where
		deal_id = @candidate_deal_id

	update
		#trades
	set
		deal_count = @deal_count,
		deal_net_quantity = @deal_net_quantity
	where
		trade_id = @trade_id

	select
		@trades = count(*)
	from
		#trades
	where
		trade_id > @trade_id
end



select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	external_account = b.symbol,
	counterparty = c.name,
	a.quantity,
	e.symbol,
	value_date = convert(char(11), a.value_date, 1),
	a.price,
	trader = f.symbol,
	delink_deal = "DELINK TO NEW DEAL ID"
from
	trades a,
	external_accounts b,
	counterparties c,
	contracts e,
	traders f
where
	a.external_account_id = b.external_account_id
and
	a.counterparty_id = c.counterparty_id
and
	a.contract_id = e.contract_id
and
	a.trader_id = f.trader_id
and
	a.deal_id = @deal_id

select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	external_account = b.symbol,
	counterparty = c.name,
	a.quantity,
	e.symbol,
	value_date = convert(char(11), a.value_date, 1),
	a.price,
	trader = f.symbol,
	d.deal_count,
	current_net = d.deal_net_quantity,
	new_deal_id = @deal_id,
	link_deal = "LINK DEAL"
from
	trades a,
	external_accounts b,
	counterparties c,
	#trades d,
	contracts e,
	traders f
where
	a.external_account_id = b.external_account_id
and
	a.counterparty_id = c.counterparty_id
and
	a.contract_id = e.contract_id
and
	a.trader_id = f.trader_id
and
	a.trade_id = d.trade_id




	

go
