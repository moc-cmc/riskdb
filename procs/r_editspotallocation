
if object_id("r_editspotallocation") != NULL
    drop procedure
        r_editspotallocation
go

create procedure
	r_editspotallocation
		@login char(30),
		@external_account char(50),
		@internal_account char(50),
		@remainder_external_account char(50),
		@remainder_internal_account char(50),
		@allocation char(30)

as

declare @fund_id int
declare @external_account_id int
declare @internal_account_id int
declare @remainder_ext_account_id int
declare @remainder_int_account_id int
declare @ext_spot_allocation_id int
declare @percentage float

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

if @fund_id = NULL
begin
	select
		id = -1,
		error = "Problem finding default fund for user"
	return
end

select
	@percentage = convert(float, @allocation)

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding external account",
		external_account = @external_account
	return
end


select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @internal_account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding internal account",
		internal_account = @internal_account
	return
end


select
	@remainder_ext_account_id = external_account_id
from
	external_accounts
where
	symbol = @remainder_external_account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding remainder external account",
		remainder_external_account = @remainder_external_account
	return
end


select
	@remainder_int_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @remainder_internal_account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding remainder internal account",
		remainder_internal_account = @remainder_internal_account
	return
end


select
	@ext_spot_allocation_id = ext_spot_allocation_id
from
	external_spot_allocations
where
	remainder_ext_account_id = @remainder_ext_account_id
and
	remainder_int_account_id = @remainder_int_account_id
and
	internal_account_id = @internal_account_id
and
	external_account_id = @external_account_id
and
	fund_id = @fund_id
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding external spot allocation",
		internal_account = @internal_account,
		external_account = @external_account,
		remainder_external_account = @remainder_external_account,	
		remainder_internal_account = @remainder_internal_account
end

begin tran
	update
		external_spot_allocations
	set
		percentage = @percentage
	where
		ext_spot_allocation_id = @ext_spot_allocation_id
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem finding external spot allocation",
			internal_account = @internal_account,
			external_account = @external_account,
			remainder_external_account = @remainder_external_account,	
			remainder_internal_account = @remainder_internal_account
		rollback tran
		return
	end
commit tran


exec
	cl_tradeallocations
		@login


go
