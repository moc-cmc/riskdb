use
	risk_rcm
go

drop procedure
	r_importrjotrades
go

create procedure
	r_importrjotrades
		@login varchar(50),
		@precid varchar(5),
		@pfirm varchar(5),
		@poffic varchar(5),
		@prr varchar(10),
		@pacct varchar(10),
		@plcass varchar(5),
		@psubcl varchar(5),
		@patype varchar(5),
		@pcard varchar(5),
		@pbs varchar(5),
		@pqty varchar(20),
		@psdsc1 varchar(35),
		@pprtpr varchar(20),
		@ptdate varchar(15),
		@poc varchar(5),
		@patype2 varchar(10),
		@pctym varchar(10),
		@psbcus varchar(5),
		@pstype varchar(5),
		@psubty varchar(5),
		@pstrik varchar(20),
		@pexpdt varchar(15),
		@psubac varchar(15),
		@pbrokr varchar(10),
		@pspred varchar(5),
		@psname varchar(25),
		@psrcac varchar(15),
		@psdate varchar(15),
		@pexch varchar(5),
		@ptrdex varchar(5),
		@pfc varchar(5),
		@psymbl varchar(10),
		@pptype varchar(5),
		@ptpric varchar(20),
		@pcalc varchar(5),
		@pcmnt1 varchar(5),
		@pcmnt2 varchar(5),
		@pexbkr varchar(5),
		@pgivio varchar(10),
		@pgivf varchar(10),
		@pbqty varchar(20),
		@psqty varchar(20),
		@pcurat varchar(5),
		@pcomm varchar(20),
		@pfee1 varchar(20),
		@pfee2 varchar(20),
		@pfee3 varchar(20),
		@pfee4 varchar(20),
		@pfee6 varchar(20),
		@pfee7 varchar(20),
		@pgichg varchar(20),
		@pbkchg varchar(20),
		@pother varchar(20),
		@pgross varchar(20),
		@row_date datetime=NULL,
		@row_index int,
		@row_count int
as


declare @identifier varchar(50)
declare @trade_id int
declare @commission float
declare @excf float
declare @exsf float
declare @nfa float
declare @new_trade_id int
declare @credit_type_id int
declare @credit float
declare @currency_id int
declare @account_transaction_id int
declare @tico_account_id int
declare @deal_id int
declare @trade_date datetime
declare @status varchar(50)
declare @rjo_source_id int
declare @broker_id int
declare @contract_symbol varchar(50)
declare @strike numeric(30,6)
declare @buy_sell varchar(15)
declare @external_account varchar(50)
declare @external_account_id int
declare @quantity int
declare @expiration_symbol varchar(50)
declare @future_id int
declare @contract_id int
declare @id int
declare @option_expiration_id int
declare @price_factor float
declare @price_format varchar(50)
declare @trade_price float
declare @contract varchar(50)
declare @instrument varchar(50)



if @row_date = NULL
begin
	select
		status = "Error",
		message = "Trade date not entered"
	return
end

select
	@broker_id = broker_id
from
	brokers
where
	symbol = "BRK"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "BRK broker not found"
end

select
	@rjo_source_id = source_id
from
	sources
where
	name = "RJO"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "RJO Source not found"
	return
end

select
	@external_account_id = external_account_id
from
	external_account_symbols
where
	symbol = @pacct
and
	source_id = @rjo_source_id
if @external_account_id = NULL
begin
	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @pacct
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Account not found",
			account = @pacct
		return
	end
end

select
	@trade_date = convert(datetime, @ptdate)

select
	@identifier = "TRD - " + rtrim(convert(varchar(50), @trade_date, 1) ) + "-" + convert(varchar(50), @row_index)


select
	@trade_id = trade_id
from
	trades
where
	identifier = @identifier
if @trade_id != NULL
begin
	select
		status = "Dupe",
		message = "trade is already tallied",
		identifier = @identifier
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Login not found"
	return
end


select
	@currency_id = product_id
from
	products
where
	symbol = @pcurat
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Currency not found",
		currency = @pcurat
	return
end



select
	@quantity = convert(int, convert(float, @pqty))

if @pbs = "2"
	select
		@buy_sell = "Sell"
else
	select
		@buy_sell = "Buy"
	

select
	@strike = convert(float, @pstrik)

select
	@contract_symbol = rtrim(@psdsc1)

if @strike != 0
begin
	select
		@option_expiration_id = option_expiration_id
	from
		option_expiration_symbols
	where
		source_id = @rjo_source_id
	and
		symbol = @contract_symbol
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Option expiration symbol not found",
			source = "RJO",
			symbol = @contract_symbol,
			map_expiration = "MAP"
		return
	end
	else
	begin
		select
			@expiration_symbol = symbol
		from
			option_expirations
		where
			option_expiration_id = @option_expiration_id

		exec
			r_optioncontract
				@expiration_symbol,
				@pstrik,
				@psubty,
				@contract_id output

	end
end

if @contract_id = NULL
begin
	select
		@contract_id = contract_id
	from
		contract_symbols
	where
		source_id = @rjo_source_id
	and
		symbol = @contract_symbol
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Contract not found",
			source = "RJO",
			symbol = @contract_symbol,
			set_symbol = "Map Symbol"
		return
	end
end

select
	@future_id = NULL
exec
	r_underlyingfuture
		@contract_id,
		@future_id output

select
	@price_factor = NULL,
	@price_format = NULL

select
	@price_factor = a.factor,
	@price_format = b.name
from
	future_price_factors a,
	price_formats b
where
	a.future_id = @future_id
and
	a.price_format_id = b.price_format_id
and
	a.source_id = @rjo_source_id
if @price_factor = NULL
	select
		@price_factor = 1.0

if @price_format = "32nds"
begin
	exec
		r_pricefromdashbond
			@contract_id,
			@ptpric,
			@trade_price output

	if @strike != 0
	begin
		exec
			r_pricefromdashbond
				@contract_id,
				@pstrik,
				@strike output
	end
end
else
begin
	exec
		x_resolvepricefromstring
			@ptpric,
			@trade_price output

	select
		@strike = convert(float, @pstrik)

end

select
	@trade_price = @trade_price * @price_factor,
	@strike = @strike * @price_factor

select
	@contract = symbol
from
	contracts
where
	contract_id = @contract_id

update
	option_contracts
set
	strike = @strike
where
	contract_id = @contract_id

select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @contract_id

if @instrument = "Future"
begin
	exec
		api_tallyextaccountfuture
			@login = @login,
			@trade_date = @trade_date,
			@source = "RJO",
			@identifier = @identifier,
			@external_account = @external_account,
			@buy_sell = @buy_sell,
			@symbol = @contract,
			@quantity = @quantity,
			@price = @trade_price,
			@deal_id = @deal_id output,
			@trade_id = @trade_id output
end
if @instrument = "Option"
begin
	exec
		api_tallyextaccountfutopt
			@login = @login,
			@trade_date = @trade_date,
			@source = "RJO",
			@identifier = @identifier,
			@external_account = @external_account,
			@buy_sell = @buy_sell,
			@symbol = @contract,
			@quantity = @quantity,
			@price = @trade_price,
			@deal_id = @deal_id output,
			@trade_id = @trade_id output
end

select
	@id = id
from
	rjo_trades_file
where
	identifier = @identifier
if @id = NULL
begin

	exec
		j_nextkey
			"rjo_trades_file",
			@id output
	
	insert into
		rjo_trades_file
	values(
		@id,
		@rjo_source_id,
		@identifier,
		@external_account_id,
		@trade_date,
		@precid,
		@pfirm,
		@poffic,
		@prr,
		@pacct,
		@plcass,
		@psubcl,
		@patype,
		@pcard,
		@pbs,
		@pqty,
		@psdsc1,
		@pprtpr,
		@ptdate,
		@poc,
		@patype2,
		@pctym,
		@psbcus,
		@pstype,
		@psubty,
		@pstrik,
		@pexpdt,
		@psubac,
		@pbrokr,
		@pspred,
		@psname,
		@psrcac,
		@psdate,
		@pexch,
		@ptrdex,
		@pfc,
		@psymbl,
		@pptype,
		@ptpric,
		@pcalc,
		@pcmnt1,
		@pcmnt2,
		@pexbkr,
		@pgivio,
		@pgivf,
		@pbqty,
		@psqty,
		@pcurat,
		@pcomm,
		@pfee1,
		@pfee2,
		@pfee3,
		@pfee4,
		@pfee6,
		@pfee7,
		@pgichg,
		@pbkchg,
		@pother,
		@pgross)
end
	

go
