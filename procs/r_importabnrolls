use
	risk_cresco
go

drop procedure
	r_importabnrolls
go

create procedure
	r_importabnrolls
		@login varchar(50),
		@identifier varchar(50)=NULL,
		@status varchar(50)=NULL,
		@customer_direction varchar(50)=NULL,
		@trade_date varchar(50)=NULL,
		@trade_entry_time varchar(50)=NULL,
		@ccy_pair varchar(50)=NULL,
		@rvalue_date varchar(50)=NULL,
		@dealt_ccy varchar(50)=NULL,
		@dealt_amt varchar(50)=NULL,
		@counter_amt varchar(50)=NULL,
		@fund varchar(50)=NULL,
		@account varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@deal_type varchar(50)=NULL,
		@order_id varchar(50)=NULL,
		@user varchar(50)=NULL,
		@fixing_date varchar(50)=NULL,
		@deal_spot varchar(50)=NULL,
		@deal_points varchar(50)=NULL,
		@deal_rate varchar(50)=NULL,
		@tenor varchar(50)=NULL,
		@net_pv varchar(50)=NULL,
		@last_update varchar(50)=NULL,
		@executed_rate varchar(50)=NULL,
		@slippage varchar(50)=NULL,
		@order_type varchar(50)=NULL,
		@point_trade_status varchar(50)=NULL,
		@row_count int,
		@row_index int,
		@session_id varchar(100) 

as

declare @near_direction varchar(50)
declare @far_direction varchar(50)
declare @near_value_date varchar(50)
declare @far_value_date varchar(50)
declare @product varchar(50)
declare @currency varchar(50)
declare @symbol varchar(50)
declare @near_dealt_qty varchar(50)
declare @near_counter_qty varchar(50)
declare @far_dealt_qty varchar(50)
declare @far_counter_qty varchar(50)
declare @near_identifier varchar(50)
declare @far_identifier varchar(50)
declare @source_id int
declare @counterparty_id int
declare @far_price float
declare @trader_login varchar(50)
declare @trader_tico_account_id int
declare @broker_id int
declare @external_account_id int
declare @roll_account varchar(50)
declare @swap_symbol_id int
declare @swap_symbol varchar(50)
declare @near_trade_id int
declare @far_trade_id int
declare @deal_id int
declare @near_dealt_amt numeric(30,4)
declare @near_counter_amt numeric(30,4)
declare @far_dealt_amt numeric(30,4)
declare @far_counter_amt numeric(30,4)
declare @near_price float
declare @near_val_date datetime
declare @far_val_date datetime
declare @source varchar(50)
declare @contract_id int
declare @price_style varchar(50)

select
	@source = "ABN Amro"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "ABN Source not found"
	return
end


select
	@near_identifier = rtrim(@identifier) + ".near",
	@far_identifier = rtrim(@identifier) + ".far"

exec
	u_fieldsfromslashseparator
		@dealt_amt,
		@near_dealt_qty output,
		@far_dealt_qty output

exec
	u_fieldsfromslashseparator
		@counter_amt,
		@near_counter_qty output,
		@far_counter_qty output

exec
	u_fieldsfromslashseparator
		@customer_direction,
		@near_direction output,
		@far_direction output

exec
	u_fieldsfromslashseparator
		@rvalue_date,
		@near_value_date output,
		@far_value_date output
exec
	u_fieldsfromslashseparator
		@ccy_pair,
		@product output,
		@currency output

if @product = @dealt_ccy
	select
		@symbol = rtrim(@product) + rtrim(@currency)
if @currency = @dealt_ccy
	select
		@symbol = rtrim(@currency) + rtrim(@product)
select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found"
	return
end


if @far_value_date != NULL
begin
	select
		@near_dealt_amt = convert(numeric(30,4), @near_dealt_qty),
		@far_dealt_amt = convert(numeric(30,4), @far_dealt_qty),
		@near_counter_amt = convert(numeric(30,4), @near_counter_qty),
		@far_counter_amt = convert(numeric(30,4), @far_counter_qty)


	select
		@near_price = (abs(@near_counter_amt) / abs(@near_dealt_amt)),
		@far_price = (abs(@far_counter_amt) / abs(@far_dealt_amt))

	select
		@price_style = a.name
	from
		price_styles a,
		contract_price_styles b
	where
		a.price_style_id = b.price_style_id
	and
		b.contract_id = @contract_id


	if @price_style = "Inverted"
	begin
		select
			@near_price = 1.0 / @near_price,
			@far_price = 1.0 / @far_price
	end
		

	select
		@trader_login = a.login,
		@trader_tico_account_id = a.account_id
	from
		tico_accounts a,
		fund_roll_traders b,
		traders c
	where
		b.roll_trader_id = c.trader_id
	and
		a.account_id = c.tico_account_id
	if @trader_login = NULL
	begin
		select
			status = "Error",
			message = "Roll trader not configured"
		return
	end

	select
		@broker_id = a.broker_id,
		@external_account_id = a.external_account_id
	from
		default_tally_accounts a,
		tally_types b
	where
		a.tico_account_id = @trader_tico_account_id
	and
		a.tally_type_id = b.tally_type_id
	and
		b.name = "Swap"
	if @broker_id = NULL
	begin
		select
			status = "Error",
			message = "Broker not found"
		return
	end

	select
		@roll_account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	exec
		j_nextkey
			"swap_symbols",
			@swap_symbol_id output

	select
		@near_val_date = convert(datetime, @near_value_date),
		@far_val_date = convert(datetime, @far_value_date)

	
	select
		@near_trade_id = trade_id
	from
		trades
	where
		identifier = @near_identifier
	and
		broker_id = @broker_id

	if @near_trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @trader_login,
				@source = @source,
				@trade_id = @near_trade_id output,
				@deal_id = @deal_id output,
				@tally_type = "Swap",
				@deal_type = "Market Swap",
				@trade_type = "Swap Near",
				@symbol = @symbol,
				@quantity = @near_dealt_amt,
				@price = @near_price,
				@trade_date = @trade_date,
				@value_date = @near_val_date,
				@identifier = @near_identifier,
				@sales_code = "None",
				@counterparty = "ABN-ABN"

		select
			@swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".M"
		insert into
			swap_symbols
		values(
			@swap_symbol_id,
			@swap_symbol,
			getdate())
		insert into
			swap_symbol_trades
		values(
			@swap_symbol_id,
			@near_trade_id)
	end

	select
		@far_trade_id = trade_id
	from
		trades
	where
		identifier = @far_identifier
	and
		broker_id = @broker_id
	if @far_trade_id = NULL
	begin
		exec
			fxa_tallytrade
				@login = @trader_login,
				@source = @source,
				@trade_id = @far_trade_id output,
				@deal_id = @deal_id output,
				@tally_type = "Swap",
				@deal_type = "Market Swap",
				@trade_type = "Swap Far",
				@symbol = @symbol,
				@quantity = @far_dealt_amt,
				@price = @far_price,
				@trade_date = @trade_date,
				@value_date = @far_val_date,
				@identifier = @far_identifier,
				@sales_code = "None",
				@counterparty = "ABN-ABN"

		insert into
			swap_symbol_trades
		values(
			@swap_symbol_id,
			@far_trade_id)
	end

	exec
		r_setextacctrollrates
			@login = @login,
			@symbol = @symbol,
			@closing_date = @near_val_date,
			@closing_rate = @near_price,
			@roll_date = @far_val_date,
			@roll_rate = @far_price,
			@trade_date = @trade_date


	update
		ext_account_biproduct_rates
	set
		closing_rate = @near_price,
		roll_date = @far_val_date,
		roll_rate = @far_price
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id
	and
		closing_date = @near_val_date
	if @@rowcount != 1
	begin
		insert into
			ext_account_biproduct_rates(
				external_account_id,
				contract_id,
				closing_date,
				closing_rate,
				roll_date,
				roll_rate)
		values(
			@external_account_id,
			@contract_id,
			@near_val_date,
			@near_price,
			@far_val_date,
			@far_price)
	end 
end


go

