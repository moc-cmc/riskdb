
drop procedure
	api_editcreditprofilesym
go

create procedure
	api_editcreditprofilesym
			@login varchar(25),
			@name varchar(50),
			@source_name varchar(100),
			@mapping varchar(50),
			@new_mapping varchar(50)

as

declare @credit_profile_id int
declare @source_id int

select
	@credit_profile_id = credit_profile_id
from
	credit_profiles	
where
	name=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Cannot find Credit Profile",
		credit_profile=@name
	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source_name
	return
end

begin tran
	update
		credit_profile_symbols	
	set
		symbol=@new_mapping
	where
		credit_profile_id=@credit_profile_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount !=1)
	begin
		select
			status="Error",
			msg="Could not edit Credit Profiles",
			mapping=@mapping
	
		rollback tran

		return
	end

commit tran

select
	status="Success",
	msg="Credit Profile Edited",
	name=@name

exec
	r_mappingoverview2 @login

return

go
		
