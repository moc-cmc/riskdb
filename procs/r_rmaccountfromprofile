drop procedure
	r_rmaccountfromprofile
go

create procedure
	r_rmaccountfromprofile
		@login varchar(50),
		@credit_profile varchar(50),
		@account varchar(50)

as

declare @external_account_id int
declare @credit_profile_id int


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @@rowcount !=1
begin
	select
		msg = "Could not find account",
		account = @account
	return
end

select
	@credit_profile_id = credit_profile_id
from
	credit_profiles
where
	name = @credit_profile
if @@rowcount !=1
begin
        select
                msg = "Could not find credit profile",
		credit_profile = @credit_profile
        return
end

delete from
	credit_profile_accounts
where
	credit_profile_id = @credit_profile_id
and
	external_account_id = @external_account_id
if @@rowcount = 1
begin
	select
		msg = "Successfully removed " + @account + " From profile " + @credit_profile
end


exec
	r_viewcreditprofile
		@login,
		@credit_profile

go

