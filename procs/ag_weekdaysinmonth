use
	risk_untl
go

drop procedure
	ag_weekdaysinmonth
go

create procedure
	ag_weekdaysinmonth
		@date_in_month datetime,
		@weekdays int output

as

declare @day_one_string varchar(50)
declare @day_one datetime
declare @month_first_date datetime
declare @date datetime
declare @prev_month_last_date datetime
declare @month varchar(50)
declare @date_month varchar(50)

select
	@day_one_string = convert(varchar(2), datepart(month, @date_in_month))  + "/01/" + convert(varchar(4), datepart(year, @date_in_month)) 

select
	@day_one = convert(datetime, @day_one_string)


exec
	r_prevbusinessday
		@day_one,
		@prev_month_last_date output

exec
	r_nextbusinessday
		@prev_month_last_date,
		@month_first_date output
	
select
	month_first_date = @month_first_date

select
	@month = datename(month, @month_first_date)

select
	@date_month = datename(month, @month_first_date)

create table
	#dates(
		date datetime)

select
	@date = @month_first_date

while @date_month = @month
begin
	insert into
		#dates
	values(
		@date)

	exec
		r_nextbusinessday
			@date,
			@date output
	select
		@date_month = datename(month, @date)
end

select
	@weekdays = count(*)
from
	#dates


go
