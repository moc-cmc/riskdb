
create or replace procedure
	r_grantrun
		@run_name char(50),
		@user_name char(50)
as


declare @account_id int
declare @run_id int

select
	@account_id = account_id
from	
	tico_accounts
where
	login = @user_name
if @@rowcount != 1
begin
        select

                status = -1,
                error = "Problem deterimining login",
		login = @user_name	
        return
end

select 
	@run_id = run_id
from	
	runs
where
	name = @run_name



if not exists(select tico_account_id from user_runs where run_id = @run_id and tico_account_id = @account_id)
begin
insert into
	user_runs
values(
	@account_id,
	@run_id
)
end

exec
	r_managerunaccessdetails @user_name, @run_name
go 

