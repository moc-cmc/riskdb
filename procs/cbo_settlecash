use
	risk_tradenext_test
go

drop procedure
	cbo_settlecash
go

create procedure
	cbo_settlecash
		@login varchar(50),
		@value_date datetime
as

declare @evaluation_currency_id int
declare @fund_id int
declare @transaction_type_id int
declare @external_account_id int
declare @external_accounts int
declare @account_transaction_id int
declare @transaction_date datetime
declare @tico_account_id int
declare @amount numeric(30,2)
declare @evaluation_currency varchar(50)
declare @product_id int
declare @products int
declare @product varchar(50)
declare @ids int
declare @id int
declare @closing_rate float
declare @roll_date datetime
declare @roll_rate float
declare @forward_id int
declare @inverted_forward_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)


insert into
	#meta
values(
	"Column Hidden",
	"Product",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"Price Date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Format",
	"equiv",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"rate",
	"Number",
	"#,##0.000000")

insert into
	#meta
values(
	"Column Format",
	"balance",
	"Number",
	"#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_rate",
	"Edit Acct Settle Rate",
	NULL)

select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		messsage = "Could not resolve login"
	return
end

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

select
	@value_date = convert(datetime, convert(date, @value_date))


select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end

create table
	#products(
		external_account_id int,
		product_id int,
		quantity float)

insert into
	#products
select
	a.external_account_id,
	b.product_id,
	a.quantity * -1.0
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.value_date = @value_date



insert into
	#products
select
	a.external_account_id,
	b.currency_id,
	a.quantity * a.price
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.value_date = @value_date


insert into
	#products
select
	external_account_id,
	product_id,
	quantity
from
	product_transactions
where
	convert(date, value_date) = convert(date, @value_date)


create table
	#ladder(
		id int identity,
		external_account_id int,
		product_id int,
		quantity float,
		equiv float NULL,
		price float NULL)

insert into
	#ladder(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	product_id,
	sum(quantity)
from
	#products
group by
	external_account_id,
	product_id


delete

from
	#ladder
where
	quantity = 0.0



select
	@id = 0
select
	@ids = count(*)
from
	#ladder
where
	product_id != @evaluation_currency_id
and
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ladder
	where
		product_id != @evaluation_currency_id
	and
		id > @id
		

	select
		@external_account_id = external_account_id,
		@product_id = product_id
	from
		#ladder
	where
		id = @id
	
	select
		@closing_rate = NULL,
		@roll_date = NULL,
		@roll_rate = NULL,
		@forward_id = NULL,
		@inverted_forward_id = NULL

	select
		@closing_rate = closing_rate,
		@roll_date = roll_date,
		@roll_rate = roll_rate
	from
		ext_account_settle_rates
	where
		external_account_id = @external_account_id
	and
		product_id = @product_id
	and
		convert(date, @value_date) = convert(date, closing_date)


	if @closing_rate = NULL
	begin
		select
			@forward_id = contract_id
		from
			forwards
		where
			product_id = @product_id
		and
			currency_id = @evaluation_currency_id

		select
			@closing_rate = price
		from
			bo_spot_settles
		where
			contract_id = @forward_id
		and
			convert(date, @value_date) = convert(date, price_date)

		if @closing_rate = NULL
		begin
			select
				@inverted_forward_id = contract_id
			from
				forwards
			where
				product_id = @evaluation_currency_id
			and
				currency_id = @product_id
	
			select
				@closing_rate = 1.0 / price
			from
				bo_spot_settles
			where
				contract_id = @inverted_forward_id
			and
				convert(date, @value_date) = convert(date, price_date)
		end

		update
			ext_account_settle_rates
		set
			closing_rate = @closing_rate
		where
			product_id = @product_id
		and
			external_account_id = @external_account_id
		and
			convert(date, closing_date) = convert(date, @value_date)
		if @@rowcount = 0
			insert into
				ext_account_settle_rates(
					external_account_id,
					product_id,
					closing_rate,
					closing_date)
			values(
				@external_account_id,
				@product_id,
				@closing_rate,
				@value_date)
	end

	if @roll_date = NULL
	begin
		exec
			r_nextbusinessday
				@value_date,
				@roll_date output

		exec
			r_nextbusinessday
				@roll_date,
				@roll_date output
		update
			ext_account_settle_rates
		set
			roll_date = @roll_date
		where
			product_id = @product_id
		and
			external_account_id = @external_account_id
		and
			closing_date = @value_date
	end
		
	if @roll_rate = NULL
	begin
		select
			@forward_id = contract_id
		from
			forwards
		where
			product_id = @product_id
		and
			currency_id = @evaluation_currency_id

		select
			@closing_rate = price
		from
			bo_prices
		where
			contract_id = @forward_id
		and
			convert(date, @value_date) = convert(date, price_date)
		and
			convert(date, @roll_date) = convert(date, value_date)

		if @closing_rate = NULL
		begin
			select
				@inverted_forward_id = contract_id
			from
				forwards
			where
				product_id = @evaluation_currency_id
			and
				currency_id = @product_id

			select
				@closing_rate = 1.0 / price
			from
				bo_prices
			where
				contract_id = @inverted_forward_id
			and
				convert(date, @value_date) = convert(date, price_date)
			and
				convert(date, @roll_date) = convert(date, value_date)
		end
		
		update
			ext_account_settle_rates
		set
			roll_rate = @roll_rate
		where
			external_account_id = @external_account_id
		and
			product_id = @product_id
		and
			closing_date = @value_date
	end

	select
		@ids = count(*)
	from
		#ladder
	where
		product_id != @evaluation_currency_id
	and
		id > @id
end



update
	#ladder
set
	equiv = quantity,
	price = 1.0
where
	product_id = @evaluation_currency_id

update
	#ladder
set
	a.equiv = a.quantity * b.closing_rate,
	a.price = b.closing_rate
from
	#ladder a,
	ext_account_settle_rates b
where
	a.product_id = b.product_id
and
	a.external_account_id = b.external_account_id


create table
	#equiv_balances(
		external_account_id int,
		quantity float)

insert into
	#equiv_balances
select
	external_account_id,
	sum(equiv)
from
	#ladder
group by
	external_account_id


create table
	#rolls(
		id int identity,
		currency varchar(50) NULL,
		style varchar(250) NULL,
		account varchar(50) NULL,
		product varchar(50) NULL,
		value_date datetime NULL,
		balance float NULL,
		equiv float NULL,
		rate float NULL,
		settle varchar(50) NULL,
		roll varchar(50) NULL)


select
	@product_id = 0
select
	@products = count(*)
from
	#ladder
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#ladder
	where
		product_id > @product_id

	select
		@product = symbol
	from
		products
	where
		product_id = @product_id

	insert into
		#rolls(
			style,
			product,
			currency)
	values(
		"background:#FFFFCC;border: 1px solid white",
		@product,
		@product)

	insert into
		#rolls(
			style,
			account,
			product,
			value_date,
			balance,
			equiv)
	select
		style = "background:#fff;border: 1px solid white",
		accout = a.symbol,
		product = c.symbol,
		value_date = @value_date,
		balance = b.quantity,
		b.equiv
	from
		external_accounts a,
		#ladder b,
		products c
	where
		a.external_account_id = b.external_account_id
	and
		b.product_id = c.product_id
	and
		c.product_id = @product_id
	order by
		a.symbol
	
	select
		@products = count(*)
	from
		#ladder
	where
		product_id > @product_id
	
end


update
	#rolls
set
	settle = "SETTLE",
	roll = "ROLL"
where
	equiv != 0.0
and
	product != @evaluation_currency

create table
	#output(
		id int identity,
		style varchar(250) NULL,
		currency varchar(50) NULL,
		product varchar(50) NULL,
		account varchar(50) NULL,
		value_date datetime NULL,
		balance float NULL,
		equiv float NULL,
		rate float NULL,
		settle varchar(50) NULL,
		roll varchar(50) NULL)

insert into
	#output(
		style,
		currency,
		product,
		account,
		value_date,
		balance,
		equiv,
		rate,
		settle,
		roll)
select
	style,
	currency,
	product,
	account,
	value_date = convert(varchar(11), value_date, 1),
	balance,
	equiv,
	rate,
	settle,
	roll
from
	#rolls
order by
	product,	
	id

select
	section = "Settlement Rates For " + convert(varchar(11), @value_date),
	style = "background:#fff;border: 1px solid white",
	price_date = @value_date,
	account = a.symbol,
	currency = b.symbol,
	closing_date = convert(char(11), c.closing_date, 1),
	c.closing_rate,
	roll_date = convert(char(11), c.roll_date, 1),
	roll_rate = c.roll_rate,
	edit_rate = "EDIT",
	settle_date = convert(varchar(11), c.closing_date, 1)
from
	external_accounts a,
	products b,
	ext_account_settle_rates c
where
	a.external_account_id = c.external_account_id
and
	b.product_id = c.product_id
and
	b.product_id != @evaluation_currency_id
order by
	b.symbol,
	a.symbol


select
	style,
	currency,
	product,
	account,
	value_date = convert(varchar(11), value_date, 1),
	roll_date = convert(varchar(11), @roll_date, 1),
	balance,
	equiv,
	rate,
	settle,
	roll
from
	#output
order by
	id


go
