drop procedure
	ag_addreportingdomain
go

create procedure
	ag_addreportingdomain
		@login varchar(50),
		@account_type varchar(50)
as

declare @reporting_domain_id int

select
	@reporting_domain_id = reporting_domain_id
from
	reporting_domains
where
	name = @account_type
if @reporting_domain_id != NULL
begin
	select
		status = "Error",
		message = "Account Type already exists",
		account_type = @account_type
	return
end


exec
	j_nextkey
		"reporting_domains",
		@reporting_domain_id output

insert into
	reporting_domains
values(
	@reporting_domain_id,
	@account_type)

exec
	ag_reportingdomains
		@login


go
