drop procedure
	r_editcfdcontractsize
go

create procedure
	r_editcfdcontractsize
		@login varchar(50),
		@name varchar(100),
		@symbol varchar(50),
		@currency varchar(50),
		@quantity int,
		@trade_date datetime=NULL
as

declare @contract_id int
declare @assigned_status_id int
declare @cfd_status_id int
declare @tico_account_id int
declare @cfd_product_type_id int
declare	@cfd_unassigned_type_id int
declare @cfd_product_id int
declare @cfd_pt_id int



select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Login not found"
	return
end

select
	@cfd_product_type_id = product_type_id
from
	product_types
where
	name = "CFD"
if @cfd_product_type_id = NULL
begin
	exec
		j_nextkey
			"product_types",
			@cfd_product_type_id
	insert into
		product_types(
			product_type_id,
			name)
	values(
		@cfd_product_type_id,
		"CFD")
end

select
	@cfd_unassigned_type_id = product_type_id
from
	product_types
where
	name = "Unassigned CFD"
if @cfd_unassigned_type_id = NULL
begin
	exec
		j_nextkey
			"product_types",
			@cfd_unassigned_type_id
	insert into
		product_types(
			product_type_id,
			name)
	values(
		@cfd_unassigned_type_id,
		"Unassigned CFD")
end


select
	@assigned_status_id = status_id
from
	statuses
where
	name = "Assigned"
if @assigned_status_id = NULL
begin
	exec
		j_nextkey
			"statuses",
			@assigned_status_id output

	insert into
		statuses
	values(
		@assigned_status_id,
		"Assigned")
end

select
	@contract_id = a.contract_id
from
	forwards a,
	products b,
	products c
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id
and
	b.symbol = @symbol
and
	c.symbol = @currency

if @contract_id = NULL
begin
	select
		status = "Error",
		message = "CFD Contract not found",
		symbol = @symbol,
		currency = @currency
	return
end

exec
	j_nextkey
		"cfd_statuses",
		@cfd_status_id output

begin tran
	update
		forwards
	set
		quantity = @quantity
	where
		contract_id = @contract_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to assigne quantity to CFD",
			symbol = @symbol,
			currency = @currency
		rollback tran
		return
	end

	insert into
		cfd_statuses
	values(
		@cfd_status_id,
		@contract_id,
		@tico_account_id,
		@assigned_status_id,
		getdate())
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not update status of CFD",
			symbol = @symbol,
			currency = @currency
		rollback tran
		return
	end

	select
		@cfd_product_id = a.product_id,
		@cfd_pt_id = a.product_type_id
	from
		products a,
		forwards b
	where
		a.product_id = b.product_id
	and
		b.contract_id = @contract_id

	if @cfd_pt_id = @cfd_unassigned_type_id
	begin
		update
			products
		set
			product_type_id = @cfd_product_type_id
		where
			product_id = @cfd_product_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Could not update product type of CFD product",
				contract_id = @contract_id,
				cfd_product_id = @cfd_product_id
			rollback tran
			return
		end
	end


commit tran

exec
	ag_cfdsettles
		@login,
		@trade_date
	
	


go
		
