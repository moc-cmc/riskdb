drop procedure bls_validatedeal
go

create procedure
	bls_validatedeal
		@deal_id int,
		@validated char(1)=NULL output,
		@debug char(1)=NULL
	
as

select
	@validated = 'y'

if @debug != NULL
	select
		@debug = lower(@debug)

declare @deal_trade_count int
declare @reval_trade_count int

declare @resid_status_id int
select
	@resid_status_id = status_id
from
	statuses
where
	name = "Resid"

create table
	#meta
(
	meta_type char(50),
	name char(50) NULL,
	action char(100) NULL,
	value char(200) NULL


)
insert into #meta values("Column Group", "section", NULL, NULL)
insert into #meta values("Row Style", "style", NULL, NULL)

create table
	#deal_validation
(
	validation_id int,
	validation varchar(100),
	status varchar(15),
	notes varchar(150) NULL,
	style varchar(50) NULL
)

create table
	#deal_trades
(
	deal_id int,
	trade_id int,
	contract_id int NULL,
	contract varchar(50) NULL,
	perspective_contract_id int,
	perspective_contract varchar(50) NULL,
	internal_account_id int,
	internal_account varchar(50) NULL,
	external_account_id int,
	external_account varchar(50) NULL,
	counterparty_id int,
	counterparty varchar(50) NULL,
	trader_id int,
	trader varchar(30) NULL,
	broker_id int,
	broker varchar(30) NULL,
	trade_type_id int,
	trade_type varchar(25) NULL,
	sales_code_id int,
	sales_code varchar(50) NULL,
	trade_date datetime,
	status_id int,
	value_date datetime,
	price float,
	quantity numeric(30, 2)
)

create table
	#daily_revals
(
	trade_daily_reval_id int,
	trade_id int,
	bo_trade_date datetime,
	reval_date datetime,
	contract_id int NULL,	
	perspective_contract_id int NULL,
	notional_amount float NULL,
	evaluation_notional float NULL,
	forward_id int NULL,
	maker char(1) NULL,
	taker char(1) NULL,
	agency_trader char(1) NULL,
	none_salescode char(1) NULL,
	/* trades table info */
	counterparty_id int NULL,
	trader_id int NULL,
	sales_code_id int NULL,
	status_id int NULL
)
	
/*
 |  Collect trades in deal
 */	
insert into
	#deal_trades(
			deal_id,
			trade_id,
			contract_id,
			perspective_contract_id,
			internal_account_id,
			external_account_id,
			counterparty_id,
			trader_id,
			broker_id,
			trade_type_id,
			sales_code_id,
			trade_date,
			status_id,
			value_date,
			price,
			quantity)
select
	deal_id,
	trade_id,
	contract_id,
	contract_id,
	internal_account_id,
	external_account_id,
	counterparty_id,
	trader_id,
	broker_id,
	trade_type_id,
	sales_code_id,
	trade_date,
	status_id,
	value_date,
	price,
	quantity
from
	trades
where
	deal_id = @deal_id
and
	quantity != 0
select @deal_trade_count = @@rowcount
if @deal_trade_count = 0
begin
	select
		error="Error",
		msg="No trades found for deal",
		deal_id=@deal_id
	return
end


/*
 | Mark perspective contract for trades
 */ 
update
	#deal_trades
set
	perspective_contract_id = b.perspective_contract_id
from
	#deal_trades a,
	def_perspective_contracts b
where
	a.contract_id = b.contract_id
	
/*
 | Collect back office information
 */ 
insert into
	#daily_revals
		(
        	trade_daily_reval_id,
        	trade_id,
        	bo_trade_date,
		reval_date,
        	contract_id,
        	perspective_contract_id ,
        	notional_amount,
        	evaluation_notional,
        	forward_id,
        	maker,
        	taker,
        	agency_trader,
		none_salescode,
        	counterparty_id,
		trader_id,
        	sales_code_id,
		status_id
		)
select
        a.trade_daily_reval_id,
        a.trade_id,
        a.bo_trade_date,
	a.reval_date,
        a.contract_id,
	b.perspective_contract_id,
        a.notional_amount, 
        a.evaluation_notional, 
        a.forward_id,
	'y',
	'n',
	'n',
	'n',
	b.counterparty_id,
	b.trader_id,
	b.sales_code_id,
	b.status_id
from
	committed_daily_revals a,
	#deal_trades b
where
	a.trade_id = b.trade_id


select
        @reval_trade_count = count(distinct(trade_id))
from
        #daily_revals


/*
 | Remove Resids
 */
delete from
	#deal_trades
where
	status_id = @resid_status_id
if @@rowcount > 0 and @debug = 'y'
begin
	select
		msg = "Removed residual trade(s)"
end

/*
 | Remove Resid Revals
 */
delete from
	#daily_revals
where
	status_id = @resid_status_id



/*
 | Set validation fields
 */
update
	#daily_revals
set
	maker = 'n',
	taker = 'y'
from
	#daily_revals a,
	fund_agency_counterparties c
where
	a.counterparty_id = c.counterparty_id

update
	#daily_revals
set
	agency_trader = 'y'
from
	#daily_revals a,
	fund_agency_traders c
where
	a.trader_id = c.trader_id

update 
	#daily_revals
set
	none_salescode = 'y'
from
	#daily_revals a,
	sales_codes b
where
	a.sales_code_id = b.sales_code_id
and
	b.name = 'None'

	

/*-----------------------------------------------------------------------------------------
 |
 |  Below are a series of checks to validate that a deal is set for BLS attribution
 |
 '----------------------------------------------------------------------------------------*/
/*
 | Check that all trades in a deal are revalued
 */
insert into
        #deal_validation(
                validation_id,
                validation,
                status,
                notes)
values(
        1,
        "Validate all trades in deal have been revalued",
        "OK",
        ""
)

if @reval_trade_count != @deal_trade_count
begin
        update
                #deal_validation
        set
                status = "Error",
                notes = "Tradecount in deal does not match daily revals count",
		style = "background:#FF9999"
        where
                validation_id = 1
	if @debug = 'y'
	begin
		select 
			reval_trade_count = @reval_trade_count,
			deal_trade_count = @deal_trade_count
	end
end
	

/*
 | Check that the trades on a deal do not span a date range
 */
declare @td_count int

insert into
        #deal_validation(
                validation_id,
                validation,
                status,
                notes)
values(
        2,
        "Validate trades in deal do not span date range",
        "OK",
        "" 
)

select
	@td_count = count(distinct(bo_trade_date))
from
	#daily_revals
if @td_count > 1
begin
        update
                #deal_validation
        set
                status = "Error",
                notes = "More than one back office trade date in deal",
		style = "background:#FF9999"
        where
                validation_id = 2
	if @debug = 'y'
	begin
		select
			distinct(bo_trade_date)
		from
			#daily_revals
	end
end



/*
 | Check that any maker trader values are also defined as fund_agency_traders
 */
insert into
        #deal_validation(
                validation_id,
                validation,
                status,
                notes)
values(
        3,
        "Validate any maker trader is also a fund agency trader",
        "OK",
        "" 
)
declare @maker_fund_trader_count int

select
	@maker_fund_trader_count = count(*)
from
	#daily_revals
where
	maker = 'y'
and
	agency_trader = 'n'
if @maker_fund_trader_count > 0
begin
        update
                #deal_validation
        set
                status = "Error",
                notes = "Found "+ rtrim(convert(varchar(10), @maker_fund_trader_count)) +" maker trader that are not fund agency traders",
		style = "background:#FF9999"
        where
                validation_id = 3

	if @debug = 'y'
	begin
		select 
			a.*,
			b.trader_id, 
			b.symbol
		from
        		#daily_revals a,
			traders b
		where
			a.trader_id = b.trader_id
		and
			a.maker = 'y'
		and
			a.agency_trader = 'n'
	end
end


/*
 | Check that all non-agency_traders are assigned a salecode other than None
 */
insert into
        #deal_validation(
                validation_id,
                validation,
                status,
                notes)
values(
        4,
        "Validate all non-agency traders have a salescode other than 'None'", 
        "OK",
	""
)
declare @invalid_salescode_count int

select
	@invalid_salescode_count = count(*)
from
	#daily_revals
where
	agency_trader = 'n'
and
	none_salescode = 'y'
if @invalid_salescode_count > 0
begin
        update
                #deal_validation
        set
                status = "Warning",
                notes = "Found "+ rtrim(convert(varchar(10), @invalid_salescode_count)) +" trades with non-agency trade and 'None' salescode"
        where
                validation_id = 4
	if @debug = 'y'
	begin
		select
			"trade_id"=trade_id
		from
			#daily_revals
		where
			agency_trader = 'n'
		and
			none_salescode = 'y'
		group by
			trade_id
	end
end

			

/*
 | Check that there is as least one maker trade and one taker trade in the deal per perspective contract
 */ 
declare @maker_count_perspective_ct int
declare @taker_count_perspective_ct int
declare @maker_non_none_salescode int
declare @perspective_contract_id int
	
insert into
        #deal_validation(
                validation_id,
                validation,
                status,
                notes)
values(
        5,
        "Validate at lease one maker trade and one taker trade per perspective contract ",
        "OK",
	""
)
	

create table
	#p_contracts
(
	contract_id int
)
insert into 
	#p_contracts 
select
	distinct(perspective_contract_id)
from
	#daily_revals

declare
        perspective_ct_cursor
cursor for
        select
		contract_id
	from
		#p_contracts
	order by
		contract_id


open perspective_ct_cursor
fetch perspective_ct_cursor into @perspective_contract_id

while @@sqlstatus = 0
begin
	select
		@maker_count_perspective_ct = 0,
		@taker_count_perspective_ct = 0,
		@maker_non_none_salescode = 0

	select
		@maker_count_perspective_ct = count(*)
	from
		#daily_revals
	where
		maker = 'y'
	and
		perspective_contract_id	= @perspective_contract_id

        select
                @taker_count_perspective_ct = count(*)
        from
                #daily_revals
        where
                taker = 'y'
        and
                perspective_contract_id = @perspective_contract_id


	if @maker_count_perspective_ct = 0
	begin

	        update
                	#deal_validation
        	set
                	status = "Error",
                	notes = "Did not find maker trade for perspective contract in deal:"+ rtrim(convert(varchar(10), @perspective_contract_id)),
			style = "background:#FF9999"
        	where
                	validation_id = 5
	end
	if @taker_count_perspective_ct = 0
	begin
			
		select 
			@maker_non_none_salescode = count(*)
		from	
			#daily_revals
		where
			maker = 'y'
		and
			none_salescode != 'y'
		
		if @maker_non_none_salescode = 0
		begin
	        	update
                		#deal_validation
        		set
                		status = "Error",
                		notes = "Did not find taker trade for perspective contract in deal:  "+ rtrim(convert(varchar(10), @perspective_contract_id))+ 
                                        " or maker trade with non none salescode. Will result in Unattributed sales code PL",
				style = "background:#FF9999"
        		where
                		validation_id = 5
		end
		else
		begin
	        	update
                		#deal_validation
        		set
                		status = "Warning",
                		notes = "Evaluated as prop. Did not find taker trade for perspective contract in deal: "+ rtrim(convert(varchar(10), @perspective_contract_id))+ 
					" - Did find salescode for pl distribution",
				style = "background:#FFFF99"
        		where
                		validation_id = 5
		end
			
	end

	fetch perspective_ct_cursor into @perspective_contract_id
end

close perspective_ct_cursor
deallocate perspective_ct_cursor



/*
 | Check that all of the trades in the deal have a calculated forward delta in committed_daily_revals
 */ 
insert into	
       	#deal_validation(
		validation_id, 
       		validation,
       		status,
       		notes)
values(
	6,
	"Validate back office entries have revaled commit deltas - non null fwd id", 
	"OK",
	""
)

declare @non_reval_comdelta_count int

select 
	@non_reval_comdelta_count = count(*)
from
	#daily_revals
where
	forward_id = NULL

if @non_reval_comdelta_count > 0
begin
	update
		#deal_validation
	set
		status = "Error",
		notes = "NULL forward ids exist for trades in back office. Resolve by running 'real missing commit deltas', contact Elysium Support",
		style = "background:#FF9999"
	where
		validation_id = 6

	if @debug = 'y'
	begin
		select
			section="Validation 1 - Missing Commit Deltas",
			* 
		from
			#daily_revals
		where
			forward_id = NULL
		
		select 
			"Validation 1 - Resolution - run cbo_revalmissingcommitdeltas"
	end	
end

if exists(select status from #deal_validation where status != "OK")
begin
	select
		@validated = 'n'
end


if @validated = 'n'
begin
	select * from #meta
	select
		section="Deal "+rtrim(convert(varchar(20), @deal_id)),
        	validation_id,
        	validation,
        	status,
        	notes,
		style
	from
		#deal_validation

	update
		#deal_trades
	set
		broker = b.symbol
	from
		#deal_trades a,
		brokers b
	where
		a.broker_id = b.broker_id
	
	update
		#deal_trades
	set
		internal_account = b.symbol
	from
		#deal_trades a,
		internal_accounts b
	where
		a.internal_account_id = b.internal_account_id
	
	update
		#deal_trades
	set
		external_account = b.symbol
	from
		#deal_trades a,
		external_accounts b
	where
		a.external_account_id = b.external_account_id
	
	update
		#deal_trades
	set
		trader = b.symbol
	from
		#deal_trades a,
		traders b
	where
		a.trader_id = b.trader_id
	
	update
		#deal_trades
	set
		counterparty = b.name
	from
		#deal_trades a,
		counterparties b
	where
		a.counterparty_id = b.counterparty_id
	
	update
		#deal_trades
	set
		sales_code = b.name
	from
		#deal_trades a,
		sales_codes b
	where
		a.sales_code_id = b.sales_code_id
	
	update
		#deal_trades
	set
		contract = b.symbol
	from
		#deal_trades a,
		contracts b
	where
		a.contract_id = b.contract_id

        update  
                #deal_trades
        set     
                perspective_contract = b.symbol
        from
                #deal_trades a,
                contracts b
        where   
                a.perspective_contract_id = b.contract_id


	select
		section="Deal Info "+rtrim(convert(varchar(20), @deal_id)),
		a.trade_id,
		bo_trade_date = case b.bo_trade_date
					when NULL then "Not Revalued"
					else convert(varchar(14), b.bo_trade_date, 1)
				end,
		a.internal_account,
		a.external_account,
		a.counterparty,
		b.maker,
		b.taker,
		a.trader,
		b.agency_trader,
		a.broker,
		a.sales_code,
		b.none_salescode,
		a.contract,
		a.perspective_contract,
		a.quantity,
		a.price,
		a.value_date,
		b.evaluation_notional
	from
		#deal_trades a,
		#daily_revals b
	where
		a.trade_id *= b.trade_id
	and
		convert(date, b.bo_trade_date) = convert(date, b.reval_date)

end
	
go

