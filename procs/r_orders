
if object_id("r_orders") != NULL
    drop procedure
        r_orders
go

create procedure
	r_orders
		@login char(100)
as

select
	meta_type = "Column Link",
	column = "run_name",
	link = "Run Orders"

select
	run_name = a.name
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
order by
	name

go
