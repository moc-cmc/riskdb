create or replace procedure
	 r_manageaccountspreadoverrides
		@login varchar(50)

as


declare @tico_account_id int
declare @missing_count int
declare @override_accounts int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Link",
	"set_override",
	"Edit Account Spread Override",
	NULL)

insert into
	#meta
values (
	"Column Link",
	"init_missing_defaults",
	"Initialize Account Spread",
	NULL)

insert into
        #meta
values (
        "Column Link",
        "view_account",
        "View Account Spread Overrides",
        NULL)

insert into
        #meta
values (
        "Column Link",
        "back",
        "Manage Default Account Spreads",
        NULL)

insert into
	#meta
values (
	"Column Hidden",
	"name",
	NULL,
	NULL)


create table
	#output(
		id int identity,
		section varchar(50),
		ordering int,
		account varchar(50),
		contract_id int,
		contract varchar(50) NULL,
		account_spread varchar(50) NULL,
		pips float NULL,
		set_spread varchar(20) NULL,
		set_override varchar(20) NULL
)

insert into
	#output(
		section,
		ordering,
		account,
		contract_id,
		contract,
		account_spread,
		pips,
		set_override)
select
	section = "Account Spread Overrides",
	ordering = 1,
	account = b.symbol,
	contract_id = c.contract_id,
	contract = c.symbol,
	account_spread = a.name,
	pips = a.pips,
	set_override = "Edit"
from
	account_spread_overrides a,
	external_accounts b,
	contracts c
where
	a.contract_id = c.contract_id
and
	a.external_account_id = b.external_account_id



select
	* 
from
	#meta

select
	section = "Operations",
	back = "<< Back to Default Spreads",
	style = @style

select
	section,
	account,
	contract,
	account_spread,
	pips,
	set_spread,
	set_override,
	name=account_spread,
	style = @style
from
	#output
order by 
	ordering,
	account,
	contract

go
	
	


		
	
	
	
