drop procedure
	r_editsource
go

create procedure
	r_editsource
		@login varchar(50),
		@sid int,
		@source varchar(50),
		@source_type varchar(50)

as


declare @source_change varchar(1)
declare @source_type_id int
declare @dupe_name varchar(50)

select
	@source_type_id = source_type_id
from
	source_types
where
	name = @source_type
if @@rowcount != 1
begin
	select
		msg = "Source type not found"
end

select
        @source_change = "N"
from
	sources
where
	name = @source
and
	source_type_id = @source_type_id

if @source_change != "N"
begin

	update	
		sources
	set
		name = @source,
		source_type_id = @source_type_id
	where
		source_id = @sid 
end

exec
	r_viewsources
		@login


go
