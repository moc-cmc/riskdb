drop procedure
	api_tallyriskbookroll
go

create procedure
	api_tallyriskbookroll
		@login char(25),
		@buy_sell varchar(50),
		@quantity numeric(30,4),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@strategy varchar(50),
		@near_date datetime,
		@near_price float,
		@far_date datetime,
		@far_price float,
		@deal_id int output,
		@batch_transaction_id int,
		@trade_date datetime=NULL
as

declare @tally_type varchar(20)
declare @external_account varchar(50)
declare @symbol varchar(50)
declare @near_trade_id int
declare @far_trade_id int
declare @near_quantity numeric(30,4)
declare @far_quantity numeric(30,4)
declare @sales_code varchar(50)
declare @contract_id int
declare @swap_symbol_id int
declare @swap_symbol varchar(50)
declare @strategy_id int
declare @near_identifier varchar(50)
declare @far_identifier varchar(50)


select
	@near_identifier = "RB" + rtrim(@strategy) + "-" + rtrim(@dealt_currency) + rtrim(@counter_currency) + "-" + rtrim(convert(varchar(25), @batch_transaction_id)) + ".n"


select
	@far_identifier = "RB" + rtrim(@strategy) + "-" + rtrim(@dealt_currency) + rtrim(@counter_currency) + "-" + rtrim(convert(varchar(25), @batch_transaction_id)) + ".f"


select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @strategy_id = NULL
begin
	exec
		j_nextkey
			"strategies",
			@strategy_id output
	insert into
		strategies(
			strategy_id,
			name)
	values(
		@strategy_id,
		@strategy)
end


select
	@sales_code = "None"

select
	@tally_type = "Swap"

if @buy_sell = "Buy"
begin
	select
		@near_quantity = abs(@quantity)
end
if @buy_sell = "Sell"
begin
	select
		@near_quantity = abs(@quantity) * -1.0
end

select
	@far_quantity = @near_quantity * -1.0

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)

select
    @contract_id = contract_id
from
    contracts
where
    symbol = @symbol
if @@rowcount != 1
begin

    declare @evaluation_currency varchar(50)
    declare @fund_id int

    exec
        r_defaultfundforlogin
                @login,
                @fund_id output

    select
        @evaluation_currency = a.symbol
    from
        products a,
        funds b
    where
        a.product_id = b.evaluation_currency_id

    exec r_addbatchfwdsubscription
            @login,
            @symbol,
            @dealt_currency,
            @counter_currency,
            @evaluation_currency

    if not exists (select contract_id from contracts where symbol=@symbol)
    begin
        select
            status = "Error",
            message = "Contract not found",
            symbol=@symbol

        return
    end

end


if @trade_date= NULL
select
	@trade_date = getdate()

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Market Swap",
		@trade_type = "Swap Near",
		@quantity = @near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@price = @near_price,
		@trade_date = @trade_date,
		@strategy = @strategy,
		@trade_date = @trade_date



exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Market Swap",
		@trade_type = "Swap Far",
		@quantity = @far_quantity,
		@symbol = @symbol,
		@value_date = @far_date,
		@price = @far_price,
		@trade_date = @trade_date,
		@strategy = @strategy, 
		@trade_date = @trade_date

/* Create and assign client swap symbol */
exec
        j_nextkey
                "swap_symbols",
                @swap_symbol_id output
select
        @swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".M"

/* select swap_symbol = @swap_symbol, deal_id = @deal_id, near_trade_id = @near_trade_id, far_trade_id = @far_trade_id /* MARKR */ */


insert into
        swap_symbols(
        	swap_symbol_id,
        	symbol,
        	timestamp)
values(
        @swap_symbol_id,
        @swap_symbol,
        getdate())

/* Tie both legs to the swap symbol */
insert into
        swap_symbol_trades(
        	swap_symbol_id,
        	trade_id)
values(
        @swap_symbol_id,
        @near_trade_id)

insert into
        swap_symbol_trades(
        	swap_symbol_id,
        	trade_id)
values(
        @swap_symbol_id,
        @far_trade_id)



go
