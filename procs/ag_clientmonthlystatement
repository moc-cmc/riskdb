create table
	#cash_out(
		id int identity,
		style varchar(250) NULL,
		transaction_id varchar(50) NULL,
		transaction_date datetime NULL,
		transaction_type varchar(50) NULL,
		currency varchar(50) NULL,
		amount float NULL,
		equivalent_amount float NULL)

select
	@transaction_type_id = 0
select
	@transaction_types = count(*)
from
	#transaction_types
where
	transaction_type_id > @transaction_type_id

while @transaction_types > 0
begin
	select
		@transaction_type_id = min(transaction_type_id)
	from
		#transaction_types
	where
		transaction_type_id > @transaction_type_id

	select
		@amount = NULL

	select
		@transaction_type = name
	from
		transaction_types
	where
		transaction_type_id = @transaction_type_id

	select
		@amount = sum(end_equiv)
	from
		#transactions
	where
		transaction_type_id = @transaction_type_id
	and
		convert(date, transaction_date) >= convert(date, @first_of_month)
	if @amount = NULL
		select
			@amount = 0.0

	insert into
		#report(
			style,
			description,
			value)
	values(
		@style,
		@transaction_type + "s During Period",
		@amount)

	insert into
		#cash_out(
			style,
			transaction_id)
	values(
		@style,
		@transaction_type)

	insert into
		#cash_out(
			style,
			transaction_id,
			transaction_date,
			transaction_type,
			currency,
			amount,
			equivalent_amount)
	select
		style = @style,
		convert(varchar(50), convert(numeric(30,0), a.account_transaction_id)),
		a.transaction_date,
		transaction_type = b.name,
		currency = c.symbol,
		a.amount,
		equivalent_amount = end_equiv
	from
		#transactions a,
		transaction_types b,
		products c
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.currency_id = c.product_id
	and
		b.name = @transaction_type
	and
		a.transaction_date >= @first_of_month
	and
		a.amount != 0.0
	order by
		a.transaction_date

	insert into
		#cash_out(
			style,
			transaction_id,
			equivalent_amount)
	values(
		@total_style,
		@transaction_type + " Total",
		@amount)

	select
		@transaction_types = count(*)
	from
		#transaction_types
	where
		transaction_type_id > @transaction_type_id
end

