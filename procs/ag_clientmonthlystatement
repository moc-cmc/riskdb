insert into
	#open_trades(
		section,
		style,
		trade_type,
		trade_id,
		value_date,
		dealt_ccy,
		dealt_amount,
		counter_ccy,
		counter_amount,
		rate,
		trade_date)
select
	section = "Open Trades as of " + convert(varchar(11), @last_of_month),
	style = @style,
	trade_type = c.name,
	a.trade_id,
	value_date = convert(varchar(11), a.value_date),
	dealt_ccy = e.symbol,
	dealt_amount = b.quantity * -1.0,
	counter_ccy = f.symbol,
	counter_amount = b.quantity * b.price,
	rate = b.price,
	b.trade_date
from
	committed_daily_revals a,
	trades b,
	trade_types c,
	forwards d,
	products e,
	products f
