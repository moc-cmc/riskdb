	account_transaction_id,
	transaction_date,
	transaction_type_id,
	currency_id,
	amount
from
	account_transactions
where
	external_account_id = @external_account_id
and
	convert(date, transaction_date) <= convert(date, @last_of_month)

update
	#transactions
set
	a.begin_equiv = a.amount * b.begin_rate
from
	#transactions a,
	#conversion_rates b
where
	a.currency_id = b.product_id

update
	#transactions
set
	begin_equiv = 0.0
where
	transaction_date >= @first_of_month

update
	#transactions
set
	a.end_equiv = a.amount * b.end_rate
from
	#transactions a,
	#conversion_rates b
where
	a.currency_id = b.product_id



select
	@begin_balance = sum(begin_equiv)
from
	#transactions
where
	transaction_date < @first_of_month
