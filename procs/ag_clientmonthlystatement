	d.product_id = e.product_id
and
	d.currency_id = f.product_id
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
and
	a.value_date > @last_of_month
and
	convert(date, a.bo_trade_date) <= convert(date, @last_of_month)
order by
	e.symbol,
	f.symbol,
	a.value_date


