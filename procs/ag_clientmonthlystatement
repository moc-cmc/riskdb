	end_rate = 1.0
where
	product_id = @display_currency_id

update
	#display_rates
set
	a.begin_rate = c.price
from
	#display_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	b.currency_id = @display_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @first_biz_day)

