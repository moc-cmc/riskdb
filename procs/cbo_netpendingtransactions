create or replace procedure
	cbo_netpendingtransactions
		@login varchar(100),
		@trade_date datetime

as

declare @roll_transaction_date datetime
declare @pending_count int
declare @rolled_count int
declare @updated_count int
declare @tico_account_id int
declare @external_account_id int
declare @currency_id int
declare @transaction_type_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @ids int
declare @account_transaction_id int
declare @amount float
declare @exchange_fee float
declare @trade_settlement_fee float
declare @pending_transactions int
declare @netted_transactions int

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login
if @tico_account_id = NULL
begin
        select
                status = "Error",
                message = "Unable to resolve login"
        return
end

if @trade_date = NULL
begin
        select
                @trade_date = getdate()
       	select
                @trade_date = convert(date, @trade_date)
end

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output

select
	@exchange_fee = transaction_type_id
from
	transaction_types
where
	name = "Exchange Fee"
if @@rowcount != 1
begin
	select
		status = "Erorr",
		message = "Could not find transaction type",
		type = "Exchange Fee"
	return
end

select
	@trade_settlement_fee = transaction_type_id
from
        transaction_types
where
        name = "Trade Settlement Fee"
if @@rowcount != 1
begin
        select
                status = "Erorr",
                message = "Could not find transaction type",
                type = "Trade Settlement Fee"
        return
end

create table
	#pending_transactions(
		account_transaction_id int,
        	entered_by int,
        	external_account_id int,
        	transaction_type_id int,
        	transaction_date datetime,
        	currency_id int,
        	amount float,
        	create_date datetime,
        	status_id int NULL,
        	ledger_request_id int NULL,
        	note char(255) null)
create table
        #netted_transactions(
                id int identity,
		account_transaction_id int NULL,
                external_account_id int,
                currency_id int,
                transaction_type_id int,
                amount float)

insert into
	#pending_transactions
select
        account_transaction_id,
        entered_by,
        external_account_id,
        transaction_type_id,
        transaction_date,
        currency_id,
        amount,
        create_date,
        status_id,
        ledger_request_id,
        note
from
        pending_transactions
where
	transaction_type_id in(@exchange_fee, @trade_settlement_fee)
and
        transaction_date >= @begin_date
and
        transaction_date <= @end_date

insert into
	#netted_transactions(
		external_account_id,
		currency_id,
		transaction_type_id,
		amount)
select
	a.external_account_id,
	a.currency_id,
	a.transaction_type_id,
	sum(a.amount)
from
	#pending_transactions a
group by
	a.external_account_id,
	a.currency_id,
	a.transaction_type_id

select
	@pending_transactions = count(*)
from
	#pending_transactions

select
        @netted_transactions = count(*)
from
	#netted_transactions

select
        @id = 0
select
        @ids = count(*)
from
        #netted_transactions
where
        id > @id

while @ids > 0
begin
	select
                @id = min(id)
        from
                #netted_transactions
        where
                id > @id

	select
		@account_transaction_id = NULL
	exec
		j_nextkey
			"account_transactions",
			@account_transaction_id output
	update
		#netted_transactions
	set
		account_transaction_id = @account_transaction_id
	where
		id = @id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem updating #netted_transactions",
			@account_transaction_id,
			external_account_id,
			currency_id,
			transaction_type_id,
			amount
		from
			#netted_transactions
		where
			id = @id 

		return
	end

	select
                @ids = count(*)
        from
                #netted_transactions
        where
                id > @id
end

begin tran

	insert into
                account_transactions(
                        account_transaction_id,
                        entered_by,
                        external_account_id,
                        transaction_type_id,
                        transaction_date,
                        currency_id,
                        amount)
	select
		account_transaction_id,
		@tico_account_id,
		external_account_id,
		transaction_type_id,
		@trade_date,
		currency_id,
		amount
	from
		#netted_transactions

	if @@rowcount != @netted_transactions
	begin
		select
			status = "Error",
			message = "Number if inserted rows to account_transactions does not match #netted_transactions"
		rollback tran
		return
	end
			
	insert into
            	pending_transactions_archive(
                	account_transaction_id,
                	entered_by,
                	external_account_id,
                	transaction_type_id,
                	transaction_date,
                	currency_id,
                	amount,
                	create_date,
                	status_id,
                	ledger_request_id,
                	note,
                	archived_at)
        select
            	account_transaction_id,
            	entered_by,
            	external_account_id,
            	transaction_type_id,
            	transaction_date,
            	currency_id,
            	amount,
            	create_date,
            	status_id,
            	ledger_request_id,
            	note,
            	getdate()
        from 
            	#pending_transactions

        if @@rowcount != @pending_transactions
        begin
            	select
                	status = "Error",
                	message = "Problem sweeping pending transactions into archive"
            	rollback tran
            	return
        end
	
	delete from
		pending_transactions
	from
		pending_transactions a,
		#pending_transactions b
	where
		a.account_transaction_id = b.account_transaction_id

	if @@rowcount != @pending_transactions
	begin
		select
                        status = "Error",
                        message = "Number if inserted rows deleted from pending_transactions does not match #pending_transactions"
                rollback tran
                return
        end

commit tran

go


