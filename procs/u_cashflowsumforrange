create procedure
	u_cashflowsumforrange
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime,
		@end_date datetime,
		@evaluation_currency_id int output,
		@option_prem_credit_equiv float output,
		@option_prem_debit_equiv float output,
		@settled_fx_equiv float output,
		@fees_equiv float output,
		@begin_fx_equiv float output,
		@end_fx_equiv float output,
		@fx_pl_equiv float output

as


declare @fund_id int
declare @run_id int

declare @original_begin_date datetime
declare @original_end_date datetime

declare @b_date datetime
declare @e_date datetime

declare @prem_equiv float
declare @settled_balance float

declare @id int
declare @ids int
declare @product_id int
declare @prod varchar(50)


select
	@original_begin_date = @begin_date,
	@original_end_date = @end_date

if @original_begin_date = NULL and @original_end_date = NULL
begin
	select
		@begin_date = max(price_date)
	from
		prices

	select
		@begin_date = convert(datetime, convert(date, @begin_date)),
		@end_date = convert(datetime, convert(date, @begin_date))
end

if @original_begin_date != NULL and @original_end_date = NULL
begin
	select
		@begin_date = convert(datetime, convert(date, @begin_date)),
		@end_date = convert(datetime, convert(date, @begin_date))
end

if @original_begin_date = NULL and @original_end_date != NULL
begin
	select
		@begin_date = convert(datetime, convert(date, @end_date)),
		@end_date = convert(datetime, convert(date, @end_date))

end


if @original_begin_date != NULL and @original_end_date != NULL
begin
	select
		@begin_date = convert(datetime, convert(date, @begin_date)),
		@end_date = convert(datetime, convert(date, @end_date))

end


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id



exec
	r_daterangefordate
		@begin_date,
		@b_date output,
		@e_date output

select
	@begin_date = @b_date

select
	@b_date = NULL,
	@e_date = NULL

exec
	r_daterangefordate
		@end_date,
		@b_date output,
		@e_date output

select
	@end_date = @e_date



select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	a.name = @run_name
if @run_id = NULL
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end

