
drop procedure
	fxa_setclientrun
go

create procedure
	fxa_setclientrun
		@login varchar(50),
		@user_name varchar(50),
		@run_name varchar(50)=NULL
as

declare @run_id int
declare @tico_account_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @user_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "user name not found",
		user_name = @user_name
	return
end

select
	@run_id = run_id
from
	runs
where
	name = @run_name
	

update
	client_login_configs
set
	run_id = @run_id
where
	tico_account_id = @tico_account_id

exec
	fxa_clientruns
		@login,
		@user_name


go


