
drop procedure
	ag_tallyoptexpdeals
go

create procedure
	ag_tallyoptexpdeals
		@login varchar(50),
		@batch_id int
as


declare @tico_account_id int
declare @queued_deal_id int
declare @queued_deals int
declare @queued_trade_id int
declare @queued_trades int
declare @batch_trade_date datetime
declare @batch_value_date datetime
declare @batch_run_name varchar(50)
declare @run_name varchar(50)
declare @deal_type_id int

declare @source varchar(50)
declare @trade_id int
declare @deal_id int
declare @user_name varchar(50)
declare @tally_type varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @internal_account varchar(50)
declare @external_account varchar(50)
declare @counterparty varchar(50)
declare @quantity numeric(30,4)
declare @symbol varchar(50)
declare @value_date datetime
declare @price float
declare @trade_date datetime
declare @trader varchar(50)
declare @strategy varchar(50)
declare @broker varchar(50)
declare @sales_code varchar(50)
declare @identifier varchar(100)


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@source = "MPT"


select
	@queued_deal_id = 0

select
	@queued_deals = count(*)
from
	queued_deals
where
	batch_id = @batch_id
and
	queued_deal_id > @queued_deal_id

while @queued_deals > 0
begin
	select
		@queued_deal_id = min(queued_deal_id)
	from
		queued_deals
	where
		batch_id = @batch_id
	and
		queued_deal_id > @queued_deal_id

	select
		@deal_type = a.name,
		@deal_type_id = a.deal_type_id
	from
		deal_types a,
		queued_deals b
	where
		a.deal_type_id = b.deal_type_id
	and
		b.queued_deal_id = @queued_deal_id

	
	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,
			deal_type_id,
			timestamp,
			status_id)
	values(
		@deal_id,
		@deal_type_id,
		getdate(),
		1)

	select
		@queued_trade_id = 0
	select
		@queued_trades = count(*)
	from
		queued_trades
	where
		queued_deal_id = @queued_deal_id
	and
		queued_trade_id > @queued_trade_id

	while @queued_trades > 0
	begin
		select
			@queued_trade_id = min(queued_trade_id)
		from
			queued_trades
		where
			queued_deal_id = @queued_deal_id
		and
			queued_trade_id > @queued_trade_id

		select
			@trade_id = NULL

		select
			@tally_type = b.name,
			@internal_account = c.symbol,
			@external_account = d.symbol,
			@counterparty = e.name,
			@quantity = a.quantity,
			@trade_date = a.trade_date,
			@value_date = a.value_date,
			@price = a.price,
			@trader = f.symbol,
			@strategy = g.name,
			@broker = h.symbol,
			@user_name = i.login,
			@symbol = j.symbol,
			@identifier = identifier,
			@trade_type = k.name
		from
			queued_trades a,
			tally_types b,
			internal_accounts c,
			external_accounts d,
			counterparties e,
			traders f,
			strategies g,
			brokers h,
			tico_accounts i,
			contracts j,
			trade_types k
		where
			a.tally_type_id = b.tally_type_id
		and
			a.internal_account_id = c.internal_account_id
		and
			a.external_account_id = d.external_account_id
		and
			a.counterparty_id = e.counterparty_id
		and
			a.trader_id = f.trader_id
		and
			a.strategy_id = g.strategy_id
		and
			a.broker_id = h.broker_id
		and
			a.user_id = i.account_id
		and
			a.contract_id = j.contract_id
		and
			a.trade_type_id = k.trade_type_id
		and
			a.queued_trade_id = @queued_trade_id

		/* select
			deal_type = @deal_type,
			tally_type = @tally_type,
			internal_account = @internal_account,
			external_account = @external_account,
			counterparty = @counterparty,
			quantity = @quantity,
			trade_date = @trade_date,
			value_date = @value_date,
			price = @price,
			trader = @trader,
			strategy = @strategy,
			broker = @broker */

		exec
			fxa_tallytrade
				@login = @login,
				@source = @source,
				@trade_id = @trade_id output,
				@deal_id = @deal_id output,
				@tally_type = @tally_type,
				@deal_type = @deal_type,
				@trade_type = @trade_type,
				@internal_account = @internal_account,
				@external_account = @external_account,
				@counterparty = @counterparty,
				@quantity = @quantity,
				@symbol = @symbol,
				@value_date = @value_date,
				@price = @price,
				@trade_date = @trade_date,
				@trader = @trader,
				@strategy = @strategy,
				@broker = @broker,
				@sales_code = None,
				@identifier = @identifier
				
		/*  Commenting sending of trade to PB for now - WDD 11/22/17
		exec
			r_inserttradenotification 
				@trade_id
		*/

		select
			@queued_trades = count(*)
		from
			queued_trades
		where
			queued_deal_id = @queued_deal_id
		and
			queued_trade_id > @queued_trade_id

	end


	select
		@queued_deals = count(*)
	from
		queued_deals
	where
		batch_id = @batch_id
	and
		queued_deal_id > @queued_deal_id
end

select
	@batch_run_name = run_name
from
	batch_info
where
	batch_id = @batch_id

exec
	ag_optioncalendar
		@login = @login,
		@as_of_date = NULL,
		@expiration_name = @batch_run_name

	

go
