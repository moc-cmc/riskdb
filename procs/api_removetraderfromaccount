create or replace procedure
	api_removetraderfromaccount
		@login varchar(100),
		@trader varchar(50),
		@account varchar(100)


as

declare @tico_account_id int
declare @trader_id int
declare @external_account_id int
declare @trader_le_id int
declare @account_le_id int
declare @trader_le varchar(150)
declare @account_le varchar(150)
declare @remove_count int


select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @trader_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining trader",
		trader = @trader
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining external account",
		external_account = @account
	return
end


begin tran
	delete from
		external_account_traders
	where
		external_account_id = @external_account_id
	and
		trader_id = @trader_id
	
	select 
		@remove_count = @@rowcount
	
	if @remove_count > 1
	begin
		select
			status = "Error",
			message = "Trader not removed from account since delete rowcount did not match",
			trader = @trader,
			account = @account,
			remove_count = @remove_count
		rollback tran
		return
	end
commit tran

if @remove_count = 0
begin	
	select
		status = "Success",
		message = "Trader was not associated with account. Nothing to remove",
		trader = @trader,
		account = @account
end
if @remove_count = 1
begin
	select
		status = "Success",
		message = "Trader has been removed from to account",
		trader = @trader,
		account = @account
end


go
