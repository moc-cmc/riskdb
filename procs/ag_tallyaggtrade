use
	risk_edgewater_test
go

drop procedure
	ag_tallyaggtrade
go

create procedure
	ag_tallyaggtrade
		@login varchar(50),
		@batch_id int,
		@agg_group_id int,
		@contract_id int,
		@value_date datetime,
		@trade_date datetime,
		@quantity numeric(30,4),
		@price float,
		@tickets int,
		@trade_id int output,
		@deal_id int output
		
as

declare @tico_account_id int
declare @identifier varchar(50)
declare @trade_type_id int
declare @internal_account_id int
declare @external_account_id int
declare @counterparty_id int
declare @trader_id int
declare @strategy_id int
declare @status_id int
declare @broker_id int
declare @sales_code_id int
declare @trade_date datetime
declare @aggregated_status_id int
declare @agg_group varchar(50)
declare @validated char(1)
declare @deal_type_id int
declare @user_review_status_id int

declare @offset_trade_id int
declare @offset_identifier varchar(50)
declare @offset_quantity numeric(30, 4)
declare @offset_ext_account_id int
declare @offset_counterparty_id int
declare @offset_trader_id int
declare @book_offset char(1)



select
	@trade_id = NULL,
	@deal_id = NULL


select
	@aggregated_status_id = status_id
from
	statuses
where
	name = "Aggregated"
if @aggregated_status_id = NULL
begin
	select
		status = "Error",
		message = "Aggregated status not found"
	return
end

select
	@user_review_status_id = status_id
from
	statuses
where
	name = "User Review"
if @user_review_status_id = NULL
begin
	select
		status = "Error",
		message = "User Review status not found"
	return
end

select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = "Client Forward"
if @deal_type_id = NULL
begin
	select
		status = "Error",
		message = "Client Forward deal type not found"
	return
end

select
	@agg_group = name
from
	agg_groups
where
	agg_group_id = @agg_group_id

exec
       ag_validateagggroup
	       @agg_group = @agg_group,
	       @validated = @validated output,
	       @tally_user_id = @tico_account_id output,
	       @tally_trade_type_id = @trade_type_id output,
	       @tally_internal_account_id = @internal_account_id output,
	       @tally_external_account_id = @external_account_id output,
	       @tally_counterparty_id = @counterparty_id output,
	       @tally_trader_id = @trader_id output,
	       @tally_strategy_id = @strategy_id output,
	       @tally_status_id = @status_id output,
	       @tally_broker_id = @broker_id output,
	       @tally_sales_code_id = @sales_code_id output,
               @offset_ext_account_id = @offset_ext_account_id output,
               @offset_counterparty_id = @offset_counterparty_id output,
               @offset_trader_id = @offset_trader_id output

select
	@book_offset = "Y"

if (@offset_ext_account_id = NULL or @offset_counterparty_id = NULL or @offset_counterparty_id = NULL)
begin
	if (@offset_ext_account_id = NULL and @offset_counterparty_id = NULL and @offset_counterparty_id = NULL)
	begin
		select
			@book_offset = "N"
	end
	else
	begin
		select
			error="Error",
			msg = "An offset value is null when another offset value is pupulated. Can not tally agg or offset. Check aggregation group definition",
			offset_ext_account_id = @offset_ext_account_id,
			offset_counterparty_id = @offset_counterparty_id,
			offset_trader_id = @offset_trader_id
		return
	end
end

exec
	j_nextkey
		"deals",
		@deal_id output

exec
	j_nextkey
		"trades",
		@trade_id output
exec
	j_nextkey
		"trades",
		@offset_trade_id output

select
	@trade_date = getdate()

select
	@identifier = rtrim(convert(varchar(30), @trade_id)) +  " Agg Batch " + rtrim(convert(varchar(30), @batch_id))

select
	@offset_identifier = rtrim(@identifier)+" Offset",
	@offset_quantity = @quantity * -1


begin tran

	insert into
		deals(
			deal_id,
			deal_type_id,
			timestamp,
			status_id)
	values(
		@deal_id,
		@deal_type_id,
		getdate(),
		@user_review_status_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Deal tally failed",
			contract_id = @contract_id,
			value_date = @value_date,
			batch_id = @batch_id
		rollback tran
		return
	end
			

	insert into
		trades(
    			trade_id,
    			deal_id,
    			user_id,
    			trade_type_id,
    			internal_account_id,
    			external_account_id,
    			counterparty_id,
    			quantity,
    			contract_id,
    			value_date,
    			price,
    			trade_date,
    			trader_id,
    			strategy_id,
    			status_id,
    			broker_id,
    			sales_code_id,
    			identifier)
	values(
		@trade_id,
		@deal_id,
		@tico_account_id,
		@trade_type_id,
		@internal_account_id,
		@external_account_id,
		@counterparty_id,
		@quantity,
		@contract_id,
		@value_date,
		@price,
		@trade_date,
		@trader_id,
		@strategy_id,
		@status_id,
		@broker_id,
		@sales_code_id,
		@identifier)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not tally aggregated trade. No net tallied",
			contract_id = @contract_id,
			value_date = @value_date,
			batch_id = @batch_id
		rollback tran
		return
	end

	if @book_offset = "Y"
	begin
		insert into
			trades(
    				trade_id,
    				deal_id,
    				user_id,
    				trade_type_id,
    				internal_account_id,
    				external_account_id,
    				counterparty_id,
    				quantity,
    				contract_id,
    				value_date,
    				price,
    				trade_date,
    				trader_id,
    				strategy_id,
    				status_id,
    				broker_id,
    				sales_code_id,
    				identifier)
		values(
			@offset_trade_id,
			@deal_id,
			@tico_account_id,
			@trade_type_id,
			@internal_account_id,
			@offset_ext_account_id,
			@offset_counterparty_id,
			@offset_quantity,
			@contract_id,
			@value_date,
			@price,
			@trade_date,
			@offset_trader_id,
			@strategy_id,
			@status_id,
			@broker_id,
			@sales_code_id,
			@offset_identifier)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Could not tally aggregated trade offset. No net tallied",
				book_offset = @book_offset,
				contract_id = @contract_id,
				value_date = @value_date,
				batch_id = @batch_id
			rollback tran
			return
		end
	end

	/*update
		trades
	set
		a.status_id = @aggregated_status_id
	from
		trades a,
		batch_netting_trades b
	where
		a.trade_id = b.trade_id
	and
		b.batch_id = @batch_id
	and
		b.agg_group_id = @agg_group_id
	and
		sign(a.quantity) = sign(@quantity)
	if @@rowcount != @tickets
	begin
		select
			status = "Error",
			message = "Aggregated trade count match failed. No net tallied",
			contract_id = @contract_id,
			value_date = @value_date,
			batch_id = @batch_id
		rollback tran
		return
	end*/
	update
		batch_netting_trades
	set
		b.status_id = @aggregated_status_id
	from
		trades a,
		batch_netting_trades b
	where
		a.trade_id = b.trade_id
	and
		b.batch_id = @batch_id
	and
		b.agg_group_id = @agg_group_id
	and
		sign(a.quantity) = sign(@quantity)
	if @@rowcount != @tickets
	begin
		select
			status = "Error",
			message = "Update of batch_netting_trades failed. No net tallied",
			contract_id = @contract_id,
			value_date = @value_date,
			batch_id = @batch_id
		rollback tran
		return
	end
	update
		trades
	set
		a.status_id = @aggregated_status_id
	from
		trades a,
		batch_netting_trades b
	where
		a.trade_id = b.trade_id
	and
		b.batch_id = @batch_id
	and
		b.agg_group_id = @agg_group_id
	and
		sign(a.quantity) = sign(@quantity)
	if @@rowcount != @tickets
	begin
		select
			status = "Error",
			message = "Aggregated trade count match failed. No net tallied",
			contract_id = @contract_id,
			value_date = @value_date,
			batch_id = @batch_id
		rollback tran
		return
	end
commit tran


go

