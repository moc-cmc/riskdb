create or replace procedure
	api_approveoa
		@login varchar(50),
		@legal_entity varchar(150),
		@outside_account varchar(50)

as

declare @has_permission varchar(10)
declare @legal_entity_id int
declare @outside_account_id int
declare @existing_checksum varchar(200)
declare @pending char(1)
declare @checksum_user_id int


exec
	r_checkaccessgrouppermission
		@login=@login,
		@access_group="Wire Admin",
		@show_perm_denied = "N",
		@has_permission = @has_permission output

if @has_permission != "Y"
begin
	select
		status = "Error",
		message = "Permission denied"
	return
end

declare @tico_account_id int

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end


select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @@rowcount !=1
begin
	select
		status = "Error",
		message = "Could not find legal entity",
		legal_entity = @legal_entity
	return
end


declare @allow_creation_pending_only char(1)
select
	@allow_creation_pending_only = "N"

select
	@outside_account_id = outside_account_id,
	@pending = "Y"
from
	pending_outside_accounts
where
	name = @outside_account
and
	legal_entity_id = @legal_entity_id
if @outside_account_id = NULL 
begin
	if @allow_creation_pending_only = "N"
	begin
		select
			@outside_account_id = outside_account_id,
			@pending = "N"
		from
			outside_accounts
		where
			name = @outside_account
		and
			legal_entity_id = @legal_entity_id
	end
	if @outside_account_id = NULL
	begin
		select
			status = "Error",
			message = "Problem determining oa properties"
		return
	end
end

select
	@existing_checksum = checksum,
	@checksum_user_id = checksum_user_id
from
	outside_account_info
where
	outside_account_id = @outside_account_id

select
        @legal_entity = name
from
        legal_entities a,
	legal_entity_tico_accounts b
where
	a.legal_entity_id = b.legal_entity_id
and
        a.legal_entity_id = @legal_entity_id 
and
	b.tico_account_id = @tico_account_id
if @@rowcount !=1
begin
        select
                status = "Error",
                message = "Could not find legal entity or no permission",
                legal_entity = @legal_entity
        return
end



if @outside_account_id = NULL 
begin
	select
		status = "Error",
		message = "Access to account and legal entity denied"
	return
end

if @existing_checksum = NULL
begin
	select
		status = "Error",
		message = "Must have a checksum in order to approve"
	return
end

if @checksum_user_id = NULL
begin
	select
		status = "Error",
		message = "Missing user for checksum approval"
	return
end

if @checksum_user_id = @tico_account_id
begin
	select
		status = "Error",
		message = "Approval must be done by a different user than generated the checksum"
	return
end


begin tran
	if @pending = "Y"
	begin
		insert into
			outside_accounts(
				outside_account_id,
				outside_account_type_id,
				legal_entity_id,
				provider_id,
				name)
		select
			outside_account_id,
			outside_account_type_id,
			legal_entity_id,
			provider_id,
			name
		from
			pending_outside_accounts
		where
			outside_account_id = @outside_account_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem migrating pending account"
			rollback tran
			return
		end
		
		delete from
			pending_outside_accounts
		where
			outside_account_id = @outside_account_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem removing account after transitioning from pending"
			rollback tran
			return
		end
	end
	update
		outside_account_info
	set
		approval_user_id = @tico_account_id
	where
		outside_account_id = @outside_account_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem updating account info with approval usuer"
		rollback tran
		return
	end
commit tran


select
	status = "Success",
	message = "Successfully approved outside account",
	outside_account = @outside_account

go
