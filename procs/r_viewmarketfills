
if object_id("r_viewmarketfills") != NULL
    drop procedure
        r_viewmarketfills
go

create procedure
	r_viewmarketfills
		@login varchar(50),
		@symbol varchar(50),
		@value_date datetime,
		@trader varchar(50),
		@quantity numeric(30,4),
		@deal_id int = NULL
as

declare @contract_id int
declare @trader_id int
declare @net_quantity numeric(30,4)
declare @notional float
declare @price float

create table
	#meta(
		meta_type char(50),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"exclude",
	"Ungroup Trade From DealID",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"include",
	"Group Trade With New DealID",
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"new_deal_id",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		contract = @symbol
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Trader not found",
		trader = @trader
	return
end


create table
	#included_trades(
		style varchar(100) NULL,
		deal_id int NULL,
		trade_id int,
		trade_date datetime,
		contract_id int,
		value_date datetime,
		quantity numeric(30,4),
		price float,
		notional float NULL,
		exclude varchar(100) NULL)	
insert into
	#included_trades(
		deal_id,
		trade_id,
		trade_date,
		contract_id,
		value_date,
		quantity,
		price,
		notional,
		exclude)
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	a.contract_id,
	a.value_date,
	a.quantity,
	a.price,
	a.quantity *a. price,
	exclude = "EXCLUDE"
from
	trades a,
	deals b,
	deal_types c
where
	a.deal_id = b.deal_id
and
	b.deal_type_id = c.deal_type_id
and
	a.contract_id = @contract_id
and
	a.trader_id = @trader_id
and
	a.value_date = @value_date
and
	sign(a.quantity) = sign(@quantity)
and
	a.deal_id = @deal_id
and
	b.deal_id = @deal_id

create table
	#excluded_trades(
		style varchar(100) NULL,
		deal_id int NULL,
		trade_id int,
		trade_date datetime,
		contract_id int,
		value_date datetime,
		quantity numeric(30,4),
		price float,
		notional float NULL,
		include varchar(100) NULL,
		new_deal_id int)	
insert into
	#excluded_trades(
		deal_id,
		trade_id,
		trade_date,
		contract_id,
		value_date,
		quantity,
		price,
		notional,
		include,
		new_deal_id)
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	a.contract_id,
	a.value_date,
	a.quantity,
	a.price,
	a.quantity *a. price,
	exclude = case
			when
				@deal_id = NULL
			then
				"Start with this trade"
			else
				"Include"
	end,
	new_deal_id = case
			when
				@deal_id = NULL
			then
				a.deal_id
			else
				@deal_id
	end
from
	trades a,
	deals b,
	deal_types c
where
	a.deal_id = b.deal_id
and
	b.deal_type_id = c.deal_type_id
and
	a.contract_id = @contract_id
and
	a.trader_id = @trader_id
and
	a.value_date = @value_date
and
	sign(a.quantity) = sign(@quantity)
and
	c.name = "Market Forward"
and
	a.deal_id != @deal_id

insert into
	#excluded_trades(
		deal_id,
		trade_id,
		trade_date,
		contract_id,
		value_date,
		quantity,
		price,
		notional,
		include,
		new_deal_id)
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	a.contract_id,
	a.value_date,
	a.quantity,
	a.price,
	a.quantity *a. price,
	exclude = case
			when
				@deal_id = NULL
			then
				"Start with this trade"
			else
				"Include"
	end,
	new_deal_id = case
			when
				@deal_id = NULL
			then
				a.deal_id
			else
				@deal_id
	end
from
	trades a,
	deals b,
	deal_types c
where
	a.deal_id = b.deal_id
and
	b.deal_type_id = c.deal_type_id
and
	a.contract_id = @contract_id
and
	a.value_date = @value_date
and
	c.name = "Client Forward"
and
	a.deal_id != @deal_id


update
	#included_trades
set
	a.style = "background:#CCFF99"
from
	#included_trades a,
	trades b,
	external_accounts c,
	external_account_types d
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	c.external_account_type_id = d.external_account_type_id
and
	d.name = "Client"

update
	#excluded_trades
set
	a.style = "background:#FFFF99"
from
	#excluded_trades a,
	trades b,
	external_accounts c,
	external_account_types d
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	c.external_account_type_id = d.external_account_type_id
and
	d.name = "Counterparty"





select
	@net_quantity = sum(quantity),
	@notional = sum(notional)
from
	#included_trades

select
	@price = @notional / @net_quantity

select
	deal_id = @deal_id,
	symbol = @symbol,
	quantity = @net_quantity * -1.0,
	price = @price,
	tally_cient_trade = "TALLY CLIENT FILL"


select
	a.style,
	trader = @trader,
	a.deal_id,
	a.trade_id,
	a.trade_date,
	b.symbol,
	value_date = convert(varchar(11), a.value_date, 1),
	a.quantity,
	a.price,
	a.exclude
from
	#included_trades a,
	contracts b
where
	a.contract_id = b.contract_id
order by
	a.trade_date


select
	a.style,
	trader = @trader,
	a.deal_id,
	a.trade_id,
	a.trade_date,
	b.symbol,
	value_date = convert(varchar(11), a.value_date, 1),
	a.quantity,
	a.price,
	a.include,
	a.new_deal_id
from
	#excluded_trades a,
	contracts b
where
	a.contract_id = b.contract_id
order by
	a.trade_date


go
