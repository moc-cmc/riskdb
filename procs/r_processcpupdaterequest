        from
                archive_credit_profiles
        where
                credit_profile_id = @credit_profile_id
        if @max_timestamp = NULL
        begin
                select
                        @message = "Could not find last credit value to restore line"
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
