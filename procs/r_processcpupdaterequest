                                status = "Failed",
                                msg = @message,
                                new_dsl_limit = @dsl_limit,
                                prev_dsl_limit = @previous_dsl_limit

                        return
                end
        end

        select
                @dsl_limit = @previous_dsl_limit,
                @nop_limit = @previous_nop_limit

        exec
                r_updatecreditprofilelimit
                        @login=@login,
                        @credit_profile_name=@credit_profile_name,
                        @nop_limit=@nop_limit,
                        @dsl_limit=@dsl_limit,
                        @timestamp=@timestamp,
                        @successful_update=@successful_update output
        if @successful_update != "Y"
        begin
                select
                        @message = "Failed to update credit line"
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                values(
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @failed_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message
                )
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                msg = "Problem adding credit update request"
                        return
                end

                select
                        status = "Failed",
                        msg = @message
                return

        end
        else
        begin
                select
                        @message = "Updated nop credit line to " + cast(@nop_limit as varchar) + " and dsl credit line to " + cast(@dsl_limit as varchar)
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                values(
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @success_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message
                )
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                msg = "Problem adding credit update request"
                        return
                end

                select
                        status = "Success",
                        msg = @message
                return

        end

end
