        from
                archive_credit_profiles
        where
                credit_profile_id = @credit_profile_id
        and
                timestamp = @max_timestamp

        if @nop_limit != NULL
        begin
                if @previous_nop_limit != @nop_limit
                begin
                        select
                                @message = "Credit line restore amount does not match previously known amount"
                        exec
                                j_nextkey
                                        "credit_update_requests",
                                        @credit_update_request_id output
                        insert into
                                credit_update_requests(
                                        credit_update_request_id,
                                        credit_update_type_id,
                                        status_id,
                                        tico_account_id,
                                        timestamp,
                                        source_id,
                                        identifier,
                                        credit_profile_id,
                                        message)
                        values(
                                @credit_update_request_id,
                                @credit_update_type_id,
                                @failed_status_id,
                                @tico_account_id,
                                @timestamp,
                                @source_id,
                                @identifier,
                                @credit_profile_id,
                                @message
                        )
                        if @@rowcount != 1
                        begin
                                select
                                        status = "Error",
                                        msg = "Problem adding credit update request"
                                return
                        end

                        select
                                status = "Failed",
                                msg = @message,
                                new_nop_limit = @nop_limit,
                                prev_nop_limit = @previous_nop_limit

                        return
                end
        end

        if @dsl_limit != NULL
        begin
                if @previous_dsl_limit != @dsl_limit
                begin
                        select
                                @message = "Credit line restore amount does not match previously known amount"
                        exec
                                j_nextkey
                                        "credit_update_requests",
                                        @credit_update_request_id output
                        insert into
                                credit_update_requests(
                                        credit_update_request_id,
                                        credit_update_type_id,
                                        status_id,
                                        tico_account_id,
                                        timestamp,
                                        source_id,
                                        identifier,
                                        credit_profile_id,
                                        message)
                        values(
                                @credit_update_request_id,
                                @credit_update_type_id,
                                @failed_status_id,
                                @tico_account_id,
                                @timestamp,
                                @source_id,
                                @identifier,
                                @credit_profile_id,
                                @message
                        )
                        if @@rowcount != 1
                        begin
                                select
                                        status = "Error",
                                        msg = "Problem adding credit update request"
                                return
                        end

