create or replace procedure
	r_processcpupdaterequest
		@login varchar(50),
                @source varchar(100),
		@name varchar(50),
                @request_type varchar(25),
                @identifier varchar(100),
                @pb varchar(50),
                @timestamp datetime=NULL,
		@nop_limit numeric(30,4)=NULL,
		@dsl_limit numeric(30,4)=NULL,
                @return_on_restore_failed_mapping varchar(1)="N"

as

declare @credit_profile_name varchar(50)
declare @credit_update_type_id int
declare @credit_profile_id int
declare @failed_status_id int
declare @success_status_id int
declare @tico_account_id int
declare @source_id int
declare @credit_update_request_id int
declare @message varchar(100)
declare @previous_nop_limit numeric(30,4)
declare @previous_dsl_limit numeric(30,4)
declare @has_credit_profile_access varchar(1)
declare @max_timestamp datetime
declare @successful_update varchar(1)
declare @is_duplicate varchar(1)
declare @line_already_pulled varchar(1)
declare @line_already_restored varchar(1)
declare @credit_profile_symbol varchar(100)

select
        @credit_profile_symbol = rtrim(@pb)+"-"+rtrim(@name)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		msg = "Unable to resolve login",
                login = @login
	return
end

select
        @source_id = source_id
from
        sources
where
        name = @source
if @source_id = NULL
begin
        select
                status = "Error",
                msg = "Unable to find source",
                source = @source
        return
end

select
        @is_duplicate = "Y"
from
        credit_update_requests
where
        source_id = @source_id
and
        identifier = @identifier
if @is_duplicate = "Y"
begin
        select
                @credit_update_request_id = credit_update_request_id
        from
                credit_update_requests
        where
                source_id = @source_id
        and
                identifier = @identifier

        select
                status = "Dupe",
                msg = "Already processed",
                identifier = @identifier,
                credit_update_request_id = @credit_update_request_id
        return
end

select
        @failed_status_id = status_id
from
        statuses
where
        name = "Failed"
if @failed_status_id = NULL
begin
        select
                status = "Error",
                msg = "Failed status not found"
        return
end
select
        @success_status_id = status_id
from
        statuses
where
        name = "Success"
if @success_status_id = NULL
begin
        select
                status = "Error",
                msg = "Success status not found"
        return
end

if @timestamp = NULL
begin
        select
                @timestamp = getdate()
end

select
	@credit_update_type_id = credit_update_type_id
from
	credit_update_types
where
	name = @request_type
if @credit_update_type_id = NULL
begin
	select
		status = "Error",
		msg = "Credit update type not found",
		credit_update = @request_type
	return
end

select 
        @credit_profile_id = credit_profile_id
from
        credit_profile_symbols
where
        source_id = @source_id
and
        symbol = @credit_profile_symbol
if @credit_profile_id = NULL
begin
        if @return_on_restore_failed_mapping = "Y"
        begin
                if @request_type in("Restore","Restore NOP","Restore DSL")
                begin
                        select
                                 status = "Error",
                                 msg = "No credit profile mapping for mapping value '" + rtrim(@credit_profile_symbol) + "'"
                        return
                end
        end

        select
                @message = "No credit profile mapping for mapping value '" + rtrim(@credit_profile_symbol) + "'"
        exec
	        j_nextkey
		        "credit_update_requests",
		        @credit_update_request_id output
	insert into
		credit_update_requests(
			credit_update_request_id,
                        credit_update_type_id,
                        status_id,
                        tico_account_id,
                        timestamp,
                        source_id,
                        identifier,
                        message)
	values(
		@credit_update_request_id,
                @credit_update_type_id,
                @failed_status_id,
                @tico_account_id,
                @timestamp,
                @source_id,
                @identifier,
                @message
        )
        if @@rowcount != 1
        begin
                select
                        status = "Error",
                        msg = "Problem adding credit update request"
                return
        end

        select
                status = "Failed",
                msg = @message

        return
end

select 
        @has_credit_profile_access = "Y"
from
        user_credit_profiles
where
        user_id = @tico_account_id
and
        credit_profile_id = @credit_profile_id
    
if @has_credit_profile_access != "Y"
begin
        select
                @message = "No access to modify credit profile"
        exec
                j_nextkey
                        "credit_update_requests",
                        @credit_update_request_id output
        insert into
                credit_update_requests(
                        credit_update_request_id,
                        credit_update_type_id,
                        status_id,
                        tico_account_id,
                        timestamp,
                        source_id,
                        identifier,
                        credit_profile_id,
                        message)
        values(
                @credit_update_request_id,
                @credit_update_type_id,
                @failed_status_id,
                @tico_account_id,
                @timestamp,
                @source_id,
                @identifier,
                @credit_profile_id,
                @message
        )
        if @@rowcount != 1
        begin
                select
                        status = "Error",
                        msg = "Problem adding credit update request"
                return
        end

        select
                status = "Failed",
                msg = @message

        return
end

select
        @credit_profile_name = name
from
        credit_profiles
where
        credit_profile_id = @credit_profile_id

if @request_type = "Pull"
begin

        select
                @line_already_pulled = "Y"
        from 
                credit_profiles
        where
                credit_profile_id = @credit_profile_id
        and
                nop_limit = 0
        and
                dsl_limit = 0
        if @line_already_pulled = "Y"
        begin
		select
                        @message = "Failed to update credit line: credit line already pulled"
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                values(
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @failed_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message
                )
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                msg = "Problem adding credit update request"
                        return
                end

                select
                        status = "Failed",
                        msg = @message
                return
        end

        exec 
                r_updatecreditprofilelimit
                        @login=@login,
                        @credit_profile_name=@credit_profile_name,
                        @nop_limit=0,
                        @dsl_limit=0,
                        @timestamp=@timestamp,
                        @successful_update=@successful_update output
        if @successful_update != "Y"
        begin
                select
                        @message = "Failed to update credit line"
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                values(
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @failed_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message
                )
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                msg = "Problem adding credit update request"
                        return
                end

                select
                        status = "Failed",
                        msg = @message
                return

        end
        else
        begin
                select
                        @message = "Updated credit line to 0"
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                values(
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @success_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message
                )
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                msg = "Problem adding credit update request"
                        return
                end

                select
                        status = "Success",
                        msg = @message
                return

        end
end
else if @request_type = "Restore"
