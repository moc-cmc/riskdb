drop procedure r_addagggroupcounterparty
go

create procedure
	r_addagggroupcounterparty
		@login varchar(50),
		@agg_group varchar(50),
		@counterparty varchar(50)

as

declare @agg_group_id int
declare @counterparty_id int

select
	@agg_group_id = agg_group_id
from
	agg_groups
where
	name=@agg_group
if @agg_group_id = NULL
begin
	select
		error="Error",
		msg="Aggregation Group not found", @agg_group
	return
end

select
        @counterparty_id = counterparty_id
from
        counterparties
where
        name=@counterparty
if @counterparty_id = NULL
begin
        select
                error="Error",
                msg="counterparty not found", @counterparty
        return
end


insert into
	agg_group_counterparties(
		agg_group_id,
		counterparty_id)
values(
	@agg_group_id,
	@counterparty_id
)
if @@rowcount != 1
begin
	select
		status = "Error adding conterparty to aggregation group",
		agg_group = @agg_group,
		counterparty = @counterparty
	return
end

select
	status = "Successfully created added counterparty to aggregation group",
	agg_group = @agg_group,
	counterparty = @counterparty


go

	
