
create or replace procedure
	api_addpendingtransaction
		@login varchar(100),
		@external_account varchar(50),
		@transaction_type varchar(50),
		@transaction_date datetime,
		@product varchar(50),
		@amount float,
		@status varchar(50)=NULL,
		@ledger_request_id int=NULL,
		@note varchar(255)=NULL
as


declare @tico_account_id int
declare @transaction_type_id int
declare @account_transaction_id int
declare @external_account_id int
declare @product_id int
declare @status_id int
declare @timestamp datetime

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "External account not found",
		external_account = @external_account
	return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = @transaction_type
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Transaction type not found",
		transaction_type = @transaction_type
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

if @status = NULL
begin
	select
		@status = "New"
end
select
	@status_id = status_id
from
	statuses
where
	name = @status
if @status_id = NULL
begin
	select
		status = "Error",
		msg = "Unable to find id for status provided",
		status_provided = @status
	return
end

if @ledger_request_id != NULL
begin
	if not exists(select ledger_request_id from ledger_requests where ledger_request_id = @ledger_request_id)
	begin
		select
			status = "Error",
			message = "Unable to find ledger request for provided ledger_request_id",
			ledger_request_id = @ledger_request_id
		return
	end
end

select
	@timestamp = convert(date, getdate())

/* pending_transactions takes an ID from account_transactions
 * because we fully intend to book a pending_transaction into
 * account_transactions. They are essentially one and the same 
 * except that account_transactions do not have a status_id 
 * because they are considered cash
 */
exec
	j_nextkey
		"account_transactions",
			@account_transaction_id output

begin tran
	insert into
		pending_transactions(
			account_transaction_id,
			entered_by,
			external_account_id,
			transaction_type_id,
			transaction_date,
			currency_id,
			amount,
			create_date,
			status_id,
			ledger_request_id,
			note)
	values(
		@account_transaction_id,
		@tico_account_id,
		@account_transaction_id,
		@transaction_type_id,
		@timestamp,
		@product_id,
		@amount,
		getdate(),
		@status_id,
		@ledger_request_id,
		@note)
	if @@rowcount != 1
	begin 
		select
			status = "Error",
			messsage = "Unable to book pending transaction",
			account_transaction_id = @account_transaction_id,
                	account = @external_account,
                	transaction_type = @transaction_type,
                	transaction_date = @transaction_date,
                	product = @product,
                	amount = @amount,
                	transaction_status = @status,
                	ledger_request_id = @ledger_request_id
		rollback tran
		return
	end
commit tran

select
	status = "Success",
	msg = "Booked pending transaction",
	account_transaction_id = @account_transaction_id,
	account = @external_account,
	transaction_type = @transaction_type,
	transaction_date = @transaction_date,
	product = @product,
	amount = @amount,
	transaction_status = @status,
	ledger_request_id = @ledger_request_id


go 

