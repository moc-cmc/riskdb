
if object_id("r_contractproducttype") != NULL
    drop procedure
        r_contractproducttype
go
 
create procedure
	r_contractproducttype
		@contract_id int,
		@product_type_id int output
as

declare @product_id int

exec
	r_contractproduct
		@contract_id,
		@product_id output

select
	@product_type_id = product_type_id
from
	products
where
	product_id = @product_id


go
