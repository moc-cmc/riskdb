drop procedure cbo_commitstatus
go

create procedure
	cbo_commitstatus
		@login varchar(50)

as

declare @last_commit_date datetime
declare @today datetime
declare @yesterday datetime
declare @commit_status varchar(200)


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select
	@today = convert(date, getdate())

exec
	r_prevbusinessday
		@today,
		@yesterday output


select 
	@last_commit_date = max(reval_date)
from
	committed_daily_revals

select
	@commit_status = "<b><font color='00CC00'>Data Committed to Date</font></b>"

if convert(date, @yesterday) != convert(date, @last_commit_date)
	select
		@commit_status = "<b><font color='FF0000'>Data Not Committed to Date</font></b>"

select * from #meta

select
	section = "Commit Status",
	msg = "Data has been committed through <b>"+convert(varchar(11), convert(date, @last_commit_date), 100)+"</b>",
	commit_status = @commit_status,
	style = "background:#FFFFFF;border: 1px solid white"

go

