drop procedure r_addcreditprofilecounterparty
go

create procedure
	r_addcreditprofilecounterparty
		@login varchar(50),
		@credit_profile varchar(50),
		@counterparty varchar(50)

as

declare @credit_profile_id int
declare @counterparty_id int

select
	@credit_profile_id = credit_profile_id
from
	credit_profiles
where
	name=@credit_profile
if @credit_profile_id = NULL
begin
	select
		error="Error",
		msg="Credit profile not found", @credit_profile
	return
end

select
        @counterparty_id = counterparty_id
from
        counterparties
where
        name=@counterparty
if @counterparty_id = NULL
begin
        select
                error="Error",
                msg="counterparty not found", @counterparty
        return
end


insert into
	credit_profile_counterparties(
		credit_profile_id,
		counterparty_id)
values(
	@credit_profile_id,
	@counterparty_id
)
if @@rowcount != 1
begin
	select
		status = "Error adding conterparty to credit profile",
		credit_profile = @credit_profile,
		counterparty = @counterparty
	return
end

select
	status = "Successfully created added counterparty to credit profile",
	credit_profile = @credit_profile,
	counterparty = @counterparty

exec
	r_viewcreditprofile
		@login,
		@credit_profile

go

	
