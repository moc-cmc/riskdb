use
	risk_walrus
go

if object_id("x_impliedratefromforward") != NULL
    drop procedure
        x_impliedratefromforward
go

create procedure
	x_impliedratefromforward
		@login char(30),
		@as_of datetime=NULL,
		@symbol char(50),
		@spot_price float,
		@forward_date datetime,
		@forward_price float,
		@get_product_id int output,
		@get_product_rate float output,
		@days float output

as

declare @contract_id int
declare @give_product_id int
declare @give_product_rate float
declare @hours int


if @as_of = NULL
	select
		@as_of = getdate()

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract with symbol",
		symbol = @symbol
	return
end

select
	@hours = convert(float, datediff(hour, @as_of, @forward_date))

select
	@days = @hours / 24.0

exec
	r_contractproduct
		@contract_id,
		@get_product_id output
exec
	r_contractcurrency
		@contract_id,
		@give_product_id output

exec
	r_rateasof
		@give_product_id,
		@as_of,
		@forward_date,
		@give_product_rate output

/* select
	days = @days, forward_price = @forward_price, spot_price = @spot_price, give_product_rate = @give_product_rate
*/
select
	@get_product_rate = ((360.0/@days * log(@forward_price/@spot_price)) - @give_product_rate) * -1.0


return

go
