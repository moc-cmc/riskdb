if object_id("r_importfutoptexpiration") != NULL
    drop procedure
        r_importfutoptexpiration
go

create procedure
	r_importfutoptexpiration
		@source varchar(50),
		@underlying_symbol varchar(50),
		@exchange varchar(50),
		@exercise_style varchar(50),
		@quantity int,
		@tick_size float,
		@expiration_symbol varchar(50),
		@expiration datetime
as

declare @status_id int
declare @source_id int
declare @underlying_contract_id int
declare @exchange_id int
declare @exercise_style_id int
declare @option_id int
declare @option_expiration_id int
declare @timezone_id int

select
	@timezone_id = 1

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount = 0
begin
	select
		@status_id = status_id
	from
		statuses
	where
		name = "Active"
	if @status_id = NULL
	begin
		exec
			j_nextkey
				"statuses",
				@status_id output

		insert into
			statuses
		values(
			@status_id,
			"Active")
	end

	exec
		j_nextkey
			"sources",
			@source_id output

	insert into
		sources
	values(
		@source_id,
		@source,
		@status_id)
end

select
	@option_expiration_id = option_expiration_id
from
	option_expiration_symbols
where
	symbol = @expiration_symbol
if @option_expiration_id != NULL
begin
	return
end

select
	@underlying_contract_id = contract_id
from
	contract_symbols
where
	source_id = @source_id
and
	symbol = @underlying_symbol
if @underlying_contract_id = NULL
begin
	select
		status = "Error",
		message = "Underlying contract not found",
		underlying_contract = @underlying_symbol
	return
end

select
	@exchange_id = exchange_id
from
	exchanges
where
	name = @exchange
if @@rowcount != 1
begin
	exec
		j_nextkey
			"exchanges",
			@exchange_id output

	insert into
		exchanges
	values(
		@exchange_id,
		@exchange)
end

select
	@exercise_style_id = exercise_style_id
from
	exercise_styles
where
	name = @exercise_style
if @@rowcount = 0
begin
	exec
		j_nextkey
			"exercise_styles",
			@exercise_style_id output

	insert into
		exercise_styles
	values(
		@exercise_style_id,
		@exercise_style)
end

select
	@option_id = option_id
from
	options
where
	underlying_contract_id = @underlying_contract_id
and
	exchange_id = @exchange_id
and
	def_exercise_style_id = @exercise_style_id
and
	quantity = @quantity
and
	tick_size = @tick_size
if @option_id = NULL
begin
	exec
		j_nextkey
			"options",
			@option_id output

	insert into
		options
	values(
		@option_id,
		@underlying_contract_id,
		@exchange_id,
		@exercise_style_id,
		@quantity,
		@tick_size)
end

exec
	j_nextkey
		"option_expirations",
		@option_expiration_id output

insert into
	option_expirations
values(
	@option_expiration_id,
	@option_id,
	@expiration_symbol,
	@expiration,
	@timezone_id)
	
insert into
	option_expiration_symbols
values(
	@option_expiration_id,
	@source_id,
	@expiration_symbol)


go
