use
	risk_qson
go

drop procedure
	uat_createtesttradesbnp
go

create procedure
	uat_createtesttradesbnp
		@login varchar(50)

as

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)
declare @usdjpy_price float

create table
	#symbols(
		id int identity,
		type varchar(50) NULL,
		symbol varchar(50))
insert into
	#symbols(
		symbol)
select
	symbol
from
	contracts
where
	symbol in(
		"EURUSD",
		"USDJPY",
		"GBPUSD",
		"AUDUSD",
		"USDCAD",
		"USDCHF",
		"EURCHF",
		"EURJPY",
		"EURGPB",
		"EURAUD",
		"EURCAD",
		"GBPJPY",
		"AUDJPY",
		"CADJPY",
		"CHFJPY",
		"AUDCAD",
		"USDBRL",
		"JPYUSD")

update
	#symbols
set
	type = "NDF"
where
	symbol = "USDBRL"

update
	#symbols
set
	type = "Unconventional"
where
	symbol = "JPYUSD"

select
	@usdjpy_price = a.price
from
	current_prices a,
	contracts b
where
	a.contract_id = b.contract_id
and
	b.symbol = "USDJPY"

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"old_value_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"create_fwd",
	"UAT Create Forward Trade BNP",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"create_swap",
	"UAT Create Swap Trade BNP",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"create_spot",
	"UAT Create Spot Trade BNP",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	"#,##0.000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"



select
	style = @style,
	b.symbol,
	c.type,
	price = case
		when
			b.symbol != "JPYUSD" then convert(numeric(30,6), a.price)
		else
			convert(numeric(30,6), @usdjpy_price)
	end,
	create_spot = case 
			when
				c.type != "NDF" or c.type = NULL then "CREATE SPOT TRADE"
			else
				NULL
	end,
	create_fwd = "CREATE FORWARD TRADE",
	create_swap = "CREATE SWAP TRADE"
from
	current_prices a,
	contracts b,
	#symbols c
where
	a.contract_id =* b.contract_id
and
	b.symbol = c.symbol
order by
	c.type,
	b.symbol


	
	


go
