
drop procedure
	r_checknewpassword

go

create procedure r_checknewpassword @login varchar(25), 
				 @password varchar(30),
				 @message  varchar(250) output,
				 @isValid  varchar(1) output 

as

declare @passlen int

/* verify length */

select
        @passlen = len(@password)

if(@passlen > 20)
begin
        select
		@message = "Password too long. Twenty character maximum.",
		@isValid = "N"

        return
end

if((@passlen = NULL) or (@passlen < 1))
begin
        select
               	@message = "New password cannot be blank.", 
		@isValid = "N"

        return
end

select
	@message = "Password is good.", 
	@isValid = "Y"


go

