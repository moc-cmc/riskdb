
if object_id("tt_cognotectally") != NULL
    drop procedure
        tt_cognotectally
go

create procedure
	tt_cognotectally
       		@agent varchar(50),
       		@source varchar(50),
       		@client_source varchar(50),
       		@executing_firm varchar(50),
       		@contra_firm varchar(50),
       		@sponsoring_firm varchar(50), /* sometimes NULL */
       		@trade_date datetime,
       		@trading_day datetime,
       		@trade_report_id varchar(50),
       		@order_id varchar(50),
       		@client_order_id varchar(50),
       		@execution_id varchar(50),
       		@symbol varchar(50),
       		@ccy1 varchar(10),
       		@ccy2 varchar(10),
       		@value_date datetime,
       		@side varchar(10),
       		@qty1 float,
       		@price float


as

declare @source_id int
declare @internal_account_id int
declare @trader_id int
declare @tico_account_id int
declare @external_account_id int
declare @deal_id int
declare @trade_id int
declare @external_account_type varchar(30)
declare @trade_identifier varchar(50)
declare @trade_symbol varchar(50)
declare @contract_id int
declare @strategy_id int
declare @status_id int
declare @broker_id int
declare @broker_symbol varchar(50)
declare @trade_status_id int
declare @trade_symbol_id int
declare @notification_source varchar(50)
declare @notification_source_id int
declare @active_status_id int
declare @msg varchar(200)

/* IOC support */
declare @source2 varchar(50)
declare @source2_id int
declare @trade_symbol2 varchar(50)
declare @trade_symbol2_id int

select
	@notification_source = "BOA Traiana FTP"

select
	@notification_source_id = source_id
from
	sources
where
	name = @notification_source
if @notification_source_id = null
begin
	select
		status = "Error",
		message = "Notification source not found",
		notification_source =@notification_source
	return
end

select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Active status not found"
	return
end


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @agent
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Login not found",
		login = @agent
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
        status = "Error",
		message = "Source not found",
		source = @source
	return
end

/* 
 * IOC support: We need a second source to store two separate trade_symbols for
 * a deal. One will be stored under @source, the other one under @source2.
 */
select
    @source2 = @source + " Order"

select
	@source2_id = source_id
from
	sources
where
	name = @source2
if @@rowcount != 1
begin
	select
        status = "Error",
		message = "Source not found",
		source = @source2
	return
end

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @client_source
if @@rowcount != 1
begin
	select
		status = "Error",
		message= "Internal account not found",
		internal_account = @client_source
	return
end

select 
	@trader_id = b.trader_id,
	@external_account_id = b.external_account_id
from
	trader_symbols a,	
	traders b
where 
	a.trader_id = b.trader_id and
	a.symbol = @contra_firm


if @trader_id = NULL
begin
	select
		@trader_id = trader_id,
		@external_account_id = external_account_id	
	from
		traders
	where
		symbol = @contra_firm
	if @@rowcount != 1
	begin
		exec
			j_nextkey
				"traders",
				@trader_id output
	
		insert into
			traders
		values(
			@trader_id,
			@contra_firm,
			0,
			7,
			NULL,
			NULL)
    
		select
			@msg = "Trade capture failed for trader: " + rtrim(@contra_firm)
		exec
			cn_addmessage
				@agent,
				@msg,
				@msg
	
	end
end



if @external_account_id = NULL
begin

    declare @issue varchar(250)
    declare @subject varchar(250)
    declare @content varchar(250)
    
    select
        @issue = "data:traders(symbol=" + @contra_firm + ").external_account_id",
        @subject = "Account for trader, '" + @contra_firm + "', needs to be assigned",
        @content = "There is no account assigned for the trader, '" + @contra_firm + "'. There are trades waiting for this mapping before it can proceed"
    
    exec
        r_manageissue
            @agent,
            "Support",
            "Front Office",
            @issue,
            @subject,
            @content,
            "High",
            NULL,
            "exec fxpb_checkaccounts"
     
	select
		status = "Error",
		message = "Account for trader needs to be assigned",
		trader = @contra_firm
	return
end

select
	@external_account_type = a.name
from
	external_account_types a,
	external_accounts b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.external_account_id = @external_account_id

if @external_account_type = "Client"
begin
	select
		@trade_identifier = rtrim(@execution_id) + ".C"
end
if @external_account_type = "Counterparty"
begin
    select
		@trade_identifier = rtrim(@execution_id) + ".M"
end

if @trade_identifier = NULL
begin
	select
		status = "Error",
		message = "Account type is not Client or Counterparty"
	return
end

/* 
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @ccy1 != NULL and @ccy2 != NULL and @symbol = @ccy2 + @ccy1
begin
    select
        @symbol = @ccy1 + @ccy2,
        @price = 1 / @price
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

/* --------------------------------------------------------------,
| Check to see if trader is in equity_val_date_traders           |
|	if yes --> check to see if contract is in equity_value_dates |
|			if yes --> override value_date						 |
|			if no --> send message								 |
|	if no --> Use value date FD provides						 |
|																 |
'---------------------------------------------------------------*/

if exists (select * from equity_value_date_traders where trader_id = @trader_id)
begin
	if exists (select * from equity_value_dates where contract_id = @contract_id)
	begin
			select
					@value_date = value_date
			from
					equity_value_dates
			where
					contract_id = @contract_id
			select
					id = 1,
					msg = "Updating value date for trader ",
					val_date = @value_date,
					fd_trader = @contra_firm,
					trader_id = @trader_id
	end
	else
	begin
		select
				id = "ERROR",
				msg = "No default value date set for contract for valdate trader"
	end
end	


select
    @broker_symbol = upper(@source)

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker_symbol
if @@rowcount != 1
begin
	exec
		j_nextkey
			"brokers",
			@broker_id output
	insert into
		brokers
	values(
		@broker_id,
		@broker_symbol,
		100)
end

select
	@trade_status_id = 1,
	@strategy_id = 1

select
	@trade_id = trade_id
from
	trade_identifiers
where
	identifier = @trade_identifier
if @trade_id !=NULL
begin
	select
		status = "Dupe",
		message = "Trade is already tallied",
		trade_identifier = @trade_identifier
	return
end

if lower(rtrim(@side)) = "sell"
begin
	select
		@qty1 = abs(@qty1) * -1.0
end
else
begin
	select
		@qty1 = abs(@qty1)
end

/*
 * FIND @trade_symbol: We will handling IOC Street Fills and IOC Client Netted
 * Trades differently than Regular Trades. Here's how it works:
 *
 * Type               @execution_id             @order_id
 *                    @client_order_id          -> @trade_symbol
 * ---------------------------------------------------------------------------
 * 
 * Regular Trade #1   9IQ41WFn4BGASKCPSshD9gA   gjkK1WFn4BGoraCPSshD9gA
 *                    A27d3c71cbaf87e           -> "9IQ41WFn4BGASKCPSshD9gA"
 * 
 * Regular Trade #2   9IQ41WFn4BGASKCPSshD9gA   gjkK1WFn4BGoraCPSshD9gA
 *                    240602-1                  -> "9IQ41WFn4BGASKCPSshD9gA"
 * 
 * IOC Street Fills   MUX5:LM004-4536-1         MUX5:LM004-4536-1
 *                    4536-1                    -> "4536"
 *     Determined by seeing if the @client_order_id is a suffix of @execution_id
 *     and if the @client_order_id fits the pattern of "\d+-\d+".
 * 
 * IOC Client Trades  4536                      4536
 *                    1302109416315:2           -> "4536"
 *     Determined by seeing if @execution_id is the same as @client_order_id and
 *     if the @client_order_id is numeric.
 */

select
    @trade_symbol = @execution_id

if @client_order_id not like "%[^0-9-]%" and @client_order_id like "[0-9]%[0-9]"
begin
    select
        @trade_symbol2 = substring(@client_order_id, 1, charindex('-', @client_order_id) - 1)
end

/* First, match by @execution_id */
select
	@deal_id = deal_id
from
	trade_symbols
where
	source_id = @source_id
and
	symbol = @trade_symbol

if @deal_id = NULL
begin

    /* If no match, match by stripped @client_order_id */
    select
        @deal_id = deal_id
    from
        trade_symbols
    where
        source_id = @source2_id
    and
        symbol = @trade_symbol2

end

if @deal_id = NULL
begin
	select
		msg = "Creating new deal"

	exec
		j_nextkey
			"deals",
			@deal_id output

    /* Store @execution_id symbol */
    exec
		j_nextkey
			"trade_symbols",
			@trade_symbol_id output
	insert into
		trade_symbols
	values(
		@trade_symbol_id,
		@source_id,
		@deal_id,
		@trade_symbol,
		getdate())
    
    if @trade_symbol2 != NULL
    begin
        
        /* Store stripped @client_order_id symbol */
        exec
            j_nextkey
                "trade_symbols",
                @trade_symbol2_id output

        insert into
            trade_symbols
        values(
            @trade_symbol2_id,
            @source2_id,
            @deal_id,
            @trade_symbol2,
            getdate())
        
    end
    
end
else
begin
	select
		msg = "Appending to existing deal"
end
		


exec
	j_nextkey
		"trades",
		@trade_id output

insert into
	trades
values(
	@trade_id,
	@deal_id,
	@tico_account_id,
	@internal_account_id,
	@external_account_id,
	@qty1,
	@contract_id,
	@price,
	@trade_date,
	@trader_id,
	@strategy_id,
	@trade_status_id,
	@broker_id)

insert into
	trade_value_dates
values(
	@trade_id,
	@value_date)

insert into
	trade_types
values(
	@trade_id,
	"S")

insert into
	trade_identifiers
values(
	@trade_id,
	@source_id,
	@trade_identifier)

insert into
	trade_notifications(
		source_id,
		trade_id,
		status_id,
		capture_date)
values(
	@notification_source_id,
	@trade_id,
	@active_status_id,
	getdate())


select
	status = "Tallied",
	message = "Trade successfully tallied",
    trade_id = @trade_id,
    deal_id = @deal_id,
	account = @contra_firm,
	symbol = @symbol,
	side = @side,
	quantity = @qty1,
	price = @price,
	val_date = @value_date

go
