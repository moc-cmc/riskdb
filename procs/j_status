
if object_id("j_status") != NULL
    drop procedure
        j_status
go

create procedure
	j_status
		@name char(200) output,
		@status_id int output
as

if @name != NULL
	select
		@status_id = status_id
	from
		statuses
	where
		name = @name
else
	select
		@name = name
	from
		statuses
	where
		status_id = @status_id

return

go
