use
	risk_ram
go

drop procedure
	mn_unallocatedeal
go


create procedure
	mn_unallocatedeal
		@login varchar(50),
		@run_name varchar(50)=NULL,
		@deal_id int


as

declare @status_id int
declare @trade_id int


select
	@status_id = status_id
from
	statuses
where
	name = "User Review"


create table
	#sub_account_trades(
		trade_id int)
create table
        #master_account_trade(
                trade_id int)

insert into
	#master_account_trade
select
        a.trade_id
from
        trades a,
        master_allocations b,
        ma_versions c,
        deal_ma_versions d
where
        a.external_account_id = b.external_account_id
and
        b.master_allocation_id = c.master_allocation_id
and
        c.ma_version_id = d.ma_version_id
and
        a.deal_id = d.deal_id
and
	a.deal_id = @deal_id
and
	d.deal_id = @deal_id

	
insert into
	#sub_account_trades
select
	a.trade_id
from
	trades a,
	sub_accounts b,
	deal_ma_versions c
where
	a.external_account_id = b.external_account_id
and
	a.deal_id = @deal_id
and
	a.deal_id = c.deal_id
and
	b.ma_version_id = c.ma_version_id



/*
* Perform actions to unallocate *
*/

declare allocations_cursor cursor for
	select
		trade_id
	from
		#sub_account_trades

open allocations_cursor
fetch allocations_cursor into @trade_id

while @@sqlstatus = 0
begin

	exec
		tt_deletetradenomsg
			@trade_id,
			"N"

	fetch allocations_cursor into @trade_id

end

close allocations_cursor
deallocate allocations_cursor


update
	trades
set
	a.quantity = b.orginal_quantity
from
	trades a,
	deal_ma_versions b,
	#master_account_trade c
where
	a.deal_id = b.deal_id
and
	a.trade_id = c.trade_id


delete from
	deal_ma_versions
where
	deal_id = @deal_id


update
	deals
set
	status_id = @status_id
where
	deal_id = @deal_id




exec
        mn_accounttrades
                @login,
                @run_name



go
