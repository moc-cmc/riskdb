
create or replace procedure
	cm_addprimebroker
		@login varchar(50),
		@name varchar(100),
		@external_account varchar(50) 
as

declare @prime_broker_id int
declare @source_id int
declare @bo_external_account_id int
declare @run_id int
declare @mkt_external_account_id int
declare @prime_broker_source_id int
declare @status_id int
declare @margin_model_id int

select
	@prime_broker_source_id = source_type_id
from
	source_types
where
	name="Prime Broker"

if @@rowcount != 1
begin
	select
		status="Warning",
		message="Could not find Prime Broker Source Type, creating Prime Broker Type",
		source_type="Prime Broker"

	declare @source_type_id int
	
	exec j_nextkey "source_types", @source_type_id out

	insert into
		source_types (
		source_type_id,
		name)
	values (
		@source_type_id,
		"Prime Broker")

	if @@rowcount !=1
	begin
		select
			status="Error",
			message="Could not create source type",
			source_type="Prime Broker"

		return
	end

	select @prime_broker_source_id=@source_type_id
	
end

select
	@source_id=source_id
from
	sources
where
	name=@name
and
	source_type_id=@prime_broker_source_id

if @@rowcount != 1
begin

	select
		@status_id=status_id
	from
		statuses
	where
		name="New"

	if @@rowcount != 1
	begin
		select
			status="Error",
			message="Could not locate status type New",
			status_type="New"

		return
	end

	exec j_nextkey "sources", @source_id out

	insert into
		sources (
			source_id,
			name,
			status_id,
			source_type_id)
		values (
			@source_id,
			@name,
			@status_id,
			@prime_broker_source_id)

	if @@rowcount != 1
	begin
		select
			status="Error",
			message="Could not create new Prime Broker Source",
			prime_broker=@name

		return
	end

end
else
begin
	if exists (select source_id from prime_brokers where source_id=@source_id)
	begin
		select
			status="Error",
			message="Prime Broker already exists",
			prime_broker=@name

		return
	end
end

if exists (select external_account_id from external_accounts where symbol=@external_account)
begin
	select
		status="Error",
		message="External Account already exists",
		external_account=@external_account

	return
end

exec j_nextkey "prime_brokers", @prime_broker_id out

insert into
	prime_brokers (
		prime_broker_id,
		source_id
	)
values (
	@prime_broker_id,
	@source_id
	)

/* check to see if it's the first pb created */

declare @first_pb int

select
        @first_pb = count(*)
from
        prime_brokers

if (@first_pb = 1)
begin

	begin tran

        	update
                	funds
        	set
                	prime_broker_id=@prime_broker_id

        	if @@rowcount != 1
        	begin
                	select
                        	status="Error",
                        	msg="Could not update prime_broker_id in funds table",
                        	prime_broker=@name

			rollback tran

                	return
        	end

	commit tran

end

/* set default margin schedule */

insert into
        product_margins
select
        a.product_id,
        0.02,
        @prime_broker_id
from
        products a,
        product_types b
where
        a.product_type_id = b.product_type_id
and
        b.name = "Currency"

if @@rowcount = 0
begin
        select
                status="Warning",
                msg="Could not set up product margins for prime_broker",
                prime_broker=@name
end

exec
        api_createexternalaccount
                        @login=@login,
                        @symbol=@external_account,
                        @prime_broker=@name,
                        @account_type="Counterparty"

select
	@bo_external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account 

if @@rowcount != 1
begin
	select
		status="Error",
		message="Could not locate bo_external_account in external accounts",
		bo_external_account=@external_account

	return
end

select
	@run_id=run_id
from
	runs
where
	name=@external_account

if @@rowcount != 1
begin
	select
		status="Error",
		message="Could not locate run",
		run=@name

	return
end

select
	@margin_model_id=margin_model_id
from
	margin_models
where
	name="Default"

if @@rowcount != 1
begin
	select
		status="Warning",
		message="Could not locate Margin Model Default"
end

begin tran

	update
		prime_brokers
	set
		bo_external_account_id=@bo_external_account_id,
		run_id=@run_id,
		margin_model_id=@margin_model_id
	where
		prime_broker_id=@prime_broker_id

	if @@rowcount != 1
	begin
		select
			status="Warning",
			message="Could not update Prime Broker with ext account and run",
			prime_broker=@name

		rollback tran

		return
	end

commit tran

select
        status="Success",
        msg="Prime Broker created",
        name=@name

exec
	cm_primebrokers @login

return

go

