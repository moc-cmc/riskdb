create procedure
	fcm_tradefeesreport	
		@login char(30),
		@portfolio varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @trades int
declare @trade_id int
declare @trade_date datetime
declare @contract_id int
declare @quantity numeric(30,2)
declare @trade_price float
declare @end_value float
declare @default_day datetime
declare @trader_id int
declare @broker_id int
declare @contracts int



declare @sales_code varchar(50)
declare @sales_code_id int


declare @deal_id int


declare @day varchar(4)
declare @month varchar(4)
declare @year varchar(4)
declare @datestring char(20)
declare @today datetime
declare @now datetime

declare @external_account_type varchar(20)
declare @external_account_id int
declare @counterparty_id int
declare @style varchar(30)

select
	@now = getdate()
select
	@day = convert(varchar(4), datepart(day, @now)),
	@month = convert(varchar(4), datepart(month, @now)),
	@year = convert(varchar(4), datepart(year, @now))

select
	@datestring = rtrim(@month) + "/" + rtrim(@day) + "/" + rtrim(@year)

	select
		@today = convert(datetime, @datestring)

if @begin_date = NULL
begin
	if @end_date = NULL
	begin
		select
			@begin_date = max(trade_date) from trades
	end
	else
	begin	
		select
			@begin_date = getdate()
	end
end

	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)

create table
	#trades(
		trade_id int,
		identifier varchar(50),
		deal_id int,
		contract_id int,
		value_date datetime NULL,
		quantity numeric(30,2),
		trade_date datetime,
		price float,
		close_price float NULL,
		change float NULL,
		p_l float NULL,
		native_currency_id int NULL,
		native_pl float NULL)

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	a.external_account_id
from
	cta_portfolio_ext_accts a,
	cta_portfolios b
where
	a.portfolio_id = b.portfolio_id
and
	b.name = @portfolio
	
if @@rowcount = 0
begin

	select
		status="Error",
		message="No external accounts for portfolio ", @portfolio	
	return
end

insert into
	#trades
select
	a.trade_id,
	a.identifier,
	a.deal_id,
	a.contract_id,
	NULL,
	convert(numeric(30,2), a.quantity),
	a.trade_date,
	a.price,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL
from
	trades a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date


create table #output(
		trade_id		int,
		identifier		varchar(50),
		date			varchar(12),
		location		varchar(50) NULL,
		salescode		varchar(50) NULL,
		account			varchar(50) NULL,
		exchange		varchar(50) NULL,
		product			varchar(50) NULL,
		quantity		float       NULL,
		currency		varchar(12)	NULL,
		commission		float		NULL,
		clearing		float		NULL,
		exchange_fee	float		NULL,
		nfa				float		NULL,
		brokerage		float		NULL,
		service			float		NULL,
		omf				float		NULL,
		give_in			float		NULL,
		order_fee		float		NULL)


insert into
	#output
		(trade_id,
		identifier,
		date,
		salescode,
		account,
		exchange,
		product,
		quantity,
		currency,
		commission,
		exchange_fee,
		clearing,
		nfa,
		brokerage,
		service,
		omf,
		give_in,
		order_fee)
select
	a.trade_id,
	b.TXNO,
	convert(varchar(12), convert(datetime,substring(b.TDDT,2,6)), 101),
	b.SLSPSN,
	b.ACCTNO,
	b.EXCH,
	b.DSC,
	convert(float,b.QUANTY),
	b.ALTCUR,
	convert(float,b.CMNS),
	convert(float,b.EXSF),
	convert(float,b.EXCF),
	convert(float,b.NFA),
	convert(float,b.FBKR),
	convert(float,b.SERVICE),
	convert(float,b.OMF),
	convert(float,b.GIVEIN),
	convert(float,b.ORDERFEE)
from
	#trades a,
	crossland_trades_file b
where
	a.identifier=b.TXNO

