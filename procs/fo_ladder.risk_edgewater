	#premiums(
		product_id,
		value_date,
		premium)
select
	a.currency_id,
	convert(datetime, convert(date, a.transaction_date)),
	sum(a.amount)
from
	account_transactions a,
	account_transaction_trades b,
	#option_trades c
where
	a.account_transaction_id = b.account_transaction_id
and
	b.trade_id = c.trade_id
and
	a.transaction_date >= @begin_date
group by
	a.currency_id,
	convert(datetime, convert(date, a.transaction_date))
order by
	convert(datetime, convert(date, a.transaction_date))

