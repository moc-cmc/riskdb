	#rates(
		contract_id int NULL,
		price_style varchar(50) NULL,
		product_id int NULL,
		currency_id int NULL,
		rate float NULL,
		display_rate float NULL,
		timestamp datetime NULL,
		derived_timestamp datetime NULL)
