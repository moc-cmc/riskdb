		counterparty_id int NULL,
		broker_id int NULL,
		contract_id int,
		value_date datetime,
		product_id int,
		product_qty float,
		currency_id int,
		currency_qty float,
		price_style varchar(50) NULL,
		display_contract_id int NULL,
		display_product_qty float NULL,
		display_currency_qty float NULL,
		rate float NULL,
		product_equiv float NULL,
		currency_equiv float NULL,
		status_id int)

create table
	#option_trades(
		trade_id int)
insert into
	#option_trades
select
	a.trade_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	option_contracts h
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date >= @trades_begin
and
	a.trade_date < @end_date


insert into
	#trades(
		trade_id,
		trade_date,
		external_account_id,
		trader_id,
		counterparty_id,
		broker_id,
		contract_id,
		value_date,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		rate,
		status_id)
select
	a.trade_id,
	a.trade_date,
	a.external_account_id,
	a.trader_id,
	a.counterparty_id,
	a.broker_id,
	a.contract_id,
	a.value_date,
	h.product_id,
	a.quantity,
	h.currency_id,
	a.quantity * a.price * -1.0,
	a.price,
	a.status_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	forwards h
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date >= @trades_begin
and
	a.trade_date < @end_date

update
	#trades
set
	price_style = "Standard",
	display_contract_id = contract_id

update
	#trades
set
	a.price_style = c.name
from
	#trades a,
	contract_price_styles b,
	price_styles c
