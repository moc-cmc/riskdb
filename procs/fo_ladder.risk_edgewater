	fo_ladder
		@login varchar(50),
		@run_name varchar(50),
		@as_of_date datetime=NULL,
		@include_starting_positions char(10)=NULL,
		@currency varchar(50)=NULL
as


declare @run_id int
declare @tico_account_id int
declare @trades_begin datetime
declare @begin_date datetime
declare @end_date datetime
declare @fund_id int
declare @evaluation_currency_id int
declare @total_style varchar(250)
