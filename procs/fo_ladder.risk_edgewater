	#trades
set
	a.product_equiv = a.product_qty * b.rate
from
	#trades a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

update
	#trades
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#trades a,
	#rates b
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id





update
	#balances
set
	a.equiv = a.balance * b.rate
from
	#balances a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

update
	#premiums
set
	a.equiv = a.premium * b.rate,
	a.market_rate = b.display_rate
from
	#premiums a,
	#rates b
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id

select
	@total_prem_equiv = NULL
select
	@total_prem_equiv = sum(equiv)
from
	#premiums

if @total_prem_equiv != NULL
insert into
	#premiums(
		style,
		product,
		equiv)
values(
	@total_style,
	"Total",
	@total_prem_equiv)

