	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@resid_style = "background:#E3E1E2;border: 1px solid white;font-weight:bold"


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@original_incl = @include_starting_positions

if @include_starting_positions = NULL
	select
		@include_starting_positions = "N"



select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Login not found"
	return
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b
where
	a.run_id = b.run_id
and
	b.tico_account_id = @tico_account_id
and
	a.name = @run_name
if @run_id = NULL
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end

select
	@original_as_of_date = @as_of_date

if @as_of_date = NULL
	select
		@as_of_date = getdate()
exec
	r_daterangefordate
		@as_of_date,
		@begin_date output,
		@end_date output


if lower(convert(char(1), @include_starting_positions)) = "n"
begin
	select
		@trades_begin = @begin_date,
		@toggle_string = "Include Starting Positions",
		@incl = "YES"
end
else
begin
	select
		@trades_begin = min(trade_date)
	from
		trades
	where
		value_date >= @begin_date
	select
		@toggle_string = "Exclude Starting Positions",
		@incl = "NO"
end

