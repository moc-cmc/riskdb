create table
	#premiums(
		id int identity,
		style varchar(250) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		value_date datetime NULL,
		premium float NULL,
		currency_id int NULL,
		equiv float NULL,
		market_rate float NULL
		)
