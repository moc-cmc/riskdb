/* Forward ladder construction */
create table
	#forward_ladder(
		id int identity,
		style varchar(250) NULL,
		date datetime NULL,
		product_id int NULL,
		product varchar(50) NULL,
		value_date datetime NULL,
		balance float NULL,
		ccy varchar(50) NULL,
		equiv float NULL)

create table
	#value_dates(
		value_date datetime)
insert into
	#value_dates
select
	distinct(value_date)
from
	#trades


select
	@value_date = dateadd(year, -1, min(value_date))
from
	#value_dates

select
	@value_dates = count(*)
from
	#value_dates
where
	value_date > @value_date

while @value_dates > 0
begin
	select
		@value_date = min(value_date)
	from
		#value_dates
	where
		value_date > @value_date

	select
		@balances = NULL
	select
		@balances = count(*)
	from
		#balances
	where
		value_date = @value_date
	if @balances = NULL
		select
			@balances = 0

	if @balances > 0
	begin
		insert into
			#forward_ladder(
				style,
				product)
		values(
			@style,
			convert(varchar(11), @value_date))
	
		insert into
			#forward_ladder(
				style,
				/* product, MARKR */
				product_id,
				value_date,
				balance,
				ccy,
				equiv)
		select
			style = @style,
			/* MARKR b.symbol, */
			a.product_id,
			a.value_date,
			a.balance,
			b.symbol,
			a.equiv
		from
			#balances a,
			products b
		where
			a.product_id = b.product_id
		and
			a.value_date = @value_date
		order by
			b.symbol

		select
			@total_equiv = NULL
		select
			@total_equiv = sum(equiv)
		from
			#forward_ladder
		where
			value_date = @value_date

		insert into
			#forward_ladder(
				style,
				product,
				equiv)
		values(
			@subtotal_style,
			convert(varchar(11), @value_date) + " Total",
			@total_equiv)
	end


	select
		@value_dates = count(*)
	from
		#value_dates
	where
		value_date > @value_date
end

select
	@total_equiv = NULL
select
	@total_equiv = sum(equiv)
from
	#forward_ladder
where
	balance != NULL

insert into
	#forward_ladder(
		style,
		product,
		equiv)
