		total float NULL,
		currency varchar(50) NULL,
		market_rate float NULL,
		display_market_rate float NULL,
		equiv float NULL)
insert into
	#total_balances(
		ordering,
		product_id,
		balance)
select
	2,
	product_id,
	sum(balance)
from
	#balances
group by
	product_id

insert into
	#total_balances(
		ordering,
		product_id,
		premium)
select
	2,
	product_id,
	premium
from
	#net_prems
where
	product_id not in(
		select
			product_id
		from
			#balances)


update
	#total_balances
set
	balance = 0.0
where
	balance = NULL

update
	#total_balances
set
