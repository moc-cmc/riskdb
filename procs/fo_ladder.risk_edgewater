update
	#rates
set
	a.rate = c.price,
	a.timestamp = c.price_date
from
	#rates a,
	forwards b,
	prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#rates
set
	a.rate = 1.0 / c.price,
	a.timestamp = c.price_date
from
	#rates a,
	forwards b,
	prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#rates
set
	a.rate = c.price,
	a.timestamp = c.timestamp
from
	#rates a,
	forwards b,
	current_prices c
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#rates
set
	a.rate = 1.0 / c.price,
	a.timestamp = c.timestamp
from
	#rates a,
	forwards b,
	current_prices c
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#rates
set
	a.price_style = c.name
from
	#rates a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id

update
	#rates
set
	display_rate = rate

update
	#rates
set
	display_rate = 1.0 / rate
where
	price_style = "Inverted"

create table
	#contracts(
		contract_id int,
		product_id int NULL,
		currency_id int NULL)
insert into
	#contracts(
		contract_id)
select
	distinct(display_contract_id)
from
	#trades

update
	#contracts
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#contracts a,
	forwards b
where
	a.contract_id = b.contract_id

delete

from
	#contracts
where
	product_id = @evaluation_currency_id

delete

from
	#contracts
where
	currency_id = @evaluation_currency_id

select
	@contract_id = 0
select
	@contracts = count(*)
from
	#contracts
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#contracts
	where
		contract_id > @contract_id

	select
		@product_id = NULL,
		@currency_id = NULL,
		@product_rate = NULL,
		@currency_rate = NULL,
		@timestamp = NULL,
		@derived_timestamp = NULL,
		@product_style = NULL,
		@currency_style = NULL,
		@derived_rate = NULL

	select
		@product_id = product_id,
		@currency_id = currency_id
	from
		#contracts
	where
		contract_id = @contract_id

	select
		@product_rate = display_rate,
		@timestamp = timestamp,
		@product_style = price_style
	from
		#rates
	where
		product_id = @product_id
	and
		currency_id = @evaluation_currency_id

	select
		@currency_rate = display_rate,
		@derived_timestamp = timestamp,
		@currency_style = price_style
	from
		#rates
	where
		product_id = @currency_id
	and
		currency_id = @evaluation_currency_id

	if @product_style = @currency_style
	begin
		select
			@derived_rate = round(@product_rate, 5) / round(@currency_rate, 5)
	end
	if @product_style != @currency_style
	begin
		select
			@derived_rate = round(@product_rate, 5) * round(, @currency_rate, 5)
	end

	insert into
		#rates(
			contract_id,
			product_id,
			currency_id,
			rate,
			timestamp,
			derived_timestamp)
	values(
		@contract_id,
		@product_id,
		@currency_id,
		@derived_rate,
		@timestamp,
		@derived_timestamp)
		
	select
		@contracts = count(*)
	from
		#contracts
	where
		contract_id > @contract_id
end
		
update
	#rates
set
	display_rate = rate 

update
	#rates
set
	a.display_rate = 1.0 / a.rate,
	a.price_style = "Inverted"
from
	#rates a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"


