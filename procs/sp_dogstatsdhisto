drop procedure	
	sp_dogstatsdtimer
go

create procedure
	sp_dogstatsdtimer
		@metric_name varchar(200),
		@start_time datetime,
		@end_time datetime,
		@tags varchar(255)=NULL,
		@sample_rate varchar(10)="1.0"

as

/* chriso: 2018-07-07 - https://docs.datadoghq.com/developers/dogstatsd/datagram_shell/#metrics */


declare @result int
declare @value varchar(20)

select
	@value = convert(varchar(20), datediff(ms, @start_time, @end_time))

if @tags = NULL
begin
	select
		@tags = "db:"+db_name()
end
else
begin
	select
		@tags = rtrim(@tags)+",db:"+db_name()
end

select
	@result = syb_sendmsg("localhost", 8125,
            rtrim(@metric_name) +":"+ rtrim(@value) +"|ms|@"+ rtrim(@sample_rate) +"|#"+ rtrim(@tags)
        )


go
