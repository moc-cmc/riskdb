
drop procedure
	r_delexpprice
go

create procedure
	r_delexpprice
		@login varchar(50),
		@symbol varchar(50),
		@expiration_name varchar(50)
as

declare @contract_id int


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end


delete

from
	expiration_prices
where
	contract_id = @contract_id
and
	expiration_name = @expiration_name


exec
	ag_optioncalendar
		@login = @login,
		@as_of_date = NULL,
		@expiration_name = @expiration_name


go

