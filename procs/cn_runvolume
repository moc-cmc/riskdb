/* Prepare a summary of evaluation price sources for display */
create table
	#price_sources(
		style varchar(50),
		status varchar(25),
		message varchar(200),
		total_trades int,
		evaluation_currency_trades int,
		back_office_evaluations int,
		front_office_evaluations int,
		live_price_evaluations int)

select
	@evaluation_currency_trades = count(*)
from
	#trades
where
	price_source = "NATIVE"
if @evaluation_currency_trades = NULL
	select
		@evaluation_currency_trades = 0

select
	@bo_valued_trades = count(*)
from
	#trades
where
	price_source = "BO"
if @bo_valued_trades = NULL
	select
		@bo_valued_trades = 0

select
	@fo_valued_trades = count(*)
from
	#trades
where
	price_source = "FO"
if @fo_valued_trades = NULL
	select
		@fo_valued_trades = 0

select
	@current_valued_trades = count(*)
from
	#trades
where
	price_source = "CURRENT"
if @current_valued_trades = NULL
	select
		@current_valued_trades = 0

select
	@trades = count(*)
from
	#trades
if @trades = NULL
begin
	select
		@trades = 0

	insert into
		#price_sources
	values(
		"background:#FF9999",
		"Empty",
		"No trades found",	
		0,
		0,
		0,
		0,
		0)
end
else
begin
	if @trades != @evaluation_currency_trades + @bo_valued_trades + @fo_valued_trades + @current_valued_trades
		select
			@style = "background:#FF9999",
			@status = "Incomplete",
			@message = "Volume cannot be calculated due to missing prices"
	if @bo_valued_trades + @evaluation_currency_trades = @trades
		select
			@style = "background:#99FF99",
			@status = "Complete",
			@message = "Only back office settles used"
	
	if @fo_valued_trades != 0 and @current_valued_trades = 0
		select
			@style = "background:#FFFF99",
			@status = "Complete",
			@message = "Some front office settles used"
	
	if @current_valued_trades != 0
		select
			@style = "background:#FF9999",
			@status = "Incomplete",
			@message = "Volume was calculated using some ticking prices"
	
	insert into
		#price_sources
	values(
		@style,
		@status,
		@message,
		@trades,
		@evaluation_currency_trades,
		@bo_valued_trades,
		@fo_valued_trades,
		@current_valued_trades)

end
