select
	@total = sum(total_volume)
from
	#by_instrument
if @total = NULL
	select
		@total = 0.0

insert into
	#by_instrument
values(
	"Total",
	@total)

select
	instrument,
	total_volume = total_volume / 1000000.00
from
	#by_instrument
	
create table
	#by_deal_notification(
		deal_notification_source varchar(50),
		total_volume float)
insert into
	#by_deal_notification
select
	a.name,
	sum(c.evaluation_value)
from
	sources a,
	#notifications b,
	#trades c
where
	a.source_id = b.source_id
and
	b.deal_id = c.deal_id
group by
	a.name
order by
	a.name
select
	@total = sum(total_volume)
from
	#by_deal_notification
if @total = NULL
	select
		@total = 0.0
insert into
	#by_deal_notification
values(
	"Total",
	@total)

select
	deal_notification_source,
	total_volume = total_volume / 1000000.00
from
	#by_deal_notification



