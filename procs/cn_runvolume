		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@evaluation_currency varchar(50)=NULL,
		@min_size float=NULL,
		@reporting_source varchar(50)=NULL
as

declare @date datetime
declare @evaluation_currency_id int
declare @run_id int
declare @total float
declare @total_adjusted float
declare @missing_settles int
declare @trades int
declare @bo_valued_trades int
declare @fo_valued_trades int
