from
	#meta

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

