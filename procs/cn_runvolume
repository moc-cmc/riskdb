create table
	#by_date(
		trade_date varchar(30),
		total_volume float,
		adjusted_volume float)
insert into
	#by_date
select
	convert(varchar(11), convert(datetime, convert(varchar(10), dateadd(day, case when datepart(caldayofweek, dateadd(hour, 7, trade_date)) > 5 then 8 - datepart(caldayofweek, dateadd(hour, 7, trade_date)) else 0 end, dateadd(hour, 7, trade_date)), 101))),
	sum(evaluation_value),
	sum(volume_equivalent)
from
	#trades
group by
	convert(datetime, convert(varchar(10), dateadd(day, case when datepart(caldayofweek, dateadd(hour, 7, trade_date)) > 5 then 8 - datepart(caldayofweek, dateadd(hour, 7, trade_date)) else 0 end, dateadd(hour, 7, trade_date)), 101))
order by
	convert(datetime, convert(varchar(10), dateadd(day, case when datepart(caldayofweek, dateadd(hour, 7, trade_date)) > 5 then 8 - datepart(caldayofweek, dateadd(hour, 7, trade_date)) else 0 end, dateadd(hour, 7, trade_date)), 101))

select
