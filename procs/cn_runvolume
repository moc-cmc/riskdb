if @reporting_source = NULL or @reporting_source = "All"
begin
	insert into
		#notifications
	select
		a.deal_id,
		a.source_id,
		max(a.notify_date)
	from
		deal_notifications a,
		statuses b
	where
		a.status_id = b.status_id
	and
		b.name = "Sent"
	and
		a.notify_date > @begin_date
	and
		a.notify_date <= @end_date
	group by
		a.deal_id,
		a.source_id
	having
		a.notify_date = max(a.notify_date)

	insert into
		#trades(
			trade_id,
			deal_id,
			user_id,	
			internal_account_id,
			external_account_id,
			quantity,
			contract_id,
			price,
			trade_date,
			trader_id,
			strategy_id,
			status_id,
			broker_id)
	select
		a.trade_id,
		a.deal_id,
		a.user_id,
		a.internal_account_id,
		a.external_account_id,
		a.quantity,
		a.contract_id,
		a.price,
		a.trade_date,
		a.trader_id,
		a.strategy_id,
		a.status_id,
		a.broker_id 
	from
		trades a,
		#internal_accounts b,
		#external_accounts c,
		#traders d,
		#strategies e,
		#brokers f
	where
		a.internal_account_id = b.internal_account_id
	and
		a.external_account_id = c.external_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id= f.broker_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date

end
else
begin
	insert into
		#notifications
	select
		a.deal_id,
		a.source_id,
		max(a.notify_date)
	from
		deal_notifications a,
		statuses b,
		sources c
	where
		a.source_id = c.source_id
	and
		a.status_id = b.status_id
	and
		b.name = "Sent"
	and
		c.name = @reporting_source
	and
		a.notify_date > @begin_date
	and
		a.notify_date <= @end_date
	group by
		a.deal_id,
		a.source_id
	having
		a.notify_date = max(a.notify_date)

	insert into
		#trades(
			trade_id,
			deal_id,
			user_id,	
			internal_account_id,
			external_account_id,
			quantity,
			contract_id,
			price,
			trade_date,
			trader_id,
			strategy_id,
			status_id,
			broker_id)
	select
		a.trade_id,
		a.deal_id,
		a.user_id,
		a.internal_account_id,
		a.external_account_id,
		a.quantity,
		a.contract_id,
		a.price,
		a.trade_date,
		a.trader_id,
		a.strategy_id,
		a.status_id,
		a.broker_id 
	from
		trades a,
		#internal_accounts b,
		#external_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
		#notifications g
	where
		a.internal_account_id = b.internal_account_id
	and
		a.external_account_id = c.external_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id= f.broker_id
	and
		a.deal_id = g.deal_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
end



