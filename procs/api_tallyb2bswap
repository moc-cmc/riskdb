if object_id("api_tallyb2bswap") != NULL
    drop procedure
        api_tallyb2bswap
go

create procedure
	api_tallyb2bswap
		@login varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(20),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@near_date datetime,
		@client_near_price float,
		@market_near_price float,
		@far_date datetime,
		@client_far_price float,
		@market_far_price float,
		@deal_id int output,
		@near_fixing_date datetime = NULL,
		@far_fixing_date datetime = NULL

as

declare @tally_type varchar(20)
declare @client_external_account varchar(50)
declare @market_external_account varchar(50)
declare @trader varchar(25)
declare @symbol varchar(50)
declare @client_near_trade_id int
declare @market_near_trade_id int
declare @client_far_trade_id int
declare @market_far_trade_id int
declare @far_trade_id int
declare @trade_date datetime
declare @client_near_quantity numeric(30,4)
declare @client_far_quantity numeric(30,4)
declare @market_near_quantity numeric(30,4)
declare @market_far_quantity numeric(30,4)
declare @market_sales_code varchar(50)

select
	@market_sales_code = "None"

select
	@tally_type = "Swap"

if @client_buys_sells = "Client Buys"
begin
	select
		@client_near_quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@client_near_quantity = abs(@quantity)
end

select
	@client_far_quantity = @client_near_quantity * -1.0

select
	@market_near_quantity = @client_near_quantity * -1.0,
	@market_far_quantity = @client_far_quantity * -1.0

select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)


select
	@client_external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

select
	@market_external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end


select
	@trader = a.symbol
from
	traders a,
	tico_accounts b
where
	a.tico_account_id = b.account_id
and
	b.login = @login


select
	@trade_date = getdate()


/* Tally the client near leg */
exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Near",
		@external_account = @client_external_account,
		@quantity = @client_near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@price = @client_near_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@fixing_date = @near_fixing_date	

exec
	r_inserttradenotification @client_near_trade_id

/* Tally the market near leg */
exec
	fxa_tallytrade
		@login,
		@source = "MPT Manual Tally",
		@trade_id = @market_near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Near",
		@external_account = @market_external_account,
		@counterparty = @counterparty,
		@quantity = @market_near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@price = @market_near_price,
		@trade_date = @trade_date,
		@sales_code = @market_sales_code,
		@fixing_date = @near_fixing_date	

exec
	r_inserttradenotification @market_near_trade_id

/* Tally the client far leg */
exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Far",
		@external_account = @client_external_account,
		@quantity = @client_far_quantity,
		@symbol = @symbol,
		@value_date= @far_date,
		@price = @client_far_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@fixing_date = @far_fixing_date	

exec
        r_inserttradenotification @client_far_trade_id

/* Tally the market far leg */
exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @market_far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "B2B Swap",
		@trade_type = "Swap Far",
		@external_account = @market_external_account,
		@counterparty = @counterparty,
		@quantity = @market_far_quantity,
		@symbol = @symbol,
		@value_date = @far_date,
		@price = @market_far_price,
		@trade_date = @trade_date,
		@sales_code = @market_sales_code,
		@fixing_date = @far_fixing_date

exec
        r_inserttradenotification @market_far_trade_id

go
