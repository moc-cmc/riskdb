drop procedure fxa_unmarkallresids
go
		
create procedure
	fxa_unmarkallresids
                @login varchar(30),
		@run_name varchar(50),
		@begin_date datetime,
		@end_date datetime

as



declare @run_id int
declare @tico_account_id int
declare @date datetime
declare @trade_date datetime
declare @user_review_status_id int
declare @resid_status_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "login not found"
	return
end

select
	@user_review_status_id = status_id
from
	statuses
where
	name = "User Review"
if @@rowcount != 1
begin
	select
		error = -1,
		msg = "Problem finding status with name 'User Review'"
	return
end

select
        @resid_status_id = status_id
from
        statuses
where   
        name = "Resid"
if @@rowcount != 1
begin           
        select
                error = -1,
                msg = "Problem finding status with name 'Resid'"
        return
end


select
	@run_id = b.run_id
from
	runs b
where
	b.name = @run_name
if @run_id = NULL
begin
	select
		id = -1,
		error = "Problem finding run for run name",
		run = @run_name
	return
end
	


	
create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#traders
	select
		trader_id
	from
		traders

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
run_id = @run_id
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select  
	internal_account_id
from    
	run_internal_accounts
where   
	run_id = @run_id 
if @@rowcount = 0
	insert into
		#internal_accounts
	select  
		internal_account_id
	from    
		internal_accounts

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#strategies
	select
		strategy_id
	from
		strategies


create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
        #counterparties(
                counterparty_id int)
insert into
        #counterparties
select
        counterparty_id
from
        run_counterparties
where
        run_id = @run_id 
if @@rowcount = 0
        insert into
                #counterparties
        select
                counterparty_id
        from
                counterparties


create table
	#trades(
		trade_id int,
		deal_id int,
		trade_date datetime,
		currency_pair varchar(20) NULL,
		value_date varchar(11) NULL,
		quantity numeric(30,4) NULL,
		all_in_rate float NULL,
		platform varchar(25) NULL,
		external_account varchar(25) NULL,
		trader varchar(25) NULL,
		counterparty varchar(25) NULL,
		status_id int
		)
insert into
	#trades(
		trade_id,
		deal_id,
		quantity,
		all_in_rate,
		trade_date,
		value_date,
		status_id
		)	
select
	a.trade_id,
	a.deal_id,
	a.quantity,     
	a.price,
	trade_date = convert(char(30), a.trade_date, 109),
	value_date = a.value_date,
	a.status_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.quantity != 0
and
	a.status_id = @resid_status_id

declare @count int
update
	trades
set
	a.status_id = @user_review_status_id
from
	trades a,
	#trades b
where
	a.trade_id = b.trade_id
select @count = @@rowcount
	
/*select
	"msg" = "Unmarked trades",
	"count" = @count*/

exec
	fxa_batchmarkresids
		@login,
		@run_name,
		@begin_date,
		@end_date
		
go
