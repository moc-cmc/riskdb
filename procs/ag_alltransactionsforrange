use
	risk_admis
go

drop procedure
	ag_alltransactionsforrange
go

create procedure
	ag_alltransactionsforrange
		@login varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as


declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)


declare @status_id int
declare @source_id int
declare @contract_id int
declare @inverted_contract_id int
declare @price_date datetime
declare @val_date datetime
declare @forward_price float
declare @inverted_price float
declare @bo_price_id int
declare @inverted_price_id int
declare @price_style varchar(50)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_contracts",
	"Edit Pip Spread Contracts",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	"#,##0.0000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date = NULL
	select
		@end_date = getdate()



select
	section = "Transactions for " + convert(varchar(11), @begin_date) + " To " + convert(varchar(11), @end_date),
	style = @style,
	a.account_transaction_id,
	entered_by = b.login,
	account = c.symbol,
	transaction_type = d.name,
	a.transaction_date,
	a.amount,
	currency = e.symbol,
	a.note
from
	account_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d,
	products e
where
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	a.currency_id = e.product_id
and
	convert(date, a.transaction_date) >= @begin_date
and
	convert(date, a.transaction_date) <= @end_date
order by
	a.transaction_date,
	c.symbol,
	e.symbol
	


go
