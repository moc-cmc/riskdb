drop procedure r_glencommittedvolumefordate
go


create procedure
	r_glencommittedvolumefordate
		@login varchar(50),
		@bo_trade_date datetime,
		@min_ticket_size float=NULL,
		@commit_status varchar(50) output,
		@evaluation_currency varchar(30) output,
		@spot_trades int output,
		@spot_volume float output,
		@forward_trades int output,
		@forward_volume float output,
		@forward_option_trades int output,
		@forward_option_volume float output,
		@exotic_trades int output,
		@exotic_volume float output,
		@forward_swap_trades int output,
		@forward_swap_volume float output,
		@futures_trades int output,
		@futures_volume float output,
		@futures_option_trades int output,
		@futures_option_volume float output,
		@internal_trades int output,
		@internal_volume float output

as

declare @max_commit_date datetime
declare @evaluation_currency_id int
declare @swap_near_trades int
declare @swap_near_volume float
declare @swap_far_trades int
declare @swap_far_volume float

select
	@evaluation_currency_id = a.product_id,
	@evaluation_currency = a.symbol
from
	products a,
	funds b
where
	a.product_id = b.evaluation_currency_id 


/* MARK: CHECK that this trade date is not being moved back prior to an already committed date */

select 
	@max_commit_date = max(commit_date) 
from 
	daily_commits a, 
	commit_statuses b 
where 
	a.commit_status_id = b.commit_status_id 
and 
	b.name in("Commit Complete")


/* MARK: CHECK that this trade is not already committed*/
if (convert(date, @bo_trade_date) > convert(date, @max_commit_date))
begin
	select
		status = "Error",
		error = "Data not committed for date, can not run revenue capture",
		bo_trade_date = @bo_trade_date,
		max_commit_date = @max_commit_date
	return
end

select
	@commit_status = "Committed"


create table
	#int_ext_accts(
		external_account_id int
)
create table
	#ext_accts(
		external_account_id int
)

insert into
	#int_ext_accts
select
	external_account_id
from
	external_accounts
where
	symbol in("")

insert into
	#ext_accts
select
	external_account_id
from
	external_accounts
where
	external_account_id not in(select external_account_id from #int_ext_accts)


create table
	#volumes(
		trade_type varchar(50),
		num_trades int NULL,
		volume float NULL)


create table
        #int_volumes(
                trade_type varchar(50),
                num_trades int NULL,
                volume float NULL)

if @min_ticket_size = NULL
begin
	select bo_trade_date = @bo_trade_date
		
	insert into
		#volumes
	select
		c.name,
		count(a.trade_id),
		sum(a.volume)
	from
		trade_volumes a,
		trades b,
		trade_types c,
		#ext_accts d
	where
		a.trade_id = b.trade_id
	and
		b.trade_type_id = c.trade_type_id
	and
		a.volume_date = @bo_trade_date
	and
		a.product_id = @evaluation_currency_id
	and
		b.external_account_id = d.external_account_id
	group by
		c.name

        insert into
                #int_volumes
        select
                c.name,
                count(a.trade_id),
                sum(a.volume)
        from
                trade_volumes a,
                trades b,
                trade_types c,
                #int_ext_accts d
        where
                a.trade_id = b.trade_id
        and
                b.trade_type_id = c.trade_type_id
        and
                a.volume_date = @bo_trade_date
        and
                a.product_id = @evaluation_currency_id
        and
                b.external_account_id = d.external_account_id
        group by
                c.name

end
else
begin

	insert into
		#volumes
	select
		c.name,
		count(a.trade_id),
		sum(a.volume)
	from
		trade_volumes a,
		trades b,
		trade_types c,
		#ext_accts d
	where
		a.trade_id = b.trade_id
	and
		b.trade_type_id = c.trade_type_id
	and
		a.volume >= @min_ticket_size
        and
                a.volume_date = @bo_trade_date
        and
                a.product_id = @evaluation_currency_id
        and
                b.external_account_id = d.external_account_id
	group by
		c.name

        insert into
                #int_volumes
        select
                c.name,
                count(a.trade_id),
                sum(a.volume)
        from
                trade_volumes a,
                trades b,
                trade_types c,
                #int_ext_accts d
        where
                a.trade_id = b.trade_id
        and
                b.trade_type_id = c.trade_type_id
        and
                a.volume >= @min_ticket_size
        and
                a.volume_date = @bo_trade_date
        and
                a.product_id = @evaluation_currency_id
        and
                b.external_account_id = d.external_account_id
        group by
                c.name


	create table
		#min_tickets(
			trade_type varchar(50),
			num_trades int NULL,
			volume float NULL)

        create table
                #int_min_tickets(
                        trade_type varchar(50),
                        num_trades int NULL,
                        volume float NULL)

	insert into
		#min_tickets
	select
		c.name,
		count(a.trade_id),
		sum(a.volume - a.volume + @min_ticket_size)
	from
		trade_volumes a,
		trades b,
		trade_types c,
		#ext_accts d
	where
		a.trade_id = b.trade_id
	and
		b.trade_type_id = c.trade_type_id
        and
                a.volume_date = @bo_trade_date
        and
                a.product_id = @evaluation_currency_id
	and
		a.volume < @min_ticket_size
	and
		b.external_account_id = d.external_account_id
	group by
		c.name

        insert into
                #int_min_tickets
        select
                c.name,
                count(a.trade_id),
                sum(a.volume - a.volume + @min_ticket_size)
        from
                trade_volumes a,
                trades b,
                trade_types c,
                #int_ext_accts d
        where
                a.trade_id = b.trade_id
        and
                b.trade_type_id = c.trade_type_id
	and
                a.volume_date = @bo_trade_date
        and
                a.product_id = @evaluation_currency_id
        and
                a.volume < @min_ticket_size
        and
                b.external_account_id = d.external_account_id
        group by
                c.name



	update
		#volumes
	set
		a.num_trades = a.num_trades + b.num_trades,
		a.volume = a.volume + b.volume
	from
		#volumes a,
		#min_tickets b
	where
		a.trade_type = b.trade_type

	insert into
		#volumes
	select
		trade_type,
		num_trades,
		volume
	from
		#min_tickets
	where
		trade_type
	not in(
		select
			trade_type
		from
			#volumes)

        update
                #int_volumes
        set
                a.num_trades = a.num_trades + b.num_trades,
                a.volume = a.volume + b.volume
        from
                #int_volumes a,
                #int_min_tickets b
        where
                a.trade_type = b.trade_type

        insert into
                #int_volumes
        select
                trade_type,
                num_trades,
                volume
        from
                #int_min_tickets
        where
                trade_type
        not in(
                select
                        trade_type
                from
                        #int_volumes)
end

select
	@spot_trades = num_trades,
	@spot_volume = volume
from
	#volumes
where
	trade_type = "Spot"
if @spot_trades != NULL and @spot_trades > 0 and @spot_volume = NULL
begin
	select
		@commit_status = "Incomplete spot volume"
	return
end

select
        @internal_trades = num_trades,
        @internal_volume = volume
from
        #int_volumes
if @internal_trades != NULL and @internal_trades > 0 and @internal_volume = NULL
begin
        select
                @commit_status = "Incomplete spot volume"
        return
end


select
	@forward_trades = num_trades,
	@forward_volume = volume
from
	#volumes
where
	trade_type = "Forward"
if @forward_trades != NULL and @forward_trades > 0 and @forward_volume = NULL
begin
	select
		@commit_status = "Incomplete forward volume"
	return
end


select
	@forward_option_trades = num_trades,
	@forward_option_volume = volume
from
	#volumes
where
	trade_type = "Option"
if @forward_option_trades != NULL and @forward_option_trades > 0 and @forward_option_volume = NULL
begin
	select
		@commit_status = "Incomplete forward option volume"
	return
end
if @forward_option_volume = NULL
	select
		@forward_option_trades = 0,
		@forward_option_volume = 0.0

select
	@exotic_trades = num_trades,
	@exotic_volume = volume
from
	#volumes
where
	trade_type = "Exotic"
if @exotic_trades != NULL and @exotic_trades > 0 and @exotic_volume = NULL
begin
	select
		@commit_status = "Incomplete exotic volume"
	return
end
if @exotic_volume = NULL
	select
		@exotic_trades = 0,
		@exotic_volume = 0.0

select
	@swap_near_trades = num_trades,
	@swap_near_volume = volume
from
	#volumes
where
	trade_type = "Swap Near"
if @swap_near_trades != NULL and @swap_near_trades > 0 and @swap_near_volume = NULL
begin
	select
		@commit_status = "Incomplete swap near volume"
	return
end
if @swap_near_volume = NULL
	select
		@swap_near_trades = 0,
		@swap_near_volume = 0.0


select
	@swap_far_trades = num_trades,
	@swap_far_volume = volume
from
	#volumes
where
	trade_type = "Swap Near"
if @swap_far_trades != NULL and @swap_far_trades > 0 and @swap_far_volume = NULL
begin
	select
		@commit_status = "Incomplete swap far volume"
	return
end
if @swap_far_volume = NULL
	select
		@swap_far_trades = 0,
		@swap_far_volume = 0.0
	
select
	@forward_swap_trades = @swap_near_trades + @swap_far_trades,
	@forward_swap_volume = @swap_near_volume + @swap_far_volume


select
	@futures_trades = num_trades,
	@futures_volume = volume
from
	#volumes
where
	trade_type = "Future"
if @futures_trades != NULL and @futures_trades > 0 and @futures_volume = NULL
begin
	select
		@commit_status = "Incomplete futures volume"
	return
end
if @futures_volume = NULL
	select
		@futures_trades = 0,
		@futures_volume = 0.0
	

select
	@futures_option_trades = num_trades,
	@futures_option_volume = volume
from
	#volumes
where
	trade_type = "Future Option"
if @futures_option_trades != NULL and @futures_option_trades > 0 and @futures_option_volume = NULL
begin
	select
		@commit_status = "Incomplete futures option volume"
	return
end
if @futures_option_volume = NULL
	select
		@futures_option_trades = 0,
		@futures_option_volume = 0.0


go
