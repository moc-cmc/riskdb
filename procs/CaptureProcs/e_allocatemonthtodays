use
	risk_home
go

drop procedure
	e_allocatemonthtodays
go

create procedure
	e_allocatemonthtodays
		@login varchar(50),
		@first_date_of_month datetime,
		@vendor varchar(50),
		@screen_name varchar(50),
		@buy_sell varchar(50),
		@symbol varchar(50),
		@quantity numeric(30,4),
		@price float,
		@value_date datetime
as

declare @client_buys_sells varchar(50)
declare @dealt_currency varchar(50)
declare @counter_currency varchar(50)
declare @day_one datetime
declare @prev_month_last_date datetime
declare @next_month_first_date datetime
declare @num_days int

declare @business_days int
declare @business_day datetime

declare @day int
declare @month int
declare @year int
declare @datestring varchar(50)

declare @id int
declare @ids int
declare @tally_type varchar(50)
declare @deal_id int
declare @trade_id int
declare @day_allocation numeric(30,4)

declare @contract_id int
declare @product_id int
declare @currency_id int

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Could not resolve contract",
		contract = @symbol
	return
end

exec
	r_contractproduct
		@contract_id,
		@product_id output
exec
	r_contractcurrency
		@contract_id,
		@currency_id output

select
	@dealt_currency = symbol
from
	products
where
	product_id = @product_id

select
	@counter_currency = symbol
from
	products
where
	product_id = @currency_id


select
	@tally_type = "Forward"

select
	@day = datepart(day, @first_date_of_month),
	@month = datepart(month, @first_date_of_month),
	@year = datepart(year, @first_date_of_month)

select
	@datestring = convert(varchar(2), @month) + "/" + convert(varchar(2), @day) + "/" + convert(varchar(4), @year)

select
	@day_one = convert(datetime, @datestring)

select
	@next_month_first_date = dateadd(month, 1, @day_one)

exec
	r_prevbusinessday
		@day_one,
		@prev_month_last_date output

select
	@business_day = @prev_month_last_date

create table
	#dates(
		id int identity,
		business_day datetime,
		amount float NULL)

while @business_day < @next_month_first_date
begin
	exec
		r_nextbusinessday
			@business_day,
			@business_day output

	if datepart(month, @business_day) = @month
		insert into
			#dates(
				business_day)
		values(
			@business_day)

end

select
	@num_days = count(*)
from
	#dates

if @num_days != 0
update
	#dates
set
	amount = @quantity / convert(float, @num_days)

if lower(convert(char(1), @buy_sell)) = "b"
begin
	select
		@buy_sell = "Buy"
end
if lower(convert(char(1), @buy_sell)) = "s"
begin
	select
		@buy_sell = "Sell"
end


select
	@id = 0
select
	@ids = count(*)
from
	#dates
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#dates
	where
		id > @id

	select
		@deal_id = NULL,
		@trade_id = NULL
	
	select
		@day_allocation = convert(numeric(30,2), amount),
		@business_day = business_day
	from
		#dates
	where
		id = @id

	exec
		api_tallymarkettrade
			@login = @screen_name,
			@tally_type = @tally_type,
			@buy_sell = @buy_sell,
			@dealt_currency = @dealt_currency,
			@counter_currency = @counter_currency,
			@counterparty_account = @vendor,
			@quantity = @day_allocation,
			@price = 1.0,
			@value_date = @value_date,
			@deal_id = @deal_id output,
			@trade_id = @trade_id output
			

	update
		trades
	set
		trade_date = @business_day
	where
		trade_id = @trade_id


	select
		@ids = count(*)
	from
		#dates
	where
		id > @id
end


		

go
