use
	risk_home
go

drop procedure
	e_billingreport
go

create procedure
	e_billingreport
		@login varchar(50)

as

declare @id int
declare @ids int
declare @last_date datetime
declare @committed_days int
declare @total_days int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Column Format",
	"year",
	"Number",
	"###0")

insert into
	#meta
values(
	"Column Format",
	"projected_pl",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"average_day",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"p_l",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"account",
	NULL,
	NULL)

select * from #meta

create table
	#months(
		id int identity,
		label varchar(25),
		last_date datetime)

insert into
	#months(
		label,
		last_date)
select
	datename(month, reval_date) + convert(varchar(4), datepart(year, reval_date)),
	max(reval_date)
from
	committed_daily_revals
group by
	datename(month, reval_date) + convert(varchar(4), datepart(year, reval_date))


create table
	#pls(
		id int identity,
		last_date datetime,
		external_account_id int,
		total_days int NULL,
		committed_days int NULL,
		average_day float NULL,
		projected_pl float NULL,
		p_l float)

select
	@id = 0
select
	@ids = count(*)
from
	#months
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#months
	where
		id > @id

	select
		@last_date = last_date
	from
		#months
	where
		id = @id

	select
		@total_days = NULL,
		@committed_days = NULL

	exec
		e_businessdaysinmonth
			@last_date,
			@total_days output


	exec
		e_monthbizdaystildate
			@last_date,
			@committed_days output


	insert into
		#pls(
			last_date,
			external_account_id,
			p_l)
	select
		a.reval_date,
		b.external_account_id,
		sum(a.realized_pl_to_date + a.unrealized_pl_to_date)
	from
		committed_daily_revals a,
		trades b
	where
		a.trade_id = b.trade_id
	and
		a.reval_date = @last_date
	and
		datepart(month, b.trade_date) = datepart(month, @last_date)
	and
		datepart(year, b.trade_date) = datepart(year, @last_date)
	group by
		a.reval_date,
		b.external_account_id

	update
		#pls
	set
		total_days = @total_days,
		committed_days = @committed_days
	where
		last_date = @last_date

	select
		@ids = count(*)
	from
		#months
	where
		id > @id
end


update
	#pls
set
	average_day = p_l / convert(float, committed_days)
where
	committed_days != 0

update
	#pls
set
	projected_pl = (convert(float, total_days) / convert(float, committed_days)) * p_l
where
	total_days != committed_days
and
	committed_days != 0


create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	distinct(a.external_account_id)
from
	counterparties a,
	committed_captures b
where
	a.counterparty_id = b.counterparty_id

select
	style = "background:#fff;border: 1px solid white",
	account = b.symbol,
	month = datename(month, a.last_date) + " (" + rtrim(convert(varchar(4), datepart(year, a.last_date))) + ")",
	a.total_days,
	a.committed_days,
	a.average_day,
	a.projected_pl,
	a.p_l
from
	#pls a,
	external_accounts b,
	#external_accounts c
where
	a.external_account_id = b.external_account_id
and
	a.external_account_id = c.external_account_id
and
	b.external_account_id = c.external_account_id
order by
	b.symbol,
	a.last_date
	


go
