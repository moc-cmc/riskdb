use
	risk_home
go

drop procedure
	adm_batchcommit
go

create procedure
	adm_batchcommit
		@login varchar(50),
		@begin_date datetime,
		@end_date datetime

as

declare @commit_date datetime
declare @trade_date datetime


while @begin_date <= @end_date
begin
	
	select
		@trade_date = @begin_date

	exec
		adm_ex_tallycommittedtrades
			@login,
			"ADM",
			"ADM",
			@trade_date
	exec
		adm_ex_tallycommittedtrades
			@login,
			"ADM",
			"Notify BoA 1",
			@trade_date

	exec
		adm_ex_tallycommittedtrades
			@login,
			"ADM",
			"Notify BoA 2",
			@trade_date
	
	exec
		adm_tallycommittedtrades
			@login,
			"ADM",
			@trade_date

	exec
		r_nextbusinessday
			@begin_date,
			@begin_date output 

end


go
