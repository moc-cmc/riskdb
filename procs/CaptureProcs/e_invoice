		@style = "background:#fff;color:#FF0000;border: 1px solid white" /* ,
		@previous_due = "Past Due" */
else
	select
		@style = "background:#fff;border: none"
insert into
	#statement(
		section,
		style,
		activity,
		amount,
		balance,
		due)
