	#statement(
		id int identity,
		section varchar(50),
		style varchar(200),
		transaction_id int NULL,
		transaction_type_id int NULL,
		activity varchar(100),
		date datetime NULL,
		amount float NULL,
		payments float NULL,
		charges float NULL,
		credits float NULL,
		balance float NULL,
		due varchar(200) NULL)


