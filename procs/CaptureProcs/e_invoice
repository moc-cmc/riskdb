and
	a.external_account_id = @external_account_id
and
	a.transaction_date >= @billing_cutoff
and
	a.transaction_type_id != @transaction_type_id
and
	a.transaction_date < @statement_date
and
	a.transaction_type_id != @payment_transaction_type_id
order by
	a.transaction_date


