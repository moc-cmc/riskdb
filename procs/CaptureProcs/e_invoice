	@statement_string,
	@style,
	"Previous Balance",
	@begin_balance,
	@begin_balance,
	@previous_due)

	
insert into
	#statement(
		section,
		style,
		transaction_id,
		transaction_type_id,
		activity,
		date,
		amount,
		balance)
select
	section = @statement_string,
	style = "background:#fff;border: none", /* 0px solid white", */
	transaction_id = a.account_transaction_id,
	a.transaction_type_id,
	activity = b.name, 
	date = a.transaction_date,
	a.amount,
	a.amount
from
	account_transactions a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
	a.external_account_id = @external_account_id
and
	a.transaction_date >= @billing_cutoff
and
	a.transaction_type_id != @transaction_type_id
and
	a.transaction_date < getdate() /* MARKR */
and
	a.transaction_type_id = @payment_transaction_type_id
order by
	a.transaction_date

select
	@total_payments = sum(amount)
from
	#statement
where
	transaction_type_id = @payment_transaction_type_id
if @total_payments = NULL
	select
		@total_payments = 0.0

insert into
	#statement(
		section,
		style,
		activity)
values(
	@statement_string,
	"font-weight:bold;border-top:2px solid #999;margin-bottom:10px;color:#963;background:#fff",
	"New Activity (" + @period_string + ")")



