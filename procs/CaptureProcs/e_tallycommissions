use
	risk_home
go

drop procedure
	e_tallycommissions
go

create procedure
	e_tallycommissions
		@login varchar(50),
		@trade_date datetime,
		@committed_capture_id int,
		@tally_type varchar(50),
		@client_buys_sells varchar(50),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@quantity numeric(30,4),
		@value_date datetime
as

	
declare @commissions int
declare @commission_id int
declare @client_user varchar(50)
declare @price float
declare @trade_id int
declare @deal_id int


select
	@commission_id = 0
select
	@commissions = count(*)
from
	commissions
where
	committed_capture_id = @committed_capture_id
and
	commission_id > @commission_id

while @commissions > 0
begin
	select
		@commission_id = min(commission_id)
	from
		commissions
	where
		committed_capture_id = @committed_capture_id
	and
		commission_id > @commission_id


	select
		@client_user = a.symbol,
		@price = b.price
	from
		traders a,
		commissions b
	where
		a.trader_id = b.trader_id
	and
		b.commission_id = @commission_id


	select
		@deal_id = NULL,
		@trade_id = NULL

	exec
		api_tallyclienttrade
			@login = @login,
			@tally_type = @tally_type,
			@client_user = @client_user,
			@client_buys_sells = @client_buys_sells,
			@dealt_currency = @dealt_currency,
			@counter_currency = @counter_currency,
			@quantity = @quantity,
			@price = @price,
			@value_date = @value_date,
			@deal_id = @deal_id output,
			@trade_id = @trade_id output

	update
		trades
	set
		trade_date = @trade_date
	where
		trade_id = @trade_id
			

	select
		@commissions = count(*)
	from
		commissions
	where
		committed_capture_id = @committed_capture_id
	and
		commission_id > @commission_id
end



go
