use
	risk_faros
go

drop procedure
	r_committedvolumefordate
go

create procedure
	r_committedvolumefordate
		@login varchar(50),
		@bo_trade_date datetime,
		@min_ticket_size float=NULL,
		@commit_status varchar(50) output,
		@evaluation_currency varchar(30) output,
		@spot_trades int output,
		@spot_volume float output,
		@forward_trades int output,
		@forward_volume float output,
		@forward_option_trades int output,
		@forward_option_volume float output,
		@exotic_trades int output,
		@exotic_volume float output,
		@forward_swap_trades int output,
		@forward_swap_volume float output,
		@futures_trades int output,
		@futures_volume float output,
		@futures_option_trades int output,
		@futures_option_volume float output

as


declare @commit_date datetime
declare @swap_near_trades int
declare @swap_near_volume float
declare @swap_far_trades int
declare @swap_far_volume float

select
	@evaluation_currency = a.symbol
from
	products a,
	funds b
where
	a.product_id = b.evaluation_currency_id 


select
	@commit_date = max(a.transaction_date)
from
	int_account_transactions a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
	b.name = "Front Office Commit"
if @commit_date = NULL
begin
	select
		@commit_status = "Zero P&Ls Committed"
	return
end

if @commit_date < @bo_trade_date
begin
	select
		@commit_status = "No P&L Commit For Date"
	return
end

select
	@commit_status = "Committed"

create table
	#volumes(
		trade_type varchar(50),
		num_trades int NULL,
		volume float NULL)

if @min_ticket_size = NULL
begin
	select bo_trade_date = @bo_trade_date
		
	insert into
		#volumes
	select
		c.name,
		count(a.trade_id),
		sum(a.evaluation_notional)
	from
		committed_daily_revals a,
		trades b,
		trade_types c
	where
		a.trade_id = b.trade_id
	and
		b.trade_type_id = c.trade_type_id
	and
		convert(char(11), a.bo_trade_date, 1) = convert(char(11), @bo_trade_date, 1)
	and
		convert(char(11), a.bo_trade_date, 1) = convert(char(11), a.reval_date, 1)
	group by
		c.name
end
else
begin
	insert into
		#volumes
	select
		c.name,
		count(a.trade_id),
		sum(a.evaluation_notional)
	from
		committed_daily_revals a,
		trades b,
		trade_types c
	where
		a.trade_id = b.trade_id
	and
		b.trade_type_id = c.trade_type_id
	and	
		convert(char(11), a.bo_trade_date, 1) = convert(char(11), @bo_trade_date, 1)
	and
		convert(char(11), a.bo_trade_date, 1) = convert(char(11), a.reval_date, 1)
	and
		a.evaluation_notional >= @min_ticket_size
	group by
		c.name

	create table
		#min_tickets(
			trade_type varchar(50),
			num_trades int NULL,
			volume float NULL)
	insert into
		#min_tickets
	select
		c.name,
		count(a.trade_id),
		sum(a.evaluation_notional - a.evaluation_notional + @min_ticket_size)
	from
		committed_daily_revals a,
		trades b,
		trade_types c
	where
		a.trade_id = b.trade_id
	and
		b.trade_type_id = c.trade_type_id
	and	
		convert(char(11), a.bo_trade_date, 1) = convert(char(11), @bo_trade_date, 1)
	and
		convert(char(11), a.bo_trade_date, 1) = convert(char(11), a.reval_date, 1)
	and
		a.evaluation_notional < @min_ticket_size
	group by
		c.name

	update
		#volumes
	set
		a.num_trades = a.num_trades + b.num_trades,
		a.volume = a.volume + b.volume
	from
		#volumes a,
		#min_tickets b
	where
		a.trade_type = b.trade_type
end

select
	@spot_trades = num_trades,
	@spot_volume = volume
from
	#volumes
where
	trade_type = "Spot"
if @spot_trades != NULL and @spot_trades > 0 and @spot_volume = NULL
begin
	select
		@commit_status = "Incomplete spot volume"
	return
end

select
	@forward_trades = num_trades,
	@forward_volume = volume
from
	#volumes
where
	trade_type = "Forward"
if @forward_trades != NULL and @forward_trades > 0 and @forward_volume = NULL
begin
	select
		@commit_status = "Incomplete forward volume"
	return
end


select
	@forward_option_trades = num_trades,
	@forward_option_volume = volume
from
	#volumes
where
	trade_type = "Option"
if @forward_option_trades != NULL and @forward_option_trades > 0 and @forward_option_volume = NULL
begin
	select
		@commit_status = "Incomplete forward option volume"
	return
end
if @forward_option_volume = NULL
	select
		@forward_option_trades = 0,
		@forward_option_volume = 0.0

select
	@exotic_trades = num_trades,
	@exotic_volume = volume
from
	#volumes
where
	trade_type = "Exotic"
if @exotic_trades != NULL and @exotic_trades > 0 and @exotic_volume = NULL
begin
	select
		@commit_status = "Incomplete exotic volume"
	return
end
if @exotic_volume = NULL
	select
		@exotic_trades = 0,
		@exotic_volume = 0.0

select
	@swap_near_trades = num_trades,
	@swap_near_volume = volume
from
	#volumes
where
	trade_type = "Swap Near"
if @swap_near_trades != NULL and @swap_near_trades > 0 and @swap_near_volume = NULL
begin
	select
		@commit_status = "Incomplete swap near volume"
	return
end
if @swap_near_volume = NULL
	select
		@swap_near_trades = 0,
		@swap_near_volume = 0.0


select
	@swap_far_trades = num_trades,
	@swap_far_volume = volume
from
	#volumes
where
	trade_type = "Swap Near"
if @swap_far_trades != NULL and @swap_far_trades > 0 and @swap_far_volume = NULL
begin
	select
		@commit_status = "Incomplete swap far volume"
	return
end
if @swap_far_volume = NULL
	select
		@swap_far_trades = 0,
		@swap_far_volume = 0.0
	
select
	@forward_swap_trades = @swap_near_trades + @swap_far_trades,
	@forward_swap_volume = @swap_near_volume + @swap_far_volume


select
	@futures_trades = num_trades,
	@futures_volume = volume
from
	#volumes
where
	trade_type = "Future"
if @futures_trades != NULL and @futures_trades > 0 and @futures_volume = NULL
begin
	select
		@commit_status = "Incomplete futures volume"
	return
end
if @futures_volume = NULL
	select
		@futures_trades = 0,
		@futures_volume = 0.0
	

select
	@futures_option_trades = num_trades,
	@futures_option_volume = volume
from
	#volumes
where
	trade_type = "Future Option"
if @futures_option_trades != NULL and @futures_option_trades > 0 and @futures_option_volume = NULL
begin
	select
		@commit_status = "Incomplete futures option volume"
	return
end
if @futures_option_volume = NULL
	select
		@futures_option_trades = 0,
		@futures_option_volume = 0.0




go
	
