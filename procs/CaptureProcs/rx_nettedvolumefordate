use
	risk_cfe
go

if object_id("rx_nettedvolumefordate") != NULL
    drop procedure
	rx_nettedvolumefordate
go

create procedure
	rx_nettedvolumefordate
		@login varchar(30),
		@run_name varchar(50),
		@trade_date datetime,
		@evaluation_currency varchar(50)=NULL,
		@min_size float=NULL,
		@reporting_source varchar(50)=NULL,
		@spot_trades int output,
		@spot_volume float output,
		@forward_trades int output,
		@forward_volume float output,
		@forward_option_trades int output,
		@forward_option_volume float output,
		@exotic_trades int output,
		@exotic_volume float output,
		@forward_swap_trades int output,
		@forward_swap_volume float output
as

declare @date datetime
declare @evaluation_currency_id int
declare @run_id int

declare @missing_settles int
declare @begin_date datetime
declare @end_date datetime

select
	@begin_date = @trade_date

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @evaluation_currency = NULL
	select
		@evaluation_currency = "USD"

select
	@evaluation_currency_id = product_id
from
	products
where
	symbol = @evaluation_currency
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Evaluation currency not found",
		evaluation_currency = @evaluation_currency
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@date output
	select
		@date = NULL

	exec
		r_daterangefordate
			@end_date,
			@date output,
			@end_date output
end
		
create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts

create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#notifications(
		deal_id int,
		source_id int,
		notify_date datetime)


create table
	#trades(
		trade_id int,
		deal_id int,
		user_id int,
		internal_account_id int,
		external_account_id int,
		quantity numeric(30,4),
		contract_id int,
		multiplier int NULL,
		price float,
		trade_date datetime,
		trader_id int,
		strategy_id int,
		status_id int,
		broker_id int,
		product_id int NULL,
		conversion_rate float NULL,
		evaluation_value float NULL,
		volume_equivalent float NULL,
		price_source varchar(20) NULL)


if @reporting_source = NULL or @reporting_source = "All"
begin
	insert into
		#notifications
	select
		a.deal_id,
		a.source_id,
		max(a.notify_date)
	from
		deal_notifications a,
		statuses b
	where
		a.status_id = b.status_id
	and
		b.name = "Sent"
	and
		a.notify_date > @begin_date
	and
		a.notify_date <= @end_date
	group by
		a.deal_id,
		a.source_id
	having
		a.notify_date = max(a.notify_date)

	insert into
		#trades(
			trade_id,
			deal_id,
			user_id,	
			internal_account_id,
			external_account_id,
			quantity,
			contract_id,
			price,
			trade_date,
			trader_id,
			strategy_id,
			status_id,
			broker_id)
	select
		a.trade_id,
		a.deal_id,
		a.user_id,
		a.internal_account_id,
		a.external_account_id,
		a.quantity,
		a.contract_id,
		a.price,
		a.trade_date,
		a.trader_id,
		a.strategy_id,
		a.status_id,
		a.broker_id 
	from
		aggregated_trades a,
		#internal_accounts b,
		#external_accounts c,
		#traders d,
		#strategies e,
		#brokers f
	where
		a.internal_account_id = b.internal_account_id
	and
		a.external_account_id = c.external_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id= f.broker_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date

end
else
begin
	insert into
		#notifications
	select
		a.deal_id,
		a.source_id,
		max(a.notify_date)
	from
		deal_notifications a,
		statuses b,
		sources c
	where
		a.source_id = c.source_id
	and
		a.status_id = b.status_id
	and
		b.name = "Sent"
	and
		c.name = @reporting_source
	and
		a.notify_date > @begin_date
	and
		a.notify_date <= @end_date
	group by
		a.deal_id,
		a.source_id
	having
		a.notify_date = max(a.notify_date)

	insert into
		#trades(
			trade_id,
			deal_id,
			user_id,	
			internal_account_id,
			external_account_id,
			quantity,
			contract_id,
			price,
			trade_date,
			trader_id,
			strategy_id,
			status_id,
			broker_id)
	select
		a.trade_id,
		a.deal_id,
		a.user_id,
		a.internal_account_id,
		a.external_account_id,
		a.quantity,
		a.contract_id,
		a.price,
		a.trade_date,
		a.trader_id,
		a.strategy_id,
		a.status_id,
		a.broker_id 
	from
		aggregated_trades a,
		#internal_accounts b,
		#external_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
		#notifications g
	where
		a.internal_account_id = b.internal_account_id
	and
		a.external_account_id = c.external_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id= f.broker_id
	and
		a.deal_id = g.deal_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
end



update
	#trades
set
	a.product_id = b.product_id,
	a.multiplier = b.quantity
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#trades
set
	a.product_id = b.product_id,
	a.multiplier = c.quantity
from
	#trades a,
	forwards b,
	futures c,
	future_contracts d
where
	a.contract_id = d.contract_id
and
	d.future_id = c.future_id
and
	c.forward_id = b.contract_id

update
	#trades
set
	a.product_id = b.product_id,
	a.multiplier = c.quantity	
from
	#trades a,
	forwards b,
	futures c,
	future_contracts d,
	options e,
	option_expirations f,
	option_contracts g
where
	a.contract_id = g.contract_id
and
	g.option_expiration_id = f.option_expiration_id
and
	f.option_id = e.option_id
and
	e.underlying_contract_id = d.contract_id
and
	d.future_id = c.future_id
and
	c.forward_id = b.contract_id
	

update
	#trades
set
	a.product_id = b.product_id,
	a.multiplier = b.quantity
from
	#trades a,
	forwards b,
	options c,
	option_expirations d,
	option_contracts e
where
	a.contract_id = e.contract_id
and
	e.option_expiration_id = d.option_expiration_id
and
	d.option_id = c.option_id
and
	c.underlying_contract_id = b.contract_id


update
	#trades
set
	a.product_id = b.product_id,
	a.multiplier = b.quantity
from
	#trades a,
	forwards b,
	options c,
	option_expirations d,
	exotic_contracts e
where
	a.contract_id = e.contract_id
and
	e.option_expiration_id = d.option_expiration_id
and
	d.option_id = c.option_id
and
	c.underlying_contract_id = b.contract_id

update
	#trades
set
	a.conversion_rate = b.price,
	a.price_source = "BO"
from
	#trades a,
	bo_spot_settles b,
	forwards c
where
	a.product_id = c.product_id
and
	c.currency_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	b.price_date = @end_date

update
	#trades
set
	a.conversion_rate = 1.0 / b.price,
	a.price_source = "BO"
from
	#trades a,
	bo_spot_settles b,
	forwards c
where
	a.product_id = c.currency_id
and
	c.product_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	a.conversion_rate = NULL
and
	b.price_date = @end_date

update
	#trades
set
	conversion_rate = 1.0,
	price_source = "NATIVE"
where
	product_id = @evaluation_currency_id


/* Use the front office settles for any remaining missing prices */
update
	#trades
set
	a.conversion_rate = b.price,
	a.price_source = "FO"
from
	#trades a,
	prices b,
	forwards c
where
	a.product_id = c.product_id
and
	c.currency_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	b.price_date = @end_date
and
	a.conversion_rate = NULL

update
	#trades
set
	a.conversion_rate = 1.0 / b.price,
	a.price_source = "FO"
from
	#trades a,
	prices b,
	forwards c
where
	a.product_id = c.currency_id
and
	c.product_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	a.conversion_rate = NULL
and
	b.price_date = @end_date


update
	#trades
set
	a.conversion_rate = b.price,
	a.price_source = "CURRENT"
from
	#trades a,
	current_prices b,
	forwards c
where
	a.product_id = c.product_id
and
	c.currency_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	a.conversion_rate = NULL


update
	#trades
set
	a.conversion_rate = 1.0 / b.price,
	a.price_source = "CURRENT"
from
	#trades a,
	current_prices b,
	forwards c
where
	a.product_id = c.currency_id
and
	c.product_id = @evaluation_currency_id
and
	c.contract_id = b.contract_id
and
	a.conversion_rate = NULL

update
	#trades
set
	evaluation_value = abs(quantity) * multiplier * conversion_rate
	
update
	#trades
set
	evaluation_value = abs(quantity) * multiplier
where
	product_id = @evaluation_currency_id


select
	@missing_settles = count(*)
from
	#trades
where
	evaluation_value = NULL
if @missing_settles != 0
begin
	select
		*
	from
		#trades
	where
		evaluation_value = NULL

	return
end


if @min_size = NULL
	select
		@min_size = 0.0

update
	#trades
set
	volume_equivalent = evaluation_value
where
	evaluation_value >= @min_size

update
	#trades
set
	volume_equivalent = @min_size
where
	evaluation_value < @min_size


	
select
	run_name = @run_name,
	begin_date = @begin_date,
	end_date = @end_date,
	evaluation_date = getdate()


create table
	#by_instrument(
		instrument varchar(50),
		num_trades int,
		total_volume float)
insert into
	#by_instrument
select
	a.name,
	count(c.trade_id),
	sum(c.volume_equivalent)
from
	instruments a,
	contracts b,
	#trades c
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = c.contract_id
group by
	a.name
order by
	a.name

select
	@spot_trades = 0,
	@spot_volume = 0.0

select
	@forward_trades = num_trades,
	@forward_volume = total_volume
from
	#by_instrument
where
	instrument = "Forward"

select
	@forward_option_trades = num_trades,
	@forward_option_volume = total_volume
from
	#by_instrument
where
	instrument = "Option"

select
	@exotic_trades = num_trades,
	@exotic_volume = total_volume
from
	#by_instrument
where
	instrument = "Exotic"





go
