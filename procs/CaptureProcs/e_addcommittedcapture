use
	risk_home
go

drop procedure
	e_addcommittedcapture
go

create procedure
	e_addcommittedcapture
		@login varchar(50),
		@counterparty varchar(50),
		@screen_name varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(15),
		@market_counterparty varchar(50),
		@symbol varchar(50),
		@client_price float,
		@client_val_date datetime,
		@market_price float,
		@market_val_date datetime

as


declare @committed_capture_id int
declare @counterparty_id int
declare @tico_account_id int
declare @trader_id int
declare @market_counterparty_id int
declare @contract_id int


select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Counterparty not found",
		counterparty = @counterparty
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @screen_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Screen name not found",
		screen_name = @screen_name
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @client_user
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Client user not found",
		client_user = @client_user
	return
end

if @client_buys_sells not in("Client Buys", "Client Sells")
begin
	select
		status = "Error",
		message = "Client Buys Sells unresolvable",
		client_buys_sells = @client_buys_sells
	return
end

select
	@market_counterparty_id = counterparty_id
from
	counterparties
where
	name = @market_counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Market counterparty not found",
		market_counterparty = @market_counterparty
	return
end


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		contract = @symbol
	return
end


exec
	j_nextkey
		"committed_captures",
		@committed_capture_id output

insert into
	committed_captures
values(
	@committed_capture_id,
	@counterparty_id,
	NULL,
	@tico_account_id,
	@trader_id,
	@client_buys_sells,
	@market_counterparty_id,
	@contract_id,
	@client_price,
	@client_val_date,
	@market_price,
	@market_val_date,
	getdate())

exec
	e_committedcaptures
		@login


go

