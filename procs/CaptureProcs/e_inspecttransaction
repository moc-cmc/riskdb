use
	risk_home
go

drop procedure
	e_inspecttransaction
go
	
create procedure
	e_inspecttransaction
		@login varchar(50),
		@transaction_id int
as


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_payment",
	"Edit Payment",
	NULL)

select * from #meta

select
	section = "Transaction Details",
	transaction_id = a.account_transaction_id,
	a.transaction_date,
	entered_by = b.login,
	account = c.symbol,
	transaction_type = d.name,
	a.amount,
	currency = e.symbol,
	a.note,
	edit_payment = "EDIT"
from
	account_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d,
	products e
where
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	a.currency_id = e.product_id
and
	a.account_transaction_id = @transaction_id


select
	section = "Associated Account Transactions",
	product_transaction_id
from
	invoice_transactions
where
	account_transaction_id = @transaction_id
	

select
	section = "Transaction Edit History",
	transaction_id = a.account_transaction_id,
	a.transaction_date,
	entered_by = b.login,
	account = c.symbol,
	transaction_type = d.name,
	a.amount,
	currency = e.symbol,
	a.note,
	a.archive_date,
	archived_by = f.login
from
	account_transaction_edits a,
	tico_accounts b,
	external_accounts c,
	transaction_types d,
	products e,
	tico_accounts f
where
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	a.currency_id = e.product_id
and
	a.tico_account_id = f.account_id
and
	a.account_transaction_id = @transaction_id




go
