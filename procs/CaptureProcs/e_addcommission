use
	risk_home
go

drop procedure
	e_addcommission
go

create procedure
	e_addcommission
		@login varchar(50),
		@committed_capture_id int,
		@counterparty varchar(50),
		@symbol varchar(50),
		@sales_person varchar(50),
		@price float

as


declare @commission_id int
declare @trader_id int


select
	@trader_id = trader_id
from
	traders
where
	symbol = @sales_person
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Sales person not found",
		sales_person = @sales_person
	return
end


exec
	j_nextkey
		"commissions",
		@commission_id output


insert into
	commissions
values(
	@commission_id,
	@committed_capture_id,
	@trader_id,
	@price)

exec
	e_commissions
		@login,
		@committed_capture_id


go

