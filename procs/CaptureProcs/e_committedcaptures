use
	risk_home
go

drop procedure
	e_committedcaptures
go

create procedure
	e_committedcaptures
		@login varchar(50),
			@as_of_date datetime=NULL
as

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"commissions",
	"Commissions",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"add_committed_capture",
	"Add Committed Capture",
	NULL,
	NULL)

select * from #links

if @as_of_date = NULL
	select
		@as_of_date = getdate()

create table
	#captures(
		committed_capture_id int NULL,
		contract_id int,
		counterparty_id int,
		as_of_date datetime)

insert into
	#captures(
		contract_id,
		counterparty_id,
		as_of_date)
select
	contract_id,
	counterparty_id,
	max(as_of_date)
from
	committed_captures
where
	as_of_date <= @as_of_date
group by
	contract_id,
	counterparty_id

update
	#captures
set
	a.committed_capture_id = b.committed_capture_id
from
	#captures a,
	committed_captures b
where
	a.counterparty_id = b.counterparty_id
and
	a.as_of_date = b.as_of_date
		

select
	add_committed_capture = "ADD NEW COMMITTED CAPTURE"

select
	a.committed_capture_id,
	as_of_date = convert(char(11), a.as_of_date, 1),
	counterparty = b.name,
	screen_name = c.login,
	client_user = d.symbol,
	a.client_buys_sells,
	market_counterparty = e.name,
	f.symbol,
	a.client_price,
	client_val_date = convert(char(11), a.client_val_date, 1),
	a.market_price,
	market_val_date = convert(char(11), a.market_val_date, 1),
	commissions = "COMMISSIONS"
from
	committed_captures a,
	counterparties b,
	tico_accounts c,
	traders d,
	counterparties e,
	contracts f
where
	a.counterparty_id = b.counterparty_id
and
	a.tico_account_id = c.account_id
and
	a.trader_id = d.trader_id
and
	a.market_counterparty_id = e.counterparty_id
and
	a.contract_id = f.contract_id
order by
	b.name,
	f.symbol



go
