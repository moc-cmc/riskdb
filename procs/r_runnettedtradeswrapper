drop procedure r_runnettedtradeswrapper
go

create procedure r_runnettedtradeswrapper @login varchar(25)
as

create table
       #links(
               meta_type char(200),
               column char(30),
               link char(200) NULL,
               arguments char(255) NULL,
               format char(20) NULL)

insert into
	#links
values(
	"Column Link",
	"run_name",
	"Run Netted Trades",
	NULL,
	NULL)


select * from #links

select
	run_name = a.name 
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
order by
	name

go


