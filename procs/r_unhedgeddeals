
if object_id("r_unhedgeddeals") != NULL
    drop procedure
        r_unhedgeddeals
go

create procedure
	r_unhedgeddeals
		@login varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @previous_day datetime

create table
	#meta(
		meta_type char(50),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)


insert into
	#meta
values(
	"Column Link",
	"previous_day",
	"Unhedged Deals",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"hedge_candidates",
	"Deal Hedge Candidates",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta



if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date = NULL
	select
		@end_date = dateadd(day, 1, @begin_date)


exec
	r_prevbusinessday
		@begin_date,
		@previous_day output

select
	previous_day = "Previous Day",
	begin_date = convert(char(11), @previous_day, 1)

create table
	#deals(
		deal_id int,
		symbol varchar(50),
		net_position numeric(30,4))

insert into
	#deals
select
	a.deal_id,
	b.symbol,
	net_position = sum(a.quantity)
from
	trades a,
	contracts b
where
	a.contract_id = b.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
group by
	a.deal_id,
	b.symbol
having
	sum(a.quantity) != 0

select
	deal_id,
	symbol,
	net_position,
	hedge_candidates = "HEDGE CANDIDATES"
from
	#deals
order by
	symbol

go
