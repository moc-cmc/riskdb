drop procedure
	r_editrollspreadgroupname
go

create procedure
	r_editrollspreadgroupname
		@login varchar(50),
		@name varchar(50),
		@new_name varchar(50)
		
as


declare @roll_spread_group_id int

select
	@roll_spread_group_id = roll_spread_group_id
from
	roll_spread_groups
where
	name = @name
if @roll_spread_group_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding group for name",
		name = @name

	exec
        	r_managerollspreadgroups
                	@login

	return
end

update
	roll_spread_groups
set
	name = @new_name
where
	roll_spread_group_id = @roll_spread_group_id
	
exec
	r_managerollspreadgroups
		@login,
		@new_name

go
