drop procedure
	ag_clientsettlementslog
go

create procedure
	ag_clientsettlementslog
		@login varchar(50),
		@value_date datetime,
		@prime_broker varchar(50)
as


declare @fund_id int
declare @evaluation_currency_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
    #meta
values(
    "Column Format",
    "amount",
    "Number",
    "#,##0.00")

insert into
        #meta
values(
        "Column Link",
        "close_settle_balances",
        "Close Settle Balances",
        NULL)

insert into
	#meta
values(
	"Column Hidden",
	"value_date",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Hidden",
        "prime_broker",
        NULL,
        NULL)


insert into
        #meta
values(
        "Column Hidden",
        "settle_date",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "display",
        NULL,
        NULL)

insert into
	#meta
values(
	"Column Hidden",
	"balance",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"cash_settle_recon",
	"Cash Settle Recon",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"settle",
	"Add Client FX Settlement",
	NULL) 

insert into
        #meta
values(
        "Column Link",
        "unsettle",
        "Delete Client FX Settlement",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "audit_log",
        "Client Account Settlements Log",
        NULL)

insert into
	 #meta
values(
        "Column Link",
        "settle_all",
        "Add All Client FX Settlements",
	NULL)


insert into
	#meta
values(
	"Column Format",
	"settled_fx",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"unsettled_fx",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"maturing_fx",
	"Number",
	"#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id


create table
    #prime_brokers(
    	prime_broker_id int)

insert into
	#prime_brokers
select
	prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = @prime_broker
if @@rowcount = 0
begin
	insert into 
 		#prime_brokers
	select
    		prime_broker_id
	from
        	prime_brokers
end


create table
    #counterparty_accounts(
        external_account_id int)

insert into
    #counterparty_accounts
select
    a.external_account_id
from
    external_accounts a,
    external_account_prime_brokers b,
    external_account_types c,
    #prime_brokers d
where
    a.external_account_id = b.external_account_id
and
    a.external_account_type_id = c.external_account_type_id
and
    b.prime_broker_id = d.prime_broker_id
and
    c.name = "Counterparty"

create table
    #client_accounts(
        external_account_id int)

insert into
    #client_accounts
select
    a.external_account_id
from
    external_accounts a,
    external_account_prime_brokers b,
    external_account_types c,
    #prime_brokers d
where
    a.external_account_id = b.external_account_id
and
    a.external_account_type_id = c.external_account_type_id
and
    b.prime_broker_id = d.prime_broker_id
and
    c.name = "Client"

delete 
    #client_accounts
from
        #client_accounts a,
        external_accounts b,
    	settlement_methods c
where
        a.external_account_id = b.external_account_id
and
    b.settlement_method_id = c.settlement_method_id
and
    c.name = "Exclude"

delete 
    #counterparty_accounts
from
         #counterparty_accounts a,
        external_accounts b,
    	settlement_methods c
where
        a.external_account_id = b.external_account_id
and
    b.settlement_method_id = c.settlement_method_id
and
    c.name = "Exclude"



create table
	#external_accounts(
		external_account_id int)

insert into
	#external_accounts
select
	a.external_account_id
from
	fund_external_accounts a,
	#client_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.fund_id = @fund_id


delete
	#external_accounts
from
	#external_accounts a,
	#counterparty_accounts b
where
	a.external_account_id = b.external_account_id


create table
	#trades(
		trade_id int,
		external_account_id int,
		contract_id int,
		product_id int,
		currency_id int,
		dealt_amount numeric(30,4),
		counter_amount numeric(30,4),
		value_date datetime)
insert into
	#trades(
		trade_id,
		external_account_id,
		contract_id,
		product_id,
		currency_id,
		dealt_amount,
		counter_amount,
		value_date)
select
	a.trade_id,
	a.external_account_id,
	a.contract_id,
	b.product_id,
	b.currency_id,
	a.quantity * -1.0,
	a.quantity * a.price,
	a.value_date
from
	trades a,
	forwards b,
	#external_accounts c
where
	a.external_account_id = c.external_account_id
and
	a.contract_id = b.contract_id
and
	convert(date, @value_date) = convert(date, a.value_date)


create table
	#trade_balances(
		external_account_id int,
		product_id int,
		balance float)
insert into
	#trade_balances(
		external_account_id,
		product_id,
		balance)
select
	external_account_id,
	product_id,
	sum(dealt_amount)
from
	#trades
group by
	external_account_id,
	product_id

insert into
	#trade_balances(
		external_account_id,
		product_id,
		balance)
select
	external_account_id,
	currency_id,
	sum(counter_amount)
from
	#trades
group by
	external_account_id,
	currency_id


create table
	#net_balances(
		external_account_id int,
		product_id int,
		balance float)
insert into
	#net_balances
select
	external_account_id,
	product_id,
	sum(balance)
from
	#trade_balances
group by
	external_account_id,
	product_id

create table
	#settlements(
		id int identity,
		section varchar(200),
		style varchar(250),
		external_account_id int,
		product_id int,
		account varchar(50),
		settlement_method varchar(50) NULL,
		product varchar(50),
		balance float,
		settled_fx float NULL,
		closed_settled float NULL,
		unsettled_fx float NULL,
		settle varchar(50) NULL,
		unsettle varchar(50) NULL)
insert into
	#settlements(
		section,
		style,
		external_account_id,
		product_id,
		account,
		product,
		balance)
select
	section = "Client Settlements For " + rtrim(convert(varchar(11), @value_date)),
	style = "background:#FFFFFF;border: 1px solid white",
	a.external_account_id,
	a.product_id,
	account = b.symbol,
	product = c.symbol,
	a.balance
from
	#net_balances a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
order by
	b.symbol,
	c.symbol

update
	#settlements
set
	a.settlement_method = c.name
from
	#settlements a,
	external_accounts b,
	settlement_methods c
where
	a.external_account_id = b.external_account_id
and
	b.settlement_method_id = c.settlement_method_id

update
	#settlements
set
	settled_fx = 0.0,
	unsettled_fx = 0.0

create table
	#closed_settled_fx(
		external_account_id int,
		product_id int,
		amount float)

create table
	#settled_fx(
		external_account_id int,
		product_id int,
		amount float)
insert into
	#settled_fx
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	transaction_types b,
	#external_accounts c
where
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = b.transaction_type_id
and
	b.name = "FX Settlement"
and
	convert(date, a.transaction_date) = convert(date, @value_date)
group by
	a.external_account_id,
	a.currency_id

insert into
	#closed_settled_fx
select
	a.external_account_id,
	a.currency_id,
	sum(amount)
from
	closed_account_transactions a,
	transaction_types b,
	#external_accounts c
where
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = b.transaction_type_id
and
	b.name = "FX Settlement"
and
	convert(date, a.transaction_date) = convert(date, @value_date)
group by
	a.external_account_id,
	a.currency_id

update
	#settlements
set
	a.settled_fx = b.amount
from
	#settlements a,
	#settled_fx b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id

update
	#settlements
set
	a.closed_settled = b.amount
from
	#settlements a,
	#closed_settled_fx b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id

	
create table
	#net_converted(
		external_account_id int,
		product_id int,
		amount float)
insert into
	#net_converted
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	closed_account_transactions a,
	transaction_types b,
	#external_accounts c
where
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = b.transaction_type_id
and
	b.name = "FX Settlement"
and
	convert(date, a.transaction_date) = convert(date, @value_date)
group by
	a.external_account_id,
	a.currency_id


update
	#settlements
set
	a.settled_fx = b.amount
from
	#settlements a,
	#net_converted b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id

update
	#settlements
set
	unsettled_fx = balance - settled_fx

update
	#settlements
set
	settle = "SETTLE"
where
	abs(unsettled_fx) >= .01
and
	/* settlement_method not in("Delivery", "Exclude") */
	settlement_method not in("Exclude")
and
	balance != 0

update
	#settlements
set
	unsettle = "UNSETTLE"
where
	closed_settled = NULL
and 
	abs(unsettled_fx) <= .01
and
	balance != 0

select
	style = "background:#FFFFFF;border: 1px solid white",
	cash_settle_recon = "Back To Cash Settle Recon",
	prime_broker = @prime_broker,
	value_date = @value_date,
	settle_date = @value_date,
	display = "N",
	close_settle_balances = "Close Settle Balances",
	settle_all = "SETTLE ALL"

select
	section,
	style,
	account,
	settlement_method,
	product,
	maturing_fx = balance,
	settled_fx,
	closed_settled,
	unsettled_fx,
	settle,
	unsettle,
	currency = product,
	balance = convert(numeric(30,2), balance),
	value_date = @value_date
from
	#settlements
order by
	id

create table
        #transaction_logs(
                settled_by varchar(50),
                external_account varchar(50),
                status varchar(50),
                currency varchar(50),
                amount float,
                settle_date datetime,
                timestamp datetime,
                section varchar(50),
                style varchar(50))

insert into
        #transaction_logs
select

        settled_by = b.login,
        account = c.symbol,
        status = d.name,
        product = e.symbol,
        a.amount,
        a.settle_date,
        timestamp = a.timestamp,
        section = "Settlement Audit Log",
        style = "background:#FFFFFF;border: 1px solid white"

from
        transaction_logs a,
        tico_accounts b,
        external_accounts c,
        statuses d,
        products e
where
        a.settled_by = b.account_id
and
        a.external_account_id = c.external_account_id
and
        a.status_id = d.status_id
and
        a.currency_id = e.product_id
and
        d.name in("Settle FX Settlement", "Unsettle FX Settlement")
and
        a.settle_date = @value_date
order by
        a.timestamp DESC

select
        settled_by,
        external_account,
        status,
        product = currency,
        amount,
        date = convert(varchar(11), settle_date, 1),
        timestamp,
        section,
        style
from
        #transaction_logs
order by
        timestamp DESC


go
