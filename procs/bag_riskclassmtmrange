	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@subtotal_style = "background:#FFFFFF;border: 1px solid white;font-style:italic;font-color:grey",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


create table
	#risk_classes(
		risk_class_id int,
		min_date datetime NULL,	
		max_date datetime NULL,
		days int NULL,
		volume float NULL,
		avg_volume float NULL,
		settled_pl float NULL,
		net float NULL,
		avg_net float NULL,
		yield float NULL)

delete

from
	beta_risk_class_mtms
where
	volume = NULL
delete

from
	beta_risk_class_mtms
where
	open_equity = NULL

insert into
	#risk_classes(
		risk_class_id,
		min_date,
		max_date,
		days,
		volume,
		avg_volume,
		settled_pl,
		net,
		avg_net)
select
	risk_class_id,
	min(trade_date),
	max(trade_date),
	count(risk_class_id),
	sum(volume),
	avg(volume),
	sum(settled_pl),
	sum(open_equity),
	avg(open_equity)
from
	beta_risk_class_mtms
where
	convert(date, trade_date) >= convert(date, @begin_date)
and
	convert(date, trade_date) <= convert(date, @end_date)
group by
	risk_class_id

update
	#risk_classes
set
	yield = net / (volume / 1000000.00)
where
	abs(volume) > 0.0


create table
	#output(
		id int identity,
		style varchar(250) NULL,
		risk_class_id int NULL,
		name varchar(50) NULL,
		min_date datetime NULL,
		max_date datetime NULL,
		days int NULL,
		volume float NULL,
		avg_volume float NULL,
		settlement float NULL,
		net float NULL,
		avg_net float NULL,
		yield float NULL)


insert into
	#output(
		style,
		risk_class_id,
		name,
		min_date,
		max_date,
		days,
		volume,
		avg_volume,
		settlement,
		net,
		avg_net,
		yield)
select
	style = @style,
	a.risk_class_id,
	b.name,
	a.min_date,
	a.max_date,
	a.days,
	a.volume,
	a.avg_volume,
	a.settled_pl,
	a.net,
	a.avg_net,
	a.yield
from
	#risk_classes a,
	risk_classes b
where
	a.risk_class_id = b.risk_class_id
order by
	b.name

select
	@volume = sum(volume),
	@net = sum(net),
	@days = sum(days),
	@settlement = sum(settlement)
from
	#output

if abs(@volume) > 0.0
	select
		@yield = @net / (@volume / 1000000.00)

