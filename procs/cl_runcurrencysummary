
if object_id("cl_runcurrencysummary") != NULL
    drop procedure
        cl_runcurrencysummary
go

create procedure
	cl_runcurrencysummary
		@login varchar(30),
		@run_name varchar(50),
		@value_date datetime=NULL
as

declare @run_id int
declare @contracts int
declare @contract_id int
declare @value_dates int
declare @trades int
declare @trade_id int
declare @product_id int
declare @products int
declare @give_total_quantity float
declare @get_total_quantity float
declare @total_quantity float
declare @quantity numeric(30,2)
declare @product char(20)
declare @contract char(20)
declare @next_value_date datetime
declare @price_style char(200)
declare @is_committed int
declare @transaction_type_id int
declare @unrolled_positions int


create table
	#links(
		meta_type char(100),
		column char(30),
		link char(100) NULL,
		arguments char(255) NULL,
		format char(30) NULL)

insert into
	#links
values(
	"Column Link",
	"commit_balance",
	"Add External Commit",
	"suppressAutoexecute=YES",
	NULL)


insert into
        #links
values(
        "Format Number",
        "price",
        NULL,
        NULL,
        "#,##0.000000")
--Adaptive Server has expanded all '*' elements in the following statement



/* insert into
	#links
values(
	"Column Link",
	"roll",
	"Tally Rollover",
	"suppressAutoexecute=YES") */
select
	#links.meta_type, #links.column, #links.link, #links.arguments, #links.format
from
	#links


if @value_date = NULL or @value_date = ""
	select
		@value_date = convert(datetime, convert(char(11), getdate(), 1))

select
	@value_date = convert(char(2), datepart(month, @value_date)) + "/" +
		convert(char(2), datepart(day, @value_date)) + "/" +
		convert(char(4), datepart(year, @value_date))
	
exec
	r_nextbusinessday
		@value_date,
		@next_value_date output

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders	
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies	
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts	
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts	

create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers	


create table
	#output(
		deal_id int,
		trade_id int,
		trade_date datetime NULL,
		value_date datetime NULL,
		trader char(100) NULL,
		external_account char(100) NULL,
		counterparty char(100) NULL,
		give_product_id int NULL,
		give_product char(20) NULL,
		give_quantity float NULL,
		get_product_id int NULL,
		get_product char(20) NULL,
		get_quantity float NULL,
		price float NULL)
		

insert into
	#output(
		deal_id,
		trade_id)
select
	a.deal_id,
	a.trade_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	forwards g
where
	a.contract_id = g.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	convert(char(11), a.value_date, 1) = convert(char(11), @value_date, 1)


update
	#output
set
	h.trade_date = a.trade_date,
	h.value_date = a.value_date,
	h.trader = f.symbol,
	h.external_account = g.symbol,
	h.counterparty = i.name,
	h.give_product_id = c.product_id,
	h.give_product = c.symbol,
	h.give_quantity = a.quantity * -a.price,
	h.get_product_id = d.product_id,
	h.get_product = d.symbol,
	h.get_quantity = a.quantity,
	h.price = a.price
from
	trades a,
	products c,
	products d,
	forwards e,
	traders f,
	external_accounts g,
	#output h,
	counterparties i
where
	a.trade_id = h.trade_id
and
	a.contract_id = e.contract_id
and
	e.currency_id = c.product_id
and
	e.product_id = d.product_id
and
	a.trader_id = f.trader_id
and
	a.external_account_id = g.external_account_id
and
	a.counterparty_id = i.counterparty_id
/* and
	convert(varchar(11), a.value_date, 1)  = convert(varchar(11), @value_date, 1) */



select
	@trade_id = 0
select
	@trades = count(*)
from
	#output
where
	trade_id > @trade_id

while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#output
	where
		trade_id > @trade_id

	select
		@contract_id = NULL

	select
		@price_style = NULL
	select
		@price_style = a.name
	from
		price_styles a,
		contract_price_styles b,
		forwards c,
		#output d
	where
		a.price_style_id = b.price_style_id
	and
		b.contract_id = c.contract_id
	and
		c.currency_id = d.give_product_id
	and
		c.product_id = d.get_product_id
	and
		d.trade_id = @trade_id

	if @price_style = "Inverted"
		update
			#output
		set
			price = 1 / price
		where
			trade_id = @trade_id

	select
		@trades = count(*)
	from
		#output
	where
		trade_id > @trade_id
end


create table
	#all_products(
		product_id int NULL)
insert into
	#all_products
select
	give_product_id
from
	#output
insert into
	#all_products
select
	get_product_id
from
	#output


create table
	#products(
		product_id int,
		quantity float NULL)

insert into
	#products
select
	distinct(product_id),
	NULL
from
	#all_products


select
	@product_id = 0
select
	@products = count(*)
from
	#products
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#products
	where
		product_id > @product_id

	select
		@give_total_quantity = 0,
		@get_total_quantity = 0,
		@total_quantity = 0

	select
		@give_total_quantity = sum(give_quantity)
	from
		#output
	where
		give_product_id = @product_id
	if @give_total_quantity = NULL
		select
			@give_total_quantity = 0

	select
		@get_total_quantity = sum(get_quantity)
	from
		#output
	where
		get_product_id = @product_id
	if @get_total_quantity = NULL
		select
			@get_total_quantity = 0

	select
		@total_quantity = @give_total_quantity + @get_total_quantity

	update
		#products
	set
		quantity = @total_quantity
	where
		product_id = @product_id

	select
		@products = count(*)
	from
		#products
	where
		product_id > @product_id
end


create table
	#balances(
		product_id int,
		product char(20),
		value_date datetime,
		balance numeric(30,2),
		symbol char(20) NULL,
		quantity numeric(30,2) NULL,
		next_value_date datetime NULL,
		run_name char(100) NULL,
		roll char(20) NULL,
		commit_balance char(20) NULL)

insert into
	#balances
select
	a.product_id,
	a.symbol,
	@value_date,
	quantity = convert(numeric(30,2), b.quantity),
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL
from
	products a,
	#products b
where
	a.product_id = b.product_id

select
	@product_id = 0
select
	@products = count(*)
from
	#balances
where
	product_id > 0
while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#balances
	where
		product_id > @product_id
	
	select
		@contract = NULL,
		@product = NULL,
		@quantity = NULL

	select
		@product = product,
		@quantity = balance * -1.0
	from
		#balances
	where
		product_id = @product_id
	if @product != "USD"
	begin
		if abs(@quantity) >= 500
		begin
			select
				@contract = rtrim(@product) + "USD"

			update
				#balances
			set
				symbol = @contract,
				quantity = convert(numeric(30,2), @quantity),
				next_value_date = @next_value_date,
				run_name = @run_name,
				roll = "ROLL POSITION"
			where
				product_id = @product_id

		end
	end
		

	select
		@products = count(*)
	from
		#balances
	where
		product_id > @product_id
end


select
	product,
	closing_date = convert(char(11), value_date, 1),
	balance,
	symbol,
	roll_date = convert(char(11), next_value_date, 1),
	quantity,
	run_name,
	roll,
	commit_balance
from
	#balances
order by
	product_id

select
	deal_id,
	trade_id,
	trade_date = convert(char(11), trade_date, 1),
	value_date = convert(char(11), value_date, 1),
	trader,
	external_account,
	counterparty,
	give_quantity = convert(char(30), convert(numeric(30,0), give_quantity)),
	give_product,
	get_quantity = convert(char(30), convert(numeric(30,0), get_quantity)),
	get_product,
	price = convert(char(30), convert(numeric(30,6), price))
from
	#output
order by
	convert(float, price)


go
