 */



/*+---------------------------------------------------------------------------* 
 |                       MARK: Collect #external_trades                       | 
 *----------------------------------------------------------------------------*/

create table
    #external_trades (
        report_trade_id int,
        inverted bit,
        /* key */
        external_account_id int NULL,
        contract_id int NULL,
        value_date datetime,
        broker_id int NULL,
        /* symbols */
        trade_symbol char(100) NULL,
        /* attributes */
        qty1 numeric(30,10),
        qty2 numeric(30,10),
        price float
        )

/* ------------------ MARK: Add external trades as reported ----------------- */

insert into
    #external_trades
select
    a.report_trade_id,
    0 /* not inverted */,
    a.external_account_id,
    b.contract_id,
    a.value_date,
    a.broker_id,
    a.client_identifier,
    a.ccy_1_quantity,
    a.ccy_2_quantity,
    - a.ccy_2_quantity / a.ccy_1_quantity
from
    report_trades a,
    contracts b /* not outer */
where
    a.report_commit_id = @report_commit_id
and
    b.symbol = rtrim(a.ccy_1) + rtrim(a.ccy_2)

/* ------------------- MARK: Add external trades inverted ------------------- */

insert into
    #external_trades
select
    a.report_trade_id,
    1 /* not inverted */,
    a.external_account_id,
    b.contract_id,
    a.value_date,
    a.broker_id,
    a.client_identifier,
    a.ccy_2_quantity,
    a.ccy_1_quantity,
    - a.ccy_1_quantity / a.ccy_2_quantity
from
    report_trades a,
    contracts b /* not outer */
where
    a.report_commit_id = @report_commit_id
and
    b.symbol = rtrim(a.ccy_2) + rtrim(a.ccy_1)


    
/*+---------------------------------------------------------------------------* 
 |                       MARK: Cache external_accounts                        | 
 *----------------------------------------------------------------------------*/
 
create table
    #external_accounts (
        external_account_id int
        )

insert into
    #external_accounts
select
    external_account_id
from
    fund_external_accounts
where
    fund_id = @fund_id



/*+---------------------------------------------------------------------------* 
 |                       MARK: Collect #internal_trades                       | 
 *----------------------------------------------------------------------------*/
  
create table
    #internal_trades (
        trade_id int,
        /* key */
        external_account_id int,
        contract_id int,
        value_date datetime,
        broker_id int,
        /* symbols */
        trade_symbol char(100) NULL,
        /* attributes */
        qty1 numeric(30,10),
        qty2 numeric(30,10),
        price float
        )
        
insert into
    #internal_trades 
select
    a.trade_id,
    a.external_account_id,
    a.contract_id,
    a.value_date,
    a.broker_id,
    a.identifier,
    a.quantity,
    -1 * a.quantity * a.price,
    a.price
from
    trades a,
    #external_accounts b
where
    a.trade_date >= @begin_date
and
    a.trade_date < @end_date
and
    a.external_account_id = b.external_account_id
and
    a.quantity != 0
and
    a.price != 0
order by
    a.trade_date asc
    


/*+---------------------------------------------------------------------------* 
 |                            MARK: Apply filters                             | 
 *----------------------------------------------------------------------------*/

if @external_account_filter != null
begin
    delete
    from
        #internal_trades
    where
        external_account_id not in (
            select
                a.external_account_id
            from
                external_accounts a,
                external_account_symbols s
            where
                a.external_account_id *= s.external_account_id
            and (
                    s.symbol = @external_account_filter
                or
                    a.name = @external_account_filter
            )
        )
    delete
    from
        #external_trades
    where
        external_account_id not in (
            select
                a.external_account_id
            from
                external_accounts a,
                external_account_symbols s
            where
                a.external_account_id *= s.external_account_id
            and (
                    s.symbol = @external_account_filter
                or
                    a.name = @external_account_filter
            )
        )
end
  
if @contract_filter != null
begin
    delete
    from
        #internal_trades
    where
        contract_id not in (
            select
                c.contract_id
            from
                contracts c
            where
                c.symbol = @contract_filter
        )
    delete
    from
        #external_trades
    where
        contract_id not in (
            select
                c.contract_id
            from
                contracts c
            where
                c.symbol = @contract_filter
        )
end

if @value_date_filter != null
begin
    delete
    from
        #internal_trades
    where
        value_date != @value_date_filter
    delete
    from
        #external_trades
    where
        value_date != @value_date_filter
end

if @broker_filter != null 
begin
    delete
    from
        #internal_trades
    where
        broker_id not in (
            select
                b.broker_id
            from
                brokers b,
                broker_symbols s
            where
                b.broker_id *= s.broker_id
            and
                s.source_id = @source_id
            and (
                    s.symbol = @broker_filter
                or
                    b.symbol = @broker_filter
            )
        )
    delete
    from
        #external_trades
    where
        broker_id = NULL
    or
        broker_id not in (
            select
                b.broker_id
            from
                brokers b,
                broker_symbols s
            where
                b.broker_id *= s.broker_id
            and
                s.source_id = @source_id
            and (
                    s.symbol = @broker_filter
                or
                    b.symbol = @broker_filter
            )
        )
end



/*+---------------------------------------------------------------------------* 
 |   MARK: Trim internal and external trades that have already been matched   | 
 *----------------------------------------------------------------------------*/

delete
from
    #internal_trades
where
    trade_id in (
        select
            m.trade_id
        from
            report_trade_matches m,
            trades i
        where
            m.trade_id = i.trade_id
        and
            i.trade_date >= @begin_date
        and
            i.trade_date < @end_date
    )

delete
from
    #external_trades
where
    report_trade_id in (
        select
            m.report_trade_id
        from
            report_trade_matches m,
            trades i
        where
            m.trade_id = i.trade_id
        and
            i.trade_date >= @begin_date
        and
            i.trade_date < @end_date
    )



/*+---------------------------------------------------------------------------* 
 |                          MARK: Calculate matches                           | 
 *----------------------------------------------------------------------------*/
  
create table
    #matches (
        report_trade_id int,
        inverted bit,
        trade_id int,
        match_strength float,
        symbols_match bit,
        notes varchar(200) NULL
    )
    
/* 
 *      abs(e - i)         
 * 1 - ------------ * A - abs(e - i) * B
 *        (e + i)
 * 
 * Where for quantities: A = 331, B = 0.001
 * and prices: A = 4500, B = 0
 */

/* If we're doing a rate match, then match based on the price and not
 * -qty1/qty2. This doesn't work so well for small quantities */
if @action like "%rate-match%"
begin
    insert into
        #matches
    select
        e.report_trade_id,
        e.inverted,
        i.trade_id,
        1 + (
          - abs(convert(float, e.qty1 - i.qty1) / i.qty1) * 10000
             - abs(e.qty1 - i.qty1) * 0.5
          - abs((e.price - i.price) / i.price) * 4500
            /* - abs(e.price - i.price) * 0 */
        ),
        case 
            when charindex(e.trade_symbol, i.trade_symbol)
               + charindex(i.trade_symbol, e.trade_symbol) = 0 then 0
            else 1
        end,
        NULL
    from
        #external_trades e,
        #internal_trades i
    where
        e.external_account_id = i.external_account_id
    and 
        e.contract_id = i.contract_id
    and
        e.value_date = i.value_date
    and (
            @match_broker = 0
        or
            e.broker_id = i.broker_id
        or
            e.broker_id = @generic_broker_id
        or
            e.broker_id = NULL
    )
    and 
        i.qty1 != 0
    and 
        e.qty1 != 0
    and (
            i.qty1 < 0 and e.qty1 < 0
        or
            i.qty1 > 0 and e.qty1 > 0
    )
end
else
begin
    insert into
        #matches
    select
        e.report_trade_id,
        e.inverted,
        i.trade_id,
        1 + (
          - abs(convert(float, e.qty1 - i.qty1) / i.qty1) * 5000
             - abs(e.qty1 - i.qty1) * 0.25
          - abs(convert(float, e.qty2 - i.qty2) / i.qty2) * 5000
             - abs(e.qty2 - i.qty2) * 0.25
        ),
        case 
            when charindex(e.trade_symbol, i.trade_symbol)
               + charindex(i.trade_symbol, e.trade_symbol) = 0 then 0
            else 1
        end,
        case when e.qty1 != i.qty1 then "e.qty1(" + convert(varchar(50), e.qty1) + ") != i.qty1(" + convert(varchar(50), i.qty1) + "). " else "" end
        + case when e.qty2 != i.qty2 then " e.qty2(" + convert(varchar(50), e.qty2) + ") != i.qty2(" + convert(varchar(50), i.qty2) + "). " else "" end

    from
        #external_trades e,
        #internal_trades i
    where
        e.external_account_id = i.external_account_id
    and 
        e.contract_id = i.contract_id
    and
        e.value_date = i.value_date
    and (
            @match_broker = 0
        or
            e.broker_id = i.broker_id
        or
            e.broker_id = @generic_broker_id
        or
            e.broker_id = NULL
    )
    and 
        i.qty1 != 0
    and 
        e.qty1 != 0
    and (
            i.qty1 < 0 and e.qty1 < 0
        or
            i.qty1 > 0 and e.qty1 > 0
    )
end

/* 
 * If the symbols match, make trade details take the range of 95% - 100% instead
 * of 0% - 100%.
 */
update
    #matches
set
    match_strength = (match_strength - 1) * 0.05 + 1
where
    symbols_match = 1

