
if object_id("r_autoreconcilereport") != NULL
    drop procedure
        r_autoreconcilereport
go

create procedure
    r_autoreconcilereport
        @login char(50),
        @fund char(100),
        @external_report char(100),
        @trade_date datetime = NULL,
        @action char(100) = NULL,
        @mismatch_strength float = NULL, 
        @reconciled_strength float = NULL,
        @external_account_filter char(100) = NULL,
        @contract_filter char(100) = NULL,
        @value_date_filter datetime = NULL,
        @broker_filter char(100) = NULL
as

declare @report_commit_id int
declare @begin_date datetime
declare @end_date datetime
declare @fund_id int
declare @match_broker bit
declare @status char(50)
declare @source_id int
declare @mismatched_status_id int
declare @matched_status_id int
declare @committed_status_id int
declare @quantity numeric(30,4)
declare @price float
declare @generic_broker_id int
declare @trade_day datetime


/*
 * Save 12:00AM trade date into @trade_day
 */
select
	@trade_day = @trade_date

/* 
 * Calculate @begin_date and @end_day
 */
exec
    r_gettradingday
        @trade_date,
        @trade_date output,
        @begin_date output,
        @end_date output

/* 
 * Default the @mismatch_strength and @reconciled_strength
 */
if @mismatch_strength = NULL
    select
        @mismatch_strength = 0.75 /* 0.818 ~0.5 pips (0.999818) */
if @reconciled_strength = NULL
    select
        @reconciled_strength = 0.998000 /* Full match (empirical) */
if @action like "%Non-Broker%"
    select
        @match_broker = 0
else
    select
        @match_broker = 1

select
    @generic_broker_id = broker_id
from
    brokers
where
    symbol = "External"

/* -------------------- MARK: Find the @report_commit_id -------------------- */

exec
    r_reportcommitfordate
        @fund,
        @external_report,
        @trade_date,
        @report_commit_id output
if @report_commit_id = NULL
begin
    select
        id = -1,
        error = "Couldn't find the requested report commit"
    return
end

select
    trade_date = @trade_date,
    begin_date = @begin_date,
    end_date = @end_date,
    report_commit_id = @report_commit_id

/* 
 * Find the @fund_id, commit @status and @source_id from the @report_commit_id,
 * we could've also gotten this using @fund and @external_report but this should
 * be more consistent
 */
select
    @fund_id = b.fund_id,
    @source_id = c.source_id,
    @status = d.name
from
    report_commits a,
    fund_reports b,
    external_reports c,
    statuses d
where
    a.report_commit_id = @report_commit_id
and
    a.fund_report_id = b.fund_report_id
and
    b.external_report_id = c.external_report_id
and
    a.status_id = d.status_id
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the external report, """ 
                + rtrim(@external_report) + """"
    return
end



/* ------------------------- MARK: Retrieve settings ------------------------ */

select
    @mismatched_status_id = status_id
from
    statuses
where
    name = "Mismatched"
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the ""Mismatched"" status"
    return
end

select
    @matched_status_id = status_id
from
    statuses
where
    name = "Matched"
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the ""Matched"" status"
    return
end

select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"
if @@rowcount != 1
begin
    select
        id = -1,
        error = "Couldn't find the ""Committed"" status"
    return
end

