/*+---------------------------------------------------------------------------* 
 |                         MARK: Select best matches                          | 
 *----------------------------------------------------------------------------*/

declare @report_trade_id int
declare @inverted bit
declare @trade_id int
declare @match_strength float
declare @symbols_match bit
declare @match_status_id int

/* 
 * Loop through each of the matches that are greater than @mismatch_strength
 * and create a report_trade_matches for it.
 */

declare 
    matching
cursor for select
    report_trade_id,
    inverted,
    trade_id,
    match_strength,
    symbols_match
from
    #matches
where
    match_strength >= @mismatch_strength
order by
    match_strength desc,
    symbols_match desc

open matching

fetch matching into
    @report_trade_id,
    @inverted,
    @trade_id,
    @match_strength,
    @symbols_match
    
while @@sqlstatus = 0
begin

    if not exists(
            select
                *
            from
                report_trade_matches
            where
                report_trade_id = @report_trade_id
            or
                trade_id = @trade_id )
    begin
    
        /* Calculate the status */
        if @match_strength >= @reconciled_strength
            select
                @match_status_id = @committed_status_id
        else
            select
                @match_status_id = @mismatched_status_id
        
        select
            @quantity = convert(numeric(30, 4), qty1),
            @price = price
        from
            #external_trades
        where
            report_trade_id = @report_trade_id
        and
            inverted = @inverted
        if @@rowcount != 1
        begin
            select
                id = -1,
                err = "Couldn't find report_trade_id = " + convert(varchar(10), @report_trade_id) + " and inverted = " + str(@inverted)
            return
        end
                
/*        select
            report_trade_id = @report_trade_id,
            trade_id = @trade_id,
            match_strength = @match_strength,
            difference = @reconciled_strength - @match_strength,
            scaled = 1000 * (@reconciled_strength - @match_strength),
            e_quantity = a.quantity, i_quantity = b.quantity, diff_quantity = (a.quantity - b.quantity) * 1000,
            e_price = a.price, i_price = b.price, diff_price = (a.price - b.price) * 1000
        from
            #external_trades a,
            #internal_trades b
        where
            a.report_trade_id = @report_trade_id
        and
            a.inverted = @inverted
        and
            b.trade_id = @trade_id
*/        
        insert into 
            report_trade_matches
        values (
            @report_commit_id,
            @trade_id,
            @report_trade_id,
            @inverted,
            @match_strength,
            @symbols_match,
            @match_status_id,
            getdate(),
            @quantity,
            @price
        )
        
    end

    fetch matching into
        @report_trade_id,
        @inverted,
        @trade_id,
        @match_strength,
        @symbols_match
end

close matching
deallocate cursor matching

