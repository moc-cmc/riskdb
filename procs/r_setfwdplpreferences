
if object_id("r_setfwdplpreferences") != NULL
    drop procedure
        r_setfwdplpreferences
go

create procedure
	r_setfwdplpreferences
		@login char(20),
		@view_style char(100),
		@sorting char(100)
as

declare @pl_view_style_id int
declare @sorting_style_id int
declare @ti_account_id int

select
	@ti_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@pl_view_style_id = pl_view_style_id
from
	pl_view_styles
where
	name = @view_style
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding pl view style",
		pl_view_style = @view_style
	return
end

select
	@sorting_style_id = sorting_style_id
from
	sorting_styles
where
	name = @sorting
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Unknown sorting style",
		sorting = @sorting
	return
end

update
	fwd_pl_preferences
set
	pl_view_style_id = @pl_view_style_id,
	sorting_style_id = @sorting_style_id
where
	ti_account_id = @ti_account_id
if @@rowcount = 0
begin
	insert into
		fwd_pl_preferences
	values(
		@ti_account_id,
		@pl_view_style_id,
		@sorting_style_id)
end

truncate table
	run_pos_cache


select
	id = 0,
	msg = "Successfully set pl view style"

go
