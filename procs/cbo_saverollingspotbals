drop procedure
	cbo_saverollingspotbals
go

create procedure
	cbo_saverollingspotbals
		@login varchar(50),
		@trade_date datetime
as


declare @begin_date datetime
declare @end_date datetime
declare @settlement_type_id int

declare @account_transaction_id int
declare @entered_by int
declare @external_account_id int
declare @transaction_date datetime
declare @currency_id int
declare @amount float
declare @deal_id int
declare @id int
declare @ids int

select
	@entered_by = account_id
from
	tico_accounts
where
	login = @login
if @entered_by = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@trade_date = convert(datetime, convert(date, @trade_date))

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

select
	@transaction_date = convert(datetime, convert(date, @end_date))

select
	@settlement_type_id = transaction_type_id
from
	transaction_types
where
	name = "PS Settlement"
if @settlement_type_id = NULL
begin
	exec
		j_nextkey
			"transaction_types",
			@settlement_type_id output

	insert into
		transaction_types(
			transaction_type_id,
			name,
			direction)
	values(
		@settlement_type_id,
		"PS Settlement",
		1)
end

create table
	#accounts(
		external_account_id int)
insert into
	#accounts(
		external_account_id)
select
	a.external_account_id
from
	external_accounts a,
	settlement_methods b
where
	a.settlement_method_id = b.settlement_method_id
and
	b.name in("Perpetual Spot", "Digital Delivery")

create table
	#positions(
		external_account_id int,
		product_id int,
		balance float)
insert into
	#positions(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	c.product_id,
	sum(a.quantity)
from
	trades a,
	#accounts b,
	forwards c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	convert(date, a.value_date) = convert(date, @end_date)
group by
	a.external_account_id,
	c.product_id

insert into
	#positions(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	c.currency_id,
	sum(a.quantity * a.price * -1.0)
from
	trades a,
	#accounts b,
	forwards c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	convert(date, a.value_date) = convert(date, @end_date)
group by
	a.external_account_id,
	c.currency_id

create table
	#balances(
		id int identity,
		external_account_id int,
		product_id int,
		balance float)
insert into
	#balances(
		external_account_id,
		product_id,
		balance)
select
	external_account_id,
	product_id,
	sum(balance)
from
	#positions
group by
	external_account_id,
	product_id


delete

from
	#balances
where
	balance = 0.0


select
	@id = 0
select
	@ids = count(*)
from
	#balances
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#balances
	where
		id > @id

	select
		@account_transaction_id = NULL,
		@deal_id = NULL,
		@external_account_id = NULL,
		@currency_id = NULL,
		@amount = NULL

	select
		@external_account_id = external_account_id,
		@currency_id = product_id,
		@amount = balance
	from
		#balances
	where
		id = @id

	exec
		j_nextkey
			"deals",
			@deal_id output
	exec
		j_nextkey
			"account_transactions",
			@account_transaction_id output

	begin tran
		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount,
				deal_id)
		values(
			@account_transaction_id,
			@entered_by,
			@external_account_id,
			@settlement_type_id,
			@transaction_date,
			@currency_id,
			@amount,
			@deal_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to settle perp spot balance",
				external_account_id = @external_account_id,
				transaction_date = @transaction_date,
				currency_id = @currency_id,
				amount = @amount
			rollback tran
			return
		end
	commit tran

	/* Adaptive Server has expanded all '*' elements in the following statement */ select account_transactions.account_transaction_id, account_transactions.entered_by, account_transactions.external_account_id, account_transactions.transaction_type_id, account_transactions.transaction_date, account_transactions.currency_id, account_transactions.amount, account_transactions.note, account_transactions.deal_id from account_transactions where account_transaction_id = @account_transaction_id /* MARKR */

	select
		@ids = count(*)
	from
		#balances
	where
		id > @id
end

		


go
