
drop procedure r_moveopstask
go

create procedure
	r_moveopstask
		@login varchar(50),
		@ops_task_id int,
		@direction varchar(10),
		@status varchar(10)=NULL output


as

declare @tico_account_id int
declare	@ops_task_type_id int
declare	@ops_task_ordering int
declare @next_ops_task_id int
declare @next_ops_task_ordering int

select
	@status = "error"

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end


select
	@direction = upper(@direction)
if @direction not in("UP", "DOWN")
begin
	select
		status = "Error",
		message = "Must provide a direction as up or down",
		direction = @direction
	return
end

select
	@ops_task_type_id = ops_task_type_id,
	@ops_task_ordering = ordering
from
	ops_tasks
where
	ops_task_id = @ops_task_id
if @ops_task_ordering = NULL
begin
	select
		status = "Error",
		message = "Could not find ops task for ID provided",
		ops_task_id = @ops_task_id
	return
end

if @direction = "DOWN"
begin
	select
		@next_ops_task_ordering = min(ordering) 
	from
		ops_tasks
	where
		ops_task_type_id = @ops_task_type_id
	and
		ordering > @ops_task_ordering 
	
	if @next_ops_task_ordering = NULL
	begin
		select
			@next_ops_task_ordering = @ops_task_ordering
	end
	
	select
		@next_ops_task_ordering = @next_ops_task_ordering + 1

	begin tran
		update
			ops_tasks
		set
			ordering = ordering + 1
		where
			ops_task_type_id = @ops_task_type_id
		and
			ordering >= @next_ops_task_ordering

		update
			ops_tasks
		set
			ordering = @next_ops_task_ordering
		where
			ops_task_id = @ops_task_id
		if @@rowcount != 1
		begin	
			select
				status = "Error",
				message = "Problem updating ordering for task",
				ops_task_id = @ops_task_id
	
			rollback
			return
		end
	commit tran

	
end
	
if @direction = "UP"
begin
	select
		@next_ops_task_ordering = max(ordering) 
	from
		ops_tasks
	where
		ops_task_type_id = @ops_task_type_id
	and
		ordering < @ops_task_ordering 
	
	if @next_ops_task_ordering = NULL
	begin
		select
			@next_ops_task_ordering = @ops_task_ordering
	end
	
	select
		@next_ops_task_ordering = @next_ops_task_ordering - 1

	begin tran
		update
			ops_tasks
		set
			ordering = ordering - 1
		where
			ops_task_type_id = @ops_task_type_id
		and
			ordering <= @next_ops_task_ordering

		update
			ops_tasks
		set
			ordering = @next_ops_task_ordering
		where
			ops_task_id = @ops_task_id
		if @@rowcount != 1
		begin	
			select
				status = "Error",
				message = "Problem updating ordering for task",
				ops_task_id = @ops_task_id
	
			rollback
			return
		end
	commit tran

end

if @next_ops_task_ordering = NULL
begin
	select
		status = "Error",
		message = "Problem determining next_ops_task_ordering",
		next_ops_task_ordering = @next_ops_task_ordering
	return
end


select
	@status = "success"

go

