
create or replace procedure
	tt_netlinktally
		@login varchar(50)=NULL,
		@source varchar(50)=NULL,
		@strategy varchar(50)=NULL,
		@trml_version varchar(50)=NULL,
		@messsage_type varchar(50)=NULL,
		@id varchar(50)=NULL,
		@destination varchar(50)=NULL,
		@product varchar(50)=NULL,
		@action varchar(50)=NULL,
		@type varchar(50)=NULL,
		@process varchar(20)=NULL,
		@direct varchar(50)=NULL,
		@trade_reporter varchar(50)=NULL,
		@ticket_num varchar(50)=NULL,
		@identifer varchar(50)=NULL,
		@portfolio varchar(50)=NULL,
		@trader_name varchar(50)=NULL,
		@account varchar(50)=NULL,
		@reporting_party varchar(50)=NULL,
		@region varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@cpty_region varchar(50)=NULL,
		@cpty_ticket_number varchar(50)=NULL,
		@prime_broker varchar(50)=NULL,
		@prime_broker_id  varchar(50)=NULL,
		@prime_broker_account varchar(50)=NULL,
		@trade_date varchar(50)=NULL,
		@origin_system varchar(50)=NULL,
		@system_trade_id varchar(50)=NULL,
		@ebnoe varchar(50)=NULL,
		@traded_amount_near varchar(30)=NULL,
		@fx_product varchar(30)=NULL,
		@traded_ccy varchar(10)=NULL,
		@direction varchar(10)=NULL,
		@counter_ccy varchar(10)=NULL,
		@counter_amount_near varchar(30)=NULL,
		@dealt_rate_near varchar(30)=NULL,
		@quote_terms varchar(30)=NULL,
		@fwd_points varchar(30)=NULL,
		@spot_rate varchar(30)=NULL,
		@value_date_near varchar(30)=NULL,
		@fixing_date_near varchar(30)=NULL
as


declare @contract_id int
declare @default_login varchar(50)
declare @sales_code_id int
declare @user_account_id int
declare @symbol varchar(50)
declare @committed_status_id int
declare @external_account_id int
declare @external_account_type varchar(25)
declare @aggregation_style_id int
declare @aggregation_style varchar(25)

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_login varchar(50)
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int
declare @clvcl_counterparty varchar(50)

declare @lookup_cpty varchar(50)
declare @lookup_trader varchar(50)
declare @broker_id int
declare @broker varchar(50)
declare @market_trade char(1)

declare @source_id int
/*declare @source varchar(50)*/

declare @suppressed_trade_id int
declare @suppressed_deal_id int
declare @suppress_trade varchar(1)
declare @lp_trade varchar(10)
declare @client_trade varchar(10)

declare @tally_tally_type varchar(50)
declare @tally_trader_type varchar(50)
declare @tally_external_account varchar(50)
declare @tally_counterparty_account varchar(50)
declare @tally_quantity numeric(30, 8)
declare @tally_symbol varchar(50)
declare @tally_price float
declare @tally_trade_date datetime
declare @tally_value_date datetime
declare @tally_fixing_date datetime
declare @tally_sales_code varchar(50)
declare @tally_identifier varchar(100)
declare @tally_far_price float
declare @tally_far_value_date datetime
declare @tally_far_fixing_date datetime
declare @tally_spot_reference float
declare @tally_strategy varchar(50)
declare @tally_broker varchar(50)
declare @tally_status varchar(50)

declare @offset_trade_id int
declare @offset_identifier varchar(50)
declare @offset_quantity numeric(30, 4)
declare @offset_ext_account_id int
declare @offset_counterparty_id int
declare @offset_trader_id int
declare @offset_ext_account varchar(50)
declare @offset_counterparty varchar(50)
declare @offset_trader varchar(50)
declare @book_offset char(1)
declare @deal_groupings char(1)
declare @pb_id int



/* Conversions */
select
	@tally_price = convert(float, @dealt_rate_near),
	@tally_quantity = abs(convert(numeric(30, 8), @traded_amount_near)),
	@tally_trade_date = convert(datetime, @trade_date),
	@tally_value_date = convert(datetime, @value_date_near),
	@tally_fixing_date = convert(datetime, @fixing_date_near) /*,
	@tally_far_price = convert(float, @far_price),
	@tally_far_value_date = convert(datetime, @far_value_date),
	@tally_far_fixing_date = convert(datetime, convert(char(8, @far_fixing_date, 112))),
	@tally_spot_reference = convert(float, @spot_reference) */


select
        @source = "Netlink EB"
select
        @source_id = source_id
from
        sources
where
        name = @source
if @@rowcount != 1
begin
        select
                status = "Error",
                message = "Source not found",
                source = @source
        return
end

select
	@pb_id = prime_broker_id
from
	prime_broker_symbols
where
	source_id = @source_id
and
	symbol = @prime_broker

if @pb_id = NULL
begin
	select
		error = "Prime Broker not found",
		pb = @prime_broker
	return
end

select
	@book_offset = book_offset,
	@offset_ext_account_id = offset_ext_account_id,
	@offset_trader_id = offset_trader_id,
	@offset_counterparty_id = offset_counterparty_id,
	@deal_groupings = deal_groupings
from
	netlink_configs
where
	prime_broker_id = @pb_id


if @book_offset = "Y"
begin
	select
		@offset_ext_account = symbol
	from
		external_accounts
	where
		external_account_id = @offset_ext_account_id
	if @offset_ext_account = NULL
	begin
		select
			"error"="Error",
			"msg"="Problem finding offset ext account",
			"offset_ext_account_id"=@offset_ext_account_id
		return
	end
	select
		@offset_trader = symbol
	from
		traders
	where
		trader_id = @offset_trader_id
	if @offset_trader = NULL 
	begin
		select
			"error"="Error",
			"msg"="Problem finding offset trader",
			"offset_trader_id"=@offset_trader_id
		return
	end
	select
		@offset_counterparty = name
	from
		counterparties
	where
		counterparty_id = @offset_counterparty_id
	if @offset_counterparty = NULL
	begin
		select
			"error"="Error",
			"msg"="Problem finding offset counterparty",
			"offset_counterparty_id"=@offset_counterparty_id
		return
	end
end

select
	@tally_status = name
from
	statuses
where
	name = "Aggregated"
if @tally_status = NULL
begin
	select
		@tally_status = "User Review"
end



if @broker = NULL
	select
		@broker = "Netlink EB"
select
	@quoted_price = @tally_price
select
	@trade_identifier = @ticket_num
select
        @trade_type = "Spot"

/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

/*
 * VERIFY @broker exist and check for dupe
 */
select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @@rowcount != 1
begin
        select
                "error"="Error",
                "msg"="Broker not found",
                "broker"=@broker
        return
end

if @counterparty = NULL
begin
	select
		error = "No counterparty provided"
	return
end

select
	@counterparty = @prime_broker + '-' + @counterparty

if @counterparty != NULL
begin
	select
		@lp_trade = "Y"
	from
		counterparty_symbols b
	where
		b.source_id = @source_id
	and
		b.symbol = @counterparty
	if @lp_trade != "Y"
	begin
		select
        		@lp_trade = "Y"
		from
        		counterparties a
		where
        		a.name = @counterparty
	end

	if @lp_trade != "Y"
	begin
		/*NOT LP TRADE. CHECK FOR CLIENT TRADE */

		select
			@client_trade = "Y"
		from
			trader_symbols b
		where
			b.source_id = @source_id
		and
			b.symbol = @counterparty
		if @client_trade != "Y"
		begin
			select
                        	@client_trade = "Y"
                	from
                        	traders b
                	where
                        	b.symbol = @counterparty
		end
	end
	
	if @lp_trade != "Y" and @client_trade != "Y"
	begin
		select
			status = "Error",
                        message = "Couldn't find counterparty for @counterparty",
                        cpty = @counterparty
                return
	end
end

/*select lp_trade=@lp_trade, cl_trade=@client_trade*/

if @client_trade = "Y"
begin
	/* LOOKUP CLIENT DETAILS */

	select
		@lookup_trader = rtrim(@counterparty),
		@lookup_cpty = rtrim(@trade_reporter)

	select
		@trade_identifier = @trade_identifier,
                @deal_type = "Client Forward"

	
	select
        	@suppress_trade = "Y"
	from
        	suppression_symbols
	where
        	source_id = @source_id
	and
        	symbol = @lookup_trader


	select
        	@trader_id = a.trader_id,
        	@trader = a.symbol,
        	@user_account_id = a.tico_account_id,
        	@sales_code_id = a.sales_code_id,
		@external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b
	where
        	a.trader_id = b.trader_id
	and
        	b.source_id = @source_id
	and
        	b.symbol = @lookup_trader
	if @@rowcount != 1
	begin
        	select
                	@trader_id = a.trader_id,
                	@trader = a.symbol,
                	@user_account_id = a.tico_account_id,
                	@sales_code_id = a.sales_code_id,
			@external_account_id = a.external_account_id
        	from
                	traders a
        	where
                	a.symbol = @lookup_trader
		if @@rowcount != 1
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
                        	lookup_trader = @lookup_trader
                	return
        	end
	end

	/*
 	* LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 	*/
	
	select
		@counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = @source_id
	and
        	b.symbol = @lookup_cpty
	if @counterparty = NULL
	begin
        	select
                	@counterparty_id = a.counterparty_id,
			@counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
        	
        	if @counterparty = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
				lookup_cpty = @lookup_cpty
                	return
        	end
	end
	/*select lookup_cpty=@lookup_cpty, counterparty_id=@counterparty_id, counterparty = @counterparty, cpty_ext_acct_id = @cpty_ext_acct_id, source_id = @source_id*/
		

	/*
 	* LOOKUP @external_account, @external_account_type based on @external_account_id
 	*/
	select
    		@external_account = a.symbol,
    		@external_account_type = b.name,
    		@aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @external_account_id
	if @external_account = NULL
	begin
        	select
                	status = "Error",
                	message = "Couldn't find external_account from @external_account_id",
                	external_account_id = @external_account_id
        	return
	end
end

if @lp_trade = "Y"
begin
	/* LOOKUP LP DETAILS */

	select
		@lookup_trader = @trade_reporter,
		@lookup_cpty = @counterparty
	
	select
                @trade_identifier = @trade_identifier,
                @deal_type = "Market Forward"

	
	select
        	@suppress_trade = "Y"
	from
        	suppression_symbols
	where
        	source_id = @source_id
	and
        	symbol = @lookup_cpty


	select
        	@trader_id = a.trader_id,
        	@trader = a.symbol,
        	@user_account_id = a.tico_account_id,
        	@sales_code_id = a.sales_code_id,
		@external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b
	where
        	a.trader_id = b.trader_id
	and
        	b.source_id = @source_id
	and
        	b.symbol = @lookup_trader
	if @@rowcount != 1
	begin
        	select
                	@trader_id = a.trader_id,
                	@trader = a.symbol,
                	@user_account_id = a.tico_account_id,
                	@sales_code_id = a.sales_code_id,
			@external_account_id = a.external_account_id
        	from
                	traders a
        	where
                	a.symbol = @lookup_trader
		if @@rowcount != 1
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
                        	lookup_trader = @lookup_trader
                	return
        	end
	end

	/*
 	* LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 	*/
	
	select
		@counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = @source_id
	and
        	b.symbol = @lookup_cpty
	if @counterparty = NULL
	begin
        	select
                	@counterparty_id = a.counterparty_id,
			@counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
        	
        	if @counterparty = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
				lookup_cpty = @lookup_cpty
                	return
        	end
	end
	
	/*      
 	* OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
 	*/     
        select
                @external_account_id = @cpty_ext_acct_id

	/*
        * LOOKUP @external_account, @external_account_type based on @external_account_id
        */
        select
                @external_account = a.symbol,
                @external_account_type = b.name,
                @aggregation_style = c.name
        from    
                external_accounts a,
                external_account_types b,
                aggregation_styles c
        where
                a.external_account_type_id = b.external_account_type_id
        and     
                a.aggregation_style_id = c.aggregation_style_id
        and
                a.external_account_id = @external_account_id
        if @external_account = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find external_account from @external_account_id",
                        external_account_id = @external_account_id
                return
        end
end


select
	@trader_login = login
from
	tico_accounts
where
	account_id = @user_account_id


if exists(select trade_id from trades where identifier = @trade_identifier and broker_id = @broker_id)
begin
        select
                status="Dupe",
                msg="Trade already tallied",
                identifier=@trade_identifier,
                broker= @broker
        return
end


select
        @symbol = @quote_terms

/* 
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @traded_ccy != NULL and @counter_ccy != NULL and @symbol = @counter_ccy + @traded_ccy
begin
    select
        @symbol = @traded_ccy + @counter_ccy,
	@inverted = "Y"
end


if @direction = "SELL"
begin
    select
        @tally_quantity = -@tally_quantity
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @login,
                        @symbol,
                        @traded_ccy,
                	@counter_ccy,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor,
			min_scale,
			max_scale
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0,
		4,
		6
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end

select
	@deal_exec_symbol = @ticket_num

if @deal_groupings = "Y"
begin

	select
		@deal_id = deal_id
	from
		netlink_deal_groupings
	where
		contract_id = @contract_id
	and
		trade_date = @tally_trade_date
end

if @deal_id = NULL
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
	insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
	)

	if @deal_groupings = "Y"
	begin
		insert into
			netlink_deal_groupings(
				trade_date,
				contract_id,
				deal_id)
		values(
			@tally_trade_date,
			@contract_id,
			@deal_id)
	end
end
else
begin
	select
		msg = "Appending to existing deal"

	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = 'B2B Forward'
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for 'B2B Forward'"
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
end

if @suppress_trade = "Y"
begin
        exec
                fxa_suppresstrade
                        @login = @trader_login,
                        @source = @source,
                        @suppressed_trade_id = @suppressed_trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @trade_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @external_account,
                        @counterparty = @counterparty,
                        @quantity = @tally_quantity,
                        @symbol = @symbol,
                        @value_date = @tally_value_date,
			@fixing_date = @tally_fixing_date,
                        @price = @tally_price,
                        @trade_date = @tally_trade_date,
                        @trader = @trader,
                        @broker = @broker,
                        @identifier = @trade_identifier,
                        @spot_reference = @quoted_price

            if @suppressed_trade_id = NULL
            begin
                    select
                            status = "Error",
                            message = "Failed to suppress trade"
            end
end  		
else
begin    
	exec
		fxa_tallytrade
			@login = @trader_login,
			@source = @source,
			@trade_id = @trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @trade_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@quantity = @tally_quantity,
			@symbol = @symbol,
			@value_date = @tally_value_date,
			@fixing_date = @tally_fixing_date,
			@price = @tally_price,
			@trade_date = @tally_trade_date,
			@trader = @trader,
			@broker = @broker,
			@identifier = @trade_identifier,
			@spot_reference = @quoted_price,
			@status = @tally_status,
			@strategy = @strategy

	if @trade_id = NULL
	begin
		select
			status = "Error",
			message = "Failed to tally trade"
		return
	end

	exec
		r_inserttradenotification
			@trade_id

	if @book_offset = "Y"
	begin
		select
			@offset_quantity = @tally_quantity * -1,
			@offset_identifier = rtrim(@trade_identifier)+"_offset"

        	exec
                	fxa_tallytrade
                        	@login = @trader_login,
                        	@source = @source,
                        	@trade_id = @offset_trade_id out,
                        	@deal_id = @deal_id out,
                        	@tally_type = @trade_type,
                        	@deal_type = @deal_type,
                        	@trade_type = @trade_type,
                        	@external_account = @offset_ext_account,
                        	@counterparty = @offset_counterparty,
                        	@quantity = @offset_quantity,
                        	@symbol = @symbol,
                        	@value_date = @tally_value_date,
                        	@fixing_date = @tally_fixing_date,
                        	@price = @tally_price,
                        	@trade_date = @tally_trade_date,
                        	@trader = @offset_trader,
                        	@broker = @broker,
                        	@identifier = @offset_identifier,
                        	@spot_reference = @quoted_price,
                        	@status = @tally_status,
				@strategy = @strategy

        	if @offset_trade_id = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Failed to tally offset trade"
        	end
	end
end


