drop procedure
	ag_borollrisk
go

create procedure
	ag_borollrisk
		@login varchar(50),
		@clearing_entity varchar(50),
		@trade_date datetime=NULL
as

declare @total_style varchar(250)
declare @head_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)
declare @deficit_style varchar(250)
declare @client_style varchar(250)

declare @begin_date datetime
declare @end_date datetime
declare @prime_broker_id int
declare @evaluation_currency_id int
declare @fund_id int
declare @max_roll_date datetime

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"run_name",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"trade_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"back_to_home",
	"Roll Risk Home",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"product",
	"Forward Ladder Balances",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"position",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"balance_equiv",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"balance",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"equiv",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@deficit_style = "background:#F5F3CE;color:#FF0000;border: 1px solid white",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold",
	 @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",  
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@selected_trade_style = "background:#F7F4C1;border: 1px solid white" ,
	@head_style = "background:#FFFFFF;border: 1px solid white;font-weight:bold"

exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @trade_date = NULL
	select
		@trade_date = convert(datetime, convert(date, getdate()))

create table
	#spot_value_dates(
		contract_id int,
		product_id int NULL,
		currency_id int NULL,
		symbol varchar(50) NULL,
		trade_date datetime,
		closing_date datetime,
		spot_date datetime,
		includes_holiday varchar(1))
insert into
	#spot_value_dates(
		contract_id,
		trade_date,
		closing_date,
		spot_date,
		includes_holiday)
select
	contract_id,
	trade_date,
	closing_date,
	spot_date,
	includes_holiday
from
	spot_value_dates
where
	convert(date, trade_date) = convert(date, @trade_date)

create table
	#inverted_contracts(
		contract_id int,
		product_id int, 
		currency_id int,
		inverted_contract_id int NULL)
insert into
	#inverted_contracts(
		contract_id,
		product_id,
		currency_id)
select
	a.contract_id,
	b.product_id,
	b.currency_id
from
	#spot_value_dates a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#inverted_contracts
set
	a.inverted_contract_id = b.contract_id
from
	#inverted_contracts a,
	forwards b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id

delete

from
	#inverted_contracts
where
	inverted_contract_id = NULL

insert into
	#spot_value_dates(
		contract_id,
		trade_date,
		closing_date,
		spot_date,
		includes_holiday)
select
	a.inverted_contract_id,
	b.trade_date,
	b.closing_date,
	b.spot_date,
	b.includes_holiday
from
	#inverted_contracts a,
	#spot_value_dates b
where
	a.contract_id = b.contract_id

update
	#spot_value_dates
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#spot_value_dates a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#spot_value_dates
set
	a.symbol = b.symbol
from
	#spot_value_dates a,
	contracts b
where
	a.contract_id = b.contract_id

create unique index
	u_svd
on
	#spot_value_dates(
		contract_id)
create unique index
	n_svd
on
	#spot_value_dates(
		contract_id,
		closing_date)

select
	@max_roll_date = max(spot_date)
from
	#spot_value_dates

select
	@prime_broker_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = @clearing_entity
if @prime_broker_id = NULL
begin
	select
		status = "Error",
		message = "Clearing Entity not found",
		clearing_entity = @clearing_entity
	return
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#begin_positions(
		external_account_id int,
		product_id int,
		value_date datetime,
		quantity float)
insert into
	#begin_positions(
		external_account_id,
		product_id,
		value_date,
		quantity)
select
	a.external_account_id,
	b.product_id,
	a.value_date,
	sum(a.quantity)
from
	trades a,
	forwards b,
	external_account_prime_brokers c,
	external_accounts d,
	settlement_methods e
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id 
and
	a.external_account_id = d.external_account_id 
and
	d.external_account_id = c.external_account_id 
and
	d.settlement_method_id = e.settlement_method_id
and
	/* e.name in("Roll To Eval Currency", "Roll By Pair") */
	e.name = "Roll To Eval Currency" /* will only work if all roll to USD*/
and
	c.prime_broker_id = @prime_broker_id
and
	a.value_date >= @begin_date
and
	a.value_date <= @max_roll_date
and
	a.trade_date < @end_date
group by
	a.external_account_id,
	b.product_id,
	a.value_date

delete from
	#begin_positions
where
	quantity = 0.0

insert into
	#begin_positions(
		external_account_id,
		product_id,
		value_date,
		quantity)
select
	a.external_account_id,
	b.currency_id,
	a.value_date,
	sum(a.quantity * a.price * -1.0)
from
	trades a,
	forwards b,
	external_account_prime_brokers c,
	external_accounts d,
	settlement_methods e
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
        a.external_account_id = d.external_account_id
and
        d.external_account_id = c.external_account_id
and
        d.settlement_method_id = e.settlement_method_id
and
        /* e.name in("Roll To Eval Currency", "Roll By Pair") */
	e.name = "Roll To Eval Currency" /* will only work if all roll to USD*/
and
	c.prime_broker_id = @prime_broker_id
and
	a.value_date >= @begin_date
and
	a.value_date <= @max_roll_date
and
	a.trade_date < @end_date
group by
	a.external_account_id,
	b.currency_id,
	a.value_date

delete from
	#begin_positions
where
	quantity = 0.0

create table
	#begin_balances(
		external_account_id int,
		product_id int,
		value_date datetime,
		balance float NULL)
insert into
	#begin_balances(
		external_account_id,
		product_id,
		value_date,
		balance)
select
	external_account_id,
	product_id,
	value_date,
	sum(quantity)
from
	#begin_positions
group by
	external_account_id,
	product_id,
	value_date

	
delete

from
	#begin_balances
where
	abs(balance) < 1.0
		
create table
	#roll_balances(
		product_id int,
		value_date datetime,
		balance float)
insert into
	#roll_balances(
		product_id,
		value_date,
		balance)
select
	a.product_id,
	a.value_date,
	sum(a.balance)
from
	#begin_balances a,
	#spot_value_dates b
where
	a.product_id = b.product_id
and
	a.value_date = b.closing_date
and
	b.currency_id = @evaluation_currency_id
group by
	a.product_id,
	a.value_date

create table
	#pair_balances(
		external_account_id int,
		contract_id int,
		value_date datetime,
		quantity numeric(30,4))
insert into
	#pair_balances(
		external_account_id,
		contract_id,
		value_date,
		quantity)
select
	a.external_account_id,
	a.contract_id,
	a.value_date,
	sum(a.quantity)
from
	trades a,
	external_account_prime_brokers b,
	external_accounts c,
	settlement_methods d
where
	a.external_account_id = b.external_account_id
and
	a.external_account_id = c.external_account_id
and
	b.external_account_id = c.external_account_id
and
	c.settlement_method_id = d.settlement_method_id
and
	d.name = "Roll By Pair"
and
	b.prime_broker_id = @prime_broker_id
and
	a.value_date >= @begin_date
and
	a.value_date <= @max_roll_date
and
	a.trade_date < @end_date
group by
	a.external_account_id,
	a.contract_id,
	a.value_date

create table
	#net_by_pair(
		contract_id int,
		value_date datetime,
		quantity numeric(30,4))
insert into
	#net_by_pair(
		contract_id,
		value_date,
		quantity)
select
	a.contract_id,
	a.value_date,
	sum(a.quantity)
from
	#pair_balances a,
	#spot_value_dates b
where
	a.contract_id = b.contract_id
and
	a.value_date = b.closing_date
group by
	a.contract_id,
	a.value_date

delete

from
	#pair_balances
where
	quantity = 0.0


select
	section = "Net Balances By Value Date",
	style = @style,
	b.symbol,
	a.value_date,
	a.balance
from
	#roll_balances a,
	products b
where
	a.product_id = b.product_id
order by
	b.symbol,
	a.value_date
	
select
	section = "Net Positions By Pair",
	style = @style,
	b.symbol,
	a.value_date,
	a.quantity
from
	#net_by_pair a,
	contracts b
where
	a.contract_id = b.contract_id
order by
	b.symbol,
	a.value_date
	
select
	section = "Roll To Eval Currency Balances By Account",
	style = @style,
	account = b.symbol,
	c.symbol,
	value_date = convert(varchar(11), a.value_date),
	a.balance
from
	#begin_balances a,
	external_accounts b,
	products c,
	settlement_methods d,
	#spot_value_dates e
where
	a.product_id = e.product_id
and
	e.currency_id = @evaluation_currency_id
and
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
and
	b.settlement_method_id = d.settlement_method_id
and
	a.value_date = e.closing_date
and
	d.name = "Roll To Eval Currency"
order by
	b.symbol,
	c.symbol,
	a.value_date 
	
select
	section = "Roll By Pair Balances By Account",
	style = @style,
	account = b.symbol,
	c.symbol,
	a.value_date,
	a.quantity
from
	#pair_balances a,
	external_accounts b,
	#spot_value_dates c,
	settlement_methods d
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.value_date = c.closing_date
and
	b.settlement_method_id = d.settlement_method_id
and
	d.name = "Roll By Pair"
order by
	b.symbol,
	c.symbol

	
go
