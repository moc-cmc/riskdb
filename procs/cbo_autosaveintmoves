create or replace procedure
	cbo_autosaveintmoves
		@login varchar(50),
		@trade_date datetime
as


declare @fund_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @ids int
declare @product_id int
declare @product varchar(10)
declare @status_id int
declare @rate float
declare @balance float
declare @days float
declare @external_account_id int
declare @interest float
declare @transaction_type_id int
declare @tico_account_id int
declare @value_date datetime
declare @first_of_month datetime
declare @account_transaction_id int
declare @batch_id int
declare @rate_date datetime
declare @note varchar(200)
declare @weekday varchar(100)
declare @no_rate_date char(1)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "New"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "New status not found"
	return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Interest Accrual"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Interest transaction type not found"
	return
end



select
	@trade_date = convert(datetime, convert(date, @trade_date))

/*  Can be a weekend so don't use this logic 
exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output */

select
	@end_date = dateadd(hour, 17, @trade_date)


select
        @first_of_month = convert(datetime,
                datename(month, dateadd(month, 1, @end_date)) +
                " 1, " +
                datename(year, dateadd(month, 1, @end_date)))


exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output

/*----------------------------------------------------------------------
 * Balancs from sub and master accountst
 */

create table
	#master_accounts(
                legal_entity_id int,
		legal_entity_name varchar(100),
                bo_master_account_id int,
                bo_external_account_id int,
		bo_external_account_symbol varchar(100),
		bo_external_account_name varchar(100)
)


create table
	#master_balances(
		legal_entity_id int,
		bo_master_account_id int,
		bo_external_account_id int,
		product_id int,
		amount float
)

create table
	#fo_sub_balances(
		legal_entity_id int,
		bo_master_account_id int,
		bo_external_account_id int,
		fo_sub_account_id int,
		fo_external_account_id int,
		product_id int,
		amount float
) 


create table
        #custody_balances(
                external_account_id int,
                product_id int,
                amount float
)




insert into
	#master_balances
select
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id,
        amount=sum(e.amount)
from
        legal_entities a,
        bo_master_accounts b,
        account_transactions e,
        products g,
	legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.external_account_id = e.external_account_id
and
        e.currency_id = g.product_id
and
        a.legal_entity_id = h.legal_entity_id
and
        e.transaction_date <= @end_date
group by
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id

/* There should be no pending balances, they should be swept into account_transactions */

insert into
	#fo_sub_balances(
		legal_entity_id,
		bo_master_account_id,
		bo_external_account_id,
		fo_sub_account_id,
		fo_external_account_id,
		product_id,
		amount
	)
select
	a.legal_entity_id,
	b.bo_master_account_id,
	b.external_account_id,
	c.fo_sub_account_id,
	c.external_account_id,
	g.product_id,
	amount=sum(e.amount)
from
	legal_entities a,
	bo_master_accounts b,
	fo_sub_accounts c,
	external_accounts d,
	account_transactions e,
	products g,
	legal_entities h
where
	a.legal_entity_id = b.legal_entity_id
and
	b.bo_master_account_id = c.bo_master_account_id
and
	c.external_account_id = d.external_account_id
and
	d.external_account_id = e.external_account_id
and
	e.currency_id = g.product_id
and
	a.legal_entity_id = h.legal_entity_id
and
	e.transaction_date <= @end_date
group by
	a.legal_entity_id,
	b.bo_master_account_id,
	b.external_account_id,
	c.fo_sub_account_id,
	c.external_account_id,
	g.product_id


create table
	#balances(
		id int identity,
		external_account_id int,
		product_id int ,
		balance float)

insert into
	#balances(
		external_account_id,
		product_id,
		balance)
select
	bo_external_account_id,
	product_id,
	amount
from
	#master_balances

/* debug
select * from #balances
*/
insert into
        #balances(
		external_account_id,
		product_id,
		balance)
select
        e.external_account_id,
        e.currency_id,
        sum(e.amount)
from
	external_accounts a,
	external_account_types b,
        account_transactions e
where
        a.external_account_id = e.external_account_id
and
        a.external_account_type_id = b.external_account_type_id
and
	b.name in("Custody", "Custody MMF")
and
        e.transaction_date <= @end_date
group by
        e.external_account_id,
	e.currency_id

/* debug
select * from #balances
*/

create table
        #bo_fo_balances(
                external_account_id int,
                product_id int ,
                balance float)
insert into
	#bo_fo_balances
select
	a.bo_external_account_id,
	a.product_id,
	sum(a.amount)
from
	#fo_sub_balances a
group by
	a.bo_external_account_id,
	a.product_id
/* debug
select
	"bo_fo_balances",
	*
from
	 #bo_fo_balances
*/

update
	#balances
set
	a.balance = a.balance + b.balance
from
	#balances a,
	#bo_fo_balances b
where
	a.product_id = b.product_id
and
	a.external_account_id = b.external_account_id

/* debug
select * from #balances
*/



select
	@id = 0
select
	@ids = count(*)
from
	#balances
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#balances
	where
		id > @id

	select
		@product_id = NULL,
		@balance = NULL,
		@rate = NULL,
		@rate_date = NULL,
		@interest = NULL,
		@external_account_id = NULL,
		@product = NULL,
		@account_transaction_id = NULL,
		@days = NULL

	select
		@product_id = product_id,
		@balance = balance,
		@external_account_id = external_account_id
	from
		#balances
	where
		id = @id

	select
		@days = 1.0

	select
		@rate_date = max(rate_date)
	from
		external_account_daily_rates
	where
		product_id = @product_id
	and
		external_account_id = @external_account_id
	and
		rate_date <= @end_date

	if @rate_date = NULL
	begin
		/* May not have a rate defined for all accounts, not necessarily an error */
		/* 
		select
			status = "Error",
			message = "No rate found for account and product",
			external_account_id = @external_account_id,
			product_id = @product_id,
			rate_date = @end_date
		*/
		select
			@no_rate_date= "Y"
	end
	else
	begin

		select
			@rate = rate,
			@days = payment_days_offset
		from
			external_account_daily_rates
		where
			product_id = @product_id
		and
			external_account_id = @external_account_id
		and
			rate_date = @rate_date
		
		exec
			u_bizdaysadd
				@first_of_month,
				@days,
				@value_date output
	
		select
			@product = symbol
		from
			products
		where
			product_id = @product_id
	
		if @rate = NULL
		begin
			select
				status = "Error",
				message = "No rate found for product",
				product = @product
		end
		else
		begin
			select
				@interest = (@rate/360.0) * @balance * 1.0
	
				/*@interest = (@balance * exp(@rate * (1.0/360.0))) - @balance*/
	
			if @interest != NULL and abs(@interest) >= 0.01
			begin
				/* Debug 
				select
					account_transaction_id = @account_transaction_id,
					tico_account_id = @tico_account_id,
					external_account_id = @external_account_id,
					transactio_type_id = @transaction_type_id,
					value_date = @value_date,
					product_id = @product_id,
					interest = convert(numeric(30,2), @interest),
					trade_date = @trade_date,
					status_id = @status_id
                        	*/
	
				select
					@note = NULL
	
				select
					@note = "Balance: " + rtrim(convert(varchar(30), convert(numeric(30,2), @balance))) + " As of: " + convert(varchar(22), @end_date) + " Rate: " + rtrim(convert(varchar(30), convert(numeric(30,4), @rate)))
	
				exec
					j_nextkey
						"account_transactions",
						@account_transaction_id output
	
				insert into
					pending_transactions(
						account_transaction_id,
						entered_by,
						external_account_id,
						transaction_type_id,
						transaction_date,
						currency_id,
						amount,
						create_date,
						status_id,
						note)
				values(
					@account_transaction_id,
					@tico_account_id,
					@external_account_id,
					@transaction_type_id,
					@value_date,
					@product_id,
					convert(numeric(30,2), @interest),
					@trade_date,
					@status_id,
					@note) 
			end
					
		end
	end


	select
		@ids = count(*)
	from
		#balances
	where
		id > @id
end


		

go 
