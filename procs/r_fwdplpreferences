
if object_id("r_fwdplpreferences") != NULL
    drop procedure
        r_fwdplpreferences
go

create procedure
	r_fwdplpreferences
		@login char(50)
as


declare @ti_account_id int
declare @refresh_rate int
declare @view_style char(50)
declare @sorting char(50)

select
	@ti_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
	raiserror 999999 "Problem determining current user"

create table
	#links(
		meta_type char(100),
		column char(30),
		link char(100),
		arguments char(255) NULL)
insert into
	#links
values(
	"Column Link",
	"set_view",
	"Set Forward P&L View",
	"suppressAutoexecute=YES")
--Adaptive Server has expanded all '*' elements in the following statement


select
	#links.meta_type, #links.column, #links.link, #links.arguments
from
	#links

create table
	#view_styles(
		view_style char(50),
		set_view char(25) NULL,
		sorting char(25) NULL,
		current_view char(10) NULL)

select
	@view_style = a.name,
	@sorting = c.name
from
	pl_view_styles a,
	fwd_pl_preferences b,
	sorting_styles c
where
	a.pl_view_style_id = b.pl_view_style_id
and
	b.sorting_style_id = c.sorting_style_id
and
	b.ti_account_id = @ti_account_id
if @@rowcount != 1
begin
	select
		@view_style = "Default",
		@view_style = "By Contract"
end
	

insert into
	#view_styles
select
	name,
	set_view = "CHOOSE VIEW",
	sorting = @sorting,
	current_view = NULL
from
	pl_view_styles


update
	#view_styles
set
	set_view = NULL,
	sorting = @sorting,
	current_view = "CURRENT"
where
	view_style = @view_style


