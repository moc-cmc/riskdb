use
	risk_jeff
go

drop procedure
	cbo_operations
go

create procedure
	cbo_operations
		@login varchar(50),
		@trade_date datetime=NULL


as


declare @tico_account_id int
declare @today datetime
declare @prev_date datetime
declare @next_date datetime
declare @weekday int
declare @daily_ops_status varchar(50)
declare @total_tasks_today int
declare @completed_tasks_today int
declare @pending_ops_task_status_id int
declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @grey_style varchar(200)
declare @max_commit_date datetime
declare @dodd_frank_enabled char(1)


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end


select 
	@max_commit_date = max(commit_date) 
from 
	daily_commits a, 
	commit_statuses b 
where 
	a.commit_status_id = b.commit_status_id 
and 
	b.name in("Commit Complete", "Commit Pending", "Commit Requested")

select
	@max_commit_date = convert(date, @max_commit_date)


if @trade_date = NULL
begin
	exec
		r_nextbusinessday
			@max_commit_date,	
			@trade_date output
end

exec
        r_prevbusinessday
                @trade_date,
                @prev_date output

exec
        r_nextbusinessday
                @trade_date,
                @next_date output

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@grey_style = "background:#FFFFFF;color:#666666;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


insert into
	#meta
values(
	"Column Link",
	"manage_rolls",
	"Manage Rollovers",
	NULL
)
insert into
	#meta
values(
	"Column Link",
	"manage_residuals",
	"Manage Residual Trades",
	NULL
)
insert into
	#meta
values(
	"Column Link",
	"manage_settlements",
	"Manage Settlements",
	"login=" + @login + "&valueDate=" + convert(varchar(10), @trade_date, 101)
)
insert into
	#meta
values(
	"Column Link",
	"manage_payments",
	"Manage Payments",
	NULL
)

insert into
        #meta
values(
        "Column Link",
        "manage_fees",
        "Fee Recon",
        NULL
)
insert into
        #meta
values(
        "Column Link",
        "statement_generation",
        "Statement Generation",
        NULL
)

insert into
	#meta
values(
	"Column Link",
	"affirmation_admin",
	"Affirmation Admin",
	NULL
)

insert into
	#meta
values(
	"Column Link",
	"manage_affirmations",
	"Trade Affirmations",
	NULL
)

insert into
	#meta
values(
	"Column Link",
	"manage_roll_dates",
	"Product Roll Dates",
	NULL
)




insert into
	#meta
values(
	"Column Link",
	"previous_date",
	"Daily Operations",
	"login=" + @login + "&tradeDate=" + convert(varchar(10), @prev_date, 101)
)
insert into
	#meta
values(
	"Column Link",
	"next_date",
	"Daily Operations",
	"login=" + @login + "&tradeDate=" + convert(varchar(10), @next_date, 101)
)

insert into
	#meta
values(
	"Column Hidden",
	"trade_date",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Hidden",
        "value_date",
        NULL,
        NULL)
insert into
        #meta
values(
        "Column Hidden",
        "task_id",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "mark_as",
        "Mark Ops Task",
        NULL
)

select
	@pending_ops_task_status_id = ops_task_status_id
from
	ops_task_statuses
where
	name = "Pending"
if @pending_ops_task_status_id = NULL
begin
	select 
		status="Error",
		message="Could not find 'Pending' ops task status"
	return
end

/* Grab all possible ops tasks that would be queued for today */
create table
	#daily_ops_tasks(
		id int identity,
                ops_task_id int,
                trade_date date,
                ops_task_status_id int,
                user_id int NULL,
                timestamp datetime NULL
)



insert into
	#daily_ops_tasks(
		ops_task_id,	
		trade_date,	
		ops_task_status_id,
		user_id,
		timestamp)
select
	a.ops_task_id,    
	@trade_date,     
	@pending_ops_task_status_id,
	NULL,
	NULL
from
	ops_tasks a,
	statuses b
where
	a.status_id = b.status_id
and
	a.create_date <= @trade_date
and
	b.name = "Active"


/* Delete possible ops tasks if they are already queued */
delete
	#daily_ops_tasks
from
	#daily_ops_tasks a,
	daily_ops_tasks b
where
	a.ops_task_id = b.ops_task_id
and
	a.trade_date = b.trade_date

/*
select 
	debug="#daily_ops_tasks",
	*
from
	#daily_ops_tasks
*/

/* Queue up any unqueued_tasks */
insert into
	daily_ops_tasks(
                ops_task_id,
                trade_date,
                ops_task_status_id,
                user_id,
                timestamp)
select
	ops_task_id,
	trade_date,
	ops_task_status_id,
	user_id,
	timestamp
from
	#daily_ops_tasks

select
	@total_tasks_today = count(*)
from
	daily_ops_tasks
where
	trade_date = convert(date, @trade_date)

select
	@completed_tasks_today = count(*)
from
	daily_ops_tasks a,
	ops_task_statuses b
where
	a.ops_task_status_id = b.ops_task_status_id
and
	b.name = "Complete"

if @total_tasks_today = @completed_tasks_today
begin
	select
		@daily_ops_status = "Complete"
end
		
select * from #meta

select
        style = @style,
        previous_date = "<< Previous Date",
	/*back_office_date = @trade_date,*/
	status = case when @daily_ops_status = "Complete" then "<b><font color='00CC00'>Complete</font></b>" else  "<b><font color='FF0000'>Tasks not yet completed for date: "+ convert(varchar(15), @trade_date, 107) +"</font></b>" end,
        next_date = "Next Date  >>"

select
	@dodd_frank_enabled = "Y"
from
	enabled_product_features
where
	name = "Dodd Frank Affirmations"

select
	section = "Operations",
	style = @style,
	manage_rolls = "Manage Rollovers",
	manage_residuals = "Manage Residuals",
	manage_settlements = "Manage Settlements",
	manage_affirmations = case when @dodd_frank_enabled = "Y" then "Trade Affirmations" else NULL end,
	affirmation_admin  = case when @dodd_frank_enabled = "Y" then "Affirmation Admin" else NULL end,
	manage_roll_dates = "Manage Roll Dates",
	/*manage_conversions = "Manage Conversions",*/
        /*manage_payments = "Manage Payments",*/
	/*manage_fees = "Manage Fees",*/
	/*statement_generation = "Generate Client Statements",*/
	trade_date= @trade_date,
	value_date= @trade_date

create table
	#task_output
(
	id int identity,
	section varchar(100) NULL,
	style varchar(100) NULL,
	task_id int NULL,
	task varchar(150) NULL,
	task_group varchar(50) NULL,
	assigned_to_id int NULL,
	assigned_to varchar(50) NULL,
	task_status varchar(50) NULL,
	mark_as varchar(25) NULL,
	ordering int NULL,
	completed_at datetime NULL,
	completed_by_id int NULL,
	completed_by varchar(50) NULL
)

insert into
	#task_output(
		section,
		style,
		task_id,
		task,
		task_group,	
		assigned_to_id,
		task_status,
		ordering,
		completed_at,
		completed_by_id )
select
	section = rtrim(c.name)+" Tasks for " + convert(varchar(15), @trade_date, 107),
	style = @style,
	task_id = a.daily_ops_task_id,
	task = b.name,
	task_group = c.name,
	assigned_to_id = b.assigned_to,
	task_status = d.name,
	ordering = b.ordering,
	completed_at = a.timestamp,
	completed_by_id = a.user_id
from
	daily_ops_tasks a,
	ops_tasks b,
	ops_task_types c,
	ops_task_statuses d
where
	a.ops_task_id = b.ops_task_id
and
	b.ops_task_type_id = c.ops_task_type_id
and
	a.ops_task_status_id = d.ops_task_status_id
and
	a.trade_date = convert(date, @trade_date)
order by
	c.name DESC,
	b.ordering

update
	#task_output
set
	mark_as = "MARK COMPLETE"
where
	task_status = "Pending"

update
	#task_output
set
	style  = @grey_style,
	mark_as = "UNMARK"
where
	task_status = "Complete"

	
update
	#task_output
set
	assigned_to = rtrim(given_names)+' '+rtrim(surname)
from
	tico_accounts a,
	#task_output b
where
	a.account_id = b.assigned_to_id

update
        #task_output
set
        completed_by = rtrim(given_names)+' '+rtrim(surname)
from
        tico_accounts a,
        #task_output b
where
        a.account_id = b.completed_by_id


select
        section,
        style,
        task,
        task_group,
        assigned_to,
        task_status,
	mark_as,
	completed_by,
	completed_at,
	task_id,
	trade_date=@trade_date
from
	#task_output
order by 
	section desc,
	ordering


go


