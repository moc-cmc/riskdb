create or replace  procedure
	tt_eodtradereporttimestamp
		@run_name varchar(50),
		@source varchar(50),
		@trade_date datetime=NULL,
		@query_options char(1)=NULL,
                @query_futures char(1)=NULL,
                @format_swaps char(1)=NULL
		
as

declare @run_id int
declare @begin_date datetime
declare @end_date datetime
declare @source_id int

if @trade_date = NULL
        /* runs on a 12pm-12pm schedule */
	select
		@trade_date = convert(date, getdate())

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

select
	@run_id = run_id
from
	runs
where
	name = @run_name
if @run_id = NULL
begin
	select
		error = "Error",
		msg = "Run not found",
		run_name = @run_name
	return
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


