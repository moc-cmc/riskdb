drop procedure
	r_importcctfuturessettles
go

create procedure
	r_importcctfuturessettles
		@login varchar(50),
		@source varchar(50),
		@trade_date varchar(50),
		@cctr_contract_id varchar(50),
		@blg_code varchar(50),
		@market_rate varchar(50),
		@price_type varchar(50)

as

declare @tally_market_rate float
declare @tally_trade_date datetime
declare @tally_file_date datetime
declare @symbol varchar(50)
declare @standard_contract varchar(10)
declare @source_id int

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		"Error"="ERROR",
		"msg"="Problem determining source",
		"source"= @source
	return
end

select
	@tally_market_rate = convert(float, @market_rate),
	@tally_trade_date = convert(datetime, @trade_date)

select
	@symbol = a.symbol
from
	contracts a,
	contract_symbols b
where
	a.contract_id = b.contract_id
and
	b.source_id = @source_id
and
	b.symbol = @blg_code
if @symbol = NULL
begin
	select
		@symbol = symbol
	from
		contracts
	where
		symbol = @blg_code
	if @symbol = NULL
	begin
		select
			msg = "Contract does not exist or is not mapped",
			contract = @blg_code,
			sql="insert into contract_symbols values(xxxx, 56, '"+rtrim(@blg_code)+"'"
		return
	end
end

/*select "exec r_editsettle ", @symbol, @tally_trade_date, @tally_market_rate
*/
exec
        r_editsettle
                @symbol,
                @tally_trade_date,
                @tally_market_rate

go
