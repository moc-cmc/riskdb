drop procedure
	tt_tallyboamercury
go

create procedure
	tt_tallyboamercury
		@login varchar(25),
		@source varchar(25)=NULL,
		@sender_comp varchar(50),
		@target_comp varchar(50),
		@identifier varchar(100),
		@trader varchar(25),
		@broker varchar(25),
		@trade_date datetime,
                @trade_day datetime=NULL,
		@type varchar(25),
		@ccy_pair varchar(25),
		@dealt_ccy varchar(10),
		@buy_sell varchar(5),
		@ccy1 varchar(10),
		@ccy1_amount1 float,
		@ccy2 varchar(10),
		@ccy2_amount1 float,
		@near_rate float,
		@near_points float,
		@near_value_date datetime,
		@ccy1_amount2 float=NULL,
		@ccy2_amount2 float=NULL,
		@far_rate float=NULL,
		@far_value_date datetime=NULL,
		@spot_rate float=NULL,
		@fwd_points float=NULL,
		@no_spot_nearleg_fwd float=NULL,
		@fwd_fwd_points float=NULL,
		@fixing_date datetime=NULL

as

declare @trade_id int
declare @far_trade_id int
declare @far_trade_type varchar(50)
declare @far_tally_type varchar(50)
declare @external_account varchar(50)
declare @external_account_id int
declare @deal_id int
declare @symbol varchar(50)
declare @trade_type varchar(25)
declare @contract_id int
declare @source_id int
declare @broker_id int
declare @trade_identifier varchar(100)
declare @far_trade_identifier varchar(100)
declare @trader_id int
declare @broker_symbol varchar(50)
declare @queued_trade_id int
declare @review_status_id int
declare @quantity numeric(30, 4)
declare @counterparty varchar(50)
declare @counterparty_id int
declare @far_quantity numeric(30,4)
declare @mkt_far_quantity numeric(30,4)
declare @strategy_id int
declare @deal_type varchar(100)
declare @tally_type varchar(50)
declare @status varchar(50)
declare @substring1 int
declare @substring2 int
declare @check_lookup_trader varchar(50)
declare @check_trader_id int
declare @fund_agency_trader varchar(50)
declare @trader_login varchar(50)
declare @cpty_ext_acct_id int
declare @lookup_cpty varchar(50)
declare @external_account_type varchar(50)
declare @lookup_trader varchar(50)
declare @aggregation_style varchar(50)
declare @mkt_trade_id int
declare @mkt_trade_identifier varchar(50)
declare @mkt_lookup_trader varchar(50)
declare @mkt_trader_id int
declare @mkt_trader varchar(50)
declare @mkt_trader_login varchar(50)
declare @mkt_external_account_type varchar(50)
declare @mkt_counterparty_id int
declare @mkt_counterparty varchar(50)
declare @mkt_external_account varchar(50)
declare @mkt_external_account_id int
declare @mkt_lookup_cpty varchar(50)
declare @mkt_qty numeric(30,4)
declare @deal_exec_symbol varchar(50)
declare @suppress_trade varchar(50)
declare @last_qty numeric(30,4)
declare @suppressed_trade_id int
declare @suppressed_deal_id int
declare @mkt_far_trade_id int
declare @mkt_far_trade_identifier varchar(50)



select
	@status = "User Review"

select
	@type = "FORWARD"

if @spot_rate = NULL
	select
		@spot_rate = @near_rate

select
        @review_status_id = status_id
from
        statuses
where
        name = "Review"
if @review_status_id = NULL
begin
        select
                error="Error",
                msg="Problem finding 'Review' status"
        return
end

select 
	@deal_type = "Market Forward"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select 
		error="Error",
		msg="Problem determining source",
		source=@source
	return
end

if @dealt_ccy = substring(@ccy_pair, 1, 3)
begin
	select
		@symbol = substring(@ccy_pair, 1, 3) + substring(@ccy_pair, 5, 3),
		@last_qty = @ccy1_amount1
end
else if @dealt_ccy != substring(@ccy_pair, 1, 3)
begin
	select
		@symbol = substring(@ccy_pair, 5, 3) + substring(@ccy_pair, 1, 3),
		@last_qty = @ccy1_amount1
	
end
else 
begin
        select 
                error="Error",
                msg="Problem determining symbol and quantity from ccys",
                dealt_ccy=@dealt_ccy,
                ccy1=@ccy1,
                ccy2=@ccy2
        return
end


select 
	@symbol
select
	@near_rate


if lower(@buy_sell) = "sell"
begin
        select
                @last_qty = abs(@last_qty) * -1.0
end
if lower(@buy_sell) = "buy"
begin
        select
                @last_qty = abs(@last_qty)
end


select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @broker_id = NULL
begin
	select
		error="Error",
		msg="Problem determining broker from broker symbol",
		broker_symbol =@broker
	return
end

 /*-------------------------------------------------------------------------------,
   | Client vs Counterparty Flow
   |
   | if @account is a fund_agency_trader, this is a counterparty trade
   | if @account is not a fund_agency_trader, this is a client trade 
   | message is always in @account perspective. if @account = client, flip QTY
   '-------------------------------------------------------------------------------*/

select
	@fund_agency_trader = "N"
select
        @check_trader_id = a.trader_id
from
        traders a,
        trader_symbols b,
        sources ba
where
        a.trader_id = b.trader_id
and
        b.source_id = ba.source_id
and
        ba.source_id = @source_id
and
        b.symbol = @trader

if @check_trader_id = NULL
begin
        select
                @check_trader_id = a.trader_id
        from
                traders a
        where
                a.symbol = @trader

        if @check_trader_id = NULL
        begin
        	select
                        status = "Error",
                        message = "Couldn't find trader and user for @trader, '" + @trader + "'",
                        check_lookup_trader = @trader
                return
	end
end

select
	@fund_agency_trader = "Y"
from
	fund_agency_traders
where
	trader_id = @check_trader_id


if @fund_agency_trader = "Y"
begin
        /* This is a market/street trade */

	select
		/*@trade_identifier = rtrim(@execution_id)+"-"+@trading_day+".m",*/
		@trade_identifier = rtrim(@identifier),
		@lookup_cpty = @broker,
		@lookup_trader = @trader,
		@deal_exec_symbol = rtrim(@identifier)
	select
		@trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id
	and
		identifier = @trade_identifier
	if @trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Trade is already tallied",
			trade_identifier = @trade_identifier
		return
	end


	/*
 	* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 	*/ 
	
	select
		@trader_id = a.trader_id,
		@trader = a.symbol,
		@trader_login = c.login,
		@external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	sources ba,
        	tico_accounts c
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = ba.source_id
	and
        	a.tico_account_id = c.account_id
	and
        	ba.name = @source
	and 
        	b.symbol = @lookup_trader
	
	if @trader_id = NULL or @trader_login = NULL
	begin
    		select
            		@trader_id = a.trader_id,
            		@trader = a.symbol,
            		@trader_login = c.login,
            		@external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @lookup_trader
	
    		if @trader_id = NULL or @trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            			mkt_lookup_trader = @lookup_trader
        			return
    			end		
	end
	
	/*
 	* LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 	*/
	
	select
		@counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b,
        	sources ba
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = ba.source_id
	and
        	ba.name = @source
	and
        	b.symbol = @lookup_cpty
	if @counterparty = NULL
	begin
        	select
                	@counterparty_id = a.counterparty_id,
			@counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
        	
        	if @counterparty = NULL
        	begin
               		select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
				mkt_lookup_cpty = @lookup_cpty
                	return
        	end
	end


	/*
 	* LOOKUP @external_account, @external_account_type based on  @cpty_ext_acct_id
 	*/
	select
    		@external_account = a.symbol,
    		@external_account_type = b.name,
    		@aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @cpty_ext_acct_id
	if @external_account = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find external_account from @external_account_id",
			mkt_external_account_id = @external_account_id
		return
	end
end /* market trade details */

if @fund_agency_trader = "N"
begin
	/* book B2B */

	select
		@mkt_trade_identifier = rtrim(@identifier)+ ".m",
                @mkt_lookup_cpty = @broker,
                @mkt_lookup_trader = @sender_comp,
                @deal_exec_symbol = rtrim(@identifier),
                @mkt_qty = @last_qty,
		@trade_identifier = rtrim(@identifier)+".c",
		@lookup_cpty = @target_comp,
		@lookup_trader = @trader,
		@last_qty = -@last_qty



	/*
 	* LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 	*/ 
	
	select
		@trader_id = a.trader_id,
		@trader = a.symbol,
		@trader_login = c.login,
		@external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	sources ba,
        	tico_accounts c
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = ba.source_id
	and
        	a.tico_account_id = c.account_id
	and
        	ba.name = @source
	and 
        	b.symbol = @lookup_trader
	
	if @trader_id = NULL or @trader_login = NULL
	begin
    		select
            		@trader_id = a.trader_id,
            		@trader = a.symbol,
            		@trader_login = c.login,
            		@external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @lookup_trader
	
    		if @trader_id = NULL or @trader_login = NULL
    		begin
			select
            		status = "Error",
            		message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            		cli_lookup_trader = @lookup_trader
        		return
    		end		
	end
	
	/*
 	* LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 	*/
	
	select
		@counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b,
        	sources ba
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = ba.source_id
	and
        	ba.name = @source
	and
        	b.symbol = @lookup_cpty
	if @counterparty = NULL
	begin
        	select
                	@counterparty_id = a.counterparty_id,
			@counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @lookup_cpty
        	
        	if @counterparty = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
				cli_lookup_cpty = @lookup_cpty
                	return
        	end
	end
	
	
	/*
 	* LOOKUP @external_account, @external_account_type based on @external_account_id
 	*/
	select
    		@external_account = a.symbol,
    		@external_account_type = b.name,
    		@aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @external_account_id
	if @external_account = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find external_account from @external_account_id",
			cli_external_account_id = @external_account_id
		return
	end

	/* End of Client lookups */
	
	/* Begin MKT lookups */

	select
		@mkt_trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id
	and
		identifier = @mkt_trade_identifier
	if @mkt_trade_id !=NULL
	begin
		select
			status = "Dupe",
			message = "Trade is already tallied",
			trade_identifier = @mkt_trade_identifier
		return
	end


	/*
 	* LOOKUP @mkt_trader_id, @mkt_trader, @mkt_trader_login, @mkt_external_account_id 
 	*/ 
	
	select
		@mkt_trader_id = a.trader_id,
		@mkt_trader = a.symbol,
		@mkt_trader_login = c.login,
		@mkt_external_account_id = a.external_account_id
	from
        	traders a,
        	trader_symbols b,
        	sources ba,
        	tico_accounts c
	where    
        	a.trader_id = b.trader_id
	and
        	b.source_id = ba.source_id
	and
        	a.tico_account_id = c.account_id
	and
        	ba.name = @source
	and 
        	b.symbol = @mkt_lookup_trader
	
	if @mkt_trader_id = NULL or @mkt_trader_login = NULL
	begin
    		select
            		@mkt_trader_id = a.trader_id,
            		@mkt_trader = a.symbol,
            		@mkt_trader_login = c.login,
            		@mkt_external_account_id = a.external_account_id
    		from
            		traders a,
            		tico_accounts c
    		where    
            		a.tico_account_id = c.account_id
    		and 
            		a.symbol = @mkt_lookup_trader
	
    		if @mkt_trader_id = NULL or @mkt_trader_login = NULL
    			begin
				select
            			status = "Error",
            			message = "Couldn't find trader and user for @mkt_lookup_trader, '" + @mkt_lookup_trader + "'",
            			mkt_lookup_trader = @mkt_lookup_trader
        			return
    			end		
	end
	
	/*
 	* LOOKUP @mkt_counterparty_id, @mkt_counterparty_symbol, @cpty_ext_acct_id from @mkt_lookup_cpty
 	*/
	
	select
		@mkt_counterparty_id = a.counterparty_id,
		@mkt_counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
	from
        	counterparties a,
        	counterparty_symbols b,
        	sources ba
	where
        	a.counterparty_id = b.counterparty_id
	and
        	b.source_id = ba.source_id
	and
        	ba.name = @source
	and
        	b.symbol = @mkt_lookup_cpty
	if @mkt_counterparty = NULL
	begin
        	select
                	@mkt_counterparty_id = a.counterparty_id,
			@mkt_counterparty = a.name,
			@cpty_ext_acct_id = a.external_account_id
        	from
                	counterparties a
        	where
                	a.name = @mkt_lookup_cpty
        	
        	if @mkt_counterparty = NULL
        	begin
               		select
                        	status = "Error",
                        	message = "Couldn't find counterparty for @mkt_lookup_cpty, '" + @mkt_lookup_cpty + "'",
				mkt_lookup_cpty = @mkt_lookup_cpty
                	return
        	end
	end


	/*
 	* LOOKUP @mkt_external_account, @mkt_external_account_type based on  @cpty_ext_acct_id
 	*/
	select
    		@mkt_external_account = a.symbol,
    		@mkt_external_account_type = b.name,
    		@aggregation_style = c.name
	from
    		external_accounts a,
    		external_account_types b,
    		aggregation_styles c
	where
    		a.external_account_type_id = b.external_account_type_id
	and
    		a.aggregation_style_id = c.aggregation_style_id
	and
    		a.external_account_id = @cpty_ext_acct_id
	if @mkt_external_account = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find external_account from @mkt_external_account_id",
			mkt_external_account_id = @mkt_external_account_id
		return
	end
	/* End of mkt lookups */
end


select
	@suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id 
and
	symbol = @lookup_trader



if @far_value_date != NULL
begin
	select
		@far_quantity = @last_qty * -1,
		@mkt_far_quantity = @mkt_qty * -1

	select
		@trade_identifier = @trade_identifier + ".n",
		@far_trade_identifier = @trade_identifier + ".f",
		@mkt_trade_identifier = @mkt_trade_identifier + ".n",
		@mkt_far_trade_identifier = @mkt_trade_identifier + ".f"
end


if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

select
    @contract_id = contract_id
from
    contracts
where
    symbol = @symbol
if @@rowcount != 1
begin
        select
            status = "Error",
            message = "Contract not found",
            symbol=@symbol

        return
end



/* ------------Value Date Adjustments --------------------
   problem:
     es-fix library will pass in a converted GMT timestamp even for value dates
     So, if the value date is "20130725T00:00:00.000Z"
     we end up tallying value date as "20130724 8:00 EST", which is incorrect
   solution: 
     if there is a timestamp, add 8 hours to value dates and then truncate timestamp.
     This will ensure proper value date w/o worrying about daylight savings
----------------------------------------------------------*/

	select
		@near_value_date = dateadd(hh, 8, @near_value_date)
	select
		@near_value_date = convert(date, @near_value_date)
	select
		@far_value_date = dateadd(hh, 8, @far_value_date)
	select
		@far_value_date = convert(date, @far_value_date)
        select
		@fixing_date = dateadd(hh, 8, @fixing_date)
	select
		@fixing_date = convert(date, @fixing_date)

/*
if @near_value_date != convert(date, @near_value_date)
begin
end
if @far_value_date != convert(date, @far_value_date)
begin
end
*/

if @type = "FORWARD"
begin
	select
		@trade_type = "Forward",
		@tally_type = "Forward",
		@deal_type = "Market Forward"

	if @far_value_date != NULL
	begin
		select
			@trade_type = "Near Swap",
			@far_trade_type = "Far Swap",
			@tally_type = "Swap",
			@far_tally_type = "Swap",
			@deal_type = "Market Swap"
	end
end
else
begin
	select
		"error"="Error",
		"msg"="Unsuppored trade type",
		"type"=@type
	return
end


/* Tally Trade */

if @suppress_trade = "Y"
begin
exec
        fxa_suppresstrade
                @login = @trader_login,
                @source = @source,
                @suppressed_trade_id = @suppressed_trade_id out,
                @deal_id = @suppressed_deal_id out,
                @deal_identifier = @deal_exec_symbol,
                @tally_type = @trade_type,
                @deal_type = @deal_type,
                @trade_type = @trade_type,
                @external_account = @external_account,
                @counterparty = @counterparty,
                @quantity = @last_qty,
                @symbol = @symbol,
                @value_date = @near_value_date,
                @price = @near_rate,
                @trade_date = @trade_date,
                @trader = @trader,
                @broker = @broker,
                @identifier = @trade_identifier,
                @spot_reference = @near_rate
        if @suppressed_trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to suppress trade"
        end
        select
                status = "Suppressed",
                message = "Trade successfully suppressed",
                trade_id = @suppressed_trade_id,
                deal_id = @suppressed_deal_id,
                account = @external_account,
                symbol = @symbol,
                quantity = @last_qty,
                price = @near_rate,
                val_date = @near_value_date
        return
end
else
begin
        exec
                fxa_tallytrade
                        @login = @trader_login,
                        @source = @source,
                        @trade_id = @trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @tally_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @external_account,
                        @counterparty = @counterparty,
                        @quantity = @last_qty,
                        @symbol = @symbol,
                        @value_date = @near_value_date,
                        @price = @near_rate,
                        @trade_date = @trade_date,
                        @trader = @trader,
                        @broker = @broker,
                        @identifier = @trade_identifier,
                        @spot_reference = @near_rate


        if @trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally client trade"
                return
        end
        else
        begin
                insert into
                        trade_quoted_prices (
                                trade_id,
                                price)
                values(
                        @trade_id,
                        @near_rate
                        )
                exec
                        r_inserttradenotification
                        @trade_id
        end
end
if @mkt_qty != NULL
begin
        exec
                fxa_tallytrade
                        @login = @mkt_trader_login,
                        @source = @source,
