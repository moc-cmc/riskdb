
if object_id("tt_cognotecstptally") != NULL
    drop procedure
        tt_cognotecstptally
go

create procedure
	tt_cognotecstptally
       		@agent varchar(50),
       		@source varchar(50),
       		@client_source varchar(50),
		@default_login varchar(50),
       		@executing_firm varchar(50),
       		@contra_firm varchar(50),	/* Counterparty for Market. Trader for Client */
       		@sponsoring_firm varchar(50),	/* sometimes NULL */
		@trade_sub_type int,	/* Determines client or market */ 
       		@trade_date datetime,
       		@trading_day datetime,
       		@trade_report_id varchar(50),
       		@order_id varchar(50),
       		@client_order_id varchar(50),
       		@execution_id varchar(50),
       		@symbol varchar(50),
       		@ccy1 varchar(10),
       		@ccy2 varchar(10),
       		@value_date datetime,
       		@side varchar(10),
       		@qty1 float,
       		@price float


as

declare @trader varchar(50)
declare @user varchar(50)
declare @counterparty varchar(50)
declare @counterparty_id int
declare @trade_identifier varchar(50)
declare @deal_exec_symbol varchar(50)
declare @deal_alias varchar(50)
declare @source_id int
declare @broker varchar(50)
declare @external_account varchar(50)
declare @internal_account varchar(50)

declare @trader_id int
declare @tico_account_id int
declare @external_account_id int
declare @deal_id int
declare @trade_id int
declare @external_account_type varchar(30)
declare @contract_id int
declare @strategy_id int
declare @status_id int
declare @broker_id int
declare @broker_symbol varchar(50)
declare @trade_status_id int
declare @deal_exec_symbol_id int
declare @notification_source varchar(50)
declare @notification_source_id int
declare @active_status_id int
declare @msg varchar(200)

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @deal_type_id int
declare @deal_status_id int
declare @trd_spot_ref float
declare @quoted_price float

declare @sales_code_id int
declare @do_not_tally_salescode_id int

declare @fund_agency_counterparty_id int

select
	@trade_type = "Spot",
	@deal_type = "B2B Forward",
	@trd_spot_ref = @price,
	@quoted_price = @price

select
	@do_not_tally_salescode_id = sales_code_id
from
	sales_codes
where 
	name = "DONT TALLY"

select
    @deal_status_id = status_id
from
    statuses
where
    name = "User Review"

if @deal_status_id = NULL
begin
	select
		status = "Error",
		message = "No status found named, 'User Review'"
	return
end

select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = @deal_type
if @deal_type_id = NULL
begin
	select
		status = "Error",
		msg = "No deal type found for",
		deal_type = @deal_type
	return
end


select
	@internal_account = symbol
from
	internal_accounts
where
	symbol = @client_source
if @@rowcount != 1
begin
	select
		status = "Error",
		message= "Internal account not found",
		internal_account = @client_source
	return
end


select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end

/*
 * DETERMINE @external_account_type, @counterparty, @trader based on @trade_sub_type
 */

   /*-------------------------------------------------------------------------------,
   | Client vs Counterparty Flow
   | 
   | if @trade_sub_type = 1, it's a market trade.
   | if @trade_sub_type = 2, it's a client trade.
   | 
   | If client --> @counterparty is determinged by @executing_firm
   |           --> @trader is determined by @contrafirm
   |           --> @external_account is determined from @trader
   |  
   | If market --> @counterparty is determined by @contra_firm
   |           --> @trader is determined by @executing_firm
   |           --> @external_account is determined from counterparties.external_account_id
   '-------------------------------------------------------------------------------*/

if @trade_sub_type = 1		/* INTERNAL_TRANSFER_OR_ADJUSTMENT */
begin
	/* This is a market/street trade */

	select 
		@counterparty = b.name,
		@counterparty_id = b.counterparty_id
	from
		counterparty_symbols a,
		counterparties b
	where
		a.counterparty_id = b.counterparty_id 
	and
		a.source_id = @source_id
	and
		a.symbol = @contra_firm
	if @counterparty = NULL
	begin
		select
			@counterparty = name,
			@counterparty_id = counterparty_id
		from
			counterparties
		where
			name = @contra_firm
		if @counterparty = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find counterparty for market trade with @contra_firm, '" + @contra_firm + "'",	
				contra_firm = @contra_firm
			return
		end
	end

	select
		@user = c.login,
		@trader = a.symbol,
		@sales_code_id = a.sales_code_id
	from
		traders a,
		trader_symbols b,
		sources ba,
		tico_accounts c
	where
		a.trader_id = b.trader_id
	and
		b.source_id = ba.source_id
	and
		a.tico_account_id = c.account_id
	and
		ba.name = @source
	and
		b.symbol = @executing_firm

	if @user = NULL or @trader = NULL
	begin
		select
			@user = b.login,
			@trader = a.symbol,
			@sales_code_id = a.sales_code_id
		from
			traders a,
			tico_accounts b
		where
			a.tico_account_id = b.account_id
		and
			a.symbol = @executing_firm

		if @trader = NULL or @user = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find trader and user for @executing_firm, '" + @executing_firm + "'",
				executing_firm = @executing_firm,
				trader = @trader
				/*user = @user*/
			return
		end
	end

	select
		@external_account = a.symbol,
		@external_account_id = a.external_account_id
	from
		external_accounts a,
		counterparties b
	where
		a.external_account_id = b.external_account_id
	and
		b.name = @counterparty
	if @external_account = NULL
	begin
	        select
                     	status = "Error",
                       	message = "Couldn't find market account for @external_account from @counterparty, '" + @counterparty + "'",
                       	trader = @counterparty
               	return
	end
    
    /* IOC: To support IOC orders, we also want to record the a @deal_alias if
     * the @client_order_id looks like "<number>-<number>", like "629809-1". See
     * the @deal_id lookup below. */
    if @client_order_id not like "%[^0-9-]%" and @client_order_id like "[0-9]%[0-9]"
    begin
        select
            @deal_alias = substring(@client_order_id, 1, charindex('-', @client_order_id) - 1)
            
        select
            msg = "M0: Found possible IOC",
            client_order_id = @client_order_id,
            deal_alias = @deal_alias
            
    end
    
end /* market trade details */

if @trade_sub_type = 2		/* EXTERNAL_TRANSFER_OR_TRANSFER_OF_ACCOUNT */
begin
	/* This is a client trade */

	select 
		@counterparty = b.name,
		@counterparty_id = b.counterparty_id
	from
		counterparty_symbols a,
		counterparties b
	where
		a.counterparty_id = b.counterparty_id 
	and
		a.source_id = @source_id
	and
		a.symbol = @executing_firm
	if @counterparty = NULL
	begin
		select
			@counterparty = name,
			@counterparty_id = counterparty_id
		from
			counterparties
		where
			name = @executing_firm
		if @counterparty = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find counterparty for client trade with @executing_firm, '" + @executing_firm + "'",	
				executing_firm = @executing_firm
			return
		end
	end

	select
		@user = c.login,
		@trader = a.symbol,
		@trader_id = a.trader_id,
		@sales_code_id = a.sales_code_id
	from
		traders a,
		trader_symbols b,
		sources ba,
		tico_accounts c
	where
		a.trader_id = b.trader_id
	and
		b.source_id = ba.source_id
	and
		a.tico_account_id = c.account_id
	and
		ba.name = @source
	and
		b.symbol = @contra_firm
	if @user = NULL or @trader = NULL
	begin
		select
			@user = b.login,
			@trader = a.symbol,
			@sales_code_id = a.sales_code_id
		from
			traders a,
			tico_accounts b
		where
			a.tico_account_id = b.account_id
		and
			a.symbol = @contra_firm
		if @trader = NULL or @user = NULL
		begin
			select
				status = "Error",
				message = "Couldn't find trader and user for @contra_firm, '" + @contra_firm + "'",
				contra_firm = @contra_firm,
				trader = @trader
				/*user = @user*/
			return
		end
	end

	select
		@external_account = a.symbol,
		@external_account_id = a.external_account_id
	from
		external_accounts a,
		traders b
	where
		a.external_account_id = b.external_account_id
	and
		b.symbol = @trader
	if @external_account = NULL
	begin
	        select
                     	status = "Error",
                       	message = "Couldn't find client account for @external_account from @trader, '" + @trader + "'",
                       	trader = @trader
               	return
	end


    /* IOC: To support IOC orders, we also want to record the a @deal_alias for
     * all client trades. */
    if @execution_id not like "%[^0-9]%"
    begin
        select
            @deal_alias = @execution_id
            
        select
            msg = "M1: Added",
            execution_id = @execution_id,
            deal_alias = @deal_alias
            
    end

end /* client trade details */
if @trade_sub_type not in(1, 2)
begin
	select
		status = "Error",
		message = "Recieved unexpected @trade_sub_type, '" + convert(varchar(10),  @trade_sub_type) + "'",
                trade_sub_type = @trade_sub_type
	select
		note = "Note: @trade_sub_type determines if a trade is client or market"
	return
end

/*
 *   If sales_code = DONT TALLY, just return.
 */

if @sales_code_id = @do_not_tally_salescode_id
begin
	select
		id = 1,
		msg = "Trader salescode forces pass. Trade not tallied",
		trader = @trader,
		identifier = @trade_identifier
	return
end

select
	@external_account_type = a.name
from
	external_account_types a,
	external_accounts b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.external_account_id = @external_account_id


if @counterparty_id in (select counterparty_id from fund_agency_counterparties)
begin
	select
		@trade_identifier = rtrim(@execution_id) + ".C"
end
else /* @external_account_type = "Counterparty" */
begin
    select
		@trade_identifier = rtrim(@execution_id) + ".M"
end

if @trade_identifier = NULL
begin
	select
		status = "Error",
		trade_identifier = "NULL",
		message = "Account type is not Client or Counterparty"
	return
end

select
	@trade_id = trade_id
from
	trades
where
	identifier = @trade_identifier
if @trade_id !=NULL
begin
	select
		status = "Dupe",
		message = "Trade is already tallied",
		trade_identifier = @trade_identifier
	return
end

/* 
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @ccy1 != NULL and @ccy2 != NULL and @symbol = @ccy2 + @ccy1
begin
    select
        @symbol = @ccy1 + @ccy2
	/* CDO: There's no need to invert since fxa_tallytrade does it already */
        /* @price = 1 / @price */
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1,
                	@ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

/* EQUITY VALUE DATES LOGIC ***DISABLED***. Can be reenabled by uncommenting.
/* --------------------------------------------------------------------,
| Check to see if trader is in equity_val_date_traders           
|	if yes --> check to see if contract is in equity_value_dates 
|			if yes --> override value_date						 
|			if no --> send message	
|	if no --> Use value date FD provides 
|							
'---------------------------------------------------------------------*/

if exists (select * from equity_value_date_traders where trader_id = @trader_id)
begin
	if exists (select * from equity_value_dates where contract_id = @contract_id)
	begin
			select
					@value_date = value_date
			from
					equity_value_dates
			where
					contract_id = @contract_id
			select
					id = 1,
					msg = "Updating value date for trader ",
					val_date = @value_date,
					fd_trader = @contra_firm,
					trader_id = @trader_id
	end
	else
	begin
		select
				id = "ERROR",
				msg = "No default value date set for contract for valdate trader"
	end
end	
*/

select
    	@broker_symbol = upper(@source)

select
	@broker = symbol
from
	brokers
where
	upper(symbol) = @broker_symbol
if @@rowcount != 1
begin
	select
		@broker = NULL		
end


if lower(rtrim(@side)) = "sell"
begin
	select
		@qty1 = abs(@qty1) * -1.0
end
else
begin
	select
		@qty1 = abs(@qty1)
end

/*
 * FIND @deal_exec_symbol: We will handling IOC Street Fills and IOC Client 
 * Netted Trades differently than Regular Trades. Here's how it works:
 *
 * Type               @execution_id             @order_id
 *                    @client_order_id          -> @trade_symbol
 * ---------------------------------------------------------------------------
 * 
 * Regular Trade #1   9IQ41WFn4BGASKCPSshD9gA   gjkK1WFn4BGoraCPSshD9gA
 *                    A27d3c71cbaf87e           -> "9IQ41WFn4BGASKCPSshD9gA"
 * 
 * Regular Trade #2   9IQ41WFn4BGASKCPSshD9gA   gjkK1WFn4BGoraCPSshD9gA
 *                    240602-1                  -> "9IQ41WFn4BGASKCPSshD9gA"
 * 
 * IOC Street Fills   MUX5:LM004-4536-1         MUX5:LM004-4536-1
 *                    4536-1                    -> "4536"
 *     Determined by seeing if the @client_order_id is a suffix of @execution_id
 *     and if the @client_order_id fits the pattern of "\d+-\d+".
 * 
 * IOC Client Trades  4536                      4536
 *                    1302109416315:2           -> "4536"
 *     Determined by seeing if @execution_id is the same as @client_order_id and
 *     if the @client_order_id is numeric.
 */

select
	@deal_exec_symbol = @execution_id

select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	/* source_id = @source_id */ /* not supported */
	symbol = @deal_exec_symbol

/* IOC: If this is a market trade that looks like it could be an IOC
 * trade or a client trade that could be backed by IOC 
 * trades, @deal_alias is populated. */
if @deal_id = NULL and @deal_alias != NULL
begin

    select
        msg = "M2: Checking deal_aliases",
        source_id = @source_id,
        deal_alias = @deal_alias
    
    select
        @deal_id = deal_id
    from
        deal_aliases
    where
        source_id = @source_id
    and
        alias = @deal_alias
end

if @deal_id = NULL
begin
	select
		msg = "Creating new deal"

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    )
    
    /* If we also have a @deal_alias, this is either an IOC (warehoused) street
     * trade or the corresponding client trade. Record the @deal_alias to match
     * other IOC street trades and client trades */
    if @deal_alias != NULL
    begin
    
        select
            msg = "M3: Inserting deal_aliases",
            deal_id = @deal_id,
            source_id = @source_id,
            deal_alias = @deal_alias
        
        insert into
            deal_aliases
        values(
            @deal_id,
            @source_id,
            @deal_alias
        )
    end

end
else
begin
	select
		msg = "Appending to existing deal"
end
		
    
exec
	fxa_tallytrade
		@login = @user,
		@source = @source,
		@trade_id = @trade_id out,
		@deal_id = @deal_id out,
		@tally_type = @trade_type,
		@deal_type = @deal_type,
		@trade_type = @trade_type,
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @qty1,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@trader = @trader,
		@broker = @broker,
		@identifier = @trade_identifier,
		@spot_reference = @trd_spot_ref

if @trade_id = NULL
	begin
		select
			status = "Error",
			message = "Failed to tally market trade"
		return
	end

	exec
		r_inserttradenotification
					@trade_id
        
	insert into
		trade_quoted_prices (	trade_id,
					price)
		values(
			@trade_id,
			@quoted_price
			)

select
	status = "Tallied",
	message = "Trade successfully tallied",
    	trade_id = @trade_id,
    	deal_id = @deal_id,
	account = @contra_firm,
	symbol = @symbol,
	side = @side,
	quantity = @qty1,
	price = @price,
	val_date = @value_date


go
