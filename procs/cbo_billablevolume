use
	risk_faros
go

drop procedure
	cbo_billablevolume
go

create procedure
	cbo_billablevolume
		@login varchar(50),
		@date datetime=NULL,
		@first_commit_date datetime output,
		@last_commit_date datetime output,
		@total_billable float output
as


declare @begin_date datetime
declare @end_date datetime
declare @month varchar(2)
declare @year varchar(4)
declare @first_of_month datetime
declare @first_of_next_month datetime


if @date = NULL
	select
		@date = getdate()


select
	@month = convert(varchar(2), datepart(month, @date)),
	@year = convert(varchar(4), datepart(year, @date))


select
	@first_of_month = convert(datetime, @month + "/1/" + @year)



select
	@first_of_next_month = dateadd(month, 1, @first_of_month)


select
	@first_commit_date = min(reval_date)
from
	committed_daily_revals
where
	reval_date >= @first_of_month

select
	@last_commit_date = max(reval_date)
from
	committed_daily_revals
where
	reval_date < @first_of_next_month

create table
	#trades(
		trade_id int,
		trade_type_id int,
		trade_date datetime,
		volume float,
		reval_date datetime,
		rate float NULL,
		volume_fee float NULL)

insert into
	#trades(
		trade_id,
		trade_type_id,
		trade_date,
		volume,
		reval_date)
select
	a.trade_id,
	b.trade_type_id,
	a.bo_trade_date,
	a.evaluation_notional,
	a.reval_date
from
	committed_daily_revals a,
	trades b,
	external_accounts c,
	external_account_types d
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	c.external_account_type_id = d.external_account_type_id
and
	d.name != "Internal"
and
	a.bo_trade_date >= @first_of_month
and
	a.bo_trade_date < @first_of_next_month
and
	convert(varchar(11), a.bo_trade_date, 1) = convert(varchar(11), a.reval_date, 1)

update
	#trades
set
	a.rate = 0.50
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id
and
	b.name in("Swap Near", "Swap Far")

update
	#trades
set
	a.rate = 1.0
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id
and
	b.name in("Forward", "Spot")

update
	#trades
set
	volume_fee = (volume / 1000000.00) * rate

create table
	#output(
		trade_type varchar(50),
		rate float,
		volume_fee float)
insert into
	#output
select
	b.name,
	min(a.rate),
	sum(a.volume_fee)
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id
group by
	b.name
order by
	b.name
	
select
	first_commit_date = @first_commit_date,
	last_commit_date = @last_commit_date

select * from #output

select @total_billable = sum(volume_fee) from #output

go
