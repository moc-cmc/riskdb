as

declare @status varchar(50)
declare @db_name varchar(30)
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)


select
	@status = b.name
from
	funds a,
	statuses b
where
	a.status_id = b.status_id
if @status = "Active"
begin
	select
		status = "Error",
		message = "Cannot clear Active fund"
	return
end

