from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

if @date = NULL
begin
	select
		@date = getdate()
end

select
	@date = convert(datetime, convert(date, @date))

if datename(weekday, @date) = "Saturday"
	select
		@date = dateadd(day, 2, @date)

if datename(weekday, @date) = "Sunday"
	select
		@date = dateadd(day, 1, @date)

select
	@ledger_begin = @date,
	@ledger_end = dateadd(day, 1, @date)

if datename(weekday, @ledger_begin) = "Monday"
	select
		@ledger_begin = dateadd(day, -2, @ledger_begin)
exec
	r_prevbusinessday
		@ledger_begin,
		@ledger_price_begin output
select
	@ledger_price_begin = convert(datetime, convert(date, @ledger_price_begin)),
	@ledger_price_end = @ledger_begin

exec
	r_daterangefordate
		@date,
		@trades_begin output,
		@trades_end output


