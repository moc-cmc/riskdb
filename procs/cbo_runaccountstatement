	#fwd_options
set
	a.previous_settle = b.close_price,
	a.previous_value = b.native_value,
	a.previous_equiv = b.evaluation_value
from
	#fwd_options a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	convert(date, b.reval_date) = convert(date, @trades_begin)
	
update
	#fwd_options
set
	today_pl = today_value - previous_value,
	today_pl_equiv = today_equiv - previous_equiv
where
	previous_equiv != NULL

