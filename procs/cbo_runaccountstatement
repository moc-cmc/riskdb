create table
	#prem_ladder(
		id int identity,
		style varchar(250) NULL,
		currency_id int NULL,
		trade_id varchar(50)  NULL,
		trade_date datetime NULL,
		symbol varchar(50) NULL,
		premium_settledate varchar(50) NULL,
		premium float NULL,
		premium_ccy varchar(50) NULL,
		current_value float NULL,
		currency varchar(50) NULL,
		equiv float NULL)
insert into
	#prem_ladder(
		style,
		currency_id,
		trade_id,
		trade_date,
		symbol,
		premium_settledate,
		premium,
		premium_ccy,
		current_value,
		currency)
select
	style = @style,
	a.currency_id,
	convert(varchar(50), a.trade_id),
	convert(varchar(11), a.trade_date, 1),
	c.symbol,
	a.premium_value_date,
	a.premium,
	premium_currency = b.symbol,
	current_value = a.today_value * -1.0,
	currency = d.symbol
from
	#fwd_options a,
	products b,
	contracts c,
	products d
where
	a.premium_currency_id = b.product_id
and
	a.contract_id = c.contract_id
and
	a.currency_id = d.product_id
order by
	a.premium_value_date
update
	#prem_ladder
set
	a.equiv = current_value * b.end_rate
from
	#prem_ladder a,
	#conversion_rates b
where
	a.currency_id = b.product_id

select
	@total_equiv_prem = sum(equiv)
from
	#prem_ladder

insert into
	#prem_ladder(
		style,
		equiv)
values(
	@total_style,
	@total_equiv_prem)




