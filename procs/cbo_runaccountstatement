create table
	#conversion_rates(
		product_id int,
		begin_rate float NULL,
		end_rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	a.product_id
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"

update
	#conversion_rates
set
	begin_rate = 1.0,
	end_rate = 1.0
where
	product_id = @currency_id

/* get the begin rates */

update
	#conversion_rates
set
	a.begin_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	b.currency_id = @currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @trades_begin)

update
	#conversion_rates
set
	a.begin_rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	b.product_id = @currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @trades_begin)
and
	a.begin_rate = NULL

/* get the end rates */
update
	#conversion_rates
set
	a.end_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	b.currency_id = @currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @trades_end)

update
	#conversion_rates
set
	a.end_rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.currency_id
and
	b.product_id = @currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @trades_end)
and
	a.end_rate = NULL


select
	@currency = symbol
from
	products
where
	product_id = @currency_id

create table
	#ledger_positions(
		product_id int,
		currency_id int NULL,
		quantity float,
		begin_equiv float NULL,
		end_equiv float NULL,
		ccy_pl float NULL)
insert into
	#ledger_positions(
		product_id,
		quantity)
select
	currency_id,
	sum(amount)
from
	account_transactions
where
	external_account_id = @external_account_id
and
	transaction_date < @ledger_begin
group by
	currency_id

update
	#ledger_positions
set
	currency_id = @currency_id

update
	#ledger_positions
set
	a.begin_equiv = a.quantity * b.begin_rate
from
	#ledger_positions a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#ledger_positions
set
	a.end_equiv = a.quantity * b.end_rate
from
	#ledger_positions a,
	#conversion_rates b
where
	a.product_id = b.product_id


update
	#ledger_positions
set
	ccy_pl = end_equiv - begin_equiv


select
	@fx_settlement_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @fx_settlement_type_id = NULL
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end

create table
	#ledger_transactions(
		account_transaction_id int,
		trade_id int NULL,
		currency_id int NULL,
		transaction_date datetime,
		transaction_type_id int,
		product_id int,
		quantity float,
		end_equiv float NULL)


insert into
	#ledger_transactions(
		account_transaction_id,
		transaction_date,
		transaction_type_id,
		product_id,
		quantity)
select
	account_transaction_id,
	transaction_date,
	transaction_type_id,
	currency_id,
	amount
from
	account_transactions
where
	external_account_id = @external_account_id
and
	transaction_date >= @ledger_begin
and
	transaction_date < @ledger_end
and
	amount != 0.0

update
	#ledger_transactions
set
	a.trade_id = b.trade_id
from
	#ledger_transactions a,
	account_transaction_trades b
where
	a.account_transaction_id = b.account_transaction_id

update
	#ledger_transactions
set
	a.trade_id = c.exit_trade_id
from
	#ledger_transactions a,
	transaction_round_turns b,
	round_turns c
where
	a.account_transaction_id = b.account_transaction_id
and
	b.round_turn_id = c.round_turn_id


update
	#ledger_transactions
set
	a.end_equiv = a.quantity * b.end_rate
from
	#ledger_transactions a,
	#conversion_rates b
where
	a.product_id = b.product_id

create table
	#ledger_bal_output(
		id int identity,
		style varchar(200) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		balance float NULL,
		begin_equiv float NULL,
		end_equiv float NULL,
		ccy_pl float NULL,
		currency varchar(50) NULL)
insert into
	#ledger_bal_output(
		style,
		product_id,
		product,
		balance,
		begin_equiv,
		end_equiv,
		ccy_pl)	
select
	style = @style,
	a.product_id,
	product = b.symbol,
	balance = a.quantity,
	a.begin_equiv,
	a.end_equiv,
	a.ccy_pl
from
	#ledger_positions a,
	products b
where
	a.product_id = b.product_id
order by
	b.symbol


select
	@ledger_pos_begin_total = sum(begin_equiv),
	@ledger_pos_end_total = sum(end_equiv),
	@total_pos_ledger = sum(ccy_pl)
from
	#ledger_bal_output
if @ledger_pos_begin_total = NULL
	select
		@ledger_pos_begin_total = 0.0
if @ledger_pos_end_total = NULL
	select
		@ledger_pos_end_total = 0.0
if @total_pos_ledger = NULL
	select
		@total_pos_ledger = 0.0


insert into
	#ledger_bal_output(
		style,
		product,
		begin_equiv,
		end_equiv,
		ccy_pl,
		currency)
values(
	@total_style,
	"Total",
	@ledger_pos_begin_total,
	@ledger_pos_end_total,
	@total_pos_ledger,
	@currency)


create table
	#positions(
		product_id int,
		value_date datetime,
		quantity numeric(30,4))
insert into
	#positions
select
	b.product_id,
	a.value_date,
	sum(a.quantity)
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.external_account_id = @external_account_id
/* and
	convert(date, a.value_date) = convert(date, @date) */
and
	a.trade_date < @trades_end
group by
	a.value_date,
	b.product_id

insert into
	#positions
select
	b.currency_id,
	a.value_date,
	sum(a.quantity * a.price * -1.0)
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.external_account_id = @external_account_id
and
	/* convert(date, a.value_date) = convert(date, @date)
and */
	a.trade_date < @trades_end
group by
	a.value_date,
	b.currency_id

create table
	#maturing_products(
		product_id int,
		quantity numeric(30,4))
insert into
	#maturing_products
select
	product_id,
	sum(quantity)
from
	#positions
where
	convert(date, value_date) = convert(date, @trades_end)
group by
	product_id


select
	@total_ledger_trans = sum(end_equiv)
from
	#ledger_transactions
if @total_ledger_trans = NULL
	select
		@total_ledger_trans = 0.0

create table
	#ledger_transactions_out(
		id int identity,
		style varchar(250) NULL,
		transaction_id varchar(50) NULL,
		trade_id int NULL,
		product_id int NULL,
		product varchar(50) NULL,
		transaction_date datetime NULL,
		transaction_type varchar(50) NULL,
		quantity numeric(30,4) NULL,
		equiv float NULL,
		currency varchar(50) NULL)
insert into
	#ledger_transactions_out(
		style,
		transaction_id,
		trade_id,
		product_id,
		product,
		transaction_date,
		transaction_type,
		quantity,
		equiv)
select
	style = @style,
	transaction_id = convert(varchar(50), a.account_transaction_id),
	a.trade_id,
	a.product_id,
	product = b.symbol,
	a.transaction_date,
	transaction_type = c.name,
	a.quantity,
	a.end_equiv
from
	#ledger_transactions a,
	products b,
	transaction_types c
where
	a.product_id = b.product_id
and
	a.transaction_type_id = c.transaction_type_id
order by
	b.symbol,
	a.transaction_date

insert into
	#ledger_transactions_out(
		style,
		transaction_id,
		equiv,
		currency)
values(
	@total_style,
	"Total",
	@total_ledger_trans,
	@currency)	

create table
	#closed_futs_out(
		id int identity,
		style varchar(250) NULL,
		entry_trade_id varchar(50) NULL,
		entry_date datetime NULL,
		entry_quantity numeric(30,4) NULL,
		contract_id int NULL,
		contract varchar(200) NULL,
		symbol varchar(50) NULL,
		entry_price float NULL,
		exit_trade_id int NULL,
		exit_date datetime NULL,
		exit_quantity numeric(30,4) NULL,
		exit_price float NULL,
		contract_size int NULL,
		p_l float NULL,
		ccy varchar(50) NULL,
		native_currency_id int NULL,
		equiv float NULL,
		currency varchar(50) NULL)
		
insert into
	#closed_futs_out(
		style,
		entry_trade_id,
		entry_date,
		entry_quantity,
		contract_id,
		symbol,
		entry_price,
		exit_trade_id,
		exit_date,
		exit_quantity,
		exit_price,
		contract_size,
		p_l,
		ccy,
		native_currency_id)
select
	style = @style,
	convert(varchar(50), a.entry_trade_id),
	a.entry_date,
	a.entry_quantity,
	a.contract_id,
	b.symbol,
	a.entry_price,
	a.exit_trade_id,
	a.exit_date,
	a.exit_quantity,
	a.exit_price,
	contract_size = a.multiplier,
	a.p_l,
	currency = c.symbol,
	a.currency_id
from
	round_turns a,
	contracts b,
	products c
where
	a.contract_id = b.contract_id
and
	a.currency_id = c.product_id
and
	convert(date, a.exit_date) = convert(date, @date)
and
	a.external_account_id = @external_account_id
order by
	b.symbol,
	a.entry_date

update
	#closed_futs_out
set
	a.contract = c.name
from
	#closed_futs_out a,
	future_contracts b,
	futures c
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id

update
	#closed_futs_out
set
	a.equiv = a.p_l * b.end_rate
from
	#closed_futs_out a,
	#conversion_rates b
where
	a.native_currency_id = b.product_id

select
	@realized_pl = sum(equiv)
from
	#closed_futs_out
if @realized_pl = NULL
	select
		@realized_pl = 0.0

insert into
	#closed_futs_out(
		style,
		entry_trade_id,
		equiv,
		currency)
values(
	@total_style,
	"Total",
	@realized_pl,
	@currency)


create table
	#open_futs_out(
		id int identity,
		style varchar(250) NULL,
		trade_id varchar(50) NULL,
		trade_date datetime NULL,
		traded_quantity numeric(30,4) NULL,
		remaining numeric(30,4) NULL,
		contract_id int NULL,
		currency_id int NULL,
		ccy varchar(50) NULL,
		symbol varchar(50) NULL,
		contract varchar(100) NULL,
		contract_size int NULL,
		trade_price float NULL,
		today_settle float NULL,
		unrealized_pl float NULL,
		equiv float NULL,
		currency varchar(50) NULL)
insert into
	#open_futs_out(
		style,
		trade_id,
		trade_date,
		traded_quantity,
		remaining,
		contract_id,
		currency_id,
		symbol,
		contract,
		contract_size,
		trade_price,
		today_settle,
		unrealized_pl)

select
	style = @style,
	convert(varchar(50), a.trade_id),
	b.trade_date,
	trade_quantity = b.quantity,
	a.remaining,
	b.contract_id,
	f.currency_id,	
	c.symbol,
	e.name,
	e.quantity,
	trade_price = b.price,
	today_settle = a.settle,
	a.unrealized_pl
from
	open_futures a,
	trades b,
	contracts c,
	future_contracts d,
	futures e,
	forwards f
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	b.contract_id = d.contract_id
and
	c.contract_id = d.contract_id
and
	d.future_id = e.future_id
and
	e.forward_id = f.contract_id
and
	convert(date, a.settle_date) = convert(date, @date)

update
	#open_futs_out
set
	a.ccy = b.symbol
from
	#open_futs_out a,
	products b
where
	a.currency_id = b.product_id

update
	#open_futs_out
set
	a.equiv = a.unrealized_pl * b.end_rate
from
	#open_futs_out a,
	#conversion_rates b
where
	a.currency_id = b.product_id

select
	@unrealized_pl = sum(equiv)
from
	#open_futs_out

insert into
	#open_futs_out(
		style,
		trade_id,
		equiv,
		currency)
values(
	@total_style,
	"Total",
	@unrealized_pl,
	@currency)

	
create table
	#fwds(
		trade_id int,
		deal_id int,
		bo_trade_date datetime NULL,
		trade_date datetime,
		value_date datetime,
		contract_id int,
		product_id int,
		dealt_amount float,
		currency_id int,
		counter_amount float,
		trade_price float,
		previous_settle float NULL,
		previous_counter_amt float NULL,
		current_price float NULL,
		current_counter_amt float NULL,
		days_pl float NULL,
		days_equiv float NULL,
		lifetime_pl float NULL)

insert into
	#fwds(
		trade_id,
		deal_id,
		trade_date,
		value_date,
		contract_id,
		product_id,
		dealt_amount,
		currency_id,
		counter_amount,
		trade_price)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	a.value_date,
	a.contract_id,
	b.product_id,
	a.quantity,
	b.currency_id,
	a.quantity * a.price * -1.0,
	a.price
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.external_account_id = @external_account_id
and
	a.trade_date < @trades_end
and
	convert(date, a.value_date) > convert(date, @trades_end)
and
	a.quantity != 0.0

update
	#fwds
set
	bo_trade_date = convert(datetime, convert(date, trade_date))
where
	datepart(hour, trade_date) < 17

update
	#fwds
set
	bo_trade_date = dateadd(day, 1, convert(datetime, convert(date, trade_date)))
where
	datepart(hour, trade_date) >= 17



update
	#fwds
set
	a.previous_settle = b.price
from
	#fwds a,
	bo_prices b
where
	a.contract_id = b.contract_id
and
	convert(date, a.value_date) = convert(date, b.value_date)
and
	convert(date, b.price_date) = convert(date, @trades_begin)

update
	#fwds
set
	a.current_price = b.price
from
	#fwds a,
	bo_prices b
where
	a.contract_id = b.contract_id
and
	convert(date, a.value_date) = convert(date, b.value_date)
and
	convert(date, b.price_date) = convert(date, @trades_end)

update
	#fwds
set
	previous_counter_amt = (dealt_amount * previous_settle * -1.0),
	current_counter_amt = (dealt_amount * current_price * -1.0)

update
	#fwds
set
	/*lifetime_pl = current_counter_amt - counter_amount*/
	lifetime_pl = counter_amount - current_counter_amt

update
	#fwds
set
	days_pl = lifetime_pl 
where
	trade_date >= @trades_begin
and
	trade_date < @trades_end

update
	#fwds
set
	/* days_pl = current_counter_amt - previous_counter_amt */
	days_pl = previous_counter_amt - current_counter_amt
where
	trade_date < @trades_begin

update
	#fwds
set
	a.days_equiv = a.days_pl * b.end_rate
from
	#fwds a,
	#conversion_rates b
where
	a.currency_id = b.product_id


create table
	#open_fwds_output(
		id int identity,
		style varchar(250) NULL,
		trade_id varchar(50) NULL,
		deal_id int NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		trade_date datetime NULL,
		value_date datetime NULL,
		dealt varchar(50) NULL,
		dealt_amount float NULL,
		counter varchar(50) NULL,
		counter_amount float NULL,
		trade_price float NULL,
		yest_mark float NULL,
		today_mark float NULL,
		today_pl float NULL,
		today_equiv float NULL,
		life_pl float NULL,
		currency varchar(50) NULL)
insert into
	#open_fwds_output(
		style,
		trade_id,
		deal_id,
		contract_id,
		symbol,
		trade_date,
		value_date,
		dealt,
		dealt_amount,
		counter,
		counter_amount,
		trade_price,
		yest_mark,
		today_mark,
		today_pl,
		today_equiv,
		life_pl)
select
	style = @style,
	convert(varchar(30), a.trade_id),
	a.deal_id,
	a.contract_id,
	d.symbol,
	a.trade_date,
	a.value_date,
	b.symbol,
	a.dealt_amount,
	c.symbol,
	a.counter_amount,
	a.trade_price,
	a.previous_settle,
	a.current_price,
	a.days_pl,
	a.days_equiv,
	a.lifetime_pl
from
	#fwds a,
	products b,
	products c,
	contracts d
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id
and
	a.contract_id = d.contract_id
and
	a.trade_date < @trades_begin
order by
	d.symbol,
	a.trade_date,
	a.value_date
	
select
	@total_fwd_pos_pl = sum(today_equiv)
from
	#open_fwds_output
if @total_fwd_pos_pl = NULL
	select
		@total_fwd_pos_pl = 0.0

insert into
	#open_fwds_output(
		style,
		trade_id,
		today_equiv,
		currency)
values(
	@total_style,
	"Total",
	@total_fwd_pos_pl,
	@currency)
		

