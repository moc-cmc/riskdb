/* Select the output */

/* Conversion Rates */
select
	section = "Conversion Rates Missing",
	a.style,
	a.message,
	b.symbol,
	a.price_date
from
	#errors a,
	products b
where
	a.product_id = b.product_id

/* FUTURES STUFF
select
	section = "Futures Prices Missing",
	a.style,
	a.message,
	c.symbol,
	d.name,
	price_date = convert(varchar(11), a.price_date, 1),
	edit_fut_price = "ADD"
from
	#errors a,
	future_contracts b,
	contracts c,
	futures d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	a.contract_id = c.contract_id
and
	b.future_id = d.future_id
END FUTURES STUFF */

select
	section = "Forward Marks Missing",
	a.style,
	a.message,
	c.symbol,
	value_date = convert(varchar(11), a.value_date, 1),
	price_date = convert(varchar(11), a.price_date, 1),
	edit_fwd_price = "ADD"
from
	#errors a,
	forwards b,
	contracts c
where
	a.contract_id = b.contract_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id	
	
select
	section = "Option Marks Missing",
	a.style,
	a.message,
	c.symbol,
	a.price_date
from
	#errors a,
	option_contracts b,
	contracts c
where
	a.contract_id = b.contract_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id
	
select
	section = @summary,
	style,
	category,
	starting_position = position,
	new_activity = activity,
	total_pl = total
from
	#summary
order by
	id

select
	section = "Starting Balances",
	style,
	product,
	balance,
	begin_equiv,
	end_equiv,
	ccy_pl,
	currency
from
	#ledger_bal_output
order by
	id

select
	section = "Today's Ledger Activity",
	style,
	transaction_id,
	trade_id,
	product,
	transaction_date,
	transaction_type,
	quantity,
	equiv,
	currency
from
	#ledger_transactions_out
order by
	id

select
	section = "Closed Futures",
	style,
	entry_trade_id,
	entry_date,
	entry_quantity,
	contract,
	symbol,
	entry_price,
	exit_trade_id,
	exit_date,
	exit_quantity,
	exit_price,
	contract_size,
	realized_pl = p_l,
	ccy,
	equiv,
	currency
from
	#closed_futs_out
order by
	id
	

select
	section = "Open Futures",
	style,
	trade_id,
	symbol,
	contract,
	contract_size,
	traded_quantity,
	remaining,
	trade_price,
	today_settle,
	unrealized_pl,
	ccy,
	equiv,
	currency
from
	#open_futs_out
order by
	id
	


/* Flip the price for display for non stand fx pairs */
update
	#today_fwds_output
set
	a.trade_price = 1.0 / a.trade_price,
	a.today_mark = 1.0 / a.today_mark
from
	#today_fwds_output a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
select
	section = "Today's Forwards",
	style,
	trade_id,
	deal_id,
	trade_date,
	value_date = convert(varchar(11), value_date,1),
	dealt,
	dealt_amt = dealt_amount,
	counter,
	counter_amt = counter_amount,
	trade_price,
	today_mark,
	life_pl,
	today_pl,
	today_equiv,
	currency
from
	#today_fwds_output
order by
	id 


/* Flip the price for display for non stand fx pairs */
update
	#open_fwds_output
set
	a.trade_price = 1.0 / a.trade_price,
	a.yest_mark = 1.0 / a.yest_mark,
	a.today_mark = 1.0 / a.today_mark
from
	#open_fwds_output a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"

select
	section = "Open Forwards",
	style,
	trade_id,
	deal_id,
	trade_date,
	value_date = convert(varchar(11), value_date,1),
	dealt,
	dealt_amt = dealt_amount,
	counter,
	counter_amt = counter_amount,
	trade_price,
	yest_mark,
	today_mark,
	life_pl,
	today_pl,
	today_equiv,
	currency
from
	#open_fwds_output
order by
	id

select
	section = "Today's Forward Options Trades",
	style,
	trade_id,
	deal_id,
	trade_date,
	quantity,
	symbol,
	premium,
	ccy = premium_ccy,
	prem_val_date = convert(varchar(11), premium_val_date, 1),
	today_mark,
	today_pl,
	today_equiv = today_pl_equiv,
	currency
from
	#fwd_opt_trades_output
order by
	id
select
	section = "Open Forward Options",
	style,
	trade_id,
	deal_id,
	trade_date,
	quantity,
	symbol,
	premium,
	ccy,
	prem_val_date = convert(varchar(11), prem_val_date, 1),
	yest_mark,
	today_mark,
	life_pl,
	today_pl,
	today_equiv = today_pl_equiv,
	currency
from
	#fwd_opt_pos_output
order by
	id


select
	section = "Premium Summary",
	style,
	trade_id,
	trade_date,
	symbol,
	premium_settledate,
	premium,
	premium_ccy,
	current_value,
	currency,
	equiv
from
	#prem_ladder
order by
	id





