
if object_id("mc_checkcounterpartydsl") != NULL
    drop procedure
        mc_checkcounterpartydsl
go

create procedure
    mc_checkcounterpartydsl
        @login varchar(25),
        @fund varchar(50)
as

/* 
 * Calculate all counterparty credit utilizations (#utilizations) and their
 * statuses (dsl_status). Manage issues which are still active and delete the
 * ones that are "ok".
 */

/* MARK: VARIABLES */
declare @fund_id int
declare @item_relation_id int
declare @counterparty_id int
declare @counterparty varchar(50)
declare @currency varchar(5)
declare @dsl_type varchar(25)
declare @dsl_limit numeric(30,4)
declare @dsl float
declare @dsl_utilization float
declare @dsl_status varchar(25)
declare @dsl_level float
declare @issue_id int
declare @issue_properties varchar(250)
declare @issue_dsl_status varchar(25)
declare @subject varchar(250)
declare @content varchar(250)
declare @properties varchar(250)
declare @priority varchar(15)
declare @timer varchar(100)
declare @timer_sql varchar(250)

/* MARK: FIND @fund_id from funds for @fund */
select
    @fund_id
from
    funds 
where
    name = @fund

if @@rowcount != 1
begin
    select
        status = "Error",
        message = "Fund, '" + @fund + "', not found",
        fund = @fund
    return
end

/* MARK: - CREATE #messages: to calculate levels */
create table
    #messages (
        id int identity,
        subject varchar(20),
        message varchar(80)
    )

/* MARK: - CREATE #utilizations: to calculate levels */
create table
    #utilizations (
        counterparty_id int,
        counterparty varchar(50),
        currency varchar(5),
        dsl_type varchar(25) NULL,
        dsl_limit numeric(30,4) NULL,
        dsl float NULL,
        dsl_utilization float NULL,
        dsl_status varchar(25) NULL,
        dsl_level float NULL
    )

/* MARK: INSERT #utilizations: from current_counterparty_utils */
insert into
    #utilizations (
        counterparty_id,
        counterparty,
        currency,
        dsl_type,
        dsl_limit,
        dsl,
        dsl_utilization
    )
select
    a.counterparty_id,
    counterparty = a.name,
    currency = ba.symbol,
    dsl_type = bc.name,
    b.dsl_limit,
    c.dsl,
    dsl_utilization = case 
        when b.dsl_limit != NULL and b.dsl_limit > 0 then
            c.dsl / b.dsl_limit
        else
            NULL
    end
from
    counterparties a,
    counterparty_limits b,
        products ba,
        dsl_types bc,
    current_counterparty_utils c
where
    a.counterparty_id = b.counterparty_id
        and
            b.currency_id = ba.product_id
        and
            b.dsl_type_id = bc.dsl_type_id
and
    a.counterparty_id = c.counterparty_id

/* MARK: UPDATE #utilizations: set dsl_status */
update
    #utilizations
set
    dsl_status = case 
        when a.dsl_utilization = NULL then
            "ok"
        when a.dsl_utilization > b.blocked_level then
            "blocked"
        when a.dsl_utilization > b.warning_level then
            "warning"
        when a.dsl_utilization > b.notice_level then
            "notice"
        else
            "ok"
    end,
    dsl_level = case 
        when a.dsl_utilization = NULL then
            NULL
        when a.dsl_utilization > b.blocked_level then
            b.blocked_level
        when a.dsl_utilization > b.warning_level then
            b.warning_level
        when a.dsl_utilization > b.notice_level then
            b.notice_level
        else
            NULL
    end
from
    #utilizations a,
    counterparty_limits b
where
    a.counterparty_id = b.counterparty_id

/*
 * MARK: - CREATE #issues: for all active Credit Exceeded issues
 * 
 * Find all of the issues that 
 */
 
create table
    #issues (
        issue_id int,
        counterparty_id int,
        properties varchar(250) NULL
    )

/* MARK: INSERT #issues: all active Credit Exceeded issues */
insert into
    #issues (
        issue_id,
        counterparty_id,
        properties
    )
select
    a.issue_id,
    counterparty_id = a.item_id,
    a.properties
from
    issues a,
    statuses b,
    channels c
where
    a.status_id = b.status_id
and
    b.name != "Resolved"
and
    a.channel_id = c.channel_id
and
    c.name = "Counterparty DSL Credit Exceeded"
and
    a.item_relation_id = object_id("counterparties")
    

/* MARK: - LOOP exceeded: for all #utilizations and create/update issues */
declare
    exceeded 
cursor for select
    counterparty_id,
    counterparty,
    currency,
    dsl_type,
    dsl_limit,
    dsl,
    dsl_utilization,
    dsl_status,
    dsl_level
from
    #utilizations a
order by
    a.counterparty_id
    
open
    exceeded
    
/* MARK: FETCH exceeded */
fetch
    exceeded
into
    @counterparty_id,
    @counterparty,
    @currency,
    @dsl_type,
    @dsl_limit,
    @dsl,
    @dsl_utilization,
    @dsl_status,
    @dsl_level

while @@sqlstatus = 0
begin

    /* MARK: . FIND @issue_id from #issues for @counterparty_id */
    select
        @issue_id = NULL,
        @issue_properties = NULL
        
    select
        @issue_id = a.issue_id,
        @issue_properties = a.properties
    from
        #issues a
    where
        a.counterparty_id = @counterparty_id
    
    /* MARK: . IF @issues_properties is found */
    if @issue_properties != NULL
    begin
    
        /* MARK: . . FIND @issue_dsl_status to obtain previous status */
        select
            @issue_dsl_status = substring(@issue_properties, patindex("%dsl_status:%", @issue_properties) + 11, 25)
        select
            @issue_dsl_status = substring(@issue_dsl_status, 1, patindex("%,%", @issue_dsl_status) - 1)
        
    end
       
    /* MARK: . IF: @dsl_status is not "ok" */
    if @dsl_status != "ok"
    begin
    
        /* MARK: . . SET @channel, @subject, etc.: for r_manageissue params */
        select
            @subject = @fund + ": Counterparty " + @counterparty + " DSL credit utilization has exceeded",
            @content = @counterparty + "'s " + @dsl_type + " DSL credit utilization is " + @currency + " " + convert(varchar(30), convert(money, @dsl)) + " which is " + convert(varchar(30), convert(money, @dsl_utilization * 100)) + "% of the " + @currency + " " + convert(varchar(30), convert(money, @dsl_limit)) + " limit. This exceeds the " + @dsl_status + " level of " + convert(varchar(30), convert(money, @dsl_level * 100)) + "%",
            @properties = '{'
                + 'counterparty:"' + @counterparty+ '",'
                + 'currency:"' + @currency + '",'
                + 'dsl_type:"' + @dsl_type + '",'
                + 'dsl_limit:' + convert(varchar(30),
                    convert(numeric(30,0), @dsl_limit)) + ','
                + 'dsl:' + convert(varchar(30),
                    convert(numeric(30,0), @dsl)) + ','
                + 'dsl_utilization:' + convert(varchar(30),
                    convert(numeric(30,2), @dsl_utilization)) + ','
                + 'dsl_status:' + @dsl_status + ','
                + 'dsl_level:' + convert(varchar(30),
                    convert(numeric(30,2), @dsl_level)) + ','
            + '}'
        
        insert into
            #messages
        select
            name = case 
                when @issue_id = NULL then
                    "Added Issue"
                else
                    "Updated Issue"
            end,
            message = @counterparty + " DSL exceeds "
        
        select
            @item_relation_id = object_id("counterparties"),
            @priority = case @dsl_status
                when "blocked" then
                    "High"
                when "warning" then
                    "Medium"
                when "notice" then
                    "Normal"
                else
                    "Low"
            end

        /* MARK: . . EXEC r_manageissue: create or update issue */
        exec
            r_manageissue
                @login = @login,
                @issue_id = @issue_id out,
                @channel = "Counterparty DSL Credit Exceeded",
                @item_relation_id = @item_relation_id,
                @item_id = @counterparty_id,
                @subject = @subject,
                @content = @content,
                @properties = @properties,
                @priority = @priority,
                @status = "New",
                @check_interval = 60
        
    end
    /* MARK: . ELSE IF: @dsl_status is "ok" */
    else if @issue_id != NULL
    begin
        
        /* MARK: . . EXEC r_manageissue: create or update issue */
        exec
            r_manageissue
                @login = @login,
                @issue_id = @issue_id,
                @status = "Resolved"
                
    end
    
    /* MARK: . DELETE #issues: for @issue_id to mark this issue as done */
    delete
        #issues
    where
        issue_id = @issue_id
    
    /* MARK: . FETCH exceeded */
    fetch
        exceeded
    into
        @counterparty_id,
        @counterparty,
        @currency,
        @dsl_type,
        @dsl_limit,
        @dsl,
        @dsl_utilization,
        @dsl_status,
        @dsl_level
    
end

/* MARK: - INSERT #messages: for any remaining #issues */
insert into
    #messages
select
    subject = "Remaining Issues",
    message = "Issue " + convert(varchar(30), a.issue_id) + " is either not associated with an counterparty or has not utilization"
from
    #issues a

/* MARK: - SHOW #messages */
select
    subject,
    message
from
    #messages
order by
    id

/* MARK: - EXEC r_managetimer: for any remaining #issues */
select
    @timer = "mc_checkcounterpartydsl:login=" + @login + ",fund=" + @fund,
    @timer_sql = "exec mc_checkcounterpartydsl @login=""" + @login + """, @fund=""" + @fund + """"
exec
    r_managetimer
        @name = @timer,
        @iterations = -1, /* indefinite */
        @interval = 30,  /* minimum 30 seconds */
        @sql = @timer_sql
    
go
