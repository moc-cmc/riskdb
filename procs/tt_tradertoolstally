
if object_id("tt_tradertoolstally") != NULL
    drop procedure
        tt_tradertoolstally
go

create procedure
	tt_tradertoolstally
        @agent varchar(50),
        @source varchar(50),
        @default_login varchar(50), 
        @customer_desk varchar(50),
        @customer_name varchar(50),
            /* trades.trader_id */
        @customer_account varchar(50),
        @customer_short_name varchar(50),
        @account_type varchar(50),
            /* Customer, Nostro */
        @action varchar(50),
            /* BUY, SELL */
        @ccy1 varchar(50),
        @ccy2 varchar(50),
        @amount_ccy varchar(50),
            /* Traded currency */
        
        @order_type varchar(50),
            /* Spot, Outright, NDF, EFP, Swap */
        @order_amount varchar(50)=NULL,
	@order_status varchar(50)=NULL,
        @total_amt_filled varchar(50)=NULL,
        @total_counter_filled varchar(50)=NULL,
        @total_unacct_amt varchar(50)=NULL,
        @total_canceled_amt varchar(50)=NULL,
        @depth_id varchar(50)=NULL,
        @mkt_rate_on_submit varchar(50)=NULL,
        @start_validity varchar(50)=NULL,
        @settlement_date datetime,
	@validity_type varchar(50),
        @order_id varchar(50),
            /* deals.identifier */
	@related_order_id varchar(50),
	    /* deals.identifier on client tickets*/
        @order_added_by varchar(50),
            /* User */
        @market_rate float,
        @customer_rate float,
            /* @account_type="Nostro" ? 0 : target customer rate */
        
        @exec_id varchar(50),
            /* trades.identifier */
        @fill_quantity float,
        @fill_counterquantity float,
        @fill_date datetime,
        @fill_price float,
        @fill_markup float,
        @trader_price float,
        @trade_day datetime,
        @counterparty_exec_id varchar(50),
        @executing_broker varchar(50),
        @external_counterparty varchar(50),
	@counterparty_acct_name varchar(50),
        @liquidity_provider varchar(50)
as

declare @committed_status_id int

declare @login varchar(50)
declare @source_id int
declare @deal_identifier varchar(50)
declare @deal_id int
declare @deal_status_id int
declare @deal_status varchar(25)
declare @deal_type_id int
declare @deal_type varchar(25)
declare @trade_identifier varchar(50)
declare @trade_id int
declare @trade_type_id int
declare @trade_type varchar(25)
declare @tally_type varchar(25)
declare @external_account_id int
declare @external_account varchar(50)
declare @external_account_type varchar(25)
declare @aggregation_style_id int
declare @aggregation_style varchar(25)
declare @quantity numeric(30,4)
declare @symbol varchar(25)
declare @value_date datetime
declare @agency_price float
declare @client_price float
declare @quoted_price float
declare @trade_date datetime
declare @trader_id int
declare @trader varchar(50)
declare @trader_symbol varchar(50)
declare @trader_login varchar(50)
declare @broker varchar(50)
declare @counterparty_id int
declare @counterparty varchar(50)
declare @counterparty_symbol varchar(50)
declare @counterparty_ext_account_id int
declare @spot_reference float
declare @side char(5)
declare @is_flipped char(1)
declare @is_agency_trade char(1)
declare @inverted char(1)
declare @cl_create char(1)
declare @lp_create char(1)
declare @mpt_order_id int
declare @client_aggressor char(1)
declare @trigger_symbol varchar(50)

/* Order variables */
declare @ord_amount numeric(30, 4)
declare @ototal_amt_filled numeric(30, 4)
declare @ototal_counter_filled numeric(30, 4)
declare @ototal_unacct_amt numeric(30, 4)
declare @ototal_canceled_amt numeric(30, 4)
declare @omkt_rate_on_submit float



select
    @login              = @default_login,
    @deal_identifier    = @order_id,
    @trade_identifier   = @exec_id,
    @tally_type         = case @order_type
                            when "Spot" then        "Spot"
                            when "Outright" then    "Forward"
                            when "NDF" then         "Forward"
                            when "EFP" then         "Forward"
                            when "Swap" then        "Swap"
                          end,
    @trade_type         = case @order_type
                            when "Spot" then        "Spot"
                            when "Outright" then    "Forward"
                            when "NDF" then         "Forward"
                            when "EFP" then         "Forward"
                            when "Swap" then        NULL
                          end,
    @quantity           = @fill_quantity,
    @value_date         = @settlement_date,
    @agency_price       = @fill_price,
    @client_price       = @trader_price,
    @trade_date         = @fill_date,
    @trader_symbol      = @order_added_by,
    @broker             = "TraderTools",
    @counterparty_symbol = @external_counterparty,
    @spot_reference     = @customer_rate,
    @is_flipped         = case @amount_ccy when @ccy2 then 'Y' else 'N' end,
    @side               = lower(@action),
    @is_agency_trade    = case @account_type when "Nostro" then 'Y' else 'N' end,
    @client_aggressor   = "N",
    @ord_amount		= convert(numeric(30, 4), @order_amount),
    @ototal_amt_filled  = convert(numeric(30, 4), @total_amt_filled),
    @ototal_counter_filled = convert(numeric(30, 4), @total_counter_filled),
    @ototal_unacct_amt = convert(numeric(30, 4), @total_unacct_amt),
    @ototal_canceled_amt = convert(numeric(30, 4), @total_canceled_amt),
    @omkt_rate_on_submit = convert(float, @mkt_rate_on_submit)



if @is_agency_trade = 'N'
begin
	select
		@quantity = -@quantity,
		@deal_identifier = @related_order_id,
		@client_aggressor = "Y"
end


/*
 * QUERY deal on cancel and process done order
 */ 
if @order_status = "Deleted"
begin
	select
    		@deal_id = deal_id
	from
    		deal_exec_symbols
	where
	    	symbol = @deal_identifier

	if @deal_id = NULL
	begin
		select
			/*status = "OrderDeleteProcessed",*/
			msg = "No order found for delete",
			deal_identifier = @deal_identifier,
			order_id = @order_id,
			ord_status = @order_status
	end
	else
	begin


        	select
                	@mpt_order_id = NULL

        	exec
                	tt_processorder
                        	@login=@login,
                        	@source=@source,
                        	@order_id=@mpt_order_id output,
                        	@deal_id=@deal_id,
                        	@order_type=@validity_type,
                        	@status=@order_status
	end
	
	select
		status = "OrderDeleteProcessed",
		message= "Order Delete Successfully Processed",
		order_id=@mpt_order_id,
		deal_id=@deal_id,
		order_type=@validity_type

	return
end
	

/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
    select
        status = "Error",
        message = "Source not found",
	source = @source
    return
end
/*
 * LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 */ 

select
    @trader_id = a.trader_id,
    @trader = a.symbol,
    @trader_login = c.login,
    @external_account_id = a.external_account_id
from
    traders a,
    trader_symbols b,
    sources ba,
    tico_accounts c
where    
    a.trader_id = b.trader_id
and
    b.source_id = ba.source_id
and
    a.tico_account_id = c.account_id
and
    ba.name = @source
and 
    b.symbol = @trader_symbol

if @trader_id = NULL or @trader_login = NULL
begin
    select
        @trader_id = a.trader_id,
        @trader = a.symbol,
        @trader_login = c.login,
        @external_account_id = a.external_account_id
    from
        traders a,
        tico_accounts c
    where    
        a.tico_account_id = c.account_id
    and 
        a.symbol = @trader_symbol

    if @trader_id = NULL or @trader_login = NULL
    begin
        select
            status = "Error",
            message = "Couldn't find trader and user for @trader_symbol, '" + @trader_symbol + "'",
            trader_symbol = @trader_symbol
        return
    end        
end

/*
 * LOOKUP @counterparty_id, @counterparty_symbol, @counterparty_ext_account_id from @lookup_cpty
 */


if @counterparty_symbol = " " and @is_agency_trade = "N"
	/*
	select
		@counterparty_symbol = "FUND AGENCY COUNTERPARTY"*/
        select 
		@counterparty_symbol = @customer_desk

select
    @counterparty_id = a.counterparty_id,
    @counterparty = a.name,
    @counterparty_ext_account_id = a.external_account_id
from
    counterparties a,
    counterparty_symbols b,
    sources ba
where
    a.counterparty_id = b.counterparty_id
and
    b.source_id = ba.source_id
and
    ba.name = @source
and
    b.symbol = @counterparty_symbol

if @counterparty = NULL
begin
    select
        @counterparty_id = a.counterparty_id,
        @counterparty = a.name,
        @counterparty_ext_account_id = a.external_account_id
    from
        counterparties a
    where
        a.name = @counterparty_symbol

        
    if @counterparty = NULL
    begin
        select
            status = "Error",
            message = "Couldn't find counterparty for @counterparty_symbol, '" + @counterparty_symbol + "'",
            counterparty_symbol = @counterparty_symbol
        return
    end
end

if @is_agency_trade = 'Y'
begin
    select
        @deal_type = case @order_type
            when "Spot" then            "Market Forward"
            when "Outright" then        "Market Forward"
            when "NDF" then             "Market Forward"
            when "EFP" then             "Market Forward"
            when "Swap" then            "Market Swap"
        end
    
    /* 
     * OVERWRITE @external_account_id from @counterparty_ext_account_id if this
     * is a street trade
     */
    select
        @external_account_id = @counterparty_ext_account_id
end
else
begin
    select
        @deal_type = case @order_type
            when "Spot" then            "B2B Forward"
            when "Outright" then        "B2B Forward"
            when "NDF" then             "B2B Forward"
            when "EFP" then             "B2B Forward"
            when "Swap" then            "B2B Swap"
        end
end

/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
    select
        status = "Error",
        message = "Couldn't find external_account from @external_account_id",
        external_account_id = @external_account_id
    return
end

/* 
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @is_flipped = 'N'
begin
    select
        @symbol = @ccy1 + @ccy2,
        @inverted = 'N'
end
else
begin
    select
        @symbol = @ccy2 + @ccy1,
        @inverted = 'Y',
        @quantity = -@quantity
end

if @side = 'sell'
begin
    select
        @quantity = -@quantity
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
    select
        message = "Contract not found",
        contract = @symbol,
        action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
    
    declare @evaluation_currency varchar(50)
    declare @fund_id int

    exec
        r_defaultfundforlogin
            @default_login,
            @fund_id output

    select
        @evaluation_currency = a.symbol
    from
        products a,
        funds b
    where
        a.product_id = b.evaluation_currency_id 
    and
        b.fund_id=@fund_id
  
    exec
        r_addbatchfwdsubscription
            @default_login,
            @symbol,
            @ccy1,
            @ccy2,
            @evaluation_currency 

    /* @waitfor_delay = "HH:MM:SS.00"*/
    declare @waitfor_delay char(11)
    select
        @waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

    select 
        action = "Sleeping @waitfor_delay and checking for contract again",
        waitfor_delay = @waitfor_delay

    waitfor delay @waitfor_delay

    if not exists (select contract_id from contracts where symbol=@symbol)
    begin
        select
            status = "Error",
            message = "Contract not found",
            symbol = @symbol
        return
    end
    
    select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
    select
        c.*
    from
        contracts a,
        contract_price_styles b,
        price_styles c
    where
        a.contract_id = b.contract_id
    and
        b.price_style_id = c.price_style_id
    and
        a.symbol = @symbol
    and
        c.name = "Inverted"
    )
begin
    insert into
        contract_price_styles (
            contract_id,
            price_style_id,
            factor
        )
    select
        a.contract_id,
        b.price_style_id,
        1.0
    from
        contracts a,
        price_styles b
    where
        a.symbol = @symbol
    and
        b.name = "Inverted"
end


select
    @deal_id = deal_id
from
    deal_exec_symbols
where
    symbol = @deal_identifier

if @deal_id = NULL
begin
    select
        msg = "Creating new deal"
    
    select
        @deal_status_id = status_id
    from
        statuses
    where
        name = "User Review"
    if @deal_status_id = NULL
    begin
        select
            status = "Error",
            message = "No status found named, 'User Review'"
        return
    end
    select
        @deal_type_id = deal_type_id
    from
        deal_types
    where
        name = @deal_type
    if @deal_type_id = NULL
    begin
        select
            status = "Error",
            message = "No deal type found for @deal_type",
            deal_type = @deal_type
        return    
    end

    exec
        j_nextkey
            "deals",
            @deal_id output

    insert into
        deals(
            deal_id,   
            deal_type_id,
            timestamp,  
            status_id  
             )      
        values( 
            @deal_id,
            @deal_type_id,
            getdate(),
            @deal_status_id
            )
    
    insert into
        deal_exec_symbols
    values(
        @deal_id,
        @deal_identifier
    )
end
else
begin
    select
        msg = "Appending to existing deal"

    /*  Below to support management of deal_type. 
        This tally is currently purposed for B2B deals. This will be inserted B2B */    
    /*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = 'B2B Forward'
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for 'B2B Forward'"
                return
        end

    update
        deals
    set
        deal_type_id = @deal_type_id
    where
        deal_id = @deal_id
    */
end

declare @check_for_order char(1)
if @deal_id != NULL
begin
	select
		@check_for_order = "Y"
end
 
/*
select
        'sql' = "exec fxa_tallytrade",
        login = @trader_login,
        source = @source,
        trade_id = @trade_id,
        deal_id = @deal_id,
        tally_type = @trade_type,
        deal_type = @deal_type,
        trade_type = @trade_type,
        external_account = @external_account,
        counterparty = @counterparty,
        quantity = @quantity,
        symbol = @symbol,
        value_date = @value_date,
        price = @agency_price,
        trade_date = @trade_date,
        trader = @trader,
        broker = @broker,
        identifier = @trade_identifier,
        spot_reference = @spot_reference
*/
exec
    fxa_tallytrade
        @login = @trader_login,
        @source = @source,
        @trade_id = @trade_id out,
        @deal_id = @deal_id out,
        @tally_type = @trade_type,
        @deal_type = @deal_type,
        @trade_type = @trade_type,
        @external_account = @external_account,
        @counterparty = @counterparty,
        @quantity = @quantity,
        @symbol = @symbol,
        @value_date = @value_date,
        @price = @agency_price,
        @trade_date = @trade_date,
        @trader = @trader,
        @broker = @broker,
        @identifier = @trade_identifier,
        @spot_reference = @spot_reference

if @trade_id = NULL
begin
    select
        status = "Error",
        message = "Failed to tally trade"
    return
end






if @quoted_price != NULL
begin
insert into
    trade_quoted_prices (
        trade_id,
        price)
    values(
        @trade_id,
        @quoted_price
    )
end

exec
    r_inserttradenotification
        @trade_id

 /*
  * CHECK to see if this requires a manufactured B2B
  */
select
        @cl_create = cl_create,
        @lp_create = lp_create
from
        ticket_creation_values
where
        trigger_symbol = @customer_account
and
	source_id = @source_id
if @@rowcount != 0
begin
	
	select
		@trigger_symbol = @customer_account
end

select 
	@cl_create = cl_create,
	@lp_create = lp_create
from 
	ticket_creation_values 
where 
	trigger_symbol = @trader_symbol 
and
	 source_id = @source_id
if @@rowcount != 0
begin
        select
                @trigger_symbol = @trader_symbol
end


if @cl_create = "Y" or @lp_create = "Y"
begin
	if @cl_create = "Y"
	begin
		declare @t2_cl_ext_account varchar(50)
		declare @t2_cl_trader varchar(50)
		declare @t2_cl_counterparty varchar(50)
		declare @t2_cl_trade_id int
		declare @t2_cl_identifier varchar(100)
		declare @t2_cl_quantity numeric(30, 4)
		declare @t2_cl_inv_qty char(1)
			
		select
			@t2_cl_ext_account = cl_ext_account,
			@t2_cl_trader = cl_trader,
			@t2_cl_counterparty = cl_counterparty,
			@t2_cl_inv_qty = cl_inv_qty
		from
			ticket_creation_values
		where
		        trigger_symbol = @trigger_symbol

		select
			@t2_cl_identifier = rtrim(@trade_identifier)+".t2cl_autob2b",
                        @t2_cl_quantity = @quantity

		
		if @t2_cl_inv_qty = "Y"
		begin
			select
				@t2_cl_quantity = -@quantity
		end

		exec
			fxa_tallytrade
        			@login = @trader_login,
        			@source = @source,
        			@trade_id = @t2_cl_trade_id out,
        			@deal_id = @deal_id,
        			@tally_type = @trade_type,
        			@deal_type = @deal_type,
        			@trade_type = @trade_type,
        			@external_account = @t2_cl_ext_account,
        			@counterparty = @t2_cl_counterparty,
        			@quantity = @t2_cl_quantity,
        			@symbol = @symbol,
        			@value_date = @value_date,
        			@price = @agency_price,
        			@trade_date = @trade_date,             
        			@trader = @t2_cl_trader,
        			@broker = @broker,
        			@identifier = @t2_cl_identifier,
        			@spot_reference = @spot_reference

		if @t2_cl_trade_id = NULL
		begin
    			select
        			status = "Error",
        			message = "Failed to tally trade"
    			return
		end

		if @quoted_price != NULL
		begin
			insert into
    				trade_quoted_prices (
        			trade_id,
        			price)
    			values(
        			@t2_cl_trade_id,
        			@quoted_price
    			)
		end

		exec
    			r_inserttradenotification
        			@t2_cl_trade_id

    		select
        		status = "Tallied",
        		message = "Trade successfully tallied",
        		trade_id = @t2_cl_trade_id,
        		deal_id = @deal_id,
        		account = @t2_cl_ext_account,
        		symbol = @symbol,
        		side = @side,
        		quantity = @t2_cl_quantity,
        		price = @agency_price,
        		val_date = @value_date
 
		

	end
	if @lp_create = "Y"
	begin
	        declare @t2_lp_ext_account varchar(50)
                declare @t2_lp_trader varchar(50)
                declare @t2_lp_counterparty varchar(50)
                declare @t2_lp_trade_id int
                declare @t2_lp_identifier varchar(100)
                declare @t2_lp_quantity numeric(30, 4)
		declare @t2_lp_inv_qty char(1)

                select
                        @t2_lp_ext_account = lp_ext_account,
                        @t2_lp_trader = lp_trader,
                        @t2_lp_counterparty = lp_counterparty,
			@t2_lp_inv_qty = lp_inv_qty
                from
                        ticket_creation_values
                where
                        trigger_symbol = @trigger_symbol

                select
                        @t2_lp_identifier = rtrim(@trade_identifier)+".t2lp_autob2b",
			@t2_lp_quantity = @quantity

                if @t2_lp_inv_qty = "Y"
                begin
                        select
                                @t2_lp_quantity = -@quantity
                end
		

                exec
                        fxa_tallytrade
                                @login = @trader_login,
                                @source = @source,
                                @trade_id = @t2_lp_trade_id out,
                                @deal_id = @deal_id,
                                @tally_type = @trade_type,
                                @deal_type = @deal_type,
                                @trade_type = @trade_type,
                                @external_account = @t2_lp_ext_account,
                                @counterparty = @t2_lp_counterparty,
                                @quantity = @t2_lp_quantity,
                                @symbol = @symbol,
                                @value_date = @value_date,
                                @price = @agency_price,
                                @trade_date = @trade_date,
                                @trader = @t2_lp_trader,
                                @broker = @broker,
                                @identifier = @t2_lp_identifier,
                                @spot_reference = @spot_reference

                if @t2_lp_trade_id = NULL
                begin
                        select
                                status = "Error",
                                message = "Failed to tally trade"
                        return
                end

                if @quoted_price != NULL
                begin
                        insert into
                                trade_quoted_prices (
                                trade_id,
                                price)
                        values(
                                @t2_lp_trade_id,
                                @quoted_price
                        )
                end

                exec
                        r_inserttradenotification
                                @t2_lp_trade_id

                select
                        status = "Tallied",
                        message = "Trade successfully tallied",
                        trade_id = @t2_lp_trade_id,
                        deal_id = @deal_id,
                        account = @t2_lp_ext_account,
                        symbol = @symbol,
                        side = @side,
                        quantity = @t2_lp_quantity,
                        price = @agency_price,
                        val_date = @value_date

	end
end


/* 
 * AUTOCOMMIT
 *
 * If there is a client trade in this deal and the account type is set for
 * Autocommit, then push through this deal automatically.
 */
if @deal_id != NULL and @is_agency_trade = 'N' and @aggregation_style = "Autocommit"
begin

    update
        deals
    set
        status_id = @committed_status_id
    where
        deal_id = @deal_id
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    end
end
else
begin
    select
        message = "No autocommitted",
        deal_id = @deal_id,
        trade_id = @trade_id,
        aggregation_style = @aggregation_style
end

if exists(
    select
        trade_id 
    from
        trades
    where
        trade_id = @trade_id
)
begin
    select
        status = "Tallied",
        message = "Trade successfully tallied",
        trade_id = @trade_id,
        deal_id = @deal_id,
        account = @external_account,
        symbol = @symbol,
        side = @side,
        quantity = @quantity,
        price = @agency_price,
        val_date = @value_date
end

if @check_for_order = "Y" and @aggregation_style != "None"
begin

	select
		@mpt_order_id = NULL
	select
		@ord_amount = @ord_amount+abs(@quantity)

	exec
		tt_processorder
			@login=@login,
			@source=@source,
			@order_id=@mpt_order_id output,
			@deal_id=@deal_id,
			@trade_id=@trade_id,
			@client_aggressor=@client_aggressor,
			@counterparty=@counterparty,
			@order_type=@validity_type,
			@order_quantity=@ord_amount,
			@order_date=@trade_date,
			@status=@order_status,
		        @internal_account=NULL,
                	@external_account=@external_account,
                	@contract=@symbol,
                	@trader=@trader,
        	        @strategy=NULL,
	                @broker=@broker
end


go
