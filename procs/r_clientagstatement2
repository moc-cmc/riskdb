/* Calculate Open Trades */
create table
  #open_trades(
    row_kind int,
    contract varchar(25),
    value_date datetime NULL,
    trade_id int NULL,
    buy_sell varchar(10) NULL,
    symbol varchar(25),
    dealt_amount float,
    rate float NULL,
    counter_amount float,
    market_rate float NULL,
    market_value float NULL,
    trade_date datetime NULL,
    style varchar(75))
insert into
  #open_trades(
    row_kind,
    contract,
    value_date,
    trade_id,
    buy_sell,
    symbol,
    dealt_amount,
    rate,
    counter_amount,
    trade_date,
    style)
select
  row_kind = 0,
  contract = c.symbol,
  a.value_date,
  a.trade_id,
  buy_sell = case when a.product_qty >= 0 then "Bought" else "Sold" end,
  symbol = c.symbol,
  dealt_amount = a.product_qty,
  rate = a.price,
  counter_amount = a.currency_qty,
  a.trade_date,
	style = "background:#FFFFFF;border: 1px solid white"
from
  #trades a,
  trade_types b,
  contracts c
where
  a.trade_type_id = b.trade_type_id
and
  a.contract_id = c.contract_id
and
  a.value_date >= @end_date
order by
  c.symbol,
  a.trade_id

update
  #open_trades
set
  market_rate = b.close_price,
  market_value = -b.native_unrealized_pl_to_date
from
  #open_trades a,
  committed_daily_revals b
where
  a.trade_id = b.trade_id
and
  b.reval_date = @end_date

insert into
  #open_trades (
    row_kind,
    contract,
    symbol,
    dealt_amount,
    counter_amount,
    market_value,
    style
  )
select
  row_kind = 1,
  contract,
  symbol = "<b>Total</b>",
  dealt_amount = sum(dealt_amount),
  counter_amount = sum(counter_amount),
  market_value = sum(market_value),
	style = "background:#fff;border:1px solid white;height:2em;font-weight:bold"
from
  #open_trades
group by
  contract

update
  #open_trades
set
  dealt_amount = abs(dealt_amount),
  counter_amount = abs(counter_amount)
where
  row_kind = 0


/* Calculate Maturing Trades */
create table
  #maturing_trades(
    row_kind int,
    contract varchar(25),
    value_date datetime NULL,
    trade_id int NULL,
    buy_sell varchar(10) NULL,
    symbol varchar(25),
    rate float NULL,
    dealt_amount float,
    dealt_ccy varchar(10) NULL,
    counter_amount float,
    counter_ccy varchar(10) NULL,
    trade_date datetime NULL,
    style varchar(75))
insert into
  #maturing_trades(
    row_kind,
    contract,
    value_date,
    trade_id,
    buy_sell,
    symbol,
    rate,
    dealt_amount,
    dealt_ccy,
    counter_amount,
    counter_ccy,
    trade_date,
    style)
select
  row_kind = 0,
  contract = c.symbol,
  a.value_date,
  a.trade_id,
  buy_sell = case when a.product_qty >= 0 then "Bought" else "Sold" end,
  symbol = c.symbol,
  rate = a.price,
  dealt_amount = a.product_qty,
  dealt_ccy = d.symbol,
  counter_amount = a.currency_qty,
  counter_ccy = e.symbol,
  a.trade_date,
	style = "background:#FFFFFF;border: 1px solid white"
from
  #trades a,
  trade_types b,
  contracts c,
  products d,
  products e
where
  a.trade_type_id = b.trade_type_id
and
  a.contract_id = c.contract_id
and
  a.product_id = d.product_id
and
  a.currency_id = e.product_id
and
  a.value_date >= @begin_date
and
  a.value_date < @end_date
order by
  c.symbol,
  a.trade_id

insert into
  #maturing_trades (
    row_kind,
    contract,
    symbol,
    dealt_amount,
    counter_amount,
    style
  )
select
  row_kind = 1,
  contract,
  symbol = "<b>Total</b>",
  dealt_amount = sum(dealt_amount),
  counter_amount = sum(counter_amount),
	style = "background:#fff;border:1px solid white;height:2em;font-weight:bold"
from
  #maturing_trades
group by
  contract

update
  #maturing_trades
set
  dealt_amount = abs(dealt_amount),
  counter_amount = abs(counter_amount)
where
  row_kind = 0


/* Select out Today's Trades */
select
  section = "Today's Trades",
  trade_type = b.name,
  a.trade_id,
  a.value_date,
  dealt_ccy = c.symbol,
  dealt_amount = a.product_qty,
  counter_ccy = d.symbol,
  counter_amount = a.currency_qty,
  rate = a.price,
  a.trade_date,
  style = "background:#fff"
from
  #trades a,
  trade_types b,
  products c,
  products d
where
  a.trade_type_id = b.trade_type_id
and
  a.product_id = c.product_id
and
  a.currency_id = d.product_id
and
  a.trade_date >= @begin_date
and
  a.trade_date < @end_date
order by
  c.symbol,
  d.symbol,
  a.trade_id

/* Select out Open Trades FX */
select
  section = "Open Trades FX",
  value_date,
  trade_id,
  "Buy/Sell" = buy_sell,
  symbol,
  dealt_amount = dealt_amount,
  rate,
  counter_amount = counter_amount,
  market_rate,
  market_value,
  trade_date,
	style
from
  #open_trades
order by
  contract,
  row_kind,
  trade_id

/* Select out Maturing Trades */
select
  section = "Maturing Trades",
  value_date,
  trade_id,
  "Buy/Sell" = buy_sell,
  symbol,
  rate,
  dealt_amount = dealt_amount,
  dealt_ccy,
  counter_amount = counter_amount,
  counter_ccy,
  trade_date,
	style
from
  #maturing_trades
order by
  contract,
  row_kind,
  trade_id

/* Select out the Maturing Totals */
select
	section = "Maturing Totals",
	style = "background:#FFFFFF;border: 1px solid white",
	account = c.symbol,
	currency = a.symbol,
	amount = b.quantity
from
	products a,
	#maturing_totals b,
	external_accounts c
where
	a.product_id = b.product_id
and
	b.external_account_id = c.external_account_id
order by
	c.symbol,
	a.symbol

/* Select out the Account Activity */
select
	section = "Account Activity",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
	activity = c.name,
	a.amount,
	currency = d.symbol
from
	#account_transactions a,
	external_accounts b,
	transaction_types c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.currency_id = d.product_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date < @end_date
order by
	b.symbol,
	a.transaction_date

select
	section = "Net Equity Activity",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
	product = c.symbol,
	a.opening_balance,
	a.maturing_fx,
	a.cash,
	a.fees,
	a.settled_premium,
	a.closing_balance,
	a.unsettled_prem,
	a.open_position,
	a.open_option_pos,
	a.total_equity
from
	#net_activity a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
order by
	b.symbol,
	c.symbol

/* Show the Equity Value Summary */
select
	section = "Equity Value Summary",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
	product = c.symbol,
  a.total_equity,
  a.conversion_rate,
  a.converted_value,
  evaluation_ccy = d.symbol
from
	#equity_value_summary a,
	external_accounts b,
	products c,
  products d
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
and
  a.evaluation_currency_id = d.product_id
order by
	b.symbol,
	c.symbol

/* Show the Margin Summary */
select
	section = "Margin Summary",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
  a.net_equity,
  a.net_margin_use,
  a.available_funds,
  currency = c.symbol
from
	#margin_summary a,
	external_accounts b,
  products c
where
	a.external_account_id = b.external_account_id
and
	c.product_id = @evaluation_currency_id
order by
	b.symbol

exec
  r_showdisclaimer
    "Daily Trading Statement"

go
