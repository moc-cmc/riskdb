go

create procedure
	r_getcommitdata
		@login varchar(50),
		@bo_trade_date datetime

as 


declare @min_ticket_size float
declare @commit_status varchar(50) 
declare @evaluation_currency varchar(30) 
declare @spot_trades int 
declare @spot_volume float 
declare @forward_trades int 
declare @forward_volume float 
declare @forward_option_trades int 
declare @forward_option_volume float 
declare @exotic_trades int 
declare @exotic_volume float 
declare @forward_swap_trades int 
declare @forward_swap_volume float 
declare @futures_trades int 
declare @futures_volume float 
declare @futures_option_trades int 
declare @futures_option_volume float
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(250)
declare @external_account_id int
declare @account_id int


select
	@account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
        select

                error = "Problem deterimining login",
                login = @login
        return
end


create table
	#external_accounts(
		external_account_id int,
 		server varchar(50),
 		database_name varchar(50),
 		proc_name varchar(50),
		min_ticket_size float,
		status varchar(50) 
)

create table
	#run_external_accounts(
		account_id int,
		external_account_id int
)


insert into
	#run_external_accounts
select
	@account_id,
	a.external_account_id
from
	run_external_accounts a,
	user_runs b
where
	b.tico_account_id = @account_id
and
	a.run_id = b.run_id
group by
	a.external_account_id
		

insert into
	#external_accounts
select
	b.external_account_id,
	b.server,
	b.database_name,
	b.proc_name,
	b.min_ticket_size,
	"Uncommitted"
from
	#run_external_accounts a,
	external_account_info b
where
	a.external_account_id = b.external_account_id

update
	#external_accounts
set
	status = "Committed"
from
	risk_commit_aggregates a,
	#external_accounts b
where
	commit_status = "Committed"
and
	bo_trade_date = @bo_trade_date
and
	a.external_account_id = b.external_account_id
	


declare external_account_cursor cursor for
	select 
		external_account_id
	from
		#external_accounts
	where
		status != "Committed"

open external_account_cursor
fetch external_account_cursor into @external_account_id

while @@sqlstatus = 0
begin

	delete from
		risk_commit_aggregates
	where
		external_account_id = @external_account_id
	and
		bo_trade_date = @bo_trade_date	

	select
		@sql_string = a.server+ "." + a.database_name + "." + a.proc_name,
                @min_ticket_size = a.min_ticket_size
	from
		#external_accounts a
	where
		a.external_account_id = @external_account_id 
		
	exec
		@sql_string
                        @login,
                        @bo_trade_date,
			@external_account_id,
                        @min_ticket_size,
                        @commit_status  output,
                        @evaluation_currency output,
                        @spot_trades  output,
                        @spot_volume  output,
                        @forward_trades  output,
                        @forward_volume  output,
                        @forward_option_trades  output,
                        @forward_option_volume  output,
                        @exotic_trades  output,
                        @exotic_volume  output,
                        @forward_swap_trades  output,
                        @forward_swap_volume  output,
                        @futures_trades  output,
                        @futures_volume  output,
                        @futures_option_trades  output,
                        @futures_option_volume  output

	insert into
        	risk_commit_aggregates
	values(
                @external_account_id,
                @bo_trade_date,
                @min_ticket_size,
                @commit_status,
                @evaluation_currency,
                @spot_trades,
                @spot_volume,
                @forward_trades,
                @forward_volume,
                @forward_option_trades,
                @forward_option_volume,
                @exotic_trades,
                @exotic_volume,
                @forward_swap_trades,
                @forward_swap_volume,
                @futures_trades,
                @futures_volume,
                @futures_option_trades,
                @futures_option_volume
)

	select	
                @external_account_id = NULL,
                @min_ticket_size = NULL,
                @commit_status = NULL,
                @evaluation_currency = NULL,
                @spot_trades = NULL,
                @spot_volume = NULL,
                @forward_trades = NULL,
                @forward_volume = NULL,
                @forward_option_trades = NULL,
                @forward_option_volume = NULL,
                @exotic_trades = NULL,
                @exotic_volume = NULL,
                @forward_swap_trades = NULL,
                @forward_swap_volume = NULL,
                @futures_trades = NULL,
                @futures_volume = NULL,
                @futures_option_trades = NULL,
                @futures_option_volume = NULL



	fetch external_account_cursor into @external_account_id
end

close external_account_cursor
deallocate external_account_cursor
		

