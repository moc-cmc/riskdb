create table
	#fut_based_contracts(
		contract_id int,
		multiplier numeric(30,2),
		product_id int,
		currency_id int)
insert into
	#fut_based_contracts
select
	a.contract_id,
	b.quantity,
	c.product_id,
	c.currency_id
from
	future_contracts a,
	futures b,
	forwards c
where
	a.future_id = b.future_id
and
	b.forward_id = c.contract_id
and
	a.expiration >= @start_date

insert into
	#fut_based_contracts
select
	a.contract_id,
	e.quantity,
	f.product_id,
	f.currency_id
from
	option_contracts a,
	option_expirations b,
	options c,
	future_contracts d,
	futures e,
	forwards f
where
	a.option_expiration_id = b.option_expiration_id
and
	b.option_id = c.option_id
and
	c.underlying_contract_id = d.contract_id
and
	d.future_id = e.future_id
and
	e.forward_id = f.contract_id
and
	b.expiration >= @start_date

		


create table
	#trades(
		trade_id int,
		contract_id int,
		broker_id int,
		counterparty_id int,
		external_account_id int,
		trader_id int,
		trade_type_id int,
		notional_volume float NULL,
		volume float NULL,
		bo_trade_date datetime NULL,
		native_currency_id int NULL,
		product_id int NULL,
		evaluation_currency_id int NULL,
		evaluation_contract_id int NULL,
		evaluation_settle float NULL)


/*
 * Find any trades that were done during the range
 */
insert into
	#trades(
		trade_id,
		contract_id,
		broker_id,
		counterparty_id,
		external_account_id,
		trader_id,
		trade_type_id,
		notional_volume,
		volume,
                bo_trade_date,
		evaluation_currency_id)
select
	a.trade_id,
	b.contract_id,
	b.broker_id,
	b.counterparty_id,
	b.external_account_id,
	b.trader_id,
	b.trade_type_id,
	a.notional_amount,
	a.evaluation_notional,
	a.bo_trade_date,
	@evaluation_currency_id
from
	committed_daily_revals a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g,
	#counterparties h
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.broker_id = g.broker_id
and
	b.counterparty_id = h.counterparty_id
and
	a.value_date >= @start_date
and
	a.bo_trade_date >= @start_date
and
	a.bo_trade_date < @stop_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id

update
	#trades
set
	product_id = a.product_id
from
	forwards a,
	#trades b
where
	a.contract_id = b.contract_id

update
	#trades
set
	product_id = a.product_id
from
	forwards a,
        #trades b,
        option_contracts c,
        option_expirations d,
        options e
where
        b.contract_id = c.contract_id
and
        c.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
	e.underlying_contract_id = a.contract_id

update
        #trades
set
        product_id = a.product_id
from
        forwards a,
        #trades b,
        exotic_contracts c,
        option_expirations d,
        options e
where
        b.contract_id = c.contract_id
and
        c.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
        e.underlying_contract_id = a.contract_id



/* Forwards */
update
	#trades
set
	evaluation_contract_id = c.contract_id,
	evaluation_settle = a.price
from
	bo_spot_settles a,
	#trades b,
	forwards c
where
	a.contract_id = c.contract_id
and
	b.product_id = c.product_id
and
	b.evaluation_currency_id = c.currency_id
and
	convert(date, a.price_date) = convert(date, b.bo_trade_date)

update
        #trades
set
	evaluation_contract_id = c.contract_id,
        evaluation_settle = a.price
from
        bo_spot_settles a,
        #trades b,
        forwards c
where
        a.contract_id = c.contract_id
and
        b.product_id = c.currency_id
and
        b.evaluation_currency_id = c.product_id
and
        convert(date, a.price_date) = convert(date, b.bo_trade_date)

	
	
/* Options */
update
        #trades
set
	evaluation_contract_id = f.contract_id,
        evaluation_settle = a.price
from            
        bo_spot_settles a,
        #trades b,
        option_contracts c,
        option_expirations d,
        options e,
	forwards f
where
        b.contract_id = c.contract_id
and
        c.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
        e.underlying_contract_id = f.contract_id
and
	b.product_id = f.product_id
and
	b.evaluation_currency_id = f.currency_id
and
	f.contract_id = a.contract_id
and
        convert(date, a.price_date) = convert(date, b.bo_trade_date)

update
        #trades
set
	evaluation_contract_id = f.contract_id,
        evaluation_settle = a.price
from
        bo_spot_settles a,
        #trades b,
        option_contracts c,
        option_expirations d,
        options e,
        forwards f
where
        b.contract_id = c.contract_id
and
        c.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
        e.underlying_contract_id = f.contract_id
and
        b.product_id = f.currency_id
and
        b.evaluation_currency_id = f.product_id
and
	f.contract_id = a.contract_id
and
        convert(date, a.price_date) = convert(date, b.bo_trade_date)



/* Exotics */
update
        #trades
set
	evaluation_contract_id = f.contract_id,
        evaluation_settle = a.price
from
        bo_spot_settles a,
        #trades b,
        exotic_contracts c,
        option_expirations d,
        options e,
        forwards f
where
        b.contract_id = c.contract_id
and
        c.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
        e.underlying_contract_id = f.contract_id
and
        b.product_id = f.product_id
and
        b.evaluation_currency_id = f.currency_id
and
	f.contract_id = a.contract_id
and
        convert(date, a.price_date) = convert(date, b.bo_trade_date)

update
        #trades
set
	evaluation_contract_id = f.contract_id,
        evaluation_settle = a.price
from
        bo_spot_settles a,
        #trades b,
        exotic_contracts c,
        option_expirations d,
        options e,
        forwards f
where
        b.contract_id = c.contract_id
and
        c.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
        e.underlying_contract_id = f.contract_id
and
        b.product_id = f.currency_id
and
        b.evaluation_currency_id = f.product_id
and
	f.contract_id = a.contract_id
and
        convert(date, a.price_date) = convert(date, b.bo_trade_date)


update
	#trades
set
	evaluation_contract_id = contract_id
from
	#trades
where
	evaluation_settle = NULL
and
	product_id = evaluation_currency_id

update
	#trades
set
	a.evaluation_contract_id = e.underlying_contract_id
from
	#trades a,
	option_contracts b,
        option_expirations d,
        options e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
	a.evaluation_settle = NULL
and
	a.product_id = a.evaluation_currency_id

update
        #trades
set
        a.evaluation_contract_id = e.underlying_contract_id
from
        #trades a,
        exotic_contracts b,
        option_expirations d,
        options e
where
        a.contract_id = b.contract_id
and
        b.option_expiration_id = d.option_expiration_id
and
        d.option_id = e.option_id
and
        a.evaluation_settle = NULL
and
        a.product_id = a.evaluation_currency_id




	
declare @missing_underlying int
select 
	@missing_underlying = count(*)
from
	#trades
where
	evaluation_settle = NULL
and
	product_id != evaluation_currency_id
if @missing_underlying != 0
begin
	select
		"status" = "Warning",
		"msg"= "Missing underlying conversion rate for trades"

	select
		a.trade_id,
		b.symbol,
		a.evaluation_settle
	from
		#trades a,
		contracts b
	where
		a.contract_id = b.contract_id
	and
		a.evaluation_settle = NULL
end


