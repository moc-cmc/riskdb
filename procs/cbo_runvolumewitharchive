go

create procedure
	cbo_runvolume
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @start_date datetime
declare @stop_date datetime
declare @evaluation_currency_id int
declare @fund_id int
declare @run_id int
declare @source_id int
declare @total_volume float
declare @trade_count float
declare @avg_ticket_size float

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"trades_file",
	"Run Trades File",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"volume",
	"Number",
	"#,##0.00")
insert into
        #meta
values(
        "Column Format",
        "avg_ticket_size",
        "Number",
        "#,##0.00")

insert into
        #meta
values(
        "Column Format",
        "native_volume",
        "Number",
        "#,##0.00")


select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id,
	@source_id = source_id
from
	fund_run_defaults
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end


if @begin_date = NULL
	select
		@begin_date = getdate()

if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output

	select
		@start_date = @begin_date,
		@stop_date = @end_date
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@start_date output,
			@stop_date output

	exec
		r_daterangefordate
			@end_date,
			@begin_date output,
			@stop_date output
end


