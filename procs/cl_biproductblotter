
drop procedure
	cl_biproductblotter
go

create procedure
	cl_biproductblotter
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@trade_id int=NULL

as



declare @run_id int
declare @tico_account_id int

declare @date datetime


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Format Number",
	"price",
	NULL,
	NULL,
	"#,##0.000000")


select * from #links

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "login not found"
	return
end

select
	@run_id = a.run_id
from
	user_runs a,
	runs b
where
	a.run_id = b.run_id
and
	b.name = @run_name
and
	a.tico_account_id = @tico_account_id
if @run_id = NULL
begin
	select
		id = -1,
		error = "No run configured for user"
	return
end
	


if @begin_date = NULL
	select
		@begin_date = convert(datetime, convert(char(11), getdate(), 1))


if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output
else
begin
	exec
		r_daterangefordate
			@end_date,
			@date output,
			@end_date output
end


	
create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#traders
	select
		trader_id
	from
		traders

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select  
	internal_account_id
from    
	run_internal_accounts
where   
	run_id = @run_id 
if @@rowcount = 0
	insert into
		#internal_accounts
	select  
		internal_account_id
	from    
		internal_accounts

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#strategies
	select
		strategy_id
	from
		strategies


create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers


create table
	#trades(
		trade_id int,
		deal_id int,
		trade_date datetime,
		trading_party varchar(50) NULL,
		counter_party varchar(50) NULL,
		product varchar(10) NULL,
		buy_sell varchar(20) NULL,
		quantity numeric(30,4),
		symbol varchar(50) NULL,
		value_date varchar(11) NULL,
		price float,
        min_scale int NULL,
        max_scale int NULL,
		reference_id varchar(50) NULL,
		trader varchar(25) NULL
		)

if @trade_id = NULL
begin
	insert into
		#trades(
			trade_id,
			deal_id,
			trade_date,
			quantity,
			price)
	select
		a.trade_id,
		a.deal_id,
		a.trade_date,
		a.quantity,
		a.price
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        statuses g
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
    and
        a.status_id = g.status_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
	and
		a.quantity != 0
    and
        g.name != "Unaggregated"
end
else /* Identical query above except with @trade_id qualifier */
begin
	insert into
		#trades(
			trade_id,
			deal_id,
			trade_date,
			quantity,
			price)
	select
		a.trade_id,
		a.deal_id,
		a.trade_date,
		a.quantity,
		a.price
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        statuses g
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
    and
        a.status_id = g.status_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
	and
		a.trade_id = @trade_id
	and
		a.quantity != 0
    and
        g.name != "Unaggregated"
end	






update
	#trades
set
	a.trading_party = c.symbol
from
	#trades a,
	trades b,
	external_accounts c
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id

update
	#trades
set
	a.counter_party = c.symbol
from
	#trades a,
	trades b,
	internal_accounts c
where
	a.trade_id = b.trade_id
and
	b.internal_account_id = c.internal_account_id

update
	#trades
set
	a.product = c.name
from
	#trades a,
	trades b,
	trade_types c
where
	a.trade_id = b.trade_id
and
	b.trade_type_id= c.trade_type_id


update
	#trades
set
	buy_sell = "Client Buys"
where
	quantity < 0

update
	#trades
set
	buy_sell = "Client Sells"
where
	quantity >= 0

update
	#trades
set
	quantity = abs(quantity)

update
	#trades
set
	a.symbol = c.symbol
from
	#trades a,
	trades b,
	contracts c
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id

update
	#trades
set
	a.value_date = convert(char(11), b.value_date, 1)
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id

update
	#trades
set
	a.reference_id = b.identifier
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id
	
update
	#trades
set
	a.trader = c.symbol
from
	#trades a,
	trades b,
	traders c
where
	a.trade_id = b.trade_id
and
	b.trader_id = c.trader_id

/* Set defaults */
update
	#trades
set
    min_scale = 5,
    max_scale = 6

update
	#trades
set
	price = 1.0 / a.price,
    min_scale = c.min_scale + 1,
    max_scale = c.max_scale
from
	#trades a,
	trades b,
	contract_price_styles c,
	price_styles d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

select
	deal_id,
	trade_date,
	trading_party,
	counter_party,
	product,
	buy_sell,
	quantity,
	symbol,
	value_date,
	price = case buy_sell
        when "Client Buys" then
            ceiling(price * power(10, max_scale)) / power(10, max_scale)
        else
            floor(price * power(10, max_scale)) / power(10, max_scale)
    end,
	reference_id,
	trader
from
	#trades
order by
	trade_date

go
