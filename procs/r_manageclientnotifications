drop procedure r_manageclientnotifications
go


create procedure
	r_manageclientnotifications
		@login varchar(50)

as



declare @tico_account_id int
declare @agency_client_source_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = -1,
		error = "Problem deterimining login"
	return
end

select 
	@agency_client_source_id = source_id
from
	sources
where
	name = 'Agency Client'
if @@rowcount != 1
begin
	select
		error = "Error",
		message = "Problem finding status 'Agency Client'"
	return
end

create table
    #meta (
        meta_type char(50),
        name char(50) NULL,
        action char(100) NULL,
        value char(200) NULL
    )

create table
	#overview_output
(
	external_account_id int,
	external_account varchar(100),
	transfer_protocol varchar(25) NULL,
	distribution_list varchar(25) NULL,
        client_blotter_login varchar(50) NULL,
	notification_alias varchar(50) NULL,
	set_transfer_protocol varchar(25) NULL,
	set_distribution_list varchar(25) NULL,
        set_client_blotter_login varchar(25) NULL,
	set_notification_alias varchar(25) NULL,
	external_account_type varchar(50) NULL,
	status varchar(10) NULL /* 'Live' or NULL */
)


insert into #overview_output
select
	a.external_account_id,
	a.symbol,
	'None',
	'None',
	'None',
	a.symbol,
	"Set Transfer Protocol",
	"Set Distribution List",
        "Set Blotter Login",
	"Set Notification Alias",
	b.name,
	NULL
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
	
update
	#overview_output
set
	transfer_protocol = a.name
from
	transfer_protocols a,
	protocol_credentials b,
	client_transfer_details c
where
	c.protocol_credential_id = b.protocol_credential_id
and
	a.transfer_protocol_id = b.transfer_protocol_id

update
	#overview_output
set
	status = 'Live'
from
	#overview_output a,
	external_accounts b,
	tico_accounts c,
	trade_notifiers d,
	client_transfer_details e,
	client_login_configs f
where
	a.external_account_id = b.external_account_id
and
	a.external_account_id = d.external_account_id
and
	a.external_account_id = e.external_account_id
and
	c.account_id = f.tico_account_id
and
	e.client_login_config_id = f.id
and
	d.source_id = @agency_client_source_id
and
	f.run_id != NULL
and
	f.blotter_view_style_id != NULL
and
	e.dist_list_id != NULL
	

update 
	#overview_output
set
	distribution_list = a.name
from
	dist_lists a,
	client_transfer_details b,
	#overview_output c
where
	a.dist_list_id = b.dist_list_id
and
	c.external_account_id = b.external_account_id

update
        #overview_output
set
        client_blotter_login = d.login
from
        client_login_configs a,
        client_transfer_details b, 
        #overview_output c,
        tico_accounts d
where
        a.id = b.client_login_config_id
and
        a.tico_account_id = d.account_id
and
        c.external_account_id = b.external_account_id

update
	#overview_output
set
	notification_alias = b.symbol
from
	#overview_output a,
	external_account_symbols b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @agency_client_source_id



insert into 
	#meta
values(
	"Column Link",
	"manage_distribution_lists",
	"Manage Distribution Lists",
	NULL
)
/*
insert into 
	#meta
values(
	"Column Link",
	"manage_transfer_details",
	"Manage Transfer Details",
	NULL
)
*/

/*
insert into
	#meta
values(
	"Column Link",
	"set_transfer_protocol",
	"Set Transfer Protocol For Account",
	NULL
	)
*/
insert into
        #meta
values(
        "Column Link",
        "set_distribution_list", 
        "Set Dist List For Account",    
        NULL
        )

insert into
        #meta
values(
        "Column Link",
        "set_client_blotter_login",
        "Set Blotter Login For Account",
        NULL
        )

insert into
        #meta
values( 
        "Column Link",
        "manage_contract_spreads", 
        "Manage Default Account Spreads",
        NULL
        )

insert into
        #meta
values(
        "Column Link",
        "set_notification_alias",
	"Set Client Notification Symbol",
        NULL
        )



select
	"<h1>Live Notification Clients<h1>"

select * from #meta
select 
	external_account,
	transfer_protocol,
	distribution_list,
        client_blotter_login,
	notification_alias,
	set_transfer_protocol,
	set_distribution_list,
	set_client_blotter_login,
	set_notification_alias
from
	#overview_output
where
	status = 'Live'
order by
	external_account_type,
	external_account

select
        "<h1>Unconfigured Clients<h1>", "Note: Notifications require that a distrubition list and client blotter login be configured. If an account does not show 'Live' after both are configured, please contact support@elysiumtechgroup.com"

select
        external_account,
        transfer_protocol,
        distribution_list,
        client_blotter_login,
        notification_alias,
        set_transfer_protocol,
        set_distribution_list,
        set_client_blotter_login,
        set_notification_alias
from
        #overview_output
where
        status = NULL
order by
        external_account_type,
        external_account

	
select
	"manage_distribution_lists" = "Manage Distribution Lists",
	"manage_contract_spreads" = "Manage Contract Spreads",
	"manage_transfer_details" = "Manage Transfer Details"
	

go

