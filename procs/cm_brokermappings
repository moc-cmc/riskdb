
if object_id("cm_brokermappings") != NULL
    drop procedure
        cm_brokermappings
go

create procedure
	cm_brokermappings
		@login varchar(50),
		@broker varchar(50)
as

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"del_mapping",
	"Delete Broker Mapping",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"add_mapping",
	"Add Broker Mapping",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"edit_mapping",
	"Edit Broker Mapping",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	add_mapping = "Add Mapping",
	broker = @broker


select
	broker = a.symbol,
	source = b.name,
	mapping = c.symbol,
	edit_mapping = "EDIT",
	del_mapping = "DELETE"
from
	brokers a,
	sources b,
	broker_symbols c
where
	a.broker_id = c.broker_id
and
	b.source_id = c.source_id
and
	a.symbol = @broker
order by
	b.name,
	a.symbol


go
