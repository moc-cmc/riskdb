drop procedure
	cbo_savefutrealized
go

create procedure
	cbo_savefutrealized
		@login varchar(50),
		@trade_date datetime=NULL
as

declare @begin_date datetime
declare @end_date datetime
declare @transaction_date datetime
declare @tico_account_id int
declare @account varchar(50)
declare @product varchar(50)
declare @contract varchar(50)
declare @account_transaction_id int
declare @note varchar(100)
declare @identifier varchar(100)
declare @amount float

declare @id int
declare @ids int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@trade_date = convert(datetime, convert(date, @trade_date))

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

select
	@transaction_date = convert(datetime, convert(date, @end_date))


create table
	#ledgers(
		id int identity,
		account varchar(50) NULL,
		external_account_id int NULL,
		contract_id int NULL,
		contract varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		realized_pl float NULL)
insert into
	#ledgers(
		external_account_id,
		contract_id,
		product_id,
		realized_pl)
select
	a.external_account_id,
	a.contract_id,
	a.currency_id,
	sum(a.realized_pl)
from
	round_turns a
where
	a.trade_date = @trade_date
group by
	a.external_account_id,
	a.contract_id,
	a.currency_id

update
	#ledgers
set
	a.account = b.symbol
from
	#ledgers a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#ledgers
set
	a.contract = b.symbol
from
	#ledgers a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#ledgers
set
	a.product = b.symbol
from
	#ledgers a,
	products b
where
	a.product_id = b.product_id



select
	@id = 0
select
	@ids = count(*)
from
	#ledgers
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ledgers
	where
		id > @id

	select
		@account_transaction_id = NULL,
		@account = NULL,
		@product = NULL,
		@contract = NULL,
		@note = NULL,
		@identifier = NULL,
		@amount = NULL

	select
		@account = account,
		@product = product,
		@contract = contract,
		@amount = realized_pl
	from
		#ledgers
	where
		id = @id

	select
		@note = @contract

	select
		@identifier = rtrim(@account) + rtrim(@contract) + convert(varchar(11), @trade_date)

	select * from #ledgers where id = @id
        exec
                api_addaccounttransaction
                        @login = @login,
                        @account = @account,
                        @transaction_type = "Realized P&L",
                        @amount = @amount,
                        @product = @product,
                        @date = @trade_date,
                        @note = @note,
                        @identifier = @identifier,
                        @source = "MPT",
                        @account_transaction_id = @account_transaction_id output

	select
		@ids = count(*)
	from
		#ledgers
	where
		id > @id
end



go
