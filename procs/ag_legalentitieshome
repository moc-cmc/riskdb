create table
	#legal_entities(
		legal_entity_id int,
		name varchar(255),
		lei varchar(100) NULL,
		approval_count int NULL,
		approve_setup varchar(10) NULL,
		status_id int NULL,
		status varchar(50) NULL,
		section varchar(50) NULL,
		add_outside_account varchar(50) NULL,
		add_bo_account varchar(50) NULL,
		add_users varchar(50) NULL,
		add_client_user varchar(50) NULL,
		style varchar(50) NULL)

insert into
	#legal_entities(
		legal_entity_id,
		name,
		lei,
		approve_setup,
		status_id,
		section,
		style)
select
	legal_entity_id,
	name,
	lei,
	NULL,
	status_id,	
	section = "Legal Entities",
	style = @style
from
	legal_entities
order by
	name


update
	#legal_entities
set
	status = b.name
from
	#legal_entities a,
	statuses b
where
	a.status_id = b.status_id


update
	#legal_entities
set
	style = @selected_style,
	approve_setup = "Approve",
        add_outside_account = "Add Outside Account",
        add_bo_account = "Add BO Account",
        add_users = "Add Internal Users",
        add_client_user = "Add Client User"
where
	name = @legal_entity

create table
	#le_approvals(
		legal_entity_id int,
		approval_count int NULL
)
insert into
	#le_approvals(
		legal_entity_id,
		approval_count)
select
	legal_entity_id,
	count(*)
from
	legal_entity_approvals
group by
	legal_entity_id

update
        #legal_entities
set
        approval_count = b.approval_count
from
        #legal_entities a,
        #le_approvals b
where
	a.legal_entity_id = b.legal_entity_id

update
	#legal_entities
set
	approve_setup = NULL
where
	status = "Approved"


select
	section,
	style,
	legal_entity = name,
	entity = name,
	view_entity = "VIEW",
	approval_count = approval_count,
	approve_setup = approve_setup,
	status = status,
	lei = lei,
	add_outside_account = add_outside_account,
        add_bo_account = add_bo_account,
	add_users = add_users,
	add_client_user = add_client_user
from
	#legal_entities


if @legal_entity_id = NULL
begin
	/* 
         * EXIT THE PROC SINCE WE DO NOT NEED TO SHOW ANY DETAIL
         * ---------------------------------------------------------*/
	return
end


