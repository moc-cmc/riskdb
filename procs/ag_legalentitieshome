insert into
        #account_output(
                ordering,
                bo_master_account_id,
                master_account,
		sub_account_id,
		sub_account_symbol,
		sub_account_name,
		edit_account,
                style)
select
        ordering = 2,
        bo_master_account_id = c.bo_master_account_id,
	master_account = d.symbol,
	sub_account_id = a.fo_sub_account_id,
        sub_account_symbol = b.symbol,
        sub_account_name = b.name,
	"Edit Sub Account",
        @subtotal_style
from
	fo_sub_accounts a,
	external_accounts b,
	bo_master_accounts c,
	external_accounts d
where
	a.external_account_id = b.external_account_id
and
	a.bo_master_account_id = c.bo_master_account_id
and
	c.external_account_id = d.external_account_id
and
	c.legal_entity_id = @legal_entity_id




	
	
select
	@default_user_pool = a.name
from
	cognito_user_pools a,
	cognito_settings b
where
	a.cognito_user_pool_id = b.default_user_pool_id

create table
	#le_users(
		legal_entity_id int,
		tico_account_id int,
		first_name varchar(50),
		last_name varchar(50),
		user_name varchar(100),
		email varchar(100) NULL,
		phone varchar(100) NULL,
		mfa_type_id int NULL,
		mfa_type varchar(25) NULL,
		trader_id int NULL,
		trader_name varchar(50) NULL,
		login_status varchar(50) NULL,
		status varchar(50) NULL,
		enable_login varchar(50) NULL,
		disable_login varchar(50) NULL,
		create_date datetime NULL,
		last_updated datetime NULL,
		create_trader varchar(25) NULL,
		bo_access varchar(10) NULL,
		bo_readonly varchar(10) NULL,
		fo_access varchar(10) NULL,
		fo_readonly varchar(10) NULL,
		section varchar(50) NULL
)

insert into 
	#le_users
select
	a.legal_entity_id,
	c.account_id,	
	c.given_names,
	c.surname,
	c.login,
	email = NULL,
	phone = NULL,
	mfa_type_id = NULL,
	mfa_type = NULL,
	trader_id = NULL,
	trader_name = NULL,
	login_status = "Pending",
	status = NULL,
	enable_login = "ENABLE ACCESS",
	disable_login = NULL,
	create_date = NULL,
	last_updated = NULL,
	create_trader = "Create Trader",
	bo_access = "-",
	bo_readonly = "-",
	fo_access = NULL, /* null since fo access requires trader, will set to - later */
	fo_readonly = "-",
	section = "Client Users"
from
	legal_entities a,
	legal_entity_tico_accounts b,
	tico_accounts c,
	tico_account_types d,
	login_types e
where
	a.legal_entity_id = b.legal_entity_id
and
	b.tico_account_id = c.account_id
and
	a.legal_entity_id = @legal_entity_id 
and
	c.account_id = d.tico_account_id
and
	d.login_type_id = e.login_type_id
and
	e.name = "Client"

update
	#le_users
set
	trader_id =  b.trader_id,
	trader_name = b.symbol,
	create_trader = NULL,
	fo_access = "-"
from
	#le_users a,
	traders b
where
	a.tico_account_id = b.tico_account_id

delete 
	#le_users
from
	#le_users a,
	traders b
where
	a.first_name = b.symbol

update 
	#le_users
set
	bo_access = "Yes"
from
	#le_users a,
	access_group_accounts b,
	access_groups c
where
	a.tico_account_id = b.tico_account_id
and
	b.access_group_id = c.access_group_id
and
	c.name = "Client Back Office"

update 
        #le_users
set
        bo_readonly = "Yes"
from
        #le_users a,
        access_group_accounts b,
        access_groups c
where
        a.tico_account_id = b.tico_account_id
and
        b.access_group_id = c.access_group_id
and
        c.name = "Client Back Office Read Only"

update 
        #le_users
set
        fo_access = "Yes"
from
        #le_users a,
        access_group_accounts b,
        access_groups c
where
        a.tico_account_id = b.tico_account_id
and
        b.access_group_id = c.access_group_id
and
        c.name = "Client Front Office"

update
        #le_users
set
        fo_readonly = "Yes"
from
        #le_users a,
        access_group_accounts b,
        access_groups c
where
        a.tico_account_id = b.tico_account_id
and
        b.access_group_id = c.access_group_id
and
        c.name = "Client Front Office Read Only"



	

insert into
        #le_users
select
        a.legal_entity_id,
        c.account_id,
        c.given_names,
        c.surname,
        c.login,
	email = NULL,
	phone = NULL,
	mfa_type_id = NULL,
	mfa_type = NULL,
	trader_id =  NULL,
	trader_name =  NULL,
        login_status = "Pending",
	status = NULL,
        enable_login = "ENABLE ACCESS",
        disable_login = NULL,
        create_date = NULL,
        last_updated = NULL,
	create_trader = NULL,
        bo_access = NULL,
        bo_readonly = NULL,
        fo_access = NULL,
        fo_readonly = NULL,
        section = "Internal Users"
from
        legal_entities a,
        legal_entity_tico_accounts b,
        tico_accounts c,
        tico_account_types d,
        login_types e
where
        a.legal_entity_id = b.legal_entity_id
and
        b.tico_account_id = c.account_id
and
        a.legal_entity_id = @legal_entity_id
and
        c.account_id = d.tico_account_id
and
        d.login_type_id = e.login_type_id
and
        e.name = "Standard"


update
	#le_users
set
	email = a.email
from
	emails a,
	user_emails b,
	#le_users c
where
	a.email_id = b.email_id
and
	b.tico_account_id = c.tico_account_id


update
	#le_users
set
	login_status = c.name,
	status = d.name,
	phone = b.phone_number,
	create_date = b.create_date,
	last_updated = b.last_modify_date,
	mfa_type_id = b.mfa_type_id
from
	#le_users a,
	cognito_users b,
	cognito_user_statuses c,
	statuses d
where
	a.tico_account_id = b.tico_account_id
and
	b.cognito_user_status_id = c.cognito_user_status_id
and
	b.status_id = d.status_id

update
	#le_users
set
	mfa_type = b.name
from
	#le_users a,
	mfa_types b
where
	a.mfa_type_id = b.mfa_type_id

	
update
	#le_users
set
	disable_login = "DISABLE ACCESS"
from
	#le_users a,
	cognito_users b,
	cognito_user_statuses c,
	statuses d
where
	a.tico_account_id = b.tico_account_id
and
	b.cognito_user_status_id = c.cognito_user_status_id
and
	b.status_id = d.status_id
and
	d.name not in("User Review", "Submitted")

if @legal_entity_status != "Approved"
begin
	update
		#le_users
	set
		enable_login = NULL,
		disable_login = NULL
end


insert into
        #account_output(
                ordering,
                bo_master_account_id,
                master_account,
                sub_account_id,
		sub_account_symbol,
		trader_id,
                trader,
                add_trader,
                style)
select
        ordering = 3,
        bo_master_account_id = c.bo_master_account_id,
        master_account = d.symbol,
        sub_account_id = a.fo_sub_account_id,
	sub_account_symbol = b.symbol,
	trader_id = e.trader_id,
        trader = e.symbol,
        "Add Trader",
        @grey_style
from
        fo_sub_accounts a,
        external_accounts b,
        bo_master_accounts c,
        external_accounts d,
        traders e,
        #le_users f
where
        a.external_account_id = b.external_account_id
and
        a.bo_master_account_id = c.bo_master_account_id
and
        c.external_account_id = d.external_account_id
/*
and
        b.external_account_id = f.external_account_id - no join, show all traders for each sub account 
*/
and
        f.trader_id = e.trader_id
and
        c.legal_entity_id = @legal_entity_id

update
	#account_output
set
	add_trader = NULL,
	remove_trader= "Remove Trader",
	style = @style
from
	#account_output a,
        fo_sub_accounts b,
	external_account_traders c
where
	a.sub_account_id = b.fo_sub_account_id
and
	b.external_account_id = c.external_account_id
and
	a.trader_id = c.trader_id


create table
	#legal_entity_otc_links(
		ordering int,
		legal_entity varchar(150),
		legal_entity_otc_link_id int NULL,
		entering_legal_entity_id int NULL,
		available_legal_entity_id int NULL,
		available_legal_entity varchar(150) NULL,
		manage_otc_whitelist varchar(25) NULL,
		remove_access varchar(25) NULL,
		style varchar(255) NULL
)

if @legal_entity != NULL
begin
	insert into
		#legal_entity_otc_links(
			ordering,
			legal_entity,
			manage_otc_whitelist,
			style)
	values(
		1,
		@legal_entity,
		"Manage Whitelist",
		@total_style
	)

end

insert into
	#legal_entity_otc_links(
		ordering,
		legal_entity,
		legal_entity_otc_link_id,
		entering_legal_entity_id,
		available_legal_entity_id,
		available_legal_entity,
		manage_otc_whitelist,
		remove_access,
		style)
select
	2,
	@legal_entity,
	a.legal_entity_otc_link_id,
	a.entering_legal_entity_id,
	a.available_legal_entity_id,
	b.name,
	NULL,
	"Remove",
	@style
from
	legal_entity_otc_links a,
	legal_entities b,
	legal_entities c
where
	a.entering_legal_entity_id = c.legal_entity_id
and
	a.available_legal_entity_id = b.legal_entity_id
and
	c.name = @legal_entity
	
	
	

select
	section = "Account Overview",
	ordering,
	master_account,
	bo_master_account = master_account_symbol,
	master_account_name = master_account_name,
	symbol = master_account_symbol,
	name = master_account_name,
	sub_account_symbol,
	sub_account_name,
	trader,
	add_fo_sub_account,
	add_trader,
	remove_trader,
	edit_account,
	style,
	account = sub_account_symbol,
	legal_entity = @legal_entity
from
	#account_output
order by 
	master_account,
	account,
	ordering,
	trader



