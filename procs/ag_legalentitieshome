	1,
	a.bo_master_account_id,
	b.symbol,
	b.symbol,
	b.name,
	c.name,
	"Add FO Sub Account",
	"Edit Master Account",
	@total_style
from
	bo_master_accounts a,
	external_accounts b,
	legal_entities c
where
	a.external_account_id =  b.external_account_id
and
	a.legal_entity_id = c.legal_entity_id
and
	c.legal_entity_id = @legal_entity_id

	
	
