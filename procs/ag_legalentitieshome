	style = @style,
	section,
	legal_entity = @legal_entity,
	first_name,
	last_name,
	user_name,
	email,
	phone,
	mfa_type,
	trader_name,
	bo_access,
	bo_readonly,
	fo_access,
	fo_readonly,
	login_status,
/*
	enable_login,
	disable_login,
	create_date,	
	last_updated,
*/
	create_trader,
	/*permissions = "VIEW",*/
	mfa_login = user_name,
	mfa_phone_number = phone,
	user_pool = @default_user_pool
from
	#le_users
where
	section = "Client Users"
order by
	section,
	last_name,
	first_name


select
	style = style,
	section = "OTC Whitelist",
	legal_entity = legal_entity,
	entering_legal_entity = legal_entity,
	available_legal_entity = available_legal_entity,
	remove_legal_entity = available_legal_entity,
	manage_otc_whitelist,
	whitelisted_legal_entity = available_legal_entity,
	"remove_otc_access" = remove_access
from
	#legal_entity_otc_links 
order by
	ordering,
	available_legal_entity


select
        style = @style,
        section,
        legal_entity = @legal_entity,
        first_name,
        last_name,
        user_name,
        email,
        phone,
	mfa_type,
        login_status,
        mfa_login = user_name,
        mfa_phone_number = phone,
        user_pool = @default_user_pool
from
        #le_users
where
        section != "Client Users"
order by
        section,
        last_name,
        first_name

select
	style = @style,
	section = "Approval Log",
	b.approved_at,
        user_name = a.login,
        first_name = a.given_names,
	last_name = a.surname
from
	tico_accounts a,
	legal_entity_approvals b
where
	a.account_id = b.tico_account_id
and	
	b.legal_entity_id = @legal_entity_id


go
