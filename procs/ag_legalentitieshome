		ordering int,
		bo_master_account_id int,
		master_account varchar(100),
		master_account_symbol varchar(100) NULL,
		master_account_name varchar(100) NULL,
		legal_entity varchar(100) NULL,
		sub_account_id int NULL,
		sub_account_symbol varchar(100) NULL,
		sub_account_name varchar(100) NULL,
		trader_id int NULL,
		trader varchar(100) NULL,
		add_fo_sub_account varchar(25) NULL,
		add_trader varchar(25) NULL,
                remove_trader varchar(25) NULL,
		edit_account varchar(25) NULL,
		style varchar(255) NULL
)

insert into
	#account_output(
		ordering,
		bo_master_account_id,
		master_account,
		master_account_symbol,
		master_account_name,
		legal_entity,
		add_fo_sub_account,
		edit_account,
		style)
