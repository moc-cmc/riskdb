drop procedure r_checkaccessgrouppermission
go

create procedure
	r_checkaccessgrouppermission
		@login varchar(50),
		@access_group varchar(50),
                @has_permission char(1) output,
		@show_perm_denied char(1)=NULL

as

declare @tico_account_id int
declare @access_group_id int

select
    @has_permission = "N"

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login

select
	@access_group_id = access_group_id
from
	access_groups
where
	name = @access_group
if @access_group_id = NULL
begin
    select
        status = "Error",
        message = "Access group does not exist",
	access_group = @access_group
    return
end

select
    @has_permission = "Y"
from
    access_groups a,
    access_group_accounts b
where
    a.access_group_id = b.access_group_id
and
    a.name = @access_group
and
    b.tico_account_id = @tico_account_id
    

if @has_permission != "Y"
begin
    
	if(@show_perm_denied != "N")
	begin
		select
        		status = "Error",
        		message = "<b>Permission Denied</b>" + " - User must be configured as '"+rtrim(@access_group)+"' to view report"
    		return
	end	
end


go
