create procedure
	cbo_runtradesfile
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as


declare @start_date datetime
declare @stop_date datetime
declare @evaluation_currency_id int
declare @source_id int
declare @run_id int
declare @fund_id int
declare @evaluation_currency varchar(20)
declare @source varchar(30)


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
