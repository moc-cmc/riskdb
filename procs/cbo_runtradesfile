create table
	#deals(
		deal_id int,
		quantity numeric(30,4))

create table
	#trades(
		deal_id int NULL,
		trade_id int NULL,
		trade_date datetime NULL,
		bo_trade_date datetime NULL,
		external_account_id int NULL,
		contract_id int NULL,
		quantity numeric(30,4) NULL,
		expiration datetime NULL,
		price float NULL,
		settle_price float NULL,
		premium float NULL,
		premium_currency varchar(50) NULL,
		prem_val_date datetime NULL,
		trader varchar(50) NULL,
		sales_code varchar(50) NULL,
		counterparty_id int NULL,
		broker_id int NULL,
		volume float NULL,
		trade_pl float NULL,
		deal_pl float NULL)
		

insert into
	#deals(
		deal_id,
		quantity)
select
	b.deal_id,
	sum(b.quantity)
from
	committed_daily_revals a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.broker_id = g.broker_id
and
	a.value_date >= @start_date
and
	a.bo_trade_date >= @start_date
and
	a.bo_trade_date < @stop_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
group by
	b.deal_id

/*
 * Find any trades that were done during the range
 */
insert into
	#trades(
		trade_id,
		expiration,
		settle_price,
		premium,
		volume,
		trade_pl)
select
	b.trade_id,
	a.value_date,
	a.close_price,
	a.premium,
	a.evaluation_notional,
	a.unrealized_pl_to_date + a.realized_pl_to_date
from
	committed_daily_revals a,
	trades b,
	#deals c
where
	a.trade_id = b.trade_id
and
	b.deal_id = c.deal_id
and
	a.value_date >= @start_date
and
	a.bo_trade_date >= @start_date
and
	a.bo_trade_date < @stop_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id


update
	#trades
set
	a.deal_id = b.deal_id,
	a.trade_date = b.trade_date,
	a.external_account_id = b.external_account_id,
	a.contract_id = b.contract_id,
	a.quantity = b.quantity,
	a.price = b.price,
	a.counterparty_id = b.counterparty_id,
	a.broker_id = b.broker_id
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id


update
	#trades
set
	a.expiration = b.value_date,
	a.settle_price = b.close_price,
	a.premium = b.premium,
	a.volume = abs(b.evaluation_notional),
	a.bo_trade_date = b.bo_trade_date
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.reval_date = @stop_date


update
	#trades
set
	a.expiration = b.value_date
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id

update
	#trades
set
	a.premium_currency = d.symbol,
	a.prem_val_date = c.transaction_date
from
	#trades a,
	account_transaction_trades b,
	account_transactions c,
	products d
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.currency_id = d.product_id

update
	#trades
set
	a.trader = c.symbol
from
	#trades a,
	trades b,
	traders c
where
	a.trade_id = b.trade_id
and
	b.trader_id = c.trader_id

update
	#trades
set
	a.sales_code = c.name
from
	#trades a,
	trades b,
	sales_codes c
where
	a.trade_id = b.trade_id
and
	b.sales_code_id = c.sales_code_id

create table
	#deal_pl(
		deal_id int,
		p_l float NULL)

insert into
	#deal_pl
select
	deal_id,
	sum(trade_pl)
from
	#trades
group by
	deal_id

update
	#trades
set
	a.deal_pl = b.p_l
from
	#trades a,
	#deal_pl b
where
	a.deal_id = b.deal_id

select
	a.deal_id,
	a.trade_id,
	trade_date = convert(varchar(22), a.trade_date, 0),
	bo_trade_date = convert(varchar(11), a.bo_trade_date, 1),
	account = b.symbol,
	a.trader,
	a.sales_code,
	c.symbol,
	value_date = convert(varchar(11), a.expiration, 1),
	a.quantity,
	a.price,
	a.settle_price,
	a.premium,
	a.premium_currency,
	prem_val_date = convert(varchar(11), a.prem_val_date, 1),
	counterparty = d.name,
	broker = e.symbol,
	a.volume,
	a.trade_pl,
	a.deal_pl
from
	#trades a,
	external_accounts b,
	contracts c,
	counterparties d,
	brokers e
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.counterparty_id = d.counterparty_id
and
	a.broker_id = e.broker_id
order by
	a.deal_id
	
select
	msg = "Total Trades P&L",
	trade_pl = sum(trade_pl)
from
	#trades


go
