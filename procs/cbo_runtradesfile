	#links
values(
	"Format Number",
	"price",
	NULL,
	NULL,
	"#,##0.000000")

insert into
	#links
values(
	"Format Number",
	"settle_price",
	NULL,
	NULL,
	"#,##0.000000")
--Adaptive Server has expanded all '*' elements in the following statement



select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end


