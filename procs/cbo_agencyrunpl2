	a.external_account_id = c.external_account_id
and
	a.internal_account_id = d.internal_account_id
and
	a.trader_id = e.trader_id
and
	a.strategy_id = f.strategy_id
and
	a.broker_id = g.broker_id
and
	a.counterparty_id = h.counterparty_id
and
	a.counterparty_id = i.counterparty_id
and
    a.quantity != 0
and
	a.trade_date < @end_date
