/* MARK: CREATE #deal_pls */
create table
    #deal_pls (
        deal_id int,
        perspective_contract_id int,
        delta float null,
        net_delta float null,
        realized_pl float,
        unrealized_pl float,
        trade_count int
    )

/* MARK: INSERT #deal_pls: all deals */
insert into
    #deal_pls (
        deal_id,
        perspective_contract_id,
        delta,
        net_delta,
        realized_pl,
        unrealized_pl,
        trade_count
    )
select
    a.deal_id,
    b.perspective_contract_id,
    delta = sum(abs(a.forward_delta * b.delta_conversion)),
    net_delta = sum(a.forward_delta * b.delta_conversion),
    realized_pl = sum(a.realized_range_pl),
    unrealized_pl = sum(a.unrealized_range_pl),
    trade_count = count(*)
from
    #trades_data a,
    #contracts b
where
    a.contract_id = b.contract_id
group by
    a.deal_id,
    b.perspective_contract_id

