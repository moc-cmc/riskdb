    )
select
    a.trade_id,
    a.deal_id,
    in_run = "Y",
    i.type,
    a.external_account_id,
    a.broker_id,
    a.sales_code_id,
    a.counterparty_id,
    a.trade_date,
    bo_trade_date = convert(date, case datepart(weekday, dateadd(hour, 7, a.trade_date))
        when 7 then
            dateadd(day, 2, dateadd(hour, 7, a.trade_date))
        when 1 then 
            dateadd(day, 1, dateadd(hour, 7, a.trade_date))
