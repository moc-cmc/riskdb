/*+---------------------------------------------------------------------------* 
 |               MARK: | Calculate Trade+Revals, Contracts Info               | 
 *----------------------------------------------------------------------------*/

/*
 * Collect 4 sets of trades:
 *                            td    vd    
 *            b       e       bd ed bd ed 
 *      . . . | . . . | . . . -- -- -- -- 
 *  A.  [   ] |       |       .  .  <  .    ignore
 *  B.    [   <-->]   |       <  .  >= <    ( begin_date, value_date )
 *  C.      [ <-------> ]     <  .  .  >=   ( begin_date, end_date )
 *  D.        | [<->] |       >= <  >= <    ( trade_date, value_date )
 *  E.        |   [<-->   ]   >= <  .  >=   ( trade_date, end_date ) 
 *  F.        |       | [   ] .  >= .  .    ignore
 */


/* MARK: CREATE #trades_data */
create table
	#trades_data (
		trade_id int,
		deal_id int,
		external_account_id int,
		broker_id int,
		sales_code_id int,
		counterparty_id int,
		trade_date datetime null,
        bo_trade_date date null,
		contract_id int,
		value_date datetime null,
        bo_value_date date null,
        forward_id int null,
        forward_delta float null,
		total_premium float null,
		premium_settle_date datetime null,
        begin_date datetime null,
        end_date datetime null,
		begin_realized_pl_to_date float null,
		end_realized_pl_to_date float null,
		begin_unrealized_pl_to_date float null,
		end_unrealized_pl_to_date float null,
		realized_range_pl float null,
		unrealized_range_pl float null,
		native_value float null,
		end_evaluation_value float null,
		settle_price float null,
		volume float null,
		trade_day_pl float null,
		trades_pl float null,
		position_pl float null,
		total_pl float null
    )

/*
 * MARK: INSERT #trades_data: (B,C,D,E)
 */
insert
    #trades_data (
        trade_id,
        deal_id,
        external_account_id,
        broker_id,
        sales_code_id,
        counterparty_id,
        trade_date,
        bo_trade_date,
        contract_id,
        value_date,
        bo_value_date,
        forward_id,
        forward_delta,
        total_premium,
        premium_settle_date,
        begin_date,
        begin_realized_pl_to_date,
        begin_unrealized_pl_to_date,
        end_date,
        end_realized_pl_to_date,
        end_unrealized_pl_to_date,
        realized_range_pl,
        unrealized_range_pl,
        native_value,
        end_evaluation_value,
        settle_price
    )
select
    a.trade_id,
    a.deal_id,
    a.external_account_id,
    a.broker_id,
    a.sales_code_id,
    a.counterparty_id,
    a.trade_date,
    a.bo_trade_date,
    a.contract_id,
    a.value_date,
    a.bo_value_date,
    b.forward_id,
    forward_delta = b.delta,
    b.premium,
    b.premium_settle_date,
    begin_date = b.reval_date,
    begin_realized_pl_to_date = case
        when b.reval_date = a.bo_trade_date then 0
        else b.realized_pl_to_date
    end,
    begin_unrealized_pl_to_date = case
        when b.reval_date = a.bo_trade_date then 0
        else b.unrealized_pl_to_date
    end,
    end_date = c.reval_date,
    end_realized_pl_to_date = c.realized_pl_to_date,
    end_unrealized_pl_to_date = c.unrealized_pl_to_date,
    realized_range_pl = case
        when b.reval_date = a.bo_trade_date then c.realized_pl_to_date
        else c.realized_pl_to_date - b.realized_pl_to_date
    end,
    unrealized_range_pl = case
        when b.reval_date = a.bo_trade_date then c.unrealized_pl_to_date
        else c.unrealized_pl_to_date - b.unrealized_pl_to_date
    end,
    c.native_value,
    c.evaluation_value,
    c.close_price
from
    #trades a,
    #daily_revals b,
    #daily_revals c
where
    a.trade_id = b.trade_id
and
    b.reval_date in (a.bo_trade_date, @begin_day)
and
    a.trade_id = c.trade_id
and
    c.reval_date in (a.bo_value_date, @end_day)

insert into #benchmarks select "Find P&L", @bench_start, getdate(), @@rowcount select @bench_start = getdate()

