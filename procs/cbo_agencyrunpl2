/* MARK: CREATE #trade_pls */
create table
    #trade_pls (
        trade_id int,
        deal_id int,
        perspective_contract_id int,
        delta float,
        delta_pct float,
        realized_pl float,
        unrealized_pl float
    )

/* MARK: INSERT #trade_pls: all trades */
insert into
    #trade_pls (
        trade_id,
        deal_id,
        perspective_contract_id,
        delta,
        delta_pct,
        realized_pl,
        unrealized_pl
    )
select
    a.trade_id,
    a.deal_id,
    b.perspective_contract_id,
    delta = abs(a.forward_delta) * b.delta_conversion,
    delta_pct = abs(a.forward_delta) * b.delta_conversion / c.delta,
    realized_pl = c.realized_pl * abs(a.forward_delta) * b.delta_conversion / c.delta,
    unrealized_pl = c.unrealized_pl * abs(a.forward_delta) * b.delta_conversion / c.delta
from
    #trades_data a,
    #contracts b,
    #deal_pls c,
    #counterparty_types d
where
    a.contract_id = b.contract_id
and
    a.deal_id = c.deal_id
and
    b.perspective_contract_id = c.perspective_contract_id
and
    a.counterparty_id = d.counterparty_id

