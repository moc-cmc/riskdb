        source_id,
        status_id,
        contract_id,
        contract_qty,
        forward_id,
        value_date,
        reval_date,
        close_price,
        native_value,
        delta,
        gamma,
        theta,
        tau,
        native_currency_id,
        product_id,
        evaluation_currency_id,
        evaluation_value,
        price_change_to_date,
        native_realized_pl_to_date,
        native_unrealized_pl_to_date,
        realized_pl_to_date,
        unrealized_pl_to_date,
        premium_ccy_id,
        premium,
        evaluation_premium,
        premium_settle_date,
        notional_amount,
        evaluation_notional
    )
select
    b.trade_id,
    b.bo_trade_date,
    b.source_id,
    b.status_id,
    b.contract_id,
    b.contract_qty,
    b.forward_id,
    b.value_date,
    reval_date = convert(date, b.reval_date),
    b.close_price,
    b.native_value,
    b.delta,
    b.gamma,
    b.theta,
    b.tau,
    b.native_currency_id,
