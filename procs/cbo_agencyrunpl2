go

/* cbo_agencyrunpl2 "markr", "Cantor", "5/1/2011", "5/31/2011" */

create procedure
    cbo_agencyrunpl2
		@login varchar(30),
		@run varchar(50),
		@begin_date datetime=null,
		@end_date datetime=null,
		@total_pl float=null output,
		@total_volume float=null output,
		@display_output varchar(10)=null
as

declare @bench_start datetime
declare @total_start datetime
select @total_start = getdate()

create table 
    #benchmarks (
        id int identity,
        name varchar(75),
        start_date datetime default getdate(),
        stop_date datetime null,
        row_count int null
    )

declare @fund_id int
declare @run_id int
declare @evaluation_currency_id int
declare @evaluation_currency varchar(10)
declare @source_id int
declare @source varchar(50)
declare @begin_day datetime
declare @end_day datetime

/* MARK: EXEC r_defaultfundforlogin */
exec
	r_defaultfundforlogin
		@login,
		@fund_id output

/* MARK: FIND @run_id */
select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run
	return
end

/* MARK: FIND @begin_date, @end_date */
if @begin_date = null
	select
		@begin_date = convert(datetime, convert(char(11), max(reval_date)))
	from
		trade_daily_revals

if @end_date = null
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output
    
    select
        @begin_day = convert(date, @end_date),
        @end_day = convert(date, @end_date)
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@begin_day output

	exec
		r_daterangefordate
			@end_date,
			null,
			@end_date output
    
    select
        @begin_day = convert(date, @begin_day),
        @end_day = convert(date, @end_date)
end

/* MARK: FIND @evaluation_currency_id, @source_id */
select
	@evaluation_currency_id = a.evaluation_currency_id,
    @evaluation_currency = b.symbol,
	@source_id = a.source_id,
    @source = c.name
from
	run_defaults a,
    products b,
    sources c
where
    a.evaluation_currency_id = b.product_id
and
    a.source_id = c.source_id
and
	a.run_id = @run_id
if @evaluation_currency_id = null
begin
	select
		@evaluation_currency_id = a.evaluation_currency_id,
        @evaluation_currency = b.symbol,
		@source_id = a.source_id,
        @source = c.name
	from
        fund_run_defaults a,
        products b,
        sources c
	where
        a.evaluation_currency_id = b.product_id
    and
        a.source_id = c.source_id
    and
		fund_id = @fund_id

	if @evaluation_currency_id = null
	begin
		select
			id = -1,
			error = "Unable to determine default run settings"
		return
	end
end

select
    run = @run,
    source = @source,
    evaluation_currency = @evaluation_currency,
    begin_day = @begin_day,
    begin_date = @begin_date,
    end_day = @end_day,
    end_date = @end_date
    

