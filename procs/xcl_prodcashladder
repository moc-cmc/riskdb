	#value_dates
select
	distinct(value_date)
from
	#give_products
insert into
	#value_dates
select
	distinct(value_date)
from
	#get_products
where
	value_date not in(
		select
			value_date
		from
			#value_dates)

create table
	#biproduct_view(
		currency_id int,
		amount float,
		counter_currency_id int,
		counter_amount float)

select
	@product_id = 0,
	@ladder_id = 0
select
	@products = count(*)
from
	#products
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#products
	where
		product_id > @product_id

	select
		@value_date = "8/8/88"
	select
		@value_dates = count(*)
	from
		#value_dates
	where
		value_date > @value_date
	
	while @value_dates > 0
	begin
		select
			@value_date = min(value_date)
		from
			#value_dates
		where
			value_date > @value_date

		select
			@get_product_qty = NULL,
			@give_product_qty = NULL,
			@exposure = NULL,
			@usd_equiv = NULL
	
		select
			@symbol = symbol
		from
			products
		where
			product_id = @product_id

		select
			@get_product_qty = quantity
		from
			#get_products
		where
			product_id = @product_id
		and
			value_date = @value_date
		if @get_product_qty = NULL
			select
				@get_product_qty = 0
	
		select
			@give_product_qty = quantity
		from
			#give_products
		where
			product_id = @product_id
		and
			value_date = @value_date
		if @give_product_qty = NULL
			select
				@give_product_qty = 0
	
		select
			@exposure = @give_product_qty + @get_product_qty
	
		exec
			r_dollaramount
				@product_id,
				@exposure,
				@end_date,
				@usd_equiv output
	
		select
			@ladder_id = @ladder_id + 100

		if @product_id != @usd_product_id
		begin
			select
				@conversion_forward_id = contract_id
			from
				forwards
			where
				product_id = @product_id
			and
				currency_id = @usd_product_id

			select
				@price_style = NULL
			select
				@price_style = a.name
			from
				price_styles a,
				contract_price_styles b
			where
				a.price_style_id = b.price_style_id
			and
				b.contract_id = @conversion_forward_id

			if @price_style = "Inverted"
			begin
				update
					#biproduct_view
				set
					amount = amount + (@usd_equiv * -1.0),
					counter_amount = counter_amount + @exposure
				where
					currency_id = @usd_product_id
				and
					counter_currency_id = @product_id
				if @@rowcount != 1
					insert into
						#biproduct_view
					values(
						@usd_product_id,
						@usd_equiv * -1.0,
						@product_id,
						@exposure)
			end
			else
			begin
				select
					product_id = @product_id,
					contract_id = @contract_id,
					exposure = @exposure,
					usd_equiv = @usd_equiv /* TEST */
				update
					#biproduct_view
				set
					amount = amount + @exposure,
					counter_amount = counter_amount + (@usd_equiv * -1.0)
				where
					currency_id = @product_id
				and
					counter_currency_id = @usd_product_id
				if @@rowcount != 1	
					insert into
						#biproduct_view
					values(
						@product_id,
						@exposure,
						@usd_product_id,
						@usd_equiv * -1.0)
			end

		end

		insert into
			#ladder
		values(
			@ladder_id,
			@product_id,
			@symbol,
			@exposure,
			@usd_equiv,
			@value_date)

		select
			@value_dates = count(*)
		from
			#value_dates
		where
			value_date > @value_date
	end

	select
		@products = count(*)
	from
		#products
	where
		product_id > @product_id
end

update
	#ladder
set
	usd_equiv = quantity
where
	product_id = 1


create table
	#output(
		ladder_id int,
		symbol char(50),
		value_date char(50) NULL,
		quantity numeric(30,2) NULL,
		usd_equiv numeric(30,2) NULL,
		ccy_subtotal numeric(30,2) NULL,
		ccy char(70) NULL,
		val_date char(11) NULL)


select
	@symbol = ""
select
	@symbols = count(*)
from
	#ladder
where
	symbol > @symbol


while @symbols > 0
begin
	select
		@symbol = min(symbol)
	from
		#ladder
	where
		symbol > @symbol

	insert into
		#output
	select
		b.ladder_id,
		a.symbol,
		value_date = convert(char(11), b.value_date, 0),
		b.quantity,
		NULL,
		NULL,
		NULL,
		val_date = convert(char(11), b.value_date, 0)
	from
		products a,
		#ladder b
	where
		a.product_id = b.product_id
	and
		b.symbol = @symbol
	order by
		convert(datetime, b.value_date)

	select
		@ladder_id = max(ladder_id)
	from
		#output

	select
		@ladder_id = @ladder_id + 10

	select
		@total_usd = sum(usd_equiv),
		@total = sum(quantity)
	from
		#ladder
	where
		symbol = @symbol

	insert into
		#output
	values(
		@ladder_id,
		"<font size=2><b>Total</b></font>",
		NULL,
		NULL,
		@total_usd,
		@total,
		"<font size=2><b>" + " (" + @symbol + ")</b></font>",
		NULL)


	select
		@symbols = count(*)
	from
		#ladder
	where
		symbol > @symbol
end


create table
	#biprod_output(
		amount float,
		currency char(30),
		counter_currency char(30),
		counter_amount float,
		implied_rate float NULL)
insert into
	#biprod_output
select
	b.amount,
	currency = "<div align=right>" + a.symbol + "</div>",
	counter_currency = c.symbol,
	b.counter_amount,
	NULL
from
	products a,
	#biproduct_view b,
	products c
where
	a.product_id = b.currency_id
and
	b.counter_currency_id = c.product_id

update
	#biprod_output
set
	implied_rate = abs(counter_amount) / abs(amount)
where
	amount != 0


--Adaptive Server has expanded all '*' elements in the following statement
select #biprod_output.amount, #biprod_output.currency, #biprod_output.counter_currency, #biprod_output.counter_amount, #biprod_output.implied_rate from #biprod_output order by currency, counter_currency

select
	symbol,
	value_date,
	quantity,
	ccy_subtotal,
	ccy,
	usd_equiv,
	val_date
from
	#output
where
	quantity != 0
or
	quantity = NULL

select
	@total_longs = sum(usd_equiv)
from
	#output
where
	usd_equiv > 0
select
	@total_shorts = sum(usd_equiv)
from
	#output
where
	usd_equiv < 0

select
	cash_balances = "CASH BALANCES",
	total_longs = @total_longs,
	total_shorts = @total_shorts



