create table
	#get_products(
		product_id int,
		quantity float,
		value_date datetime)

insert into
	#get_products
select
	a.product_id,
	sum(b.quantity),
	max(b.value_date)
from
	forwards a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#counterparties g
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.counterparty_id = g.counterparty_id
and
	b.trade_date <= @end_date
and
	b.value_date >= @begin_date
group by
	a.product_id,
	b.value_date


create table
	#give_products(
		product_id int,
		quantity float,
		value_date datetime)

insert into
	#give_products
select
	a.currency_id,
	sum(b.quantity * a.quantity * b.price * -1),
	max(b.value_date)
from
	forwards a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#counterparties g
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.counterparty_id = g.counterparty_id
and
	b.trade_date <= @end_date
and
	b.value_date >= @begin_date
group by
	a.currency_id,
	b.value_date

