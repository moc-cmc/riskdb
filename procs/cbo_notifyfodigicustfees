drop procedure cbo_notifyfodigicustfees
go


create procedure
	cbo_notifyfodigicustfees
		@login varchar(100),
		@trade_date datetime

as
declare @id int
declare @ids int
declare @account_transaction_id int
declare @entry_request_id int

create table
	#transactions(
		id int identity,
		account_transaction_id int
)
insert into
	#transactions
select
	a.account_transaction_id 
from
	account_transactions a,
        external_accounts b,
        fo_sub_accounts c,
        products d,
        transaction_types e
where
        a.external_account_id = b.external_account_id
and
        b.external_account_id = c.external_account_id
and
        a.currency_id = d.product_id
and
        a.transaction_type_id = e.transaction_type_id
and
        e.name = "Digital Custody Fee"
and
        a.transaction_date = convert(date, @trade_date)
order by
        a.account_transaction_id DESC


select
	@id = 0
select
	@ids = count(*)
from
	#transactions
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#transactions
	where
		id > @id

	select
		@account_transaction_id = NULL,
		@entry_request_id = NULL

	select
		@account_transaction_id = account_transaction_id
	from
		#transactions
	where
		id = @id
		
	exec
		api_addentryrequest
			@login=@login,
			@account_transaction_id = @account_transaction_id,
			@entry_request_id = @entry_request_id output
	
	if @entry_request_id = NULL
	begin
		select
			status = "Error",
			message = "Problem creating entry request for front office fee",
			account_transaction_id = @account_transaction_id	

		/* do not return */
	end
			
	select
		@ids = count(*)
	from
		#transactions
	where
		id > @id
end		


go
