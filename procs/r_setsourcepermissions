
if object_id("r_setsourcepermissions") != NULL
    drop procedure
        r_setsourcepermissions
go

create proc
	r_setsourcepermissions
        @source varchar(50),
        @autocreates_users char(1) = "Y",
        @autocreates_statuses char(1) = "Y",
        @autocreates_funds char(1) = "N",
        @autocreates_internal_accounts char(1) = "Y",
        @autocreates_external_accounts char(1) = "Y",
        @autocreates_traders char(1) = "Y",
        @autocreates_brokers char(1) = "Y",
        @autocreates_strategies char(1) = "Y",
        @autocreates_contracts char(1) = "Y",
        @autocreates_products char(1) = "Y",
        @autocreates_exchanges char(1) = "N"
as

declare @source_id int

select
    @source_id = source_id
from
    sources
where
    name = @source

if @source_id = NULL
begin
    select
        status = "Error",
        message = "No source found for name",
        source = @source
    raiserror 99999, "No source found"
    return
end

if not exists (select * from source_permissions where source_id = @source_id)
begin
    insert into
        source_permissions
    values (
        @source_id,
        @autocreates_users,
        @autocreates_statuses,
        @autocreates_funds,
        @autocreates_internal_accounts,
        @autocreates_external_accounts,
        @autocreates_traders,
        @autocreates_brokers,
        @autocreates_strategies,
        @autocreates_contracts,
        @autocreates_products,
        @autocreates_exchanges
    )
end
else
begin
    update
        source_permissions
    set
        autocreates_users = @autocreates_users,
        autocreates_statuses = @autocreates_statuses,
        autocreates_funds = @autocreates_funds,
        autocreates_internal_accounts = @autocreates_internal_accounts,
        autocreates_external_accounts = @autocreates_external_accounts,
        autocreates_traders = @autocreates_traders,
        autocreates_brokers = @autocreates_brokers,
        autocreates_strategies = @autocreates_strategies,
        autocreates_contracts = @autocreates_contracts,
        autocreates_products = @autocreates_products,
        autocreates_exchanges = @autocreates_exchanges
    where
        source_id = @source_id
end

go
