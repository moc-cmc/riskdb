use
	risk_edgewater_test
go

drop procedure
	ag_nettrades
go

create procedure
	ag_nettrades
		@login varchar(50),
		@trade_date datetime=NULL

as

declare @begin_date datetime
declare @end_date datetime

declare @id int
declare @ids int

declare @deal_id int
declare @trade_id int
declare @tico_account_id int
declare @agg_group_id int
declare @contract_id int
declare @value_date datetime
declare @quantity float
declare @price float
declare @tickets int
declare @avg_size float
declare @in_progress_status_id int
declare @in_progress int
declare @batch_id int

if @trade_date = NULL
	select
		@trade_date = getdate()

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

select
	@trade_date = convert(date, @end_date)

select
	@in_progress_status_id = status_id
from
	statuses
where
	name = "In Progress"
if @in_progress_status_id = NULL
begin
	exec
		j_nextkey
			"statuses",
			@in_progress_status_id output

	insert into
		statuses
	values(
		@in_progress_status_id,
		"In Progress")
end

select
        @aggregated_status_id = status_id
from
        statuses
where
        name = "Aggregated"
if @aggregated_status_id = NULL
begin
        exec
                j_nextkey
                        "statuses",
                        @aggregated_status_id output

        insert into
                statuses
        values(
                @aggregated_status_id,
                "Aggregated")
end


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

exec
	j_nextkey
		"batches",
		@batch_id output

begin tran
	insert into
		batch_nettings(
			batch_id,
			tico_account_id,
			timestamp,
			status_id)
	values(
		@batch_id,
		@tico_account_id,
		getdate(),
		@in_progress_status_id)

	select
		@in_progress = count(*)
	from
		batch_nettings
	where
		status_id = @in_progress_status_id

	if @in_progress > 1
	begin
		select
			status = "Netting in progress",
			message = "Cannot net while another net is in progress"
		rollback tran
		return
	end
commit tran

		
insert into
	batch_netting_trades(
		batch_id,
		trade_id,
		agg_group_id,
		status_id)
select
	batch_id = @batch_id,
	c.trade_id,
	a.agg_group_id,
	status_id = @in_progress_status_id
from
	agg_groups a,
	agg_group_counterparties b,
	trades c,
	statuses d
where
	a.agg_group_id = b.agg_group_id
and
	b.counterparty_id = c.counterparty_id
and
	c.trade_date >= @begin_date
and
	c.trade_date < @end_date
and
	c.status_id = d.status_id
and
	d.name != "Aggregated"
/* MARKR */
and
	c.contract_id = 1197 /* Filter for just EURCHF for testing */


insert into
	batch_netting_trades(
		batch_id,
		trade_id,
		agg_group_id,
		status_id)
select
	batch_id = @batch_id,
	c.trade_id,
	a.agg_group_id,
	status_id = @in_progress_status_id
from
	agg_groups a,
	agg_group_accounts b,
	trades c,
	statuses d
where
	a.agg_group_id = b.agg_group_id
and
	b.external_account_id = c.external_account_id
and
	c.trade_date >= @begin_date
and
	c.trade_date < @end_date
and
	c.status_id = d.status_id
and
	d.name != "Aggregated"
/* MARKR */
and
	c.contract_id = 1197 /* Filter for just EURCHF for testing */

create table
	#trades(
		agg_group_id int,
		trade_id int,
		deal_id int,
		trade_date datetime,
		contract_id int,
		symbol varchar(50) NULL,
		quantity numeric(30,4),
		price float,
		value_date datetime,
		external_account_id int,
		external_account varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
		trader_id int,
		trader varchar(50) NULL,
		broker_id int,
		broker varchar(50) NULL)

insert into
	#trades(
		agg_group_id,
		trade_id,
		deal_id,
		trade_date,
		contract_id,
		quantity,
		price,
		value_date,
		external_account_id,
		counterparty_id,
		trader_id,
		broker_id)
select
	a.agg_group_id,
	b.trade_id,
	b.deal_id,
	b.trade_date,
	b.contract_id,
	b.quantity,
	b.price,
	b.value_date,
	b.external_account_id,
	b.counterparty_id,
	b.trader_id,
	b.broker_id
from
	batch_netting_trades a,
	trades b
where
	a.trade_id = b.trade_id
and
	a.batch_id = @batch_id

update
	#trades
set
	a.symbol = b.symbol
from
	#trades a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#trades
set
	a.broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id

update
	#trades
set
	a.external_account = b.symbol
from
	#trades a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.counterparty = b.name
from
	#trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#trades
set
	a.trader = b.symbol
from
	#trades a,
	traders b
where
	a.trader_id = b.trader_id


create table
	#longs(
		id int identity,
		agg_group_id int,
		contract_id int,
		value_date datetime,
		quantity float,
		avg_long float,
		tickets int,
		avg_size float)
insert into
	#longs(
		agg_group_id,
		contract_id,
		value_date,
		quantity,
		avg_long,
		tickets,
		avg_size)
select
	agg_group_id,
	contract_id,
	value_date,
	sum(quantity),
	sum(quantity * price) / sum(quantity),
	count(trade_id),
	avg(quantity)
from
	#trades
where
	quantity > 0
group by
	agg_group_id,
	contract_id,
	value_date

create table
	#shorts(
		id int identity,
		agg_group_id int,
		contract_id int,
		value_date datetime,
		quantity float,
		avg_short float,
		tickets int,
		avg_size float)
insert into
	#shorts(
		agg_group_id,
		contract_id,
		value_date,
		quantity,
		avg_short,
		tickets,
		avg_size)
select
	agg_group_id,
	contract_id,
	value_date,
	sum(quantity),
	sum(quantity * price) / sum(quantity),
	count(trade_id),
	avg(quantity)
from
	#trades
where
	quantity < 0
group by
	agg_group_id,
	contract_id,
	value_date


select
	@id = 0
select
	@ids = count(*)
from
	#longs
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#longs
	where
		id > @id

	select
		@agg_group_id = NULL,
		@contract_id = NULL,
		@value_date = NULL,
		@quantity = NULL,
		@price = NULL,
		@tickets = NULL,
		@avg_size = NULL,
		@trade_id = NULL,
		@deal_id = NULL

	select
		@agg_group_id = agg_group_id,
		@contract_id = contract_id,
		@value_date = value_date,
		@quantity = quantity,
		@price = avg_long,
		@tickets = tickets,
		@avg_size = avg_size
	from
		#longs
	where
		id = @id

	exec
		ag_tallyaggtrade
			@login = @login,
			@batch_id = @batch_id,
			@agg_group_id = @agg_group_id,
			@contract_id = @contract_id,
			@value_date = @value_date,
			@trade_date = @trade_date,
			@quantity = @quantity,
			@price = @price,
			@tickets = @tickets,
			@trade_id = @trade_id output,
			@deal_id = @deal_id output


	select
		@ids = count(*)
	from
		#longs
	where
		id > @id
end

select
	@id = 0
select
	@ids = count(*)
from
	#shorts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#shorts
	where
		id > @id

	select
		@agg_group_id = NULL,
		@contract_id = NULL,
		@value_date = NULL,
		@quantity = NULL,
		@price = NULL,
		@tickets = NULL,
		@avg_size = NULL,
		@trade_id = NULL,
		@deal_id = NULL

	select
		@agg_group_id = agg_group_id,
		@contract_id = contract_id,
		@value_date = value_date,
		@quantity = quantity,
		@price = avg_short,
		@tickets = tickets,
		@avg_size = avg_size
	from
		#shorts
	where
		id = @id

	exec
		ag_tallyaggtrade
			@login = @login,
			@batch_id = @batch_id,
			@agg_group_id = @agg_group_id,
			@contract_id = @contract_id,
			@value_date = @value_date,
			@trade_date = @trade_date,
			@quantity = @quantity,
			@price = @price,
			@tickets = @tickets,
			@trade_id = @trade_id output,
			@deal_id = @deal_id output


	select
		@ids = count(*)
	from
		#shorts
	where
		id > @id
end

/* check batch_nettings and batch_netting_trades for an issue with netting */
declare @in_process_trades int
select 
	@in_process_trades = 0

begin tran
        select
                @in_progress_trades = count(*)
        from
		batch_netting_trades b
        where
		b.batch_id = @batch_id
	and
                b.status_id = @in_progress_status_id
        if @in_progress_trades > 0
        begin
                select
                        status = "Error",
                        message = "Netting should be complete but 'in progress' batch_netting_trades still found"
                rollback tran
                return
        end

	update
		batch_nettings
	set
		status_id = @aggregated_status_id
	where
		batch_id = @batch_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem updating batch netting record to 'Aggregated'"
		rollback tran
		return
	end
commit tran

