use
	risk_cfe
go

drop procedure
	esm_cfefxtrades
go

create procedure
	esm_cfefxtrades
		@trade_date datetime=NULL,
		@trade_id int=NULL
as

declare @timestamp datetime
declare @begin_date datetime
declare @end_date datetime
declare @processing_revals int


if @trade_id = NULL
	select
		@trade_id = 0

select
	@processing_revals = count(a.trade_daily_reval_id)
from
	trade_daily_revals a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Processing"

if @trade_date = NULL
	select
		@timestamp = getdate()

else
	select
		@timestamp = @trade_date

exec
	r_daterangefordate
		@timestamp,
		@begin_date output,
		@end_date output

if @trade_date = NULL
	select
		@trade_date = @begin_date


create table
	#output(
		trade_action varchar(20),
		trade_id int,
		contract_id int,
		quantity numeric(30,4),
		price float,
		trade_date datetime)


if @processing_revals != 0
begin
	select
		a.trade_action,
		a.trade_id,
		b.symbol,
		a.quantity,
		a.price,
		a.trade_date
	from
		#output a,
		contracts b
	where
		a.contract_id = b.contract_id

	return
end

insert into
	#output
select
	trade_action = "Received",
	a.trade_id,
	a.contract_id,
	a.quantity,
	a.price,
	a.trade_date
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.trade_date > @begin_date
and
	a.trade_date < @end_date
and
	a.trade_id > @trade_id

insert into
	#output
select
	trade_action = "Sent",
	b.trade_id,
	b.contract_id,
	b.quantity,
	b.price,
	b.trade_date
from
	deal_notifications a,
	trades b,
	forwards c,
	statuses d
where
	a.deal_id = b.deal_id
and
	b.contract_id = c.contract_id
and
	a.status_id = d.status_id
and
	b.trade_date > @begin_date
and
	b.trade_date < @end_date
and
	d.name = "Sent"
and
	b.trade_id > @trade_id
	
	
insert into
	#output
select
	trade_action = "Received",
	a.trade_id,
	d.underlying_contract_id,
	a.quantity,
	price = 0.0,
	a.trade_date	
from
	trades a,
	option_contracts b,
	option_expirations c,
	options d
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	a.trade_date > @begin_date
and
	a.trade_date < @end_date
and
	a.trade_id > @trade_id

insert into
	#output
select
	trade_action = "Sent",
	a.trade_id,
	d.underlying_contract_id,
	a.quantity,
	price = 0.0,
	a.trade_date	
from
	trades a,
	option_contracts b,
	option_expirations c,
	options d,
	deal_notifications e,
	statuses f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	a.deal_id = e.deal_id
and
	e.status_id = f.status_id
and
	f.name = "Sent"
and
	a.trade_date > @begin_date
and
	a.trade_date < @end_date
and
	a.trade_id > @trade_id


update
	#output
set
	a.price = b.price
from
	#output a,
	current_prices b
where
	a.contract_id = b.contract_id
and
	a.price = 0.0
	

select
	a.trade_action,
	a.trade_id,
	b.symbol,
	a.quantity,
	a.price,
	a.trade_date
from
	#output a,
	contracts b
where
	a.contract_id = b.contract_id



go
