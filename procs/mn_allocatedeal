use
	risk_ram
go

drop procedure
	mn_allocatedeal
go

create procedure
	mn_allocatedeal
		@login varchar(50),
		@run_name varchar(50),
		@deal_id int
as

declare @ma_version_id int

select
        @ma_version_id = b.ma_version_id
from
        master_allocations a,
        ma_versions b,
        contracts c,
        statuses d,
        trades e,
        external_accounts f,
        external_account_types g
where
        e.deal_id = @deal_id
and
        e.external_account_id = f.external_account_id
and
        f.external_account_type_id = g.external_account_type_id
and
        g.name = "Master"
and
        e.contract_id = c.contract_id
and
        c.instrument_id = a.instrument_id
and
        a.master_allocation_id = b.master_allocation_id
and
        b.status_id = d.status_id
and
        d.name = "Active"

exec
	mn_allocateotherdeal
		@login,
		@run_name,
		@deal_id,
		@ma_version_id



go

