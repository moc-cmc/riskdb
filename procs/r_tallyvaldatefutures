
if object_id("r_tallyvaldatefutures") != NULL
    drop procedure
        r_tallyvaldatefutures
go

create procedure
	r_tallyvaldatefutures
		@login char(25),
		@contract char(50),
		@val_date datetime,
		@trader varchar(50),
		@broker char(100),
		@quantity int,
		@price float,
		@strategy char(100)


as

declare @symbol varchar(50)
declare @future_id int
declare @root_symbol varchar(30)
declare @account_id int
declare @contract_id int
declare @trade_quantity int
declare @remainder_quantity int
declare @internal_account_id int
declare @tico_account_id int
declare @external_account_id int
declare @external_account char(25)
declare @trade_id int
declare @deal_id int
declare @trade_date datetime
declare @strategy_id int
declare @trader_id int
declare @allocations int
declare @ext_future_allocation_id int
declare @allocation float
declare @broker_id int
declare @fund_id int
declare @instrument_id int

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)


exec
	r_defaultfundforlogin
		@login,
		@fund_id output
if @fund_id = NULL
begin
	select
		id = -1,
		error = "Problem finding default fund for user"
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Future"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"instruments",
			@instrument_id output

	insert into
		instruments
	values(
		@instrument_id,
		"Future")
end

select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding strategy",
		strategy = @strategy
	return
end

select
	@future_id = future_id,
	@root_symbol = root_symbol
from
	futures
where
	name = @contract
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		contract = @contract
	return
end


select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding broker",
		broker = @broker
	return
end

select
	@account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select 	
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol =  @trader
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding trader",
		trader = @trader
	return
end


select
	@symbol = rtrim(@root_symbol) + " " + rtrim(convert(varchar(12), @val_date))

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	exec
		j_nextkey
			"contracts",
			@contract_id output

	insert into
		future_contracts
	values(
		@contract_id,
		@future_id,
		@val_date)

	insert into
		contracts
	values(
		@contract_id,
		@symbol,
		@instrument_id)
end

select
	@trade_date = getdate()


begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "deals"
	select
		@deal_id = last_id
	from
		keys
	where
		relation = "deals"
commit tran

insert into
	deals
values(
	@deal_id,
	getdate())

select
	@remainder_quantity = @quantity

begin tran
select
	@ext_future_allocation_id = 0
select
	@allocations = count(*)
from
	external_future_allocations
where
	fund_id = @fund_id
and
	ext_future_allocation_id > @ext_future_allocation_id

while @allocations > 0
begin
	select
		@ext_future_allocation_id = min(ext_future_allocation_id)
	from
		external_future_allocations
	where
		fund_id = @fund_id
	and
		ext_future_allocation_id > @ext_future_allocation_id

	select
		@external_account_id = external_account_id,
		@internal_account_id = internal_account_id,
		@allocation = percentage	
	from
		external_future_allocations
	where
		ext_future_allocation_id = @ext_future_allocation_id

	select
		@trade_quantity = convert(int, round(@quantity * @allocation, 0))

/***** below alogirithm is to truncate non remainder accounts - not in use  ****/

/*	select
		@trade_quantity = convert(int, @quantity * @allocation, 0) */

	select
		@remainder_quantity = @remainder_quantity - @trade_quantity


	begin tran
		update
			keys
		set
			last_id = last_id + 1
		where
			relation = "trades"
		select
			@trade_id = last_id
		from
			keys
		where
			relation = "trades"
	commit tran
	
	
	insert into
		trades
	values(
		@trade_id,
		@deal_id,
		@account_id,
		@internal_account_id,
		@external_account_id,
		@trade_quantity,
		@contract_id,
		@price,
		@trade_date,
		@trader_id,
		@strategy_id,
		1,
		@broker_id)
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem adding trade"
		rollback tran
		return
	end
	
	select
		@allocations = count(*)
	from
		external_future_allocations
	where
		fund_id = @fund_id
	and
		ext_future_allocation_id > @ext_future_allocation_id
	
end
	
select
	@internal_account_id = NULL,
	@external_account_id = NULL

select
	@internal_account_id = remainder_int_account_id,
	@external_account_id = remainder_ext_account_id
from
	external_future_allocations
where
	ext_future_allocation_id = @ext_future_allocation_id

if @external_account_id = NULL
begin
	select
		@external_account_id = futures_external_account_id,
		@internal_account_id = futures_internal_account_id
	from
		default_accounts
	where
		tico_account_id = @account_id

	if @internal_account_id = NULL
	begin
		select
			@internal_account_id = min(internal_account_id)
		from
			internal_accounts
	end

	if @external_account_id = NULL
	begin
		select
			@external_account_id = min(external_account_id)
		from
			external_accounts
	end
end
		

begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "trades"
	select
		@trade_id = last_id
	from
		keys
	where
		relation = "trades"
commit tran

insert into
	trades
values(
	@trade_id,
	@deal_id,
	@account_id,
	@internal_account_id,
	@external_account_id,
	@remainder_quantity,
	@contract_id,
	@price,
	@trade_date,
	@trader_id,
	@strategy_id,
	1,
	@broker_id)
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem adding trade"
	rollback tran
	return
end
commit tran



exec
	r_inspectdealtrades
		@login,
		@deal_id

exec
	r_intradayfwdpl
		@login

go
