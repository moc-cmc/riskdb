create or replace procedure
	api_allocdepositrequest
		@login varchar(50),
		@sub_account varchar(50),
		@product varchar(50),
		@amount float

	

as

select
	@amount = abs(@amount)

exec
	api_addallocationrequest
		@login=@login,
		@sub_account=@sub_account,
		@product=@product,
		@amount=@amount


go

