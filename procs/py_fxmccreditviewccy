drop procedure py_fxmccreditviewccy
go

create procedure
	py_fxmccreditviewccy
		@login varchar(50),
		@external_account varchar(50)=NULL
as

declare @external_account_id int
declare @nop_limit float
declare @dsl_limit float
declare @net_equiv float
declare @longs_equiv float
declare @shorts_equiv float
declare @nop_type varchar(50)
declare @value_date datetime
declare @dsl_type varchar(50)
declare @evaluation_currency_id int
declare @evaluation_currency varchar(50)
declare @fund_id int

declare @search_string varchar(50)


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Could not find evaluation currency"
	return
end

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

if @external_account = NULL
begin
	select
		@search_string = "%"
end
else
begin
	select
		@search_string = "%" + rtrim(@external_account) + "%"

	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @external_account
end

create table
	#output
(
	ext_account varchar(50),
	product varchar(10),
        val_date datetime,
	amount float,
	equiv float,
	implied_rate float NULL
)

insert into
	#output
select
	ext_account,
	product,
	val_date = convert(varchar(12), value_date, 101),
	amount,
	equiv,
	implied_rate = case
		when
			equiv != 0
		then
			abs(amount) / abs(equiv)
		else
			NULL
	end
from
	ext_account_ladder_details
where
	ext_account like @search_string
order by
	value_date,
	product

update
	#output
set
	ext_account = a.symbol
from
	external_account_symbols a,
	external_accounts b,
	sources c,
	#output d
where
	a.external_account_id = b.external_account_id 
and
	a.source_id = c.source_id
and
	b.symbol like d.ext_account
and
	c.name = "Agency Client"	
	
select
        ext_account,
        product,
        val_date = convert(varchar(12), val_date, 101),
        amount,
        equiv,
        implied_rate
from
	#output
order by
        val_date,
        product
go
