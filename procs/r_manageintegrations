
create or replace procedure
	r_manageintegrations
		@login varchar(50)
as

declare @tico_account_id int
declare @has_permission  char(1)
declare @login_name varchar(25)
declare @elysium_login_id int

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
        #meta
values(
        "Column Link",
        "add_integration",
        "Add Integration",
        NULL)


insert into
        #meta
values(
        "Column Link",
        "add_organization",
        "Add Organization",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "add_connection",
        "Add Integration Connection",
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "integration_id",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "org_id",
        NULL,
        NULL)

select * from #meta

select
	@has_permission = "N"

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login

select
	@has_permission = "Y"
FROm
	access_groups a,
	access_group_accounts b
where
	a.access_group_id = b.access_group_id
and
	a.name = "Integration Admin"
and
	b.tico_account_id = @tico_account_id
	

if @has_permission != "Y"
begin
	select
		status = "Error",
		message = "<b>Permission Denied</b>" + " - User must be configured as 'Integration Admin'"
	return
end

select
        @elysium_login_id = a.login_type_id
from
        login_types a,
	tico_account_types b
where
        a.name="Elysium"
and
	a.login_type_id = b.login_type_id
and
	b.tico_account_id = @tico_account_id
	
	
if @elysium_login_id != NULL
begin
	select
		section = "Integration Administration",
		add_connection = "Add Connection",
		add_integration = "Add Integration",
		add_organization = "Add Organization"
end


declare @total_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)

select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
        @selected_trade_style = "background:#F7F4C1;border: 1px solid white"

create table
	#integration_connections(
		id int identity,
		connection_id int,
		name varchar(50),
		ops_name varchar(70),
		source_id int,
		source_name varchar(50),
		source_type_id int,
		source_type varchar(50),
		integration_id int,
		integration_name varchar(50),
		org_id int NULL,
		org_name varchar(50) NULL,
		format_swaps char(1) NULL,
                connection_status_id int,
		connection_status varchar(50),
		stale_threshold int NULL,
		monitoring_enabled char(1) NULL,
		edit_connection varchar(10) NULL
)

insert into
	#integration_connections(
		connection_id,
		name,
		ops_name,
		source_id,
		source_name,
		source_type_id,
		source_type,
		integration_id,
		integration_name,
		org_id,
		format_swaps,
		connection_status_id,
		connection_status,
		stale_threshold,
		monitoring_enabled,
		edit_connection)
select
	a.connection_id,
	a.name,
	a.ops_name,
	a.source_id,
	b.name,
	b.source_type_id,
	c.name,
	a.integration_id,
	d.name,
	d.org_id,
	d.format_swaps,
	a.connection_status_id,
	e.name,
	a.stale_threshold,
	a.monitoring_enabled,
	NULL
from
	connections a,
	sources b,
	source_types c,
	integrations d,
	connection_statuses e
where
	a.source_id = b.source_id
and
	b.source_type_id = c.source_type_id
and
	a.integration_id = d.integration_id
and
	a.connection_status_id = e.connection_status_id

update
	#integration_connections
set
	org_name = b.name
from
	#integration_connections a,
	orgs b
where
	a.org_id = b.org_id

if @elysium_login_id != NULL
begin
	update 
		#integration_connections
	set
		edit_connection = "EDIT"
end	

select
	section = "Integration Connections",
        connection_id,
        name,
        ops_name,
        source_name,
        source_type,
        integration_name,
	org_name,
        format_swaps,
	connection_status,
        stale_threshold,
        monitoring_enabled,
	edit_connection,
	style = @style
from
	#integration_connections
order by
	ops_name,
	integration_name
	
	
go


