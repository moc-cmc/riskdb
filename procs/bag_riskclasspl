select
	@risk_class_id = 0
select
	@risk_classes = count(*)
from
	risk_classes
where
	risk_class_id > @risk_class_id

while @risk_classes > 0
begin
	select
		@risk_class_id = min(risk_class_id)
	from
		risk_classes
	where
		risk_class_id > @risk_class_id
	
	select
		@rcm_id = NULL

	/* TEMP */
	delete

	from
		beta_risk_class_mtms
	where
		convert(date, trade_date) = convert(date, @trade_date)

	select
		@rcm_id = id
	from
		beta_risk_class_mtms
	where
		risk_class_id = @risk_class_id
	and
		convert(date, trade_date) = convert(date, @trade_date)

	if @risk_class_id = @selected_rc_id
		select
			@rcm_id = NULL


	if @rcm_id = NULL
	begin
		select
			@run_id = 0
		select
			@runs = count(*)
		from
			risk_class_runs
		where 
 			risk_class_id = @risk_class_id
		and
			run_id > @run_id
		
		while @runs > 0
		begin
			select
				@run_id = min(run_id)
			from
				risk_class_runs
			where
				risk_class_id = @risk_class_id
			and
				run_id > @run_id
			
			truncate table #traders
			truncate table #strategies
			truncate table #external_accounts
			truncate table #internal_accounts
			truncate table #brokers
			truncate table #counterparties

			
			insert into
				#traders
			select
				trader_id,
				run_id = @run_id
			from
				run_traders
			where
				run_id = @run_id
			if @@rowcount = 0
			begin
				insert into
					#traders
				select
					trader_id,
					run_id = @run_id
				from
					traders
			end
		
			insert into
				#strategies
			select
				strategy_id,
				run_id = @run_id
			from
				run_strategies
			where
				run_id = @run_id
			if @@rowcount = 0
			begin
				insert into
					#strategies
				select
					strategy_id,
					run_id = @run_id
				from
					strategies
			end
			
			insert into
				#external_accounts
			select
				external_account_id,
				run_id = @run_id
			from
				run_external_accounts
			where
				run_id = @run_id
			if @@rowcount = 0
			begin
				insert into
					#external_accounts
				select
					external_account_id,
					run_id = @run_id
				from
					external_accounts
			end
		
			insert into
				#internal_accounts
			select
				internal_account_id,
				run_id = @run_id
			from
				run_internal_accounts
			where
				run_id = @run_id 
			if @@rowcount = 0
				insert into
					#internal_accounts
				select
					internal_account_id,
					run_id = @run_id
				from
					internal_accounts
		
			insert into
				#brokers
			select
				broker_id,
				run_id = @run_id
			from
				run_brokers
			where
				run_id = @run_id
			if @@rowcount = 0
				insert into
					#brokers
				select
					broker_id,
					run_id = @run_id
				from
					brokers
			
			insert into
				#counterparties
			select
				counterparty_id,
				run_id = @run_id
			from
				run_counterparties
			where
				run_id = @run_id
			if @@rowcount = 0
				insert into
					#counterparties
				select
					counterparty_id,
					run_id = @run_id
				from
					counterparties
			
		
			insert into 
 				#trades(
					trade_id,
					deal_id,
					risk_class_id,
					run_id,
					trade_date,
					amount,
					price,
					contract_id,
					product_id,
					currency_id,
					value_date,
					external_account_id)
			select
				a.trade_id,
				a.deal_id,
				risk_class_id = @risk_class_id,
				run_id = @run_id,
				a.trade_date,
				a.quantity,
				a.price,
				a.contract_id,
				h.product_id,
				h.currency_id,	
				a.value_date,
				a.external_account_id
			from
				trades a,
				#external_accounts b,
				#internal_accounts c,
				#traders d,
				#strategies e,
				#brokers f,
				#counterparties g,
				forwards h
			where
				a.contract_id = h.contract_id
			and
				a.external_account_id = b.external_account_id
			and
				a.internal_account_id = c.internal_account_id
			and
				a.trader_id = d.trader_id
			and
				a.strategy_id = e.strategy_id
			and
				a.broker_id= f.broker_id
			and
				a.counterparty_id = g.counterparty_id
			and
				a.value_date >= @begin_date
			and
				/* a.trade_date >= @begin_date
			and */
				a.trade_date < @end_date
			and
				b.run_id = @run_id
			and
				c.run_id = @run_id
			and
				d.run_id = @run_id
			and
				e.run_id = @run_id
			and
				f.run_id = @run_id
			and
				g.run_id = @run_id
			
			select
				@runs = count(*)
			from
				risk_class_runs
			where
				risk_class_id = @risk_class_id
			and
				run_id > @run_id
		end
	
	end


	select
		@risk_classes = count(*)
	from
		risk_classes
	where
		risk_class_id > @risk_class_id
		
end

