create table
	#summary(
		id int identity,
		style varchar(250) NULL,
		risk_class_id int NULL,
		risk_class varchar(100) NULL,
		settled_pl numeric(30,2) NULL,
		open_positions numeric(30,2) NULL,
		daily_trades numeric(30,2) NULL,
		total numeric(30,2) NULL,
		volume numeric(30,2) NULL,
		saved_settled numeric(30,2) NULL,
		saved_open numeric(30,2) NULL,
		saved_trades numeric(30,2) NULL,
		saved_volume numeric(30,2) NULL,
		status varchar(250) NULL)
insert into
	#summary(
		risk_class_id,
		risk_class,
		style)
select
	risk_class_id,
	name,
	style = @style
from
	risk_classes
order by
	name

select
	@id = 0
select
	@ids = count(*)
from
	#summary
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#summary
	where
		id > @id

	select
		@settlement_pl = NULL,
		@positions_pl = NULL,
		@trades_pl = NULL,
		@volume = NULL

	select
		@risk_class_id = risk_class_id
	from
		#summary
	where
		id = @id

	select
		@settlement_pl = p_l
	from
		#risk_classes
	where
		risk_class_id = @risk_class_id
	and
		trade_tag = "Settlement"
	if @settlement_pl = NULL
		select
			@settlement_pl = 0.0

	select
		@positions_pl = p_l
	from
		#risk_classes
	where
		risk_class_id = @risk_class_id
	and
		trade_tag = "Position"
	if @positions_pl = NULL
		select
			@positions_pl = 0.0

	select
		@trades_pl = p_l,
		@volume = volume
	from
		#risk_classes
	where
		risk_class_id = @risk_class_id
	and
		trade_tag = "New Trade"
	if @trades_pl = NULL
		select
			@trades_pl = 0.0
	if @volume = NULL
		select
			@volume = 0.0

	update
		#summary
	set
		settled_pl = @settlement_pl,
		open_positions = @positions_pl,
		daily_trades = @trades_pl,
		total = @positions_pl + @trades_pl,
		volume = @volume
	where
		risk_class_id = @risk_class_id
		
	update
                #summary
        set
                a.saved_settled = b.settled_equiv,
                a.saved_open = b.pos_pl_equiv,
                a.saved_trades = b.trades_pl_equiv,
                a.saved_volume = b.volume
        from
                #summary a,
                risk_class_history b
        where
                a.risk_class_id = b.risk_class_id
	and
		a.risk_class_id = @risk_class_id
	and
		b.risk_class_id = @risk_class_id
        and
                convert(date, b.trade_date) = convert(date, @end_date)
        if @@rowcount = 0
        begin
		if @end_date < getdate()
                	insert into
				risk_class_history(
					risk_class_id,
					trade_date,
					settled_equiv,
					pos_pl_equiv,
					trades_pl_equiv,
					volume)
			values(
				@risk_class_id,
				@end_date,
				@settlement_pl,
				@positions_pl,
				@trades_pl,
				@volume)
	end
			

	select
		@ids = count(*)
	from
		#summary
	where
		id > @id
end

update
	#summary
set
	status = "Mismatch",
	style = @error_style
where
	saved_settled != settled_pl
or
	saved_open != open_positions
or
	saved_trades != daily_trades
or
	saved_volume != volume




select
	@total = sum(total),
	@settlement_pl = sum(settled_pl),
