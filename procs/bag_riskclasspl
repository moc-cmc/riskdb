insert into
	#deal_trades(
		trade_id,
		deal_id,
		risk_class_id,
		trade_date,
		amount,
		price,
		counter_amount,
		contract_id,
		product_id,
		currency_id,
		value_date,
		external_account_id)
select
	a.trade_id,
	a.deal_id,
	c.risk_class_id,
	a.trade_date,
	a.quantity,
	a.price,
	a.quantity * a.price * -1.0,
	a.contract_id,
	b.product_id,
	b.currency_id,	
	a.value_date,
	a.external_account_id
from
	trades a,
	forwards b,
	#agency_deals c
where
	a.contract_id = b.contract_id
and
	a.deal_id = c.deal_id
and
	a.value_date >= @begin_date
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

