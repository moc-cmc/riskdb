create or replace procedure
	bn_letradingbalances
		@login varchar(100),
		@legal_entity varchar(100) =NULL

as


declare @begin_date datetime
declare @end_date datetime
declare @trade_date datetime
declare @bo_master_account_id int
declare @bo_external_account_id int
declare @fo_sub_account_id int
declare @legal_entity_id int
declare @tico_account_id int
declare @run_id int
declare @fund_id int
declare @evaluation_currency_id int
declare @mark_to_market char(1)
declare @settled_status_id int



select
	/*@trade_date  = convert(date, getdate()),*/
	@mark_to_market = "Y"

exec
	r_daterangefordate 
		@trade_date,
		@begin_date output,
		@end_date output

select
	@begin_date = convert(varchar(8), convert(date, @begin_date), 112) + " 17:00",
	@end_date = convert(varchar(8), convert(date, @end_date), 112) + " 17:00"

select
	begin_date = @begin_date,
	end_date = @end_date

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
   @client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
   #meta(
           meta_type char(200),
           name char(50) NULL,
           action char(100) NULL,
           value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Link",
	"deposit",
	"Allocation Request Deposit to Sub Account",
	NULL)

insert into
	#meta
values (
	"Column Link",
	"Withdrawal",
	"Allocation Request Withdrawal From Sub Account",
	NULL)

insert into
        #meta
values (
        "Column Link",
        "manage_settlements",
        "Manage Legal Entity Settlements",
        NULL)


insert into
	#meta
values(
	"Column Format",
	"total_balance", 
 	"Number",
	"#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")

insert into
        #meta
values(
        "Column Format",
        "unallocated_balance",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")

insert into
        #meta
values(
        "Column Format",
        "allocated_balance",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")

insert into
        #meta
values(
        "Column Format",
        "unsettled_balance",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")
insert into
        #meta
values(
        "Column Format",
        "amount",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")





create table
	#legal_entities(
		legal_entity_id int
)

if @legal_entity = NULL
begin
	insert into
		#legal_entities
	select
		legal_entity_id
	from
		legal_entities
end
else
begin

	select
		@legal_entity_id = legal_entity_id
	from
		legal_entities
	where
		name = @legal_entity
	if @legal_entity_id = NULL
	begin
		select
			status = "Error",
			message = "Problem finding legal_entity",
			legal_entity = @legal_entity
		return
	end
	insert into
		#legal_entities
	values(
		@legal_entity_id
	)
end



/*-------------------------------------------------------------------
 * TRADES
 *------------------------------------------------------------------*/

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @legal_entity != NULL
begin
	select
		@run_id = a.run_id
	from
		user_runs a,
		runs b,
		tico_accounts c
	where
		a.run_id = b.run_id
	and
		a.tico_account_id = c.account_id
	and
		c.login = @login
	and
		b.name = @legal_entity

	if @run_id = NULL
	begin
		select
			status = "Error",
			message = "Run not found",
			run_name = @legal_entity
		return
	end
end

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

select
	@settled_status_id = status_id
from
	statuses
where
	name = "Settled"
if @settled_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding status of 'Settled' in system"
	return
end


create table
	#trades(
		trade_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		internal_account_id int,
		internal_account varchar(30) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(15) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
                agency_vs_counterparty varchar(40) NULL,
		fund_agency_trade char(1) NULL,
		fund_agency_buy_sell varchar(8) NULL,
		client_buy_sell varchar(4) NULL,
		broker_id int,
		broker varchar(25) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		ext_account_pb varchar(25) NULL,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity float NULL,
		counter_quantity float NULL,
		abs_qty float NULL,
		abs_counter_qty float NULL,
                abs_far_counter_qty float NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date varchar(15) NULL,
		fixing_date varchar(15) NULL,
		db_price float NULL,
		std_price float NULL,
		sales_code_id int,
		sales_code varchar(15) NULL,
		strategy_id int,
		strategy varchar(30) NULL,
                is_ndf char(1) NULL,
		is_inverted_contract char(1) NULL,
                product_id int NULL,
		currency_id int NULL,
                pd1_eq float NULL,
		pd2_eq float NULL,
		vo float NULL,
                vo_rate float NULL
		)


insert into
	#trades
(
	trade_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	trader_id,
	counterparty_id,
	fund_agency_trade,
	contract_id,
	broker_id,
	quantity,
	counter_quantity,
	trade_date,
	value_date,
	fixing_date,
	sales_code_id,
	strategy_id
)
select 
	trade_id = a.trade_id,
	trade_type_id = a.trade_type_id,
	internal_account_id = a.internal_account_id,
	external_account_id = a.external_account_id,
	trader_id = a.trader_id,
	counterparty_id = a.counterparty_id,
        fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	quantity = a.quantity * -1, /* flipping perspective */
	counter_quantity = a.quantity * price * -1 * -1,  /* flipping perspective */
	trade_date = a.trade_date,
	value_date = convert(varchar(12), a.value_date, 112),
	fixing_date = convert(varchar(12), a.fixing_date, 112),
	sales_code_id = a.sales_code_id,
	strategy_id = a.strategy_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date <= @end_date
and
	a.value_date = convert(date, @end_date)  /* only trades settling today */
and
	quantity != 0
and	
	status_id != @settled_status_id


/*
| Query trade_types
*/
update
	#trades
set
	trade_type = b.name
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id

update
	#trades
set
	is_ndf = "Y"
where
	fixing_date != NULL


/*
| Query internal_accounts
*/

update
	#trades
set
	internal_account = b.symbol
from
	#trades a,
	internal_accounts b
where
	a.internal_account_id = b.internal_account_id


/*
| Query external_accounts
*/
update 
        #trades
set
        external_account = b.symbol,
	external_account_type_id = b.external_account_type_id
from
        #trades a,
        external_accounts b
where
        a.external_account_id = b.external_account_id

update
	#trades 
set
	external_account_type = b.name
from
	#trades a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id

	
/*
| Query traders
*/
update
	#trades
set
	trader = b.symbol
from
        #trades a,
        traders b
where
        a.trader_id = b.trader_id


/*
| Query counterparties
*/

update
	#trades
set
	counterparty = b.name,
	agency_vs_counterparty = b.name
from
	#trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#trades
set
	fund_agency_trade = "Y",
	agency_vs_counterparty = a.external_account
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id



update
	#trades
set
	fund_agency_buy_sell = "SELL",
        client_buy_sell = "BUY"
where
	quantity < 0

update
        #trades
set
        fund_agency_buy_sell = "BUY",
	client_buy_sell = "SELL"
where
        quantity > 0


/*
| Query brokers
*/

update
	#trades
set
	broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id


/*
| Query strategies
*/

update 
	#trades
set
	strategy = b.name
from
	#trades a,
	strategies b
where
	a.strategy_id = b.strategy_id

/* strategy_symbols does not exist */


/*
|  Query contracts, dealt ccy, counter ccy
*/
update 
	#trades
set
	std_contract = b.symbol,
        traded_ccy = g.symbol,
        counter_ccy = f.symbol
from
	#trades a,
	contracts b,
	forwards e,
	products f,
	products g
where
	a.contract_id = b.contract_id
and
	b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#trades
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy)
from
	#trades a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

update
	#trades
set
	std_contract = b.symbol
from
	#trades a,
	contracts b,
	instruments c
where
	a.contract_id =b.contract_id
and
	b.instrument_id = c.instrument_id
and
	c.name in("Option", "Exotic")


update
	#trades
set
	prime_broker_id = d.prime_broker_id,
	prime_broker = c.name
from
	#trades a,
	external_account_prime_brokers b,
	prime_brokers d,
	sources c
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = d.prime_broker_id
and
	c.source_id = d.source_id

update
	#trades
set
	is_inverted_contract = "Y"
from
	#trades a,
	contracts b,
        contract_price_styles c,
        price_styles d,
	forwards e
where
        b.contract_id = c.contract_id
and
        c.price_style_id = d.price_style_id
and
        d.name = "Inverted"


if @mark_to_market = "Y"
begin
	/* set product id */
	update
        	#trades
	set
        	product_id = b.product_id,
        	currency_id = b.currency_id
	from
        	#trades a,
        	forwards b
	where
        	a.contract_id = b.contract_id

	/* get the eval ccy */	
	create table
        	#eval_ccys(
                	product_id int,
                	symbol varchar(10) NULL
	)
	insert into
        	#eval_ccys(
                	product_id)
	select
        	distinct(evaluation_currency_id)
	from
        	funds

	/* Find out what products have been traded */
	create table
		#traded_products(
			product_id int
	)
	
	insert into
		#traded_products
	select
		distinct(product_id)
	from
		#trades
	
	insert into 
		#traded_products
	select
		distinct(currency_id)
	from
		#trades
	where
		currency_id not in(select product_id from #traded_products)

	/* Get the conversion rated from traded products to eval ccy */	
	create table
		#conversion_contracts
	(
		contract_id int NULL,
		product_id int,
		currency_id int,
		inverse_contract_id int NULL,
		standard_price float NULL,
		conversion_price float NULL
	)
	
	insert into 
		#conversion_contracts(
			contract_id,
			product_id,
			currency_id
		)
	select
		a.contract_id,
		a.product_id,
		a.currency_id
	from
		forwards a,
		#traded_products b,
		#eval_ccys c
	where
		a.product_id = b.product_id
	and
		a.currency_id = c.product_id

	update
		#conversion_contracts
	set
		inverse_contract_id = a.contract_id
	from
		forwards a,
		#conversion_contracts b
	where
		a.product_id = b.currency_id
	and
		a.currency_id = b.product_id

	/* create temp table of current prices so price ticks dont affect conversion rates */
	create table
		#current_prices(
			contract_id int,
			price float
	)
	insert into
		#current_prices
	select
		contract_id,
		price
	from
		current_prices

	/* set conversion rates from current prices */	
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		#current_prices a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	#current_prices a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
		b.standard_price = NULL

	/* ensure a rate of 1.0 exists for the eval to eval conversion */
	insert into
		#conversion_contracts
	(
		product_id,
		currency_id,
		conversion_price
	)
	select
		product_id,
		product_id,
		1.0
	from
		#eval_ccys


	update 
		#trades
	set
		pd1_eq = quantity * conversion_price,
                vo_rate = conversion_price
	from
		#trades a,
		#conversion_contracts b
	where
		a.product_id = b.product_id
	
	update
        	#trades
	set
        	pd2_eq = (quantity * db_price * -1) * conversion_price
	from
        	#trades a,
        	#conversion_contracts b
	where
        	a.currency_id = b.product_id
	
	update
		#trades
	set
		vo = abs(pd1_eq)

end

create table
	#product_positions(
		id int identity,
		external_account_id int,
		product_id int,
		quantity float NULL
)

insert into
	#product_positions(
		external_account_id,
		product_id,
		quantity)
select
        external_account_id,
	product_id,
	quantity = sum(quantity)
from
	#trades
group by
        external_account_id,
	product_id


insert into
        #product_positions(
		external_account_id,
		product_id,
		quantity)
select
        external_account_id,
	currency_id,
        quantity = sum(counter_quantity)
from
        #trades
group by
        external_account_id,
	currency_id




/*-------------------------------------------------------------------
 * CASH AND LEDGER
 *------------------------------------------------------------------*/
create table
	#master_accounts(
                legal_entity_id int,
		legal_entity_name varchar(100),
                bo_master_account_id int,
                bo_external_account_id int,
		bo_external_account_symbol varchar(100),
		bo_external_account_name varchar(100)
)



create table
	#master_balances(
		legal_entity_id int,
		bo_master_account_id int,
		bo_external_account_id int,
		product_id int,
		amount float
)

create table
        #master_pending_balances(
                legal_entity_id int,
                bo_master_account_id int,
                bo_external_account_id int,
                product_id int,
                amount float
)

		
create table
	#fo_sub_balances(
		legal_entity_id int,
		bo_master_account_id int,
		bo_external_account_id int,
		fo_sub_account_id int,
		fo_external_account_id int,
		product_id int,
		amount float
) 

create table
        #pre_fo_sub_balances(
                legal_entity_id int,
                bo_master_account_id int,
                bo_external_account_id int,
                fo_sub_account_id int,
                fo_external_account_id int,
                product_id int,
                amount float
)




insert into
        #master_accounts
select
        a.legal_entity_id,
	a.name,
        b.bo_master_account_id,
        b.external_account_id,
	c.symbol,
	c.symbol
from
        legal_entities a,
        bo_master_accounts b,
	external_accounts c,
        #legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.external_account_id = c.external_account_id
and
        a.legal_entity_id = h.legal_entity_id


insert into
	#master_balances
select
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id,
        amount=sum(e.amount)
from
        legal_entities a,
        bo_master_accounts b,
        account_transactions e,
        products g,
	#legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.external_account_id = e.external_account_id
and
        e.currency_id = g.product_id
and
        a.legal_entity_id = h.legal_entity_id
and
        e.transaction_date <= @end_date
group by
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id

insert into
        #master_pending_balances
select
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id,
        amount=sum(e.amount)
from
        legal_entities a,
        bo_master_accounts b,
        pending_transactions e,
        products g,
        #legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.external_account_id = e.external_account_id
and
        e.currency_id = g.product_id
and
        a.legal_entity_id = h.legal_entity_id
and
        e.transaction_date <= @end_date
group by
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id

update 
	#master_balances
set
	amount = a.amount + b.amount
from
	#master_balances a,
	#master_pending_balances b
where
	a.legal_entity_id = b.legal_entity_id
and
	a.bo_master_account_id = b.bo_master_account_id
and
	a.bo_external_account_id  = b.bo_external_account_id
and
	a.product_id = b.product_id
	

insert into
	#pre_fo_sub_balances(
		legal_entity_id,
		bo_master_account_id,
		bo_external_account_id,
		fo_sub_account_id,
		fo_external_account_id,
		product_id,
		amount
	)
select
	a.legal_entity_id,
	b.bo_master_account_id,
	b.external_account_id,
	c.fo_sub_account_id,
	c.external_account_id,
	g.product_id,
	amount=sum(e.amount)
from
	legal_entities a,
	bo_master_accounts b,
	fo_sub_accounts c,
	external_accounts d,
	account_transactions e,
	products g,
	#legal_entities h
where
	a.legal_entity_id = b.legal_entity_id
and
	b.bo_master_account_id = c.bo_master_account_id
and
	c.external_account_id = d.external_account_id
and
	d.external_account_id = e.external_account_id
and
	e.currency_id = g.product_id
and
	a.legal_entity_id = h.legal_entity_id
and
	e.transaction_date <= @end_date
group by
	a.legal_entity_id,
	b.bo_master_account_id,
	b.external_account_id,
	c.fo_sub_account_id,
	c.external_account_id,
	g.product_id

insert into
        #pre_fo_sub_balances(
                legal_entity_id,
                bo_master_account_id,
                bo_external_account_id,
                fo_sub_account_id,
                fo_external_account_id,
                product_id,
                amount
        )
select
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        c.fo_sub_account_id,
        c.external_account_id,
        g.product_id,
        amount=sum(e.amount)
from
        legal_entities a,
        bo_master_accounts b,
        fo_sub_accounts c,
        external_accounts d,
        pending_transactions e,
        products g,
        #legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.bo_master_account_id = c.bo_master_account_id
and
        c.external_account_id = d.external_account_id
and
        d.external_account_id = e.external_account_id
and
        e.currency_id = g.product_id
and
        a.legal_entity_id = h.legal_entity_id
and
        e.transaction_date <= @end_date
group by
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        c.fo_sub_account_id,
        c.external_account_id,
        g.product_id



insert into
	#fo_sub_balances(
                legal_entity_id,
                bo_master_account_id,
                bo_external_account_id,
                fo_sub_account_id,
                fo_external_account_id,
                product_id,
                amount
        )
select
	legal_entity_id,
	bo_master_account_id,
	bo_external_account_id,
	fo_sub_account_id,
	fo_external_account_id,
	product_id,
	sum(amount)
from
	#pre_fo_sub_balances
group by
        legal_entity_id,
        bo_master_account_id,
        bo_external_account_id,
        fo_sub_account_id,
        fo_external_account_id,
        product_id

	


	

/* insert sub account with no balance for product */
create table
	#fo_sub_account_products(
		bo_master_account_id int,
		fo_sub_account_id int,
		external_account_id int,
		product_id int
)

insert into
	#fo_sub_account_products
select
	a.bo_master_account_id,
	a.fo_sub_account_id,
	a.external_account_id,
	b.product_id
from
	fo_sub_accounts a,
	#master_balances b
where
	a.bo_master_account_id = b.bo_master_account_id


delete 
	#fo_sub_account_products
from
	#fo_sub_account_products a,
	#fo_sub_balances b	
where
	a.fo_sub_account_id = b.fo_sub_account_id
and
	a.product_id = b.product_id

insert into
        #fo_sub_balances(
                legal_entity_id,
                bo_master_account_id,
                bo_external_account_id,
                fo_sub_account_id,
                fo_external_account_id,
                product_id,
                amount
        )
select
        a.legal_entity_id,
        a.bo_master_account_id,
        a.bo_external_account_id,
        b.fo_sub_account_id,
        b.external_account_id,
        b.product_id,
        0.00
from
	#master_balances a,
	#fo_sub_account_products b
where
	a.bo_master_account_id = b.bo_master_account_id
and
	a.product_id = b.product_id
	


create table
	#bo_master_balances(
		bo_master_account_id int,
		bo_external_account_id int,
		product_id int,
		unallocated_balance float,
		allocated_balance float,
		total_balance float NULL
)

insert into
	#bo_master_balances (
		bo_master_account_id,
		bo_external_account_id,
		product_id,
		unallocated_balance,
		allocated_balance)
select
	a.bo_master_account_id,
	a.bo_external_account_id,
	a.product_id,
	a.amount,
	sum(b.amount)
from
	#master_balances a,
	#fo_sub_balances b
where
	a.bo_master_account_id = b.bo_master_account_id
and
	a.product_id = b.product_id
group by
	a.bo_master_account_id,
	a.bo_external_account_id,
	a.product_id

update 
	#bo_master_balances
set
	total_balance = unallocated_balance + allocated_balance	

/*select * from #master_balances
select * from #fo_sub_balances
select * from #bo_master_balances*/


/*-------------------------------------------------------------------
 * FORMATING / OUTPUT
 *------------------------------------------------------------------*/
create table
	#summary(
		id int identity,
		ordering int,
		style varchar(100),
		product_id int NULL,
		product varchar(20) NULL, 
		legal_entity_id int NULL,
		legal_entity varchar(100) NULL,
		bo_master_account_id int,
		bo_external_account_id int,
		bo_master_account varchar(100) NULL,
		bo_external_account varchar(100),
		bo_external_account_symbol varchar(100) NULL,
		fo_external_account_id int NULL,
		fo_sub_account varchar(100) NULL,
		fo_external_account varchar(100) NULL,
		fo_external_account_symbol varchar(100) NULL,
		total_balance float NULL,
		unallocated_balance float NULL,
		allocated_balance float NULL,
		unsettled_balance float NULL,
		deposit varchar(15) NULL,
		withdrawal varchar(15) NULL,
		manage_settlements varchar(25) NULL
)


insert into
        #summary(
                ordering,
                style,
                bo_master_account_id,
                bo_external_account_id,
                bo_external_account,
                bo_external_account_symbol,
		legal_entity_id,
		legal_entity,
		manage_settlements)
select
        ordering=1,
        style = @client_style,
        bo_master_account_id,
        bo_external_account_id,
        bo_external_account_name,
        bo_external_account_symbol,
	legal_entity_id,
	legal_entity_name,
	"Manage Settlements"
from
	#master_accounts

insert into
	#summary(
		ordering,
		style,
		product_id,
		product,
		bo_master_account_id,
		bo_external_account_id,
		bo_external_account,
		bo_external_account_symbol,
		total_balance,
		unallocated_balance,
		allocated_balance)
select
	ordering=2,
	style = @subtotal_style,
	product_id = a.product_id,
	product = b.symbol,
	bo_master_account_id = a.bo_master_account_id,
	bo_external_account_id = a.bo_external_account_id,
	bo_external_account = c.symbol,
	bo_external_account_symbol = c.symbol,
	total_balance = a.total_balance,
	unallocated_balance = a.unallocated_balance,
	allocated_balance = a.allocated_balance
from
	#bo_master_balances a,
	products b,
	external_accounts c
where
	a.product_id = b.product_id
and
	a.bo_external_account_id = c.external_account_id


insert into	
	#summary(
		ordering,
		style,
		product_id,
		product,
		bo_master_account_id,
                bo_external_account_id,
                bo_external_account,
                bo_external_account_symbol,
		fo_external_account_id,
		fo_external_account,
		fo_external_account_symbol,
		allocated_balance,
		unsettled_balance,
		deposit,
		withdrawal)
select
        ordering=3,
        style = @style,
        product_id = a.product_id,
        product = b.symbol,
        bo_master_account_id = a.bo_master_account_id,
        bo_external_account_id = a.bo_external_account_id,
        bo_external_account = c.symbol,
        bo_external_account_symbol = c.symbol,
	fo_external_account_id = a.fo_external_account_id,
	fo_external_account = d.symbol,
	fo_external_account_symbol = d.symbol,
	allocated_balance = a.amount,
	unsettled_balance = NULL,
	deposit = "Deposit",
	withdrawal = "Withdrawal"
from
	#fo_sub_balances a,
	products b,
	external_accounts c,
	external_accounts d
where
	a.product_id = b.product_id
and
	a.bo_external_account_id = c.external_account_id
and
	a.fo_external_account_id = d.external_account_id

update 
	#summary
set
	bo_master_account = bo_external_account
where
	ordering in(1, 2)

update 
	#summary
set
	fo_sub_account = fo_external_account

update 
	#summary
set
	unsettled_balance = b.quantity
from
	#summary a,
	#product_positions b
where
	a.fo_external_account_id = b.external_account_id
and
	a.product_id = b.product_id
	

/*-------------------------------------------------------------------
 * SELECT OUT 
 *------------------------------------------------------------------*/
select 
	*
from
	#meta

/*------------
select 
	section = "Trading Balances",
	style = @style,
	* 
from
	#product_positions
*/

select
	section = "Account Balances",
	legal_entity,
        bo_master_account,
	fo_sub_account,
	product, 	
	total_balance,
	unallocated_balance,
        allocated_balance,
	unsettled_balance,
	deposit,
	withdrawal,
	manage_settlements,
	style
from
	#summary
order by
	bo_external_account,
	product,
	ordering,
	fo_external_account
	
	

select
	section = "Allocation Requests - Open",
	style = @style,
	a.allocation_request_id,
	requestor = b.login,
	status = c.name,
	master_account = h.symbol,
	sub_account = e.symbol,
	product = f.symbol,
	a.amount,
	a.request_date,
	a.respond_timestamp
from
	allocation_requests a,
	tico_accounts b,
	statuses c,
	fo_sub_accounts d,
	external_accounts e,
	products f,
	bo_master_accounts g,
	external_accounts h
where
	a.requestor_id = b.account_id
and
	a.status_id = c.status_id
and
	a.fo_sub_account_id = d.fo_sub_account_id
and
	d.external_account_id = e.external_account_id
and
	a.product_id = f.product_id
and
	d.bo_master_account_id = g.bo_master_account_id
and
	g.external_account_id = h.external_account_id
and
	c.name in("New", "Pending")
order by
	request_date DESC

select
        section = "Allocation Requests - Closed",
        style = @style,
        a.allocation_request_id,
        requestor = b.login,
        status = case c.name when 'Rejected' then "<b><font color='FF0000'>Rejected</font></b>" else "<b><font color='00CC00'>"+rtrim(c.name)+"</font></b>" end,
        master_account = h.symbol,
        sub_account = e.symbol,
        product = f.symbol,
        a.amount,
        a.request_date,
        a.respond_timestamp
from
        allocation_requests a,
        tico_accounts b,
        statuses c,
        fo_sub_accounts d,
        external_accounts e,
        products f,
        bo_master_accounts g,
        external_accounts h
where
        a.requestor_id = b.account_id
and
        a.status_id = c.status_id
and
        a.fo_sub_account_id = d.fo_sub_account_id
and
        d.external_account_id = e.external_account_id
and
        a.product_id = f.product_id
and
        d.bo_master_account_id = g.bo_master_account_id
and
        g.external_account_id = h.external_account_id
and
        c.name not in("New", "Pending")
order by
	request_date DESC



	


			
go



