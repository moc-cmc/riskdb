use
	risk_futdemo
go

drop procedure
	cta_runacctpl
go
create procedure
	cta_runacctpl
		@login char(30),
		@account char(200),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as
declare @delta_count int
declare @sorting char(100)
declare @run_id int
declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @net_change float
declare @positions int
declare @trades int
declare @trade_id int
declare @trade_date datetime
declare @contract_id int
declare @quantity numeric(30,2)
declare @trade_price float
declare @open_price float
declare @begin_value float
declare @close_price float
declare @end_value float
declare @start_price float
declare @last_price float
declare @p_l float
declare @native_currency_id int
declare @native_pl float
declare @default_day datetime
declare @trader_id int
declare @broker_id int
declare @contracts int
declare @pos_pl float
declare @trade_pl float
declare @current_position numeric(30,2)
declare @total_pos_pl float
declare @total_deltas_pl float
declare @total_day_trade_pl float
declare @total_pl float
declare @total_pl_string char(40)
declare @trade_total numeric(30,2)
declare @curr_adj_trade_total numeric(30,0)
declare @pos_total numeric(30,2)
declare @perspective_contract_id int
declare @delta float
declare @price_style char(100)
declare @price_factor float
declare @has_deltas int
declare @product_region char(10)
declare @sales_code varchar(50)
declare @sales_code_id int


declare @product_id int
declare @get_product_id int
declare @get_product_qty float
declare @give_product_id int
declare @give_product_qty float
declare @usd_equivalent_qty float
declare @total_longs float
declare @total_shorts float
declare @resid_status_id int
declare @has_exposure int
declare @is_expired int
declare @instrument char(100)

declare @deal_id int
declare @value_date datetime
declare @value_dates int
declare @pl_view_style char(50)
declare @product_type_id int

declare @e_id int

declare @non_opt_native_total_pl float
declare @non_opt_usd_total_pl float
declare @non_opt_native_trades_pl float
declare @non_opt_native_pos_pl float
declare @non_opt_usd_trades_pl float
declare @non_opt_usd_pos_pl float

declare @day varchar(4)
declare @month varchar(4)
declare @year varchar(4)
declare @datestring char(20)
declare @today datetime
declare @now datetime

declare @external_account_type varchar(20)
declare @external_account_id int
declare @counterparty_id int
declare @style varchar(30)

declare @client_broker varchar(50)
declare @client_ext_account varchar(50)
declare @symbol varchar(50)
declare @cpty varchar(50)
declare @cpty_broker varchar(50)

declare @client_qty numeric(30,4)
declare @client_rate float
declare @market_qty numeric(30,4)
declare @market_rate float

declare @trade_type varchar(50)
declare @deal_qty numeric(30,4)
declare @near_sign float
declare @run_name varchar(50)

select
	@run_name = "Mokena Cap"

select
	@now = getdate()
select
	@day = convert(varchar(4), datepart(day, @now)),
	@month = convert(varchar(4), datepart(month, @now)),
	@year = convert(varchar(4), datepart(year, @now))

select
	@datestring = rtrim(@month) + "/" + rtrim(@day) + "/" + rtrim(@year)

	select
		@today = convert(datetime, @datestring)


create table
	#product_types(
		product_type_id int,
		trades_pl float NULL,
		pos_pl float NULL,
		total_pl float NULL)
	

select
	@pl_view_style = a.name,
	@sorting = d.name
from
	pl_view_styles a,
	fwd_pl_preferences b,
	tico_accounts c,
	sorting_styles d
where
	a.pl_view_style_id = b.pl_view_style_id
and
	b.ti_account_id = c.account_id
and
	b.sorting_style_id = d.sorting_style_id
and
	c.login = @login
if @@rowcount = 0
	select
		@pl_view_style = "Default",
		@sorting = "By Contract"


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)

create table
	#prices(
		contract_id int,
		price_date datetime,
		value_date datetime NULL,
		price float NULL)

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	external_accounts
where
	symbol = @account
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts


create table
	#positions(
		contract_id int,
		value_date datetime,
		quantity numeric(30,4),
		trade_date datetime,
		open_price float NULL,
		close_price float NULL,
		change float NULL,
		p_l float NULL,
		native_currency_id int NULL,
		native_pl float NULL,
		product_type_id int NULL)
		
insert into
	#positions(
		contract_id,
		value_date,
		quantity,
		trade_date)
select
	a.contract_id,
	a.value_date,
	sum(convert(numeric(30,2), a.quantity)),
	max(a.trade_date)
from
	trades a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.trade_date <= @begin_date
group by
	a.contract_id,
	a.value_date
	

create table
	#agency_view(
		deal_id int,
		trade_date datetime,
		client_broker varchar(50) NULL,
		sales_code varchar(50) NULL,
		client_ext_account varchar(50) NULL,
		symbol varchar(50) NULL,
		value_date varchar(11) NULL,
		client_qty numeric(30,4) NULL,
		client_rate float NULL,
		market_qty numeric(30,4) NULL,
		market_rate float NULL,
		cpty varchar(50) NULL,
		cpty_broker varchar(50) NULL,	
		total_pl float NULL)

create table
	#trades(
		trade_id int,
		deal_id int,
		contract_id int,
		value_date datetime NULL,
		quantity numeric(30,2),
		trade_date datetime,
		price float,
		close_price float NULL,
		change float NULL,
		p_l float NULL,
		native_currency_id int NULL,
		native_pl float NULL)

create table
	#deals(
		style varchar(35) NULL,
		deal_id int,
		trade_id int,
		contract_id int,
		value_date datetime NULL,
		quantity numeric(30,2),
		trade_date datetime,
		trade_price float,
		close_price float NULL,
		change float NULL,
		p_l float NULL,
		broker_id int,
		trader_id int,
		external_account_id int,
		counterparty_id int,
		sales_code_id int)



insert into
	#trades
select
	a.trade_id,
	a.deal_id,
	a.contract_id,
	NULL,
	convert(numeric(30,2), a.quantity),
	a.trade_date,
	a.price,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL
from
	trades a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	trade_date >= @begin_date
and
	trade_date <= @end_date


select
	@contract_id = 0
select
	@positions = count(*)
from
	#positions
where
	contract_id > @contract_id

while @positions > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#positions
	where
		contract_id > @contract_id

	select
		@value_date = "1/1/1970"

	select
		@value_dates = count(*)
	from
		#positions
	where
		contract_id = @contract_id
	and
		value_date > @value_date


	while @value_dates > 0
	begin
		select
			@value_date = min(value_date)
		from
			#positions
		where
			value_date > @value_date
		and
			contract_id = @contract_id


		select
			@quantity = quantity
		from
			#positions
		where
			contract_id = @contract_id
		and
			value_date = @value_date

		select
			@open_price = NULL,
			@close_price = NULL,
			@p_l = NULL,
			@begin_value = NULL,
			@end_value = NULL,
			@native_currency_id = NULL,
			@native_pl = NULL

	
		exec
			zr_posplfordate
				"Intraday",
				@contract_id, 
				@value_date,
				@quantity,
				@begin_date,
				@end_date,
				@open_price output,
				@begin_value output,
				@close_price output,
				@end_value output,
				@p_l output,
				@native_currency_id output,
				@native_pl output


		update
			#prices
		set
			price = @open_price
		where
			contract_id = @contract_id
		and
			price_date = @begin_date
		and
			value_date = @value_date
		if @@rowcount != 1
			insert into
				#prices
			values(
				@contract_id,
				@begin_date,
				@value_date,
				@open_price)

		update
			#prices
		set
			price = @close_price
		where
			contract_id = @contract_id
		and
			price_date = @end_date
		and
			value_date = @value_date
		if @@rowcount != 1
			insert into
				#prices
			values(
				@contract_id,
				@end_date,
				@value_date,
				@close_price)

			
		exec
			r_contractproducttype
				@contract_id,
				@product_type_id output
	
		if @p_l = NULL
		begin
			select
				@e_id = -1
				/* error = "Found NULL p&l for contract",
				contract_id = @contract_id */
		end
		else
		begin
			update
				#product_types
			set
				pos_pl = pos_pl + @p_l,
				total_pl = total_pl + @p_l
			where
				product_type_id = @product_type_id
			if @@rowcount != 1
				insert into
					#product_types
				values(
					@product_type_id,
					0,
					@p_l,
					@p_l)
		end
		
		select
			@price_style = NULL,
			@price_factor = NULL
		select
			@price_style = a.name,
			@price_factor = b.factor
		from
			price_styles a,
			contract_price_styles b
		where
			a.price_style_id = b.price_style_id
		and
			b.contract_id = @contract_id
	
		if @price_factor = NULL
			select
				@price_factor = 1.0
		
		if @price_style = "Inverted"
		begin
			select
				@open_price = 1 / @open_price,
				@close_price = 1 / @close_price
		end
	
		select
			@open_price = @open_price * @price_factor,
			@close_price = @close_price * @price_factor
	
		update
			#positions
		set
			open_price = @open_price,
			close_price = @close_price,
			change = @close_price - @open_price,
			p_l = @p_l,
			native_currency_id = @native_currency_id,
			native_pl = @native_pl,
			product_type_id = @product_type_id
		where
			contract_id = @contract_id
		and
			value_date = @value_date
	

		select
			@value_dates = count(*)
		from
			#positions
		where
			contract_id = @contract_id
		and
			value_date > @value_date
	end

	select
		@positions = count(*)
	from
		#positions
	where
		contract_id > @contract_id
end
	

select
	@trade_id = 0
select
	@trades = count(*)
from
	#trades
where
	trade_id > @trade_id


while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#trades
	where
		trade_id > @trade_id

	select
		@deal_id = deal_id,
		@trade_date = trade_date,
		@contract_id = contract_id,
		@quantity = quantity,
		@trade_price = price,
		@close_price = NULL,
		@p_l = NULL,
		@native_currency_id = NULL,
		@native_pl = NULL
	from
		#trades
	where
		trade_id = @trade_id

	select
		@trader_id = trader_id,
		@broker_id = broker_id,
		@external_account_id = external_account_id,
		@sales_code_id = sales_code_id,
		@counterparty_id = counterparty_id
	from
		trades
	where
		trade_id = @trade_id

	select
		@external_account_type = a.name
	from
		external_account_types a,
		external_accounts b
	where
		a.external_account_type_id = b.external_account_type_id
	and
		b.external_account_id = @external_account_id

	select
		@style = NULL

	if @external_account_type = "Client"
		select
			@style = "background:#CCFF99"
	if @external_account_type = "Counterparty"
		select
			@style = "background:#FFFF99"

	select
		@value_date= NULL
	select
		@value_date = value_date
	from
		trades
	where
		trade_id = @trade_id
	if @value_date = NULL
		exec
			r_contractexpiration
				@contract_id,
				@value_date output
	if @value_date = NULL
		select 
			@value_date = @today
		
	update
		#trades
	set
		value_date = @value_date
	where
		trade_id = @trade_id


	exec
		zr_tradeplfordate
			"Intraday",
			@trade_id,
			@quantity,
			@trade_price,
			@begin_value output,
			@end_date,
			@close_price output,
			@end_value output,
			@p_l output,
			@native_currency_id output,
			@native_pl output

	
	update
		#prices
	set
		price = @close_price
	where
		contract_id = @contract_id
	and
		value_date = @value_date
	and
		price_date = @end_date
	if @@rowcount != 1
		insert into
			#prices
		values(
			@contract_id,
			@end_date,
			@value_date,
			@close_price)

	if @p_l = NULL
	begin
		select
			@e_id = -1
			/* error = "Found NULL trades p&l for contract",
			contract_id = @contract_id */
	end
	else
	begin
		exec
			r_contractproducttype
				@contract_id,
				@product_type_id output

		update
			#product_types
		set
			trades_pl = trades_pl + @p_l,
			total_pl = total_pl + @p_l
		where
			product_type_id = @product_type_id
		if @@rowcount != 1
			insert into
				#product_types
			values(
				@product_type_id,
				@p_l,
				0,
				@p_l)
	end


	select
		@price_style = NULL,
		@price_factor = NULL

	select
		@price_style = a.name,
		@price_factor = b.factor
	from
		price_styles a,
		contract_price_styles b
	where
		a.price_style_id = b.price_style_id
	and
		b.contract_id = @contract_id

	if @price_factor = NULL
		select
			@price_factor = 1.0

	if @price_style = "Inverted"
	begin
		select
			@trade_price = 1 / @trade_price,
			@close_price = 1 / @close_price
	end

	select
		@trade_price = @trade_price * @price_factor,
		@close_price = @close_price * @price_factor


	update
		#trades
	set
		price = @trade_price,
		close_price = @close_price,
		change = @close_price - @trade_price,
		p_l = @p_l,
		native_currency_id = @native_currency_id,
		native_pl = @native_pl
	where
		trade_id = @trade_id


	if @pl_view_style = "Agency"
	begin
		select
			@client_broker = NULL,
			@sales_code = NULL,
			@client_ext_account = NULL,
			@symbol = NULL,
			@cpty = NULL,
			@cpty_broker = NULL,
			@client_qty = NULL,
			@client_rate = NULL,
			@market_qty = NULL,
			@market_rate = NULL,
			@deal_qty = NULL

		if @external_account_type = "Client" or @external_account_type = "Internal"
		begin
			select
				@client_broker = a.symbol,
				@sales_code = c.name,
				@client_ext_account = d.symbol,
				@client_qty = b.quantity,
				@client_rate = b.price,
				@symbol = e.symbol
			from
				brokers a,
				trades b,
				sales_codes c,
				external_accounts d,
				contracts e
			where
				a.broker_id = b.broker_id
			and
				b.sales_code_id = c.sales_code_id
			and
				b.external_account_id = d.external_account_id
			and
				b.contract_id = e.contract_id
			and
				b.trade_id = @trade_id

			if @price_style = "Inverted"
				select
					@client_rate = 1.0 / @client_rate 

			select
				@trade_type = a.name
			from
				trade_types a,
				trades b
			where
				a.trade_type_id = b.trade_type_id
			and
				b.trade_id = @trade_id


			if @trade_type in("Swap Near", "Swap Far")
			begin
				select
					@near_sign = sign(a.quantity)
				from
					trades a,
					trade_types b,
					external_accounts c,
					external_account_types d
				where
					a.trade_type_id = b.trade_type_id
				and
					a.external_account_id = c.external_account_id
				and
					c.external_account_type_id = d.external_account_type_id
				and
					a.deal_id = @deal_id
				and
					d.name = "Client"
				and
					b.name = "Swap Near"

				select
					@deal_qty = sum(abs(a.quantity))
				from
					trades a,
					external_accounts b,
					external_account_types c,
					trade_types d
				where
					a.external_account_id = b.external_account_id
				and
					b.external_account_type_id = c.external_account_type_id
				and
					a.trade_type_id = d.trade_type_id
				and
					a.deal_id = @deal_id
				and
					c.name = "Client"
				and
					d.name = "Swap Near"
				and
					sign(a.quantity) = @near_sign
			end
			else
			begin
				select
					@deal_qty = client_qty + @client_qty
				from
					#agency_view
				where
					deal_id = @deal_id
				if @deal_qty = NULL
					select
						@deal_qty = @client_qty
			end
				
			update
				#agency_view
			set
				trade_date = @trade_date,
				client_broker = @client_broker,
				sales_code = @sales_code,
				client_ext_account = @client_ext_account,
				symbol = @symbol,
				value_date = convert(varchar(11), @value_date, 1),
				client_qty = @deal_qty,
				client_rate = @client_rate,
				total_pl = total_pl + @p_l
			where
				deal_id = @deal_id
			if @@rowcount = 0
			begin
				insert into
					#agency_view(
						deal_id,
						trade_date,
						client_broker,
						sales_code,
						client_ext_account,
						symbol,
						value_date,
						client_qty,
						client_rate,
						market_qty,
						total_pl)
				values(
					@deal_id,
					@trade_date,
					@client_broker,
					@sales_code,
					@client_ext_account,
					@symbol,
					convert(varchar(11), @value_date, 1),
					@deal_qty,
					@client_rate,
					0.0,
					@p_l)
			end	
				
		end

		if @external_account_type = "Counterparty"
		begin
			select
				@cpty = a.name,
				@cpty_broker = b.symbol,
				@market_qty = c.quantity,
				@market_rate = c.price,
				@symbol = d.symbol
			from
				counterparties a,
				brokers b,
				trades c,
				contracts d
			where
				a.counterparty_id = c.counterparty_id
			and
				b.broker_id = c.broker_id
			and
				c.contract_id = d.contract_id
			and
				c.trade_id = @trade_id


			if @price_style = "Inverted"
				select
					@market_rate = 1.0 / @market_rate 
			select
				@trade_type = a.name
			from
				trade_types a,
				trades b
			where
				a.trade_type_id = b.trade_type_id
			and
				b.trade_id = @trade_id

			if @trade_type in("Swap Near", "Swap Far")
			begin
				select
					@near_sign = sign(a.quantity)
				from
					trades a,
					trade_types b,
					external_accounts c,
					external_account_types d
				where
					a.trade_type_id = b.trade_type_id
				and
					a.external_account_id = c.external_account_id
				and
					c.external_account_type_id = d.external_account_type_id
				and
					a.deal_id = @deal_id
				and
					d.name = "Counterparty"
				and
					b.name = "Swap Near"

				select
					@deal_qty = sum(abs(a.quantity))
				from
					trades a,
					external_accounts b,
					external_account_types c,
					trade_types d
				where
					a.external_account_id = b.external_account_id
				and
					b.external_account_type_id = c.external_account_type_id
				and
					a.trade_type_id = d.trade_type_id
				and
					a.deal_id = @deal_id
				and
					c.name = "Counterparty"
				and
					d.name = "Swap Near"
				and
					sign(a.quantity) = @near_sign
			end
			else
			begin
				select
					@deal_qty = market_qty + @market_qty
				from
					#agency_view
				where
					deal_id = @deal_id
				if @deal_qty = NULL
					select
						@deal_qty = @market_qty
			end

			update
				#agency_view
			set
				cpty = @cpty,
				cpty_broker = @cpty_broker,
				market_qty = @deal_qty,
				market_rate = @market_rate,
				total_pl = total_pl + @p_l
			where
				deal_id = @deal_id
			if @@rowcount = 0
			begin
				insert into
					#agency_view(
						deal_id,
						trade_date,
						client_qty,
						symbol,
						value_date,
						market_qty,
						market_rate,
						cpty,
						cpty_broker,
						total_pl)
				values(
					@deal_id,
					@trade_date,
					0.0,
					@symbol,
					convert(varchar(11), @value_date, 1),
					@deal_qty,
					@market_rate,
					@cpty,
					@cpty_broker,
					@p_l)
			end
		end
	end

	update
		#deals
	set
		quantity = quantity + @quantity,
		p_l = p_l + @p_l,
		trade_date = @trade_date,
		close_price = @close_price,
		change = @close_price - @trade_price,
		trader_id = @trader_id,
		broker_id = @broker_id,
		external_account_id = @external_account_id,
		sales_code_id = @sales_code_id,
		counterparty_id = @counterparty_id
	where
		deal_id = @deal_id
	and
		contract_id = @contract_id
	and
		value_date = @value_date
	and
		convert(char(30), convert(numeric(30,4), trade_price)) = convert(char(30), convert(numeric(30,4), @trade_price))
	and
		sign(quantity) = sign(@quantity)
	if @@rowcount != 1
	begin
		insert into
			#deals
		values(
			@style,
			@deal_id,
			@trade_id,
			@contract_id,
			@value_date,
			@quantity,
			@trade_date,
