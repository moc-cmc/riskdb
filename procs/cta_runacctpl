create table
	#value_dates(
		value_date datetime NULL)

select
	@contract_id = 0
select
	@contracts = count(*)
from
	#contracts
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#contracts
	where
		contract_id > @contract_id	

	select
		@value_date = "1/1/1970"
	
	delete

	from
		#value_dates
	where
		value_date > @value_date

	insert into
		#value_dates
	select
		value_date
	from
		#trades
	where
		contract_id = @contract_id

	insert into
		#value_dates
	select
		value_date
	from
		#positions
	where
		contract_id = @contract_id

	select
		@value_dates = count(*)
	from
		#value_dates
	where
		value_date > @value_date

	while @value_dates > 0
	begin
		select
			@value_date = min(value_date)
		from
			#value_dates
		where
			value_date > @value_date

		select
			@current_position = NULL,
			@trade_pl = NULL,
			@pos_pl = NULL
	
		select
			@trade_total = sum(a.quantity)
		from
			#trades a,
			trades b,
			strategies c
		where
			a.contract_id = @contract_id
		and
			a.trade_id = b.trade_id
		and
			b.strategy_id = c.strategy_id
		and
			a.value_date = @value_date
		and
			c.name != "Currency Balance Management"
		if @trade_total = NULL
			select
				@trade_total = 0
	
		select
			@pos_total = sum(quantity)
		from
			#positions
		where
			contract_id = @contract_id
		and
			value_date = @value_date
		if @pos_total = NULL
			select
				@pos_total = 0
	
		select
			@current_position = @trade_total + @pos_total
	
		select
			@perspective_contract_id = NULL,
			@delta = NULL
	
		select
			@instrument = a.name
		from
			instruments a,
			contracts b
		where
			a.instrument_id = b.instrument_id
		and
			b.contract_id = @contract_id
	
		select @product_id = NULL

		exec
			r_contractproducttype
				@contract_id,
				@product_type_id output
		exec
			r_contractproduct
				@contract_id,
				@product_id output
		
		select @product_region = NULL	

		select
			@product_region	= a.name
		from
			regions a,
			product_regions b
		where
			b.product_id = @product_id
		and
			a.region_id = b.region_id


		if
			@product_region = NULL
		select
			@product_region = "Global"

		/*select @contract_id, @product_id, @product_region */
	
		if @instrument = "Forward" or @instrument = "Future"
		begin
			exec
				b_contractdelta
					@run_id,
					@end_date,
					@contract_id,
					@current_position,
					@perspective_contract_id output,
					@delta output
		
			if @delta != NULL
			begin
				select
					@non_opt_native_total_pl = NULL,
					@non_opt_usd_total_pl = NULL,
					@non_opt_native_trades_pl = NULL,
					@non_opt_native_pos_pl = NULL,
					@non_opt_usd_trades_pl = NULL,
					@non_opt_usd_pos_pl = NULL 
	
				select
					@non_opt_native_trades_pl = sum(native_pl),
					@non_opt_usd_trades_pl = sum(p_l)
				from
					#trades
				where
					contract_id = @contract_id
	
				if @non_opt_native_trades_pl = NULL
					select
						@non_opt_native_trades_pl = 0.0,
						@non_opt_usd_trades_pl = 0.0
				
				select
					@non_opt_native_pos_pl = sum(native_pl),
					@non_opt_usd_pos_pl = sum(p_l)
				from
					#positions
				where
					contract_id = @contract_id
	
				if @non_opt_native_pos_pl = NULL
					select
						@non_opt_native_pos_pl = 0.0,
						@non_opt_usd_pos_pl = 0.0
	
	
				select
					@non_opt_native_total_pl = @non_opt_native_trades_pl + @non_opt_native_pos_pl,
					@non_opt_usd_total_pl = @non_opt_usd_trades_pl + @non_opt_usd_pos_pl
	
				update
					#deltas
				set
					delta = delta + @delta,
					total_delta = total_delta + @delta,
					non_opt_native_pl = non_opt_native_pl + @non_opt_native_total_pl,
					non_opt_usd_pl = non_opt_usd_pl + @non_opt_usd_total_pl
				where
					contract_id = @perspective_contract_id
				if @@rowcount != 1
					insert into
						#deltas
					values(
						@perspective_contract_id,
						@delta,
						0,
						@delta,
						0,
						@product_type_id,
						@non_opt_native_total_pl,
						@non_opt_usd_total_pl,
						NULL,
						NULL,
						1.0,
						@product_region
						)
			end
		end
		else
		begin
	
			exec
				r_optcontractdelta
					@run_id,
					@contract_id,
					@current_position,
					@end_date,
					@perspective_contract_id output,
					@delta output
	
			if @delta = NULL
				select
					@delta = 0
	
	
			if @delta != NULL
			begin
				update
					#deltas
				set
					option_delta = option_delta + @delta,
					total_delta = total_delta + @delta
				where
					contract_id = @perspective_contract_id
				if @@rowcount != 1
					insert into
						#deltas
					values(
						@perspective_contract_id,
						0,
						@delta,
						@delta,
						0,
						@product_type_id,
						0.0,
						0.0,
						NULL,
						NULL,
						1.0,
						@product_region)
			end
	
		end
	
		select
			@trade_pl = sum(a.p_l)
		from
			#trades a,
			trades b,
			strategies c
		where
			a.contract_id = @contract_id
		and
			a.trade_id = b.trade_id
		and
			b.strategy_id = c.strategy_id
		and
			a.value_date = @value_date
		and
			c.name != "Currency Balance Management"
		if @trade_pl = NULL
		begin
			select
				@trade_pl = 0
		end
	
		select
			@pos_pl = sum(p_l)
		from
			#positions
		where
			contract_id = @contract_id
		and
			value_date = @value_date
		if @pos_pl = NULL
			select
				@pos_pl = 0
	
	
		/* NEW PART TESTING TESTING*/
		update
			#deltas
		set
			p_l = p_l + @trade_pl + @pos_pl
		where
			contract_id = @perspective_contract_id
	
		update
			#deltas
		set
			last_price = a.price
		from
			current_prices a,
			#deltas b
		where
			a.contract_id = b.contract_id /* TEST */
	
		update
			#deltas
		set
			multiplier = a.quantity
		from
			futures a,
			future_contracts b,
			#deltas c
		where
			a.future_id = b.future_id
		and
			b.contract_id = c.contract_id
	
		update
			#deltas
		set
			implied_entry = last_price - (non_opt_native_pl / (delta * multiplier))
		where
			delta != 0
	
		select
			@net_change = NULL
	
		select
			@price_style = NULL

		select
			@last_price = NULL,
			@start_price = NULL

		select
			@last_price = price
		from
			#prices
		where
			contract_id = @contract_id
		and
			value_date = @value_date
		and
			price_date = @end_date
		select
			@start_price = price
		from
			#prices
		where
			contract_id = @contract_id
		and
			value_date = @value_date
		and
			price_date = @begin_date

		select
			@price_style = a.name
		from
			price_styles a,
			contract_price_styles b
		where
			a.price_style_id = b.price_style_id
		and
			b.contract_id = @contract_id

		if @price_style = "Inverted"
		begin
			select
				@last_price = 1.0 / @last_price,
				@start_price = 1.0 / @start_price

		end

		if @start_price != NULL
			select
				@net_change = @last_price - @start_price
		else
			select
				@net_change = NULL

		select
			@is_expired = NULL
	
		exec
			r_isexpired
				@contract_id,
				@begin_date,
				@is_expired output
	
		exec
			r_contractproducttype
				@contract_id,
				@product_type_id output
	
		if @is_expired = NULL
			select
				@is_expired = 0
	
		if @is_expired = 0
			insert into
				#breakdown
			values(
				@contract_id,
				@value_date,
				@pos_total,
				@trade_total,
				@current_position,
				@pos_pl,
				@trade_pl,
				@net_change,
				@last_price,
				@product_type_id)
		
		select
			@value_dates = count(*)
		from
			#value_dates
		where
			value_date > @value_date
	end

	select
		@contracts = count(*)
	from
		#contracts
	where
		contract_id > @contract_id
end
	
	
	
