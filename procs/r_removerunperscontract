
if object_id("r_removerunperscontract") != NULL
    drop procedure
        r_removerunperscontract
go

create procedure
	r_removerunperscontract
		@login char(30),
		@run_name char(100),
		@forward_symbol char(50),
		@perspective_contract char(50)
as

declare @run_id int
declare @contract_id int
declare @perspective_contract_id int


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	a.name = @run_name
and
	c.login = @login

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @forward_symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract with symbol",
		forward_symbol = @forward_symbol
	return
end

select
	@perspective_contract_id = contract_id
from
	contracts
where
	symbol = @perspective_contract
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding perspective contract wth symbol",
		perspective_contract = @perspective_contract
	return
end

if @run_id != NULL
begin
	delete
	
	from
		run_perspective_contracts
	where
		run_id = @run_id
	and
		contract_id = @contract_id
	and
		perspective_contract_id = @perspective_contract_id
end
else
begin
	delete

	from
		def_perspective_contracts
	where
		contract_id = @contract_id
	and
		perspective_contract_id = @perspective_contract_id
end


exec
	r_defperspectivecontracts
		@login


go
