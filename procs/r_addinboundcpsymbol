
drop procedure
	r_addinboundcpsymbol	
go


create procedure
	r_addinboundcpsymbol
		@login varchar(25),
		@name varchar(100),
		@inbound_source varchar(100),
		@symbol varchar(100)
as

exec
	api_addcounterpartysymbol
			@login=@login,
			@name=@name,
			@symbol=@symbol,
			@source=@inbound_source

exec
	r_mappingoverview
			@login=@login

return

go

