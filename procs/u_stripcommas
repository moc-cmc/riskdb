use
	risk_admis
go

drop procedure
	u_stripcommas
go

create procedure
	u_stripcommas
		@comma_string varchar(200),
		@commas_removed_string varchar(200) output

as


declare @comma_index int
declare @comma int
declare @counter int

select
	@counter = 0
select
	@comma = charindex(",", @comma_string)

select
	@commas_removed_string = @comma_string

while @comma != 0 and @counter < 10
begin 

	select
		@comma = charindex(",", @commas_removed_string)
		
	select
		@commas_removed_string = stuff(@commas_removed_string, @comma, 1, NULL)
	select
		@comma = charindex(",", @commas_removed_string)

	select
		@counter = @counter + 1
		
end


go

