create table
	#trades(
		trade_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		identifier varchar(100) NULL,
		)
/*
| Insert *_ids into #trades that need to be notified 
*/
insert into
	#trades
(
	trade_id,
	trade_type_id,
	trade_type,
	identifier
)
select 
	trade_id = a.trade_id,
	trade_type_id = a.trade_type_id,
	trade_type = h.name,
	identifier = a.identifier
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	trade_types h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_type_id = h.trade_type_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date
and
	a.quantity != 0

insert into
        #trades
(
        trade_id,
        trade_type_id,
        trade_type,
        identifier
)
select
        trade_id = a.trade_id,
        trade_type_id = a.trade_type_id,
        trade_type = h.name,
        identifier = a.identifier
from
        archive_trades a,
        #external_accounts b,
        #internal_accounts c,
        #traders d,
        #strategies e,
        #brokers f,
        #counterparties g,
        trade_types h
where
        a.external_account_id = b.external_account_id
and
        a.internal_account_id = c.internal_account_id
and
        a.trader_id = d.trader_id
and
        a.strategy_id = e.strategy_id
and
        a.broker_id= f.broker_id
and
        a.counterparty_id = g.counterparty_id
and
        a.trade_type_id = h.trade_type_id
and
        a.trade_date >= @begin_date
and
        a.trade_date <= @end_date
and
        a.quantity != 0

select
	trade_id,
	trade_type,
	identifier
from
        #trades
order by
        trade_id

go
