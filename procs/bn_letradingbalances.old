create or replace procedure
	bn_letradingbalances
		@login varchar(100),
		@legal_entity varchar(100) =NULL

as


declare @begin_date datetime
declare @bo_master_account_id int
declare @bo_external_account_id int
declare @fo_sub_account_id int
declare @legal_entity_id int
declare @tico_account_id int

select
	@begin_date = convert(date, getdate())

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
   @client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
   #meta(
           meta_type char(200),
           name char(50) NULL,
           action char(100) NULL,
           value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Link",
	"deposit",
	"Allocation Request Deposit to Sub Account",
	NULL)

insert into
	#meta
values (
	"Column Link",
	"Withdrawal",
	"Allocation Request Withdrawal From Sub Account",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"total_balance", 
 	"Number",
	"#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")

insert into
        #meta
values(
        "Column Format",
        "unallocated_balance",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")

insert into
        #meta
values(
        "Column Format",
        "allocated_balance",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")

insert into
        #meta
values(
        "Column Format",
        "unsettled_balance",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")
insert into
        #meta
values(
        "Column Format",
        "amount",
        "Number",
        "#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")





create table
	#legal_entities(
		legal_entity_id int
)

if @legal_entity = NULL
begin
	insert into
		#legal_entities
	select
		legal_entity_id
	from
		legal_entities
end
else
begin

	select
		@legal_entity_id = legal_entity_id
	from
		legal_entities
	where
		name = @legal_entity
	if @legal_entity_id = NULL
	begin
		select
			status = "Error",
			message = "Problem finding legal_entity",
			legal_entity = @legal_entity
		return
	end
	insert into
		#legal_entities
	values(
		@legal_entity_id
	)
end



create table
	#master_accounts(
                legal_entity_id int,
		legal_entity_name varchar(100),
                bo_master_account_id int,
                bo_external_account_id int,
		bo_external_account_symbol varchar(100),
		bo_external_account_name varchar(100)
)



create table
	#master_balances(
		legal_entity_id int,
		bo_master_account_id int,
		bo_external_account_id int,
		product_id int,
		amount float
)

create table
        #master_pending_balances(
                legal_entity_id int,
                bo_master_account_id int,
                bo_external_account_id int,
                product_id int,
                amount float
)

		
create table
	#fo_sub_balances(
		legal_entity_id int,
		bo_master_account_id int,
		bo_external_account_id int,
		fo_sub_account_id int,
		fo_external_account_id int,
		product_id int,
		amount float
) 



insert into
        #master_accounts
select
        a.legal_entity_id,
	a.name,
        b.bo_master_account_id,
        b.external_account_id,
	c.symbol,
	c.symbol
from
        legal_entities a,
        bo_master_accounts b,
	external_accounts c,
        #legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.external_account_id = c.external_account_id
and
        a.legal_entity_id = h.legal_entity_id


insert into
	#master_balances
select
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id,
        amount=sum(e.amount)
from
        legal_entities a,
        bo_master_accounts b,
        account_transactions e,
        products g,
	#legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.external_account_id = e.external_account_id
and
        e.currency_id = g.product_id
and
        a.legal_entity_id = h.legal_entity_id
and
        e.transaction_date <= @begin_date
group by
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id

insert into
        #master_pending_balances
select
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id,
        amount=sum(e.amount)
from
        legal_entities a,
        bo_master_accounts b,
        pending_transactions e,
        products g,
        #legal_entities h
where
        a.legal_entity_id = b.legal_entity_id
and
        b.external_account_id = e.external_account_id
and
        e.currency_id = g.product_id
and
        a.legal_entity_id = h.legal_entity_id
and
        e.transaction_date <= @begin_date
group by
        a.legal_entity_id,
        b.bo_master_account_id,
        b.external_account_id,
        g.product_id

update 
	#master_balances
set
	amount = a.amount + b.amount
from
	#master_balances a,
	#master_pending_balances b
where
	a.legal_entity_id = b.legal_entity_id
and
	a.bo_master_account_id = b.bo_master_account_id
and
	a.bo_external_account_id  = b.bo_external_account_id
and
	a.product_id = b.product_id
	

insert into
	#fo_sub_balances(
		legal_entity_id,
		bo_master_account_id,
		bo_external_account_id,
		fo_sub_account_id,
		fo_external_account_id,
		product_id,
		amount
	)
select
	a.legal_entity_id,
	b.bo_master_account_id,
	b.external_account_id,
	c.fo_sub_account_id,
	c.external_account_id,
	g.product_id,
	amount=sum(e.amount)
from
	legal_entities a,
	bo_master_accounts b,
	fo_sub_accounts c,
	external_accounts d,
	account_transactions e,
	products g,
	#legal_entities h
where
	a.legal_entity_id = b.legal_entity_id
and
	b.bo_master_account_id = c.bo_master_account_id
and
	c.external_account_id = d.external_account_id
and
	d.external_account_id = e.external_account_id
and
	e.currency_id = g.product_id
and
	a.legal_entity_id = h.legal_entity_id
and
	e.transaction_date <= @begin_date
group by
	a.legal_entity_id,
	b.bo_master_account_id,
	b.external_account_id,
	c.fo_sub_account_id,
	c.external_account_id,
	g.product_id



/* insert sub account with no balance for product */
create table
	#fo_sub_account_products(
		bo_master_account_id int,
		fo_sub_account_id int,
		external_account_id int,
		product_id int
)

insert into
	#fo_sub_account_products
select
	a.bo_master_account_id,
	a.fo_sub_account_id,
	a.external_account_id,
	b.product_id
from
	fo_sub_accounts a,
	#master_balances b
where
	a.bo_master_account_id = b.bo_master_account_id


delete 
	#fo_sub_account_products
from
	#fo_sub_account_products a,
	#fo_sub_balances b	
where
	a.fo_sub_account_id = b.fo_sub_account_id
and
	a.product_id = b.product_id

insert into
        #fo_sub_balances(
                legal_entity_id,
                bo_master_account_id,
                bo_external_account_id,
                fo_sub_account_id,
                fo_external_account_id,
                product_id,
                amount
        )
select
        a.legal_entity_id,
        a.bo_master_account_id,
        a.bo_external_account_id,
        b.fo_sub_account_id,
        b.external_account_id,
        b.product_id,
        0.00
from
	#master_balances a,
	#fo_sub_account_products b
where
	a.bo_master_account_id = b.bo_master_account_id
and
	a.product_id = b.product_id
	


create table
	#bo_master_balances(
		bo_master_account_id int,
		bo_external_account_id int,
		product_id int,
		unallocated_balance float,
		allocated_balance float,
		total_balance float NULL
)

insert into
	#bo_master_balances (
		bo_master_account_id,
		bo_external_account_id,
		product_id,
		unallocated_balance,
		allocated_balance)
select
	a.bo_master_account_id,
	a.bo_external_account_id,
	a.product_id,
	a.amount,
	sum(b.amount)
from
	#master_balances a,
	#fo_sub_balances b
where
	a.bo_master_account_id = b.bo_master_account_id
and
	a.product_id = b.product_id
group by
	a.bo_master_account_id,
	a.bo_external_account_id,
	a.product_id

update 
	#bo_master_balances
set
	total_balance = unallocated_balance + allocated_balance	

/*select * from #master_balances
select * from #fo_sub_balances
select * from #bo_master_balances*/

create table
	#summary(
		id int identity,
		ordering int,
		style varchar(100),
		product_id int NULL,
		product varchar(20) NULL, 
		bo_master_account_id int,
		bo_external_account_id int,
		bo_master_account varchar(100) NULL,
		bo_external_account varchar(100),
		bo_external_account_symbol varchar(100) NULL,
		fo_external_account_id int NULL,
		fo_sub_account varchar(100) NULL,
		fo_external_account varchar(100) NULL,
		fo_external_account_symbol varchar(100) NULL,
		total_balance float NULL,
		unallocated_balance float NULL,
		allocated_balance float NULL,
		unsettled_balance float NULL,
		deposit varchar(15) NULL,
		withdrawal varchar(15) NULL
)


insert into
        #summary(
                ordering,
                style,
                bo_master_account_id,
                bo_external_account_id,
                bo_external_account,
                bo_external_account_symbol)
select
        ordering=1,
        style = @client_style,
        bo_master_account_id,
        bo_external_account_id,
        bo_external_account_name,
        bo_external_account_symbol
from
	#master_accounts a

insert into
	#summary(
		ordering,
		style,
		product_id,
		product,
		bo_master_account_id,
		bo_external_account_id,
		bo_external_account,
		bo_external_account_symbol,
		total_balance,
		unallocated_balance,
		allocated_balance)
select
	ordering=2,
	style = @subtotal_style,
	product_id = a.product_id,
	product = b.symbol,
	bo_master_account_id = a.bo_master_account_id,
	bo_external_account_id = a.bo_external_account_id,
	bo_external_account = c.symbol,
	bo_external_account_symbol = c.symbol,
	total_balance = a.total_balance,
	unallocated_balance = a.unallocated_balance,
	allocated_balance = a.allocated_balance
from
	#bo_master_balances a,
	products b,
	external_accounts c
where
	a.product_id = b.product_id
and
	a.bo_external_account_id = c.external_account_id


insert into	
	#summary(
		ordering,
		style,
		product_id,
		product,
		bo_master_account_id,
                bo_external_account_id,
                bo_external_account,
                bo_external_account_symbol,
		fo_external_account_id,
		fo_external_account,
		fo_external_account_symbol,
		allocated_balance,
		unsettled_balance,
		deposit,
		withdrawal)
select
        ordering=3,
        style = @style,
        product_id = a.product_id,
        product = b.symbol,
        bo_master_account_id = a.bo_master_account_id,
        bo_external_account_id = a.bo_external_account_id,
        bo_external_account = c.symbol,
        bo_external_account_symbol = c.symbol,
	fo_external_account_id = a.fo_external_account_id,
	fo_external_account = d.symbol,
	fo_external_account_symbol = d.symbol,
	allocated_balance = a.amount,
	unsettled_balance = NULL,
	deposit = "Deposit",
	withdrawal = "Withdrawal"
from
	#fo_sub_balances a,
	products b,
	external_accounts c,
	external_accounts d
where
	a.product_id = b.product_id
and
	a.bo_external_account_id = c.external_account_id
and
	a.fo_external_account_id = d.external_account_id

update 
	#summary
set
	bo_master_account = bo_external_account
where
	ordering in(1, 2)

update 
	#summary
set
	fo_sub_account = fo_external_account

select 
	*
from
	#meta

select
	section = "Account Balances",
        bo_master_account,
	fo_sub_account,
	product, 	
	total_balance,
	unallocated_balance,
        allocated_balance,
	unsettled_balance,
	deposit,
	withdrawal,
	style
from
	#summary
order by
	bo_external_account,
	product,
	ordering,
	fo_external_account
	
	

select
	section = "Allocation Requests - Open",
	style = @style,
	a.allocation_request_id,
	requestor = b.login,
	status = c.name,
	master_account = h.symbol,
	sub_account = e.symbol,
	product = f.symbol,
	a.amount,
	a.request_date,
	a.respond_timestamp
from
	allocation_requests a,
	tico_accounts b,
	statuses c,
	fo_sub_accounts d,
	external_accounts e,
	products f,
	bo_master_accounts g,
	external_accounts h
where
	a.requestor_id = b.account_id
and
	a.status_id = c.status_id
and
	a.fo_sub_account_id = d.fo_sub_account_id
and
	d.external_account_id = e.external_account_id
and
	a.product_id = f.product_id
and
	d.bo_master_account_id = g.bo_master_account_id
and
	g.external_account_id = h.external_account_id
and
	c.name in("New", "Pending")
order by
	request_date DESC

select
        section = "Allocation Requests - Closed",
        style = @style,
        a.allocation_request_id,
        requestor = b.login,
        status = case c.name when 'Rejected' then "<b><font color='FF0000'>Rejected</font></b>" else "<b><font color='00CC00'>"+rtrim(c.name)+"</font></b>" end,
        master_account = h.symbol,
        sub_account = e.symbol,
        product = f.symbol,
        a.amount,
        a.request_date,
        a.respond_timestamp
from
        allocation_requests a,
        tico_accounts b,
        statuses c,
        fo_sub_accounts d,
        external_accounts e,
        products f,
        bo_master_accounts g,
        external_accounts h
where
        a.requestor_id = b.account_id
and
        a.status_id = c.status_id
and
        a.fo_sub_account_id = d.fo_sub_account_id
and
        d.external_account_id = e.external_account_id
and
        a.product_id = f.product_id
and
        d.bo_master_account_id = g.bo_master_account_id
and
        g.external_account_id = h.external_account_id
and
        c.name not in("New", "Pending")
order by
	request_date DESC



	


			
go



