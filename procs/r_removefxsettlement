drop procedure
        r_removefxsettlement
go

create procedure
        r_removefxsettlement
                @login varchar(50),
                @account_transaction int,
                @settled_balance float,
                @value_date datetime,
                @prime_broker varchar(50)

as

declare @account_transaction_id int

select
        @account_transaction_id = @account_transaction

delete from
        account_transactions
where
        account_transaction_id = @account_transaction_id

exec
        cbo_settlementrecon
                @login,
                @value_date,
                @prime_broker



go
