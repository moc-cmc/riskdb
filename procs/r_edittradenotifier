drop procedure
	r_edittradenotifier
go

create procedure
	r_edittradenotifier
		@login varchar(50),
		@trade_notifier_id int,
		@source varchar(50),
		@external_account varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@status varchar(50)=NULL,
		@trade_type varchar(50)=NULL,
		@notification_status varchar(50),
                @notifier_date datetime=NULL


as

declare @external_account_id int 
declare @counterparty_id int 
declare @trader_id int 
declare @strategy_id int 
declare @status_id int 
declare @trade_type_id int
declare @broker_id int 
declare @notification_status_id int
declare @source_id int



select
        @external_account_id = external_account_id
from
        external_accounts
where
        symbol = @external_account
if @@rowcount != 1
begin
        select
                @external_account_id = NULL
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
        select
                @source_id = NULL
end


select
	@counterparty_id = counterparty_id 
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
        select
                @counterparty_id = NULL
end


select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
        select
                @trader_id = NULL
end


select
	@status_id = status_id
from
	statuses
where
	name = @status
if @@rowcount != 1
begin
        select
                @status_id = NULL
end

select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = @trade_type
if @@rowcount != 1
begin
	select
		@trade_type_id = NULL
end


select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
        select
                @broker_id = NULL
end


select
	@notification_status_id = status_id	
from
	statuses
where
	name = @notification_status


if @notifier_date = NULL
begin	
	select
		@notifier_date = getdate()
end

if @source_id != NULL and @notification_status_id !=NULL and @notifier_date != NULL
begin

	update
		trade_notifiers
	set
		source_id = @source_id,
        	external_account_id = @external_account_id,
        	broker_id = @broker_id,
        	trader_id = @trader_id,
        	counterparty_id = @counterparty_id,
        	status_id = @status_id,
		trade_type_id = @trade_type_id,
		notification_status_id = @notification_status_id,
		notifier_date = @notifier_date
	where
		trade_notifier_id = @trade_notifier_id

	select
		msg = "Successfully edited trade notifier",
		source =@source,
                external_account = @external_account,
                broker = @broker,
                trader = @trader,
                counterparty = @counterparty,
                status = @status,
		trade_type = @trade_type,
                notification_status = @notification_status,
                notifier_date = @notifier_date

	exec
        	r_sourcenotifiers
                	@login
end
else
begin
	select
		msg = "Source and Notification can not be NULL",
		source = @source,
		notification_status = @notification_status
end


go
