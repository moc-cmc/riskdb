
if object_id("cm_counterpartymappings") != NULL
    drop procedure
        cm_counterpartymappings
go

create procedure
	cm_counterpartymappings
		@login varchar(50),
		@counterparty varchar(50)
as

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"del_mapping",
	"Delete Counterparty Mapping",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"add_mapping",
	"Add Counterparty Mapping",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"edit_mapping",
	"Edit Counterparty Mapping",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	add_mapping = "Add Mapping",
	counterparty = @counterparty


select
	counterparty = a.name,
	source = b.name,
	mapping = c.symbol,
	edit_mapping = "EDIT",
	del_mapping = "DELETE"
from
	counterparties a,
	sources b,
	counterparty_symbols c
where
	a.counterparty_id = c.counterparty_id
and
	b.source_id = c.source_id
and
	a.name = @counterparty
order by
	b.name,
	a.name


go
