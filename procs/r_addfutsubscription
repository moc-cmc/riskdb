
if object_id("r_addfutsubscription") != NULL
    drop procedure
        r_addfutsubscription
go

create procedure
	r_addfutsubscription
		@login varchar(50),
		@future varchar(50),
		@root_symbol varchar(10),
		@exchange varchar(50),
		@evaluation_currency varchar(50)
as


declare @db_name varchar(30)
declare @servername varchar(30)
declare @sql_string varchar(255)

select
	@db_name = db_name(),
	@servername = @@servername

select
        @sql_string = "exec contracts.dbo.ct_addfutsubscription '" +
                rtrim(@login)+"', '"+
                rtrim(@db_name)+"', '"+
                rtrim(@servername)+"', '"+
                rtrim(@future)+"', '"+
                rtrim(@exchange)+"', '"+
                rtrim(@evaluation_currency)+ "'"

exec
        sp_remotesql
                "CONTRACTS",
                @sql_string

select 
	@sql_string = "exec contracts.db.ct_futures '" +
		rtrim(@login) + "'. '" +
		rtrim(@db_name)+"', '"+
		rtrim(@servername)+"', '"+
		rtrim(@evaluation_currency)+ "'"

exec
        sp_remotesql 
                "CONTRACTS",
                @sql_string

go
