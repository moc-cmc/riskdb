	#external_accounts
set
	a.after_nop = abs(b.nop),
	a.after_usage = b.usage
from
	#external_accounts a,
	#after_usage b
where
	a.external_account_id = b.external_account_id

update
	#external_accounts
set
	a.before_dsl = b.dsl
from
	#external_accounts a,
	#dsls b
where
	a.external_account_id = b.external_account_id 

