create table
	#external_accounts(
		id int identity,
		style varchar(250) NULL,
		alert_level int NULL,
		prime_broker_id int NULL,
		prime_broker varchar(50) NULL,
		legal_entity_id int NULL,
		external_account_id int NULL,
		symbol varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(50) NULL,
		nop_limit float NULL,
		dsl_limit float NULL,
		before_nop float NULL,
		before_usage float NULL,
		after_nop float NULL,
		after_usage float NULL,
		before_dsl float NULL,
		after_dsl float NULL,
		auto_reduce varchar(25) NULL,
		auto_all varchar(25) NULL,
		pb_move varchar(25) NULL)
insert into
	#external_accounts(
		style,
		external_account_id,
		symbol,
		external_account_type_id,
		external_account_type,
		before_nop,
		before_usage,
		after_nop,
		after_usage)
select
	style = @style,
	a.external_account_id,
	a.symbol,
	a.external_account_type_id,
	b.name,
	before_nop = 0.0,
	before_usage = 0.0,
	after_nop = 0.0,
	after_usage = 0.0
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Counterparty"
order by
	a.symbol

delete
	#external_accounts
from
	#external_accounts a,
	bo_master_accounts b
where
	a.external_account_id = b.external_account_id

update
	#external_accounts
set
	a.legal_entity_id = c.legal_entity_id
from
	#external_accounts a,
	fo_sub_accounts b,
	bo_master_accounts c
where
	a.external_account_id = b.external_account_id
and
	b.bo_master_account_id = c.bo_master_account_id


