	#external_accounts
set
	a.after_dsl = b.dsl
from
	#external_accounts a,
	#dsls_after b
where
	a.external_account_id = b.external_account_id

update
	#external_accounts
set
	style = @alert_none_style

update
	#external_accounts
set
	style = @alert_low_style
where
	after_nop / nop_limit >= .5

update
	#external_accounts
set
	style = @alert_med_style
where
	after_nop / nop_limit >= .75

update
	#external_accounts
set
	style = @alert_high_style
where
	after_nop / nop_limit >= .95


update
	#external_accounts
set
	a.alert_level = b.alert_level
from
	#external_accounts a,
	#alerts b
where
	a.style = b.style

update
	#external_accounts
set
	auto_reduce = "Find NOP Offset",
	auto_all = "Find NOP Offsets",
	pb_move = "Transfer NOP"
where
	after_nop > 0.0

