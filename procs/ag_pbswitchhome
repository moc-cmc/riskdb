create table
	#switches(
		sw_id int identity,
		style varchar(250) NULL,
		acct varchar(50) NULL,
		trade_date datetime NULL,
		id int NULL,
		entered_by varchar(50) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		scratch_set_id int NULL,
		scratch_set varchar(50) NULL,
		contract_id int NULL,
		product_id int NULL,
		currency_id int NULL,
		symbol varchar(50) NULL,
		value_date datetime NULL,
		quantity numeric(30,4) NULL,
		price float NULL,
		counter_qty numeric(30,4) NULL,
		trade_id int NULL,
		remove_switch varchar(25) NULL,
		volume float NULL,
		fee float NULL)
insert into
	#switches(
		style,
		acct,
		trade_date,
		id,
		entered_by,
		external_account_id,
		account,
		scratch_set_id,
		scratch_set,
		contract_id,
		symbol,
		value_date,
		quantity,
		price,
		counter_qty,
		trade_id)
select
	style = @style,
	acct = c.symbol,
	a.trade_date,
	id = a.scratch_trade_id,
	entered_by = b.login,
	a.external_account_id,
	account = c.symbol,
	a.scratch_set_id,
	scratch_set = f.name,
	a.contract_id,
	e.symbol,
	a.value_date,
	a.quantity,
	a.price,
	a.quantity * a.price * -1.0,
	a.trade_id
from
	scratch_trades a,
	tico_accounts b,
	external_accounts c,
	contracts e,
	scratch_sets f
where
	a.tico_account_id = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.contract_id = e.contract_id
and
	a.scratch_set_id = f.scratch_set_id
and
	convert(date, a.trade_date) = convert(date, @trade_date)
and
	a.trade_id = NULL
order by
	a.scratch_trade_id

update
	#switches
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#switches a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#switches
set
	volume = abs(quantity)
where
	product_id = @evaluation_currency_id

update
	#switches
set
	volume = abs(quantity * price)
where
	currency_id = @evaluation_currency_id

update
	#switches
set
	volume = abs(a.quantity) * b.rate
from
	#switches a,
	#conversion_rates b
where
	a.product_id = b.product_id
and
	a.volume = NULL

update
	#switches
set
	a.fee = (a.volume / 1000000.0) * b.fee_price * -1.0
from
	#switches a,
	fee_schedules b
where
	a.external_account_id = b.external_account_id
and
	b.name like "%Switc%"

select
	@fees = sum(fee)
from
	#switches

update
