	#limits(
		credit_profile_id int,
		external_account_id int,
		num_accounts int,
		nop_limit float NULL,
		dsl_limit float NULL)
insert into
	#limits(
		credit_profile_id,
		external_account_id,
		num_accounts)
select
	a.credit_profile_id,
	max(b.external_account_id),
	count(b.external_account_id)
from
	credit_profiles a,
	credit_profile_accounts b
where
	a.credit_profile_id = b.credit_profile_id
group by
	a.credit_profile_id
	
delete

from
	#limits
where
	num_accounts != 1

