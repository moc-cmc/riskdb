	#before_usage(
		external_account_id int,
		nop float NULL,
		usage float NULL)
insert into
	#before_usage(
		external_account_id,
		nop,
		usage)
select
	external_account_id,
	sum(abs(nop_equiv)),
	sum(usage)
from
	#before_positions
group by
	external_account_id

update
	#external_accounts
set
	a.before_nop = abs(b.nop),
	a.before_usage = b.usage
from
	#external_accounts a,
	#before_usage b
where
	a.external_account_id = b.external_account_id


create table
	#after_usage(
		external_account_id int,
		nop float NULL,
		usage float NULL)
