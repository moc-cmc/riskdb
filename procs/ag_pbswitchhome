	#validation(
		style varchar(250) NULL,
		message varchar(100) NULL,
		validate varchar(50) NULL)
select
	@date_validator = a.login,
	@date_validation = b.timestamp
from
	tico_accounts a,
	roll_trade_dates b
where
	a.account_id = b.validated_by
and
	convert(date, b.trade_date) = @trade_date
if @date_validator = NULL
begin
	insert into
		#validation(
			style,
			message,
			validate)
	values(
		@error_style,
		"Closing dates not confirmed for trade date",
		"View and Confirm Dates")
end

