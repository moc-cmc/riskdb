create table
	#products(
		id int identity,
		style varchar(250) NULL,
		product_id int NULL,
		symbol varchar(50) NULL,
		before_balance float NULL,
		before_nop float NULL,
		before_usage float NULL,
		after_balance float NULL,
		after_nop float NULL,
		after_usage float NULL)
insert into
	#products(
		symbol)
select
	distinct(b.symbol)
from
	#all_products a,
	products b
where
	a.product_id = b.product_id
order by
	b.symbol

update
	#products
set
	a.product_id = b.product_id
from
	#products a,
	products b
where
	a.symbol = b.symbol

update
	#products
set
	style = @style,
	before_balance = 0.0,
	before_nop = 0.0,
	after_balance = 0.0,
	after_nop = 0.0

update
	#products
set
	a.before_balance = b.balance,
	a.before_nop = b.nop,
	a.before_usage = b.usage
from
	#products a,
	#before_products b
where
	a.product_id = b.product_id


update
	#products
set
	a.after_balance = b.balance,
	a.after_nop = b.nop,
	a.after_usage = b.usage
from
	#products a,
	#after_products b
where
	a.product_id = b.product_id


