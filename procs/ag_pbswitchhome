select
	@id = 0
select
	@ids = count(*)
from
	#products
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#products
	where
		id > @id

	select
		@product_id = NULL,
		@symbol = NULL,
		@before_usage = NULL,
		@before_nop = NULL,
		@before_balance = NULL,
		@after_usage = NULL,
		@after_nop = NULL,
		@after_balance = NULL

	select
		@product_id = product_id,
		@symbol = symbol
	from
		#products
	where
		id = @id

	insert into
		#product_detail(
			style,
			symbol)
	values(
		@client_style,
		@symbol)

	insert into
		#product_detail(
			style,
			product_id,
			product,
			external_account_id,
			account,
			margin_bucket_id,
			margin_bucket,
			date_bucket,
			before_balance,
			before_nop,
			before_usage,
			after_balance,
			after_nop,
			after_usage,
			tally_switch)
	select
		style = @style,
		a.product_id,
		c.symbol,
		a.external_account_id,
		b.symbol,
		a.margin_bucket_id,
		d.name,
		a.date_bucket,
		before_balance = 0.0,
		before_nop = 0.0,
		before_usage = 0.0,
		after_balance = 0.0,
		after_nop = 0.0,
		after_usage = 0.0,
		tally_switch = "Tally Switch"
	from
		#product_buckets a,
		external_accounts b,
		products c,
		margin_buckets d
	where
		a.external_account_id = b.external_account_id
	and
		a.product_id = c.product_id
	and
		a.margin_bucket_id = d.margin_bucket_id
	and
		a.product_id = @product_id
	order by
		b.symbol
		
	update
		#product_detail
	set
		a.prime_broker_id = b.prime_broker_id
	from
		#product_detail a,
		external_account_prime_brokers b
	where
		a.external_account_id = b.external_account_id
	update
		#product_detail
	set
		a.prime_broker = c.name
	from
		#product_detail a,
		prime_brokers b,
		sources c
	where
		a.prime_broker_id = b.prime_broker_id
	and
		b.source_id = c.source_id

/* TNG */
	update
		#product_detail
	set
		a.before_balance = b.balance,
		a.before_nop = b.nop_equiv,
		a.before_usage = b.usage,
		a.margin = b.margin,
		a.nop_model = c.name
	from
		#product_detail a,
		#before_positions b,
		nop_models c
	where
		a.product_id = b.product_id
	and
		a.external_account_id = b.external_account_id
	and
		b.nop_model_id = c.nop_model_id
	and
		a.margin_bucket_id = b.balance_bucket_id
	and
		a.date_bucket = b.date_bucket

	update
		#product_detail
	set
		a.after_balance = b.balance,
		a.after_nop = b.nop_equiv,
		a.after_usage = b.usage,
		a.margin = b.margin,
		a.nop_model = c.name
	from
		#product_detail a,
		#after_positions b,
		nop_models c
	where
		a.product_id = b.product_id
	and
		a.external_account_id = b.external_account_id
	and
		b.nop_model_id = c.nop_model_id
	and
		a.margin_bucket_id = b.balance_bucket_id
	and
		a.date_bucket = b.date_bucket

	delete

	from
		#product_detail
	where
		abs(before_balance) + abs(before_nop) + abs(before_usage) + abs(after_balance) + abs(after_nop) + abs(after_usage) = 0.0

	select
		@before_balance = sum(before_balance),
		@before_nop = sum(before_nop),
		@before_usage = sum(before_usage),
		@after_balance = sum(after_balance),
		@after_nop = sum(after_nop),
		@after_usage = sum(after_usage)
	from
		#product_detail
	where
		product_id = @product_id


	insert into
		#product_detail(
			style,
			before_balance,
			before_nop,
			before_usage,
			after_balance,
			after_nop,
			after_usage)
	values(
		@subtotal_style,
		@before_balance,
		@before_nop,
		@before_usage,
		@after_balance,
		@after_nop,
		@after_usage)

		
	select
		@ids = count(*)
	from
		#products
	where
		id > @id
end

