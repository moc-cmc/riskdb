create or replace procedure
	r_deletefiledropreport
		@login varchar(50),
		@filedrop_report varchar(50)

as

declare @filedrop_report_id int
declare @configured_report varchar(1)

select
        @filedrop_report_id = filedrop_report_id
from
        filedrop_reports
where
        name = @filedrop_report

if @filedrop_report_id = NULL
begin
        select
                status = "Error",
                msg = "report does not exist",
                report = @filedrop_report
        return
end


select
	@configured_report = "Y"
from
	run_fd_report_destinations
where
	filedrop_report_id = @filedrop_report_id

if @configured_report = "Y"
begin
	select
		status = "Error",
		msg = "Report configured for run. Cannot delete",
		filedrop_report = @filedrop_report
	return
end

delete from
	filedrop_reports
where
	filedrop_report_id = @filedrop_report_id
if @@rowcount = 1
begin
	select
		status = "Success",
		msg = "Report removed",
		report = @filedrop_report
end


exec
	r_viewfiledropreports
		@login = @login

go
	

