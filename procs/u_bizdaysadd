drop procedure
	u_bizdaysadd
go

create procedure
	u_bizdaysadd
		@starting_date datetime,
		@biz_days_to_add int,
		@future_date datetime output
as

if @biz_days_to_add < 0
	return

select
	@future_date = @starting_date

while @biz_days_to_add > 0
begin
	exec
		r_nextbusinessday
			@future_date,
			@future_date output

	select
		@biz_days_to_add = @biz_days_to_add - 1

end


go
			


