create or replace procedure
	api_sourcelefosubaccounts
		@legal_entity varchar(150),
		@source varchar(50)
		

as

declare @legal_entity_id int
declare @source_id int

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @legal_entity_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding legal entity provided"
	return	
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source provided"
	return	
end


select
	a.legal_entity_id,
	b.bo_master_account_id,
	bo_master_ext_account_id = b.external_account_id,
	c.fo_sub_account_id,
	fo_sub_ext_account_id = c.external_account_id,
	legal_entity_name = a.name,
	fo_sub_account_symbol = e.symbol,
	fo_sub_account_name = e.name,
	fo_sub_account_source_symbol = f.symbol,
	status_name = g.name
from
	legal_entities a,
	bo_master_accounts b,
	fo_sub_accounts c,
	external_accounts d,
	external_accounts e,
	external_account_symbols f,
	statuses g
where
	a.legal_entity_id = b.legal_entity_id
and
	a.status_id = g.status_id
and
	b.external_account_id = d.external_account_id
and
	c.external_account_id = e.external_account_id
and
	b.bo_master_account_id = c.bo_master_account_id
and 
	c.external_account_id = f.external_account_id
and
	a.legal_entity_id = @legal_entity_id
and
	f.source_id = @source_id
and
	g.name = "Approved"



go
