
if object_id("cm_addexternalfutaccount") != NULL
    drop procedure
        cm_addexternalfutaccount
go

create procedure
	cm_addexternalfutaccount
		@login varchar(30),
		@account varchar(50)
as


declare @fund_id int
declare @external_account_id int
declare @init_external_account_id int
declare @fund_name varchar(50)
declare @internal_account_id int
declare @ext_future_allocation_id int
declare @remainder_ext_account_id int
declare @run_id int
declare @portfolio_id int
declare @external_accounts int
declare @evaluation_currency_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@external_accounts = count(a.external_account_id)
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.instrument_type = "F"
and
	b.fund_id = @fund_id


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id != NULL
begin
	select
		status = "Error",
		message = "Account name already exists",
		account_name = @account
	return
end

select
	@fund_name = name
from
	funds
where
	fund_id = @fund_id

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @fund_name
if @internal_account_id = NULL
begin
	exec
		j_nextkey
			"internal_accounts",
			@internal_account_id output
	insert into
		internal_accounts
	values(
		@internal_account_id,
		@fund_name,
		@fund_name,
		0)
	insert into
		fund_internal_accounts
	values(
		@fund_id,
		@internal_account_id)
	insert into
		internal_account_views
	values(
		@internal_account_id)
end

exec
	j_nextkey
		"external_accounts",
		@external_account_id output

insert into
	external_accounts
values( 
	@external_account_id,
	"F",
	@account,
	@account,
	@internal_account_id,
	@evaluation_currency_id)

insert into
	fund_external_accounts
values(
	@fund_id,
	@external_account_id)

insert into
	external_account_views
		values(
			@external_account_id)

if @external_accounts > 0
begin
	select
		@remainder_ext_account_id = remainder_ext_account_id
	from
		external_future_allocations
	where
		fund_id = @fund_id
	if @remainder_ext_account_id = NULL
	begin
		select
			@remainder_ext_account_id = min(external_account_id)
		from
			external_accounts
		where
			instrument_type = "F"
	end

	exec
		j_nextkey
			"external_future_allocations",
			@ext_future_allocation_id output

	insert into
		external_future_allocations
	values(
		@ext_future_allocation_id,
		@remainder_ext_account_id,
		@internal_account_id,
		@external_account_id,
		@internal_account_id,
		0.0,
		@fund_id)
end


exec
	j_nextkey
		"runs",
		@run_id output
insert into
	runs
values(
	@run_id,
	@account)
insert into
	run_external_accounts
values(
	@run_id,
	@external_account_id)

insert into
	user_runs
select
	tico_account_id = account_id,
	run_id = @run_id
from
	tico_accounts

select
	@internal_account_id = NULL

exec
	j_nextkey
		"internal_accounts",
		@internal_account_id output
insert into
	internal_accounts
values(
	@internal_account_id,
	@account,
	@account,
	0)

insert into
	fund_internal_accounts
values(
	@fund_id,
	@internal_account_id)
insert into
	internal_account_views
values(
	@internal_account_id)

exec
	j_nextkey
		"portfolios",
		@portfolio_id output
insert into
	portfolios
values(
	@portfolio_id,
	@account)
insert into
	portfolio_accounts
values(
	@portfolio_id,
	@internal_account_id)


go
