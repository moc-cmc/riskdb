
if object_id("s_runfilters") != NULL
    drop procedure
	s_runfilters
go

create procedure
	s_runfilters
		@login char(30),
		@run_name char(200)
as

declare @tico_account_id int
declare @run_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@run_id = NULL

select
	@run_id = a.run_id
from
	runs a,
	user_runs b
where
	a.run_id = b.run_id
and
	b.tico_account_id = @tico_account_id
and
	a.name = @run_name
if @run_id = NULL
begin
	select
		id = -1,
		error = "No run found with name",
		run_name = @run_name
	return
end


