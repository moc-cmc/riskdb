use
	risk_crossfield
go

drop procedure
	fxa_holidays
go

create procedure
	fxa_holidays
		@login varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@product varchar(50)=NULL
as

declare @from_date datetime
declare @to_date datetime

create table
	#products(
		product_id int)
insert into
	#products
select
	product_id
from
	products
where
	symbol = @product
if @@rowcount = 0
	insert into
		#products
	select
		product_id
	from
		products


if @begin_date != NULL
	select
		@from_date = @begin_date
else
	select
		@from_date = convert(datetime, convert(date, getdate()))
	

if @end_date != NULL
	select
		@to_date = @end_date
else
	select
		@to_date = dateadd(day, 1, @from_date)


select
	a.product_holiday_id,
	product = b.symbol,
	holiday = b.name,
	a.date
from
	product_holidays a,
	products b
where
	a.product_id = b.product_id
and
	a.date >= @from_date
and
	a.date < @end_date
order by
	b.symbol,
	a.date
	


go

