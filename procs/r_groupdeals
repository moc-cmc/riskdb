
if object_id("r_groupdeals") != NULL
    drop procedure
        r_groupdeals
go

create procedure
	r_groupdeals
		@login varchar(50),
		@trade_date datetime = NULL,
		@symbol varchar(50) = NULL,
        @value_date varchar(50) = NULL,
        @deal_id int = NULL,
        @deal_status varchar(25) = NULL
as

exec
    r_assigntrades
        @login = @login,
        @trade_date = @trade_date,
        @symbol = @symbol,
        @value_date = @value_date,
        @deal_id = @deal_id,
        @deal_status = @deal_status,
        @page_title = "Group Deals",
        @mode = "grouping"

go
