use
	risk_sjmdemo
go

drop procedure
	ag_clienttransfershome
go

create procedure
	ag_clienttransfershome
		@login varchar(50)
as

declare @fund_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"request_types",
	"Ledger Request Types Home",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"withdrawal",
	"Add Client Withdrawal Request",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"deposit",
	"Add Client Deposit Request",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

select
	style = @style,
	deposit = "Add Deposit Request",
	withdrawal = "Add Withdrawal Request",
	request_types = "Manage Request Types"

create table
	#ledger_requests(
		id int identity,
		style varchar(250) NULL,
		ledger_request_id int,
		requestor_id int,
		requestor varchar(50) NULL,
		status_id int,
		status varchar(50) NULL,
		outside_account_id int,
		outside_account varchar(50) NULL,
		bo_master_account_id int,
		bo_master_account varchar(50) NULL,
		custodial_account_id int NULL,
		custodial_account varchar(50) NULL,
		ledger_request_type_id int,
		ledger_request_type varchar(50) NULL,
		product_id int,
		product varchar(50) NULL,
		amount float,
		transaction_date datetime,
		request_date datetime)

insert into
	#ledger_requests(
		style,
		ledger_request_id,
		requestor_id,
		status_id,
		outside_account_id,
		bo_master_account_id,
		custodial_account_id,
		ledger_request_type_id,
		product_id,
		amount,
		transaction_date,
		request_date)
select
	style = @style,
	ledger_request_id,
	requestor_id,
	status_id,
	outside_account_id,
	bo_master_account_id,
	custodial_account_id,
	ledger_request_type_id,
	product_id,
	amount,
	transaction_date,
	request_date
from
	ledger_requests
order by
	transaction_date

update
	#ledger_requests
set
	a.requestor = b.login
from
	#ledger_requests a,
	tico_accounts b
where
	a.requestor_id = b.account_id

update
	#ledger_requests
set
	a.status = b.name
from
	#ledger_requests a,
	statuses b
where
	a.status_id = b.status_id

update
	#ledger_requests
set
	a.outside_account = b.name
from
	#ledger_requests a,
	outside_accounts b
where
	a.outside_account_id = b.outside_account_id

update
	#ledger_requests
set
	a.bo_master_account = c.symbol
from
	#ledger_requests a,
	bo_master_accounts b,
	external_accounts c
where
	a.bo_master_account_id = b.bo_master_account_id
and
	b.external_account_id = c.external_account_id

update
	#ledger_requests
set
	a.custodial_account = b.symbol
from
	#ledger_requests a,
	external_accounts b
where
	a.custodial_account_id = b.external_account_id

update
	#ledger_requests
set
	a.ledger_request_type = b.name
from
	#ledger_requests a,
	ledger_request_types b
where
	a.ledger_request_type_id = b.ledger_request_type_id

update
	#ledger_requests
set
	a.product = b.symbol
from
	#ledger_requests a,
	products b
where
	a.product_id = b.product_id

select
	style,
	ledger_request_id,
	requestor,
	status,
	outside_account,
	bo_master_account,
	custodial_account,
	ledger_request_type,
	product,
	amount,
	transaction_date,
	request_date
from
	#ledger_requests
order by
	id


go

