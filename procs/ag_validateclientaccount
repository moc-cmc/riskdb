use
	risk_sjmdemo
go

drop procedure
	ag_validateclientaccount
go

create procedure
	ag_validateclientaccount
		@login varchar(50),
		@account varchar(50),
		@account_type varchar(50) output,
		@access_level varchar(50) output
as

declare @tico_account_id int
declare @account_id int
declare @total int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		@access_level = "Unknown login"
	return
end

create table
	#bo_master_accounts(
		bo_master_account_id int,
		external_account_id int NULL,
		legal_entity_id int NULL,
		symbol varchar(50) NULL)
insert into
	#bo_master_accounts(
		bo_master_account_id,
		external_account_id,
		legal_entity_id,
		symbol)
select
	a.bo_master_account_id,
	a.external_account_id,
	a.legal_entity_id,
	b.symbol
from
	bo_master_accounts a,
	external_accounts b,
	legal_entity_tico_accounts c
where
	a.external_account_id = b.external_account_id
and
	a.legal_entity_id = c.legal_entity_id
and
	c.tico_account_id = @tico_account_id
select
	@account_id = bo_master_account_id
from
	#bo_master_accounts
where
	symbol = @account
if @account_id != NULL
begin
	select
		@account_type = "Back Office Master",
		@access_level = "Request and Cancel"
	return
end


create table
	#outside_accounts(
		outside_account_id int,
		outside_account_type_id int,
		provider_id int,
		name varchar(100))
insert into
	#outside_accounts(
		outside_account_id,
		outside_account_type_id,
		provider_id,
		name)
select
	a.outside_account_id,
	a.outside_account_type_id,
	a.provider_id,
	a.name
from
	outside_accounts a,
	legal_entity_tico_accounts b
where
	a.legal_entity_id = b.legal_entity_id
and
	b.tico_account_id = @tico_account_id
select
	@account_id = outside_account_id
from
	#outside_accounts
where
	name = @account
if @account_id != NULL
begin
	select
		@account_type = "Outside",
		@access_level = "Request and Cancel"
	return
end


create table
	#custodian_accounts(
		external_account_id int,
		symbol varchar(100) NULL)
insert into
	#custodian_accounts(
		external_account_id,
		symbol)
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Custody"
select
	@account_id = external_account_id
from
	#custodian_accounts
where
	symbol = @account
if @account_id != NULL
begin
	select
		@account_type = "Custodian",
		@access_level = "Request and Cancel"
	return
end

select
	@account_type = "None",
	@access_level = "None"


go



