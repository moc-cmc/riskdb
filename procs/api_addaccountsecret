create or replace procedure
	api_addaccountsecret
		@login varchar(100),
		@vault_name varchar(50),
		@external_account varchar(50),
		@source varchar(50),
		@secret_path varchar(255)=NULL,
		@description varchar(255)=NULL

as

declare @tico_account_id int
declare @key_vault_id int
declare @source_id int
declare @external_account_id int
declare @has_legal_entity_permission char(1)
declare @active_status_id int
declare @pending_status_id int
declare @account_vault_secret_id int
declare @status_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

select
	@key_vault_id = key_vault_id
from
	key_vaults
where
	name = @vault_name
if @key_vault_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding vault",
		vault_name = @vault_name
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding source",
		source = @source
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account 
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding external account"
	return
end

select 
	@has_legal_entity_permission = "N"

select
	@has_legal_entity_permission = "Y"
from
	tico_accounts a,
	legal_entity_tico_accounts b,
	bo_master_accounts c
where
	a.account_id = b.tico_account_id
and
	c.legal_entity_id = b.legal_entity_id
and
	c.external_account_id = @external_account_id

if @has_legal_entity_permission = "N"
begin
	select
        	@has_legal_entity_permission = "Y"
	from
        	tico_accounts a,
        	legal_entity_tico_accounts b,
        	bo_master_accounts c,
		fo_sub_accounts d
	where
        	a.account_id = b.tico_account_id
	and
        	c.legal_entity_id = b.legal_entity_id
	and
		c.bo_master_account_id = d.bo_master_account_id
	and
        	d.external_account_id = @external_account_id
end

if @has_legal_entity_permission != "Y"
begin
	select
		status = "Error",
		message = "No access to legal entity for account and login"
	return
end


select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
if @active_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding Active status"
	return
end

select
	@pending_status_id = status_id
from
	statuses
where
	name = "Pending"
if @pending_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding Pending status"
	return
end


select
	@account_vault_secret_id = account_vault_secret_id
from
	account_vault_secrets
where
	key_vault_id = @key_vault_id
and
	external_account_id = @external_account_id
and
	status_id = @active_status_id
and
	source_id = @source_id

if @account_vault_secret_id != NULL
begin
	select
		status = "Error",
		message = "There is already an active secret for this account source combination",
		account = @external_account,
		source = @source,
		account_vault_secret_id = @account_vault_secret_id
	return
end

select
        @account_vault_secret_id = account_vault_secret_id
from
        account_vault_secrets
where
        key_vault_id = @key_vault_id
and
        external_account_id = @external_account_id
and
        status_id = @pending_status_id
and
        source_id = @source_id

if @account_vault_secret_id != NULL
begin
        select
                status = "Error",
                message = "There is already a pending secret for this account source combination",
                account = @external_account,
                source = @source,
                account_vault_secret_id = @account_vault_secret_id
        return
end

		
select
	@status_id = @pending_status_id

if @secret_path not in(NULL, "")
begin
	select
		@status_id = @active_status_id
end


	
exec
	j_nextkey
		"account_vault_secrets",
		@account_vault_secret_id output

begin tran
	insert into
        	account_vault_secrets (
                	account_vault_secret_id,
                	key_vault_id,
                	external_account_id,
                	source_id,
                	status_id,
                	added_by,
                	added_on,
                	secret_path,
                	description)
	values(
               	@account_vault_secret_id,
               	@key_vault_id,
               	@external_account_id,
               	@source_id,
               	@status_id,
               	@tico_account_id,
               	getdate(),
               	@secret_path,
               	@description)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding account vault secret for source",
			account = @external_account,
			source = @source,
			vault = @vault_name
		rollback tran
		return
	end
commit tran

	
select
       	status = "Success",
       	message = "Added account vault secret for source",
	id = @account_vault_secret_id,
	account = @external_account,
	source = @source,
	vault = @vault_name


go
