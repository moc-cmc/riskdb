create or replace procedure
	api_createdirectcounterparty
			@login varchar(25),
			@shortcode varchar(25),
			@prefix varchar(20)=NULL
as

declare @source_id int
declare @pb_id	 int
declare @status_id int
declare @source_type_id int
declare @pb_acct_run varchar(50)
declare @counterparty varchar(50)
declare @name varchar(50)

if @prefix = NULL
begin
	select
		@prefix = "Direct"
end

select
	@name = rtrim(@shortcode)+" "+rtrim(@prefix)

select
	@pb_acct_run = @name,
	@counterparty = rtrim(upper(@prefix))+ "-" + rtrim(@shortcode)

select
	@source_type_id=source_type_id
from
	source_types
where
	name="Prime Broker"

if @@rowcount < 1
begin
	select
		status="Error",
		msg="Source type does not exist",
		source_type="Prime Broker"

	return
end

select
	@source_id=source_id
from
	sources
where
	name=@name

if(@@rowcount < 1)
begin

	select
		@status_id=status_id
	from
		statuses
	where
		name="Active"

	if (@@rowcount < 1)
	begin
		select
			status="Error",
			msg="Active status does not exist",
			stat="Active"

		return
	end	
	
	exec j_nextkey "sources", @source_id output
	
	insert into
		sources
		(source_id,
		 name,
		 status_id,
		 source_type_id)

	values
		(@source_id,
		 @name,
		 @status_id,
		 @source_type_id)

	if(@@rowcount < 1)
	begin
		select
			status="Error",		
			msg="Could not create source record",
			name=@name
		
		return
	end

end

exec j_nextkey "prime_brokers", @pb_id output

insert into
	prime_brokers
	(prime_broker_id,
	 source_id)
values
	(@pb_id,
	 @source_id)

if(@@rowcount < 1)
begin
	select
		status="Error",
		msg="Could not insert prime broker record",
		name=@name
	
	return
end

/* check to see if it's the first pb created */

declare @first_pb int

select
	@first_pb = count(*)
from
	prime_brokers

if (@first_pb = 1)
begin
	update
		funds
	set
		prime_broker_id=@pb_id

	if @@rowcount != 1
	begin
		select
			status="Error",
			msg="Could not update prime_broker_id in funds table",
			prime_broker=@name

		return
	end
end

/* set default margin schedule */

insert into
	product_margins
select
	a.product_id,
	0.02,
	@pb_id
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"
if @@rowcount = 0
begin
	select
		status="Warning",
		msg="Could not set up product margins for prime_broker",
		prime_broker=@name
end

exec
	api_createexternalaccount
			@login=@login,
			@symbol=@pb_acct_run,
			@prime_broker=@name,
			@account_type="Counterparty"

declare @run_id int
declare @bo_external_account_id int

select
	@run_id = run_id
from
	runs
where
	name=@pb_acct_run
if (@@rowcount !=1)
begin
	select
		status="Warning",
		msg="Could not create run for pb",
		run=@pb_acct_run
end


select
	@bo_external_account_id=external_account_id
from
	external_accounts
where
	symbol=@pb_acct_run

if (@@rowcount != 1)
begin
	select
		status="Warning",
		msg="Could not create external account for pb",
		external_account=@pb_acct_run
end

update
	prime_brokers
set
	bo_external_account_id=@bo_external_account_id,
	run_id=@run_id
where
	prime_broker_id=@pb_id

exec
    	ops_loadcounterparties
            @login=@login,
            @cpty=@counterparty,
            @ext_acct=@name

select
	status="Success",
	msg="Prime Broker created",
	name=@name

go
