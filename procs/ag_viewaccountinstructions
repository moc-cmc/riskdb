create or replace procedure
	ag_viewaccountinstructions
		@login varchar(50),
		@legal_entity varchar(150),
		@outside_account varchar(50)

as

declare @has_permission varchar(10)
declare @legal_entity_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @ids int
declare @id int
declare @oa varchar(50)
declare @hash_value varchar(200)
declare @last_recon datetime


create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)
insert into
        #meta
values( 
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "back",
        "Legal Entities Home",
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "legal_entity",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "outside_account_type",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Hidden",
        "name",
        NULL,
        NULL)



insert into
        #meta
values(
        "Column Link",
        "refresh",
        "View Account Instructions",
        NULL)

insert into
	#meta
values(
	"Column Format",
	"account_number",
	"Number",
	"###.#")

insert into
        #meta
values(
        "Column Format",
        "account_code",
        "Number",
        "###.#")


insert into
        #meta
values(
        "Column Link",
        "generate",
        "Generate Outside Acccount Hash",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "approve",
        "Approve Outside Account",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "edit_account",
        "Edit Outside Account",
        NULL)


insert into
        #meta
values(
        "Column Link",
        "recon",
        "Request External OA Recon",
        NULL)




select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta


exec
	r_checkaccessgrouppermission
		@login=@login,
		@access_group="Wire Admin",
		@show_perm_denied = "Y",
		@has_permission = @has_permission output

if @has_permission != "Y"
begin
	return
end

select
	@legal_entity_id = legal_entity_id
from
	legal_entities
where
	name = @legal_entity
if @@rowcount !=1
begin
	select
		status = "Error",
		message = "Could not find legal entity",
		legal_entity = @legal_entity
	return
end

select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

declare @tico_account_id int

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end



create table
	#outside_accounts(
		pending char(1),
		status varchar(100) NULL,
		outside_account_id int,
		outside_account_type_id int,
		outside_account_type varchar(50) NULL,
		legal_entity_id int,
		legal_entity_name varchar(150) NULL,	
		provider_id int,
		provider_name varchar(50) NULL,	
		name varchar(50),
		account_number varchar(100) NULL,
		account_code varchar(100) NULL,
		account_code_type_id int NULL,
                account_code_type varchar(50) NULL,
		recalc_checksum varchar(255) NULL,
		checksum varchar(255) NULL,
		checksum_status varchar(100) NULL,
		checksum_user_id int NULL,
		checksum_user varchar(50) NULL,
		approval_user_id int NULL,
		approval_user varchar(50) NULL,
		generate varchar(50) NULL,
		approve varchar(50) NULL,
		recon varchar(50) NULL,
		edit_account varchar(10) NULL,
		last_recon datetime NULL,
		style varchar(255)
)

insert into
	#outside_accounts(
		pending,
		recon,
		outside_account_id,
		name,
		outside_account_type_id,
		outside_account_type,
		legal_entity_id,
		legal_entity_name,
		provider_id,
		provider_name,
		style)
select
	"Y",
	"Recon",
	a.outside_account_id,
	a.name,
	b.outside_account_type_id,
        b.name,
	c.legal_entity_id,
        c.name,
	d.provider_id,
        d.name,
	@style
from
        pending_outside_accounts a,
        outside_account_types b,
        legal_entities c,
        providers d
where
        a.outside_account_type_id = b.outside_account_type_id
and
        a.legal_entity_id = c.legal_entity_id
and
        a.provider_id = d.provider_id
and
        a.legal_entity_id = @legal_entity_id
and
	a.name = @outside_account

insert into
        #outside_accounts(
                pending,
		recon,
		status,
                outside_account_id,
                name,
                outside_account_type_id,
                outside_account_type,
                legal_entity_id,
                legal_entity_name,
                provider_id,
                provider_name,
                style)
select
        "N",
	"Recon",
	"<span style=""color:#00CC00;font-style:italic"">Approved</span>",
        a.outside_account_id,
        a.name,
        b.outside_account_type_id,
        b.name,
        c.legal_entity_id,
        c.name,
        d.provider_id,
        d.name,
        @style
from
        outside_accounts a,
        outside_account_types b,
        legal_entities c,
        providers d
where
        a.outside_account_type_id = b.outside_account_type_id
and
        a.legal_entity_id = c.legal_entity_id
and
        a.provider_id = d.provider_id
and
        a.legal_entity_id = @legal_entity_id
and
        a.name = @outside_account


update 
	#outside_accounts
set
	account_number = a.account_number,
	account_code = a.account_code,
	account_code_type_id = a.account_code_type_id,
	checksum = a.checksum,
	checksum_user_id  = a.checksum_user_id,
	approval_user_id = a.approval_user_id
from
	outside_account_info a,
	#outside_accounts c
where
	a.outside_account_id = c.outside_account_id

update
	#outside_accounts
set
	account_code_type = b.name
from
	#outside_accounts a,
	outside_account_code_types b
where
	a.account_code_type_id = b.outside_account_code_type_id



select
        @id = 0
select
        @ids = count(*)
from
        #outside_accounts
where
        outside_account_id > @id

while @ids > 0
begin
        select
                @id = min(outside_account_id)
        from
                #outside_accounts
        where
                outside_account_id > @id

	select
		@oa = NULL,
		@last_recon = NULL,
		@hash_value = NULL

	select
		@oa = name
	from
		#outside_accounts
	where
		outside_account_id = @id

	select
		@last_recon = max(a.respond_timestamp)
	from
		oa_recon_requests a,
		statuses b
	where
		a.status_id = b.status_id
	and
		a.outside_account_id = @id
	and
		b.name = "Success"
		
	exec
		api_oahashgen
			@login = @login,
			@outside_account = @oa,
			@hash_value = @hash_value output

	update
		#outside_accounts
	set
		recalc_checksum  = @hash_value,
		last_recon = @last_recon
	where
		outside_account_id = @id



	select
        	@ids = count(*)
	from
        	#outside_accounts
	where
        	outside_account_id > @id
end

update
	#outside_accounts
set
	checksum_status = "No Checksum Generated"
where
	checksum = NULL

update
	#outside_accounts
set
	checksum_status = "<b><font color='FF0000'>ERROR - Internal Checksum Mismatch</font></b>"
where
	checksum != NULL
and
	checksum != recalc_checksum

update
        #outside_accounts
set
        checksum_status = "<b><font color='00CC00'>Internal Match</font></b>"
where
        checksum != NULL
and
        checksum = recalc_checksum


update
	#outside_accounts
set
	status = "<span style=""color:#FF6666;font-style:italic"">Ready to generate checksum</span>",
	generate = "Generate",
        edit_account = "Edit",
	recon = NULL
where
	account_number != NULL
and
	checksum_user_id = NULL
and
	checksum = NULL


update
        #outside_accounts 
set
	status = "Ready to approve",
        approve = "Approve"
where
        account_number != NULL
and
        checksum_user_id != NULL
and
	approval_user_id = NULL

	
update
        #outside_accounts 
set
	status = "<span style=""color:#FF6666;font-style:italic"">Waiting for approval from second user</span>",
        approve = NULL
where
        account_number != NULL
and
        checksum_user_id != NULL
and
	approval_user_id = NULL
and
	checksum_user_id = @tico_account_id	

update
        #outside_accounts
set
	status = "<span style=""color:#FF6666;font-style:italic"">Needs an account number</span>",
        edit_account = "Edit",
	recon = NULL
where
        checksum_user_id = NULL
and
        approval_user_id = NULL
and
	account_number = NULL

update
	#outside_accounts
set
	checksum_user = b.login
from
	#outside_accounts a,
	tico_accounts b
where
	a.checksum_user_id = b.account_id

update
        #outside_accounts
set
        approval_user = b.login
from
        #outside_accounts a,
        tico_accounts b
where
        a.approval_user_id = b.account_id





select
        style = @style,
	section = "Instruction Operations",
        back = " Back to Legal Entities Home",
        legal_entity = @legal_entity,
	outside_account=name,
	status,
	generate,
	approve,
	recon,
	refresh = "Refresh"
from
	#outside_accounts

select
	/*status,*/
	section = "Instruction Details",
	legal_entity = @legal_entity,
	outside_account_type,
	oa_type=outside_account_type,
	provider_name,
	outside_account=name,
	name,
	account_number,
	account_code,
	account_code_type,
	checksum,
	checksum_status,
	checksum_user,
	approval_user,
	/*
	generate,
	approve,
	*/
	edit_account,
	/*last_recon,*/
	style
from 
	#outside_accounts


select
	section = "Recon Requests - Open",
	style = @style,
	recon_id = a.oa_recon_request_id,
	outside_account = d.name,
	requestor = b.login,
	status = c.name,
	a.request_date,
	a.respond_timestamp,
	a.respond_message
from
	oa_recon_requests a,
	tico_accounts b,
	statuses c,
	#outside_accounts d
where
	a.requestor_id = b.account_id
and
	a.status_id = c.status_id
and
	a.outside_account_id = d.outside_account_id
and
	c.name in("New", "Pending")
order by
	request_date DESC

select top 10
        section = "Allocation Requests - Closed - Last 10",
        style = @style,
	recon_id = a.oa_recon_request_id,
	outside_account = d.name,
        requestor = b.login,
        status = case c.name when 'Rejected' then "<b><font color='FF0000'>Rejected</font></b>" else "<b><font color='00CC00'>"+rtrim(c.name)+"</font></b>" end,
        a.request_date,
        a.respond_timestamp,
        a.respond_message
from
        oa_recon_requests a,
        tico_accounts b, 
        statuses c,
        #outside_accounts d
where
        a.requestor_id = b.account_id
and
        a.status_id = c.status_id
and
        a.outside_account_id = d.outside_account_id
and
        c.name not in("New", "Pending")
order by
        request_date DESC


go
