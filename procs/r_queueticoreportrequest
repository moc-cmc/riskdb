create or replace procedure
	r_queueticoreportrequest
		@login varchar(50),
		@tico_report varchar(100),
		@run varchar(50),
		@as_of_date datetime

as

declare @tico_report_id int
declare @name varchar(150)
declare @run_id int
declare @proc_name varchar(150)
declare @filename_tmpl varchar(150)
declare @params_tmpl varchar(150)
declare @report_user_id int
declare @status_id int
declare @tico_report_request_id int
declare @tico_account_id int
declare @new_status_id int

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login
if @tico_account_id = NULL
begin
        select
                status="Error",
                message="Problem finding account for login",
                login = @login
        return
end

select
	@run_id = run_id
from
	runs
where
	name = @run
if @run_id = NULL
begin
        select
                status = "Error",
                message = "Run not found",
                run_name = @run
        return
end

select
	@new_status_id = status_id
from
	statuses
where
	name = "New"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "could not find status",
		name = "New"
	return
end

select
	@tico_report_id = tico_report_id
from
	tico_reports
where
	run_id = @run_id
and
	name = @tico_report
if @tico_report_id = NULL
begin
	select
		status = "Error",
		message = "Could not find tico_report_id",
		run = @run,
		report = @tico_report
	return
end

select
	@tico_report_request_id = tico_report_request_id
from
	tico_report_requests
where
	tico_report_id = @tico_report_id
and
	convert(date, as_of_date) = convert(date, @as_of_date)

if @tico_report_request_id != NULL
begin
	select
		status = "Error",
		message = "This report has already been requested for this date",
		report = @tico_report,
		run = @run,
		date = @as_of_date
	return
end
else
begin
	exec
		j_nextkey
			"tico_report_requests",
			@tico_report_request_id output

	insert into
		tico_report_requests(
			tico_report_request_id,
			tico_report_id,
			as_of_date,
			request_date,
			status_id)
		values(
			@tico_report_request_id,
			@tico_report_id,
			convert(date, @as_of_date),
			getdate(),
			@new_status_id)
end

exec
	ag_ticoreportrequests
		@login,
		@tico_report,
		@run
		
go
