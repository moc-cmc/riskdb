drop procedure r_clientmarketalloc
go

create procedure
	r_clientmarketalloc
		@deal_id int=NULL

as

declare @client_alloc_ext_acct_id int
declare @client_ext_acct_id int
declare @client_accts_count int
declare @id int
declare @ids int
declare @allocated_status_id int

declare @client_alloc_strategy_id int
declare @client_strategy_id int
declare @client_strategy_count int

declare @only_cl_ext_acct int
declare @only_cl_strategy int 

declare @already_allocated_count int

if @deal_id = NULL
	return
select
	@allocated_status_id = status_id
from
	statuses
where
	name = "Allocated"

/* QUERY all trades in given deal */
create table
	#deal_trades
(
	trade_id int,
	external_account_id int,
	counterparty_id int,
	strategy_id int,
	status_id int
)
insert into
	#deal_trades
select
	trade_id,
	external_account_id,
	counterparty_id,
	strategy_id,
	status_id 
from
	trades
where
	deal_id = @deal_id
and
	quantity != 0 

select 
	@already_allocated_count = count(*)
from
	#deal_trades
where
	status_id = @allocated_status_id
if @already_allocated_count > 0
begin
        select
                error="Warning",
                msg="One or more trades in this deal are already allocated, may need manual intervention"
end


/* QUERY client trades in deal */
create table
	#cl_deal_trades
(
	trade_id int,
	external_account_id int,
	strategy_id int
)

insert into
	#cl_deal_trades
select
	a.trade_id,
	a.external_account_id,
	a.strategy_id
from
	#deal_trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id


/* FILTER client trades out of deal_trades */
delete
	#deal_trades
from
	#deal_trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id

/* REMOVE internal LP trades 
delete from
	#deal_trades
from
	#deal_trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Internal"
*/


/* CHECK there is only 1 client account in the deal */

select
	@only_cl_ext_acct = external_account_id
from	
	#cl_deal_trades
group by
	external_account_id
if @@rowcount != 1
begin
	select
		error="Error",
		msg="Problem finding only 1 client account in deal"
	return
end
else
begin
	select
		@client_accts_count = 1
end

/* CHECK there is only 1 client strategy in deal */
select
	@only_cl_strategy = strategy_id
from
	#cl_deal_trades
group by
	strategy_id
if @@rowcount !=1
begin
	select
		error="Error",
		msg="Problem finding only 1 client strategy in deal"
	return
end
else
begin
	select
		@client_strategy_count = 1
end


/* QUERY the client external acount in the deal  */
if @client_accts_count = NULL
begin
	return
end
else
begin
	select
		@client_ext_acct_id = external_account_id
	from
		#cl_deal_trades
	group by
		external_account_id
 
	if @client_ext_acct_id = NULL
	begin
		select
			error="Error",
			msg="Problem finding client account for deal"
		return
	end 
end

/* QUERY the client strategy acount in the deal  */
if @client_strategy_count = NULL
begin
	return
end
else
begin
	select
		@client_strategy_id = strategy_id
	from
		#cl_deal_trades
	group by
		strategy_id

	if @client_strategy_id = NULL
	begin
		select
			error="Error",
			msg="Problem finding client strategy for deal"
		return
	end
end



/* QUERY the market allocation for the client account in the deal */
select
	@client_alloc_ext_acct_id = mkt_external_account_id
from
	client_mkt_accounts
where
	cl_external_account_id = @client_ext_acct_id
if @client_alloc_ext_acct_id = NULL
begin
	select
		error="Error",
		msg="Problem finding market allocation for client account",
		client_ext_acct_id = @client_ext_acct_id
	return
end

/* QUERY the market allocation for the client strategy in the deal */
select
	@client_alloc_strategy_id = mkt_strategy_id
from
	client_mkt_strategies
where
	cl_strategy_id = @client_strategy_id
if @client_alloc_strategy_id = NULL
begin
	select
		error="Error",
		msg="Problem finding market allocation for client strategy",
		client_strategy_id = @client_strategy_id
	return
end



/* UPDATE the external_account, strategy_id and status_id for unallocated trades in deal */
update
	trades
set
	a.external_account_id = @client_alloc_ext_acct_id,
	a.strategy_id = @client_alloc_strategy_id,
	a.status_id = @allocated_status_id
from	
	trades a,
	#deal_trades b
where
	a.trade_id = b.trade_id

/* Notify all trades */
select
	@id = 0
select
	@ids = count(*)
from
	#deal_trades
where
	trade_id > @id

while @ids > 0
begin
	select
		@id = min(trade_id)
	from
		#deal_trades
	where
		trade_id > @id

	exec 
		r_inserttradenotification
			@trade_id = @id

	select
		@ids = count(*)
	from
		#deal_trades
	where
		trade_id > @id
end



go 
