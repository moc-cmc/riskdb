create table
	#output_trades(
		trade_id int)

if @ext_account_count >= 1
begin
	insert into
		#output_trades(
			trade_id)
	select
		a.trade_id
	from
		trades a,
		#external_accounts b
	where
                a.trade_date >= @begin_date
        and
                a.trade_date < @end_date
        and
                a.quantity != 0
	and
		a.external_account_id = b.external_account_id 
end

if @int_account_count >= 1
begin
        insert into
                #output_trades(
                        trade_id)
        select
                a.trade_id
        from
                trades a,
                #internal_accounts b
        where
                a.trade_date >= @begin_date
        and
                a.trade_date < @end_date
        and
                a.quantity != 0
        and
                a.internal_account_id = b.internal_account_id 
end

if @trader_count >= 1
begin
        insert into
                #output_trades(
                        trade_id)
        select
