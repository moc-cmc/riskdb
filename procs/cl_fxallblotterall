create procedure
	cl_fxallblotterall
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL


as

declare @run_id int
declare @tico_account_id int

declare @date datetime
declare @trade_date datetime

declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @ext_account_count int
declare @int_account_count int
declare @strategy_count int
declare @trader_count int
declare @ctpy_count int
declare @broker_count int
declare @trade_id int
declare @start_time datetime
