	insert into
        	#output_trades(
                	trade_id)
        select
                a.trade_id
        from
                trades a,
                #counterparties b
        where
                a.trade_date >= @begin_date
        and
                a.trade_date < @end_date
        and
                a.quantity != 0
        and
		a.counterparty_id = b.counterparty_id
end             


create table
	#trades(
		currency_pair varchar(20) NULL,
		trade_date varchar(11) NULL,
		provider_name varchar(30) NULL,
		customer_trader varchar(30) NULL,
		counterparty varchar(30) NULL,
		trade_id int,
		value_date varchar(11) NULL,
		fixing_date varchar(11) NULL,
		product varchar(30) NULL,
		buy_sell varchar(10) NULL,
		dealt_currency varchar(20) NULL,
		dealt_amount numeric(30,4) NULL,
		contra_currency varchar(20) NULL,
		contra_amount numeric(30,4) NULL,
		spot_date varchar(11) NULL,
		spot_rate float NULL,
		forward_points float NULL,
		all_in_rate float NULL,
		broker varchar(30) NULL
		)

if @trade_id = NULL
begin

	insert into
        	#trades(
			trade_id)
	select
        	distinct(trade_id)
	from
        	#output_trades

	update 
        	#trades
	set
        	dealt_amount = a.quantity * -1.0,     /* quantity goes in with client view and is updated to abs value with update */
        	contra_amount = a.quantity * a.price,
        	all_in_rate = a.price,
        	value_date = convert(varchar(11), a.value_date, 1),
        	trade_date = convert(varchar(11), a.trade_date, 1),
        	fixing_date = convert(varchar(11), a.fixing_date, 1),
        	spot_rate = a.spot_reference
	from
        	trades a,
		#trades b
	where
		a.trade_id = b.trade_id


	/*
	insert into
                #trades(
                        trade_id,
                        dealt_amount,
                        contra_amount,
                        all_in_rate,
                        value_date,
                        trade_date,
                        fixing_date,
                        spot_rate)
        select  
                a.trade_id,
                a.quantity * -1.0,     /* quantity goes in with client view and is updated to abs value with update */
                a.quantity * a.price,
                a.price,
                value_date = convert(varchar(11), a.value_date, 1),
                trade_date = convert(varchar(11), a.trade_date, 1),
                fixing_date = convert(varchar(11), a.fixing_date, 1),
                a.spot_reference
        from
                trades a,
                #external_accounts b /*,
                #internal_accounts c,
                #traders d,
                #strategies e,
                #brokers f,
                #counterparties g */
        where
                a.trade_date >= @begin_date
        and
                a.trade_date < @end_date
        and
                a.quantity != 0
        and
                a.external_account_id = b.external_account_id /*
        or
                a.internal_account_id = c.internal_account_id
        or
                a.trader_id = d.trader_id
        or
                a.strategy_id = e.strategy_id
        or
                a.broker_id = f.broker_id
        or
                a.counterparty_id = g.counterparty_id) */
	*/

end

/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    a.all_in_rate = case 
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.all_in_rate) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.all_in_rate) * d.factor
        when c.factor != NULL then
            a.all_in_rate * c.factor * d.factor
        else
            a.all_in_rate * d.factor
    end
from
    #trades a,
    trades e,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.trade_id = e.trade_id
and
    e.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id

update
	#trades
set
	a.product = case
	    when a.fixing_date != NULL then
		"NDF"
	    else
		c.name
	end
from
	#trades a,
	trades b,
	trade_types c
where
	a.trade_id = b.trade_id
and
	b.trade_type_id = c.trade_type_id


update
	#trades
set
	dealt_currency = d.symbol
from
	#trades a,
	trades b,
	forwards c,
	products d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.product_id = d.product_id


update
	#trades
set
	contra_currency = d.symbol
from
	#trades a,
	trades b,
	forwards c,
	products d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.currency_id = d.product_id

	
update
	#trades
set
	a.provider_name = rtrim(c.symbol) +"-"+ rtrim(e.symbol)
from
	#trades a,
	trades b,
	internal_accounts c,
	external_account_prime_brokers d,
	prime_broker_symbols e
where
	a.trade_id = b.trade_id
and
	b.internal_account_id = c.internal_account_id
and
	b.external_account_id = d.external_account_id 
and
	d.prime_broker_id = e.prime_broker_id
	
update
        #trades
set
        a.customer_trader = c.symbol
from
        #trades a,
        trades b,
        traders c
where
        a.trade_id = b.trade_id
and
        b.trader_id = c.trader_id


update
	#trades
set
	counterparty = b.name
from
	#trades a,
	counterparties b,
	trades c
where
	a.trade_id = c.trade_id
and
	b.counterparty_id = c.counterparty_id

update 
	#trades
set
	customer_trader = a.counterparty
from
	#trades a,
	trades b,
	fund_agency_traders c
where
	a.trade_id = b.trade_id
and
	b.trader_id = c.trader_id
	

update 
	#trades
set
	buy_sell = "SELL"
where
	dealt_amount < 0
update 
	#trades
set
	buy_sell = "BUY"
where
	dealt_amount > 0

update 
	#trades
set
	dealt_amount = abs(dealt_amount),
	contra_amount = abs(contra_amount),
	currency_pair = rtrim(dealt_currency) + "-" + rtrim(contra_currency)

update
	#trades
set
	broker = c.symbol
from
	#trades a,
	trades b,
	brokers c
where
	a.trade_id = b.trade_id
and
	b.broker_id = c.broker_id

/*
select
        @end_time = getdate()
select
        @end_time
*/


select  
	trade_id,
	trade_date,
	provider_name,
	customer_trader,
	"platform"=broker,
	currency_pair,
	buy_sell,
	dealt_currency,
	dealt_amount,
	contra_currency,
	contra_amount,
	spot_date,
	spot_rate,
	forward_points,
	all_in_rate,
	fixing_date,
	value_date,
	product	
from 
	#trades 
order by 
	trade_id

