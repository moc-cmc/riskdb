	@total_opt_longs = sum(a.opt_usd_equiv)
from
	#products a,
	products b
where
	a.product_id = b.product_id
and
	b.product_type_id = @asset_class_type_id
and
	a.opt_usd_equiv >= 0

select
	@total_opt_shorts = sum(a.opt_usd_equiv)
from
	#products a,
	products b
where
	a.product_id = b.product_id
and
	b.product_type_id = @asset_class_type_id
and
	a.opt_usd_equiv < 0

select
	/* @net_limit_use = sum(abs(a.product_total_usd_equiv)) / 2.0 */
	@net_limit_use = sum(a.product_total_usd_equiv)
from
	#exposure a,
