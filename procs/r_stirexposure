						@usd_equiv = @give_product_qty
				if @usd_equiv = NULL
					exec
						r_dollaramount
							@give_product_id,
							@give_product_qty,
							@end_date,
							@usd_equiv output
				select
					@usd_equiv = @usd_equiv * -1.0
			end

		end
	
		update
			#products
		set
			opt_quantity = opt_quantity + @get_product_qty,
			opt_usd_equiv = opt_usd_equiv + @usd_equiv
		where
			product_id = @get_product_id
		if @@rowcount != 1
			insert into
				#products
			values(
				@get_product_id,
				@give_product_id,
				0,
				0,
				@get_product_qty,
				@usd_equiv)
	

		select
			@expiration = expiration
		from
			future_contracts
		where
			contract_id = @perspective_contract_id /* FUCK */
		if @@rowcount != 1
