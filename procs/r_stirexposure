/* end option part */

select
	@product_id = 0
select
	@products = count(*)
from
	#products
where
	product_id > @product_id


while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#products
	where
		product_id > @product_id

	select
		@spot_longs = NULL,
		@spot_longs_usd = NULL,
		@option_longs = NULL,
		@option_longs_usd = NULL,
		@spot_shorts = NULL,
		@spot_shorts_usd = NULL,
		@option_shorts = NULL,
		@option_shorts_usd = NULL,
		@product_total_usd_equiv = 0

	select
		@symbol = symbol
	from
		products
	where
		product_id = @product_id

	select
		@spot_longs = quantity,
		@spot_longs_usd = usd_equiv
	from
		#products
	where
		quantity >= 0
	and
		product_id = @product_id
	if @spot_longs_usd != NULL
		select
			@product_total_usd_equiv = @product_total_usd_equiv + @spot_longs_usd

	select
		@option_longs = opt_quantity,
		@option_longs_usd = opt_usd_equiv
	from
		#products
	where
		product_id = @product_id
	and
		opt_quantity >= 0
	if @option_longs_usd != NULL
		select
			@product_total_usd_equiv = @product_total_usd_equiv + @option_longs_usd

	select
		@spot_shorts = quantity,
		@spot_shorts_usd = usd_equiv
	from
		#products
	where
		product_id = @product_id
	and
		quantity < 0
	if @spot_shorts_usd != NULL
		select
			@product_total_usd_equiv = @product_total_usd_equiv + @spot_shorts_usd

	select
		@option_shorts = opt_quantity,
		@option_shorts_usd = opt_usd_equiv
	from
		#products
	where
		product_id = @product_id
	and
		opt_quantity < 0
	if @option_shorts_usd != NULL
		select
			@product_total_usd_equiv = @product_total_usd_equiv + @option_shorts_usd
			
