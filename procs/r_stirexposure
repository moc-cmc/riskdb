where
	a.product_id = b.product_id
and
	b.product_type_id = @asset_class_type_id
and
	a.usd_equiv >= 0


select
	@total_shorts = sum(a.usd_equiv)
from
	#products a,
	products b
where
	a.product_id = b.product_id
and
	b.product_type_id = @asset_class_type_id
and
	a.usd_equiv < 0

