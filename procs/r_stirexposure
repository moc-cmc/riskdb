create table
	#contracts(
		contract_id int)
insert into
	#contracts
select
	a.contract_id
from
	future_contracts a,
	futures b,
	forwards c,
	products d
where
	a.future_id = b.future_id
and
	b.forward_id = c.contract_id
and
	c.product_id = d.product_id
and
	d.product_type_id = @asset_class_type_id
and
	a.expiration >= @begin_date


create table
	#positions(
		contract_id int,
		position float)
		

insert into
	#positions
select
	b.contract_id,
	sum(b.quantity)
from
	#contracts a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.trade_date <= @end_date
group by
	b.contract_id

create table
	#options(
		contract_id int,
		position float)
insert into
	#options
select
	b.contract_id,
	sum(a.quantity)
from
	trades a,
	option_contracts b,
	option_expirations c,
	#external_accounts d,
	#internal_accounts e,
	#traders f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.expiration >= @end_date
and
	a.external_account_id = d.external_account_id
and
	a.internal_account_id = e.internal_account_id
and
	a.trader_id = f.trader_id
and
	a.trade_date <= @end_date
group by
	b.contract_id

create table
	#deltas(
		contract_id int,
		delta float NULL,
		option_delta float NULL,
		total_delta float NULL,
		vol float NULL,
		weighted_delta float NULL,
		net_usd_exposure float NULL,
		price float NULL,
		change float NULL,
		expiration datetime NULL)

delete

from
	#options
where
	position = 0


create table
	#products(
		product_id int,
		currency_id int,
		quantity float NULL,
		usd_equiv float NULL,
		opt_quantity float,
		opt_usd_equiv float)

select
	@contract_id = 0
select
	@contracts = count(*)
from
	#positions
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#positions
	where
		contract_id > @contract_id

	select
		@exposure = NULL,
		@give_product_id = NULL,
		@get_product_id = NULL,
		@multiplier = NULL,
		@perspective_multiplier = NULL,
		@price = NULL,
		@prev_price = NULL,
		@usd_equiv = NULL,
		@perspective_contract_id = NULL

	select
		@exposure = position
	from
		#positions
	where
		contract_id = @contract_id

	exec
		r_contractproduct
			@contract_id,
			@get_product_id output

	exec
		r_contractcurrency
			@contract_id,
			@give_product_id output
	exec
		r_priceasof
			@contract_id,
			@end_date,
			@price output

	exec
		r_priceasof
			@contract_id,
			@begin_date,
			@prev_price output

	exec
		x_contractmultiplier
			@contract_id,
			@multiplier output

	exec
		r_perspectivecontract
			@run_id,
			@contract_id,
			@perspective_contract_id output
	exec
		x_contractmultiplier
			@perspective_contract_id,
			@perspective_multiplier output


	select
		@vol = NULL
	exec
		r_volasof
			@perspective_contract_id,
			@end_date,
			@vol output


	if @asset_class = "STIR"
	begin
		select
			@multiplier = @multiplier * convert(float, a.value)
		from
			future_attributes a,
			future_contracts b
		where
			a.future_id = b.future_id
		and
			b.contract_id = @perspective_contract_id
		and
			a.attribute_type_id = @tick_size_attribute_type_id

		select
			@perspective_multiplier = 1.0
		select
			@get_product_qty = @exposure * @multiplier,
			@give_product_qty = -@get_product_qty
	end
	else
		select
			@get_product_qty = @exposure * @multiplier,
			@give_product_qty = @exposure * -1.00 * @price * @multiplier


	if @get_product_qty = NULL
		select
			@get_product_qty = 0
	if @give_product_qty = NULL
		select
			@give_product_qty = 0

	if @give_product_id = @usd_product_id
	begin
		select
			@usd_equiv = @get_product_qty
	end
	if @usd_equiv = NULL
	begin
		exec
			r_dollaramount
				@give_product_id,
				@get_product_qty,
				@end_date,
				@usd_equiv output
	end


	update
		#products
	set
		quantity = quantity + @get_product_qty/@perspective_multiplier,
		usd_equiv = usd_equiv + @usd_equiv
	where
		product_id = @get_product_id
	if @@rowcount != 1
	begin
		insert into
			#products
		values(
			@get_product_id,
			@give_product_id,
			@get_product_qty/@perspective_multiplier,
			@usd_equiv,
			0,
			0)
	end

	select
		@expiration = NULL

	select
		@expiration = expiration
	from
		future_contracts a
	where
		contract_id = @perspective_contract_id


	update
		#deltas
	set
		delta = delta + @exposure,
		total_delta = total_delta + @exposure,
		net_usd_exposure = net_usd_exposure + @usd_equiv,
		vol = @vol,
		price = @price,
		change = @price - @prev_price
	where
		contract_id = @perspective_contract_id
	if @@rowcount != 1
		insert into
			#deltas
		values(
			@perspective_contract_id,
			@exposure,
			0,
			@exposure,
			@vol,
			NULL,
			@usd_equiv,
			@price,
			@price - @prev_price,
			@expiration)

	select
		@contracts = count(*)
	from
		#positions
	where
		contract_id > @contract_id
end

