create table
	#runs(
		run_id int)

select
	@asset_class_type_id = product_type_id
from
	product_types
where
	name = @asset_class
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding asset class",
		asset_class = @asset_class
	return
end

select
	@tick_size_attribute_type_id = attribute_type_id
from
	attribute_types
where
	name = "Tick Size"

insert into
	#runs
select
	run_id
from
	runs
where
	name = @run_name 
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding exposure runs"
	return
end 

select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"
if @usd_product_id = NULL
begin
	select
		id = -1,
		error = "Problem finding USD product!!"
	return
end


if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) > 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)



