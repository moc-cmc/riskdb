	s_usd_equiv = convert(char(30), convert(numeric(30,2), a.spot_shorts_usd / 1.000000)),
	option_shorts = convert(char(30), convert(numeric(30,2), a.option_shorts)),
	s_opt_equiv = convert(char(30), convert(numeric(30,2), a.option_shorts_usd / 1.000000)),
	NULL,
	symbol = "<div align=right>" + a.product + "</div>",
	net_usd_equiv = convert(char(30), convert(numeric(30,2), a.product_total_usd_equiv / 1.000000))
