			vol = @vol
		where
			contract_id = @perspective_contract_id
		if @@rowcount != 1
			insert into
				#deltas
			values(
				@perspective_contract_id,
				0,
				@delta,
				@delta,
				@vol,
				NULL,
				@usd_equiv,
				NULL,
