	spot_longs = convert(char(30), convert(numeric(30,2), a.spot_longs)),
	l_usd_equiv = convert(char(30), convert(numeric(30,2), a.spot_longs_usd / 1.000000)),
	option_longs = convert(char(30), convert(numeric(30,2), a.option_longs)),
	l_opt_equiv = convert(char(30), convert(numeric(30,2), a.option_longs_usd  / 1.000000)),
