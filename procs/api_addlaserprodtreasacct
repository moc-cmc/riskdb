create or replace procedure
	api_addlaserprodtreasacct
		@external_account varchar(50),
		@product varchar(50)

as

declare @product_id int
declare @external_account_id int
declare @id int

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding product",
		product = @product
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding external_account",
		external_account = @external_account
	return
end

select
	@id = id
from
	laser_product_treas_accts	
where
	product_id = @product_id
and
	external_account_id = @external_account_id
if @id = NULL
begin

	insert into
		laser_product_treas_accts(
			product_id,
			external_account_id)
	select
		@product_id,
		@external_account_id 
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	message = "Problem inserting record",
                	external_account = @external_account,
			product = @product
        	return
	end
end

select
	status = "Success",
	message = "Added product treasury account association",
	external_account = @external_account,
	product = @product

go
