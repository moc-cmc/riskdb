use
	risk_cc
go

drop procedure
	r_sourcemasterallocation
go

create procedure
	r_sourcemasterallocation
		@login varchar(50),
		@source varchar(50),
		@strategy varchar(50),
		@deployment_date datetime,
		@ma_version_id int output

as


declare @source_id int
declare @master_allocation_id int


select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end

select
	@master_allocation_id = master_allocation_id
from
	master_allocation_symbols
where
	source_id = @source_id
and
	symbol = @strategy
if @master_allocation_id = NULL
begin
	select
		status = "Error",
		message = "Master allocation for source not found",
		master_allocation = @strategy,
		source = @source
	return
end

select
	@ma_version_id = ma_version_id
from
	ma_versions
where
	master_allocation_id = @master_allocation_id
and
	convert(date, deployment_date) = convert(date, @deployment_date)
if @ma_version_id = NULL
begin
	select
		status = "Error",
		message = "Master allocation for deployment date not found",
		deployment_date = @deployment_date
	return
end


go



		
