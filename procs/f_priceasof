
if object_id("f_priceasof") != NULL
    drop procedure
        f_priceasof
go

create procedure
	f_priceasof
		@contract_id int,
		@as_of_date datetime,
		@price float output,
		@pl_price_type_id int output,
		@is_committable int output
as

declare @timestamp datetime
declare @price_date datetime
declare @c_price_date datetime
declare @inverted_price_date datetime
declare @prev_business_day datetime
declare @inverted_contract_id int
declare @is_stale int
declare @is_expired int
declare @instrument char(50)
	
if @contract_id = NULL
	return

exec
	r_isexpired
		@contract_id,
		@as_of_date,
		@is_expired output

if @is_expired = 1
begin
	select
		@instrument = a.name
	from
		instruments a,
		contracts b
	where
		a.instrument_id = b.instrument_id
	and
		b.contract_id = @contract_id

	if @instrument = "Option"
	begin
		select
			@price = 0,
			@pl_price_type_id = 1,
			@is_committable = 1
		return
	end
	if @instrument = "Future"
	begin
		select
			@price = price
		from
			prices
		where
			contract_id = @contract_id
		and
			price_date = 
				(select
				 	max(price_date) 
				from
					prices
				where
					contract_id = @contract_id
				and
					price_date <= @as_of_date)
		select
			@pl_price_type_id = 1,
			@is_committable = 1
	end

	return
end




select
	@c_price_date = max(a.price_date)
from
	prices a,
	price_types b
where
	a.price_type_id = b.price_type_id
and
	b.name = "Close"
and
	a.contract_id = @contract_id
and
	a.price_date <= @as_of_date


exec
	r_invertedcontract
		@contract_id,
		@inverted_contract_id output

select
	@inverted_price_date = max(a.price_date)
from
	prices a,
	price_types b
where
	a.price_type_id = b.price_type_id
and
	b.name = "Close"
and
	a.contract_id = @inverted_contract_id
and
	a.price_date <= @as_of_date

if @c_price_date = NULL
	select
		@c_price_date = "1/1/90"

if @inverted_price_date = NULL
	select
		@inverted_price_date = "1/1/90"


if @inverted_price_date >= @c_price_date
begin
	select
		@price_date = @inverted_price_date
	select
		@price = 1.0 / a.price
	from
		prices a,
		price_types b
	where
		a.price_type_id = b.price_type_id
	and
		b.name = "Close"
	and
		a.contract_id = @inverted_contract_id
	and
		a.price_date = @price_date
end
else
begin
	select
		@price_date = @c_price_date
	select
		@price = a.price
	from
		prices a,
		price_types b
	where
		a.price_type_id = b.price_type_id
	and
		b.name = "Close"
	and
		a.contract_id = @contract_id
	and
		a.price_date = @price_date
end
		

exec
	r_prevbusinessday
		@as_of_date,
		@prev_business_day output


select
	@is_stale = 0
if @price_date <= @prev_business_day
begin
	select
		@is_stale = 1

end

	
select
	@is_committable = 1

if @is_stale = 1
begin
	/* select
		msg = "Stale settle",
		contract = symbol,
		as_of_date = @as_of_date,
		prev_business_day = @prev_business_day,
		price_date = @price_date
	from
		contracts
	where
		contract_id = @contract_id */
	select
		@is_committable = 0
end

if @price = NULL
begin
	/* select
		messg = "There is Missing settle",
		as_of_date = @as_of_date,
		price_date = @price_date,
		contract = symbol,
		price = @price
	from
		contracts
	where
		contract_id = @contract_id */
	select
		@is_committable = 0
end
	
go
