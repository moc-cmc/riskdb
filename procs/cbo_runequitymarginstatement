insert into
        #output(
                external_account_id,
		account_type,
		account,
		initial_margin)
select
	external_account_id,
	external_account_type,
        symbol,
        margin
from
        #ext_accounts

update
	#output
set
        leverage = rtrim(convert(varchar(10), (round(a.nop_limit, 0)/round(a.margin, 0))))+":1",
        leverage_decimal = round(a.margin, 0)/round(a.nop_limit, 0)
from
	#ext_accounts a,
	#output b
where
	a.external_account_id = b.external_account_id
and
	a.margin != NULL

update 
	#output
set
	leverage = substring(leverage, 1, patindex("%.%", leverage)-1)+":1"
where
	leverage != NULL
or
	leverage != ""

update
	#output
set
	account_balance = balance
from
	#output a,
	#total_balances b
where
	a.external_account_id = b.external_account_id

update
        #output
set
        a.open_pl = b.open_pl
from
        #output a,
        #total_open_pl b
where
        a.external_account_id = b.external_account_id

update
	#output
set
	open_pl = 0
where
	open_pl = NULL
and
	account_balance != NULL

update
        #output
set
        a.margin_used = (b.abs_margin_used * a.leverage_decimal)
from
        #output a,
        #total_margin_used b
where
        a.external_account_id = b.external_account_id


update
	#output
set
	equity = account_balance - open_pl

update
	#output
set
	equity = account_balance + open_pl
where
	account_type = "Counterparty"

update
	#output
set
	free_margin = equity - margin_used,
	margin_level = (equity / margin_used ) * 100
	
