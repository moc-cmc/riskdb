create table
	#conversion_rates
(
		forward_id int,
		product_id int,
		value_date datetime null,
		rate float null,
		inverted char(1) null
)

declare @id int
declare @ids int
declare @p_external_account_id int
declare @p_value_date datetime
declare @p_product_id int
declare @p_forward_id int
declare @p_as_of_date datetime
declare @p_days float
declare @p_spot_price float
declare @p_forward_price float
declare @p_give_product_rate float
declare @p_get_product_rate float
declare @p_foward_inverted char(1)

select
	@p_as_of_date = getdate()

select
	@id = 0
select
	@ids = count(*)
from
	#ladder
where
	product_id != @evaluation_currency_id
and
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ladder
	where
		product_id != @evaluation_currency_id
	and
		id > @id
	select
		@p_foward_inverted = NULL,
		@p_external_account_id = NULL,
		@p_value_date = NULL,
		@p_product_id = NULL,
		@p_forward_id = NULL,
		@p_days = NULL,
		@p_spot_price = NULL,
		@p_forward_price = NULL,
		@p_give_product_rate = NULL,
		@p_get_product_rate = NULL
		
	select
		@p_external_account_id = external_account_id,
		@p_value_date = value_date,
		@p_product_id = product_id
	from
		#ladder
	where
		id = @id

	select
		@p_forward_id = contract_id
	from
		forwards
	where
		product_id = @p_product_id
	and
		currency_id = @evaluation_currency_id

	/* if forward is inverted, requery opposite */
	select
		@p_foward_inverted = "Y"
	from
		contract_price_styles a,
		price_styles b
	where
		a.price_style_id = b.price_style_id
	and
		a.contract_id = @p_forward_id
	and
		b.name = "Inverted"

	if @p_foward_inverted = "Y"
	begin
        	select
                	@p_forward_id = contract_id
        	from
                	forwards
        	where
                	currency_id = @p_product_id
        	and
                	product_id = @evaluation_currency_id
	end


	/* use spot price instead 
	exec
		r_forwardpriceasof
			@contract_id = @p_forward_id,
			@as_of_date = @p_as_of_date,
			@forward_date = @p_value_date,
			@days = @p_days output,
			@spot_price = @p_spot_price output,
			@forward_price = @p_forward_price output,
			@give_product_rate = @p_give_product_rate output,
			@get_product_rate = @p_get_product_rate output
       */
			

	insert into
		#conversion_rates(
			forward_id,	
		  	product_id,
			inverted
		)
	values(
		@p_forward_id,
		@p_product_id,
		@p_foward_inverted
	)

	
	select
		@ids = count(*)
	from
		#ladder
	where
		product_id != @evaluation_currency_id
	and
		id > @id
end

update
	#conversion_rates
set
	rate = b.price
from
	#conversion_rates a,
	current_prices b
where
	a.forward_id = b.contract_id

update
	#conversion_rates
set
	rate = 1/rate
where
	inverted = "Y"


