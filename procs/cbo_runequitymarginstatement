create table
	#contracts
(
	contract_id int,
	symbol varchar(100),
	product_id int null,
	product varchar(50) null,
	currency_id int null,
	currency varchar(50) null,
	price_style varchar(50) null,
	standard_contract_id int null,
	standard_symbol varchar(100) null,
	current_price float null
)

insert into 
	#contracts(
		contract_id,
		symbol,
		standard_contract_id,
		standard_symbol
)
select
	b.contract_id,
	b.symbol,
	b.contract_id,
	b.symbol
from
	#trades a,
	contracts b
where
	a.contract_id = b.contract_id
group by
	b.contract_id,
	b.symbol

update
	#contracts
set
	product_id = c.product_id,
	product = c.symbol,
	currency_id = d.product_id,	
	currency = d.symbol
from
	#contracts a,
	forwards b,
	products c,
	products d
where
	a.contract_id = b.contract_id
and
	b.product_id = c.product_id
and
	b.currency_id = d.product_id

update
	#contracts
set
	price_style = c.name
from
	#contracts a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id

update
	#contracts
set
	standard_contract_id = b.contract_id,
	standard_symbol = b.symbol
from
	#contracts a,
	contracts b,	
	forwards c
where
	b.contract_id = c.contract_id
and
	a.product_id = c.currency_id
and
	a.currency_id = c.product_id
and	
	a.price_style = "Inverted"

update
	#contracts 
set
	current_price = b.price
from
	#contracts a,
	current_prices b
where
	a.contract_id = b.contract_id

