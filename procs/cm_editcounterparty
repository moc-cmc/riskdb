
if object_id("cm_editcounterparty") != NULL
    drop procedure
        cm_editcounterparty
go

create procedure
	cm_editcounterparty
		@login varchar(30),
		@counterparty varchar(30),
		@new_name varchar(30)
as

declare @counterparty_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)


select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @new_name
if @counterparty_id != NULL
begin
	select
		status = "Error",
		message = "New counterparty name already exists",
		new_name = @new_name
	return
end

update
	counterparties
set
	name = @new_name
where
	name = @counterparty


select
        @tico_server = tico_server,
        @tico_database = tico_database
from
        funds

select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string


exec
	cm_counterparties
		@login

go
