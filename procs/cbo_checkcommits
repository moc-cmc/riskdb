
drop procedure
	cbo_checkcommits
go

create procedure
	cbo_checkcommits
		@login varchar(50),
		@commit_status varchar(25)=NULL
as

declare @commit_status_id int
declare @commit_failed_status_id int
declare @uncommit_failed_status_id int
declare @max_date datetime
declare @min_date datetime
declare @failed_commit_date datetime
declare @failed_uncommit_date datetime

select
	@commit_failed_status_id = commit_status_id
from
	commit_statuses
where
	name="Commit Failed"

if(@@rowcount < 1)
begin
	select
		status="Error",
		msg="Could not find Commit Failed status",
		commit_status="Commit Failed"
	return
end

select 
	@uncommit_failed_status_id = commit_status_id
from
	commit_statuses
where
	name="Uncommit Failed"

if(@@rowcount < 1)
begin
	select
		status="Error",
		msg="Could not find Uncommit Failed status",
		commit_status="Uncommit Failed"
	return
end

if @commit_status != NULL
begin
	select
		@commit_status_id=commit_status_id
	from
		commit_statuses
	where
		name=@commit_status

	if @commit_status_id = NULL
	begin
		select
			status="Error",
			msg="Could not find commit status",     
			commit_status=@commit_status
		return
	end

	select 
		daily_commit_id,
		commit_date,
		commit_status=@commit_status
	from
		daily_commits
	where
		commit_status_id=@commit_status_id
	order by
		commit_date

end
else
begin	
	declare @uncommit_request_status_id int
	declare @commit_request_status_id   int

	select
		@uncommit_request_status_id=commit_status_id
	from
		commit_statuses
	where
		name="Uncommit Requested"

	if(@@rowcount < 1)
	begin
		select
			status="Error",
			msg="Could not find Uncommit Requested status",
			commit_status=@commit_status
		
		return
	end

	select
		@commit_request_status_id=commit_status_id
	from
		commit_statuses
	where
		name="Commit Requested"

	if(@@rowcount < 1)
	begin
		select
			status="Error",
			msg="Could not find Commit Requested status",
			commit_status=@commit_status
		return
	end

	declare @commit_request_count int
	
	select
		@commit_request_count = count(*)
	from
		daily_commits
	where
		commit_status_id = @commit_request_status_id

	if(@commit_request_count > 0)
	begin
		select 
			@failed_commit_date = commit_date
		from
			daily_commits
		where
			commit_status_id=@commit_failed_status_id

		if(@failed_commit_date != NULL)
		begin
			select @max_date = @failed_commit_date
		end
		else
		begin
			select
				@max_date=max(commit_date)
			from
				daily_commits 
			where
				commit_status_id=@commit_request_status_id
		end
				
		select
			a.daily_commit_id,
			a.commit_date,
			commit_status=b.name
		from
			daily_commits a,
			commit_statuses b
		where
			a.commit_status_id = @commit_request_status_id 
		and
			a.commit_status_id=b.commit_status_id
		and
			a.commit_date <= @max_date

		order by
			a.commit_status_id, commit_date asc 
	end
	else
	begin
		
		select
			@failed_uncommit_date = min(commit_date)
		from
			daily_commits 
		where
			commit_status_id = @uncommit_failed_status_id

		if (@failed_uncommit_date != NULL)
		begin
			select 
			 	@min_date = @failed_uncommit_date
		end
		else
		begin
			select
				@min_date=min(commit_date)
			from
				daily_commits
			where
				commit_status_id=@uncommit_request_status_id
		end

		select
			a.daily_commit_id,
			a.commit_date,
			commit_status=b.name
		from
			daily_commits a,
			commit_statuses b
		where
			a.commit_status_id =  @uncommit_request_status_id
		and
			a.commit_status_id=b.commit_status_id
		and
			a.commit_date >= @min_date
		order by
			a.commit_status_id, commit_date desc
	end

end

go
		


