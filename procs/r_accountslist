
create or replace procedure
	r_accountslist
		@login varchar(50)
as


declare @login_type varchar(50)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL
)

insert into
	#meta
values(
	"Column Group",
	"section",
	NULL,
	NULL
)
insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)
insert into
	#meta
values(
	"Column Link",
	"overview",
	"Account Overview",
	NULL
)

insert into
	#meta
values(
	"Column Link",
	"add_account",
	"Add Account",
	NULL
)
--Adaptive Server has expanded all '*' elements in the following statement



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

declare @total_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)

select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
        @selected_trade_style = "background:#F7F4C1;border: 1px solid white"


select
        @login_type = a.name
from
        login_types a,
        tico_account_types b,
        tico_accounts c
where
        a.login_type_id = b.login_type_id
and
        b.tico_account_id = c.account_id
and
        c.login = @login
if @login_type = NULL
begin
        select
                section = "Error",
                status = "Error",
                message = "Login type not found for login",
                login = @login,
                style = @style
        return
end

if @login_type = "Elysium"
begin
	select 
		section = "Operations",
		style = @style,
		add_account = "Add Account"
end
	
create table 
	#ext_accts(
		external_account_id int,
		name varchar(50),
		symbol varchar(50),
		account_type varchar(50),
		section varchar(50) NULL,
		style varchar(50) NULL
)


insert into
	#ext_accts
select
	a.external_account_id,
	a.name,
	a.symbol,
	b.name,
	NULL,
	@style
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id

update 
	#ext_accts
set
	section = "PB Accounts"
where
	account_type = "Counterparty"

update             
        #ext_accts 
set
        section = "Clients"
where
        account_type in("Client")

update
	#ext_accts
set
	section = "Other"
where
	account_type not in("Counterparty", "Client")

		
select
	section,
	style,
	external_account=symbol,
	overview = "OVERVIEW"
from
	#ext_accts
order by
	case when section = "Operations" then 0
	     when section = "PB Accounts" then 1
	     when section = "Clients" then 2
	     when section = "Other" then 3
	end,
	symbol ASC
if @@rowcount = 0
begin
	select
		section = "No External Accounts Configured",
		msg = "No accounts configured for system"
end





go 

