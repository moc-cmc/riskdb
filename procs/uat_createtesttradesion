drop procedure
	uat_createtesttradesion
go

create procedure
	uat_createtesttradesion
		@login varchar(50)

as

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)
declare @usdjpy_price float

create table
	#symbols(
		id int identity,
		type varchar(50) NULL,
		symbol varchar(50))
insert into
	#symbols(
		symbol)
select
	symbol
from
	contracts
where
	symbol in(
		"EURUSD",
		"USDJPY",
		"GBPUSD",
		"AUDUSD",
		"USDCAD",
		"USDCHF",
		"EURCHF",
		"EURJPY",
		"EURGPB",
		"EURAUD",
		"EURCAD",
		"GBPJPY",
		"AUDJPY",
		"CADJPY",
		"CHFJPY",
		"AUDCAD",
		"USDBRL",
		"JPYUSD")

update
	#symbols
set
	type = "NDF"
where
	symbol = "USDBRL"

update
	#symbols
set
	type = "Unconventional"
where
	symbol = "JPYUSD"

select
	@usdjpy_price = a.price
from
	current_prices a,
	contracts b
where
	a.contract_id = b.contract_id
and
	b.symbol = "USDJPY"

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"old_value_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"create_sc_fwd",
	"UAT Create Forward Trade ION",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"create_sc_swap",
	"UAT Create Swap Trade ION",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"create_sc_spot",
	"UAT Create Spot Trade ION",
	NULL) 


insert into
        #meta
values( 
        "Column Link",
        "create_sb_fwd",
        "UAT Create Bank Forward Trade ION",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "create_sb_swap",
        "UAT Create Bank Swap Trade ION",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "create_sb_spot",
        "UAT Create Bank Spot Trade ION",
        NULL)

insert into
        #meta
values( 
        "Column Link",
        "create_bb_fwd",
        "UAT Create B2B Forward Trade ION",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "create_bb_swap",
        "UAT Create B2B Swap Trade ION",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "create_bb_spot",
        "UAT Create B2B Spot Trade ION",
        NULL)



insert into
        #meta
values(
        "Column Link",
        "create_internal_spotfwd",
        "UAT Create Internal Spot Forward ION",
        NULL)

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	"#,##0.000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


select
        section = "Single Side Client",
        style = @style,
        b.symbol,
        c.type,
        price = case
                when
                        b.symbol != "JPYUSD" then convert(numeric(30,6), a.price)
                else
                        convert(numeric(30,6), @usdjpy_price)
        end,
        create_sc_spot = case
                        when
                                c.type != "NDF" or c.type = NULL then "CREATE SPOT TRADE"
                        else
                                NULL
        end,
        create_sc_fwd = "CREATE FORWARD TRADE",
        create_sc_swap = "CREATE SWAP TRADE"
from
        current_prices a,
        contracts b,
        #symbols c
where
        a.contract_id =* b.contract_id
and
        b.symbol = c.symbol
order by
        c.type,
        b.symbol

select
	section = "Single Side Bank",
        style = @style,
        b.symbol,
        c.type,
        price = case
                when
                        b.symbol != "JPYUSD" then convert(numeric(30,6), a.price)
                else
                        convert(numeric(30,6), @usdjpy_price)
        end,
        create_sb_spot = case
                        when
                                c.type != "NDF" or c.type = NULL then "CREATE SPOT TRADE"
                        else
                                NULL
        end,
        create_sb_fwd = "CREATE FORWARD TRADE",
        create_sb_swap = "CREATE SWAP TRADE"
from
        current_prices a,
        contracts b,
        #symbols c
where
        a.contract_id =* b.contract_id
and
        b.symbol = c.symbol
order by
        c.type,
        b.symbol

select
	section = "Back to Back",
        style = @style,
        b.symbol,
        c.type,
        price = case
                when
                        b.symbol != "JPYUSD" then convert(numeric(30,6), a.price)
                else
                        convert(numeric(30,6), @usdjpy_price)
        end,
        create_bb_spot = case
                        when
                                c.type != "NDF" or c.type = NULL then "CREATE SPOT TRADES"
                        else
                                NULL
        end,
        create_bb_fwd = "CREATE FORWARD TRADES",
        create_bb_swap = "CREATE SWAP TRADES"
from
        current_prices a,
        contracts b,
        #symbols c
where
        a.contract_id =* b.contract_id
and
        b.symbol = c.symbol
order by
        c.type,
        b.symbol


select
        section = "Internal Spot Fwd",
        style = @style,
        b.symbol,
        c.type,
        price = case
                when
                        b.symbol != "JPYUSD" then convert(numeric(30,6), a.price)
                else
                        convert(numeric(30,6), @usdjpy_price)
        end,
        create_internal_spotfwd = "CREATE INTERNAL SPOT FORWARD TRADES"
from
        current_prices a,
        contracts b,
        #symbols c
where
        a.contract_id =* b.contract_id
and
        b.symbol = c.symbol
order by
        c.type,
        b.symbol


	
	


go
