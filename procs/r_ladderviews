drop procedure
	r_ladderviews
go

create procedure
        r_ladderviews
                @login char(100)
as

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)


insert into
        #links
values(
        "Column Link",
        "run_name",
        "Run Ladder Views",
        NULL,
        NULL)


insert into
        #links
values(
        "Column Hidden",
        "include_starting_positions",
        NULL,
        NULL,
        NULL)


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
        run_name = a.name,
	include_starting_positions = "YES"
from
        runs a,
        user_runs b,
        tico_accounts c
where
        a.run_id = b.run_id
and
        b.tico_account_id = c.account_id
and
        c.login = @login
order by
        a.name

go
