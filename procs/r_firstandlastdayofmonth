create or replace procedure
	r_firstandlastdayofmonth
                @month varchar(20),
                @year varchar(10),
		@first_of_month datetime=NULL output,
		@last_of_month datetime=NULL output,
		@first_biz_day datetime=NULL output,
		@last_biz_day datetime=NULL output

as

declare @date datetime
declare @report_month varchar(2)
declare @report_year varchar(4)

declare @first_of_next_month datetime
declare @last_of_prev_month datetime
declare @last_biz_last_month datetime

select
	@date = convert(datetime, rtrim(@month) + " 1, " + rtrim(@year))
select
	@report_month = convert(varchar(2), datepart(month, @date)),
	@report_year = convert(varchar(4), datepart(year, @date))

select
	@first_of_month = convert(datetime, @report_month + "/1/" + @report_year)

exec
	r_prevbusinessday
		@first_of_month,
		@last_biz_last_month output
select
	@first_of_next_month = dateadd(month, 1, @first_of_month)

select
	@last_of_prev_month = dateadd(day, -1, @first_of_month),
	@last_of_month = dateadd(day, -1, @first_of_next_month)

exec
	r_nextbusinessday
		@last_of_prev_month,
		@first_biz_day output
exec
	r_prevbusinessday
		@first_of_next_month,
		@last_biz_day output

go

