drop procedure
	api_pipsreadfeerecon
go

create procedure
	api_pipsreadfeerecon
		@login varchar(50),
		@trade_date datetime=NULL,
		@tally_fees varchar(10)=NULL,
		@display_output varchar(10)=NULL
as


declare @fund_id int
declare @evaluation_currency_id int
declare @tico_account_id int

declare @id int
declare @ids int
declare @fee_schedule_id int
declare @fee_schedule varchar(100)
declare @debit_account varchar(50)
declare @scheduled_fee_id int
declare @currency varchar(50)

declare @begin_date datetime
declare @end_date datetime

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)


declare @transaction_type_id int
declare @transaction_type varchar(50)

declare @transaction_date datetime
declare @amount float
declare @trade_id int

declare @credit_account varchar(50)
declare @credit_ext_account_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"run_name", 
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"book_fees",
	"Book Queued Fees",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "rate",
	 "Number",
	"#,##0.000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	 #meta
values(
	 "Column Format",
	 "fee",
	 "Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	 #meta
values(
	 "Column Format",
	 "amount",
	 "Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


if lower(@display_output) = "yes"
	select
		*
	from
		#meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@subtotal_style = "background:#FFFFFF;border: 1px solid white;font-style:italic;font-color:grey",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

if lower(@display_output) != "yes"
	select
		@display_output = "No"

if lower(@tally_fees) != "yes"
	select
		@tally_fees = "No"

select
	@transaction_date = convert(datetime, convert(date, @trade_date))
exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @trade_date = NULL
	select
		@trade_date = getdate()

select
	@trade_date = convert(datetime, convert(date, @trade_date))

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


create table
	#ids(
		id int identity,
		style varchar(250) NULL,
		fee_schedule_id int,
		external_account_id int NULL,
		debit_transaction_id int NULL,
		trade_account_id int NULL,
		pip_spread_id int NULL,
		transaction_type_id int NULL,
		trade_id int,
		trade_type_id int NULL,
		trade_type varchar(50) NULL,
		trader_id int,
		contract_id int NULL,
		dealt_amount float NULL,
		counter_amount float NULL,
		price_style varchar(50) NULL,
		product_id int NULL,
		currency_id int NULL,
		fee_amount float NULL,
		rate float NULL,
		fee numeric(30,10) NULL,
		credit_ext_account_id int NULL,
		credit_transaction_id int NULL)

create table
	#fee_schedules(
		id int identity,
		style varchar(250) NULL,
		fee_schedule_id int NULL,
		name varchar(100) NULL,
		debit_acct_id int NULL,
		debit_from varchar(50) NULL,
		credit_acct_id int NULL,
		credit_to varchar(50) NULL,
		description varchar(100) NULL,
		schedule varchar(50) NULL,
		rate float NULL,
		currency varchar(50) NULL,
		fee_amount float NULL,
		activity_date datetime NULL,
		tickets int NULL,
		fee float NULL,
		prime_broker_id int NULL,
		recon_account varchar(50) NULL)

insert into
	#fee_schedules(
		style,
		fee_schedule_id,
		name,
		debit_acct_id,
		description,
		schedule,
		activity_date)
select
	style = @style,
	a.fee_schedule_id,
	a.name,
	a.book_to_ext_account_id,
	a.description,
	schedule = b.name,
	activity_date = @trade_date	
from
	fee_schedules a,
	fee_schedule_types b,
	products c
where
	a.fee_schedule_type_id = b.fee_schedule_type_id
and
	a.fee_product_id = c.product_id
and
	b.name = "Pip Spread"
order by
	a.name


update
	#fee_schedules
set
	a.prime_broker_id = b.prime_broker_id
from
	#fee_schedules a,
	external_account_prime_brokers b
where
	a.debit_acct_id = b.external_account_id

update
	#fee_schedules
set
	a.recon_account = c.symbol
from
	#fee_schedules a,
	prime_brokers b,
	external_accounts c
where
	a.prime_broker_id = b.prime_broker_id
and
	b.bo_external_account_id = c.external_account_id

update
	#fee_schedules
set
	a.debit_from = b.symbol
from
	#fee_schedules a,
	external_accounts b
where
	a.debit_acct_id = b.external_account_id

update
	#fee_schedules
set
	credit_to = recon_account
where
	debit_from != recon_account

create table
	#traders(
		trader_id int)
create table
	#strategies(
		strategy_id int)
create table
	#external_accounts(
		external_account_id int)
create table
	#internal_accounts(
		internal_account_id int)
create table
	#brokers(
		broker_id int)
create table
	#counterparties(
		counterparty_id int)
create table
	#trade_types(
		trade_type_id int)

select
	@id = 0
select
	@ids = count(*)
from
	#fee_schedules
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#fee_schedules
	where
		id > @id

	truncate table
		#traders
	truncate table
		#strategies
	truncate table
		#external_accounts
	truncate table
		#internal_accounts
	truncate table
		#brokers
	truncate table
		#counterparties
	truncate table
		#trade_types
	
	select
		@fee_schedule_id = fee_schedule_id
	from
		#fee_schedules
	where
		id = @id

	insert into
		#traders(
			trader_id)
	select
		trader_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		trader_id != NULL
	if @@rowcount = 0
		insert into
			#traders(
				trader_id)
		select
			trader_id
		from
			traders

	insert into
		#strategies(
			strategy_id)
	select
		strategy_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		strategy_id != NULL
	if @@rowcount = 0
		insert into
			#strategies(
				strategy_id)
		select
			strategy_id
		from
			strategies

	insert into
		#external_accounts(
			external_account_id)
	select
		external_account_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		external_account_id != NULL
	if @@rowcount = 0
		insert into 
			#external_accounts(
				external_account_id)
		select
			external_account_id
		from
			external_accounts

	insert into
		#internal_accounts(
			internal_account_id)
	select
		internal_account_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		internal_account_id != NULL
	if @@rowcount = 0
		insert into
			#internal_accounts(
				internal_account_id)
		select
			internal_account_id
		from
			internal_accounts

	insert into
		#brokers(
			broker_id)
	select
		broker_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		broker_id != NULL
	if @@rowcount = 0
		insert into
			#brokers(
				broker_id)
		select
			broker_id
		from
			brokers

	insert into
		#counterparties(
			counterparty_id)
	select
		counterparty_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		counterparty_id != NULL
	if @@rowcount = 0
		insert into
			#counterparties(
				counterparty_id)
		select
			counterparty_id
		from
			counterparties

	insert into
		#trade_types(
			trade_type_id)
	select
		trade_type_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		trade_type_id != NULL
	if @@rowcount = 0
		insert into
			#trade_types(
				trade_type_id)
		select
			trade_type_id
		from
			trade_types

	insert into
		#ids(
			fee_schedule_id,
			trade_id,
			trade_type_id,
			trader_id,
			trade_account_id,
			contract_id,
			dealt_amount,
			counter_amount)
	select
		fee_schedule_id = @fee_schedule_id,
		b.trade_id,
		b.trade_type_id,
		b.trader_id,
		b.external_account_id,
		b.contract_id,
		b.quantity,
		b.quantity * b.price * -1.0
	from
		trades b,
		#traders d,
		#strategies e,
		#external_accounts f,
		#internal_accounts g,
		#brokers h,
		#counterparties i,
		#trade_types j
	where
		b.trader_id = d.trader_id
	and
		b.strategy_id = e.strategy_id
	and
		b.external_account_id = f.external_account_id
	and
		b.internal_account_id = g.internal_account_id
	and
		b.broker_id = h.broker_id
	and
		b.counterparty_id = i.counterparty_id
	and
		b.trade_type_id = j.trade_type_id
	and
		b.trade_date >= @begin_date
	and
		b.trade_date < @end_date
		

	update
		#ids
	set
		a.currency_id = b.currency_id,
		a.product_id = b.product_id
	from
		#ids a,
		forwards b
	where
		a.contract_id = b.contract_id

	update
		#ids
	set
		a.trade_type = b.name
	from
		#ids a,
		trade_types b
	where
		a.trade_type_id = b.trade_type_id

	select
		@ids = count(*)
	from
		#fee_schedules
	where
		id > @id
end


update
	#ids
set
	a.external_account_id = b.book_to_ext_account_id,
	a.credit_ext_account_id = b.credit_ext_account_id,
	a.transaction_type_id = b.fee_type_id
from
	#ids a,
	fee_schedules b
where
	a.fee_schedule_id = b.fee_schedule_id

update
	#ids
set
	a.pip_spread_id = b.pip_spread_id
from
	#ids a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#ids
set
	a.price_style = c.name
from
	#ids a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id


/* MARKR */
update
	#ids
set
	rate = 0.0

update
	#ids
set
	a.rate = b.pip_spread
from
	#ids a,
	pip_spread_contracts b
where
	a.pip_spread_id = b.pip_spread_id
and
	a.contract_id = b.contract_id

update
	#ids
set
	a.rate = a.rate + b.pip_spread
from
	#ids a,
	pip_spread_overrides b
where
	a.trade_account_id = b.external_account_id
and
	a.contract_id = b.contract_id

update
	#ids
set
	a.rate = a.rate + b.pip_spread
from
	#ids a,
	trader_spread_overrides b
where
	a.trader_id = b.trader_id
and
	a.contract_id = b.contract_id

update
	#ids
set
	fee_amount = abs(dealt_amount)

/* MARKR removed in favor of allowing non standard pairs in schedules update
	#ids
set
	fee_amount = abs(counter_amount),
	currency_id = product_id
where
	price_style = "Inverted" */

update
	#ids
set
	fee = fee_amount * rate


update
	#ids
set
	style = @style

update
	#ids
set
	a.debit_transaction_id = b.account_transaction_id
from
	#ids a,
	account_transactions b
where
	a.external_account_id = b.external_account_id
and
	b.note = convert(varchar(50), a.trade_id)
and
	b.amount < 0.0


update
	#ids
set
	a.credit_transaction_id = b.account_transaction_id
from
	#ids a,
	account_transactions b
where
	a.credit_ext_account_id = b.external_account_id
and
	b.note = convert(varchar(50), a.trade_id)
and
	b.amount > 0.0 


update
	#ids
set
	style = @error_style
where
	debit_transaction_id = NULL
or
	credit_transaction_id = NULL

select
	@id = 0
select
	@ids = count(*)
from
	#ids
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ids
	where
		id > @id


	select
		@trade_id = NULL,
		@amount = NULL,
		@fee_schedule = NULL,
		@debit_account = NULL,
		@credit_account = NULL,
		@currency = NULL,
		@scheduled_fee_id = NULL

	select
		@fee_schedule = b.name,
		@debit_account = c.symbol,
		@currency = d.symbol,
		@amount = a.fee,
		@credit_account = e.symbol,
		@trade_id = a.trade_id
	from
		#ids a,
		fee_schedules b,
		external_accounts c,
		products d,
		external_accounts e
	where
		a.fee_schedule_id = b.fee_schedule_id
	and
		a.external_account_id = c.external_account_id
	and
		a.currency_id = d.product_id
	and
		a.credit_ext_account_id = e.external_account_id
	and
		a.id = @id


	if lower(@tally_fees) = "yes" and abs(@amount) > 0.01
	begin
		exec
			ag_tallyfeeschedfee
				@login = @login,
				@fee_schedule = @fee_schedule,
				@transaction_date = @transaction_date,
				@debit_account = @debit_account,
				@credit_account = @credit_account,
				@amount = @amount,
				@currency = @currency,
				@trade_id = @trade_id,
				@scheduled_fee_id = @scheduled_fee_id output
	end
	
			

	select
		@ids = count(*)
	from
		#ids
	where
		id > @id
end



if lower(@display_output) = "yes"
begin
	select
		a.style,
		fee_schedule = b.name,
		a.trade_id,
		a.trade_type,
		account = c.symbol,
		a.debit_transaction_id,
		credit_to = h.symbol,
		a.credit_transaction_id,
		pip_spread = d.name,
		transaction_type = e.name,
		quantity = a.dealt_amount,
		contract = f.symbol,
		a.rate,
		a.fee,
		currency = g.symbol
	from
		#ids a,
		fee_schedules b,
		external_accounts c,
		pip_spreads d,
		transaction_types e,
		contracts f,
		products g,
		external_accounts h
	where
		a.fee_schedule_id = b.fee_schedule_id
	and
		a.credit_ext_account_id = h.external_account_id
	and
		a.external_account_id = c.external_account_id
	and
		a.pip_spread_id = d.pip_spread_id
	and
		a.transaction_type_id = e.transaction_type_id
	and
		a.contract_id = f.contract_id
	and
		a.currency_id = g.product_id
	order by
		a.id
end




go
