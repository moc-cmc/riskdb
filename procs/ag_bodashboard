drop procedure
	ag_bodashboard
go

create procedure
	ag_bodashboard
		@login varchar(50) ,
                @begin_date datetime=NULL,
                @end_date datetime=NULL



as

declare @fund_sub_type varchar(50)

select
	@fund_sub_type = name
from
	fund_sub_types
if @@rowcount != 1
begin
	/* Default to Agency */
	select
		@fund_sub_type = 'FX Agency'
end

if @fund_sub_type = "Prime of Prime"
begin
	exec
		ag_accountspop
			@login=@login,
                	@begin_date=NULL,
                	@end_date=NULL

end
else
begin
	/* FX Agency */
	exec 
		ag_accountsagency
			@login,
                	@begin_date=NULL,
                	@end_date=NULL
end

go
