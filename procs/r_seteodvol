use
	risk_elad2
go

drop procedure
	r_seteodvol
go

create procedure
	r_seteodvol
		@login varchar(50),
		@symbol varchar(50),
		@tv_date datetime,
		@vol float
as

declare @contract_tv_id int
declare @contract_id int
declare @underlying_contract_id int
declare @underlying float
declare @strike float
declare @expiration datetime
declare @days float
declare @interest_rate float
declare @carry_cost float
declare @product_rate float
declare @put_call char(5)
declare @exercise_style char(20)
declare @tv float
declare @spot_price float
declare @delta float
declare @gamma float
declare @theta float
declare @tau float
declare @rho float

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end


select
	@underlying_contract_id = a.underlying_contract_id,
	@strike = c.strike,
	@expiration = b.expiration,
	@put_call = c.put_call
from
	options a,
	option_expirations b,
	option_contracts c
where
	a.option_id = b.option_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.contract_id = @contract_id
if @underlying_contract_id = NULL
begin
	select
		status = "Error",
		message = "Underlying contract not found for contract",
		symbol = @symbol
end
		
select
	@tv_date = dateadd(hour, 17, convert(datetime, convert(date, @tv_date)))

exec
	r_forwardpriceasof
		@underlying_contract_id,
		@tv_date,
		@expiration,
		@days output,
		@spot_price output,
		@underlying output,
		@interest_rate output,
		@product_rate output


exec
	r_optionmodel
		@login = @login,
		@underlying = @underlying,
		@strike = @strike,
		@vol = @vol,
		@days_to_exp = @days,
		@interest_rate = @interest_rate,
		@carry_cost = 0.0,
		@put_call = @put_call,
		@exercise_style = "European",
		@tv = @tv output,
		@delta = @delta output,
		@gamma = @gamma output,
		@theta = @theta output,
		@tau = @tau output,
		@rho = @rho output



update
	contract_tvs
set
	tv = @tv,
	delta = @delta,
	gamma = @gamma,
	theta = @theta,
	tau = @tau,
	underlying_price = @underlying,
	volatility = @vol,
	days = @days,
	interest_rate = @interest_rate,
	carry_cost = 0.0
where
	contract_id = @contract_id
and
	convert(date, tv_date) = convert(date, @tv_date)
if @@rowcount != 1
begin
	exec
		j_nextkey
			"contract_tvs",
			@contract_tv_id output


	insert into
		contract_tvs(
			contract_tv_id,
			contract_id,
			tv,
			delta,
			gamma,
			theta,
			tau,
			underlying_price,
			volatility,
			days,
			interest_rate,
			carry_cost,
			tv_date)
	values(
		@contract_tv_id,
		@contract_id,
		@tv,
		@delta,
		@gamma,
		@theta,
		@tau,
		@underlying,
		@vol,
		@days,
		@interest_rate,
		0.0,
		@tv_date)
end



go




