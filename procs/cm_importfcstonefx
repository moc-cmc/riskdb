
if object_id("cm_importfcstonefx") != NULL
    drop procedure
        cm_importfcstonefx
go

create procedure
	cm_importfcstonefx
		@login varchar(50),
		@trade_symbol varchar(30),
		@trade_date datetime,
		@buy_sell varchar(10),
		@amount numeric(30,4),
		@symbol varchar(50),
		@price float,
		@account varchar(50),
		@broker varchar(20)
as

declare @source_id int
declare @deal_id int
declare @trade_id int
declare @quantity numeric(30,4)
declare @external_account_id int
declare @fund_id int
declare @tico_account_id int
declare @fund varchar(50)
declare @internal_account_id int
declare @contract_id int
declare @broker_id int
declare @value_date datetime
declare @tdate datetime
declare @trader_id int
declare @strategy_id int
declare @status_id int
declare @trade_symbol_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@fund = name
from
	funds
where
	fund_id = @fund_id

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @fund
if @internal_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve internal account"
	return
end
	
select
	@source_id = source_id
from
	sources
where
	name = "FC Stone"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "FC Stone source not found"
	return
end


select
	@deal_id = deal_id
from
	trade_symbols
where
	source_id = @source_id
and
	symbol = @trade_symbol
if @deal_id != NULL
begin
	select
		status = "Dupe",
		message = "Trade is already booked",
		trade_symbol = @trade_symbol
	return
end

select
	@quantity = @amount

if convert(char(1), lower(@buy_sell)) = "s"
	select
		@quantity = @quantity * -1.0

select
	@external_account_id = external_account_id
from
	external_account_symbols
where
	source_id = @source_id
and
	symbol = @account
if @external_account_id = NULL
begin
	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @account
	if @external_account_id = NULL
	begin
		select
			status = "Error",
			message = "Unable to resolve account",
			account = @account
		return
	end
end

select
	@contract_id = contract_id
from
	contract_symbols
where
	source_id = @source_id
and
	symbol = @symbol
if @contract_id = NULL
begin
	select
		@contract_id = contract_id
	from
		contracts
	where
		upper(symbol) = upper(@symbol)
	if @contract_id = NULL
	begin
		select
			status = "Error",
			message = "Unable to resolve contract",
			symbol = @symbol
		return
	end
end


select
	@broker_id = broker_id
from
	broker_symbols
where
	source_id = @source_id
and
	symbol = @symbol
if @broker_id = NULL
begin
	select
		@broker_id = broker_id
	from
		brokers
	where
		upper(symbol) = upper(@broker)
	if @broker_id = NULL
	begin
		select
			status = "Error",
			message = "Unable to resolve broker",
			broker = @broker
		return
	end
end


select
	@trader_id = min(trader_id)
from
	traders
if @trader_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve a trader for import"
	return
end

select
	@strategy_id = strategy_id
from
	strategies
where
	name = "Report Import"
if @strategy_id = NULL
begin
	exec
		j_nextkey
			"strategies",
			@strategy_id output
	insert into
		strategies
	values(
		@strategy_id,
		"Report Import")
end

select
	@status_id = status_id
from
	statuses
where
	name = "Active"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"statuses",
			@status_id output
	insert into
		statuses
	values(
		@status_id,
		"Active")
end

select
	@tdate = convert(datetime, convert(char(11), @trade_date, 1))

exec
	r_nextbusinessday
		@tdate,
		@value_date output

if upper(@symbol) not in("USDCAD", "CADUSD")
	exec
		r_nextbusinessday
			@value_date,
			@value_date output


exec
	j_nextkey
		"deals",
		@deal_id output

exec
	j_nextkey
		"trades",
		@trade_id output

exec
	j_nextkey
		"trade_symbols",
		@trade_symbol_id output

insert into
	trades
values(
	@trade_id,
	@deal_id,
	@tico_account_id,
	@internal_account_id,
	@external_account_id,
	@quantity,
	@contract_id,
	@price,
	@trade_date,
	@trader_id,
	@strategy_id,
	@status_id,
	@broker_id)

insert into
	trade_value_dates
values(
	@trade_id,
	@value_date)

insert into
	trade_symbols
values(
	@trade_symbol_id,
	@source_id,
	@deal_id,
	@trade_symbol,
	getdate())

	


go
