drop procedure r_updatetradenotificationbyid
go

create procedure 
	r_updatetradenotificationbyid
		@identifier varchar(100),
		@status varchar(100)

as

declare @trade_id int

select
	@trade_id = trade_id
from
	trades
where
	identifier = @identifier
if @@rowcount != 1
begin
	select
		error = "Error",
		msg = "Problem querying only one row for identifier",
		identifier = @identifier
	return
end

exec
	r_updatetradenotification
		@trade_id,
		@status

select
    status = "Success",
    trade_id = @trade_id


go

