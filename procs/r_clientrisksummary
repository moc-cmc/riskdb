select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50),
		margin_multiplier float NULL)

insert into
	#external_accounts
select
	a.external_account_id,
	a.symbol,
	a.margin_multiplier
from
	external_accounts a,
	fund_external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	a.external_account_type_id = c.external_account_type_id
and
	c.name in ("Client")
and
	a.symbol not in ("INTERNAL", "FC FTPROA3900")
/* and
	a.symbol = "FC ZTEST"*/


create table
	#trades(
		trade_id int,
		external_account_id int,
		prime_broker_id int NULL,
		margin_multiplier float NULL,
		quantity float,
		contract_id int,
		product_id int,
		product_qty float,
		currency_id int,
		currency_qty float,
		price float,
		value_date datetime,
		status_id int,
		margin float NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		margin_multiplier,
		quantity,
		contract_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		price,
		value_date,
		status_id,
		margin)
select
	a.trade_id,
	a.external_account_id,
	c.margin_multiplier,
	a.quantity,
	a.contract_id,
	b.product_id,
	a.quantity,
	b.currency_id,
	a.quantity * price * -1.0,
	a.price,
	a.value_date,
	a.status_id,
	margin = 0.0
from
	trades a,
	forwards b,
	#external_accounts c
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	a.value_date > @begin_date
and
	a.trade_date < @end_date
and
	/* chriso: added since these accounts shouldnt have margin or open equity*/
	c.symbol not in("FC EDGEBOA", "FC INTERNAL")

update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
        b.margin > a.margin

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.currency_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
        b.margin > a.margin

update
	#trades
set
	a.quantity = a.quantity * -1.0,
	a.product_qty = a.product_qty * -1.0,
	a.currency_qty = a.currency_qty * -1.0
from
	#trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"

/* MARK: FIND #products from #trades, external_accounts for #conversion_rates */
create table
  #products(
    product_id int)

insert into
  #products
select distinct
  product_id
from
  #trades

insert into
  #products
select distinct
  currency_id
from
  #trades

insert into
  #products
select distinct
  b.evaluation_currency_id
from
  #external_accounts a,
  external_accounts b
where
  a.external_account_id = b.external_account_id

/* MARK: FIND #conversion_rates from #products */
create table
  #conversion_rates(
    product_id int,
    rate float NULL)
insert into
  #conversion_rates (
    product_id)
select distinct
  product_id
from
  #products

update
  #conversion_rates
set
  rate = 1.0
where
  product_id = @evaluation_currency_id

update
  #conversion_rates
set
  rate = c.price
from
  #conversion_rates a,
  forwards b,
  prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	/* chriso: trade date should not be used after we run r_daterangefordate.
                   Only beign_date or end_date */
	/*convert(date, c.price_date) = convert(date, @trade_date)*/
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
  #conversion_rates
set
  rate = 1.0 / c.price
from
  #conversion_rates a,
  forwards b,
  prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	/* chriso: trade date should not be used after we run r_daterangefordate.
                   Only beign_date or end_date */
	/*convert(date, c.price_date) = convert(date, @trade_date)*/
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
  #conversion_rates
set
  rate = c.price
from
  #conversion_rates a,
  forwards b,
  current_prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
  #conversion_rates
set
  rate = 1.0 / c.price
from
  #conversion_rates a,
  forwards b,
  current_prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

create table
	#settlements(
		external_account_id int,
		product_id int,
		quantity float)
insert into
	#settlements
select
	external_account_id,
	product_id,
	product_qty
from
	#trades
where
	value_date < @end_date

insert into
	#settlements
select
	external_account_id,
	currency_id,
	currency_qty
from
	#trades
where
	value_date < @end_date

create table
	#settling_balances(
		external_account_id int,
		product_id int,
		quantity float,
		equiv float NULL,
		currency_id int NULL,
		conversion_rate float NULL)
insert into
	#settling_balances(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	product_id,
	sum(quantity)
from
	#settlements
group by
	external_account_id,
	product_id

delete

from
	#settling_balances
where
	quantity = 0.0

update
	#settling_balances
set
	currency_id = @evaluation_currency_id


create table
	#product_positions(
		external_account_id int,
		product_id int,
		margin float NULL,
		quantity float)
insert into
	#product_positions
select
	external_account_id,
	product_id,
	margin,	
	sum(product_qty)
from
	#trades
group by
	external_account_id,
	product_id,
	margin

insert into
	#product_positions
select
	external_account_id,
	currency_id,
	margin,
	sum(currency_qty)
from
	#trades
group by
	external_account_id,
	currency_id,
	margin


/************************************************************/
create table
	#margin_balances(
		external_account_id int,
		product_id int,
		quantity float,
		margin float NULL,
		currency_id int NULL,
		equiv float NULL,
		usage float NULL)
insert into
	#margin_balances(
		external_account_id,
		product_id,
		margin,
		quantity)
select
	external_account_id,
	product_id,
	margin,
	sum(quantity)
from
	#product_positions
group by
	external_account_id,
	product_id,
	margin

update
	#margin_balances
set
	currency_id = @evaluation_currency_id

update
  #margin_balances
set
  equiv = a.quantity * b.rate
from
  #margin_balances a,
  #conversion_rates b
where
  a.product_id = b.product_id
and
  a.currency_id = @evaluation_currency_id

update
	#margin_balances
set
	equiv = 0
where
	equiv >= 0.0

update
	#margin_balances
set
	usage = abs(equiv) * margin

create table
	#account_usage(
		external_account_id int,
		nop_short float,
		usage float NULL)
insert into
	#account_usage
select
	external_account_id,
	sum(equiv),
	sum(usage)
from
	#margin_balances
group by
	external_account_id


/************************************************************/



create table
	#account_products(
		external_account_id int,
		product_id int,
		quantity float)
insert into
	#account_products
select
	external_account_id,
	product_id,
	product_qty
from
	#trades
where
  value_date > @end_date

insert into
	#account_products
select
	external_account_id,
	currency_id,
	currency_qty
from
	#trades
where
  value_date > @end_date

select
	@fx_settlement_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end

create table
	#account_balances(
		external_account_id int,
		product_id int,
		amount float)

create table
	#cash_balances(
		external_account_id int,
		product_id int,
		amount float)
insert into
	#cash_balances
select
	external_account_id,
	currency_id,
	sum(amount)
from
	account_transactions
where
        /* chriso: trade date should not be used after we run r_daterangefordate.
                   Only beign_date or end_date */
	/*convert(date, transaction_date) < convert(date, @trade_date)*/
	convert(date, transaction_date) < convert(date, @end_date)
and
	transaction_type_id = @fx_settlement_type_id
group by
	external_account_id,
	currency_id
	
insert into
	#cash_balances
select
	external_account_id,
	currency_id,
	sum(amount)
from
	account_transactions
where
	transaction_type_id != @fx_settlement_type_id
and
	transaction_date <= @end_date
group by
	external_account_id,
	currency_id

insert into
	#account_balances
select
	external_account_id,
	product_id,
	sum(amount)
from
	#cash_balances
group by
	external_account_id,
	product_id


create table
	#all_products(
		product_id int)
insert into
	#all_products
select
	distinct(product_id)
from
	#account_products

insert into
	#all_products
select
	distinct(product_id)
from
	#account_balances
where
	product_id not in(
		select
			product_id
		from
			#all_products)

insert into
        #all_products
select
        distinct(product_id)
from
        #settling_balances
where
        product_id not in(
                select
                        product_id
                from
                        #all_products)

create table
	#balances(
		external_account_id int,
		product_id int,
		quantity float,
		currency_id int NULL,
		conversion_rate float NULL,
		equivalent float NULL,
		ote float NULL,
		ote_equiv float NULL,
		margin float NULL,
		account_balance float NULL,
		account_balance_equiv float NULL)

insert into
	#balances(
		external_account_id,
		product_id,
		quantity,
		ote,
		account_balance)
select
	a.external_account_id,
	b.product_id,
	quantity = 0.0,
	ote = 0.0,
	account_balance = 0.0
from
	#external_accounts a,
	#all_products b


create table
	#pos_balances(
		external_account_id int,
		product_id int,
		quantity float)

insert into
	#pos_balances(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	product_id,
	sum(quantity)
from
	#account_products
group by
	external_account_id,
	product_id

update
	#balances
set
	a.quantity = a.quantity + b.quantity
from
	#balances a,
	#pos_balances b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id

update
	#balances
set
	a.account_balance = a.account_balance + b.amount
from
	#balances a,
	#account_balances b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id


update
	#balances
set
	currency_id = @evaluation_currency_id,
  conversion_rate = b.rate
from
  #balances a,
  #conversion_rates b
where
  a.product_id = b.product_id

update
	#balances
set
	ote = quantity

update
	#balances
set
	equivalent = abs(quantity) * conversion_rate,
	ote_equiv = ote * conversion_rate,
	account_balance_equiv = account_balance * conversion_rate

update
        #settling_balances
set
        a.conversion_rate = b.conversion_rate
from
        #settling_balances a,
        #balances b
where
        a.product_id = b.product_id
and
        a.currency_id = b.currency_id

update
        #settling_balances
set
        equiv = quantity * conversion_rate


create table
        #account_settlements(
                external_account_id int,
                equiv float NULL)
insert into
        #account_settlements
select
        external_account_id,
        sum(equiv)
from
        #settling_balances
group by
        external_account_id


create table
	#balance_nets(
		external_account_id int,
		cash_equiv float NULL,
		open_trade_equity float NULL)
insert into
	#balance_nets(
		external_account_id,
		cash_equiv,
		open_trade_equity)
select
	external_account_id,
	sum(account_balance_equiv),
	sum(ote_equiv)
from
	#balances
group by
	external_account_id


create table
	#output(
		style varchar(200) NULL,
		external_account_id int,
		external_account_type_id int,
		cash_equiv float NULL,
		settlements float NULL,
		open_trade_equity float NULL,
		total_equity float NULL,
		nop_equiv float NULL,
		margin_use float NULL,
		excess float NULL,
                pct_use float NULL,
		status varchar(50) NULL)
insert into
	#output(
		style,
		external_account_id,
		external_account_type_id,
		cash_equiv,
		settlements,
		open_trade_equity,
		total_equity,
		nop_equiv,
		margin_use,
		status)
select
	style = "background:#FFFFFF;border: 1px solid white",
	a.external_account_id,
	a.external_account_type_id,
	cash_equiv = 0.0,
	settlements = 0.0,
	open_trade_equity = 0.0,
	total_equity = 0.0,
	nop_equiv = 0.0,
	margin_use = 0.0,
	status = "Excess"
from
	external_accounts a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	a.cash_equiv = b.cash_equiv,
	a.open_trade_equity = b.open_trade_equity
from
	#output a,
	#balance_nets b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	a.settlements = b.equiv
from
	#output a,
	#account_settlements b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	total_equity = cash_equiv + settlements + open_trade_equity

update
	#output
set
	a.nop_equiv = b.nop_short,
	a.margin_use = b.usage
from
	#output a,
	#account_usage b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	excess = total_equity - margin_use

update
	#output
set
	pct_use = margin_use / total_equity
where
	total_equity != 0.0


update
	#output
set
	status = "Deficit",
	style = "background:#E1F2EB;color:#FF0000;border: 1px solid white"
where
	excess < 0.0

select
	section = "Margin Usage",
	a.style,
	account = b.symbol,
	/* type = c.name, */
	cash = a.cash_equiv / e.rate,
	settlements = a.settlements / e.rate,
	open_eqty = a.open_trade_equity / e.rate,
	total_equity = a.total_equity / e.rate,
	nop_short = a.nop_equiv / e.rate,
	margin_use = a.margin_use / e.rate,
        a.pct_use,
	excess = a.excess / e.rate,
	a.status,
        currency = d.symbol,
	trade_date = convert(datetime, convert(date, @end_date))
from
	#output a,
	external_accounts b,
	external_account_types c,
  products d,
  #conversion_rates e
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
  b.evaluation_currency_id = d.product_id
and
  b.evaluation_currency_id = e.product_id
order by
	b.symbol

select
  section = "Margin Use By Bucket",
  account = b.symbol,
  margin = a.margin,
  nop_short = sum(a.equiv) / d.rate,
  margin_use = sum(a.usage) / d.rate,
  currency = c.symbol
from
  #margin_balances a,
  external_accounts b,
  products c,
  #conversion_rates d
where
  a.external_account_id = b.external_account_id
and
  b.evaluation_currency_id = c.product_id
and
  b.evaluation_currency_id = d.product_id
group by
  b.symbol,
  a.margin,
  c.symbol,
  d.rate
order by
  b.symbol,
  margin_use desc

select
  section = "Account Balances",
  account = b.symbol,
  product = c.symbol,
  position = a.quantity,
  nop_short = a.equiv / e.rate,
  margin_use = a.usage / e.rate,
  margin = a.margin,
  currency = d.symbol
from
  #margin_balances a,
  external_accounts b,
  products c,
  products d,
  #conversion_rates e
where
  a.external_account_id = b.external_account_id
and
  a.product_id = c.product_id
and
  b.evaluation_currency_id = d.product_id
and
  b.evaluation_currency_id = e.product_id
order by
  b.symbol,
  a.margin,
  c.symbol

go
