
if object_id("cm_editcounterpartymapping") != NULL
    drop procedure
        cm_editcounterpartymapping
go

create procedure
	cm_editcounterpartymapping
		@login varchar(50),
		@counterparty varchar(50),
		@source varchar(50),
		@mapping varchar(50),
		@new_mapping varchar(50)
as


declare @counterparty_id int
declare @source_id int

select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Broker not found",
		counterparty = @counterparty
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

update
	counterparty_symbols
set
	symbol = @new_mapping
where
	counterparty_id = @counterparty_id
and
	source_id = @source_id
and
	symbol = @mapping

exec
	cm_counterpartymappings
		@login,
		@counterparty

go
