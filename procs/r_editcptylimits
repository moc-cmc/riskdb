drop procedure
	r_editcptylimits
go

create procedure
	r_editcptylimits
		@login varchar(50),
		@counterparty varchar(50),
		@currency varchar(50),
		@nop_type varchar(50),
		@nop_limit numeric(30,4),
		@dsl_type varchar(50),
		@dsl_limit numeric(30,4),
		@notice_level float,
		@warning_level float,
		@blocked_level float
as


declare @product_id int
declare @tico_account_id int
declare @counterparty_id int
declare @nop_type_id int
declare @dsl_type_id int

select
	@product_id = product_id
from
	products
where
	symbol = @currency
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Currency not found",
		currency = @currency
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Login not found"
	return
end

select
	@nop_type_id = nop_type_id
from
	nop_types
where
	name = @nop_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "NOP type not found",
		nop_type = @nop_type
	return
end

select
	@dsl_type_id = dsl_type_id
from
	dsl_types
where
	name = @dsl_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "DSL type not found",
		dsl_type = @dsl_type
	return
end


select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Counterparty not found",
		counterparty= @counterparty
	return
end


begin  tran
	insert into
		counterparty_limit_edits(
			counterparty_limit_id,
			counterparty_id,
			currency_id,
			nop_type_id,
			nop_limit,
			dsl_type_id,
			dsl_limit,
			notice_level,
			warning_level,
			blocked_level,
			archive_date,
			tico_account_id)
	select
		counterparty_limit_id,
		counterparty_id,
		currency_id,
		nop_type_id,
		nop_limit,
		dsl_type_id,
		dsl_limit,
		notice_level,
		warning_level,
		blocked_level,
		archive_date = getdate(),
		tico_account_id = @tico_account_id
	from
		counterparty_limits
	where
		counterparty_id = @counterparty_id
	if @@rowcount != 1
	begin
		select
			status = "Edit Failed",
			message = "Limits unchanged. Unable to archive limit settings",
			counterparty = @counterparty
		rollback tran
		return
	end

	update
		counterparty_limits
	set
		currency_id = @product_id,
		nop_type_id = @nop_type_id,
		nop_limit = @nop_limit,
		dsl_type_id = @dsl_type_id,
		dsl_limit = @dsl_limit,
		notice_level = @notice_level,
		warning_level = @warning_level,
		blocked_level = @blocked_level
	where
		counterparty_id = @counterparty_id
	if @@rowcount != 1
	begin
		select
			status = "Edit Failed",
			message = "Limits unchanged. Unable to isolate limit for counterparty",
			counterparty = @counterparty
		rollback tran
		return
	end

commit tran


exec
	r_cptyfxmccreditview
		@login,
		@counterparty


go	

