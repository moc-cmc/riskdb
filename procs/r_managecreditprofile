drop procedure
	r_managecreditprofile
go

create procedure	
	r_managecreditprofile
		@login varchar(50)

as

declare @is_admin varchar(1)
declare @admin_id int
declare @tico_account_id int

create table
        #meta(
                meta_type char(200),
                name char(30),
                action char(200) NULL,
                value char(255) NULL
)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)


insert into
        #meta
values(
        "Column Link",
        "add_profile",
        "Add Credit Profile",
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "expand",
        "Expand Credit Profiles",
        NULL
)

insert into
	#meta
values(
	"Column Link",
	"edit_defaults",
	"Edit Default Credit Values",
	NULL
)

insert into
        #meta
values(
        "Column Link",
        "view_profile",
        "View Credit Profile",
        NULL
)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login

select
	@admin_id = access_group_id
from
	access_groups
where
	name = "Admin"

select
	@is_admin = "Y"
from
	access_group_accounts
where
	tico_account_id = @tico_account_id
and
	access_group_id = @admin_id


/* CHECK TO SEE IF THIS REPORT IS ENABLED */
if @is_admin != "Y"
begin
        select
                section = "Access Not Permitted",
                message = "<b>Access Not Permitted</b>" + " must be an 'Admin' user to view this report. Please contact your internal ETG Business Relationship Manager to set you up with access"
        return
end


declare @nop_type_id int
declare @dsl_type_id int
declare @currency_id int
declare @nop_type varchar(50)
declare @dsl_type varchar(50)
declare @currency varchar(10)
declare @notice_level float
declare @warning_level float
declare @blocked_level float


select
	@nop_type_id = nop_type_id,
	@dsl_type_id = dsl_type_id,
	@currency_id = currency_id,
	@notice_level = notice_level,
	@warning_level = warning_level,
	@blocked_level = blocked_level
from
	default_credit_profile_values

select
	@nop_type = name
from
	nop_types
where
	nop_type_id = @nop_type_id

select
	@dsl_type = name
from
	dsl_types
where
	dsl_type_id = @dsl_type_id

select
	@currency = symbol
from
	products
where
	product_id = @currency_id

select
	section = "Default Values",
	add_profile = "Add Credit Profile",
	expand = "Expand Profiles",
	currency = @currency,
	nop_type = @nop_type,
	dsl_type = @dsl_type,
	notice_level = @notice_level,
	warning_level = @warning_level,
	blocked_level = @blocked_level,
	edit_defaults = "EDIT"

create table
	#credit_profiles(
		credit_profile_id int,
		name varchar(50) NULL,
		currency_id int NULL,
		currency varchar(10) NULL,
		ccy varchar(10) NULL,
		nop_type_id int NULL,
		nop_type varchar(25) NULL,
		nop_limit float NULL,
		dsl_type_id int NULL,
		dsl_type varchar(25) NULL,
		dsl_limit float NULL,
		notice_level float NULL,
		warning_level float NULL,
		blocked_level float NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		counterparty_id int NULL,
		counterparty varchar(50) NULL,
		style varchar(50) NULL)

insert into
	#credit_profiles(
		credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level,
		style)
select
	credit_profile_id,
        name,
        currency_id,
        nop_type_id,
        nop_limit,
        dsl_type_id,
        dsl_limit,
        notice_level,
        warning_level,
        blocked_level,
	style = "background:#FFFFFF;border: 1px solid white"
from
	credit_profiles


update
	#credit_profiles
set
	currency = b.symbol
from
	#credit_profiles a,
	products b
where
	a.currency_id = b.product_id

update
	#credit_profiles
set
	nop_type = b.name
from
	#credit_profiles a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id

update
        #credit_profiles
set
	dsl_type = b.name
from
	#credit_profiles a,
	dsl_types b
where
	a.dsl_type_id = b.dsl_type_id	

select
	section="Credit Profiles",
        credit_profile = name,
        currency,
        nop_type,
        nop_limit,
        dsl_type,
        dsl_limit,
        notice_level,
        warning_level,
        blocked_level,
	style,
	view_profile = "VIEW"
from
	#credit_profiles
order by
	name
	
go
