use
	risk_cc
go

drop procedure
	cbo_accountoptplforrange
go

create procedure
	cbo_accountoptplforrange
		@login varchar(50),
		@account varchar(50),
		@begin_date datetime,
		@end_date datetime,
		@maturing_premium float output,
		@settled_premium float output,
		@unsettled_premium float output,
		@market_value float output,
		@realized_pl float output,
		@unrealized_pl float output,
		@unrealized_change float output
as


declare @external_account_id int
declare @u_begin_settled_premium float
declare @u_begin_unsettled_premium float
declare @u_begin_market_value float
declare @u_begin_unrealized_pl float

declare @r_begin_settled_premium float
declare @r_begin_unsettled_premium float
declare @r_begin_market_value float
declare @r_begin_unrealized_pl float

declare @u_unsettled_premium float
declare @r_unsettled_premium float

declare @u_settled_premium float
declare @r_settled_premium float

declare @u_market_value float
declare @r_market_value float


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end



create table
	#unexpired_contracts(
		contract_id int,
		expiration datetime)
insert into
	#unexpired_contracts
select
	a.contract_id,
	b.expiration
from
	option_contracts a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id
and
	convert(date, b.expiration) > convert(date, @end_date)


create table
	#expired_contracts(
		contract_id int,
		expiration datetime)
insert into
	#expired_contracts
select
	a.contract_id,
	b.expiration
from
	option_contracts a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.expiration >= @begin_date
and
	convert(date, b.expiration) <= convert(date, @end_date)

select
	@maturing_premium = sum(a.evaluation_premium)
from
	committed_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	b.external_account_id = @external_account_id
and
	convert(date, a.premium_settle_date) > convert(date, @begin_date)
and
	convert(date, a.premium_settle_date) <= convert(date, @end_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
and
	a.evaluation_premium != NULL


select
	@u_begin_unsettled_premium = sum(a.evaluation_premium)
from
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#unexpired_contracts d
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) > convert(date, @begin_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @begin_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @u_begin_unsettled_premium = NULL
	select
		@u_begin_unsettled_premium = 0.0


select  
	@u_begin_settled_premium = sum(a.evaluation_premium)
from    
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#unexpired_contracts d
where   
	a.trade_id = b.trade_id
and     
	b.account_transaction_id = c.account_transaction_id
and     
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) <= convert(date, @begin_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @begin_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @u_begin_settled_premium = NULL
	select
		@u_begin_settled_premium = 0.0


select
	@u_begin_market_value = sum(a.evaluation_value)
from
	committed_daily_revals a,
	trades b,
	#unexpired_contracts c
where
	a.trade_id = b.trade_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id
and
	b.external_account_id = @external_account_id
and
	convert(date, a.reval_date) = convert(date, @begin_date)
if @u_begin_market_value = NULL
	select
		@u_begin_market_value = 0.0


select
	@u_unsettled_premium = sum(a.evaluation_premium)
from
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#unexpired_contracts d
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) > convert(date, @end_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @end_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @u_unsettled_premium = NULL
	select
		@u_unsettled_premium = 0.0


select  
	@u_settled_premium = sum(a.evaluation_premium)
from    
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#unexpired_contracts d
where   
	a.trade_id = b.trade_id
and     
	b.account_transaction_id = c.account_transaction_id
and     
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) <= convert(date, @end_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @end_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @u_settled_premium = NULL
	select
		@u_settled_premium = 0.0


select
	@u_market_value = sum(a.evaluation_value)
from
	committed_daily_revals a,
	trades b,
	#unexpired_contracts c
where
	a.trade_id = b.trade_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id
and
	b.external_account_id = @external_account_id
and
	convert(date, a.reval_date) = convert(date, @end_date)
if @u_market_value = NULL
	select
		@u_market_value = 0.0

select
	@unrealized_pl = @u_unsettled_premium + @u_settled_premium + @u_market_value,
	@u_begin_unrealized_pl = @u_begin_unsettled_premium + @u_begin_settled_premium + @u_begin_market_value

select
	@unrealized_change = @unrealized_pl - @u_begin_unrealized_pl


/**************/
select
	@r_begin_unsettled_premium = sum(a.evaluation_premium)
from
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#expired_contracts d
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) > convert(date, @begin_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @begin_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @r_begin_unsettled_premium = NULL
	select
		@r_begin_unsettled_premium = 0.0


select  
	@r_begin_settled_premium = sum(a.evaluation_premium)
from    
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#expired_contracts d
where   
	a.trade_id = b.trade_id
and     
	b.account_transaction_id = c.account_transaction_id
and     
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) <= convert(date, @begin_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @begin_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @r_begin_settled_premium = NULL
	select
		@r_begin_settled_premium = 0.0


select
	@r_begin_market_value = sum(a.evaluation_value)
from
	committed_daily_revals a,
	trades b,
	#expired_contracts c
where
	a.trade_id = b.trade_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id
and
	b.external_account_id = @external_account_id
and
	convert(date, a.reval_date) = convert(date, @begin_date)
if @r_begin_market_value = NULL
	select
		@r_begin_market_value = 0.0


select
	@r_unsettled_premium = sum(a.evaluation_premium)
from
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#expired_contracts d
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) > convert(date, @end_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @end_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @r_unsettled_premium = NULL
	select
		@r_unsettled_premium = 0.0


select  
	@r_settled_premium = sum(a.evaluation_premium)
from    
	committed_daily_revals a,
	account_transaction_trades b,
	account_transactions c,
	#expired_contracts d
where   
	a.trade_id = b.trade_id
and     
	b.account_transaction_id = c.account_transaction_id
and     
	c.external_account_id = @external_account_id
and
	a.contract_id = d.contract_id
and
	convert(date, c.transaction_date) <= convert(date, @end_date)
and
	convert(date, a.bo_trade_date) <= convert(date, @end_date)
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
if @r_settled_premium = NULL
	select
		@r_settled_premium = 0.0


select
	@r_market_value = sum(a.evaluation_value)
from
	committed_daily_revals a,
	trades b,
	#expired_contracts c
where
	a.trade_id = b.trade_id
and
	a.contract_id = c.contract_id
and
	b.contract_id = c.contract_id
and
	b.external_account_id = @external_account_id
and
	convert(date, a.reval_date) = convert(date, @end_date)
if @r_market_value = NULL
	select
		@r_market_value = 0.0

select
	@realized_pl = @r_unsettled_premium + @r_settled_premium + @r_market_value

select
	@market_value = @r_market_value + @u_market_value,
	@settled_premium = @r_settled_premium + @u_settled_premium,
	@unsettled_premium = @r_unsettled_premium + @u_unsettled_premium



/**************/
/* select
	settled_premium = @settled_premium,
	unsettled_premium = @unsettled_premium,
	market_value = @market_value,
	begin_settled_premium = @u_begin_settled_premium,
	begin_unsettled_premium = @u_begin_unsettled_premium,
	begin_market_value = @u_begin_market_value,
	realized_pl = @realized_pl,
	unrealized_pl =	@unrealized_pl,
	unrealized_change = @unrealized_change */

go

