where
	a.forward_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @end_date)

update
	#sectors
set
	a.close_price = b.price
from
	#sectors a,
	#nearest_prices b
where
	a.forward_id = b.forward_id
and
	a.close_price = NULL
and
	b.price != NULL

update
	#sectors
set
	exposure = close_price * delta

update
	#sectors
set
	exposure_equiv = exposure
where
	currency_id = @fund_ccy_id

update
	#sectors
set
	a.exposure_equiv = a.exposure * c.price
from
	#sectors a,
	forwards b,
	bo_spot_settles c
where
	a.fund_ccy_id = b.currency_id
and
	a.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#sectors
set
	a.exposure_equiv = a.exposure * (1.0 / c.price)
from
	#sectors a,
	forwards b,
	bo_spot_settles c
where
	a.fund_ccy_id = b.product_id
and
	a.currency_id = b.currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.exposure_equiv = NULL


create table
	#sector_totals(
		sector_name varchar(50),
		exposure float NULL,
		volatility float NULL,
		of_total float NULL)

insert into
	#sector_totals(
		sector_name,
		exposure,
		volatility)
select
	sector_name,
	sum(abs(exposure_equiv)),
	avg(ten_day_vol)
from
	#sectors
where
	sector_name != NULL
and
	exposure != NULL
group by
	sector_name

update
	#sectors
set
	a.sector_total = b.exposure
from
	#sectors a,
	#sector_totals b
where
	a.sector_name = b.sector_name

update
	#sectors
set
	of_sector = abs(exposure_equiv) / sector_total,
	weighted_sector = (abs(exposure_equiv) / sector_total) * ten_day_vol
where
	sector_total != 0.0

select
	@total_exposure = sum(abs(exposure_equiv))
from
	#sectors
where
	exposure_equiv != NULL

if @total_exposure != 0.0
begin
	update
		#sectors
	set
		of_total = abs(exposure_equiv) / @total_exposure

	update
		#sector_totals
	set
		of_total = (abs(exposure)) / @total_exposure
end

select
	sector = sector_name,
	exposure,
	volatility,
	of_total
from
	#sector_totals
order by
	sector_name



select
	style,
	sector,
	base_currency,
	product,
	p_l,
	contribution,
	ten_day_vol,
	data_points,
	delta,
	close_price,
	exposure = exposure_equiv,
	of_sector,
	weighted_sector,
	of_total,
	exposure_equiv
from
	#sectors
order by
	id

