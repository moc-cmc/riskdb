create table
	#fut_prices(
		forward_id int,
		contract_id int,
		expiration datetime,
		price float)
insert into
	#fut_prices
select
	a.forward_id,
	b.contract_id,
	b.expiration,
	c.price	
from
	futures a,
	future_contracts b,
	prices c
where
	a.future_id = b.future_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)


create table
	#nearest_prices(
		forward_id int,
		nearest datetime,
		price float NULL)
insert into
	#nearest_prices(
		forward_id,
		nearest)
select
	forward_id,
	min(expiration)
from
	#fut_prices
group by
	forward_id


update
	#nearest_prices
set
	a.price = b.price
from
	#nearest_prices a,
	#fut_prices b
where
	a.forward_id = b.forward_id
and
	a.nearest = b.expiration

update
        #sectors
set
        a.close_price = 1.0 / d.price
from
        #sectors a,
        forwards b,
        forwards c,
        prices d
where
        a.forward_id = b.contract_id
and
        b.product_id = c.currency_id
and
        b.currency_id = c.product_id
and
        c.contract_id = d.contract_id
and
        convert(date, d.price_date) = convert(date, @end_date)


update
	#sectors
