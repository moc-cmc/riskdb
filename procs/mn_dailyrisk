create table
	#returns(
		id int identity,
		date datetime,
		begin_value float,
		begin_option_value float NULL,
		end_value float,
		cash_activity float,
		option_value float,
		p_l float NULL,
		roc float NULL,
		vami float NULL,
		mean float NULL,
		variance_to_mean float NULL,
		squared float NULL)
insert into
	#returns(
		date,
		begin_value,
		end_value,
		cash_activity,
		option_value)
select
	a.trade_date,
	sum(a.begin_balance),
	sum(a.end_balance),
	sum(a.cash_activity),
	sum(a.option_value)
from
	external_margin_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
group by
	a.trade_date
order by
	a.trade_date


update
	#returns
set
	a.begin_option_value = b.option_value
from
	#returns a,
	#returns b
where
	a.id = b.id + 1
	
		
/* delete

from
	#returns
where
	begin_option_value = NULL */

update
	#returns
set
	begin_option_value = option_value,
	vami = 1000.00
where
	id = 1

update
	#returns
set
	p_l = (end_value + option_value - cash_activity) - (begin_value + begin_option_value)

update
	#returns
set
	roc = 1.0 - (end_value + option_value - cash_activity) / (begin_value + begin_option_value)

	

select
	@id = 1,
	@vami = 1000.00
select
	@ids = count(*)
from
	#returns
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#returns
	where
		id > @id

	select
		@roc = roc
	from
		#returns
	where
		id = @id

	select
		@vami = @vami * (1.0 + @roc)

	update
		#returns
	set
		vami = @vami
	where
		id = @id

	select
		@ids = count(*)
	from
		#returns
	where
		id > @id
end


select
	@day = roc,
	@day_pl = p_l
