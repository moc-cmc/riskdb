	#returns
where
	convert(date, date) = convert(date, @max_date)

create table
	#months(
		month varchar(50),
		first datetime,
		last datetime,
		p_l float)
insert into
	#months
select
	rtrim(datename(month, date)) + " " + rtrim(datename(year, date)),
	min(date),
	max(date),
	sum((end_value + option_value - cash_activity) - (begin_value + begin_option_value))
from
	#returns
group by
	rtrim(datename(month, date)) + " " + rtrim(datename(year, date))


select
	@month_pl = p_l
from
	#months
where
	last = (select
			max(last)
		from
			#months)

select
	@month = @month_pl / @trading_level


select
	@year_pl = sum(p_l)
from
	#returns
where
	datepart(year, date) = datepart(year, @max_date)

select
	@year = @year_pl / @trading_level

select
	@lifetime_pl = sum(p_l)
from
	#returns

select
	@lifetime = @lifetime_pl / @trading_level



select
	@mean = avg(roc)
from
	#returns

update
	#returns
set
	mean = @mean

update
	#returns
set
	variance_to_mean = roc - mean

update
	#returns
set
	squared = variance_to_mean * variance_to_mean

select
	@total_variance = sum(squared)
from
	#returns
select
	@volatility = sqrt(@total_variance)




select
	@worst_drawdown = min(roc)
from
	#returns

select
	@drawdown_date = date
from
	#returns
where
	roc = @worst_drawdown

select
	@vami = vami
from
	#returns
where
	convert(date, date) = convert(date, @max_date)


