create table
	#contract_totals(
		contract_id int,
		forward_id int NULL,
		p_l float,
		delta float NULL)
insert into
	#contract_totals(
		contract_id,
		p_l,
		delta)
select
	contract_id,
	sum(p_l),
	sum(delta)
from
	#contract_pls
group by
	contract_id

update
	#contract_totals
set
	a.forward_id = c.forward_id,
	a.delta = a.delta * c.quantity
from
	#contract_totals a,
	future_contracts b,
	futures c
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id

update
	#contract_totals
set
	a.forward_id = f.forward_id,
	a.delta = a.delta * d.quantity * f.quantity
from
	#contract_totals a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.future_id = f.future_id


