
if object_id("j_contract") != NULL
    drop procedure
        j_contract
go

create procedure
	j_contract
		@symbol char(200) output,
		@contract_id int output
as

if @symbol != NULL
	select
		@contract_id = contract_id
	from
		contracts
	where
		symbol = @symbol
else
	select
		@symbol = symbol
	from
		contracts
	where
		contract_id = @contract_id

return

go
