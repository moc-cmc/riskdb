if object_id("mc_editmarketoption") != NULL
    drop procedure
        mc_editmarketoption
go

create procedure
	mc_editmarketoption
		@login char(25),
		@deal_id int,
		@buy_sell varchar(20),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@biproduct varchar(50),
		@timezone varchar(50),
		@expiration datetime,
		@option_settledate datetime,
		@strike numeric(30,4),
		@call_put varchar(5),
		@spot_reference float,
		@price float,
		@price_format varchar(10),
		@total_premium float,
		@premium_currency varchar(50),
		@premium_settle datetime
as

declare @external_account varchar(50)
declare @pips_price float
declare @pct_price float
declare @contract_id int
declare @symbol varchar(50)
declare @trade_id int
declare @trade_date datetime
declare @tally_type varchar(20)
declare @sales_code varchar(50)

select
	@tally_type = "Option",
	@sales_code = "None"


select
	@external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end


if @price_format = "Pct"
begin
	select
		@pips_price = (@price / 100.00)  * @spot_reference,
		@pct_price = @price / 100.00
end
else
begin
	select
		@pips_price = @price,
		@pct_price = NULL
end


if @buy_sell = "Buy"
begin
	select
		@quantity = abs(@quantity)
end
if @buy_sell = "Sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end

exec
	r_spotoptioncontract
		@biproduct,
		@timezone,
		@expiration,
		@call_put,
		@strike,
		@option_settledate,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

select
	@trade_id = trade_id
from
	trades
where
	deal_id = @deal_id

select
	@trade_date = trade_date
from
	trades
where
	trade_id = @trade_id

exec
        r_inserttradeedit @trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Market Option",
		@trade_type = "Option",
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @option_settledate,
		@price = @pips_price,
		@trade_date = @trade_date,
		@sales_code = @sales_code,
		@premium = @total_premium,
		@premium_currency = @premium_currency,
		@prem_settle_date = @premium_settle,
		@pct_price = @pct_price


if(@quantity = 0)
begin
        exec
                r_updatetradenotification @trade_id, "Cancelled"
end
else
begin
        exec
                r_updatetradenotification @trade_id, "Edit" 
end


exec
	r_inspectdealtrades
		@login,
		@deal_id



go
