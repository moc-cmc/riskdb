drop procedure
	r_viewmarginprofile
go

create procedure	
	r_viewmarginprofile
		@login varchar(50),
		@margin_profile varchar(50)

as

declare @margin_profile_id int

create table
        #meta(
                meta_type char(200),
                name char(30),
                action char(200) NULL,
                value char(255) NULL
)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Hidden",
        "cpid",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Hidden",
        "margin_profile",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "add_account",
        "Add Account to Margin Profile",
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "back",
        "Manage Margin Profiles",
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "add_ctpy",
        "Add Counterparty to Margin Profile",
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "expand",
        NULL,
        NULL
)

insert into
        #meta
values (
        "Column Group",
        "section",
        NULL,
        NULL)

insert into
        #meta
values (
        "Column Link",
        "remove_ctpy",
        "Remove Counterparty From Margin Profile",
        NULL)

insert into
        #meta
values (
        "Column Link",
        "remove_account",
        "Remove Account From Margin Profile",
        NULL)

insert into
        #meta
values (
        "Column Link",
        "edit_profile",
        "Edit Margin Profile",
        NULL)


select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta


select
	@margin_profile_id = margin_profile_id
from
	margin_profiles
where
	name = @margin_profile

select
	back = "<< Back",
	add_account = "Add Account",
	add_ctpy = "Add Counterparty",
	margin_profile = @margin_profile

create table
	#margin_profiles(
		margin_profile_id int,
		name varchar(50) NULL,
		currency_id int NULL,
		currency varchar(10) NULL,
		margin_model_id int NULL,
		margin_model varchar(50) NULL,
		notice_level float NULL,
		warning_level float NULL,
		blocked_level float NULL,
		multiplier float NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		counterparty_id int NULL,
		counterparty varchar(50) NULL,
		style varchar(50) NULL,
		section varchar(50) NULL)

insert into
	#margin_profiles(
		margin_profile_id,
                name,
                currency_id,
		margin_model_id,
                notice_level,
                warning_level,
                blocked_level,
		multiplier,
		style)
select
	margin_profile_id,
        name,
        currency_id,
	margin_model_id,
        notice_level,
        warning_level,
        blocked_level,
	multiplier,
	style = "background:#FFFFFF;border: 1px solid white"
from
	margin_profiles
where
	margin_profile_id = @margin_profile_id

insert into
	#margin_profiles(
		margin_profile_id,
		external_account_id)
select
	margin_profile_id,
	external_account_id
from
	margin_profile_accounts
where
	margin_profile_id = @margin_profile_id

insert into
	 #margin_profiles(
                margin_profile_id,
		counterparty_id)
select
	margin_profile_id,
	counterparty_id
from
	margin_profile_counterparties
where
        margin_profile_id = @margin_profile_id

	

update
	#margin_profiles
set
	currency = b.symbol
from
	#margin_profiles a,
	products b
where
	a.currency_id = b.product_id

update
	#margin_profiles
set
	margin_model = b.name
from
	#margin_profiles a,
	margin_models b
where
	a.margin_model_id = b.margin_model_id 


update
	#margin_profiles
set
	external_account = b.symbol,
	section = "Accounts",
	style = "background:#FFFFFF;border: 1px solid white"
from
	#margin_profiles a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#margin_profiles
set
	counterparty = b.name,
	section = "Counterparties",
	style = "background:#FFFFFF;border: 1px solid white"
from
	#margin_profiles a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id


select
	cpid = margin_profile_id,
        name,
        currency,
	margin_model,
        notice_level,
        warning_level,
        blocked_level,
	multiplier,
	style,
	edit_profile = "EDIT"
from
	#margin_profiles
where
	name != NULL

select
	section,
	margin_profile = @margin_profile,
	account = external_account,
	remove_account = "Remove",
	style
from
	#margin_profiles
where
	external_account != NULL

select
	section,
	margin_profile = @margin_profile,
	counterparty = counterparty,
	remove_ctpy = "Remove",
	style
from
	#margin_profiles
where
	counterparty != NULL


	
go
