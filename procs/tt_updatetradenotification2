
if object_id("tt_updatetradenotification2") != NULL
    drop procedure
        tt_updatetradenotification2
go

create procedure
    tt_updatetradenotification2
        @login varchar(50),
        @trade_notification_id int,
        @status varchar(25) = NULL,
        @error varchar(250) = NULL
as

declare @status_id int

if @status = NULL
    select
        @status = "Sent"

select
    @status_id = status_id
from
    statuses
where
    name = @status

if @status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, '" + @status + "'",
        name = @status
    return
end

update
    trade_notifications2
set
    status_id = @status_id,
    notify_date = getdate(),
    error = @error
where
    trade_notification_id = @trade_notification_id

if @@rowcount != 1
begin
    select
        status = "Error",
        message = "No trade notification found",
        trade_notification_id = @trade_notification_id
    return
end

go
