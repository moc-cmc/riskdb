drop procedure
	r_importpassportcb
go

create procedure
	r_importpassportcb
		@login varchar(50),
		@value_date datetime=NULL,
		@ccy varchar(50)=NULL,
		@ccy_pair varchar(50)=NULL,
		@account varchar(50)=NULL,
		@b_s varchar(10)=NULL,
		@ccy1 varchar(50)=NULL,
		@amount1 float=NULL,
		@ccy2 varchar(50)=NULL,
		@amount2 float=NULL,
		@type varchar(20)=NULL,
		@spot float=NULL,
		@fwd_pts float=NULL,
		@all_in float=NULL,
		@status varchar(50)=NULL,
		@alloc varchar(50)=NULL,
		@trade_date datetime=NULL,
		@last_update datetime=NULL,
		@source varchar(50)=NULL,
		@reference_id varchar(100)=NULL,
		@entry_user varchar(50)=NULL,
		@comment varchar(100)=NULL,
		@session_id varchar(100),
		@row_index int,
		@row_count int

as


declare @product1_id int
declare @product2_id int
declare @tico_account_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
	return

if @row_index = 0
	delete

	from
		session_report_balances
	where
		tico_account_id = @tico_account_id

if upper(@b_s) = "S"
	select
		@amount1 = @amount1 * -1.0
else
	select
		@amount2 = @amount2 * -1.0

select
	@product1_id = product_id
from
	products
where
	symbol = @ccy1
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Product not found",
		product = @ccy1
	return
end

select
	@product2_id = product_id
from
	products
where
	symbol = @ccy2
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Product not found",
		product = @ccy2
	return
end

insert into
	session_report_balances
values(
	@tico_account_id,
	@session_id,
	@product1_id,
	@value_date,
	@amount1,
	@trade_date)


insert into
	session_report_balances
values(
	@tico_account_id,
	@session_id,
	@product2_id,
	@value_date,
	@amount2,
	@trade_date)

	
if @row_count = @row_index + 1
	exec
		r_passengerladder
			@login,
			@session_id



go
