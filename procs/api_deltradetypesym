
drop procedure
	api_deltradetypesym	
go

create procedure 
	api_deltradetypesym	
		@login varchar(25),
		@name varchar(50),
		@source_name varchar(100),
		@mapping varchar(25)
as

declare @trade_type_id int
declare @source_id int

select
	@trade_type_id=trade_type_id
from
	trade_types	
where
	name=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find trade_type",
		trade_type=@name

	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find source",
		source=@source_name

	return
end

begin tran

	delete from
		trade_type_symbols
	where
		trade_type_id=@trade_type_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount != 1)
	begin
		rollback tran

		select
			status="Error",
			msg="Could not delete Trade Type mapping",
			name=@name

		return
	end

commit tran

select
	status="Success",
	msg="Trade Type mapping deleted",
	name=@name

exec
	r_mappingoverview2
			@login=@login

return

go

