create table
	#master_allocations(
		master_allocation_id int,
		master_allocation varchar(50),
		external_account_id int,
		account varchar(50),
		instrument_id int,
		instrument varchar(50),
		versions int NULL,
		active_version int NULL,
		manage_allocation varchar(50) NULL)

insert into
	#master_allocations(
		master_allocation_id,
		master_allocation,
		external_account_id,
		account,
		instrument_id,
		instrument,
		manage_allocation)
select
	a.master_allocation_id,
	a.name,
	a.external_account_id,
	b.symbol,
	a.instrument_id,
	c.name,
	manage_allocation = "Manage"
from
	master_allocations a,
	external_accounts b,
	instruments c
where
	a.external_account_id = b.external_account_id
and
	a.instrument_id = c.instrument_id

create table
	#versions(
		master_allocation_id int,
		versions int)
insert into
	#versions(
		master_allocation_id,
		versions)
select
	master_allocation_id,
	count(version)
from
	ma_versions
group by
	master_allocation_id

update
	#master_allocations
set
	a.versions = b.versions
from
	#master_allocations a,
	#versions b
where
	a.master_allocation_id = b.master_allocation_id

update
	#master_allocations
set
	a.active_version = b.version
from
	#master_allocations a,
	ma_versions b,
	statuses c
where
	a.master_allocation_id = b.master_allocation_id
and
	b.status_id = c.status_id
and
	c.name = "Active"

select
	master_allocation,
	account,
	instrument,
	versions,
	active_version,
	manage_allocation
from
	#master_allocations
order by
	master_allocation

	


