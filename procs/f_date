
if object_id("f_date") != NULL
    drop procedure
        f_date
go
 
create procedure
	f_date
		@date datetime,
		@stripped_date datetime output
as

declare @datestring char(50)
	

select
	@datestring = convert(char(2), datepart(month, @date)) + "/" + convert(char(2), datepart(day, @date)) + "/" + convert(char(4), datepart(year, @date))

select
	@stripped_date = convert(datetime, @datestring)

go
