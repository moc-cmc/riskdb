create or replace procedure	
	r_secretpath
		@login varchar(50),
		@identifier int,
		@external_account varchar(50)=NULL,
		@vault varchar(50)=NULL,
		@source varchar(50)=NULL

as

declare @has_permission char(1)
declare @tico_account_id int

select
    @tico_account_id = account_id
from
    tico_accounts
where
    login = @login
if @tico_account_id = NULL
begin
    select
           status="Error",
           message="Problem finding account for login"
    return
end

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)

select
    @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
    @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
    @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
    @style = "background:#FFFFFF;border: 1px solid white",
    @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
    @client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
    #meta(
        meta_type char(200),
        name char(50) NULL,
        action char(100) NULL,
        value char(200) NULL)
insert into
    #meta
values(
    "Row Style",
    "style",
    NULL,
    NULL)

insert into
    #meta
values (
    "Column Group",
    "section",
    NULL,
    NULL)

insert into
    #meta
values (
    "Column Link",
    "back",
    "Manage Secret Paths",
    NULL)

insert into
    #meta
values (
    "Column Link",
    "disable",
    "Disable Secret Path",
    NULL)

insert into
    #meta
values (
    "Column Link",
    "edit_secret",
    "Edit Secret Path",
    NULL)

insert into
    #meta
values (
    "Column Hidden",
    "identifier",
    NULL,
    NULL)

insert into
    #meta
values (
    "Column Hidden",
    "status_name",
    NULL,
    NULL)





exec
        r_checkaccessgrouppermission
                @login,
                "Secret Admin",
                @has_permission output,
		@show_perm_denied = "Y"

if @has_permission != "Y"
begin
        return
end


select
	* 
from
	#meta

select
	section = "Secret Operations",
	back = "< Back to Manage Secrets",
	style = @style


select
	section = "Current Configuration",
	external_account = b.symbol,
	vault = c.name,
	source = a.name,
	status_name = d.name,
	identifier = e.account_vault_secret_id,
	status = case	when d.name = "Active" then "<b><font color='009900'>Active</font></b>"
			when d.name = "Pending" then  "<b><font color='00CCFF'>Pending</font></b>"
			when d.name = "Disabled" then  "<b><font color='FF6666'>Disabled</font></b>"
			else d.name
		end,
	secret_path = e.secret_path,
	description = e.description,
	added_on = e.added_on,
	added_by = rtrim(f.given_names)+' '+rtrim(f.surname),
	edit_secret = "Edit",
	style = @style
from
	sources a,
	external_accounts b,
	key_vaults c,
	statuses d,
	account_vault_secrets e,
	tico_accounts f
where
	a.source_id = e.source_id
and
	b.external_account_id = e.external_account_id
and
	c.key_vault_id = e.key_vault_id
and
	d.status_id = e.status_id
and
	f.account_id = e.added_by
and
	e.account_vault_secret_id = @identifier
order by 
	a.name,
	b.symbol,
	c.vault,
	e.added_on	
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem finding secret"
	return
end


select
        section = "Configuration History",
        external_account = b.symbol,
        vault = c.name,
        status = case   when d.name = "Active" then "<b><font color='009900'>Active</font></b>"
                        when d.name = "Pending" then  "<b><font color='00CCFF'>Pending</font></b>"
			when d.name = "Disabled" then  "<b><font color='FF6666'>Disabled</font></b>"
                        else d.name
                end,
        secret_path = e.secret_path,
        description = e.description,
        added_on = e.added_on,
        added_by = rtrim(f.given_names)+' '+rtrim(f.surname),
	edited_at = e.edited_at,
	edited_by = rtrim(g.given_names)+' '+rtrim(g.surname),
	note = e.note,
        style = @style
from
        sources a,
        external_accounts b,
        key_vaults c,
        statuses d,
        account_vault_secret_edits e,
        tico_accounts f,
        tico_accounts g
where
        a.source_id = e.source_id
and
        b.external_account_id = e.external_account_id
and
        c.key_vault_id = e.key_vault_id
and
        d.status_id = e.status_id
and
        f.account_id = e.added_by
and
        g.account_id = e.edited_by
and
        e.account_vault_secret_id = @identifier
order by
        a.name,
        b.symbol,
        c.vault,
        e.edited_at DESC
	
	

go
