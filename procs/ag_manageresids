insert into
	#resids(
		external_account_id,
		product_id,
		value_date,
		quantity)
select
	external_account_id,
	product_id,
	value_date = @value_date,
	quantity * -1.0
from
	#client_balances
where
	resid = "Yes"

update
	#resids
set
	a.currency_id = b.evaluation_currency_id
from
	#resids a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#resids
set
	a.contract_id = b.contract_id
from
	#resids a,
	forwards b
where
	a.product_id = b.product_id
and
	a.currency_id = b.currency_id

update
	#resids
set
	a.price = b.rate
from
	#resids a,
	defined_resid_rates b
where
	a.contract_id = b.contract_id
and
	convert(date, b.value_date) = convert(date, @value_date)

select
	@missing_contracts = count(*)
from
	#resids
where
	contract_id = NULL
if @missing_contracts > 0
begin
	select
		section = "Missing Contracts",
		message = "Missing contracts for product currency pair. Check contract subscription for",
		product = a.symbol,
		currency = b.symbol,
		contract_id = c.contract_id
	from
		products a,
		products b,
		#resids c
	where
		a.product_id = c.product_id
	and
		b.product_id = c.currency_id
	and
		c.contract_id = NULL
	return
end

select
	@resids = count(*)
from
	#resids

if @resids > 0
begin
	exec
		j_nextkey
			"batches",
			@batch_id output

			
	select
		@id = 0
	select
		@ids = count(*)
	from
		#resids
	where
		id > @id

	while @ids > 0
	begin
		select
			@id = min(id)
		from
			#resids
		where
			id > @id


		select
			@contract_id = NULL,
			@defined_resid_rate_id = NULL,
			@resid_rate = NULL,
			@external_account_id = NULL,
			@quantity = NULL

		select
			@contract_id = contract_id,
			@external_account_id = external_account_id,
			@quantity = quantity
		from
			#resids
		where
			id = @id

		select
			@defined_resid_rate_id = defined_resid_rate_id,
			@resid_rate = rate
		from
			defined_resid_rates
		where
			contract_id = @contract_id
		and
			convert(date, value_date) = convert(date, @value_date)
		if @defined_resid_rate_id = NULL
		begin
			exec
				j_nextkey
					"defined_resid_rates",
					@defined_resid_rate_id output

			insert into
				defined_resid_rates(
					defined_resid_rate_id,
					value_date,
					contract_id)
			values(
				@defined_resid_rate_id,
				@value_date,
				@contract_id)
		end


		exec
			j_nextkey
				"queued_resid_trades",
				@queued_resid_id output
		insert into
			queued_resid_trades(
				queued_resid_id,
				batch_id,
				trade_date,
				external_account_id,
				quantity,
				contract_id,
				value_date,
				price)
		values(
			@queued_resid_id,
			@batch_id,
			getdate(),
			@external_account_id,
			@quantity,
			@contract_id,
			@value_date,
			@resid_rate)
			
		select
			@ids = count(*)
		from
			#resids
		where
			id > @id
	end
end
	

