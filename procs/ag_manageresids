	external_account_id,
	product_id

update
	#client_balances
set
	style = @style

update
	#client_balances
set
	a.product = b.symbol,
	a.account = c.symbol,
	a.evaluation_currency_id = c.evaluation_currency_id
from
	#client_balances a,
	products b,
	external_accounts c
where
	a.product_id = b.product_id
and
	a.external_account_id = c.external_account_id

update
	#client_balances
set
	settled_fx = 0.0,
	closed_fx = 0.0

update
	#client_balances
set
	a.settled_fx = b.amount
from
	#client_balances a,
	#account_settlements b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id

update
	#client_balances
set
	a.closed_fx = b.amount
from
	#client_balances a,
	#closed_account_settlements b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id 

update
	#client_balances
set
	settled_fx = 0.0
where
	settled_fx = NULL

update
	#client_balances
set
	closed_fx = 0.0
where
	closed_fx = NULL

update
	#client_balances
set
	net_balance = quantity - closed_fx - settled_fx

delete

from
	#client_balances
where
	abs(quantity) < 0.01


create table
	#pb_output(
		id int identity,
		style varchar(250) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(100) NULL,
		external_account_id int NULL,
		external_account varchar(100) NULL,
		value_date varchar(20) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		balance numeric(30,2) NULL,
		closed_fx numeric(30,2) NULL,
		settled_fx numeric(30,2) NULL,
		net_balance numeric(30,2) NULL,
		resid varchar(10) NULL)
select
	@id = 0
select
	@ids = count(*)
from
	#prime_brokers
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#prime_brokers
	where
		id > @id

	select
		@pb_id = prime_broker_id
	from
		#prime_brokers
	where
		id = @id

	insert into
		#pb_output(
			style,
			external_account_id,
			prime_broker_id,
			prime_broker,
			value_date)
	select
		pb_style = @pb_style,
		external_account_id,
		prime_broker_id,
		prime_broker,
		value_date = convert(varchar(11), @value_date, 1)
	from
		#prime_brokers
	where
		id = @id


	insert into
		#pb_output(
			style,
			prime_broker_id,
			external_account_id,
			product_id,
			product,
			balance,
			closed_fx,
			settled_fx,
			net_balance)
	select
		style = @style,
		prime_broker_id,
		external_account_id,
		product_id,
		product,
		quantity,
		closed_fx,
		settled_fx,
		net_balance
	from
		#pb_balances
	where
		prime_broker_id = @pb_id
	order by
		product
			
	select
		@ids = count(*)
	from
		#prime_brokers
	where
		id > @id
end

update
	#pb_output
set
	style = @client_style
where
	prime_broker_id = @fund_prime_broker_id

update
	#pb_output
set
	style = @error_style,
	resid = "Yes"
where
	abs(balance) > 0.01

update
	#pb_output
set
	a.style = @style,
	a.resid = "No"
from
	#pb_output a,
	pb_deliverable_products b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id

update
	#client_balances
set
	style = @error_style,
	resid = "Yes"
where
	product_id != evaluation_currency_id
and
	abs(quantity) > .01
	

update
	#client_balances
set
	a.style = @style,
	a.resid = "No"
from
	#client_balances a,
	acct_deliverable_products b
where
	a.product_id = b.product_id
and
	a.external_account_id = b.external_account_id



