	#trades(
		trade_id,
		external_account_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		value_date,
		price)
select
	a.trade_id,
	a.external_account_id,
	c.product_id,
	a.quantity,
	c.currency_id,
	a.quantity * a.price * -1.0,
	a.value_date,
	a.price
from
	trades a,
	fund_external_accounts b,
	forwards c
where
	a.contract_id = c.contract_id
and
	a.external_account_id = b.external_account_id
and
	b.fund_id = @fund_id
and
	convert(date, a.value_date) = convert(date, @value_date)

