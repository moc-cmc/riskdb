
drop procedure
	mi_touchpoints
go

create procedure
	mi_touchpoints
		@login varchar(50),
		@as_of datetime = NULL
as


if @as_of = NULL
	select
		@as_of = getdate()

create table
	#output(
		external_account_id int,
		prime_broker varchar(50) NULL,
		short_name varchar(50) NULL,
		long_name varchar(50) NULL,
		first_trade datetime NULL,
		total_trades int NULL)

create table
	#stats(
		external_account_id int,
		first_trade datetime,
		total_trades int)
insert into
	#stats(
		external_account_id,
		first_trade,
		total_trades)
select
	external_account_id,
	min(trade_date),
	count(trade_id)
from
	trades
group by
	external_account_id


insert into
	#output(
		external_account_id,
		prime_broker,
		short_name,
		long_name)
select
	a.external_account_id,
	d.name,
	a.symbol,
	a.name
from
	external_accounts a,
	external_account_prime_brokers b,
	prime_brokers c,
	sources d
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = c.prime_broker_id
and
	c.source_id = d.source_id
	


update
	#output
set
	a.first_trade = b.first_trade,
	a.total_trades = b.total_trades
from
	#output a,
	#stats b
where
	a.external_account_id = b.external_account_id


select
	prime_broker,
	short_name,
	long_name,
	first_trade,
	total_trades
from
	#output
order by
	prime_broker,
	short_name


go
