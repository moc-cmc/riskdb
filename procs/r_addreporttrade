create procedure
	r_addreporttrade
		@login varchar(25),
		@id varchar(25),		    /* 8433080 */
		@origin_ticket_id varchar(50),      /* "" */
		@link_status varchar(50),           /* "" */
		@master_id varchar(50),             /* "" */
		@lifecycle_status varchar(50),      /* Active */
		@matching_status varchar(50),       /* Unmatched */
		@approval_status varchar(50),       /* Approved */
		@allocation_status varchar(50),     /* Allocated */
		@processing_status varchar(50),     /* N/A */
		@trade_date datetime,               /* 01/02/2010 */
		@matching_time varchar(50),         /* "" */
		@trading_party varchar(50),         /*  */
		@region varchar(50),		    /* "" */
		@counter_party varchar(50),	    /* "" */
		@direction varchar(50),             /* SELL */
		@product_type varchar(50),          /* Spot/Forward */
		@ccy1 varchar(50),                  /* EUR */
		@quantity1 numeric(30,4),           /* 2,500,000 */
		@ccy2 varchar(50),                  /* USD */
		@quantity2 numeric(30,4),           /* 3,791,972.5 */
		@rate float,			    /* 1.516789 */
		@value_date varchar(50),    	    /* 02/15/2010 */
		@far_rate varchar(50),              /* "" */
		@far_value_date varchar(50),	    /* "" */
		@far_quantity1 varchar(50),         /* "" */
		@far_quantity2 varchar(50),         /* "" */
		@portfolio varchar(50),             /* "" */
		@trader varchar(50),	            /* "" */
		@ticket_num varchar(50),	    /* "" */
		@trade_type varchar(50),	    /* Regular */
		@creation_date varchar(50),         /* 01/22/2010 12:27:13 */
		@agreement_type varchar(50),	    /* PB */
		@harmony_status varchar(50),        /* "" */
		@harmony_id varchar(50),	    /* "" */
		@prime_broker varchar(50),          /* Primary Org */
		@fixing_date varchar(50),           /* "" */
		@fixing_index varchar(50),          /* "" */
		@calc_agent varchar(50),            /* "" */
		@origin_system varchar(50),         /* PB - System */
		@creation_party varchar(50),        /* Cantor Fitzgerald Securities */
		@created_by varchar(50),            /* etgbot */
		@notes varchar(50),                 /* "" */
		@execution_platform varchar(50),    /* "" */
		@reporter varchar(50),               /* "" */
		@external_report varchar(50),        /* "" */
		@defualt_broker_symbol varchar(50),  /* "" */
		@noe_activity varchar(15)            /* "" */

as

declare @report_date datetime

declare @external_report_id int
declare @source_id int
declare @source_name varchar(50)
declare @agency_strategy_id int
declare @status_id int
declare @status_name varchar(25)

declare @identifier varchar(100)
declare @broker_identifier varchar(50)
declare @external_account_id int
declare @external_account_created bit
declare @external_account_name varchar(100)
declare @external_account_type varchar(25)
declare @counterparty_id int
declare @counterparty_name varchar(50)
declare @broker_symbol varchar(50)
declare @broker_id int
declare @broker_created bit
