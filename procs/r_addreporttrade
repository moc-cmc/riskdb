/* 
 * Get the report_commit for the @trade_date
 */
exec
	r_reportcommitfordate
		@fund,
		@external_report,
		@report_date,
		@report_commit_id output

if @report_commit_id = NULL
begin
	select
		status = "Error",
		message = "Couldn't find the report commit record for fund '" + @fund + "', report '" + @external_report + "' for trade date, '" + convert(varchar(10), @report_date, 101) + "'"
	return
end



/* ------------------- MARK: Insert or update report trade ------------------ */

if @direction = "SELL"
    select
        @quantity1 = -@quantity1
else
    select
        @quantity2 = -@quantity2

/* If the row for the @ticket already exists, then try to match it. */

/*
 * -> @lifecycle_status = "Deleted"?
 *  '-> Yes: Delete the report trade and any matches
 *  '-> No:
 *    '-> identifier/@ticket already exists in report_trades?
 *    '-> No: ADDED - Insert to report_trades
 *    '-> Yes: Does account, ccy_1, ccy_2 and broker_symbol match?
 *	    '-> Yes: Do the rest of the values match?
 *	    |   '-> Yes: DUPLICATE - select status = "Duplicate"
 *	    |   '-> No:  CHANGED - Update the row and, select status = "Changed"
 *      '-> No: FAILURE select status = "Failure"
 */
select
	@report_trade_id = report_trade_id
from	
	report_trades
where
	report_commit_id = @report_commit_id
and
	identifier = @identifier

if @lifecycle_status in ("Deleted", "Replaced", "Bust", "Unified")
begin

    /* 
     * DELETED
     */
    if @report_trade_id != null
        delete from
            report_trades
        where
            report_trade_id = @report_trade_id

end
else if @report_trade_id = NULL
begin

	/* 
	 * ADDED
	 */
	
	insert into
		report_trades
	values (
		@report_commit_id,
		getdate(),
		@identifier,
		@id,
		@trade_date,
		@noe_activity,
		@external_account_id,
		@trade_date,
		@ccy1 + @ccy2,
		@ccy1,
		@quantity1,
		@ccy2,
		@quantity2,
		@rate,
		@value_date,
		@status_id,
		@agency_strategy_id,
		@broker_id,
		NULL,
		@prime_broker,
		@indicators,
		@description,
		@lifecycle_status,
		@matching_status,
		@approval_status,
		@allocation_status,
		@processing_status
	)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Failed to insert report trade"
		return
	end
	select
		@report_trade_id = @@identity

/*	select
		status = "Added",
		message = "Added report trade"
*/

end
else
begin

	/* 
	 * Check to see if the immutable properties are consistent:
	 * external_account_id, ccy_1, ccy_2, broker_id
	 */
	if exists (
			select
				*
			from
				report_trades
			where
				report_trade_id = @report_trade_id
			and
				external_account_id = @external_account_id
			and
				ccy_1 = @ccy1
			and
				ccy_2 = @ccy2
			and
				broker_id = @broker_id)
	begin
	
		if exists (
				select
					*
				from
					report_trades
				where
					report_trade_id = @report_trade_id
				and
					client_identifier = @ticket_num
				and
					activity_date = @creation_date
				and
					activity = @noe_activity
				and
					trade_date = @trade_date
				/* Ignore:
					nominal_contract_symbol = NULL */
				and
					ccy_1_quantity = @quantity1
				and
					ccy_2_quantity = @quantity2
				and
					nominal_price = @rate
				and
					value_date = @value_date
				and
					status_id = @status_id
				and
					strategy_id = @agency_strategy_id
                and
					broker_identifier = @broker_identifier
				and
					spoke_bank = @prime_broker
				and
					lifecycle_status = @lifecycle_status
				and
					matching_status = @matching_status
				and
					approval_status = @approval_status
				and
					allocation_status = @allocation_status
				and
					processing_status = @processing_status
				/* Ignore: 
				and
					indicators = NULL
				and
					description = NULL */)
		begin
			
			/* 
			 * DUPLICATE
			 */
/*			select
				status = "Duplicate",
				message = "Report trade already added",
				activity_date = @trade_date,
				activity = @noe_activity,
				portfolio = @portfolio,
				trade_date = @trade_date,
				ccy_1 = @ccy1,
				ccy_1_amount = @quantity1,
				trade_rate = @rate,
				ccy_2 = @ccy2,
				ccy_2_amount = @quantity2,
				value_date = @value_date,
				ticket = @ticket,
				description = @description,
				spoke_bank = @prime_broker,
				source = @source,
				indicators = @indicators,
				cust_trade_id = @id
*/
			select
				@noop = 1
				
		end
		else
		begin
		
			/* 
			 * CHANGED
			 */
			if 1 = 1
			begin
			
				update 
					report_trades
				set
					client_identifier = @ticket_num,
					activity_date = @creation_date,
					activity = @noe_activity,
					trade_date = @trade_date,
					ccy_1_quantity = @quantity1,
					ccy_2_quantity = @quantity2,
					nominal_price = @rate,
					value_date = @value_date,
					status_id = @status_id,
					strategy_id = @agency_strategy_id,
					broker_identifier = @broker_identifier,
			                    spoke_bank = @prime_broker,
					indicators = @indicators,
					description = @description,
					lifecycle_status = @lifecycle_status,
					matching_status = @matching_status,
					approval_status = @approval_status,
					allocation_status = @allocation_status,
					processing_status = @processing_status
				where
					report_trade_id = @report_trade_id

				select
					status = "Changed",
					message = "Changed report trade"
			end
			else
			begin
			
				select
					status = "Mismatch",
					message = "Keeping original imported trade",
					activity_date = case when @creation_date != activity_date then "New: " + convert(char(11), @creation_date, 101) + convert(char(8), @creation_date, 8) + "<br/>Old: " + convert(char(11), activity_date, 101) + convert(char(8), activity_date, 8) 
							else convert(char(11), @creation_date, 101) + convert(char(8), @creation_date, 8) end,
					activity = case when @noe_activity != activity then "New: " + rtrim(@noe_activity) + "<br/>Old: " + rtrim(activity) else rtrim(@noe_activity) end,
					external_account_id = case when @external_account_id != external_account_id then "New: " + ltrim(str(@external_account_id)) + "<br/>Old: " + ltrim(str(external_account_id)) else ltrim(str(@external_account_id)) end,
					trade_date = case when @trade_date != trade_date then "New: " + convert(char(11), @trade_date, 101) + convert(char(8), @trade_date, 8) + "<br/>Old: " + convert(char(11), trade_date, 101) + convert(char(8), trade_date, 8) 
							else convert(char(11), @trade_date, 101) + convert(char(8), @trade_date, 8) end,
					ccy_1 = @ccy1,
					ccy_1_quantity = case when @quantity1 != ccy_1_quantity then "New: " + ltrim(str(@quantity1)) + "<br/>Old: " + ltrim(str(ccy_1_quantity)) else ltrim(str(@quantity1)) end,
					nominal_price = case when @rate != nominal_price then "New: " + ltrim(str(@rate)) + "<br/>Old: " + ltrim(str(nominal_price)) else ltrim(str(@rate)) end,
					ccy_2 = @ccy2,
					ccy_2_quantity = case when @quantity2 != ccy_2_quantity then "New: " + ltrim(str(@quantity2)) + "<br/>Old: " + ltrim(str(ccy_2_quantity)) else ltrim(str(@quantity2)) end,
					value_date = @value_date,
					description = case when @description != description then "New: " + rtrim(@description) + "<br/>Old: " + rtrim(description) else rtrim(@description) end,
					spoke_bank = case when @prime_broker != spoke_bank then "New: " + rtrim(@prime_broker) + "<br/>Old: " + rtrim(spoke_bank) else rtrim(@prime_broker) end,
					broker_id = case when @broker_id != broker_id then "New: " + ltrim(str(@broker_id)) + "<br/>Old: " + ltrim(str(broker_id)) else ltrim(str(@broker_id)) end,
					indicators = case when @indicators != indicators then "New: " + rtrim(@indicators) + "<br/>Old: " + rtrim(indicators) else rtrim(@indicators) end,
					lifecycle_status = case when @lifecycle_status != lifecycle_status then "New: " + rtrim(@lifecycle_status) + "<br/>Old: " + rtrim(lifecycle_status) else rtrim(@lifecycle_status) end,
					matching_status = case when @matching_status != matching_status then "New: " + rtrim(@matching_status) + "<br/>Old: " + rtrim(matching_status) else rtrim(@matching_status) end,
					approval_status = case when @approval_status != approval_status then "New: " + rtrim(@approval_status) + "<br/>Old: " + rtrim(approval_status) else rtrim(@approval_status) end,
					allocation_status = case when @allocation_status != allocation_status then "New: " + rtrim(@allocation_status) + "<br/>Old: " + rtrim(allocation_status) else rtrim(@allocation_status) end,
					processing_status = case when @processing_status != processing_status then "New: " + rtrim(@processing_status) + "<br/>Old: " + rtrim(processing_status) else rtrim(@processing_status) end,
					id = case when @id != client_identifier then "New: " + rtrim(@id) + "<br/>Old: " + rtrim(client_identifier) else rtrim(@id) end
				from
					report_trades
				where
					report_trade_id = @report_trade_id
			
			end

		end

	end
	else
	begin
	
		/* 
		 * FAILURE - Tickets
		 */
		
		select
			status = "Failure",
			message = "The identifier " + rtrim(convert(varchar(30), @identifier)) + " already used for a different trade",
            		old_report_trade_id = report_trade_id,
            		old_external_account_id = external_account_id,
            		new_external_account_id = @external_account_id,
            		old_ccy1 = convert(varchar(5), ccy_1),
            		new_ccy1 = convert(varchar(5), @ccy1),
            		old_ccy2 = convert(varchar(5), ccy_2),
            		new_ccy2 = convert(varchar(5), @ccy2),
            		old_broker_id = broker_id,
            		new_broker_id = @broker_id
        		from
            		report_trades
        	where
            		report_trade_id = @report_trade_id
		return
				
	end
	
end
