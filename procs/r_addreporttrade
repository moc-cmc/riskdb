declare @report_commit_id int
declare @report_trade_id int

declare @external_account_symbol varchar(50)

declare @strategy_id int
declare @indicators varchar(50)
declare @description varchar(100)
declare @noop int

declare @issue varchar(250)
declare @subject varchar(250)
declare @content varchar(250)
declare @check_sql varchar(250)

/* ------------------------- MARK: Find definitions ------------------------- */


/* Definition is to set the report date to the next day if the
 * @creation_date is after 17:00. 
 */
select
    @report_date = convert(datetime, convert(varchar(10), 
		case 
        		when datepart(hour, @creation_date) > 17 
		then
            		dateadd(day, 1, @creation_date)
        	else
            		@creation_date end, 101))

select
	@external_report_id = a.external_report_id,
	@source_id = a.source_id,
	@source_name = b.name
from
	external_reports a,
	sources b
where
	a.source_id = b.source_id
and
	a.name = @external_report
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Couldn't find the '" + @external_report + "' report definition"
	return
end

select
	@agency_strategy_id = strategy_id
from	
	strategies
where
	name = "Agency"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Couldn't find the ""Agency"" strategy"
	return
end

/* -------------------------- MARK: Lookup symbols -------------------------- */

select
	@identifier = rtrim(@id) + "-" + rtrim(convert(char(10), convert(datetime, @trade_date), 101)),
    	@broker_identifier = @ticket_num

/* Calculate the status. See the link
 * https://ourwiki.elysiumtechgroup.com/wiki/cantor/Traiana_NOE_Trade_Report for
 * more information. */
select
	@status_name = case
		when @lifecycle_status = "Draft" then
			"Review"
		else
			"Review"
	end
select
	@status_id = status_id
from
	statuses
where
	name = @status_name
if @status_id = null
begin
	select
		status = "Error",
		message = "Couldn't find the status, '" + @status_name + "'"
	return
end



/* 
 * Find the @counterparty_name and @counterparty_id from @counter_party
 */

select
	@counterparty_name = a.name,
	@counterparty_id = a.counterparty_id,
	@external_account_id = a.external_account_id
from
	counterparties a,
	counterparty_symbols b
where
	b.source_id = @source_id
and
	b.symbol = @counter_party
if @counterparty_id = NULL
begin
	select
		@counterparty_name = a.name,
		@counterparty_id = a.counterparty_id,
		@external_account_id = a.external_account_id
	from
		counterparties a
	where
		a.name = @counter_party
	if @counterparty_id = NULL
	begin	
		select
			id = "ERROR",
			error = "Problem determining counterparty from "+@counter_party
		return
	end
	if @external_account_id = NULL
	begin
        	select
                	id = "ERROR",
                	error = "Problem determining external account from counterparty",
			counterparty = @counterparty_name
        	return
	end
end

/* 
 * Find the @external_account_id from @counterparty_id
 */
if @external_account_id = 0
begin
	select
		@external_account_id = a.external_account_id
	from
		external_account_symbols a
	where
		a.symbol = @trading_party and
		a.source_id = @source_id
	if @external_account_id in(NULL, 0)
	begin
		select
			@external_account_id = external_account_id
		from
			external_accounts
		where
			symbol = @trading_party
		if @external_account_id in(NULL, 0)
		begin

			select
				id = "ERROR",
				error = "Problem determining external account from trading party",
				trading_party = @trading_party
			return
		end
	end
end 



select
    	@external_account_type = a.name,
	@external_account_name = b.name
from
	external_account_types a,
	external_accounts b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.external_account_id = @external_account_id
if @external_account_type  = NULL
begin
        select
                id = "ERROR",
                error = "Problem determining external account type",
                external_account = @external_account_name
        return
end

