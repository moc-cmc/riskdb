/* -------------------- MARK: Find the @report_commit_id -------------------- */

/* 
 * Find the @fund from @external_account_id
 */
select
	@fund = a.name
from
	funds a,
	fund_external_accounts b
where
	a.fund_id = b.fund_id
and
	b.external_account_id = @external_account_id
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Couldn't find fund for external account, '" + rtrim(@portfolio) + "'"
/*
    /* Create an issue */
