create table
	#account_roll_spread_groups
(
	external_account_id int,
	external_account varchar(50) NULL,
	roll_spread_group_id int NULL,
	roll_spread_group varchar(25) NULL,
	set_spread_group varchar(10) NULL,
	change_spread_group varchar(10) NULL
)

insert into
	#account_roll_spread_groups(
		external_account_id,
		external_account
	)
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name in("Client", "Master", "Managed")


update
	#account_roll_spread_groups
set
	roll_spread_group_id = c.roll_spread_group_id,
	roll_spread_group = c.name,
	change_spread_group = "CHANGE"
from
	#account_roll_spread_groups a,
	account_roll_spread_groups b,
	roll_spread_groups c
where
	a.external_account_id = b.external_account_id
and
	b.roll_spread_group_id = c.roll_spread_group_id

update 
	#account_roll_spread_groups
set
	set_spread_group = "SET"
where
	change_spread_group = NULL



create table 
	#roll_spread_groups
(
	roll_spread_group_id int,
	name varchar(50),
	style varchar(100) NULL,
	view_details varchar(10) NULL,
	edit_name varchar(10) NULL,
	delete_group varchar(10) NULL
)

create table
	#contract_roll_spreads(
                roll_spread_group_id int,
                contract_id int,
		symbol varchar(10),
                spread float NULL,
		set_spread varchar(10) NULL,
		edit_spread varchar(10) NULL,
		style varchar(50) NULL
)


insert into
	#roll_spread_groups(
		roll_spread_group_id,
		name,
		style,
		view_details,
		edit_name,
		delete_group
)
select
	roll_spread_group_id,
	name,
	"background:#FFFFFF;border: 1px solid white",
	"VIEW",
	"EDIT",
	"DELETE"
from
	roll_spread_groups

if @name != NULL
begin
	select
		@roll_spread_group_id = roll_spread_group_id
	from
		#roll_spread_groups
	where
		name = @name
	if @roll_spread_group_id = NULL
	begin
		select
			status = "Error",
			message = "Problem finding spread group with name",
			name = @name,
			style = "background:#FF9999;border: 1px solid white"
		return
	end
	update
		#roll_spread_groups
	set
		style = "background:#FFFFCC;border: 1px solid white",
		view_details = ""
	where
		roll_spread_group_id = @roll_spread_group_id	

	insert into
		#contract_roll_spreads(
			roll_spread_group_id,
			contract_id,
			symbol,
			style
		)
	select
		@roll_spread_group_id,
		a.contract_id,
		a.symbol,
		"background:#FFFFFF;border: 1px solid white"
	from
		contracts a,
		forwards b,
		products c,
		products d,
		product_types e,
		product_types f
	where
		a.contract_id = b.contract_id
	and
		b.currency_id = c.product_id
	and
		b.product_id = d.product_id
	and
		c.product_type_id = e.product_type_id
	and
		d.product_type_id = f.product_type_id
	and
		e.name = "Currency"
	and
		f.name = "Currency"

	/* Remove inverted pairs */
	delete 
		#contract_roll_spreads
	where
		contract_id in(
				select
					a.contract_id
				from
					contract_price_styles a,
					price_styles b
				where
					a.price_style_id = b.price_style_id
				and
					b.name = "Inverted"
		)
	
	update
		#contract_roll_spreads
	set
		spread = a.spread,
		edit_spread = "EDIT"
	from
		contract_roll_spreads a,
		#contract_roll_spreads b
	where
		a.roll_spread_group_id = b.roll_spread_group_id
	and
		a.contract_id = b.contract_id				
	
	update
		#contract_roll_spreads
	set
		set_spread = "SET"
	where
		edit_spread = NULL

end


select
	section = "Manage Spread Groups",
	add_group = "Add new roll spread group",
	copy_group = "Copy existing spread group"

	
select
	section = "Defined Spread Groups",
        rsg_id=roll_spread_group_id,
        name,
        view_details,
        edit_name,
        delete_group,
	style
from
	#roll_spread_groups
order by
	name

select
	section = "Spread Definitions for "+rtrim(@name),
	spread_group_name=@name,
        symbol,
        spread,
        set_spread,
        edit_spread,
        style
from
	#contract_roll_spreads
order by
	symbol

select
	section = "Assigned Spread Groups",
	style = "background:#FFFFFF;border: 1px solid white",
	external_account,
	roll_spread_group,
	set_spread_group,
	change_spread_group
from
	#account_roll_spread_groups
order by
	external_account
	
	
	
	
