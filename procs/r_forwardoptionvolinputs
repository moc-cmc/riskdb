
if object_id("r_forwardoptionvolinputs") != NULL
    drop procedure
        r_forwardoptionvolinputs
go

create procedure
	r_forwardoptionvolinputs
		@contract_id int,
		@as_of_date datetime
as

declare @underlying_price float
declare @spot_price float
declare @rate_date datetime
declare @expiration datetime
declare @option_price float
declare @hours int
declare @days float
declare @interest_rate float
declare @carry_cost float
declare @product_id int
declare @currency_id int
declare @product_rate float
declare @currency_rate float
declare @underlying_contract_id int
declare @is_committable int
declare @pl_price_type_id int


select
	@expiration = b.expiration,
	@underlying_contract_id = a.underlying_contract_id
from
	options a,
	option_expirations b,
	option_contracts c
where
	a.option_id = b.option_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.contract_id = @contract_id


/* exec
	r_nextbusinessday
		@expiration,
		@rate_date output */
select
	@rate_date = @expiration

exec
	r_nextbusinessday
		@rate_date,
		@rate_date output

exec
	r_contractproduct
		@contract_id,
		@product_id output

exec
	r_contractcurrency
		@contract_id,
		@currency_id output


exec
	r_forwardpriceasof
		@underlying_contract_id,
		@as_of_date,
		@rate_date,
		@days output,
		@spot_price output,
		@underlying_price output,
		@currency_rate output,
		@product_rate output


exec
	f_priceasof
		@contract_id,
		@as_of_date,
		@option_price output,
		@pl_price_type_id output,
		@is_committable output

/* exec
	r_priceasof
		@contract_id,
		@as_of_date,
		@option_price output */

select
	@hours = datediff(hour, @as_of_date, @expiration)
select
	@days = convert(float, @hours) / 24.0


select
	underlying_price = @underlying_price,
	vol_estimate = .2,
	days = @days,
	interest_rate = @currency_rate,
	/* carry_cost = @product_rate, */
	carry_cost = 0.0,
	days_in_year = 360,
	option_price = @option_price

go
