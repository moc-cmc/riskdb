
drop procedure r_batchcommitagency
go


create procedure r_batchcommitagency @begin_date datetime = NULL, @end_date datetime = NULL, @run_name varchar(200) = NULL as

if(@begin_date = NULL)
begin
	 select
		@begin_date = max(trade_date) 
	from 
		run_agency_commits

	select
		@end_date = max(transaction_date)
	from
		int_account_transactions
end


if(@run_name = NULL)
begin
	exec
		r_batchcommitagencydates @begin_date, @end_date
end
else
begin
	exec
		r_batchcommitagencyforrun @run_name, @begin_date, @end_date
end


go

