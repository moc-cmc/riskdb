
create or replace procedure
	mc4_tallybrokerotcmatch
		@login varchar(50),
                @trade_date datetime=NULL,
                @buyer_trader varchar(50),
                @seller_trader varchar(50),
                @dealt_currency varchar(50),
                @counter_currency varchar(50),
                @dealt_amount float,
                @price float,
                @value_date datetime=NULL

as


declare @otc_match_id int


exec
        api_tallybrokerotcmatch
                @login = @login,
                @otc_match_id = @otc_match_id output,
                @trade_date = @trade_date,
                @buyer_trader = @buyer_trader,
                @seller_trader = @seller_trader,
                @dealt_currency = @dealt_currency,
                @counter_currency = @counter_currency,
                @dealt_amount = @dealt_amount,
                @price = @price,
                @value_date = @value_date

if @otc_match_id != NULL
begin
	select
		status = "Success",
		message = "OTC Trade submitted and sent to traders",
		buyer_trader = @buyer_trader,
		seller_trader = @seller_trader,
                dealt_currency = @dealt_currency,
		counter_currency = @counter_currency,
		amount = @dealt_amount,
		otc_match_id = @otc_match_id
end




go
