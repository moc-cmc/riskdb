
if object_id("tt_deletetrades") != NULL
    drop procedure
        tt_deletetrades
go

create procedure
    tt_deletetrades
        @trade_id int,
        @options varchar(50) = NULL
as

create table
    #messages (
        row_count int,
        message varchar(75),
    )

declare @min_deal_id int
declare @min_deal_date datetime
declare @count int

/*
 * CHECK trades: Return if the trade doesn't exist
 */
if not exists( select * from trades where trade_id >= @trade_id )
begin
    select
        status = "Error",
        message = "No trades since trade_id, '" + convert(varchar(10), @trade_id) + "'",
        trade_id = @trade_id
    return
end

if @options not like "%notifications%" and exists( select * from trade_notifications where trade_id >= @trade_id )
begin
    select
        status = "Error",
        message = "Cannot delete trades with trade_notifications without the 'notifications' option",
        trade_id = @trade_id
    return
end

if @options not like "%revals%" and exists( select * from trade_daily_revals where trade_id >= @trade_id )
begin
    select
        status = "Error",
        message = "Cannot delete trades with trade_daily_revals without the 'revals' option",
        trade_id = @trade_id
    return
end

select
    @min_deal_id = min(deal_id)
from
    trades
where
    trade_id >= @trade_id

select
    @min_deal_date = timestamp
from
    deals
where
    deal_id = @min_deal_id

if lower(@options) not like "%i'm sure%" and datediff(hour, @min_deal_date, getdate()) > 24
begin
    select
        status = "Error",
        message = "Cannot delete trades more than 24 hours old without the 'I'm sure' option",
        min_deal_date = @min_deal_date
    return
end


    
/* ------------------- MARK: Delete Deal-level information ------------------ */

delete from
    deal_aliases
where
    deal_id >= @min_deal_id

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "deal_aliases deleted")

delete from
    deal_exec_symbols
where
    deal_id >= @min_deal_id

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "deal_exec_symbols deleted")

delete from
    deal_notes
where
    deal_id >= @min_deal_id

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "deal_notes deleted")

delete from
    deal_notifications
where
    deal_id >= @min_deal_id

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "deal_notifications deleted")

delete from
    deals
where
    deal_id >= @min_deal_id

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "deals deleted")

/* ------------------ MARK: Delete Trade-level information ------------------ */

delete from
    trade_prices
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_prices deleted")

delete from
    trade_spot_references
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_spot_references deleted")

delete from
    trade_matches
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_matches deleted")

delete from
    trade_exec_symbols
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_exec_symbols deleted")

delete from
    trade_aliases
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_aliases deleted")

delete from
    trade_notifications
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_notifications deleted")

delete from
    trade_origin_deals
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_origin_deals deleted")

delete from
    aggregated_trades
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "aggregated_trades deleted")

delete from
    trade_edits
where
    trade_id in (select trade_id from trades where deal_id >= @min_deal_id)

select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trade_edits deleted")

delete from
    trades
where
    deal_id >= @min_deal_id
    
select @count = @@rowcount
if @count > 0
    insert into #messages values(@count, "trades deleted")

select
    *
from
    #messages

go
