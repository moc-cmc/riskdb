
if object_id("cm_addextallocatedspotacct") != NULL
    drop procedure
        cm_addextallocatedspotacct
go

create procedure
	cm_addextallocatedspotacct
		@login varchar(30),
		@account varchar(50),
		@account_type varchar(50),
		@aggregation_style varchar(50),
		@prime_broker varchar(50),
		@credit_limit float
as


declare @fund_id int
declare @external_account_id int
declare @external_account_type_id int
declare @init_external_account_id int
declare @fund_name varchar(50)
declare @internal_account_id int
declare @ext_spot_allocation_id int
declare @remainder_ext_account_id int
declare @run_id int
declare @portfolio_id int
declare @external_accounts int 
declare @evaluation_currency_id int
declare @aggregation_style_id int
declare @prime_broker_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@external_account_type_id = external_account_type_id
from
	external_account_types
where
	name = @account_type
if @external_account_type_id = NULL
begin
	select
		status = "Error",
		message = "External account type not found",
		account_type = @account_type
	return
end

select
	@external_accounts = count(a.external_account_id)
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.instrument_type = "S"
and
	b.fund_id = @fund_id


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id != NULL
begin
	select
		status = "Error",
		message = "Account name already exists",
		account_name = @account
	return
end

select
        @aggregation_style_id = aggregation_style_id
from
        aggregation_styles
where
        name = @aggregation_style
if @@rowcount != 1
begin
        select
                status = "Error",
                message = "Aggregation style not found",
                aggregation_style = @aggregation_style
        return
end

select
        @prime_broker_id = a.prime_broker_id
from
        prime_brokers a,
	sources b
where
        b.name = @prime_broker
if @prime_broker_id = NULL
begin
        select
                status = "Error",
                message = "Prime Broker not found",
                prime_broker = @prime_broker
        return
end



select
	@fund_name = name
from
	funds
where
	fund_id = @fund_id

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @fund_name
if @internal_account_id = NULL
begin
	exec
		j_nextkey
			"internal_accounts",
			@internal_account_id output
	insert into
		internal_accounts
	values(
		@internal_account_id,
		@fund_name,
		@fund_name,
		0)
	insert into
		fund_internal_accounts
	values(
		@fund_id,
		@internal_account_id)
	insert into
		internal_account_views
	values(
		@internal_account_id)
end

exec
	j_nextkey
		"external_accounts",
		@external_account_id output

insert into
        external_accounts(
                external_account_id,
                instrument_type,
                symbol,
                name,
                external_account_type_id,
                internal_account_id,
                evaluation_currency_id,
                aggregation_style_id)
values( 
	@external_account_id,
	"S",
	@account,
	@account,
	@external_account_type_id,
	@internal_account_id,
	@evaluation_currency_id,
	@aggregation_style_id)

insert into
	fund_external_accounts
values(
	@fund_id,
	@external_account_id)

insert into
	external_account_views
		values(
			@external_account_id)
insert into 
	external_account_prime_brokers
		values(	
			@external_account_id,
			@prime_broker_id 
			)

insert into
	ext_account_limits(
		external_account_id,
		currency_id,
		nop_type_id,
		nop_limit,
		dsl_type_id,
		dsl_limit,
		notice_level,
		warning_level,
		blocked_level)
values(
	@external_account_id,
	@evaluation_currency_id,
	NULL,
	NULL,
	NULL,
	@credit_limit,
	.5,
	.75,
	1.0)


if @external_accounts > 0
begin
	select
		@remainder_ext_account_id = remainder_ext_account_id
	from
		external_spot_allocations
	where
		fund_id = @fund_id
	if @remainder_ext_account_id = NULL
	begin
		select
			@remainder_ext_account_id = min(external_account_id)
		from
			external_accounts
		where
			instrument_type = "S"
	end

	exec
		j_nextkey
			"external_spot_allocations",
			@ext_spot_allocation_id output

	insert into
		external_spot_allocations
	values(
		@ext_spot_allocation_id,
		@remainder_ext_account_id,
		@internal_account_id,
		@external_account_id,
		@internal_account_id,
		0.0,
		@fund_id)
end

exec
	j_nextkey
		"runs",
		@run_id output

insert into
	runs
values(
	@run_id,
	@account)
insert into
	run_external_accounts
values(
	@run_id,
	@external_account_id)
insert into
	user_runs
select
	account_id,
	run_id = @run_id
from
	tico_accounts

select
	@internal_account_id = NULL

exec
	j_nextkey
		"internal_accounts",
		@internal_account_id output
insert into
	internal_accounts
values(
	@internal_account_id,
	@account,
	@account,
	0)

insert into
	fund_internal_accounts
values(
	@fund_id,
	@internal_account_id)
insert into
	internal_account_views
values(
	@internal_account_id)

exec
	j_nextkey
		"portfolios",
		@portfolio_id output
insert into
	portfolios
values(
	@portfolio_id,
	@account)
insert into
	portfolio_accounts
values(
	@portfolio_id,
	@internal_account_id)



go
