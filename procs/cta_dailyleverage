create table
	#currency_conversion_rates(
		display_currency_id int NULL,
		currency_id int,
		conversion_rate float NULL)

insert into
	#currency_conversion_rates(
		currency_id)
select
	distinct(
		native_ccy_id)
from
	#allocation


update
	#currency_conversion_rates
set
	display_currency_id = @base_currency_id
update
	#currency_conversion_rates
set
	conversion_rate = 1.0
where
	display_currency_id = currency_id


update
	#currency_conversion_rates
set
	a.conversion_rate = b.price
from
	#currency_conversion_rates a,
	prices b,
	forwards c
where
	a.currency_id = c.product_id
and
	a.display_currency_id = c.currency_id
and
	c.contract_id = b.contract_id
and
	datepart(day, b.price_date) = datepart(day, @date)
and
	datepart(month, b.price_date) = datepart(month, @date)
and
	datepart(year, b.price_date) = datepart(year, @date)


update
	#currency_conversion_rates
set
	a.conversion_rate = 1.0 / b.price
from
	#currency_conversion_rates a,
	prices b,
	forwards c
where
	a.currency_id = c.currency_id
and
	a.display_currency_id = c.product_id
and
	c.contract_id = b.contract_id
and
	datepart(day, b.price_date) = datepart(day, @date)
and
	datepart(month, b.price_date) = datepart(month, @date)
and
	datepart(year, b.price_date) = datepart(year, @date)


update
	#allocation
set
	a.conversion_rate = b.conversion_rate
from
	#allocation a,
	#currency_conversion_rates b
where
	a.native_ccy_id = b.currency_id


update
	#allocation
set
	a.allocation =  a.multiplier * a.quantity * b.price * a.delta,
	a.underlying_price = b.price
from
	#allocation a,
	#prices b
where
	a.underlying_contract_id = b.contract_id



select
	date = @date

select
	external_account,
	product_id,
	product_name,
	contract,
	sector,
	currency,
	buy_sell,
	quantity,
	settle_price,
	multiplier,
	native_allocation = allocation,
	conversion_rate,
	allocation = allocation * conversion_rate,
	market_value,
	difference = market_value - (allocation * conversion_rate),
	contract_id,
	underlying_contract_id,
	delta,
	underlying_price,
	trade_date,
	trade_price
from
	#allocation
where
	allocation != NULL
order by
	external_account,
	product_name



go
