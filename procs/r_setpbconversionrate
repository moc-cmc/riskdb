if object_id("r_setpbconversionrate") != NULL
    drop procedure
        r_setpbconversionrate
go

create procedure
        r_setpbconversionrate
		@login varchar(50),
                @prime_broker varchar(50),
                @symbol varchar(50),
                @price_date datetime,
                @price float,
		@route_to varchar(50)=NULL

as

exec
	r_editpbconversionrate
		@prime_broker = @prime_broker,
		@symbol = @symbol,
		@price_date = @price_date,
		@price = @price

if @route_to = "CFD"
begin
	exec
		ag_closesettlebalancescfd
			@login=@login,
			@settle_date = @price_date
end
if @route_to = "FX"
begin
	exec
		ag_closesettlebalances
			@login=@login,
			@settle_date = @price_date
end
/* If @route_to isnt provided, dont route anywhere */

go

