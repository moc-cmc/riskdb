
if object_id("cm_addtradersymbol") != NULL
    drop procedure
        cm_addtradersymbol
go

create procedure
	cm_addtradersymbol
		@login varchar(50),
		@trader varchar(50),
		@source varchar(50),
		@mapping varchar(100)
as


declare @source_id int
declare @trader_id int
declare @mappings int

select 
        @trader = ltrim(rtrim(@trader))

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Trader not found",
		trader = @trader
	return
end

/* CDO: Jan 12, 2011 -- Dropping constraint to only allow one mapping for a
                        trader from a given source. Incoming mappings can 
                        have many symbols from the same trader. Outbound mappings
                        need to be 1:1. This needs to be manually managed.

select
	@mappings = count(*)
from
	trader_symbols
where
	trader_id = @trader_id
and
	source_id = @source_id

if @mappings > 0
begin
	select
		status = "Error",
		message = "Trader is already mapped for mapping source",
		trader= @trader,
		source = @source
	return
end
*/

insert into
	trader_symbols
values(
	@trader_id,
	@source_id,
	@mapping)

exec
	cm_tradermappings
		@login,
		@trader

go
