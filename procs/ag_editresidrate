drop procedure
	ag_editresidrate
go

create procedure
	ag_editresidrate
		@login varchar(50),
		@pair varchar(50),
		@value_date datetime,
		@rate numeric(30,8)
as


declare @contract_id int
declare @defined_resid_rate_id int
declare @price_style varchar(50)


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @pair
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Pair not found",
		pair = @pair
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id
if @price_style = "Inverted"
	select
		@rate = 1.0 / @rate

update
	defined_resid_rates
set
	rate = @rate
where
	contract_id = @contract_id
and
	convert(date, value_date) = convert(date, @value_date)
if @@rowcount = 0
begin
	exec
		j_nextkey
			"defined_resid_rates",
			@defined_resid_rate_id output

	insert into
		defined_resid_rates(
			defined_resid_rate_id,
			contract_id,
			value_date,
			rate)
	values(
		@defined_resid_rate_id,
		@contract_id,
		@value_date,
		@rate)
end

exec
	ag_residrates
		@login = @login,
		@value_date = @value_date

go

	

	
