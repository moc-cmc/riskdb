	#output a,
	contracts b
where
	a.contract = b.symbol

update
	#output
set
	a.mapping = b.symbol
from
	#output a,
	contract_symbols b
where
	a.source_id = b.source_id
and
	a.contract_id = b.contract_id



select
	section = "Mappings",
	style = "background:#FFFFFF;border: 1px solid white",
	contract,
	source,
	mapping,
	edit_mapping = "Edit"
from
	#output
