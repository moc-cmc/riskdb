use
	risk_cc
go

drop procedure
        mc_tallyoptionsprem
go

create procedure
	mc_tallyoptionsprem
		@login char(25),
		@buy_sell varchar(20),
		@counterparty varchar(50),
		@quantity numeric(30,4),
		@biproduct varchar(50),
		@timezone varchar(25),
		@expiration datetime,
		@option_settledate datetime,
		@strike numeric(30,4),
		@call_put varchar(5),
		@implied_volatility float,
		@spot_reference float,
		@total_premium float,
		@conversion_rate float,
		@premium_settle datetime
as

declare @external_account varchar(50)
declare @pips_price float
declare @contract_id int
declare @symbol varchar(50)
declare @trade_id int
declare @deal_id int
declare @trade_date datetime
declare @tally_type varchar(20)
declare @sales_code varchar(50)
declare @native_premium float
declare @price_style varchar(50)
declare @underlying_contract_id int
declare @true_conversion_rate float
declare @premium_currency varchar(50)
declare @fund_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@premium_currency = a.symbol
from
	products a,
	funds b
where
	a.product_id = b.evaluation_currency_id
and
	b.fund_id = @fund_id
if @premium_currency = NULL
begin
	select
		status = "Error",
		message = "Default premium currency not found"
	return
end



select
	@underlying_contract_id = contract_id
from
	contracts
where
	symbol = @biproduct
if @underlying_contract_id = NULL
begin
	select
		status = "Error",
		message = "Biproduct not found",
		biproduct = @biproduct
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @underlying_contract_id
if @price_style = "Inverted"
	select
		@true_conversion_rate = 1.0 / @conversion_rate
else
	select
		@true_conversion_rate = @conversion_rate


select
	@native_premium = @total_premium * @true_conversion_rate

select
	@pips_price = @native_premium / @quantity


select
	@tally_type = "Option",
	@sales_code = "None"

select
	@trade_date = getdate()

select
	@external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end



if @buy_sell = "Buy"
begin
	select
		@quantity = abs(@quantity)
end
if @buy_sell = "Sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end

exec
	r_spotoptioncontract
		@biproduct,
		@timezone,
		@expiration,
		@call_put,
		@strike,
		@option_settledate,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

/* select
	login = @login,
	source = "MPT Manual Tally",
	trade_id = @trade_id,
	deal_id = @deal_id,
	tally_type = @tally_type,
	deal_type = "Market Option",
	trade_type = "Option",
	external_account = @external_account,
	counterparty = @counterparty,
	quantity = @quantity,
	symbol = @symbol,
	value_date = @option_settledate,
	price = @pips_price,
	trade_date = @trade_date,
	sales_code = @sales_code,
	premium = @total_premium,
	premium_currency = @premium_currency,
	prem_settle_date = @premium_settle,
	spot_reference = @spot_reference
*/

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Market Option",
		@trade_type = "Option",
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @option_settledate,
		@price = @pips_price,
		@trade_date = @trade_date,
		@sales_code = @sales_code,
		@premium = @total_premium,
		@premium_currency = @premium_currency,
		@prem_settle_date = @premium_settle,
		@spot_reference = @spot_reference

exec r_inserttradenotification @trade_id

select
	@implied_volatility = @implied_volatility / 100.00

exec
	r_initializeoptcontract
		@symbol,
		@implied_volatility



exec
	r_inspectdealtrades
		@login,
		@deal_id



go
