
if object_id("d_futureposplfordate") != NULL
    drop procedure
        d_futureposplfordate
go

  
create procedure
	d_futureposplfordate
		@contract_id int,
		@quantity numeric(30,2),
		@begin_date datetime,
		@end_date datetime,
		@open_price float output,
		@begin_value float output,
		@close_price float output,
		@end_value float output,
		@p_l float output
		
as

declare @multiplier float

exec
	r_priceasof
		@contract_id,
		@begin_date,
		@open_price output

exec
	r_priceasof
		@contract_id,
		@end_date,
		@close_price output



select
	@multiplier = a.quantity
from
	futures a,
	future_contracts b
where
 
 	b.contract_id = @contract_id
and
	a.future_id = b.future_id

select
	@begin_value = @open_price * @quantity * @multiplier,
	@end_value = @close_price * @quantity * @multiplier

select
	@p_l = @end_value - @begin_value


return


go
