drop procedure
	api_setaccountcollateralval
go

create procedure
	api_setaccountcollateralval
		@login varchar(50),
		@source varchar(50),
		@account varchar(50),
		@trade_date datetime,
		@market_value float

as


declare @fund_id int
declare @evaluation_currency_id int
declare @external_account_id int
declare @collateral_product_id int
declare @external_accounts int

declare @contract_id int
declare @source_id int
declare @price_date datetime
declare @price_type_id int
declare @price_id int
declare @status_id int


select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = @source
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "Uncommitted"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Uncommitted status not found"
	return
end

select
	@price_type_id = price_type_id
from
	price_types
where
	name = "Close"
if @price_type_id = NULL
begin
	select
		status = "Error",
		message = "Close price type not found"
	return
end

select
	@price_date = convert(datetime, convert(date, @trade_date))

select
	@price_date = dateadd(hour, 17, @price_date)

exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Cannot determine evaluation currency"
	return
end

select
	@external_account_id = min(external_account_id)
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

select
	@collateral_product_id = collateral_product_id
from
	external_accounts
where
	external_account_id = @external_account_id
if @collateral_product_id = NULL
begin

	exec
		api_initcollateralproduct
			@login = @login,
			@external_account = @account,
			@trade_date = @trade_date,
			@product_id = @collateral_product_id output,
			@contract_id = @contract_id output

end
else
begin
	select
		@contract_id = contract_id
	from
		forwards
	where
		product_id = @collateral_product_id
	and
		currency_id = @evaluation_currency_id
	if @contract_id = NULL
	begin
		select
			status = "Error",
			message = "No collateral contract found for account",
			external_account = @account
		return
	end
end

update
	bo_spot_settles
set
	price = @market_value
where
	contract_id = @contract_id
and
	source_id = @source_id 
and
	price_date = @price_date
if @@rowcount = 0
begin
	insert into
		bo_spot_settles(
			contract_id,
			source_id,
			price_date,
			price)
	values(
		@contract_id,
		@source_id,
		@price_date,
		@market_value)
end

update
	prices
set
	price = @market_value
where
	contract_id = @contract_id
and
	price_date = @price_date
if @@rowcount = 0
begin
	exec
		j_nextkey
			"prices",
			@price_id output

	insert into
		prices(
			price_id,
			status_id,
			contract_id,
			price_date,
			price_type_id,
			price)
	values(
		@price_id,
		@status_id,
		@contract_id,
		@price_date,
		@price_type_id,
		@market_value)
end

update
	current_prices
set
	price = @market_value
where
	contract_id = @contract_id
if @@rowcount = 0
begin
	insert into
		current_prices(
			contract_id,
			price,
			timestamp)
	values(
		@contract_id,
		@market_value,
		getdate())
end


go
