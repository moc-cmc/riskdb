

if object_id("b_contractdelta") != NULL
    drop procedure
        b_contractdelta
go

create procedure
	b_contractdelta
		@run_id int,
		@as_of_date datetime,
		@contract_id int,
		@position numeric(30,6),
		@perspective_contract_id int output,
		@delta float output
as

declare @product_id int
declare @perspective_product_id int
declare @correlation float
declare @instrument char(50)
declare @is_inverted int

declare @cm float /* Contract Multiplier */
declare @pcm float /* Perspective Contract Multiplier */
declare @cp float /* Contract Price */
declare @pcp float /* Perspective Contract Price */

/* select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @contract_id
if @instrument = "Exotic"
begin
	exec
		r_exoticcontractdelta
			@run_id,
			@contract_id,
			@position,
			@as_of_date,
			@perspective_contract_id output,
			@delta output
	return 
end */


exec
	b_perspectivecontract
		@run_id,
		@contract_id,
		@perspective_contract_id output,
		@is_inverted output



exec
	r_biproductcorrelation
		@product_id,
		@perspective_product_id,
		@as_of_date,
		@correlation output

exec
	r_contractquantity
		@perspective_contract_id,
		@pcm output

exec
	r_contractquantity
		@contract_id,
		@cm output

exec
	r_contractprice
		@contract_id,
		@as_of_date,
		@cp output

exec
	r_contractprice
		@perspective_contract_id,
		@as_of_date,
		@pcp output

if @is_inverted = 0
begin
	if @pcm != 0 and @pcp != 0
		select
			@delta = @position * (@cm / @pcm) * (@cp / @pcp)
	/* else
		select
			pcm = @pcm,
			pcp = @pcp  TEST */
end
else
begin
	select
		@delta = @position * (@cm / @pcm) * -1.0 * (1.0 / @pcp)
end


go
