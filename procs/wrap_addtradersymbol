
drop procedure
	wrap_addtradersymbol
go

create procedure
	wrap_addtradersymbol
		@login varchar(25),
		@name varchar(50),
		@symbol varchar(50),
		@source varchar(100)
as

exec
	api_addtradersymbol
		@login=@login,
		@name=@name,
		@symbol=@symbol,
		@source=@source

exec
	r_mappingoverview
		@login=@login

return

go

	
