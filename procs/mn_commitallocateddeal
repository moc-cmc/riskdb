drop procedure
	mn_commitallocateddeal
go

create procedure
	mn_commitallocateddeal
		@login varchar(50),
		@run_name varchar(50),
		@deal_id int
as

declare @external_account varchar(50)
declare @external_account_id int
declare @orginal_quantity numeric(30,4)
declare @is_allocated varchar(1)




select
	@external_account = a.symbol,
	@orginal_quantity = c.quantity

from
	external_accounts a,
	external_account_types b,
	trades c
where
	a.external_account_type_id = b.external_account_type_id
and
	a.external_account_id = c.external_account_id
and
	c.deal_id = @deal_id
and
	b.name = "Master"

exec
	cn_validateaccountaccess
		@login,
		@external_account,
		@external_account_id output

if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Deal not found"
	return
end


select
	@is_allocated = "Y"
from
	deal_ma_versions
where
	deal_id = @deal_id

if @is_allocated != "Y"
begin
	insert into
		deal_ma_versions
	values(
		@deal_id,
		@orginal_quantity,
		0,
		getdate())
end

exec
	mn_setdealstatus
		@login,
		@deal_id,
		"Committed"

exec
	mn_accounttrades
		@login,
		@run_name


go
