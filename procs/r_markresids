drop procedure
	r_markresids
go


create procedure
	r_markresids
		@login varchar(30)

as


declare @resid_status_id int
declare @resid_counterparty_id int

select
	@resid_status_id = status_id
from
	statuses
where
	name = "Resid"
if @@rowcount != 1
begin
	select
		msg = "No status_id from Resid"
	return
end


select
	@resid_counterparty_id = counterparty_id
from
	counterparties
where
	name = "BAML-BOARES"
if @@rowcount != 1
begin
        select
                msg = "No counterparty 'BAML-BOARES'"
        return
end


create table
	#resids(
		trade_id int
	)

insert into
	#resids
select
	trade_id
from
	trades
where
	counterparty_id = @resid_counterparty_id
and
	status_id != @resid_status_id


update 
	trades
set
	status_id = @resid_status_id
from
	trades a,
	#resids b
where
	a.trade_id = b.trade_id


select
	msg = "Success",
	trade_id = trade_id
from
	#resids


go
