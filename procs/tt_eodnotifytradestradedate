create or replace procedure
	tt_eodnotifytradestradedate
		@source varchar(50),
		@trade_date datetime=NULL,
		@query_options char(1)=NULL,
		@query_futures char(1)=NULL,
		@format_swaps char(1)=NULL,
		@format_ndf_swaps char(1)=NULL,
		@mark_to_market char(1)=NULL
as



/* 
 *  tt_notifytradestradedate will run 5pm to 5pm 
 *  This proc will provide a trade date so you can run 12pm tp 12pm so you can call a notify after 5pm est for the previous day
 */
declare @hour int

if @trade_date = NULL
begin
	select 
		@trade_date = getdate()
        select
		@hour = datepart(hour, @trade_date)

	if @hour < 14 
	begin
		select
			"status" = "Error",
			"message" = "Must call between 2pm and 11:59:59pm EST if not providing explicit trade date"
		return
	end
	select
		@trade_date = convert(date, @trade_date)

end

exec
        tt_notifytradestradedate
                @source=@source,
                @trade_date=@trade_date,
                @query_options=@query_options,
                @query_futures=@query_futures,
                @format_swaps=@format_swaps,
                @format_ndf_swaps=@format_ndf_swaps,
                @mark_to_market=@mark_to_market



go 
