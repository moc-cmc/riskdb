
if object_id("r_currentproductrateid") != NULL
    drop procedure
        r_currentproductrateid
go

create procedure
	r_currentproductrateid
		@product_id int,
		@product_rate_id int output
as

declare @most_recent_product_rate_id int

select
	@product_rate_id = product_rate_id
from
	current_product_rates
where
	product_id = @product_id

if @product_rate_id != NULL
	return

select
	@most_recent_product_rate_id = product_rate_id
from
	product_rates
where
	product_id = @product_id
and
	rate_date = (
		select
			max(rate_date)
		from
			product_rates
		where
			product_id = @product_id)

if @most_recent_product_rate_id = NULL
	return

exec
	j_nextkey
		"current_product_rates",
		@product_rate_id output

insert into
	current_product_rates
values(
	@product_rate_id,
	@product_id)

insert into
	current_product_rate_points
select
	product_rate_id = @product_rate_id,
	days,
	rate
from
	product_rate_points
where
	product_rate_id = @most_recent_product_rate_id

go
