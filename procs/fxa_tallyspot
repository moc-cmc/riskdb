
if object_id("fxa_tallyspot") != NULL
    drop procedure
        fxa_tallyspot
go

create procedure
	fxa_tallyspot
		@login char(25),
		@account_id int,
		@contract_id int,
		@trader_id int,
		@broker_id int,
		@strategy_id int,
		@external_account_id int,
		@internal_account_id int,
		@status_id int,
		@buysell char(10),
		@quantity numeric(30,2),
		@price float,
		@value_date datetime = NULL

as

/* REWRITE IF NEEDED 
declare @trade_quantity numeric(30,2)
declare @trade_id int
declare @deal_id int
declare @trade_date datetime
declare @day varchar(4)
declare @month varchar(4)
declare @year varchar(4)
declare @datestring char(20)
declare @fund_id int
declare @trade_price float 
declare @price_style char(30)
declare @inverted_contract_id int
declare @pip_adjustment float
declare @market_rate float
declare @source_id int
declare @trade_symbol_id int

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)

insert into
	#links
values(
	"Column Link",
	"run_name",
	"Intraday P&L",
	NULL)

select * from #links

select
	@source_id = source_id
from
	sources
where
	name = "MPT Manual Tally"

if @@rowcount != 1
begin
	select
		id=-1,
		error="Could not find source_id for source MPT Manual Tally"
	return -1
end
		
select
	@trade_price = convert(numeric(30,6), @price)

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

if @fund_id = NULL
begin
	select
		id = -1,
		error = "Problem finding default fund for user"
	return -1
end

if convert(char(1), lower(@buysell)) = "s"
begin
        select
                @quantity = abs(@quantity) * -1
end

if convert(char(1), lower(@buysell)) = "b"
begin
        select
                @quantity = abs(@quantity)
end

select
	@trade_date = getdate()

/* The pip adjustment */
select
        @pip_adjustment = adjustment
from
        pip_adjustments
where
        fund_id = @fund_id
and
        broker_id = @broker_id
and
        contract_id = @contract_id
if @@rowcount = 0
        select
                @pip_adjustment = 0

select
        @price_style = a.name
from
        price_styles a,
        contract_price_styles b
where
        a.price_style_id = b.price_style_id
and
        b.contract_id = @contract_id

if @price_style = "Inverted"
begin
        select
                @market_rate = 1.0 / @trade_price

        if @quantity > 0
        begin
                select
                        @trade_price = @trade_price + @pip_adjustment
        end
        if @quantity < 0
        begin
                select
                        @trade_price = @trade_price - @pip_adjustment
        end

        select
                @trade_price = 1.0 / @trade_price
end
else
begin
        select
                        @market_rate = @trade_price

        if @quantity > 0
        begin
                select
                        @trade_price = @trade_price + @pip_adjustment
        end
        if @quantity < 0
        begin
                select
                        @trade_price = @trade_price - @pip_adjustment
        end
end

/* end pip adjustment */

if @value_date = NULL
begin
	exec
		r_contractvaluedate
			@contract_id,
			@trade_date,
			@value_date output

end
else
begin
	select
		@day = convert(varchar(4), datepart(day, @value_date)),
		@month = convert(varchar(4), datepart(month, @value_date)),
		@year = convert(varchar(4), datepart(year, @value_date))

	select
		@datestring = rtrim(@month) + "/" + rtrim(@day) + "/" + rtrim(@year)

	select
		@value_date = convert(datetime, @datestring)
end

/*
if @value_date < @trade_date
begin
	select
		id = -1,
		error = "Value date is before trade date",
		value_date = @value_date,
		trade_date = @trade_date
	return -1
end
*/

begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "deals"
	select
		@deal_id = last_id
	from
		keys
	where
		relation = "deals"
commit tran

insert into
	deals
values(
	@deal_id,
	getdate())

begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "trades"
	select
		@trade_id = last_id
	from
		keys
	where
		relation = "trades"
commit tran

insert into
	trades
values(
	@trade_id,
	@deal_id,
	@account_id,
	@internal_account_id,
	@external_account_id,
	@quantity,
	@contract_id,
	@trade_price,
	@trade_date,
	@trader_id,
	@strategy_id,
	1,
	@broker_id)
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem adding trade"
	rollback tran
	return -1
end

insert into
        trade_types
(trade_id,
 trade_type)
 values
(@trade_id,
 "S")
if @@rowcount < 1
begin
        select
                id=-1,
                error="Could not add trade type"
        rollback tran
        return -1
end

commit tran

insert into
	trade_value_dates
values(
	@trade_id,
	@value_date)

insert into
	trade_prices
values(
	@trade_id,
	@market_rate,
	getdate())

exec j_nextkey "trade_symbols", @trade_symbol_id output

insert into
    trade_symbols
values
    (
    @trade_symbol_id,
    @source_id,
    @deal_id,
    convert(char(100), @trade_id),
    getdate())

insert into
	trade_identifiers
values(
	@trade_id,
	@source_id,
	convert(varchar(50), @trade_id))

insert into
    trade_notifications
    (source_id,
     trade_id,
     status_id,
     capture_date,
     notify_date,
     error)
values
    (1,
     @trade_id,
     @status_id,
     getdate(),
     getdate(),
     "")


	return @deal_id	 */

go
