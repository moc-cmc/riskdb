
if object_id("r_addfwdsubscription") != NULL
    drop procedure
        r_addfwdsubscription
go

create procedure
	r_addfwdsubscription
		@login varchar(50),
		@symbol varchar(50),
		@dealt_currency varchar(30),
		@counter_currency varchar(30),
		@evaluation_currency varchar(30)
as


declare @db_name varchar(30)
declare @servername varchar(30)
declare @sql_string varchar(255)

select
	@db_name = db_name(),
	@servername = @@servername
	


/* -----changing to use sp_remotesql
exec
        SYB0101.contracts.dbo.ct_addfwdsubscription
		@login,
		@db_name,
		@servername,
		@symbol,
		@dealt_currency,
		@counter_currency,
		@evaluation_currency
*/
select
	@sql_string = "exec contracts.dbo.ct_addfwdsubscription '" +
		rtrim(@login)+"', '"+
		rtrim(@db_name)+"', '"+
		rtrim(@servername)+"', '"+
		rtrim(@symbol)+"', '"+
		rtrim(@dealt_currency)+"', '"+
		rtrim(@counter_currency)+"', '"+
		rtrim(@evaluation_currency)+ "'"

exec
	sp_remotesql
		"CONTRACTS",
		@sql_string



/* -----changing to use sp_remotesql
exec
        SYB0101.contracts.dbo.ct_forwards
                @login,
		@db_name,
		@servername,
		@evaluation_currency
*/

select
	@sql_string = ""
select
        @sql_string = "exec contracts.dbo.ct_forwards '" +
                rtrim(@login)+"', '"+
                rtrim(@db_name)+"', '"+
                rtrim(@servername)+"', '"+
                rtrim(@evaluation_currency)+ "'"

exec
        sp_remotesql
                "CONTRACTS",
                @sql_string


go
