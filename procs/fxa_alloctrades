/*
| QUERY for DEAL
*/


insert into
	#queued_alloc_trades
(
		section,
		t_or_d,
        	trade_id,
		deal_id,
        	contract_id,
        	broker_id,
        	trader_id,
		external_account_id,
		master_external_account_id,
		counterparty_id,
        	strategy_id,
        	quantity,
        	price,
        	value_date,
		identifier,
        	spot_price,
        	trade_date,
		status_id,
		style,
		edit_trade,
		sales_code_id
)
select
	"Pending Allocation",
	't',
	a.trade_id,
	a.deal_id,
	a.contract_id,
	a.broker_id,
	a.trader_id,
	a.external_account_id,
	a.master_external_account_id,
	a.counterparty_id,
	a.strategy_id,
	a.quantity,
	a.price,
	a.value_date,
	a.identifier,
	a.spot_reference,
	a.trade_date,
	a.status_id,
	style = "color:gray;background:#FFFFFF",
	edit_trade="EDIT",
	a.sales_code_id
from
	queued_alloc_trades a,
	#traders d,
	#brokers f,
	#counterparties e,
	#external_accounts g,
	#internal_accounts h
where
	a.internal_account_id = h.internal_account_id
and
	a.counterparty_id = e.counterparty_id
and
	a.external_account_id = g.external_account_id
and
	a.trader_id = d.trader_id
and
	a.broker_id= f.broker_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date

/*
| Set trading day to EST 17:00-17:00 market standard
*/
update
	#queued_alloc_trades
set
	trade_date = case
		when a.trade_date > convert(char(8), getdate(), 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 112))
		else
			convert(char(12), a.trade_date, 112)
	end
from
	#queued_alloc_trades a


update
	#queued_alloc_trades
set
	acct_type = c.name
from
	#queued_alloc_trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id

update
	#queued_alloc_trades
set
	allocation = b.allocation
from
	#queued_alloc_trades a,
	sub_accounts b
where
	a.external_account_id = b.external_account_id



