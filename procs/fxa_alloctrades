
create or replace procedure
	fxa_alloctrades
		@login varchar(30),
		@deal_id int=NULL,
		@run_name varchar(50)=NULL,
		@trade_date datetime=NULL,
		@show_processed char(1)=NULL
as


declare @run_id int
declare @begin_date datetime
declare @end_date datetime
declare @begin_day_string varchar(25)
declare @end_day_string varchar(25)

declare @review_status_id int
declare @committed_status_id int
declare @inactive_status_id int
declare @working_status_id int

declare @processed_count int
declare @pending_count int
declare @working_count int
declare @admin varchar(1)
declare @tico_account_id int
declare @enabled_product_features varchar(50)

select
        @enabled_product_features = name
from
        enabled_product_features
where
        name in("Trade Allocation")
if @@rowcount != 1
begin
        select
                run_name = "<b>Trade Allocation</b>" + " must be enabled to view this report. Please contact " + '<a href="mailto:sales@elysiumtechgroup.com">' + 'sales@elysiumtechgroup.com</a>'  + " for more information regarding these feature sets."
        return
end


select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login

if @run_name = NULL
begin
	select
        	@admin = "Y"
	from
        	access_groups a,
        	access_group_accounts b
	where
        	a.access_group_id = b.access_group_id
	and
        	a.name = "Admin"
	and
        	b.tico_account_id = @tico_account_id
	
	
	if @admin =  "Y"
	begin
        	select
                	@run_name = name
        	from
                	funds
	end
	
	if @admin = NULL
	begin
        	select
                	@run_name = a.symbol
        	from
                	external_accounts a,
                	trades b,
                	external_account_types c
        	where
                	a.external_account_id = b.external_account_id
        	and
                	b.deal_id = @deal_id
        	and
                	a.external_account_type_id = c.external_account_type_id
        	and
                	c.name = "Master"
	end
end


select
	@review_status_id = status_id
from
	statuses
where
	name = "Review"
if @review_status_id = NULL
begin
        select
                error="Error",
                msg="Problem finding 'Review' status"
        return
end

select
        @inactive_status_id = status_id
from
        statuses
where
        name = "Inactive"
if @inactive_status_id = NULL
begin
        select
                error="Error",
                msg="Problem finding 'Inactive' status"
        return
end

select 
        @committed_status_id = status_id
from
        statuses 
where
        name = "Committed"
if @committed_status_id = NULL
begin
	select
		error="Error",
		msg="Problem finding 'Committed' status"
	return
end

select
        @working_status_id = status_id
from
        statuses
where
        name = "Working"
if @working_status_id = NULL
begin
        select
                error="Error",
                msg="Problem finding 'Working' status"
        return
end



select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1 and @run_name != NULL
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end


/*
| DATE determination
*/
select
	@begin_date = @trade_date

if @begin_date = NULL
	select
		@begin_date = getdate()

if datepart(hour, @begin_date) >= 17
	exec
		r_nextbusinessday
			@begin_date,
			@begin_date output

select
	@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
		convert(char(2), datepart(day, @begin_date)) + "/" +
		convert(char(4), datepart(year, @begin_date))
select
	@begin_date = convert(datetime, @begin_day_string)
exec
	r_prevbusinessday
		@begin_date,
		@begin_date output
select
	@begin_date = dateadd(hour, 17, @begin_date)
	
exec
	r_nextbusinessday
		@begin_date,
		@end_date output

select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
