        	value_date,
        	trade_date,
		status_id,
		style,
		select_deal,
		allocate,
		tally_deal,
		allocation_deal_id,
		trade_type,
		master_account_qty,
		sales_code_id
)
select
	"Pending Allocation",
	'd',
	a.deal_id,
	a.contract_id,
	a.broker_id,
	a.counterparty_id,
	a.master_external_account_id,
	quantity=sum(a.quantity),
	remaining_qty = sum(a.quantity),
	a.price,
	allocation=sum(allocation),
	a.value_date,
	a.trade_date,
	a.status_id,
	style="background:#CCFFCC",
	select_deal = "SELECT",
	allocate = "ALLOCATE",
	tally_deal = "TALLY DEAL",
	allocation_deal_id = convert(varchar(50), a.deal_id),
	trade_type = "Spot",
	master_account_qty = convert(varchar(50), convert(numeric(30,2), sum(a.quantity))),
	sales_code_id
from
	#queued_alloc_trades a
group by
        a.deal_id,
        a.master_external_account_id,
        a.contract_id,
        a.broker_id,
        a.counterparty_id,
	a.value_date,
	a.trade_date,
	a.status_id,
	a.price,
	a.sales_code_id,
	a.remaining_qty



