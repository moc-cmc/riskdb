drop procedure
	r_tradeidforidentifierpbcustcl
go

create procedure
	r_tradeidforidentifierpbcustcl
		@broker varchar(50),
		@trade_identifier varchar(100)

as 

declare @broker_id int
declare @trade_id int
declare @market_trade_id int
declare @booking_id int

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @broker_id = NULL
begin
	select
		status = "Error",
		message = "Broker not found"
	return
end

select
	@trade_id = trade_id
from
	trades
where
	broker_id = @broker_id
and
	identifier = rtrim(@trade_identifier)+".c"

if @trade_id = NULL
begin
	return
end

select
	@booking_id = booking_id
from
	trade_bookings
where
	trade_id = @trade_id

select 
	@market_trade_id = trade_id
from
	trade_bookings
where
	booking_id = @booking_id
and
	trade_id != @trade_id


select
	client_trade_id = @trade_id,
	market_trade_id = @market_trade_id

go



