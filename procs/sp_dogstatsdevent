drop procedure	
	sp_dogstatsdevent
go

create procedure
	sp_dogstatsdevent
		@event_title varchar(50),
		@event_text varchar(200),
		@aggregation_key varchar(50)=NULL,
		@priority varchar(10)=NULL,
		@alert_type varchar(10)=NULL,
		@tags varchar(255)=NULL

as

/* chriso: 2018-07-07 - https://docs.datadoghq.com/developers/dogstatsd/datagram_shell/#metrics */


declare @result int
declare @message varchar(255)
declare @title_length int
declare @text_length int

select
	@title_length = len(@event_title),
	@text_length = len(@event_text)

if @priority not in("low", "normal")
begin
	select
		@priority = "low"
end	

if @alert_type not in("info", "error", "warning", "success")
begin
	select
		@alert_type = "info"
end

if @tags = NULL
begin
	select
		@tags = "db:"+db_name()
end
else
begin
	select
		@tags = rtrim(@tags)+",db:"+db_name()
end

select
	@message = "_e{"+  convert(varchar(4), @title_length)
			+","+ convert(varchar(4), @text_length)
			+"}:"+ rtrim(@event_title)
			+"|"+ rtrim(@event_text)

if @aggregation_key != NULL
begin
	select
		@message = rtrim(@message)+"|k:"+rtrim(@aggregation_key)
end
	
select
	@message = rtrim(@message)
			+"|p:"+ rtrim(@priority)
			+"|t:"+ rtrim(@alert_type)
			+"|#"+ rtrim(@tags)

select
	@result = syb_sendmsg("localhost", 8125, @message)


go
