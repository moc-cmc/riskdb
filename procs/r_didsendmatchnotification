
if object_id("r_didsendmatchnotification") != NULL
    drop procedure
        r_didsendmatchnotification
go

create procedure
	r_didsendmatchnotification
		@match_notification_id int,
        	@status varchar(25),
        	@error varchar(250)
as

declare @status_id int
declare @sent_status_id int

select
    @sent_status_id = status_id,
    @status_id = status_id
from
    statuses
where
    name = 'Sent'
if @status_id = null
begin
    select
        id = -1,
        err = "No status named, 'Sent'"
    return
end

if @status != null
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name = @status
    if @status_id = null
    begin
        select
            id = -1,
            err = "No status named, '" + @status + "'"
        return
    end
    
    if @status_id != @sent_status_id
        select
            @status_id = @status_id
end

update
    match_notifications
set
    status_id = @status_id,
    error = @error,
    notify_date = getdate()
where
    match_notification_id = @match_notification_id

go
