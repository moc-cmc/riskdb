
create or replace procedure
	r_didsendmatchnotification
		@match_notification_id int,
		@status varchar(25),
		@error varchar(250)
as

declare @status_id int
declare @record_status_id int

select
	@status_id = status_id
from
	statuses
where
	name = @status
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding status",
		status_provided = @status
	return
end

select
	@record_status_id = status_id
from
	match_notifications
where
	match_notification_id = @match_notification_id
if @record_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding match notification",
		match_notification_id = @match_notification_id
	return
end

/* Do nothing if the status is already in proper state */
if @record_status_id = @status_id
begin
	return
end

begin tran
	update
		match_notifications
	set
		status_id = @status_id,
		error = @error,
		notify_date = getdate()
	where
		match_notification_id = @match_notification_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem marking status on match notification",
			match_notification_id = @match_notification_id
		rollback tran
		return
	end
commit tran

go
