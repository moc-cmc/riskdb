
if object_id("cm_edittallydefaults") != NULL
    drop procedure
        cm_edittallydefaults
go

create procedure
	cm_edittallydefaults
		@login varchar(50),
		@user_name varchar(50),
		@tally_type varchar(50),
		@internal_account varchar(50),
		@external_account varchar(50),
		@trader varchar(25),
		@strategy varchar(50),
		@status varchar(100),
		@broker varchar(50),
		@counterparty varchar(50)
as


declare @tico_account_id int
declare @tally_type_id int
declare @internal_account_id int
declare @external_account_id int
declare @trader_id int
declare @strategy_id int
declare @status_id int
declare @broker_id int
declare @counterparty_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @user_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "User name not found",
		user_name = @user_name
	return
end

select
	@tally_type_id = tally_type_id
from
	tally_types
where
	name = @tally_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Tally type not found",
		tally_type = @tally_type
	return
end

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @internal_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Internal account not found",
		inernal_account = @internal_account
	return
end


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "External account not found",
		external_account = @external_account
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Trader not found",
		trader = @trader
	return
end

select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Strategy not found",
		strategy = @strategy
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = @status
if @@rowcount != 1
begin
        select
                status = "Error",
                message = "Status not found",
                stat = @status
        return
end

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Broker not found",
		broker = @broker
	return
end

select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Counterparty not found",
		counterparty = @counterparty
	return
end

update
	default_tally_accounts
set
	internal_account_id = @internal_account_id,
	external_account_id = @external_account_id,
	trader_id = @trader_id,
	strategy_id = @strategy_id,
	status_id = @status_id,
	broker_id = @broker_id,
	counterparty_id = @counterparty_id
where
	tico_account_id = @tico_account_id
and
	tally_type_id = @tally_type_id
if @@rowcount = 0
begin
	insert into
		default_tally_accounts(
		tico_account_id,
		tally_type_id,
		internal_account_id,
		external_account_id,
		trader_id,
		strategy_id,
		status_id,
		broker_id,
		counterparty_id)
	values(
		@tico_account_id,
		@tally_type_id,
		@internal_account_id,
		@external_account_id,
		@trader_id,
		@strategy_id,
		@status_id,
		@broker_id,
		@counterparty_id)
end

create table
	#tally_defaults(
		tico_account_id int,
		tally_type_id int,
		internal_account_id int,
		external_account_id int,
		trader_id int,
		strategy_id int,
		status_id int,
		broker_id int,
		counterparty_id int)

insert into
	#tally_defaults
select
	a.tico_account_id,
        b.tally_type_id,
        a.internal_account_id,
        a.external_account_id,
        a.trader_id,
        a.strategy_id,
        a.status_id,
        a.broker_id,
        a.counterparty_id
from
	default_tally_accounts a,
	tally_types b
where
	a.tico_account_id = @tico_account_id
group by
	a.tico_account_id,
        b.tally_type_id,
        a.internal_account_id,
        a.external_account_id,
        a.trader_id,
        a.strategy_id,
        a.status_id,
        a.broker_id,
        a.counterparty_id

delete
	#tally_defaults
from
	#tally_defaults a,
	default_tally_accounts b
where
	a.tico_account_id = b.tico_account_id
and
	a.tally_type_id = b.tally_type_id

insert into
	default_tally_accounts
select
	a.tico_account_id,
        a.tally_type_id,
        a.internal_account_id,
        a.external_account_id,
        a.trader_id,
        a.strategy_id,
        a.status_id,
        a.broker_id,
        a.counterparty_id
from 
	#tally_defaults a
	
exec
	cm_tallydefaults
		@login,
		@user_name

go
