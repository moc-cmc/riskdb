create or replace procedure
	r_getfdreportruns
		@filedrop_report varchar(50),
		@filedrop_destination varchar(50)

as

declare @filedrop_report_id int
declare @filedrop_destination_id int

select
	@filedrop_report_id = filedrop_report_id
from
	filedrop_reports
where
	name = @filedrop_report
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "Could not find filedrop report",
		filedrop_report_id = @filedrop_report
	return
end

select
	@filedrop_destination_id = filedrop_destination_id
from
	filedrop_destinations
where
	name = @filedrop_destination
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "Could not find destination",
		destination = @filedrop_destination
	return
end


select
	a.name
from
	runs a,
	run_fd_report_destinations b
where
	a.run_id = b.run_id
and
	b.filedrop_destination_id = @filedrop_destination_id
and
	b.filedrop_report_id = @filedrop_report_id

go
		
