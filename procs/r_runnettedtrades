create table
	#net_positions(
		id int identity,
		identifier varchar(100) NULL,
		contract_id int,
		trade_type_id int NULL,
		value_date datetime,
		fixing_date datetime NULL,
		external_account varchar(100),
		trader varchar(25),
		strategy varchar(100),
		broker varchar(25),
		counterparty varchar(100),
		sales_code varchar(25) NULL,
		number_of_long_trades int NULL,
		longs numeric(30,4) NULL,
		avg_long float NULL,
		number_of_short_trades int NULL,
		shorts numeric(30,4) NULL,
		avg_short float NULL,
		net_pos float NULL,
        net_avg float NULL)

insert into
	#net_positions(
		identifier,
		contract_id,
		trade_type_id,
		value_date,
		fixing_date,
		external_account,
		trader,
		strategy,
		broker,
		counterparty,
		sales_code,
		number_of_long_trades,
		longs,
		avg_long)
select
	rtrim(convert(varchar(10), contract_id)) + "." + convert(varchar(11), value_date, 1) + "." + rtrim(external_account) + "." + rtrim(trader) + "." + rtrim(strategy) + "." + rtrim(broker) + "." + rtrim(counterparty) + "." + rtrim(sales_code),
	contract_id,
	trade_type_id,
	value_date,
	fixing_date,
	external_account,
	trader,
	strategy,
	broker,
	counterparty,
	sales_code,
	number_of_trades,
	quantity,
	avg_price
from
	#longs

update
	#net_positions
set
	number_of_short_trades = b.number_of_trades,
	shorts = b.quantity,
	avg_short = b.avg_price
from
	#net_positions a,
	#shorts b
where
	a.contract_id = b.contract_id
and
	a.value_date = b.value_date 
and
	a.fixing_date = b.fixing_date 
and
	a.external_account = b.external_account
and
	a.trader = b.trader
and
	a.strategy = b.strategy
and
	a.broker = b.broker
and
	a.counterparty = b.counterparty
and
	a.sales_code = b.sales_code


insert into
	#net_positions(
		identifier,
		contract_id,
		trade_type_id,
		value_date,
		fixing_date,
		external_account,
		trader,
		strategy,
		broker,
		counterparty,
		sales_code,
		longs,
		avg_long,
		number_of_short_trades,
		shorts,
		avg_short)
select
	rtrim(convert(varchar(10), contract_id)) + "." + convert(varchar(11), value_date, 1) + "." + rtrim(external_account) + "." + rtrim(trader) + "." + rtrim(strategy) + "." + rtrim(broker) + "." + rtrim(counterparty) + "." + rtrim(sales_code),
	contract_id,
	trade_type_id,
	value_date,
	fixing_date,
	external_account,
	trader,
	strategy,
	broker,
	counterparty,
	sales_code,
	longs = NULL,
	avg_long = NULL,
	number_of_trades,
	quantity,
	avg_price
from
	#shorts
where
	rtrim(convert(varchar(10), contract_id)) + "." + convert(varchar(11), value_date, 1) + "." + rtrim(external_account) + "." + rtrim(trader) + "." + rtrim(strategy) + "." + rtrim(broker) + "." + rtrim(counterparty) + "." + rtrim(sales_code) not in(
		select
			identifier
		from
			#net_positions)

update
    #net_positions
set
    net_pos=longs
where
    shorts=NULL

update
    #net_positions
set
    net_pos=shorts
where
    longs=NULL

update
    #net_positions
set
    net_pos=longs + shorts
where
    net_pos=NULL

update
    #net_positions
set
    net_avg=avg_long
where
    avg_short=NULL

update
    #net_positions
set
    net_avg=avg_short
where
    avg_long=NULL

update
    #net_positions
set
    net_avg=(avg_long + avg_short)/2
where
    net_avg=NULL

select
	b.id,
	a.symbol,
	b.value_date,
	/* b.fixing_date, */
	b.external_account,
	b.trader,
	b.strategy,
	b.broker,
	b.counterparty,
	b.sales_code,
	b.number_of_long_trades,
	b.longs,
	b.avg_long,
	b.number_of_short_trades,
	b.shorts,
	b.avg_short,
	b.net_pos,
    b.net_avg
from
	contracts a,
	#net_positions b
where
	a.contract_id = b.contract_id
order by
	a.symbol,
	b.value_date

exec j_nextkey "batch_trades", @batch_id output

delete from 
	batch_trades
where
	batch_id < @batch_id

declare batch cursor for

	select
		id
	from
		#net_positions
	order by
		id

open batch

fetch batch into @id

while @@sqlstatus = 0
begin

	select
		@identifier = identifier,
		@trade_type_id = trade_type_id,
		@external_account = external_account,
		@trader = trader,
		@contract_id = contract_id,
		@trade_type_id = trade_type_id,
		@value_date = value_date,
		@fixing_date = fixing_date,
		@strategy = strategy,
		/* @broker = broker, */
		@counterparty = counterparty,
		@sales_code = sales_code,
		@long_quantity = longs,
		@long_price = avg_long,
		@short_quantity = shorts,
		@short_price = avg_short
	from
		#net_positions
	where
		id=@id

	/* select "contract_id"=@contract_id, "trade_type_id"=@trade_type_id, "value_date"=@value_date, "trader"=@trader, "external_account"=@external_account, "strategy"=@strategy, "counterparty"=@counterparty, "sales_code"=@sales_code, "fixing_date"=@fixing_date, "short_quantity"=@short_quantity, "long_quantity"=@long_quantity */

	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		name = @external_account

	select
		@trader_id = trader_id
	from
		traders
	where
		symbol = @trader

	select
		@strategy_id = strategy_id
	from
		strategies
	where
		name = @strategy

	/* 
	select
		@broker_id = broker_id
	from
		brokers
	where
		symbol = @broker

	*/

	select
		@counterparty_id = counterparty_id
	from
		counterparties
	where
		name = @counterparty

	select
		@sales_code_id = sales_code_id
	from
		sales_codes
	where
		name = @sales_code

	select
		@internal_account_id = internal_account_id
	from
		internal_accounts
	where
		name = "Cantor"

	if(@long_quantity != NULL)
	begin
		
		exec j_nextkey "trades", @trade_id output

		exec j_nextkey "deals", @deal_id output
	
		insert into
			batch_trades
			(batch_id,
	 		trade_id,
	 		identifier,
			trade_type_id,
			deal_id,
	 		user_id,
	 		internal_account_id,
	 		external_account_id,
	 		counterparty_id,
			quantity,
	 		contract_id,
	 		value_date,
	 		fixing_date,
			price,
	 		trade_date,
	 		trader_id,
	 		strategy_id,
	 		status_id,
	 		broker_id,
			sales_code_id)
		values
			(@batch_id,
	 		@trade_id,
	 		"Aggregate Tally " + rtrim(convert(varchar(12), @trade_id)),
			@trade_type_id,
			@deal_id,
	 		@login_id,
	 		@internal_account_id,
	 		@external_account_id,
	 		@counterparty_id,
			@long_quantity,
	 		@contract_id,
	 		@value_date,
	 		@fixing_date,
			@long_price,
	 		@trade_date,
	 		@trader_id,
	 		@strategy_id,
	 		1,
	 		@aggregated_broker_id,
			@sales_code_id)


		update
			aggregated_trades
		set
			aggregate_trade_id=@trade_id,
			identifier = "Aggregate Tally " + rtrim(convert(varchar(12), @trade_id))
		where	
			contract_id=@contract_id
		and
			value_date=@value_date
		and
			trader_id=@trader_id
		and
			external_account_id=@external_account_id
		and
			strategy_id=@strategy_id
		and
			counterparty_id=@counterparty_id
		and
			sales_code_id=@sales_code_id
		and
			fixing_date=@fixing_date
		and
			quantity > 0 
		and
			trade_date >= @begin_date
		and
			trade_date < @end_date

	end


	if(@short_quantity != NULL)
	begin
		
		exec j_nextkey "trades", @trade_id output

		exec j_nextkey "deals", @deal_id output

		insert into
			batch_trades
			(batch_id,
	 		trade_id,
	 		identifier,
			trade_type_id,
			deal_id,
	 		user_id,
	 		internal_account_id,
	 		external_account_id,
			counterparty_id,
	 		quantity,
	 		contract_id,
	 		price,
	 		value_date,
	 		fixing_date,
			trade_date,
	 		trader_id,
	 		strategy_id,
	 		status_id,
	 		broker_id,
			sales_code_id)
		values
			(@batch_id,
	 		@trade_id,
	 		"Aggregate Tally " + rtrim(convert(varchar(12), @trade_id)),
			@trade_type_id,
			@deal_id,
	 		@login_id,
	 		@internal_account_id,
	 		@external_account_id,
			@counterparty_id,
	 		@short_quantity,
	 		@contract_id,
	 		@short_price,
	 		@value_date,
	 		@fixing_date,
			@trade_date,
	 		@trader_id,
	 		@strategy_id,
	 		1,
	 		@aggregated_broker_id,
			@sales_code_id)


		update
        	aggregated_trades
    	set
        	aggregate_trade_id=@trade_id,
			identifier = "Aggregate Tally " + rtrim(convert(varchar(12), @trade_id))
    	where
        	contract_id=@contract_id
    	and
        	value_date=@value_date
    	and
        	trader_id=@trader_id
    	and
        	external_account_id=@external_account_id
    	and
        	strategy_id=@strategy_id
		and
			counterparty_id=@counterparty_id
		and
			sales_code_id=@sales_code_id
		and
			fixing_date=@fixing_date
    	and
        	quantity < 0
    	and
        	trade_date >= @begin_date
    	and
        	trade_date < @end_date

	end

	fetch batch into @id

end

