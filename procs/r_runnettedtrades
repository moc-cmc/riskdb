
drop procedure
	r_runnettedtrades
go

create procedure
	r_runnettedtrades
		@login char(30),
		@run_name char(100),
		@trade_date datetime=NULL
as

declare @login_id int
declare @run_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @trade_id int
declare @batch_id int
declare @deal_id int
declare @internal_account_id int
declare @external_account_id int
declare @long_quantity numeric(30,4) 
declare @contract_id int
declare @long_price float
declare @short_quantity numeric(30,4) 
declare @short_price float
declare @trader_id int
declare @strategy_id int
declare @broker_id int
declare @counterparty_id int
declare @sales_code_id int
declare @counterparty varchar(100)
declare @sales_code varchar(25)
declare @external_account varchar(100)
declare @trader varchar(25)
declare @strategy varchar(100)
declare @broker varchar(25)
declare @value_date datetime
declare @fixing_date datetime
declare @trade_type_id int
declare @uncommitted_status_id int
declare @identifier varchar(100)
declare @aggregated_status_id int
declare @aggregated_broker_id int

create table 
		#links(
			meta_type char(200),
			column char(30),
			link char(200) NULL,
			arguments char(255) NULL,
			format char(20) NULL)

insert into
	#links
values(
	"Column Link",
	"tally_trade",
	"Tally Netted Trade",
	NULL,
	NULL)

insert into 
	#links
values(
	"Column Link",
	"tally_all",
	"Tally All",
	NULL,
	NULL)

insert into
        #links
values(
        "Format Number",
        "price",
        NULL,
        NULL,
        "#,##0.00000000")

select * from #links

select
	@login_id = account_id
from
	tico_accounts
where
	login = @login

if(@@rowcount != 1)
begin
	select
		err=-1,
		message="Invalid login"

	return
end

if @trade_date = NULL
	select
		@trade_date = getdate()

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

select
	@uncommitted_status_id=status_id
from
	statuses
where
	name="Uncommitted"

if(@@rowcount != 1)
begin
	select
		err=-1,
		message="Can't find uncommitted status id"
	
	return
end


select
	@aggregated_status_id = status_id
from
	statuses
where
	name="Aggregated"

if(@@rowcount != 1)
begin
	select
		err=-1,
		message="Can't find aggregated status id"

	return
end

delete from
	trade_notifications
where
	status_id=@aggregated_status_id

select
	@aggregated_broker_id=broker_id
from
	brokers
where
	symbol="Ticket Aggregator"

if(@@rowcount != 1)
begin
	select
		err=-1,
		message="Can't find Ticket Aggregator broker id"
	
	return
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name 
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run_name = @run_name
	return
end

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders	
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies	
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts	
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts	

create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
 	select
		broker_id
	from
		brokers	

create table
    #counterparties(
        counterparty_id int)
insert into
    #counterparties
select
    counterparty_id
from
    run_counterparties
where
    run_id = @run_id
if @@rowcount = 0
    insert into
        #counterparties
    select
        counterparty_id
    from
      	counterparties 

create table #trades(
    trade_id int)

insert into
    #trades
select
    a.trade_id
from
    trades a,
   #external_accounts b,
   #internal_accounts c,
   #traders d,
   #strategies e,
   #brokers f,
   #counterparties g
where
   a.external_account_id = b.external_account_id
and
   a.internal_account_id = c.internal_account_id
and
   a.trader_id = d.trader_id
and
   a.strategy_id = e.strategy_id
and
   a.broker_id = f.broker_id
and
   a.counterparty_id = g.counterparty_id
and
   a.trade_date >= @begin_date
and
   a.trade_date < @end_date
and
    a.quantity != 0

declare trades cursor for
    select
        trade_id
    from
        #trades
    order by
        trade_id

open trades
fetch trades into @trade_id

while(@@sqlstatus = 0)
begin
    
	delete from aggregated_trades where trade_id=@trade_id

    fetch trades into @trade_id
end
close trades
deallocate trades


insert into
	aggregated_trades
	(trade_id,
     deal_id,
     user_id,
     trade_type_id,
	 internal_account_id,
     external_account_id,
     counterparty_id,
	 quantity,
     contract_id,
     value_date,
     fixing_date,
	 price,
     trade_date,
     trader_id,
     strategy_id,
     status_id,
     broker_id,
	 sales_code_id,
	 identifier,
	 pct_price,
	 spot_reference)
select
	a.trade_id,
	a.deal_id,
	a.user_id,
	a.trade_type_id,
	a.internal_account_id,
	a.external_account_id,
	a.counterparty_id,
	a.quantity,
	a.contract_id,
	a.value_date,
	a.fixing_date,
	a.price,
	a.trade_date,
	a.trader_id,
	a.strategy_id,
	@uncommitted_status_id,	
	a.broker_id,
	a.sales_code_id,
	a.identifier,
	a.pct_price,
	a.spot_reference
from
	trades a,
    #external_accounts b,
    #internal_accounts c,
    #traders d,
    #strategies e,
    #brokers f,
	#counterparties g,
	#trades h
where
    a.external_account_id = b.external_account_id
and
    a.internal_account_id = c.internal_account_id
and
    a.trader_id = d.trader_id
and
    a.strategy_id = e.strategy_id
and
    a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
    a.trade_date >= @begin_date
and
    a.trade_date < @end_date
and
	a.quantity != 0
and
	a.trade_id = h.trade_id

update
	aggregated_trades
set
	fixing_date="Aug 29, 1960"
where
	fixing_date = NULL
and
	aggregate_trade_id = NULL

declare notification_cursor cursor for

	select
		trade_id 
	from
		aggregated_trades
	where
		trade_date >= @begin_date and trade_date < @end_date
	and
		status_id=@uncommitted_status_id
	order by
		trade_id

open notification_cursor
fetch notification_cursor into @trade_id

while(@@sqlstatus = 0)
begin
	if exists (select trade_id from trade_notifications where trade_id=@trade_id)
	begin
		delete from aggregated_trades where trade_id=@trade_id 
	end
	fetch notification_cursor into @trade_id

end
close notification_cursor
deallocate notification_cursor

create table
	#longs(
		contract_id int,
		trade_type_id int,
		value_date datetime,
		fixing_date datetime NULL,
		external_account varchar(100),
		trader varchar(25),
		strategy varchar(100),
		broker varchar(25),
		counterparty varchar(100),
		sales_code varchar(25) NULL,
		number_of_trades int,
		quantity numeric(30,4),
		avg_price float)

insert into
	#longs(
		contract_id,
		trade_type_id,
		value_date,
		fixing_date,
		external_account,
		trader,
		strategy,
		broker,
		counterparty,
		sales_code,
		number_of_trades,
		quantity,
		avg_price)
select
	a.contract_id,
	a.trade_type_id,
	a.value_date,
	a.fixing_date,
	h.name,
	i.symbol,
	j.name,
	k.symbol,
	l.name,
	m.name,
	count(*),
	sum(a.quantity),
	sum(a.quantity * a.price) / sum(a.quantity)	
from
	aggregated_trades a,
	#external_accounts b,
    #internal_accounts c,
    #traders d,
    #strategies e,
    #brokers f,
	#counterparties g,
	external_accounts h,
	traders i,
	strategies j,
	brokers k,
	counterparties l,
	sales_codes m
where
	a.external_account_id=b.external_account_id
and
	a.internal_account_id=c.internal_account_id
and
	a.trader_id=d.trader_id
and
	a.strategy_id=e.strategy_id
and
	a.broker_id=f.broker_id
and		
	a.external_account_id = h.external_account_id
and
	a.trader_id = i.trader_id
and
	a.strategy_id = j.strategy_id
and
	a.broker_id = k.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.counterparty_id = l.counterparty_id
and
	a.sales_code_id = m.sales_code_id
and
	a.quantity > 0
and
	a.status_id=@uncommitted_status_id
and
	a.trade_date >= @begin_date and a.trade_date < @end_date
group by
	a.contract_id,
	a.trade_type_id,
	a.value_date,
	a.fixing_date,
	h.name,
	i.symbol,
	j.name,
	k.symbol,
	l.name,
	m.name

