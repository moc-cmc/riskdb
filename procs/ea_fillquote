use
	risk_sales
go

drop procedure
	ea_fillquote
go

create procedure
	ea_fillquote
		@login varchar(50),
		@quote_id int

as


declare @quote_trade_id int
declare @trade_id int
declare @source varchar(50)
declare @tally_type varchar(50)
declare @deal_type varchar(50)
declare @trade_type varchar(50)
declare @trader varchar(50)
declare @external_account_id int
declare @external_account varchar(50)
declare @internal_account varchar(50)
declare @counterparty_id int
declare @counterparty varchar(50)
declare @quantity numeric(30,4)
declare @symbol varchar(50)
declare @value_date datetime
declare @price float
declare @trade_date datetime
declare @strategy varchar(50)
declare @deal_id int
declare @broker varchar(50)
declare @status varchar(50)
declare @quote_type varchar(50)
declare @identifier varchar(100)
declare @fund_id int
declare @house_counterparty_id int
declare @house_counterparty varchar(50)


			
select
	@trade_date = getdate()

exec
	r_defaultfundforlogin
		"easyxadmin",
		@fund_id output


select
	@house_counterparty_id = counterparty_id
from
	fund_agency_counterparties
where
	fund_id = @fund_id
if @house_counterparty_id = NULL
begin
	select
		status = "Error",
		message = "Fund Counterparty not found"
	return
end

select
	@house_counterparty = name
from
	counterparties
where
	counterparty_id = @house_counterparty_id


select
	@source = "GridIron EA",
	@tally_type = "Forward",
	@deal_type = "B2B Forward",
	@trade_type = "Forward"


select
	@identifier = rtrim(@source) + "-" + rtrim(convert(varchar(50), @quote_id))

select
	@quote_trade_id = a.trade_id,
	@symbol = b.symbol,
	@value_date = a.value_date,
	@price = a.price,
	@quantity = a.fill_amount,
	@quote_type = c.name
from
	quotes a,
	contracts b,
	quote_types c
where
	a.contract_id = b.contract_id
and
	a.quote_type_id = c.quote_type_id
and
	quote_id = @quote_id

if @quote_type = "Bid"
	select
		@quantity = @quantity * -1.0


select
	@trader = b.symbol,
  @external_account_id = a.external_account_id,
	@external_account = c.symbol,
	@internal_account = d.symbol,
  @counterparty_id = a.counterparty_id,
	@counterparty = e.name,
	@strategy = f.name,
	@broker = g.symbol,
	@status = h.name	
from
	trades a,
	traders b,
	external_accounts c,
	internal_accounts d,
	counterparties e,
	strategies f,
	brokers g,
	statuses h
where
	a.trader_id = b.trader_id
and
	a.external_account_id = c.external_account_id
and
	a.internal_account_id = d.internal_account_id
and
	a.counterparty_id = e.counterparty_id
and
	a.strategy_id = f.strategy_id
and
	a.broker_id = g.broker_id
and
	a.status_id = h.status_id
and
	a.trade_id = @quote_trade_id


if @counterparty = @house_counterparty
	select
		@quantity = @quantity * -1.0


/* select
	quote_trade_id = @quote_trade_id,
	symbol = @symbol,
	value_date = @value_date,
	price = @price,
	quantity = @quantity,
	quote_type = @quote_type,
	trader = @trader,
	external_account = @external_account, 
	internal_account = @internal_account,
	counterparty = @counterparty,
	strategy = @strategy,
	broker = @broker,
	status = @status */


exec
	fxa_tallytrade
		@login = @login,
		@source = @source,
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = @deal_type,
		@trade_type = @trade_type,
		@trade_date = @trade_date,
		@internal_account = @internal_account,
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@price = @price,
		@symbol = @symbol,
		@value_date = @value_date,
		@trader = @trader,
		@strategy = @strategy,
		@status = @status,
		@broker = @broker,
		@identifier = @identifier

if @trade_id != null
begin

  declare @subject varchar(250)
  declare @content varchar(250)
  declare @properties varchar(250)
  declare @quantity_text varchar(30)
  
  /* Turn 5000000.0000 -> "5,000,000.00" -> "5,000,000" */
  select
    @quantity_text = convert(varchar(30), convert(money, a.fill_amount), 1)
  from
    quotes a
  where
    a.quote_id = @quote_id

  select
    @quantity_text = left(@quantity_text, len(@quantity_text) - 3)
  /*select
    @quantity_text = convert(varchar(30), @quantity)*/

  select
    @subject = "Option Exercise: " + @trader + " Exercises " + @quantity_text + " " + b.symbol,
    @content = "Trade #" + convert(varchar(10), @trade_id) + ": " + @quantity_text + " " + @symbol + " " + convert(varchar(8), @value_date, 1) + " at " + str(@price, 10, 6)
  from
    trades a,
    contracts b
  where
    a.contract_id = b.contract_id
  and
    a.trade_id = @quote_trade_id

  exec
    r_postmessage
      @login = @login,
      @channel = "Option Exercised",
      @item_id = @external_account_id,
      @subject = @subject,
      @content = @content,
      @priority = "Medium"

  select
    @subject = "Option Assigned: " + @counterparty + " Was Assigned " + @quantity_text + " " + b.symbol,
    @content = "Trade #" + convert(varchar(10), @trade_id) + ": " + @quantity_text + " " + @symbol + " " + convert(varchar(8), @value_date, 1) + " at " + str(@price, 10, 6)
  from
    trades a,
    contracts b
  where
    a.contract_id = b.contract_id
  and
    a.trade_id = @quote_trade_id

  exec
    r_postmessage
      @login = @login,
      @channel = "Option Assigned",
      @item_id = @counterparty_id,
      @subject = @subject,
      @content = @content,
      @priority = "Medium"

end
	
go

