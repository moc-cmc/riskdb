
drop procedure
	r_setextacctrollrates
go

create procedure
	r_setextacctrollrates
		@login varchar(50),
		@symbol varchar(50),
		@closing_date datetime,
		@closing_rate float,
		@roll_date datetime,
		@roll_rate float,
		@trade_date datetime=NULL
as


declare @external_account_id int
declare @external_accounts int
declare @contract_id int

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end


create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	a.external_account_id
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Client"

select
	@external_account_id = 0
select
	@external_accounts = count(*)
from
	#external_accounts
where
	external_account_id > @external_account_id
while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		#external_accounts
	where
		external_account_id > @external_account_id


	update
		ext_account_biproduct_rates
	set
		closing_rate = @closing_rate,
		roll_date = @roll_date,
		roll_rate = @roll_rate
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id
	and
		closing_date = @closing_date
	if @@rowcount = 0
	begin

		insert into
			ext_account_biproduct_rates(
				external_account_id,
				contract_id,
				closing_date,
				closing_rate,
				roll_date,
				roll_rate,
				trade_date)
		values(
			@external_account_id,
			@contract_id,
			@closing_date,
			@closing_rate,
			@roll_date,
			@roll_rate,
			@trade_date) 

	end

	select
		@external_accounts = count(*)
	from
		#external_accounts
	where
		external_account_id > @external_account_id
end



go
