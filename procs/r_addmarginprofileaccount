drop procedure r_addmarginprofileaccount
go

create procedure
	r_addmarginprofileaccount
		@login varchar(50),
		@margin_profile varchar(50),
		@external_account varchar(50)

as

declare @margin_profile_id int
declare @external_account_id int

select
	@margin_profile_id = margin_profile_id
from
	margin_profiles
where
	name=@margin_profile
if @margin_profile_id = NULL
begin
	select
		error="Error",
		msg="Credit profile not found", @margin_profile
	return
end

select
        @external_account_id = external_account_id
from
        external_accounts
where
        symbol=@external_account
if @external_account_id = NULL
begin
        select
                error="Error",
                msg="external_account not found", @external_account
        return
end

declare @already_created varchar(1)

select
	@already_created = "Y"
from 
	margin_profile_accounts
where
	margin_profile_id = @margin_profile_id
and
	external_account_id = @external_account_id

if @already_created = "Y"
begin
	select
		error = "Account has already been assigned to Margin Profile",
		margin_profile = @margin_profile,
		external_account = @external_account_id
	return
end

insert into
	margin_profile_accounts(
		margin_profile_id,
		external_account_id)
values(
	@margin_profile_id,
	@external_account_id
)
if @@rowcount != 1
begin
	select
		status = "Error adding account to margin profile",
		margin_profile = @margin_profile,
		external_account = @external_account
	return
end

select
	status = "Successfully created added account to margin profile",
	margin_profile = @margin_profile,
	external_account = @external_account


exec
	r_viewmarginprofile
		@login,
		@margin_profile

go

	
