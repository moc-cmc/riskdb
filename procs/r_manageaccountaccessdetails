
create or replace procedure
	r_manageaccountaccessdetails
		@account_name varchar(50)
as


declare @account_id int


create table
	#meta(
		meta_type char(200),
		name char(30),
		action char(200) NULL,
		value char(255) NULL
)

insert into
	#meta
values(
	"Column Link",
	"revoke_access",
	"Revoke Account Access to Run",
	NULL
)

insert into
       #meta
values(
       "Column Link",
       "grant_all_runs",
       "Verify Account Access",
       NULL
)

insert into
       #meta
values(
       "Column Link",
       "revoke_all_runs",
       "Revoke All Runs For Acct",
       NULL
)

insert into
       #meta
values(
       "Column Link",
       "grant_access",
       "Grant Run Access To Account",
       NULL
)


insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)


insert into
	#meta
values (
	"Column Group",
  	"section",
	NULL,
	NULL
)

insert into
	#meta
values(
	"Column Link",
	"back",
	"Account Access",
	NULL
)

insert into
        #meta
values(
        "Column Link",
        "make_favorite",
        "Make Run Favorite",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "remove_favorite",
        "Remove Run Favorite",
        NULL)

select
	@account_id = account_id
from
	tico_accounts
where
	login = @account_name
if @@rowcount != 1
begin
       select

               status = -1,
               error = "Problem deterimining account"
       return
end

create table
	#account_details(
		account_id int NULL,
		account_name varchar(50) NULL,
		account_type varchar(50) NULL,
		runs_subscribed int NULL,
		grant_all_runs varchar(50),
		revoke_all_runs varchar(50),
		back varchar(50) NULL,
		show varchar(25) NULL,
		style varchar(50) NULL
)

insert into 
	#account_details
values(
	@account_id,
	@account_name,
	NULL,
	NULL,
	"GRANT ALL",
	"REVOKE ALL",
	"< Back",
	NULL,
	""
)

update 
	#account_details
set
	runs_subscribed = (select count(*) from user_runs where tico_account_id = @account_id)

update
	#account_details
set
	account_type = b.name
from
	#account_details a,
	login_types b,
	tico_account_types c
where
	a.account_id = c.tico_account_id
and
	c.login_type_id = b.login_type_id
	

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select 
	section = "Account Details",
	account_name,
	account_type,
        runs_subscribed,
	grant_all_runs,
	revoke_all_runs,
	back,
	style
from
	#account_details


create table
	#output
(
	account_name varchar(50),
	tico_account_id int,
	run_name varchar(50),
	run_id int,
	has_access char(1) NULL,
	grant_access varchar(25) NULL,
	revoke_access varchar(25) NULL,
	make_favorite varchar(15) NULL,
	remove_favorite varchar(15) NULL
)

insert into 
	#output
select
	@account_name,
	@account_id,
	name,
	run_id,
	NULL,
	"GRANT",
	NULL,
	"MAKE FAVORITE",
	NULL 
from
	runs
	
update 
	#output
set
	revoke_access = "REVOKE",
	grant_access = NULL,
	has_access = "Y"
from
	#output a,
	user_runs b
where
	a.tico_account_id = b.tico_account_id 
and
	b.tico_account_id = @account_id
and
	a.run_id = b.run_id

update
	#output
set
	make_favorite=NULL,
	remove_favorite="UNFAVORITE"
from
	#output a,
	user_run_favorites b
where
	a.tico_account_id=b.tico_account_id
and
	b.tico_account_id=@account_id
and
	a.run_id=b.run_id

update 
	#output
set
	make_favorite=NULL,
	remove_favorite=NULL
where
	grant_access="GRANT"

select 
	section = "Account Access",
	"Account Name" = @account_name,
	run_name,
	has_access,
	grant_access,
	revoke_access,
	make_favorite,
	remove_favorite
from
	#output
order by
	run_name,
	has_access desc,
	account_name


go 

