use
	risk_stad
go

drop procedure dm_historicaltradeprice
go

create procedure
	dm_historicaltradeprice
		@contract varchar(30),
		@trade_date datetime,
		@price float=NULL output

as

declare @prev_date datetime
declare @next_date datetime
declare @prev_settle float
declare @next_settle float

declare @upper_bound float
declare @lower_bound float
declare @random_unformatted_price float

declare @contract_id int

exec
	r_prevbusinessday
		@trade_date,
		@prev_date output

exec
	r_nextbusinessday
		@trade_date,
		@next_date output

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @contract
if @contract_id = NULL
begin
	select
		error = "contract not found",
		contract = @contract
	return
end

select
	@prev_settle = price
from
	prices
where
	convert(date, price_date) = @prev_date

select
	@next_settle = price
from
	prices
where
	contract_id = @contract_id
and
	convert(date, price_date) = @next_date

if @prev_settle = NULL or @next_settle = NULL
begin

	select
		error = "missing settle",
		prev_date = @prev_date,
		prev_settle = @prev_settle,
		next_date = @next_date,
		next_settle = @next_settle
	return
end

if @next_settle > @prev_settle
begin
	select 
		@upper_bound = @next_settle,
		@lower_bound = @prev_settle
end
if @prev_settle > @next_settle
begin
	select
		@upper_bound = @prev_settle,
		@lower_bound = @next_settle
end
	
/* select
	@random_unformatted_price = round((@upper_bound - @lower_bound - 1) * rand() + @lower_bound, 8)
*/

select
	next_settle = @next_settle /* TEST */

if rand() > .5
begin
	select
		@random_unformatted_price = @next_settle + (rand() * .0027 * @next_settle)
end
else
begin
	select
		@random_unformatted_price = @next_settle - (rand() * .0027 * @next_settle)
end

select 
	@random_unformatted_price

go
