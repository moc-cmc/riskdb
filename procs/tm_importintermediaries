use
	risk_admis
go

drop procedure
	tm_importintermediaries
go

create procedure
	tm_importintermediaries
		@login varchar(50),
		@acctccy varchar(50)=NULL,
		@intermediary varchar(200)=NULL,
		@swift_code varchar(100)=NULL,
		@prime_broker varchar(100)=NULL,
		@ord_swift varchar(50)=NULL
as

declare @prime_broker_id int
declare @source_id int
declare @product_id int
declare @wire_intermediary_id int
declare @external_account_id int

select
	@source_id = source_id
from
	sources
where
	name = "ADMIS Intermediaries"
if @source_id = NULL
begin
	select
		status = "Error",
		message = "ADMIS Intermediaries source not found"
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = right(@acctccy, 3)
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = right(@acctccy, 3)
	return
end


select
	@prime_broker_id = prime_broker_id
from
	prime_broker_symbols
where
	symbol = @prime_broker
and
	source_id = @source_id
if @prime_broker_id = NULL
begin
	select 
		@prime_broker_id = a.prime_broker_id
	from
		prime_brokers a,
		sources b
	where
		a.source_id = b.source_id
	and
		b.name = @prime_broker
	if @prime_broker_id = NULL
	begin
		select
			status = "Error",
			message = "Prime broker not found",
			prime_broker = @prime_broker
		return
	end
end
select
	@external_account_id = bo_external_account_id
from
	prime_brokers
where
	prime_broker_id = @prime_broker_id

	

select
	@wire_intermediary_id = wire_intermediary_id
from
	wire_intermediaries
where
	external_account_id = @external_account_id
and
	product_id = @product_id
if @wire_intermediary_id = NULL
begin
	exec
		j_nextkey
			"wire_intermediaries",
			@wire_intermediary_id output

	insert into
		wire_intermediaries(
			wire_intermediary_id,
			external_account_id,
			product_id,
			intermediary,
			int_swift_code,
			ord_swift_code)
	values(
		@wire_intermediary_id,
		@external_account_id,
		@product_id,
		@intermediary,
		@swift_code,
		@ord_swift)
end

select
	*
from
	wire_intermediaries
where
	wire_intermediary_id = @wire_intermediary_id

		
		
		


go
