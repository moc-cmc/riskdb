drop procedure
	ag_extaccountproducts
go

create procedure
	ag_extaccountproducts
		@login varchar(50),
		@prime_broker varchar(50)=NULL,
		@account varchar(50)=NULL
as

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

declare @external_account_id int
declare @external_accounts int
declare @prime_broker_id int
declare @external_account varchar(50)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"prime_broker",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"account",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"add_product",
	"Set Account Product",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"remove_product",
	"Set Account Product",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"net_balance",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

select
	@prime_broker_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = @prime_broker

create table
	#output(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(100) NULL,
		external_account varchar(100) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		add_product varchar(50) NULL,
		remove_product varchar(50) NULL)
	
create table
	#accounts(
		external_account_id int,
		account varchar(50))
insert into
	#accounts
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = @prime_broker_id
order by
	a.symbol
	

select
	@external_account_id = 0
select
	@external_accounts = count(*)
from
	#accounts
where
	external_account_id > @external_account_id
while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		#accounts
	where
		external_account_id > @external_account_id

	select
		@account = account
	from
		#accounts
	where
		external_account_id = @external_account_id

		
	insert into
		#output(
			style,
			external_account)
	values(
		@pb_style,
		@account)

	insert into
		#output(
			external_account_id,
			account,
			product_id,
			product)
	select
		external_account_id = @external_account_id,
		account = @account,
		a.product_id,
		a.symbol
	from
		products a,
		pb_deliverable_products b
	where
		a.product_id = b.product_id
	and
		b.prime_broker_id = @prime_broker_id
	order by
		a.symbol
		

	select
		@external_accounts = count(*)
	from
		#accounts
	where
		external_account_id > @external_account_id
end


update
	#output
set
	style = @style,
	add_product = "Add"
where
	product != NULL


update
	#output
set
	a.add_product = NULL,
	a.remove_product = "Remove"
from
	#output a,
	acct_deliverable_products b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id


select
	style,
	prime_broker = @prime_broker,
	external_account,
	account,
	product,
	add_product,
	remove_product
from
	#output
order by
	id




go
