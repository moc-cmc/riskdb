use
	risk_admis
go

drop procedure
	ag_wiresfordate
go

create procedure
	ag_wiresfordate
		@login varchar(50),
		@value_date datetime=NULL
as


declare @fund_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

if @value_date = NULL
begin
	select
		@value_date = convert(datetime, convert(date, getdate()))

	exec
		r_nextbusinessday
			@value_date,
			@value_date output
end
	
create table
	#output(
		id int identity,
		pb_wire_signoff_id int NULL,
		tico_account_id int NULL,
		confirmed_by varchar(30) NULL,
		timestamp datetime NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		val_date datetime NULL,
		amount numeric(30,4) NULL)
insert into
	#output(
		pb_wire_signoff_id,
		tico_account_id,
		confirmed_by,
		timestamp,
		external_account_id,
		account,
		product_id,
		product,
		val_date,
		amount)
select
	a.pb_wire_signoff_id,
	a.tico_account_id,
	confirmed_by = b.login,
	a.timestamp,
	a.external_account_id,
	c.symbol,
	a.product_id,
	d.symbol,
	a.value_date,
	a.amount
from
	pb_wire_signoffs a,
	tico_accounts b,
	external_accounts c,
	products d
where
	a.tico_account_id = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.product_id = d.product_id
and
	convert(date, a.value_date) = convert(date, @value_date)
order by
	a.timestamp


select
	pb_wire_signoff_id,
	confirmed_by,
	timestamp,
	account,
	product,
	val_date,
	amount,
	ccy_account = rtrim(account) + " " + rtrim(product)
from
	#output
order by
	timestamp,
	pb_wire_signoff_id






go
