create or replace procedure
	ag_addledgerrequesttype
		@login varchar(50),
		@name varchar(100),
		@create_pending_status varchar(50),
		@sweep_pending_status varchar(50),
		@cancel_pending_status varchar(50)

as

declare @ledger_request_type_id int

exec
	api_addledgerrequesttype
		@login = @login,
		@name = @name,
		@create_pending_status=@create_pending_status,
		@sweep_pending_status=@sweep_pending_status,
		@cancel_pending_status=@cancel_pending_status,
		@ledger_request_type_id=@ledger_request_type_id output

if @ledger_request_type_id = NULL
begin
	select
		status = "Error",
		message = "Problem adding ledger request type"
end

exec
	ag_ledgerrequesttypes
		@login = @login

go
	
