/*
|  Query contracts, dealt ccy, counter ccy
*/
update 
	#trades
set
	contract = b.symbol
from
	#trades a,
	contracts b
where
	a.contract_id = b.contract_id


create table
        #trade_output
(
	contract_id int NULL,
        symbol varchar(25) NULL,
        value_date varchar(25) NULL,
        quantity float NULL,
        trade_price float NULL
)


/* Insert trade information */

insert into
	#trade_output
(
	contract_id,
        symbol,
        value_date,
        quantity,
        trade_price
)
select
	conrtact_id = a.contract_id,
	symbol = a.contract,
        value_date = convert(varchar(11), a.value_date, 1),
	quantity = sum(a.quantity),
        trade_price = sum(a.quantity * a.db_price) / sum(a.quantity)
from
	#trades a
where
	a.quantity > 0 
group by
	a.contract_id,
	a.contract,
	convert(varchar(11), a.value_date, 1)	

insert into
        #trade_output
(
	contract_id,
        symbol,
        value_date,
        quantity,
        trade_price
)
select
	conrtact_id = a.contract_id,
        symbol = a.contract,
        value_date = convert(varchar(11), a.value_date, 1),
        quantity = sum(a.quantity),
        trade_price = sum(a.quantity * a.db_price) / sum(a.quantity)
from
        #trades a
where
        a.quantity < 0
group by
	a.contract_id,
        a.contract,
        convert(varchar(11), a.value_date, 1) 

/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    std_price = case
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.trade_price) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.trade_price) * d.factor
        when c.factor != NULL then
            a.trade_price * c.factor * d.factor
        else
            a.trade_price * d.factor
    end
from
    #trade_output a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id


select 
	*
from
	#trade_output
order by
	symbol,
	value_date
