create procedure
	fs_netsummary
                @run_name varchar(25)=NULL,
                @begin_date datetime=NULL,
                @end_date datetime=NULL
		
as


declare @account_id int
declare @num_of_runs int
declare @run_id int
declare @begin_day_string varchar(50)
declare @end_day_string varchar(50)

select
	@run_id = a.run_id
from
	runs a
where
	a.name = @run_name
if @run_id = NULL
begin
        select
                "error"="Run not found",
                "run_name"=@run_name
        return
end



/* Date determination */
if @begin_date = NULL
begin
        select
                @begin_date = getdate()
end
 
if datepart(hour, @begin_date) >= 17
begin
        exec
                r_nextbusinessday
                        @begin_date,
                        @begin_date output
end
select
        @begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
                convert(char(2), datepart(day, @begin_date)) + "/" +
                convert(char(4), datepart(year, @begin_date))
select
        @begin_date = convert(datetime, @begin_day_string)
exec
        r_prevbusinessday
                @begin_date,
                @begin_date output
select
        @begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
begin
        exec
                r_nextbusinessday
                        @begin_date,
                        @end_date output
end
select
        @end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
                        convert(char(2), datepart(day, @end_date)) + "/" +
                        convert(char(4), datepart(year, @end_date)) + " 17:00"
select
        @end_date = convert(datetime, @end_day_string)


/* Run filtering */

create table
        #traders(
                trader_id int)
insert into
        #traders
select
        trader_id
from
        run_traders
where
        run_id = @run_id
if @@rowcount = 0
begin
        insert into
                #traders
        select
                trader_id
        from
                traders
end

create table
        #strategies(
                strategy_id int)
insert into
        #strategies
select
        strategy_id
from
        run_strategies
where
        run_id = @run_id
if @@rowcount = 0
begin
        insert into
                #strategies
        select
                strategy_id
        from
                strategies
end

create table
        #external_accounts(
                external_account_id int)
insert into
        #external_accounts
select
        external_account_id
from
        run_external_accounts
where
        run_id = @run_id
if @@rowcount = 0
begin
        insert into
                #external_accounts
        select
                external_account_id
        from
                external_accounts
end

create table
        #internal_accounts(
                internal_account_id int)
insert into
        #internal_accounts
select
        internal_account_id
from
        run_internal_accounts
where
        run_id = @run_id
if @@rowcount = 0
        insert into
                #internal_accounts
        select
                internal_account_id
        from
                internal_accounts
create table
        #brokers(
                broker_id int)
insert into
        #brokers
select
        broker_id
from
        run_brokers
where
        run_id = @run_id
if @@rowcount = 0
        insert into
                #brokers
        select
                broker_id
        from
                brokers

create table
        #counterparties(
                counterparty_id int)

insert into
        #counterparties
select
        counterparty_id
from
        run_counterparties
where
        run_id = @run_id
if @@rowcount = 0
        insert into
                #counterparties
        select
                counterparty_id
        from
                counterparties




/* Trade Data */

create table
	#trades(
		trade_id int,
		deal_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		deal_type_id int NULL,
		deal_type varchar(25) NULL,
		internal_account_id int,
		internal_account varchar(50) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(25) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
                agency_vs_counterparty varchar(50) NULL,
		fund_agency_trade char(1) NULL,
		fund_agency_buy_sell varchar(4) NULL,
		client_buy_sell varchar(4) NULL,
		broker_id int,
		broker varchar(25) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		ext_account_pb varchar(25) NULL,
		contract_id int,
		contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity float NULL,
		abs_qty float NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date varchar(15) NULL,
		fixing_date varchar(15) NULL,
		db_price float,
		std_price float NULL,
		spot_reference float NULL,
		sales_code_id int,
		sales_code varchar(25) NULL,
		strategy_id int,
		strategy varchar(30) NULL,
		identifier varchar(100) NULL,
		deal_identifier varchar(100) NULL,
		deal_status_id int NULL,
		deal_status varchar(25) NULL,
		trade_status_id int,
		trade_status varchar(25) NULL
		)


create nonclustered index 
	tmp_tid
on
	#trades(trade_id)


/*
| Insert *_ids into #trades
*/
insert into
	#trades
(
	trade_id,
	deal_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	trader_id,
	counterparty_id,
	fund_agency_trade,
	contract_id,
	broker_id,
	quantity,
	trade_date,
	value_date,
	fixing_date,
	db_price,
	std_price,
	spot_reference,
	sales_code_id,
	strategy_id,
	identifier,
	trade_status_id,
	abs_qty
)
select 
	trade_id = a.trade_id,
	deal_id = a.deal_id,
	trade_type_id = a.trade_type_id,
	internal_account_id = a.internal_account_id,
	external_account_id = a.external_account_id,
	trader_id = a.trader_id,
	counterparty_id = a.counterparty_id,
        fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	quantity = a.quantity,
	trade_date = a.trade_date,
	value_date = a.value_date,
	fixing_date = a.fixing_date,
	db_price = a.price,
	std_price = a.price,
	spot_reference = a.spot_reference,
	sales_code_id = a.sales_code_id,
	strategy_id = a.strategy_id,
	identifier = a.identifier,
	trade_status_id = a.status_id,
	abs_qty = abs(a.quantity)
from
	trades a,
        #external_accounts b,
        #internal_accounts c,
        #traders d,
        #strategies e,
        #brokers f,
        #counterparties g
where
        a.external_account_id = b.external_account_id
and
        a.internal_account_id = c.internal_account_id
and
        a.trader_id = d.trader_id
and
        a.strategy_id = e.strategy_id
and
        a.broker_id= f.broker_id
and
        a.counterparty_id = g.counterparty_id
and
        a.trade_date >= @begin_date
and
        a.trade_date <= @end_date
and
	a.quantity != 0

/*
| Query traders
*/
update
	#trades
set
	trader = b.symbol
from
        #trades a,
        traders b
where
        a.trader_id = b.trader_id

/*
| Query brokers
*/

update
	#trades
set
	broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id

