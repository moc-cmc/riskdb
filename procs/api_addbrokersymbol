
drop procedure
	api_addbrokersymbol
go

create procedure 
	api_addbrokersymbol 
		@login varchar(25),
		@name varchar(25),
		@symbol varchar(100),
		@source varchar(100)
as

declare @broker_id int
declare @source_id int
declare @source_type_id int
declare @source_type varchar(50)

select 
	@symbol = ltrim(rtrim(@symbol))

select
	@broker_id=broker_id
from
	brokers
where
	symbol=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Broker name does not exist",
		broker_name=@name

	return
end

select
	@source_id = source_id,
	@source_type_id = source_type_id
from
	sources
where
	name=@source

if(@@rowcount != 1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source

	return
end

select
        @source_type=name
from
        source_types
where
        source_type_id=@source_type_id

if (@source_type="Outbound")
begin
        if exists (select 
                        broker_id
                   from
                        broker_symbols
                   where
                        source_id=@source_id
                   and
                        broker_id=@broker_id)

        begin
                select
                        status="Error",
                        msg="Broker already has an Outbound Source",
                        name=@name

                return
        end
end
insert into
	broker_symbols (
		broker_id,
		source_id,
		symbol )
values (
	@broker_id,
	@source_id,
	@symbol )

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Problem adding Broker Symbol",
		broker_symbol=@symbol
	return
end

select
	status="OK",
	msg="Successfully added Broker Symbol",
	broker_symbol=@symbol

return

go

