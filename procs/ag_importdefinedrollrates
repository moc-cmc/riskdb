drop procedure
	ag_importdefinedrollrates
go

create procedure
	ag_importdefinedrollrates
		@login varchar(50),
		@symbol varchar(50)=NULL,
		@trade_day varchar(50)=NULL,
		@closing_date varchar(50)=NULL,
		@closing_rate_long varchar(50)=NULL,
		@closing_rate_short varchar(50)=NULL,
		@roll_date varchar(50)=NULL,
		@roll_rate_long varchar(50)=NULL,
		@roll_rate_short varchar(50)=NULL,
		@row_index int,
		@row_count int


as

declare @contract_id int
declare @tico_account_id int
declare @t_date datetime
declare @c_date datetime
declare @f_closing_rate_long float
declare @f_closing_rate_short float
declare @r_date datetime
declare @f_roll_rate_long float
declare @f_roll_rate_short float
declare @defined_roll_rate_id int

if @symbol = "symbol"
	return

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

select
	@t_date = convert(date, @trade_day),
	@c_date = convert(date, @closing_date),
	@f_closing_rate_long = convert(float, @closing_rate_long),
	@f_closing_rate_short = convert(float, @closing_rate_short),
	@r_date = convert(date, @roll_date),
	@f_roll_rate_long = convert(float, @roll_rate_long),
	@f_roll_rate_short = convert(float, @roll_rate_short)




update
	defined_roll_rates
set
	tico_account_id = @tico_account_id,
	closing_date = @c_date,
	closing_rate_long = @f_closing_rate_long,
	closing_rate_short = @f_closing_rate_short,
	roll_date = @r_date,
	roll_rate_long = @f_roll_rate_long,
	roll_rate_short = @f_roll_rate_short
where
	/*convert(date, trade_date)  = convert(date, @t_date)*/
	convert(date, closing_date)  = convert(date, @c_date)
and
	contract_id = @contract_id
if @@rowcount != 1
begin
	exec
		j_nextkey
			"defined_roll_rates",
			@defined_roll_rate_id output
	

	insert into
		defined_roll_rates(
			defined_roll_rate_id,
			tico_account_id,
			contract_id,
			trade_date,
			closing_date,
			net_long,
			long_pbs,
			closing_rate_long,
			net_short,
			short_pbs,
			closing_rate_short,
			roll_date,
			roll_rate_long,
			roll_rate_short,
			timestamp)
	values(
		@defined_roll_rate_id,
		@tico_account_id,
		@contract_id,
		@t_date,
		@c_date,
		0.0,
		0.0,
		@f_closing_rate_long,
		0.0,
		0.0,
		@f_closing_rate_short,
		@r_date,
		@f_roll_rate_long,
		@f_roll_rate_short,
		getdate())
end



if @row_count = @row_index + 1
	select
		b.symbol,
		a.trade_date,
		a.closing_date,
		a.closing_rate_long,
		a.closing_rate_short,
		a.roll_date,
		a.roll_rate_long,
		a.roll_rate_short
	from
		defined_roll_rates a,
		contracts b
	where
		a.contract_id = b.contract_id
	and
		convert(date, a.trade_date) = convert(date, @t_date)



go
