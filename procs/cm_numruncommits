
if object_id("cm_numruncommits") != NULL
    drop procedure
        cm_numruncommits
go

create procedure
	cm_numruncommits
		@login varchar(30),
		@run_name varchar(30),
		@committed_pls int output
as

declare @run_id int
declare @internal_account_id int

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login

select
	@internal_account_id = NULL

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @run_name

select
	@committed_pls = NULL

select
	@committed_pls = count(a.int_account_transaction_id)
from
	int_account_transactions a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
	a.internal_account_id = @internal_account_id
and
	b.name = "Front Office Commit"
if @committed_pls = NULL
	select
		@committed_pls = 0

return

go
