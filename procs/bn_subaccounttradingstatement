create table
	#other_transaction_types(
		transaction_type_id int,
		name varchar(50)
)
insert into
	#other_transaction_types
select
	transaction_type_id,
	name
from
	transaction_types

delete from
	#other_transaction_types
where
	name in("Allocation", "Deposit", "Withdrawal")

delete 
	#other_transaction_types
from
	#other_transaction_types a,
	fee_transaction_types b
where
	a.transaction_type_id = b.transaction_type_id

delete
        #other_transaction_types
from
        #other_transaction_types a,
        #settle_transaction_types b
where
        a.transaction_type_id = b.transaction_type_id



	
	
create table
	#summary(
		id int identity,
		style varchar(250) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		beginning_balance numeric(30, 8) NULL,
		deposits numeric(30, 8) NULL,
		withdrawals numeric(30, 8) NULL,
		allocations numeric(30, 8) NULL,
		settlement numeric(30, 8) NULL,
		fees numeric(30,8) NULL,
		other numeric(30, 8) NULL,
		ending_balance numeric(30, 8) NULL)
insert into
	#summary(
		style,
		product_id,
		product,
		beginning_balance,
		deposits,
		withdrawals,
		allocations,
		settlement,
		fees,
		other,
		ending_balance)
select
	style = @style,
	a.product_id,
	a.symbol,
	beginning_balance = 0.0,
	deposits = 0.0,
	withdrawals = 0.0,
	allocations = 0.0,
	settlement = 0.0,
	fees = 0.0,
	other = 0.0,
	ending_balance = 0.0
from
	products a,
	#all_products b
where
	a.product_id = b.product_id
order by
	a.symbol

update
	#summary
set
	a.beginning_balance = b.balance
from
	#summary a,
	#begin_balances b
where
	a.product_id = b.product_id

create table
	#activity(
		product_id int,
		transaction_type_id int,
		amount numeric(30, 8))
insert into
	#activity(
		product_id,
		transaction_type_id,
		amount)
select
	currency_id,
	transaction_type_id,
	sum(amount)
from
	#account_transactions
group by
	currency_id,
	transaction_type_id


update
        #summary
set
        a.deposits = b.amount
from
        #summary a,
        #activity b,
        transaction_types c
where
        a.product_id = b.product_id
and
        b.transaction_type_id = c.transaction_type_id
and
        c.name = "Deposit"

update
        #summary
set
        a.withdrawals = b.amount
from
        #summary a,
        #activity b,
        transaction_types c
where
        a.product_id = b.product_id
and
        b.transaction_type_id = c.transaction_type_id
and
        c.name = "Withdrawal"

update
	#summary
set
	a.allocations = b.amount
from
	#summary a,
	#activity b,
	transaction_types c
where
	a.product_id = b.product_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Allocation"


update
	#summary
set
	a.other = b.amount
from
	#summary a,
	#activity b,
	transaction_types c,
	#other_transaction_types d
where
	a.product_id = b.product_id
and
	b.transaction_type_id = c.transaction_type_id
and
        c.transaction_type_id = d.transaction_type_id

create table
	#product_fees(
		product_id int,
		amount numeric(30, 8)
)
insert into
	#product_fees(
		product_id,
		amount)
select
	a.product_id,
	sum(a.amount)
from
	#activity a,
        transaction_types c,
        fee_transaction_types d
where
        a.transaction_type_id = c.transaction_type_id
and
        c.transaction_type_id = d.transaction_type_id
group by
	a.product_id

update
	#summary
set
	a.fees = b.amount
from
	#summary a,
	#product_fees b
where
	a.product_id = b.product_id

create table
	#product_settlements(
		product_id int,
		amount numeric(30, 8)
)
insert into
	#product_settlements
select
	a.product_id,
	sum(a.amount)
from
        #activity a,
        transaction_types c,
        #settle_transaction_types d
where
        a.transaction_type_id = c.transaction_type_id
and
        c.transaction_type_id = d.transaction_type_id
group by
	a.product_id

update
        #summary
set
	a.settlement = b.amount
from
	#summary a,
	#product_settlements b
where
	a.product_id = b.product_id

update
	#summary
set
	ending_balance = convert(numeric(30, 8), (beginning_balance + deposits + withdrawals + allocations + fees + settlement + other))


create table
	#output(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		prod varchar(50) NULL,
		account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		account_transaction_id int NULL,
		transaction_type_id int NULL,
		transaction_type varchar(50) NULL,
		transaction_date datetime NULL,
		amount numeric(30, 8) NULL,
		balance numeric(30,8) NULL)
select
	@id = 0
select
	@ids = count(*)
from
	#ordered_products
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ordered_products
	where
		id > @id

	select
		@product_id = NULL,
		@product = NULL,
		@begin_balance = NULL,
		@end_balance = NULL
	
	select
		@product_id = product_id
	from
		#ordered_products
	where
		id = @id

	select
		@product = symbol
	from
		products
	where
		product_id = @product_id

	select
		@begin_balance = balance
	from
		#begin_balances
	where
		product_id = @product_id
	if @begin_balance = NULL
		select
			@begin_balance = 0.0

	insert into
		#output(
			style,
			prod)
	values(
		@total_style,
		@product)

	insert into
		#output(
			style,
			transaction_type,
			transaction_date,
			product,
			balance)
	values(
		@subtotal_style,
		"Beginning balance",
		@begin_date,
		@product,
		@begin_balance)

	insert into
		#output(
			style,
			external_account_id,
			account,
			product_id,
			product,
			account_transaction_id,
			transaction_type_id,
			transaction_type,
			transaction_date,
			amount,
			balance)
	select
		style = @style,
		external_account_id = @external_account_id,
		account = @account,
		a.currency_id,
		product = @product,
		a.account_transaction_id,
		a.transaction_type_id,
		b.name,
		a.transaction_date,
		a.amount,
		balance = 0.0
	from
		#account_transactions a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.currency_id = @product_id
	order by
		a.transaction_date,
		a.account_transaction_id

	select
		@xact_id = 0
	select
		@xacts = count(*)
	from
		#output
	where
		product_id = @product_id
	and
		id > @xact_id

	select
		@running_balance = @begin_balance

	while @xacts > 0
	begin
		select
			@xact_id = min(id)
		from
			#output
		where
			product_id = @product_id
		and
			id > @xact_id

		select
			@amount = NULL
		select
			@amount = amount
		from
			#output
		where
			id = @xact_id
		
		select
			@running_balance = @running_balance + @amount

		update
			#output
		set
			balance = @running_balance
		where 
			id = @xact_id

		select
			@xacts = count(*)
		from
			#output
		where
			product_id = @product_id
		and
			id > @xact_id
	end
		
        insert into
                #output(
                        style,
                        transaction_type,
                        transaction_date,
                        product_id,
                        product,
                        balance)
        values(
                @subtotal_style,
                "Ending balance",
                @end_date,
                @product_id,
                @product,
		@running_balance)	

	select
		@ids = count(*)
	from
		#ordered_products
	where
		id > @id
