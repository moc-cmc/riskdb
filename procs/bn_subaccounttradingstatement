	@begin_date = convert(datetime, convert(date, @begin_date))
exec
	r_prevbusinessday
		@begin_date,
		@begin_date output

select
	@begin_date = convert(datetime, convert(date, @begin_date))
select
	@begin_date = dateadd(hour, 17, @begin_date)

select
	@end_date = convert(datetime, convert(date, @end_date))
select
	@end_date = dateadd(hour, 17, @end_date)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end


create table
	#begin_balances(
		product_id int,
		balance numeric(30, 8) NULL)
insert into
	#begin_balances(
		product_id,
		balance)
select
	a.currency_id,
	sum(convert(numeric(30, 8), floor(abs(a.amount) * 100000000) / 100000000 ) * sign(a.amount))
from
	account_transactions a,
	products b
where
	a.currency_id = b.product_id
and
	a.external_account_id = @external_account_id
and
	a.transaction_date < @begin_date
group by
	a.currency_id


create table
	#account_transactions(
		account_transaction_id int,
		entered_by int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		currency_id int,
		amount numeric(30,8),
		note varchar(250) NULL)
insert into
	#account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount,
		note)
select
	account_transaction_id,
	entered_by,
	external_account_id,
	transaction_type_id,
	transaction_date,
	currency_id,
	convert(numeric(30, 8), floor(abs(a.amount) * 100000000) / 100000000 ) * sign(a.amount),
	note
from
	account_transactions a
where
	external_account_id = @external_account_id
and
	transaction_date >= @begin_date
and
	transaction_date < @end_date



/* Get transaction data */

update
	#account_transactions
set
	a.amount = convert(numeric(30, 2), floor(abs(a.amount) * 100) / 100 ) * sign(a.amount)
from
	#account_transactions a,
	products b,
	origination_types b
where
	a.currency_id = b.product_id
and
	b.origination_type_id = b.origination_type_id
and
	b.name = "Fiat"


update
	#account_transactions
set
	a.amount = convert(numeric(30, 8), floor(abs(a.amount) * 100000000) / 100000000 ) * sign(a.amount)
from
	#account_transactions a,
	products b,
	origination_types b
where
	a.currency_id = b.product_id
and
	b.origination_type_id = b.origination_type_id
and
	b.name = "Digital"


/* Account transactions that have settled. Do this so we dont have to worry
   about the name of the transaction type. Ie, FX Settlement, Trade Settlement etc */
create table
	#settlement_transactions(
		account_transaction_id int
)
insert into
	#settlement_transactions
select
	a.product_transaction_id
from
	settle_transaction_trades a,
	#account_transactions b
where
	a.product_transaction_id = b.account_transaction_id
group by
	a.product_transaction_id

insert into
        #settlement_transactions
select
        a.currency_transaction_id
from
        settle_transaction_trades a,
        #account_transactions b
where
        a.currency_transaction_id = b.account_transaction_id
group by
        a.currency_transaction_id

create table
	#settle_transaction_types
(
	transaction_type_id int
)

insert into
	#settle_transaction_types
select
	a.transaction_type_id
from
	#account_transactions a,
	#settlement_transactions b
where
	a.account_transaction_id = b.account_transaction_id
group by
	a.transaction_type_id
	
	

create table
	#settled_trades(
		trade_id int
)


/* We are using a union here, commenting because its uncommon in our codebase */
insert into
	#settled_trades(
		trade_id
)
select
	a.trade_id
from
	settle_transaction_trades a,
	#settlement_transactions b
where
	a.product_transaction_id = b.account_transaction_id 
UNION   
select
        a.trade_id
from
        settle_transaction_trades a,
        #settlement_transactions b
where
        a.currency_transaction_id = b.account_transaction_id

create table
	#trades(
		trade_id int,
		deal_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		internal_account_id int,
		internal_account varchar(30) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_name varchar(50) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
                agency_vs_counterparty varchar(40) NULL,
		broker_id int,
		broker varchar(25) NULL,
		identifier varchar(100) NULL,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity numeric(30, 8) NULL,
		counter_quantity numeric(30, 8) NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date datetime NULL,
		fixing_date datetime NULL,
		db_price float NULL,
		std_price float NULL,
		strategy_id int,
		strategy varchar(30) NULL,
                product_id int NULL,
		currency_id int NULL,
                pd1_eq float NULL,
		pd2_eq float NULL,
		vo float NULL,
                vo_rate float NULL,
		status_id int NULL,
		status varchar(25) NULL
)
insert into
	#trades
(
	trade_id,
	deal_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	external_account,
	external_account_name,
	trader_id,
	trader,
	counterparty_id,
	counterparty,
	contract_id,
	broker_id,
	broker,
	identifier,
	quantity,
	counter_quantity,
        db_price,
	trade_date,
	value_date,
	fixing_date,
	strategy_id,
	strategy,
	status_id,
	status
)
select 
	trade_id = a.trade_id,
	deal_id = a.deal_id,
	trade_type_id = a.trade_type_id,
	internal_account_id = a.internal_account_id,
	external_account_id = a.external_account_id,
	external_account = b.symbol,
	external_account_name = b.name,
	trader_id = a.trader_id,
	trader = d.symbol,
	counterparty_id = a.counterparty_id,
	counterparty = g.name,
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	broker = f.symbol,
	identifier = a.identifier,
	quantity = a.quantity * convert(numeric(30, 8), -1), /* reverse the perspective */
        /* in order to ensure trunctation at 8 decimals, there can be no floats in this calculation so need to ensure everything is numeric */
	/*counter_quantity = convert(numeric(30, 8), convert(numeric(30, 8), a.quantity) * convert(numeric(30, 20), a.price)),  reverse the perspective */
        counter_quanty =  convert(numeric(30, 8), floor(abs(a.quantity) * a.price * 100000000) / 100000000) * sign(a.quantity) ,
        db_price = a.price,
	trade_date = a.trade_date,
	value_date = convert(varchar(12), a.value_date, 112),
	fixing_date = convert(varchar(12), a.fixing_date, 112),
	strategy_id = a.strategy_id,
	strategy = e.name,
	status_id = a.status_id,
	status = h.name
from
	trades a,
	external_accounts b,
	internal_accounts c,
	traders d,
	strategies e,
	brokers f,
	counterparties g,
	statuses h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.status_id = h.status_id
and
	a.external_account_id = @external_account_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.value_date > @begin_date  /* use > instead of >= and dont chop date since begin date is prev day 5pm */
and
	a.value_date <= convert(date, @end_date)  /* only trades settling during the range */
and
	quantity != 0




/*
|  Query contracts, dealt ccy, counter ccy
*/
update 
	#trades
set
	std_contract = b.symbol,
        traded_ccy = g.symbol,
        counter_ccy = f.symbol
from
	#trades a,
	contracts b,
	forwards e,
	products f,
	products g
where
	a.contract_id = b.contract_id
and
	b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#trades
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy)
from
	#trades a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

update
	#trades
set
	std_contract = b.symbol
from
	#trades a,
	contracts b,
	instruments c
where
	a.contract_id =b.contract_id
and
	b.instrument_id = c.instrument_id
and
	c.name in("Option", "Exotic")


