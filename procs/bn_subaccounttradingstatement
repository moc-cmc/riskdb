	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

if @end_date < @begin_date
begin
	select
		status = "Error",
		message = "Begin date is after end date",
		begin_date = @begin_date,
		end_date = @end_date
	return
end

