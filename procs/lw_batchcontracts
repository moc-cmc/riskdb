use
	risk_firsel
go

drop procedure
	lw_batchcontracts
go

create procedure
	lw_batchcontracts
		@login varchar(50),
		@file_name varchar(50)

as

create table
	#output(
		file_name varchar(50),
		contract_id int,
		symbol varchar(50),
		start_date datetime NULL,
		balance float NULL,
		trade_price float NULL,
		maturity_date datetime NULL,
		strategy_id int NULL,
		strategy varchar(50) NULL)
		
insert into
	#output(
		file_name,
		contract_id,
		symbol)
select
        source = a.name,
	b.contract_id,
        account = b.symbol
from
        sources a,
        contracts b,
        source_contracts c
where
        b.contract_id = c.contract_id
and
        a.source_id = c.source_id
and
        a.name = @file_name


create table
	#trades(
		contract_id int,
		quantity float,
		trade_date datetime,
		trade_price float,
		value_date datetime,
		strategy_id int)
insert into
	#trades
select
	a.contract_id,
	min(a.quantity),
	min(a.trade_date),
	min(a.price),
	min(a.value_date),
	min(a.strategy_id)
from
	trades a,
	source_contracts b,
	sources c
where
	a.contract_id = b.contract_id
and
	b.source_id = c.source_id
and
	c.name = @file_name
group by
	a.contract_id

update
	#output
set
	a.start_date = b.trade_date,
	a.balance= b.quantity,
	a.trade_price = b.trade_price,
	a.maturity_date = b.value_date,
	a.strategy_id = b.strategy_id
from
	#output a,
	#trades b
where
	a.contract_id = b.contract_id
	
update
	#output
set
	a.strategy = b.name
from
	#output a,
	strategies b
where
	a.strategy_id = b.strategy_id


select
	file_name,
	symbol,
	start_date,
	balance,
	trade_price,
	maturity_date,
	strategy
from
	#output
order by
	symbol


go
