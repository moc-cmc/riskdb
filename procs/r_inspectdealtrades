insert into
	#deal_attributes(
		deal_id,
		deal_type,
		timestamp,
		edit_deal,
		cancel_deal)
select
	a.deal_id,
	deal_type = b.name,
	a.timestamp,
	edit_deal = "",
	cancel_deal = NULL
from
	deals a,
	deal_types b
where
	a.deal_type_id = b.deal_type_id
and
	a.deal_id = @deal_id

select
	@deal_type = a.name
from
	deal_types a,
	deals b
where
	a.deal_type_id = b.deal_type_id
and
	b.deal_id = @deal_id


select
	@deal_contracts = count(distinct(contract_id))
from
	trades
where
	deal_id = @deal_id
if @deal_contracts = 1
begin
	update
		#deal_attributes
	set
		append_market_fwd = "APPEND MARKET",
		append_client_fwd = "APPEND CLIENT"
end
	

if @deal_type in("Client Forward", "Client Forward+")
begin

	/*	
	insert into
		#meta
	values(
		"Column Link",
		"edit_deal",
		"Edit Client Spot/Fwd",
		NULL)
	*/

	select
		@client_trade_id = min(trade_id)
	from
		trades
	where
		deal_id = @deal_id

	select
		@tally_type = a.name,
		@client_user = c.symbol,
		@dealt_currency = e.symbol,
		@counter_currency = f.symbol,
		@quantity = b.quantity,
		@price = b.price,
		@value_date = b.value_date,
		@fixing_date = b.fixing_date
	from
		trade_types a,
		trades b,
		traders c,
		forwards d,
		products e,
		products f
	where
		a.trade_type_id = b.trade_type_id
	and
		b.trader_id = c.trader_id
	and
		b.contract_id = d.contract_id
	and
		d.product_id = e.product_id
	and
		d.currency_id = f.product_id
	and
		b.trade_id = @client_trade_id

	if sign(@quantity) < 0
	begin
		select
			@client_buys_sells = "Client Buys"
	end
	else
	begin
		select
			@client_buys_sells = "Client Sells"
	end

	update
		#deal_attributes
	set
		tally_type = @tally_type,
		client_user = @client_user,
		client_buys_sells = @client_buys_sells,
		dealt_currency = @dealt_currency,
		counter_currency = @counter_currency,
		quantity = abs(@quantity),
		price = @price,
		value_date = @value_date,
		fixing_date = @fixing_date

	if((select count(*) from trades where deal_id = @deal_id) = 1)
	begin
	
		insert into
        #meta
    	values(
        "Column Link",
        "edit_deal",
        "Edit Client Spot/Fwd",
        NULL)

		update
			#deal_attributes
		set
			edit_deal="EDIT"
	end
	
	
end

