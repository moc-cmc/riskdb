
drop procedure fxa_editcounterpartylimits
go

create procedure fxa_editcounterpartylimits @login varchar(25), 
											@counterparty varchar(100),
											@nop_type varchar(25),
											@nop_limit numeric(30,4),
											@dsl_type varchar(25),
											@dsl_limit numeric(30,4),
											@notice_level float,
											@warning_level float,
											@blocked_level float

as

declare @counterparty_id int
declare @nop_type_id int
declare @dsl_type_id int


select
	@counterparty_id=counterparty_id
from
	counterparties
where
	name=@counterparty

if(@@rowcount < 1)
begin
	select
		err=-1,
		msg="Counterparty not found ", @counterparty

	return

end

select
	@nop_type_id=nop_type_id
from
	nop_types
where
	name=@nop_type

if(@@rowcount < 1)
begin
	select
		err=-1,
		msg="NOP Type not found ", @nop_type

	return
end

select
	@dsl_type_id=dsl_type_id
from
	dsl_types
where
	name=@dsl_type

if(@@rowcount < 1)
begin
	select
		err=-1,
		msg="DSL Type not found", @dsl_type

	return

end

begin tran

	update
		counterparty_limits
	set
		nop_type_id=@nop_type_id,
		dsl_type_id=@dsl_type_id,
		nop_limit=@nop_limit,
		dsl_limit=@dsl_limit,
		notice_level=@notice_level,
		warning_level=@warning_level,
		blocked_level=@blocked_level
	where
		counterparty_id=@counterparty_id

	if(@@rowcount != 1)
	begin
		select
			err=-1,
			msg="Could not update counterparty limit record ", @counterparty

			rollback tran
		
		return

	end

commit tran

exec fxa_counterpartylimits @login, @counterparty
 				
return

go


