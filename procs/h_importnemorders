use
	risk_walrus
go

drop procedure
	h_importnemorders
go

create procedure
	h_importnemorders
		@ord_ads_tx_key varchar(50)=NULL,
		@ord_patient_id varchar(50)=NULL,
		@ord_pharmacy_order_encounter_i varchar(50)=NULL,
		@ord_pharmacy_order_id varchar(50)=NULL
as

declare @ads_tx_key varchar(50)
declare @patient_id varchar(50)
declare @pharmacy_encounter_id varchar(50)
declare @pharmacy_order_id varchar(50)

select
	@ads_tx_key = @ord_ads_tx_key,
	@patient_id = @ord_patient_id,
	@pharmacy_encounter_id = @ord_pharmacy_order_encounter_i,
	@pharmacy_order_id = @ord_pharmacy_order_id


update
	patient_keys
set
	patient_id = @patient_id
where
	ads_key = @ads_tx_key
if @@rowcount = 0
	insert into
		patient_keys(
			ads_key,
			patient_id)
	values
		(@ads_tx_key,
		@patient_id)


go
