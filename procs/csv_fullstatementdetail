/* Calculate Open Trades */
create table
	#open_trades(
		row_kind int,
		contract varchar(25),
		contract_id int NULL,
		value_date datetime NULL,
		trade_id int NULL,
		buy_sell varchar(10) NULL,
		symbol varchar(25),
		counterparty varchar(50) NULL,
		dealt_amount float,
		rate float NULL,
		counter_amount float,
		market_rate float NULL,
		market_value float NULL,
		trade_date datetime NULL,
		style varchar(75))
insert into
	#open_trades(
		row_kind,
		contract,
		contract_id,
		value_date,
		trade_id,
		buy_sell,
		symbol,
		counterparty,
		dealt_amount,
		rate,
		counter_amount,
		trade_date,
		style)
select
	row_kind = 0,
	contract = c.symbol,
	a.contract_id,
	a.value_date,
	a.trade_id,
	buy_sell = case when a.product_qty >= 0 then "Bought" else "Sold" end,
	symbol = c.symbol,
	counterparty = a.counterparty,
	dealt_amount = a.product_qty,
	rate = a.price,
	counter_amount = a.currency_qty,
	a.trade_date,
	style = "background:#FFFFFF;border: 1px solid white"
from
	#trades a,
	#trade_types b,
	contracts c
where
	a.trade_type_id = b.trade_type_id
and
	a.contract_id = c.contract_id
and
	a.value_date >= @end_date
order by
	c.symbol,
	a.trade_id

update
	#open_trades
set
	a.market_rate = b.price,
	a.market_value = ((b.price - a.rate) * a.dealt_amount) * -1.0
from
	#open_trades a,
	bo_prices b
where
	a.contract_id = b.contract_id
and
	convert(date, a.value_date) = convert(date, b.value_date)
and
	convert(date, b.price_date) = convert(date, @end_date)

insert into
	#open_trades (
		row_kind,
		contract,
		symbol,
		dealt_amount,
		counter_amount,
		market_value,
		style
	)
select
	row_kind = 1,
	contract,
	symbol = "<b>Total</b>",
	dealt_amount = sum(dealt_amount),
	counter_amount = sum(counter_amount),
	market_value = sum(market_value),
	style = "background:#fff;border:1px solid white;height:2em;font-weight:bold"
from
	#open_trades
group by
	contract

