		instrument varchar(50) NULL,
		exchange varchar(50) NULL,
		value_date datetime NULL,
		original_qty float NULL,
		open_amount float NULL,
		price float NULL,
		current_price float NULL,
		currency_id int NULL,
		currency varchar(50) NULL,
		unrealized_pl float NULL)
insert into
	#open_perps(
		style,
		trade_id,
		trade_date,
		external_account_id,
		account,
		contract_id,
		symbol,
		expiry_type,
		instrument,
		exchange,
		value_date,
		open_amount,
		price,
		current_price,
		currency_id,
		currency,
		unrealized_pl)
select
	style = "background:#FFFFFF;border: 1px solid white",
	a.trade_id,
	a.trade_date,
	a.external_account_id,
	b.symbol,
	a.contract_id,
	c.symbol,
	"Perpetual",
	"Future",
	h.name,
	a.value_date,
	a.open_amount,
	a.price,
	a.current_price,
	a.currency_id,
	d.symbol,
	a.unrealized_pl
from
	eod_open_trades a,
	#external_accounts b,
	contracts c,
	products d,
	future_contracts e,
	futures f,
	future_types g,
	exchanges h
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.currency_id = d.product_id
and
	c.contract_id = e.contract_id
and
	e.future_id = f.future_id
and
	f.future_type_id = g.future_type_id
and
	f.exchange_id = h.exchange_id
and
	g.name in("Val Date", "Perpetual")
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	convert(date, a.eod_date) = convert(date, @end_date)
order by
	a.id

update
	#open_perps
set
	a.original_qty = b.quantity,
	a.trade_date = b.trade_date
from
	#open_perps a,
	trades b
where
	a.trade_id = b.trade_id


create table
	#net_perp_unrealized(
		external_account_id int,
		currency_id int,
		unrealized_pl float NULL)
insert into
	#net_perp_unrealized(
		external_account_id,
		currency_id,
		unrealized_pl)
select
	external_account_id,
	currency_id,
	sum(unrealized_pl)
from
	#open_perps
group by
	external_account_id,
	currency_id

update
	#net_activity
set
	a.open_position = a.open_position + b.unrealized_pl
from
	#net_activity a,
	#net_perp_unrealized b
where
	a.product_id = b.currency_id
and
	a.external_account_id = b.external_account_id

update
	#net_activity
set
	total_equity = closing_balance + unsettled_prem + open_position + open_option_pos

update
	#equity_value_summary
set
	a.total_equity = b.total_equity
from
	#equity_value_summary a,
	#net_activity b
where
	a.product_id = b.product_id
and
	a.external_account_id = b.external_account_id /* MARKR */

update
	#equity_value_summary
set
	converted_value = total_equity * conversion_rate



