	style varchar(50) NULL,
	account varchar(50) NULL,
	product varchar(50) NULL,
	total_equity float NULL,
	conversion_rate float NULL,
	converted_value float NULL,
	evaluation_ccy varchar(10) NULL
)
insert into
	#equity_summary_output(
		section,
		style,
		account,
		product,
		total_equity,
		conversion_rate,
		converted_value,
		evaluation_ccy
)
select
	section = "Equity Value Summary",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
	product = c.symbol,
	a.total_equity,
	a.conversion_rate,
	a.converted_value,
	evaluation_ccy = d.symbol
from
	#equity_value_summary a,
	external_accounts b,
	products c,
	products d
