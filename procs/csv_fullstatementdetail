create table
	#closed_cfd_trades(
		row_kind int,
		round_turn_id int NULL,
		trade_date datetime NULL,
		contract_id int NULL,
		contract varchar(50) NULL,
		expiry_type varchar(50) NULL,
		instrument varchar(50) NULL,
		exchange varchar(50) NULL,
		external_account_id int NULL,
		entry_trade_id int NULL,
		entry_date datetime NULL,
		entry_quantity numeric(30,4) NULL,
		entry_price float NULL,
		exit_trade_id int NULL,
		exit_date datetime NULL,
		exit_quantity numeric(30,4) NULL,
		exit_price float NULL,
		currency_id int NULL,
		currency varchar(20) NULL,
		realized_pl float NULL,
		style varchar(100) NULL
)


insert into
	#closed_cfd_trades(
		row_kind,
		round_turn_id,
		trade_date,
		contract_id,
		contract,
		expiry_type,
		instrument,
		exchange,
		external_account_id,
		entry_trade_id,
		entry_date,
		entry_quantity,
		entry_price,
		exit_trade_id,
		exit_date,
		exit_quantity,
		exit_price,
		currency_id,
		currency,
		realized_pl,
		style)
select
	row_kind = 0,
	round_turn_id = a.round_turn_id,
	trade_date = a.trade_date,
	contract_id = a.contract_id,
	contract = c.symbol,
	"Perpetual",
	"Future",
	h.name,
	external_account_id = a.external_account_id,
	entry_trade_id = a.entry_trade_id,
	entry_date = a.entry_date,
	entry_quantity = a.entry_quantity,
	entry_price = a.entry_price,
	exit_trade_id = a.exit_trade_id,
	exit_date = a.exit_date,
	exit_quantity = a.exit_quantity,
	exit_price = a.exit_price,
	currency_id = a.currency_id,
	currency = b.symbol,
	realized_pl = a.realized_pl,
	style = "background:#fff"
from
	round_turns a,
	products b,
	contracts c,
	#external_accounts d,
	future_contracts e,
	futures f,
	future_types g,
	exchanges h
where
	a.currency_id = b.product_id
and
	a.contract_id = c.contract_id
and
	c.contract_id = e.contract_id
and
	e.future_id = f.future_id
and
	f.future_type_id = g.future_type_id
and
	a.external_account_id = d.external_account_id
and
	g.name in("Val Date", "Perpetual")
and
	f.exchange_id = h.exchange_id
and
	a.trade_date > @begin_date
and
	a.trade_date <= @end_date
order by
	a.round_turn_id

insert into
	#closed_cfd_trades(
		row_kind,
		contract,
		currency,
		realized_pl,
		style)
select
	row_kind = 1,
	contract,
	currency,
	realized_pl = sum(realized_pl),
	style = "background:#fff;border:1px solid white;height:2em;font-weight:bold"
from
	#closed_cfd_trades
group by
	currency,
	contract

create table
	#open_perps(
