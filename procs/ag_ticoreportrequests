drop procedure
	ag_ticoreportrequests
go

create procedure
	ag_ticoreportrequests
		@login varchar(50),
		@tico_report varchar(200),
		@run varchar(50)
as

declare @tico_account_id int
declare @admin_level int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @tico_report_id int
declare @run_id int
declare @begin_date datetime
declare @end_date datetime

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"assign",
	"Assign Request Custodial Account",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"reject",
	"Reject Client Request",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"next_action",
	"Approve Next Request Action",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"enable_user",
	"Enable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"disable_user",
	"Disable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"action",
	"Resend Tico Report Request",
	NULL) 

insert into
        #meta
values( 
        "Column Link",
        "request_new_report",
        "Request Report For Run",
        NULL)

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta


/*
if @run_date = NULL
begin
        select
                @run_date = getdate()
        select
                @run_date = convert(date, @run_date)
end

exec
        r_daterangefordate
                @run_date,
                @begin_date output,
                @end_date output
*/

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end


select
	@tico_report_id = tico_report_id
from
	tico_reports
where
	name = @tico_report
if @tico_report_id = NULL
begin
	select
		status = "Error",
		message = "Tico report not found",
		tico_report = @tico_report
	return
end

select
	@run_id = run_id
from
	runs
where
	name = @run
if @run_id = NULL
begin
	select
		status = "Error",
		message = "Run not found",
		run = @run
	return
end

/*
create table
	#output(
		tico_report_request_id int,
		tico_report varchar(100),
		as_of_date datetime,
		request_date datetime,
		status varchar(50),
		status_id int,
		error varchar(250) NULL,
		modify_date datetime NULL,
		filename varchar(100) NULL,
		params varchar(150) NULL,
		url varchar(150) NULL,
		style varchar(100) NULL)

insert into
	#output(
		style,
		tico_report_request_id,
		tico_report,
		as_of_date,
		request_date,
		status,
		status_id,
		error,
		modify_date,
		filename,
		params,
		url)
*/

select
	style = @style,
	request_new_report = "Request New Report",
	run = @run,
	tico_report = @tico_report
	


select
	style = @style,
	section = "Requested Reports",
	a.tico_report_request_id,
	tico_report = b.name,
	run = d.name,
	a.as_of_date,
	a.request_date,
	status = c.name,
	a.error,
	a.modify_date,
	a.filename,
	a.params,
	a.url,
	action = "Resend Report"
from
	tico_report_requests a,
	tico_reports b,
	statuses c,
	runs d
where
	a.tico_report_id = b.tico_report_id
and
	a.status_id = c.status_id
and
	b.run_id = d.run_id
and
	b.name = @tico_report
and
	b.run_id = @run_id
order by
	a.request_date DESC


go
