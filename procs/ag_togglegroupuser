drop procedure
	ag_togglegroupuser
go

create procedure
	ag_togglegroupuser
		@login varchar(50),
		@mc_group varchar(100),
		@mc_login varchar(50)
as

declare @tico_account_id int
declare @group_id int

select
	@group_id = group_id
from
	groups
where
	name = @mc_group
if @group_id = NULL
begin
	select
		status = "Error",
		message = "Group name not found",
		mc_group = @mc_group
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @mc_login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "MC Login not found",
		mc_login = @mc_login
	return
end

delete

from
	group_accounts
where
	tico_account_id = @tico_account_id
and
	group_id = @group_id
if @@rowcount = 0
begin
	insert into
		group_accounts(
			group_id,
			tico_account_id)
	values(
		@group_id,
		@tico_account_id)
end

exec
	ag_groupshome
		@login = @login,
		@group_name = @mc_group

go
