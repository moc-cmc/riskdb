		unrealized_pl float NULL,
		total_pl float NULL)
insert into
	#currency_sum_output(
		style,
		currency,
		realized_pl,
		unrealized_pl,
		total_pl)
select
	style = @style,
	b.symbol,
	a.realized_pl,
	a.unrealized_pl,
	a.total_pl
from
	#currency_sum a,
	products b
where
	a.currency_id = b.product_id
order by
	b.symbol

select
	section = "Summary By Currency",
	style,
	currency,
	realized_pl,
	unrealized_pl,
	total_pl
from
	#currency_sum_output
order by
	id

select
	section = "Summary By Contract",
	style,
	symbol,
	currency,
	quantity,
	realized_pl,
	unrealized_pl,
	equiv
from
	#summary_output
order by
	id

select
	section = "Futures Realized P&L",
	style = @style,
	a.identifier,
	a.entry_trade_id,
	a.entry_date,
	a.entry_quantity,
	b.symbol,
	a.entry_price,
	a.exit_trade_id,
	a.exit_date,
	a.exit_quantity,
	a.exit_price,
	contract_size = a.multiplier,
	realized_pl = a.p_l,
	currency = c.symbol
from
	#round_turns a,
	contracts b,
	products c
where
	a.contract_id = b.contract_id
and
	a.currency_id = c.product_id
/* and
	convert(date, a.exit_date) >= convert(date, @trade_date) */
order by
	a.entry_trade_id

delete
	open_futures
from
	open_futures a,
	#trades b,
	trades c
where
	a.trade_id = b.trade_id
and
	a.trade_id = c.trade_id
and
	b.trade_id = c.trade_id
and
	c.external_account_id = @external_account_id
and
	convert(date, a.settle_date) = convert(date, @trade_date)
and
	a.status_id != @committed_status_id

create table
	#bond_trades(
		trade_id int)
insert into
	#bond_trades
select
	a.trade_id
from
	#trades a,
	future_contracts b,
	futures c,
	bond_attributes d
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id
and
	c.forward_id = d.contract_id
and
	abs(a.remaining) > 0.0
	
select
	@trade_id = 0
select
	@trades = count(*)
from
	#bond_trades
where
	trade_id > @trade_id
while @trades > 0
begin
	select
		@trade_id = min(trade_id)
	from
		#bond_trades
	where
		trade_id > @trade_id

	select
		@open_trade_value = NULL,
		@open_end_value = NULL

	select
		@contract_id = contract_id,
		@quantity = remaining,
		@price = price,
		@current_price = current_price
	from
		#trades
	where
		trade_id = @trade_id

	exec
		r_futpospricevalue
			@contract_id,
			@quantity,
			@price,
			@open_trade_value output
	exec
		r_futpospricevalue
			@contract_id,
			@quantity,
			@current_price,
			@open_end_value output

	/* select
		trade_id = @trade_id,
		contract_id = @contract_id,
		quantity = @quantity,
		price = @price,
		open_trade_value = @open_trade_value,
		open_end_value = @open_end_value */
	
	update
		#trades
	set
		begin_value = @open_trade_value,
		end_value = @open_end_value,
		unrealized_pl = (@open_end_value - @open_trade_value) * -1.0
	where
		trade_id = @trade_id

	update
		#trades
	set
		total_pl = realized_pl + unrealized_pl
	where
		trade_id = @trade_id

	select
		@trades = count(*)
	from
		#bond_trades
	where
		trade_id > @trade_id
end


update
	#trades
set
	a.equiv = a.unrealized_pl * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id
	
insert into
	open_futures
select
	trade_id,
	settle_date = convert(datetime, convert(date, @trade_date)),
	remaining,
	current_price,
	unrealized_pl,
	status_id = @review_status_id,
	equiv 
from
	#trades
where
	abs(remaining) > 0.0
and
	trade_id not in(
		select
			trade_id
		from
			open_futures
		where
			convert(date, settle_date) = convert(date, @trade_date))

	

select
	section = "Futures Open Trades",
	style = @style,
	a.trade_id,
	a.trade_date,
	b.symbol,
	currency = c.symbol,
	contract_size = a.multiplier,
	a.price,
	a.quantity,
	a.remaining,
	a.current_price,
	a.realized_pl,
	a.unrealized_pl,
	a.total_pl,
	a.equiv
from
	#trades a,
	contracts b,
	products c
where
	a.contract_id = b.contract_id
and
	a.currency_id = c.product_id
and
	a.remaining > 0.0 
order by
	b.symbol,
	a.id




