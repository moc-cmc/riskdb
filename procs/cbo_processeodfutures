insert into
	#trades(
		trade_id,
		trade_date,
		contract_id,
		currency_id,
		multiplier,
		price,
		quantity)
select
	a.trade_id,
	b.trade_date,
	b.contract_id,
	e.currency_id,
	d.quantity,
	b.price,
	a.remaining
from
	open_futures a,
	trades b,
	future_contracts c,
	futures d,
	forwards e
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	c.future_id = d.future_id
and
	d.forward_id = e.contract_id
and
	convert(date, a.settle_date) = convert(date, @prev_date)
order by
	b.trade_date,
	a.trade_id

insert into
	#trades(
		trade_id,
		trade_date,
		contract_id,
		currency_id,
		multiplier,
		price,
		quantity)
select
	a.trade_id,
	a.trade_date,
	a.contract_id,
	d.currency_id,
	c.quantity,
	a.price,
	a.quantity
from
	trades a,
	future_contracts b,
	futures c,
	forwards d
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id
and
	c.forward_id = d.contract_id
and
	convert(date, a.trade_date) <= convert(date, @trade_date)
and
	convert(date, a.trade_date) > convert(date, @prev_date)
and
	a.quantity != 0.0
order by
	a.trade_date,
	a.trade_id
	

update
	#trades
set
	remaining = quantity,
	realized_pl = 0.0,
	unrealized_pl = 0.0


update
	#trades
set
	a.current_price = b.price
from
	#trades a,
	prices b
where
	a.contract_id = b.contract_id
and
	convert(date, b.price_date) = convert(date, @trade_date)

/* For standard Futures */

update
	#trades
set
	unrealized_pl = (current_price - price) * quantity * multiplier


select
	@id = 0
select
	@ids = count(*)
from
	#trades
where
	convert(date, trade_date) = convert(date, @trade_date)
and
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#trades
	where
		convert(date, trade_date) = convert(date, @trade_date)
	and
		id > @id


	select
		@current_trade_id = trade_id,
		@current_trade_date = trade_date,
		@multiplier = multiplier,
		@contract_id = contract_id,
		@currency_id = currency_id,
		@current_quantity = remaining,
		@current_price = price
	from
		#trades
	where
		id = @id


	select
		@closing_fills = @current_quantity

	while abs(@closing_fills) > 0
	begin
			
		select
			@entry_id = NULL,
			@entry_remaining = NULL,
			@exit_remaining = NULL,
			@realized_pl = NULL,
			@rt_id = NULL,
			@rt_entry = NULL,
			@rt_exit = NULL,
			@rt_begin_value = NULL,
			@rt_end_value = NULL

		select
			@entry_id = min(id)
		from
			#trades
		where
			contract_id = @contract_id
		and
			sign(remaining) = sign(@current_quantity) * -1.0
		and
			remaining != 0.0
		and
			id < @id

		if @entry_id = NULL
			select
				@closing_fills = 0
		else
		begin

			select
				@entry_trade_id = trade_id,
				@entry_date = trade_date,
				@entry_quantity = remaining,
				@entry_price = price
			from
				#trades
			where
				id = @entry_id
	
			if abs(@entry_quantity) >= abs(@closing_fills)
			begin
				select
					@closed_qty = abs(@closing_fills)
			end
			else
			begin
				select
					@closed_qty = abs(@entry_quantity)
			end

			select
				@rt_entry = @closed_qty * sign(@entry_quantity),
				@rt_exit = @closed_qty * sign(@current_quantity)

	
			exec
				r_futpospricevalue
					@contract_id,
					@rt_entry,
					@entry_price,
					@rt_begin_value output
			if @rt_begin_value = NULL
				select
					@rt_begin_value = @entry_price * @multiplier * @rt_entry

			exec
				r_futpospricevalue
					@contract_id,
					@rt_exit,
					@current_price,
					@rt_end_value output
			if @rt_end_value = NULL
				select
					@rt_end_value = @current_price * @multiplier * @rt_exit


			if @entry_quantity > 0.0
			begin
				select
					/* @realized_pl = (@current_price - @entry_price) * (@closed_qty * sign(@entry_quantity)  * @multiplier) */
					@realized_pl = abs(@rt_end_value) - abs(@rt_begin_value)
			end
			if @entry_quantity < 0.0
			begin
				select
					/* @realized_pl = (@entry_price - @current_price) * (@closed_qty * sign(@current_quantity) * @multiplier)  */
					@realized_pl = abs(@rt_begin_value) - abs(@rt_end_value)
			end


			insert into
				#round_turns(
					contract_id,
					entry_trade_id,
					entry_date,
					entry_quantity,
					entry_price,
					entry_value,
					exit_trade_id,
					exit_date,
					exit_quantity,
					exit_price,
					exit_value,
					multiplier,
					p_l,
					currency_id)
			values(
				@contract_id,
				@entry_trade_id,
				@entry_date,	
				@closed_qty * sign(@entry_quantity),
				@entry_price,
				@rt_begin_value,
				@current_trade_id,
				@current_trade_date,
				@closed_qty * sign(@current_quantity),
				@current_price,
				@rt_end_value,
				@multiplier,
				@realized_pl,
				@currency_id)
			select
				@rt_id = @@identity

			select
				@entry_remaining = remaining
			from
				#trades
			where
				id = @entry_id
			select
				@exit_remaining = remaining
			from
				#trades
			where
				id = @id

			select
				@identifier = rtrim(convert(varchar(30), @entry_trade_id)) + "-" + rtrim(convert(varchar(50), convert(int, abs(@closed_qty)))) + "-" + rtrim(convert(varchar(30), convert(int, abs(@entry_remaining)))) + "-" + rtrim(convert(varchar(30), @current_trade_id))

			update
				#round_turns
			set
				identifier = @identifier
			where
				id = @rt_id

			select
				@round_turn_id = NULL
			select
				@round_turn_id = round_turn_id
			from
				round_turns
			where
				identifier = @identifier
			if @round_turn_id = NULL
			begin
				exec
					j_nextkey
						"round_turns",
						@round_turn_id output

				exec
					j_nextkey
						"account_transactions",
						@account_transaction_id output


				begin tran
					insert into
						round_turns(
							round_turn_id,
							external_account_id,
							contract_id,
							identifier,
							entry_trade_id,
							entry_date,
							entry_quantity,
							entry_price,
							entry_value,
							exit_trade_id,
							exit_date,
							exit_quantity,
							exit_price,
							exit_value,
							multiplier,
							p_l,
							currency_id)
					select
						round_turn_id = @round_turn_id,
						external_account_id = @external_account_id,
						contract_id,
						identifier,
						entry_trade_id,
						entry_date,
						entry_quantity,
						entry_price,
						entry_value,
						exit_trade_id,
						exit_date,
						exit_quantity,
						exit_price,
						exit_value,
						multiplier,
						p_l,
						currency_id
					from
						#round_turns
					where
						id = @rt_id
					if @@rowcount != 1
					begin
						select
							status = "Error",
							message = "Unable to add round turn",
							round_turn = @identifier
						rollback tran
						return
					end

					insert into
						account_transactions(
							account_transaction_id,
							entered_by,
							external_account_id,
							transaction_type_id,
							transaction_date,
							amount,
							currency_id)
					values(
						@account_transaction_id,
						@tico_account_id,
						@external_account_id,
						@transaction_type_id,
						@current_trade_date,
						@realized_pl,
						@currency_id)
					if @@rowcount != 1
					begin
						select
							status = "Error",
							message = "Unable to add ledger entry for realized PL",
							identifier = @identifier
						rollback tran
						return
					end

					insert into
						transaction_round_turns(
							account_transaction_id,
							round_turn_id)
					values(
						@account_transaction_id,
						@round_turn_id)
					if @@rowcount != 1
					begin
						select
							status = "Error",
							message = "Unable to associate round turn to ledger entry",
							identifier = @identifier
						rollback tran
						return
					end
				commit tran



					

				



			end
	
			if @closing_fills > 0.0
			begin
				update
					#trades
				set
					remaining = remaining + @closed_qty
				where
					id = @entry_id
				update
					#trades
				set
					remaining = remaining - @closed_qty
				where
					id = @id
			end
			if @closing_fills < 0.0
			begin
				update
					#trades
				set
					remaining = remaining - @closed_qty
				where
					id = @entry_id
				update
					#trades
				set
					remaining = remaining + @closed_qty
				where
					id = @id
			end

			/* select
				id = @id,
				entry_id = @entry_id,
				current_trade_id = @current_trade_id,
				contract_id = @contract_id,
				current_quantity = @current_quantity,
				closing_fills = @closing_fills,
				closed_qty = @closed_qty

			   MARKR */

			if @closing_fills > 0
				select
					@closing_fills = @closing_fills - @closed_qty
			if @closing_fills < 0
				select
					@closing_fills = @closing_fills + @closed_qty
		end
	end		

				
	select
		@ids = count(*)
	from
		#trades
	where
		convert(date, trade_date) = convert(date, @trade_date)
	and
		id > @id
end

/* update
	#round_turns
set
	p_l = (exit_price - entry_price) * (entry_quantity * multiplier)
where
	entry_quantity > 0

update
	#round_turns
set
	p_l = (entry_price - exit_price) * (exit_quantity * multiplier)
where
	entry_quantity < 0 */

create table
	#net_realized(
		exit_trade_id int,
		realized_pl float NULL)
insert into
	#net_realized
select
	exit_trade_id,
	sum(p_l)
from
	#round_turns
group by
	exit_trade_id

update
	#trades
set
	unrealized_pl = (current_price - price) * remaining * multiplier


update
	#trades
set
	a.realized_pl = b.realized_pl
from
	#trades a,
	#net_realized b
where
	/* a.trade_id = b.entry_trade_id MARKR */
	a.trade_id = b.exit_trade_id

update
	#trades
set
	total_pl = realized_pl + unrealized_pl

update
	#trades
set
	equiv = total_pl
where
	currency_id = @evaluation_currency_id

update
	#trades
set
	a.equiv = a.total_pl * c.price
from
	#trades a,
	forwards b,
	bo_prices c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, @trade_date) = convert(date, c.price_date)


update
	#trades
set
	a.equiv = a.total_pl * (1.0 / c.price)
from
	#trades a,
	forwards b,
	bo_prices c
where
	a.currency_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, @trade_date) = convert(date, c.price_date)
and
	a.equiv = NULL

