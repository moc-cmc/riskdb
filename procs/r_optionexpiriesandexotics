create procedure
	r_optionexpiriesandexotics
		@login varchar(50),	
		@run_name varchar(50),
		@run_date datetime=NULL
		
as

declare @source_id int
declare @run_id int
declare @begin_date datetime
declare @end_date datetime
declare @begin_day_string char(20)
declare @end_day_string char(20)


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @run_date = NULL
	select
		@run_date = getdate()

select
	@begin_date = @run_date

if datepart(hour, @begin_date) >= 17
        exec
                r_nextbusinessday
                        @begin_date,
                        @begin_date output

select
        @begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
        convert(char(2), datepart(day, @begin_date)) + "/" +
        convert(char(4), datepart(year, @begin_date))
select
        @begin_date = convert(datetime, @begin_day_string)

exec
        r_prevbusinessday
                @begin_date,
                @begin_date output

select
        @begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)


