/*
 | Query Exotic Info
 */

update
        #trades
set
        exotic_exercise_style_id = b.exercise_style_id,
        exotic_exercise_style = c.name,
        exotic_strike = b.strike,
        exotic_put_call = b.put_call,
        exotic_option_expiration_id = b.option_expiration_id,
	exotic_timing_id = b.timing_id,
	exotic_payout_ccy_id = b.payout_ccy_id,
	exotic_payout_amount = b.payout_amount,
	exotic_barrier_type_id = b.barrier_type_id,
	exotic_lower_barrier = b.lower_barrier,
	exotic_upper_barrier = b.upper_barrier,
	exotic_barrier = b.barrier,
	exotic_instrument_id = b.exotic_instrument_id
from
        #trades a,
        exotic_contracts b,
        exercise_styles c
where
        a.contract_id = b.contract_id
and
	b.exercise_style_id = c.exercise_style_id

update
        #trades
set
        option_id = b.option_id,
        optexp_symbol = b.symbol,
        optexp_expiration = b.expiration,
        optexp_timezone_id = b.timezone_id
from
        #trades a,
        option_expirations b
where
        a.exotic_option_expiration_id = b.option_expiration_id

update
        #trades
set
        optexp_time_zone = b.timezone,
        optexp_tz_symbol = b.symbol,
        optexp_tz_expiration_time = b.expiration_time,
        optexp_tz_display_value = b.display_value,
        optexp_tz_status = b.status
from
        #trades a,
        timezones b
where
        a.optexp_timezone_id = b.timezone_id
	

update
	#trades
set
	exotic_instrument = b.name
from
	#trades a,
	exotic_instruments b
where
	a.exotic_instrument_id = b.exotic_instrument_id

update
	#trades
set
	exotic_timing = b.timing
from
        #trades a,
        timings b
where
	a.exotic_timing_id = b.timing_id

update
	#trades
set
	exotic_barrier_type = b.barrier
from
        #trades a,
	barrier_types b
where
	a.exotic_barrier_type_id = b.barrier_type_id

update
	#trades
set
	exotic_payout_ccy = b.symbol
from
	#trades a,
	products b
where
	a.exotic_payout_ccy_id = b.product_id

/* -- Done with exotic querying --*/




