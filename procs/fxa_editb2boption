
if object_id("fxa_editb2boption") != NULL
    drop procedure
        fxa_editb2boption
go

create procedure
	fxa_editb2boption
		@login varchar(50),
		@deal_id int,
		@client_user varchar(50),
		@client_buys_sells varchar(25),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@biproduct varchar(50),
		@expiration datetime,
		@timezone varchar(25),
		@option_settlement datetime,
		@strike numeric(30,6),
		@call_put varchar(10),
		@spot_reference float,
		@client_price float,
		@client_format varchar(10),
                @client_premium_currency varchar(10),
		@client_total_premium float,
		@client_premium_settle datetime,
		@market_price float,
		@market_format varchar(10),
                @market_premium_currency varchar(10),
		@market_total_premium float,
		@market_premium_settle datetime



as


declare @client_external_account varchar(50)
declare @client_quantity numeric(30,4)
declare @client_pips_price float
declare @client_pct_price float
declare @market_external_account varchar(50)
declare @market_quantity numeric(30,4)
declare @market_pips_price float
declare @market_pct_price float
declare @contract_id int
declare @symbol varchar(50)
declare @client_trade_id int
declare @market_trade_id int
declare @trade_date datetime
declare @market_sales_code varchar(25)

select
	@trade_date = getdate()

select
	@client_external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

if @client_format = "Pct"
begin
	select
		@client_pips_price = (@client_price / 100.0) * @spot_reference,
		@client_pct_price = @client_price / 100.0
end
else
begin
	select
		@client_pips_price = @client_price,
		@client_pct_price = NULL
end


if @client_buys_sells = "Client Buys"
begin
	select
		@client_quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@client_quantity = abs(@quantity)
end

select
	@market_quantity = @client_quantity * -1.0


if @market_format = "Pct"
begin
	select
		@market_pips_price = (@market_price / 100.0) * @spot_reference,
		@market_pct_price = @market_price / 100.0
end
else
begin
	select
		@market_pips_price = @market_price,
		@market_pct_price = NULL
end

/* select
	@market_external_account = a.symbol
from
	external_accounts a,
	counterparties b
where
	a.external_account_id = b.external_account_id
and
	b.name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Cannot determine default external account for counterparty",
		counterparty = @counterparty
	return
end */

select
	@market_sales_code = "None"

exec
	r_spotoptioncontract
		@biproduct,
		@timezone,
		@expiration,
		@call_put,
		@strike,
		@option_settlement,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

select
	@client_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
and
	a.deal_id = @deal_id
if @client_trade_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve client trade id"
	return
end

select
	@market_trade_id = a.trade_id
from
	trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Counterparty"
and
	a.deal_id = @deal_id

if @market_trade_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve market trade id"
	return
end

exec
        r_inserttradeedit @client_trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @client_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Option",
		@deal_type = "B2B Option",
		@trade_type = "Option",
		@external_account = @client_external_account,
		@quantity = @client_quantity,
		@symbol = @symbol,
		@value_date = @option_settlement,
		@price = @client_pips_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@premium = @client_total_premium,
                @premium_currency = @client_premium_currency,
		@prem_settle_date = @client_premium_settle,
		@pct_price = @client_pct_price

if(@quantity = 0)
begin
        exec
                r_updatetradenotification @client_trade_id, "Cancelled"
end
else
begin
        exec
                r_updatetradenotification @client_trade_id, "Edit" 
end

exec
        r_inserttradeedit @market_trade_id

exec
	fxa_edittrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @market_trade_id output,
		@deal_id = @deal_id,
		@tally_type = "Option",
		@deal_type = "B2B Option",
		@trade_type = "Option",
		@counterparty = @counterparty,
		@quantity = @market_quantity,
		@symbol = @symbol,
		@value_date = @option_settlement,
		@price = @market_pips_price,
		@trade_date = @trade_date,
		@sales_code = @market_sales_code,
		@premium = @market_total_premium,
		@premium_currency = @market_premium_currency,
		@prem_settle_date = @market_premium_settle,
		@pct_price = @market_pct_price


if(@quantity = 0)
begin
        exec
                r_updatetradenotification @market_trade_id, "Cancelled"
end
else
begin
        exec
                r_updatetradenotification @market_trade_id, "Edit"
end

exec
	r_inspectdealtrades
		@login,
		@deal_id

go
