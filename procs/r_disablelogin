
drop procedure
	r_disablelogin
go

create procedure 
	r_disablelogin 
		@login varchar(25), 
		@login_name varchar(25) 

as

declare @account_id int
declare @disable_password varchar(20)
declare @disable_account_type_id int
declare @tico_database varchar(100)
declare @tico_server varchar(100)
declare @sql_string varchar(200)

select
	@account_id=account_id
from
	tico_accounts
where
	login=@login_name

if @@rowcount < 1
begin
	select
		status="Error",
		msg="Login does not exist",
		login_name=@login_name

	return
end

select
	@disable_account_type_id=login_type_id
from
	login_types
where
	name="Disabled"

if @@rowcount < 1
begin
	select
		status="Error",
		msg="Login type 'Disabled' does not exist"
	return
end

exec
	r_genrandompassword 20, @disable_password output

begin tran
	
	update
		tico_accounts
	set
		password=@disable_password
	where
		account_id=@account_id

	if @@rowcount != 1
	begin
		select
			status="Error",
			msg="Login not disabled",
			login_name=@login_name

		rollback tran
			
		exec r_managelogins @login
	
		return
	end
	else
	begin
		
		update
			tico_account_types
		set
			login_type_id=@disable_account_type_id
		where
			tico_account_id=@account_id
			
		if @@rowcount != 1
		begin
			select
				status="Error",
				msg="Could not set login to disabled",
				login_name=@login_name

			rollback tran

			exec r_managelogins @login
		
			return
		end

		delete from 
			mc_desktop_overrides
		where
			tico_account_id=@account_id

	end

			
commit tran

select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds

if (@@rowcount != 1)
begin
	select
		status="Warning",
	 	msg="Could not find tico server or database for remote disable in tico db"
end

select
        @sql_string = "exec " + rtrim(@tico_database) + "..ti_changepasswd '" + rtrim(@login_name) + "', '" + rtrim(@disable_password) + "'"

exec
        sp_remotesql
                @tico_server,
                @sql_string

select
	status="Success",
	msg="Login disabled",
	login=@login_name

exec
	r_managelogins @login


go


