/* -- This code block shows configured and unconfigured users in one section -- */

create table
	#output
(
	run_name varchar(50),
	tico_account_id int,
        login varchar(100),
	user_name varchar(50),
	account_type varchar(50) NULL,
	has_access char(1) NULL,
	grant_access varchar(25) NULL,
	revoke_access varchar(25) NULL,
	access_group varchar(50) NULL
)

insert into 
	#output
select
	@run_name,
	account_id,
	login,
	login,
	NULL,
	NULL,
	"GRANT",
	NULL,
	NULL
from
	tico_accounts


update
	#output
set
        account_type = b.name
from
        #output a,
        login_types b,
        tico_account_types c
where
        a.tico_account_id = c.tico_account_id
and
        c.login_type_id = b.login_type_id

	
update 
	#output
set
	revoke_access = "REVOKE",
	grant_access = NULL,
	has_access = "Y"
from
	#output a,
	user_runs b
where
	a.tico_account_id = b.tico_account_id 
and
	b.run_id = @run_id

update
	#output
set
	login = rtrim(login)+" &nbsp;&nbsp;<b>*"+rtrim(c.name)+"</b>",
	access_group = c.name
from
	#output a,
	access_group_accounts b,
	access_groups c
where
	a.tico_account_id = b.tico_account_id
and
	b.access_group_id = c.access_group_id



select 
	section = "Account Access",
	run_name,
	login,	
	account_type,
	user_name,
	has_access,
	grant_access,
	revoke_access,
	access_group
from
	#output
order by
	access_group DESC,
	user_name


go 

