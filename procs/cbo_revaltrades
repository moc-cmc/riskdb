
if object_id("cbo_revaltrades") != NULL
    drop procedure
        cbo_revaltrades
go

create procedure
	cbo_revaltrades
		@login varchar(30),
		@trade_date datetime=NULL
                /*,
		@source varchar(50),
		@evaluation_currency varchar(20)=NULL,
		@overwrite char(2)=NULL */
as

declare @source varchar(50)
declare @evaluation_currency varchar(20)
declare @overwrite  char(2)
declare @fund_type varchar(50)

declare @unresolvable_premiums int
declare @evaluation_currency_id int
declare @begin_date datetime
declare @end_date datetime
declare @committed_status_id int
declare @committed_trades int
declare @processing_trades int
declare @processing_status_id int
declare @source_id int

declare @ids int
declare @id int
declare @net_position numeric(30,4)

declare @trade_id int
declare @contract_id int
declare @inverted_contract_id int
declare @instrument varchar(20)
declare @value_date datetime
declare @days float
declare @spot_price float
declare @forward_price float
declare @price float
declare @give_product_rate float
declare @get_product_rate float

declare @missing_settles int
declare @missing_conversion_rates int

declare @product_id int
declare @products int
declare @conversion_rate float

select
	@source = "MPT",
	@evaluation_currency = "USD",
	@overwrite = "Y"


exec
	cbo_revaltradeslinks
		@login

if @trade_date = NULL
	select
		@trade_date = getdate()


exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output



if @evaluation_currency = NULL
	select
		@evaluation_currency = "USD"


select
	@evaluation_currency_id = product_id
from
	products
where
	symbol = @evaluation_currency
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Evaluation currency not found",
		evaluation_currency = @evaluation_currency
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

select
	@committed_status_id = status_id
from
	statuses
where
	name = "Committed"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Committed status not found"
	return
end

select
	@processing_status_id = status_id
from
	statuses
where
	name = "Processing"
if @@rowcount = 0
begin
	exec
		j_nextkey
			"statuses",
			@processing_status_id output

	insert into
		statuses
	values(
		@processing_status_id,
		"Processing")
end
	
select
	@committed_trades = count(*)
from
	trade_daily_revals
where
	reval_date = @end_date
and
	status_id = @committed_status_id
and
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id
if @committed_trades != 0
begin
	if @overwrite = "N"
	begin
		select
			id = -1,
			error = "Committed trades already exist for trade date",
			trade_date = @end_date
		return
	end
	else
	begin
		delete

		from
			trade_daily_revals
		where
			reval_date = @end_date
		and
			source_id = @source_id
		and
			evaluation_currency_id = @evaluation_currency_id
	end
end

select
	@processing_trades = count(*)
from
	trade_daily_revals
where
	reval_date = @end_date
and
	status_id = @processing_status_id
if @processing_trades != 0
begin
	select
		id = -1,
		error = "Concurrent reval in progress for date",
		trade_date = @end_date
	return
end


/* Get the spot/forward trades */
insert into
	trade_daily_revals(
		trade_id,
		bo_trade_date,
		source_id,
		status_id,
		contract_id,
		value_date,
		reval_date,
		contract_qty,
		evaluation_currency_id,
		native_currency_id,
		product_id,
		notional_amount)
select
	a.trade_id,
	a.trade_date,
	source_id = @source_id,
	status_id = @processing_status_id,
	a.contract_id,
	a.value_date,
	reval_date = @end_date,
	contract_qty = b.quantity,
	evaluation_currency_id = @evaluation_currency_id,
	native_currency_id = b.currency_id,
	product_id = b.product_id,
	notional_amount = abs(a.quantity * b.quantity)
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	a.quantity != 0
and
	a.value_date >= @begin_date
and
	a.trade_date <= @end_date


/* Get any futures trades */
insert into
	trade_daily_revals(
		trade_id,
		bo_trade_date,
		source_id,
		status_id,
		contract_id,
		value_date,
		reval_date,
		contract_qty,
		evaluation_currency_id,
		notional_amount)
select
	a.trade_id,
	a.trade_date,
	source_id = @source_id,
	status_id = @processing_status_id,
	a.contract_id,
	value_date = b.expiration,
	reval_date = @end_date,
	contract_qty = c.quantity,
	evaluation_currency_id = @evaluation_currency_id,
	notional_amount = abs(a.quantity * c.quantity)
from
	trades a,
	future_contracts b,
	futures c
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id
and
	a.quantity != 0
and
	b.expiration >= @begin_date
and
	a.trade_date <= @end_date

/* Get any unexpired spot option trades */
insert into
	trade_daily_revals(
		trade_id,
		bo_trade_date,
		source_id,
		status_id,
		contract_id,
		value_date,
		reval_date,
		contract_qty,
		evaluation_currency_id,
		notional_amount)
select
	a.trade_id,
	a.trade_date,
	source_id = @source_id,
	status_id = @processing_status_id,
	a.contract_id,
	value_date = c.expiration,
	reval_date = @end_date,
	contract_qty = 1,
	evaluation_currency_id = @evaluation_currency_id,
	abs(a.quantity) /* TEST */
from
        trades a,
        option_contracts b,
        option_expirations c,
        contracts d,
        instruments e
where
        a.contract_id = b.contract_id
and
        a.quantity != 0
and
        b.option_expiration_id = c.option_expiration_id
and
