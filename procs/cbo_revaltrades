	a.contract_id,
	value_date = c.expiration,
	reval_date = @end_date,
	contract_qty = 1,
	evaluation_currency_id = @evaluation_currency_id,
	notional_amount = abs(f.quantity * a.quantity)
from
	trades a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f
where
