and
	a.trade_date <= @end_date


/*
 * Remove the time part of the bo_trade date and move any trades done between
 * 17:00 and 0:00 to the next bo_trading_date (next non weekend day)
 */

/* move any trades done after 5 pm and before midnight to the next day */
update
	trade_daily_revals
set
	bo_trade_date = dateadd(hour, 9, bo_trade_date)
where
	datepart(hour, bo_trade_date) >= 17
and
	datepart(hour, bo_trade_date) <= 23
and
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id
and
	reval_date = @end_date


/* move any saturday trades to monday */
update
	trade_daily_revals
set
	bo_trade_date = dateadd(day, 2, bo_trade_date)
where
	datepart(weekday, bo_trade_date) = 7
and
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id
and
	reval_date = @end_date


/* move any sunday trades to monday */
update
	trade_daily_revals
set
	bo_trade_date = dateadd(day, 1, bo_trade_date)
where
	datepart(weekday, bo_trade_date) = 1
and
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id
and
	reval_date = @end_date


/* strip the time off of any bo_trade_dates */
update
	trade_daily_revals
set
	bo_trade_date = convert(datetime, convert(char(11), bo_trade_date, 1))
where
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id
and
	reval_date = @end_date

update
	trade_daily_revals
set
	a.close_price = b.price
from
	trade_daily_revals a,
	bo_prices b
where
	a.contract_id = b.contract_id
and
	datepart(day, a.value_date) = datepart(day, b.value_date)
and
	datepart(month, a.value_date) = datepart(month, b.value_date)
and
	datepart(year, a.value_date) = datepart(year, b.value_date)
and
	b.price_date = @end_date
and
	a.reval_date = @end_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
	

