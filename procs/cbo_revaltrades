create table
	#missing_settles(
		id int identity,
		trade_id int,
		contract_id int,
		symbol varchar(50),
		value_date datetime,
		price_date datetime,
		close_price float NULL)
insert into
	#missing_settles(
		trade_id,
		contract_id,
		symbol,
		value_date,
		price_date,
		close_price)
select
	b.trade_id,
	b.contract_id,
	a.symbol,
	b.value_date,
	b.reval_date,
	b.close_price
from
	contracts a,
	trade_daily_revals b
where
	a.contract_id = b.contract_id
and
	b.reval_date = @end_date
and
	b.close_price = NULL
if @@rowcount != 0
begin
	select
		@id = 0
	select
		@ids = count(*)
	from
		#missing_settles
	where
		id > @id

	while @ids > 0
	begin
		select
			@id = min(id)
		from
			#missing_settles
		where
			id > @id


		select
			@contract_id = contract_id,
			@value_date = value_date,
			@trade_id = trade_id
		from
			#missing_settles
		where
			id = @id

		select
			@inverted_contract_id = NULL

		exec
			r_invertedcontract
				@contract_id,
				@inverted_contract_id output

		select
			@forward_price = NULL

		select
			@forward_price = 1.0 / price
		from
			bo_prices
		where
			contract_id = @inverted_contract_id
		and
			price_date = @end_date
		and
			datepart(day, @value_date) = datepart(day, value_date)
		and
			datepart(month, @value_date) = datepart(month, value_date)
		and
			datepart(year, @value_date) = datepart(year, value_date)
		and
			source_id = @source_id

		if @forward_price != NULL
		begin
			update
				trade_daily_revals
			set
				close_price = @forward_price
			where
				reval_date = @end_date
			and
				contract_id = @contract_id
			and
				value_date = @value_date
			and
				source_id = @source_id
			and
				evaluation_currency_id = @evaluation_currency_id


			delete

			from
				#missing_settles
			where
				id = @id
		end	
		else
		begin

			select
				@net_position = NULL,
				@days = NULL,
				@spot_price = NULL,
				@forward_price = NULL,
				@give_product_rate = NULL,
				@get_product_rate = NULL
	
			select
				@instrument = a.name
			from
				instruments a,
				contracts b
			where
				a.instrument_id = b.instrument_id
			and
				b.contract_id = @contract_id


			if @instrument = "Forward"
				select
					@net_position = sum(quantity)
				from
					trades
				where
					value_date = @value_date
				and
					contract_id = @contract_id
				and
					trade_date <= @end_date
			else
				select
					@net_position = sum(quantity)
				from
					trades
				where
					contract_id = @contract_id
				and
					trade_date <= @end_date

			if @net_position = 0
			begin
				if @instrument = "Forward"
				begin
					exec
						r_forwardpriceasof
							@contract_id,
							@end_date,
							@value_date,
							@days output,
							@spot_price output,
							@forward_price output,
							@give_product_rate output,
							@get_product_rate output

					update
						trade_daily_revals
					set
						close_price = @forward_price
					where
						reval_date = @end_date
					and
						contract_id = @contract_id
					and
						value_date = @value_date
					and
						source_id = @source_id
					and
						evaluation_currency_id = @evaluation_currency_id
	
	
					delete
	
					from
						#missing_settles
					where
						id = @id
				end
				else
				begin
					exec
						r_priceasof
							@contract_id,
							@end_date,
							@price output
					if @price != NULL
					begin
						update
							trade_daily_revals
						set
							close_price = @price
						where
							reval_date = @end_date
						and
							contract_id = @contract_id
						and
							value_date = @value_date
						and
							source_id = @source_id
						and
							evaluation_currency_id = @evaluation_currency_id

						delete

						from
							#missing_settles
						where
							id = @id
					end
				end
			end
		end

		select
			@ids = count(*)
		from
			#missing_settles
		where
			id > @id
	end

	select
		@missing_settles = count(*)
	from
		#missing_settles
	if @missing_settles > 0
	begin
		select
			message = "Missing Settle",
			source = @source,
			a.trade_id,
			b.trade_date,
			b.quantity,	
			a.symbol,
			a.value_date,
			a.price_date,
			a.close_price,
			front_office_price = "USE FO"
		from
			#missing_settles a,
			trades b
		where
			a.trade_id = b.trade_id

		delete

		from
			trade_daily_revals
		where
			reval_date = @end_date

		return
	end
end

update
	trade_daily_revals
set
	status_id = @committed_status_id
where
	reval_date = @end_date
and
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id

update
	trade_daily_revals
set
	a.native_value = b.quantity * a.close_price
from
	trade_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	a.reval_date = @end_date
and
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id

/*
 * Adjust for the futures size and set the contract native currency for futures 
 */
update
	trade_daily_revals
set
	a.native_value = a.native_value * convert(float, c.quantity),
	a.native_currency_id = d.currency_id,
	a.product_id = d.product_id
from
	trade_daily_revals a,
	future_contracts b,
	futures c,
	forwards d
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id
and
	c.forward_id = d.contract_id
and
	a.reval_date = @end_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id

/*
 * Adjust for futures options size and set the contract native currency 
 * for futures options 
 */
update
	trade_daily_revals
set
	a.native_value = a.native_value * convert(float, d.quantity) * convert(float, f.quantity),
	a.native_currency_id = g.currency_id,
	a.product_id = g.product_id
from
	trade_daily_revals a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f,
	forwards g
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.future_id = f.future_id
and
	f.forward_id = g.contract_id	
and
	a.reval_date = @end_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id

/*
 * Set the contract native currency for spot options
 */
update
	trade_daily_revals
set
	a.native_currency_id = e.currency_id,
	a.product_id = e.product_id
from
	trade_daily_revals a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	a.reval_date = @end_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
	

/*
 * Set the contract native currency for spot exotics
 */
update
	trade_daily_revals
set
	a.native_currency_id = e.currency_id,
	a.product_id = e.product_id
from
	trade_daily_revals a,
	exotic_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	reval_date = @end_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
	

/*
 * Calculate the price change to date and the native p&l to date 
 */
update
	trade_daily_revals
set
	a.price_change_to_date = a.close_price - b.price,
	a.native_realized_pl_to_date = (a.close_price - b.price) * b.quantity * a.contract_qty,
	a.native_unrealized_pl_to_date = 0.0
from
	trade_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	a.reval_date = @end_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
and
	a.value_date <= @end_date

update
	trade_daily_revals
set
	a.price_change_to_date = a.close_price - b.price,
	a.native_unrealized_pl_to_date = (a.close_price - b.price) * b.quantity * a.contract_qty,
	a.native_realized_pl_to_date = 0.0
from
	trade_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	a.reval_date = @end_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
and
	a.value_date >  @end_date

update
	trade_daily_revals
set
	native_realized_pl_to_date = 0.0
where
	native_realized_pl_to_date = NULL
and
	reval_date = @end_date
and
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id

	


/* Calculate the evaluation values converted from the native values */
update
	trade_daily_revals
set
	evaluation_value = native_value,
	realized_pl_to_date = native_realized_pl_to_date,
	unrealized_pl_to_date = native_unrealized_pl_to_date
where
	reval_date = @end_date
and
	source_id = @source_id
and
	evaluation_currency_id = native_currency_id


update
	trade_daily_revals
set
	evaluation_notional = abs(notional_amount)
where
	reval_date = @end_date
and
	source_id = @source_id
and
	product_id = @evaluation_currency_id

update
	trade_daily_revals
set
	evaluation_premium = premium
where
	reval_date = @end_date
and
	source_id = @source_id
and
	evaluation_currency_id = premium_ccy_id


create table
	#non_native_ccys(
		product_id int,
		conversion_rate float NULL)
insert into
	#non_native_ccys(
		product_id)
select
	distinct(
		native_currency_id)
from
	trade_daily_revals
where
	source_id = @source_id
and
	evaluation_currency_id = @evaluation_currency_id
and
	reval_date = @end_date
and
	native_currency_id != @evaluation_currency_id

insert into
	#non_native_ccys(
		product_id)
select
	distinct(product_id)
from
	trade_daily_revals
where
	source_id = @source_id
and
	product_id != @evaluation_currency_id
and
	reval_date = @end_date
and
	product_id not in(
		select
			product_id
		from
			#non_native_ccys)





select
	@product_id = 0
select
	@products = count(*)
from
	#non_native_ccys
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#non_native_ccys
	where
		product_id > @product_id

	select
		@conversion_rate= NULL
	exec
		cbo_ccyconversionrate
			@product_id,
			@evaluation_currency_id,
			@source_id,
			@end_date,
			@conversion_rate output


	update
		#non_native_ccys
	set
		conversion_rate = @conversion_rate
	where
		product_id = @product_id

	update
		trade_daily_revals
	set
		evaluation_value = native_value * @conversion_rate,
		realized_pl_to_date = native_realized_pl_to_date * @conversion_rate,
		unrealized_pl_to_date = native_unrealized_pl_to_date * @conversion_rate
	where
		reval_date = @end_date
	and
		source_id = @source_id
	and
		native_currency_id = @product_id

	update
		trade_daily_revals
	set
		evaluation_notional = notional_amount * @conversion_rate
	where
		product_id = @product_id
	and
		reval_date = @end_date
	and
		product_id != @evaluation_currency_id

	update
		trade_daily_revals
	set
		evaluation_premium = premium * @conversion_rate
	where
		reval_date = @end_date
	and
		source_id = @source_id
	and
		premium_ccy_id = @product_id


	select
		@products = count(*)
	from
		#non_native_ccys
	where
		product_id > @product_id
end

/*
 * Check to see if any conversion rates were missing. return an error if so.
 */
select
	@missing_conversion_rates = count(*)
from
	#non_native_ccys
where
	conversion_rate = NULL
if @missing_conversion_rates != 0
begin
	select
		message = "Missing Spot Conversion Rate",
		product = a.symbol,
		date = @end_date
	from
		products a,
		#non_native_ccys b
	where
		a.product_id = b.product_id
	and
		b.conversion_rate = NULL

	return
end
	

/*
 * Overwrite the evaluation p&l for options and exotics by using the difference
 * between the end evaluation value and the evaluation premium. (rather than
 * difference in trade price)
 */
update
	trade_daily_revals
set
	a.unrealized_pl_to_date = a.evaluation_value + a.evaluation_premium
from
	trade_daily_revals a,
	option_contracts b,
	option_expirations c
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.expiration >= @begin_date
and
	a.source_id = @source_id
and
	a.reval_date = @end_date
and
	a.evaluation_currency_id = @evaluation_currency_id

update
	trade_daily_revals
set
	a.realized_pl_to_date = a.evaluation_value + a.evaluation_premium,
	a.unrealized_pl_to_date = 0.0
from
	trade_daily_revals a,
	option_contracts b,
	option_expirations c
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.expiration < @end_date
and
	a.source_id = @source_id
and
	a.reval_date = @end_date
and
	a.evaluation_currency_id = @evaluation_currency_id




