
if object_id("cm_addcounterpartysymbol") != NULL
    drop procedure
        cm_addcounterpartysymbol
go

create procedure
	cm_addcounterpartysymbol
		@login varchar(50),
		@counterparty varchar(50),
		@source varchar(50),
		@mapping varchar(100)
as


declare @source_id int
declare @counterparty_id int
declare @mappings int

select 
        @counterparty = ltrim(rtrim(@counterparty))

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Counterparty not found",
		counterparty = @counterparty
	return
end

/* CDO: Jan 11, 2011 -- Dropping constraint for 1:1 mapping for source to cpty
			Incoming mappings should be allowed more than one
			mapping into the same counterparty. 
			Outbound mappings need to be manually managed now.
select
	@mappings = count(*)
from
	counterparty_symbols
where
	counterparty_id = @counterparty_id
and
	source_id = @source_id

if @mappings > 0
begin
	select
		status = "Error",
		message = "Broker is already mapped for mapping source",
		counterparty= @counterparty,
		source = @source
	return
end
*/

insert into
	counterparty_symbols
values(
	@counterparty_id,
	@source_id,
	@mapping)

exec
	cm_counterpartymappings
		@login,
		@counterparty

go
