	confirm_transactions = "Confirm All Balances",
	scan_for_mkt = "Scan For Market Roll Prices",
	apply_to_batches = "Apply Defined Prices",
	queue_rolls = "Queue Rolls",
	trade_date = @trade_date,
	clearing_entity = "Citibank"

create table
	#roll_prices(
		id int identity,
		section varchar(100) NULL,
		style varchar(250) NULL,
		price_style varchar(50) NULL,
		price_style_id int NULL,
		contract_id int NULL,
		symbol varchar(10) NULL,
		trade_date datetime NULL,
		closing_date varchar(11) NULL,
		roll_date varchar(11) NULL,
		near_price float NULL,
		sell_roll_price float NULL,
		buy_roll_price float NULL,
		rolling_shorts float NULL,
		days int NULL,
		rolling_longs float NULL,
		edit_prices varchar(15) NULL,
		edit_points varchar(15) NULL)
insert into
	#roll_prices(
		section,
		style,
		contract_id,
		symbol,
		trade_date,
		closing_date,
		roll_date,
		near_price,
		sell_roll_price,
		buy_roll_price,
		/* rolling_shorts, */
		days,
		/* rolling_longs, */
		edit_prices,
		edit_points)
select
	section = "Defined Roll Prices",
	style = @style,
	b.contract_id,
	b.symbol,
	a.trade_date,
	closing_date = convert(varchar(11), a.closing_date),
	roll_date = convert(varchar(11), a.roll_date),
	a.near_price,
	a.sell_roll_price,
	a.buy_roll_price,
	days = datediff(day, a.closing_date, a.roll_date),
	edit_prices = "Edit Prices",
	edit_points = "Edit Points"
from
	roll_prices a,
	contracts b
where
	a.contract_id = b.contract_id
and
	a.trade_date = @trade_date
order by
	b.symbol

update
	#roll_prices
set
	a.price_style_id = b.price_style_id,
	a.price_style = c.name
from
	#roll_prices a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id


update
	#roll_prices
set
	near_price = convert(float, 1.0 / near_price),
	sell_roll_price = convert(float, 1.0 / sell_roll_price),
	buy_roll_price = convert(float, 1.0 / buy_roll_price)
where
	price_style = "Inverted"

update
	#roll_prices
set
	rolling_shorts = convert(float, (sell_roll_price - near_price)),
	rolling_longs = convert(float, (buy_roll_price - near_price))

update
	#roll_prices
set
	a.rolling_shorts = a.rolling_shorts * b.point_factor,
	a.rolling_longs = a.rolling_longs * b.point_factor
from
	#roll_prices a,
	point_factors b
where
	a.contract_id = b.contract_id


update
	#roll_prices
set
	a.rolling_shorts = a.rolling_shorts * d.point_factor,
	a.rolling_longs = a.rolling_longs * d.point_factor
from
	#roll_prices a,
	forwards b,
	forwards c,
	point_factors d
where
	a.contract_id = b.contract_id
and
	b.product_id = c.currency_id
and
	b.currency_id = c.product_id
and
	c.contract_id = d.contract_id

delete

from
	#roll_prices 
where
	symbol not in(
		select
			distinct(symbol)
		from
			#output
		where
			symbol != NULL)

select
	section,
	style,
	symbol,
	trade_date,
	closing_date,
	roll_date,
	near_price,
	sell_roll_price,
	buy_sell = convert(numeric(30,8), rolling_shorts),
	days,
	sell_buy = convert(numeric(30,8) , rolling_longs),
	buy_roll_price,
	edit_prices,
	edit_points
from
	#roll_prices
order by
	id


select
	style,
	trade_date = @trade_date,
	account,
	symbol,
	position,
	closing_price = convert(numeric(30,8), closing_price),
	closing_date = convert(varchar(11), closing_date),
	roll_price = convert(numeric(30,8), roll_price),
	roll_date = convert(varchar(11), roll_date),
	points = convert(numeric(30,8), points),
	deal_id = risk_book_deal_id,
	edit_roll,
	batch_id = batch_transaction_id,
	conf_date = convert(varchar(11), confirmation_date),
	confirmed_by,
	confirm_batch
from
	#output
order by
	id


