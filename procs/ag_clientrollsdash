create table
	#external_accounts(
		id int identity,
		external_account_id int NULL,
		symbol varchar(50) NULL)
insert into
	#external_accounts(
		symbol)
select
	a.symbol
from
	external_accounts a,
	settlement_methods b
where
	a.settlement_method_id = b.settlement_method_id
and
	b.name in("Roll To Eval Currency", "Roll By Pair")

update
	#external_accounts
set
	a.external_account_id = b.external_account_id
from
	#external_accounts a,
	external_accounts b
where
	a.symbol = b.symbol

create table
	#output(
		id int identity,
		style varchar(250) NULL,
		batch_transaction_id int NULL,
		account varchar(50) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		position numeric(30,4) NULL,
		closing_date datetime NULL,
		roll_date datetime NULL,
		closing_price float NULL,
		roll_price float NULL,
		points float NULL,
		risk_book_deal_id int NULL,
		edit_roll varchar(25) NULL,
		timestamp datetime NULL,
		confirmation_date datetime NULL,
		confirmed_by varchar(50) NULL,
		confirm_batch varchar(25) NULL)

select
	@id = 0
select
	@ids = count(*)
from
	#external_accounts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#external_accounts
	where
		id > @id

	select
		@external_account_id = NULL,
		@account = NULL,
		@batch_transaction_id = NULL,
		@confirmation_date = NULL,
		@confirmed_by = NULL

	select
		@external_account_id = external_account_id,
		@account = symbol
	from
		#external_accounts
	where
		id = @id


	select
		@batch_transaction_id = batch_transaction_id,
		@confirmation_date = confirmation_date,
		@confirm_user_id = confirm_user_id
	from
		batch_transactions
	where
		external_account_id = @external_account_id
	and
		trade_date = @trade_date

	select
		@confirmed_by = login
	from
		tico_accounts
	where
		account_id = @confirm_user_id

	insert into
		#output(
			style,
			batch_transaction_id,
			account,
			confirmation_date,
			confirmed_by)
	values(
		@client_style,
		@batch_transaction_id,
		@account,
		@confirmation_date,
		@confirmed_by)

	insert into
		#output(
			style,
			account,
			contract_id,
			symbol,
			position,
			closing_date,
			roll_date,
			closing_price,
			roll_price,
			points,
			risk_book_deal_id,
			timestamp)
	select
		style = @style,
		account = b.symbol,
		c.contract_id,
		d.symbol,
		c.position,
		c.closing_date,
		c.roll_date,
		c.closing_price,
		c.roll_price,
		c.points,
		c.risk_book_deal_id,
		c.timestamp
	from
		batch_transactions a,
		external_accounts b,
		proposed_roll_batches c,
		contracts d
	where
		a.external_account_id = b.external_account_id
	and
		a.batch_transaction_id = c.batch_transaction_id
	and
		c.contract_id = d.contract_id
	and
		a.batch_transaction_id = @batch_transaction_id
	order by
		b.symbol,
		d.symbol

	select
		@ids = count(*)
	from
		#external_accounts
	where
		id > @id
end

update
	#output
set
	a.closing_price = convert(float, 1.0 / a.closing_price),
	a.roll_price = convert(float, 1.0 / a.roll_price),
	a.points = convert(float, (1.0 / a.roll_price)) - convert(float, (1.0 / a.closing_price))
from
	#output a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"


update
	#output
set
	a.points = a.points * b.point_factor
from
	#output a,
	point_factors b
where
	a.contract_id = b.contract_id

update
	#output
set
	a.points = a.points * d.point_factor
from
	#output a,
	forwards b,
	forwards c,
	point_factors d
where
	a.contract_id= b.contract_id
and
	b.product_id = c.currency_id
and
	b.currency_id = c.product_id
and
	c.contract_id = d.contract_id


create table
	#contracts(
		contract_id int)
insert into
	#contracts(
		contract_id)
select
	distinct(a.contract_id)
from
	proposed_roll_batches a,
	batch_transactions b
where
	a.batch_transaction_id = b.batch_transaction_id
and
	b.trade_date = b.trade_date

delete
	#contracts
from
	#contracts a,
	roll_prices b
where
	a.contract_id = b.contract_id
and
	b.trade_date = @trade_date


select
	@contract_id = 0
select
	@contracts = count(*)
from
	#contracts
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#contracts
	where
		contract_id > @contract_id

	select
		@roll_price_id = NULL,
		@closing_date = NULL,
		@roll_date = NULL,
		@inverted_contract_id = NULL

	select
		@closing_date = closing_date,
		@roll_date = spot_date
	from
		spot_value_dates
	where
		contract_id = @contract_id
	and
		trade_date = @trade_date

	if @closing_date = NULL
	begin
		exec
			r_invertedcontract
				@contract_id,
				@inverted_contract_id output


		select
			@closing_date = closing_date,
			@roll_date = spot_date
		from
			spot_value_dates
		where
			contract_id = @inverted_contract_id
		and
			trade_date = @trade_date
	end



	if @closing_date = NULL
	begin
		select
			status = "Unable to determine closing date for contract"
			return
	end
	exec
		j_nextkey
			"roll_prices",
			@roll_price_id output

	insert into
		roll_prices(
			roll_price_id,
			trade_date,
			contract_id,
			closing_date,
			roll_date,
			timestamp)
	values(
		@roll_price_id,
		@trade_date,
		@contract_id,
		@closing_date,
		@roll_date,
		getdate())

	select
		@contracts = count(*)
	from
		#contracts
	where
		contract_id > @contract_id
end

