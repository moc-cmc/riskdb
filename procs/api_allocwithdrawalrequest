create or replace procedure
	api_allocwithdrawalrequest
		@login varchar(50),
		@sub_account varchar(50),
		@product varchar(50),
		@amount float

	

as

select
	@amount = abs(@amount) * -1

exec
	api_addallocationrequest
		@login=@login,
		@sub_account=@sub_account,
		@product=@product,
		@amount=@amount


go

