
drop procedure mon_invertedpricecheck
go

create procedure
	mon_invertedpricecheck

as

create table 
	#cps 
(
	symbol varchar(20) NULL,
	contract_id int NULL,
	price float NULL,
	timestamp datetime NULL
)
insert into
	#cps
select 
	b.symbol, 
	a.* 
from 
	current_prices a, 
	contracts b,
	contract_price_styles c,
	price_styles d
where 
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"
if @@rowcount >= 1
begin
	select
		status = "error",
		message = "Price exists for an inverted contract"
	select
		data="data",
		* 
	from
		#cps
	return
end

select
	status = "ok",
	message = "No current prices exist for inverted contracts"

go

