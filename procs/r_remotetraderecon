create table 
    #match_list (
	id int identity,
        remote_trade_id int NULL,
        trade_id int NULL,
        contract varchar(10),
	contract_id int NULL,
        match_status varchar(30),
        match_strength float NULL,
        trade_date datetime,
        value_date datetime,
        in_value_date datetime NULL,
        ex_value_date datetime NULL,
        fixing_date datetime NULL,
        in_fixing_date datetime NULL,
        ex_fixing_date datetime NULL,
        quantity numeric(30, 8),
        in_quantity numeric(30,8) NULL,
        ex_quantity numeric(30,8) NULL,
        price float NULL,
        in_price float NULL,
        ex_price float NULL,
        internal_account varchar(50) NULL, 
        external_account varchar(50),
        counterparty varchar(50),
        broker varchar(50) NULL,
        in_identifier varchar(100) NULL,
        ex_identifier varchar(100) NULL,
        tally char(50) NULL,
        style char(100) NULL,
	std_contract varchar(30) NULL,
	traded_ccy varchar(10) NULL,
	counter_ccy varchar(10) NULL,
	calc_price numeric(30, 10) NULL,
	recon_method_id int NULL,
	recon_method varchar(50) NULL
)

