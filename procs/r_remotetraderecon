select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login
if @tico_account_id = NULL
begin
        select
                status="Error",
                message="Problem finding account for login"
        return
end

select
        @source_id = source_id
from
        sources
where
        name = @source
/*if @source_id = NULL
begin
        select
                status = "Error",
                message = "Problem finding source",
                source = @source
        return
end*/

if @trade_date = NULL
begin
        select
                @trade_date = getdate()
end
          
exec     
        r_daterangefordate
                @trade_date, 
                @begin_date output,
                @end_date output
             
select
        @bo_trade_date = convert(date, @end_date)  


exec
	r_prevbusinessday
		@bo_trade_date,
		@previous_trade_date output

