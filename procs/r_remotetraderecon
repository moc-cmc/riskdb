		internal_account,
		external_account,
		counterparty,
		broker,
		in_identifier,
		ex_identifier,
		recon_method_id,
		style
)
select
	a.remote_trade_symbol_id,
	a.trade_id,
	b.symbol,
	a.contract_id,
	c.name,
	1.00,
	d.trade_date,
	d.value_date,
	d.value_date,
	a.value_date,
	d.fixing_date,
	d.fixing_date,
	a.fixing_date,
	d.quantity,
	d.quantity,
	a.quantity,
	d.price,
	d.price,
	a.price,
	e.symbol,
	f.symbol,
	g.name,
	h.symbol,
	d.identifier,
	a.identifier,
	a.recon_method_id,
	@matched_style
from
	#remote_trades a,
	contracts b,
	statuses c,
	#trades d,
	internal_accounts e,
	external_accounts f,
	counterparties g,
	brokers h
