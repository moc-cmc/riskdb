        broker varchar(50) NULL,
        in_identifier varchar(100) NULL,
        ex_identifier varchar(100) NULL,
        tally char(50) NULL,
        style char(100) NULL,
	std_contract varchar(30) NULL,
	traded_ccy varchar(10) NULL,
	counter_ccy varchar(10) NULL,
	calc_price numeric(30, 10) NULL,
	ex_calc_price numeric(30, 10) NULL,
	recon_method_id int NULL,
	recon_method varchar(50) NULL,
	match_group_id int NULL,
	staged_qty numeric(30, 8) NULL,
	staged_count int NULL
)

insert into
	#match_list(
		remote_trade_id,
		trade_id,	
		contract,
		contract_id,
		ex_contract,
		ex_contract_id,
		match_status,
		match_strength,
		trade_date,
		value_date,
		in_value_date,
		ex_value_date,
		fixing_date,
		in_fixing_date,
		ex_fixing_date,
		quantity,
		in_quantity,
		ex_quantity,
		price,
		in_price,
		ex_price,
		ex_calc_price,
		internal_account,
		external_account,
		counterparty,
		broker,
		in_identifier,
		ex_identifier,
		recon_method_id,
		style
)
select
	a.remote_trade_symbol_id,
	a.trade_id,
	b.symbol,
	d.contract_id,
	i.symbol,
	a.contract_id,
	c.name,
	1.00,
	d.trade_date,
	d.value_date,
	d.value_date,
	a.value_date,
	d.fixing_date,
	d.fixing_date,
	a.fixing_date,
	d.quantity,
	d.quantity,
	a.quantity,
	d.price,
	d.price,
	a.price,
	a.price,
	e.symbol,
	f.symbol,
	g.name,
	h.symbol,
	d.identifier,
	a.identifier,
	a.recon_method_id,
	case when c.name = "Committed" then @committed_style else @matched_style end
from
	#remote_trades a,
	contracts b,
	statuses c,
	#trades d,
	internal_accounts e,
	external_accounts f,
	counterparties g,
	brokers h,
	contracts i
where
	a.trade_id = d.trade_id
and
	a.recon_status_id = c.status_id
and
	d.contract_id = b.contract_id
and
	d.internal_account_id = e.internal_account_id
and
	d.external_account_id = f.external_account_id
and
	d.counterparty_id = g.counterparty_id
and
	d.broker_id = h.broker_id
and
	a.contract_id = i.contract_id
and	
	c.name in("Matched", "Committed")

insert into
        #match_list(
                remote_trade_id,
                trade_id,
                contract,
		contract_id,
		ex_contract,
		ex_contract_id,
                match_status,
                match_strength,
                trade_date,
                value_date,
                in_value_date,
                ex_value_date,
                fixing_date,
                in_fixing_date,
                ex_fixing_date,
                quantity,
                in_quantity,
                ex_quantity,
                price,
                in_price,
                ex_price,
                ex_calc_price,
                internal_account,
                external_account,
                counterparty,
                in_counterparty,
                ex_counterparty,
                broker,
                in_identifier,
                ex_identifier,
		recon_method_id,
                style
)
select
        a.remote_trade_symbol_id,
        a.trade_id,
        b.symbol,
	d.contract_id,
        j.symbol,
        a.contract_id,
        c.name,
        0.99,
        d.trade_date,
        d.value_date,
        d.value_date,
        a.value_date,
        d.fixing_date,
        d.fixing_date,
        a.fixing_date,
        d.quantity,
        d.quantity,
        a.quantity,
        d.price,
        d.price,
        a.price,
        a.price,
        e.symbol,
        f.symbol,
        g.name,
        g.name,
        i.name,
        h.symbol,
        d.identifier,
        a.identifier,
	a.recon_method_id,
        @mismatched_style
from
        #remote_trades a,
        contracts b,
        statuses c,
        #trades d,
        internal_accounts e,
        external_accounts f,
        counterparties g,
        brokers h,
	counterparties i,
	contracts j
where
        a.trade_id = d.trade_id
and
        a.recon_status_id = c.status_id
and
        d.contract_id = b.contract_id
and
        d.internal_account_id = e.internal_account_id
and
        d.external_account_id = f.external_account_id
and
        d.counterparty_id = g.counterparty_id
and
        a.counterparty_id = i.counterparty_id
and
	a.contract_id = j.contract_id
and
        d.broker_id = h.broker_id
and     
        c.name = "Mismatched"



