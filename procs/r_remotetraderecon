/* Contract display deserves a comment because we use it for price display and
 * there are formatting considerations. Im match_list we are storing several
 * contract fields, contract_id, contract, ex_contract_id, ex_contract, std_contract
 * the contract_id will always be populated either by the match using the internal contract
 * or the external contract on external onlys. ex_contract_id and ex_contract are internals
 * and the std_contract is the standard rep based off of match list contract
 *
 * prices are saved in true terms in the internal trades table for calcs. In the external recon
 * tables we store price in standard always. Therefore, we can not do one blanket update on
 * to get the calc prices or display prices for internal trades vs external trades.
 */

/* Get the standard contract for all matches, internal and externals using the contract_id
 * which can be sourced from either intenral or external table depending on record type
 */
update
	#match_list
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy)
from
	#match_list a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

/* Get the exernal calc price. can use default standard price inserted for all contracts
 * unless inverted, then invert the standard price that would be stored in remote_trade_symbols
 */
update
        #match_list
set
        ex_calc_price = 1/a.price
from
        #match_list a,
        contracts b,
        contract_price_styles c,
        price_styles d
where
        a.ex_contract_id = b.contract_id
and
        b.contract_id = c.contract_id
and
        c.price_style_id = d.price_style_id
and
        d.name = "Inverted"

/* Get the internal price used for display. The price column should be used for calcs */
update
        #match_list
set
        in_price = 1/a.price
from
        #match_list a,
        contracts b,
        contract_price_styles c,
        price_styles d
where
        a.contract_id = b.contract_id
and
        b.contract_id = c.contract_id
and
        c.price_style_id = d.price_style_id
and
        d.name = "Inverted"




