create table
	#external_account_prime_brokers(
		prime_broker_id int,
		external_account_id int)

/* Prime Broker Filter */
if @prime_broker != NULL
begin
	insert into
		#external_account_prime_brokers(
			prime_broker_id,
			external_account_id)
	select
		b.prime_broker_id,
		b.external_account_id
	from
		prime_brokers a,
		external_account_prime_brokers b,
		sources c
	where
		a.prime_broker_id = b.prime_broker_id
	and
		a.source_id = c.source_id
	and
		c.name = @prime_broker		
end
else
begin
        insert into
                #external_account_prime_brokers(
                        prime_broker_id,
                        external_account_id)
        select
                prime_broker_id,
                external_account_id
        from
                external_account_prime_brokers 
end

/* FX, Futures, CFD */

create table
	#contracts(
		contract_id int)

create nonclustered index
        tmp_cid
on
        #contracts(contract_id)

if @asset_class = "FX"
begin
	insert into
		#contracts(
			contract_id)
	select
		a.contract_id
	from
		contracts a,
		instruments b
	where
		a.instrument_id = b.instrument_id
	and
		b.name = "Forward"
end

if @asset_class = "Future"
begin
        insert into 
                #contracts(
                        contract_id)
        select
                a.contract_id
        from
                contracts a,
		future_contracts b,
		futures c,
		future_types d
        where
                a.contract_id = b.contract_id
	and
		b.future_id = c.future_id
	and
		c.future_type_id = d.future_type_id
	and
		d.name in("Regular", "Val Date")
end

if @asset_class = "CFD"
begin
        insert into
                #contracts(
                        contract_id)
        select
                a.contract_id
        from
                contracts a,
                future_contracts b,
                futures c,
                future_types d
        where
                a.contract_id = b.contract_id
        and
                b.future_id = c.future_id
        and
                c.future_type_id = d.future_type_id
        and
                d.name in("Perpetual")
end

if @asset_class = NULL
begin
        insert into
                #contracts(
                        contract_id)
	select
		contract_id
	from
		contracts
end
				

create table
        #statuses(
                status_id int,
                name varchar(50),
                match_candidate char(1)
)

insert into
        #statuses
select
        a.status_id,
        a.name,
        b.match_candidate
from
        statuses a,
        remote_recon_statuses b
where
        a.status_id = b.status_id


create table
        #remote_trades(
                remote_trade_symbol_id int,
                source_id int,
                trade_id int NULL,
                recon_status_id int,
                internal_account_id int,
                external_account_id int,
                counterparty_id int,
                quantity numeric(30,8),
                price float,
                contract_id int,
                trade_date datetime,
                value_date datetime,
                fixing_date datetime null,
                identifier varchar(100),
		recon_method_id int NULL
)

insert into
        #remote_trades(
                remote_trade_symbol_id,
                source_id,
                trade_id,
                recon_status_id,
                internal_account_id,
                external_account_id,
                counterparty_id,
                quantity,
                price,
                contract_id,
                trade_date,
                value_date,
                fixing_date,
                identifier,
		recon_method_id)
select
        a.remote_trade_symbol_id,
        a.source_id,
        a.trade_id,
        a.recon_status_id,
        a.internal_account_id,
        a.external_account_id,
        a.counterparty_id,
        a.quantity,
        a.price,
        a.contract_id,
        a.trade_date,
        a.value_date,
        a.fixing_date,
        a.identifier,
	a.recon_method_id
from
        remote_trade_symbols a,
	#external_account_prime_brokers b,
	#contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.bo_trade_date = @bo_trade_date



create table
        #trades(
                trade_id int,
                internal_account_id int,
                external_account_id int,
                counterparty_id int,
                quantity numeric(30, 8),
                price float,
                contract_id int,
                trade_date datetime,
                value_date datetime,
                fixing_date datetime NULL,
		broker_id int,
		identifier varchar(100),
		remote_trade_id int NULL
)

insert into
        #trades(
                trade_id,
                internal_account_id,
                external_account_id,
                counterparty_id,
                quantity,
                price,
                contract_id,
		trade_date,
                value_date,
                fixing_date,
		broker_id,
		identifier)
select
        a.trade_id,
        a.internal_account_id,
        a.external_account_id,
        a.counterparty_id,
        a.quantity,
        a.price,
        a.contract_id,
	a.trade_date,
        a.value_date,
        a.fixing_date,
	a.broker_id,
	a.identifier
from
        trades a,
	#external_account_prime_brokers b,
	#contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
        trade_date >= @begin_date
and
        trade_date < @end_date
and
        value_date >= @bo_trade_date
/* comment out below to include TY3 */
and
	(counterparty_id < 367
or
	counterparty_id > 378)
and 
	counterparty_id not in(380, 381, 382, 383) /* hack for OCAN TY3 */
and
	counterparty_id not in (435) /* Exclude: OAU-JUMP-JUMP */
/*
and 
	counterparty_id not in(386)
*/


update
	#trades
set
	b.remote_trade_id = a.remote_trade_symbol_id
from
	#remote_trades a,
	#trades b
where
	a.trade_id = b.trade_id

 
create table 
    #match_list (
	id int identity,
        remote_trade_id int NULL,
        trade_id int NULL,
        contract varchar(50),
        contract_id int NULL,
        ex_contract varchar(50) NULL,
        ex_contract_id int NULL,
        match_status varchar(30),
        match_strength float NULL,
        trade_date datetime,
        value_date datetime,
        in_value_date datetime NULL,
        ex_value_date datetime NULL,
        fixing_date datetime NULL,
        in_fixing_date datetime NULL,
        ex_fixing_date datetime NULL,
        quantity numeric(30, 8),
        in_quantity numeric(30,8) NULL,
        ex_quantity numeric(30,8) NULL,
        price float NULL,
        in_price float NULL,
        ex_price float NULL,
