update
	#match_list
set
	std_contract = b.symbol,
        traded_ccy = g.symbol,
        counter_ccy = f.symbol,
	calc_price = a.price
from
	#match_list a,
	contracts b,
	forwards e,
	products f,
	products g
where
	a.contract_id = b.contract_id
and
	b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#match_list
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy),
	calc_price = 1/a.price
from
	#match_list a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

update
	#match_list
set
	recon_method = b.name
from
	#match_list a,
	recon_methods b
where
	a.recon_method_id = b.recon_method_id

create table
	#report (
		ordering int NULL,
		symbol char(10) NULL,
		status char(50) NULL,
		internal_trades int NULL,
		external_trades int NULL,
		total int NULL,
		committed int NULL,
		reconciled int NULL,
		mismatched int NULL,
		external_only int NULL,
		internal_only int NULL,
		style char(100) NULL
)

insert
	#report
select distinct
	0,
	std_contract,
	NULL,
	NULL,
	NULL,
	count(*),
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	@style
from
	#match_list
group by
	std_contract
order by
	std_contract

update
    #report
set
    internal_trades = (
        select
            count(*)
        from
            #match_list
        where
            std_contract = #report.symbol
        and
            trade_id != NULL
    )

update
    #report
set
    external_trades = (
        select
            count(*)
        from
            #match_list
        where
            std_contract = #report.symbol
        and
            remote_trade_id != NULL
    )


update
    #report
set
    committed = (
        select
            count(*)
        from
            #match_list
        where
            std_contract = #report.symbol
        and
            match_status = "Committed"
    )

update
    #report
set
    reconciled = (
        select
            count(*)
        from
            #match_list
        where
            std_contract = #report.symbol
        and
            match_status = "Matched"
    )

update
    #report
set
    mismatched = (
        select
            count(*)
        from
            #match_list
        where
            std_contract = #report.symbol
        and
            match_status = "Mismatched"
    )

update
    #report
set
    internal_only = (
        select
            count(*)
        from
            #match_list
        where
            std_contract = #report.symbol
        and
            trade_id != NULL
	and
	    remote_trade_id = NULL
)

update
    #report
set
    external_only = (
        select
            count(*)
        from
            #match_list
        where
            std_contract = #report.symbol
        and
            trade_id = NULL
	and
	    remote_trade_id != NULL
    )
 

update
        #report
set
        style = @internal_style
where
        internal_only > 0

update
        #report
set
        style = @mismatched_style
where
        mismatched > 0

update
	#report
set
	style = @external_style
where
	external_only > 0



insert into
    #report
select
	1,
        NULL,
        "Total",
        sum(internal_trades),
        sum(external_trades),
        sum(total),
        sum(committed),
        sum(reconciled),
        sum(mismatched),
        sum(external_only),
        sum(internal_only),
        "background:#eee;font-weight:bold;"
from
        #report

select
	* 
from
	#meta

select
        style = @style,
	previous_date = "<< Previous Date",
	run_recon = "Run Recon",
        recon_date = @bo_trade_date,
        source = @source,
	next_date = "Next Date  >>"

select
    section = "Summary",
    trade_date = convert(char(10), @trade_date, 101),
    contract = symbol,
    status,
    internal_trades = case when internal_trades != 0 then internal_trades else NULL end,
    external_trades = case when external_trades != 0 then external_trades else NULL end,
    total = case when total != 0 then total else NULL end,
    committed = case when committed != 0 then committed else NULL end,
    reconciled = case when reconciled != 0 then reconciled else NULL end,
    mismatched = case when mismatched != 0 then mismatched else NULL end,
    external_only = case when external_only != 0 then external_only else NULL end,
    internal_only = case when internal_only != 0 then internal_only else NULL end,
    details = case when (mismatched != 0 or external_only != 0 or internal_only != 0) then "Show " +rtrim(symbol) + " Breaks" else NULL end,
    all_trades = "Show All " + rtrim(symbol),
    style
from
    #report
order by
    ordering,
    symbol

if @@rowcount = 0
begin
    if @contract = null
        select
            msg = "There are no mismatched, external-only nor internal-only trades in this report"
    else
        select
            msg = "There are no mismatched, external-only nor internal-only trades for " + rtrim(@contract)
end


if @granularity = "All" and @contract = NULL
begin
	select
		section = "Recon for " + external_account,
		recon_id=id,
        	ids="IN "+rtrim(convert(varchar(30), trade_id)) + " <br/>EX " + rtrim(convert(varchar(30), remote_trade_id)),
		contract,
		match_status,
		match_strength,
		trade_date,
		value_date=convert(char(12), convert(datetime, value_date, 101)),
		/*fixing_date=convert(datetime, fixing_date, 101),*/
		quantity=rtrim(convert(varchar(30), convert(numeric(30,2),in_quantity)))  + " <br/>" + rtrim(convert(varchar(30), convert(numeric(30,2),ex_quantity))),
		counter_quantity=rtrim(convert(varchar(30), convert(numeric(30,2),in_quantity*calc_price*-1)))  + " <br/>" + rtrim(convert(varchar(30), convert(numeric(30,2),ex_quantity*calc_price*-1))),
		rate=rtrim(convert(varchar(30), convert(numeric(30,8), in_price)))  + " <br/>" + rtrim(convert(varchar(30), convert(numeric(30,8),ex_price))),
		internal_account,
		external_account,
		counterparty,
		broker,
		identifier = "IN "+rtrim(convert(varchar(100), in_identifier)) + " <br/>EX " + rtrim(convert(varchar(100), ex_identifier)),
		recon_method,
		style
	from
		#match_list
	order by 
		external_account,
		std_contract,
		price,
		match_status
end

if @granularity = "All" and @contract != NULL
begin
	select
		section = "Recon for " + external_account,
		recon_id=id,
        	ids="IN "+rtrim(convert(varchar(30), trade_id)) + " <br/>EX " + rtrim(convert(varchar(30), remote_trade_id)),
		contract,
		match_status,
		match_strength,
		trade_date,
		value_date=convert(char(12), convert(datetime, value_date, 101)),
