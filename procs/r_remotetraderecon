create or replace procedure
	r_remotetraderecon
		@login varchar(50),
		@trade_date datetime = NULL,
		@source varchar(50) = NULL,
		@contract varchar(50) = NULL,
		@granularity varchar(50) = NULL

as


declare @tico_account_id int
declare @source_id int
declare @begin_date datetime
declare @end_date datetime
declare @bo_trade_date datetime
declare @previous_trade_date datetime
declare @next_trade_date datetime

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)
declare @matched_style varchar(200)
declare @mismatched_style varchar(200)
declare @committed_style varchar(200)
declare @external_style varchar(200)
declare @internal_style varchar(200)

declare @alert_high_style varchar(200)
declare @alert_med_style varchar(200)
declare @alert_low_style varchar(200)
declare @alert_none_style varchar(200)

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold",
        @matched_style = "background:#fff;border: 1px solid white",
        @mismatched_style = "background:#decafc;border: 1px solid white;font-weight:bold",
        @committed_style = "background:#f0f0f8;color:#666;border: 1px solid white",
        @external_style = "background:#c4ff5e;border: 1px solid white",
        @internal_style = "background:#fcf860;border: 1px solid white"

select
	@alert_high_style = "color:#ffffff; background:#f03b20; border:1px solid white; font-weight:bold",
	@alert_med_style = "color:#000000; background:#feb24c; border:1px solid white; font-weight:bold",
	@alert_low_style = "color:#000000; background:#ffeda0; border:1px solid white; font-weight:bold",
	@alert_none_style = "color:#000000; background:#e5f5e0; border:1px solid white; font-weight:bold"

select
	@external_style = @alert_none_style,
	@internal_style = @alert_low_style


