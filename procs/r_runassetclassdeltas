create procedure
	r_runassetclassdeltas
		@login char(30),
		@run_name char(200),
		@as_of_date datetime=NULL,
		@asset_class char(100)
as

declare @run_id int
declare @contracts int
declare @contract_id int
declare @instrument char(30)
declare @perspective_contract_id int
declare @delta float
declare @weighted_delta float
declare @current_position float
declare @eurusd_contract_id int
declare @eurusd_vol float
declare @usd_product_id int
declare @vol float
declare @price float
declare @product_id int
declare @currency_id int
declare @product_qty float
declare @currency_qty float
declare @multiplier float
declare @products int
declare @usd_equiv float
declare @asset_class_id int
declare @product_type_id int
declare @factor float
declare @total_usd_equiv float
declare @begin_date datetime
declare @end_date datetime

create table
	#links(
		meta_type char(200),
		column char(30),
