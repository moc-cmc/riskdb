	#links
values(
	"Column Link",
	"set_vol",
	"Set Vols",
	"suppressAutoexecute=YES",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links


select
	@run_id = run_id
from
	runs
where
	name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @asset_class = "Currency"
	select
		@factor = 1000000
else
	select
		@factor = 1

select
	@eurusd_contract_id = contract_id
from
	contracts
where
	symbol = "EURUSD"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding EURUSD contract"
	return
end

if @as_of_date = NULL
	select
		@as_of_date = getdate()


exec
	r_daterangefordate
		@as_of_date,
		@begin_date output,
		@end_date output

select
	@as_of_date = @end_date
select
	@product_type_id = product_type_id
from
	product_types
where
	name = @asset_class
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding asset class",
		asset_class = @asset_class
	return
end

exec
	r_volasof
		@eurusd_contract_id,
		@as_of_date,
		@eurusd_vol output

