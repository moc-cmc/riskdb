create table
	#contracts(
		contract_id int)
insert into
	#contracts
select
	a.contract_id
from
	forwards a,
	products b
where
	a.product_id = b.product_id
and
	b.product_type_id = @product_type_id
	
insert into
	#contracts
select
	a.contract_id
from
	future_contracts a,
	futures b,
	forwards c,
	products d
where
	a.future_id = b.future_id
and
	b.forward_id = c.contract_id
and
	c.product_id = d.product_id
and
	a.expiration > @as_of_date
and
	d.product_type_id = @product_type_id

insert into
	#contracts
select
	a.contract_id
from
	option_contracts a,
	option_expirations b,
	options c,
	#contracts d
where
	a.option_expiration_id = b.option_expiration_id
and
	b.option_id = c.option_id
and
	c.underlying_contract_id = d.contract_id
and
	b.expiration > @as_of_date

/* NEW PIECE FOR EXOTICS */
insert into
	#contracts
select
	a.contract_id
from
	exotic_contracts a,
	option_expirations b,
	options c,
	#contracts d
where
	a.option_expiration_id = b.option_expiration_id
and
	b.option_id = c.option_id
and
	c.underlying_contract_id = d.contract_id
and
	b.expiration > @as_of_date
/* END EXOTICS PIECE */


create table
	#positions(
		contract_id int,
		quantity numeric(30,0),
		trade_date datetime)

insert into
	#positions
select
	a.contract_id,
	convert(numeric(30,0), sum(a.quantity)),
	max(a.trade_date)
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#contracts f
where
	a.contract_id = f.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.trade_date <= @as_of_date
group by
	a.contract_id

delete

from
	#positions
where
	quantity = 0

create table
	#deltas(
		contract_id int,
		delta float NULL,
		option_delta float NULL,
		total_delta float NULL,
		vol float NULL,
		weighted_delta float NULL,
		price float NULL)


select
	@contract_id = 0
select
	@contracts = count(*)
from
	#positions
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#positions
	where
		contract_id > @contract_id


	select
		@current_position = quantity
	from
		#positions
	where
		contract_id = @contract_id
	select
		@perspective_contract_id = NULL,
		@delta = NULL

	select
		@instrument = a.name
	from
		instruments a,
		contracts b
	where
		a.instrument_id = b.instrument_id
	and
		b.contract_id = @contract_id

	if @instrument != "Option" and @instrument != "Exotic"
	begin
		exec
			b_contractdelta
				@run_id,
				@as_of_date,
				@contract_id,
				@current_position,
				@perspective_contract_id output,
				@delta output

			/* r_contractdelta
				@run_id,
				@as_of_date,
				@contract_id,
				@current_position,
				@perspective_contract_id output,
				@delta output */
	

		if @delta != NULL
		begin
			update
				#deltas
			set
				delta = delta + @delta,
				total_delta = total_delta + @delta
			where
				contract_id = @perspective_contract_id
			if @@rowcount != 1
				insert into
					#deltas
				values(
					@perspective_contract_id,
					@delta,
					0,
					@delta,
					NULL,
					NULL,
					NULL)
		end
	end
	else
	begin

		exec
			r_optcontractdelta
				@run_id,
				@contract_id,
				@current_position,
				@as_of_date,
				@perspective_contract_id output,
				@delta output

		if @delta != NULL
		begin
			update
				#deltas
			set
				option_delta = option_delta + @delta,
				total_delta = total_delta + @delta
			where
				contract_id = @perspective_contract_id
			if @@rowcount != 1
				insert into
					#deltas
				values(
					@perspective_contract_id,
					0,
					@delta,
					@delta,
					NULL,
					NULL,
					NULL)
		end

	end


	select
		@contracts = count(*)
	from
		#positions
	where
		contract_id > @contract_id
end

create table
	#products(
		product_id int,
		quantity float,
		currency_id int,
		usd_equiv float NULL)

select
	@contract_id = 0
select
	@contracts = count(*)
from
	#deltas
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#deltas
	where
		contract_id > @contract_id

	select
		@delta = NULL,
		@vol = NULL,
		@price = NULL,
		@product_id = NULL,
		@currency_id = NULL,
		@product_qty = NULL,
		@currency_qty = NULL,
		@multiplier = NULL,
		@instrument = NULL

	select
		@delta = total_delta
	from
		#deltas
	where
		contract_id = @contract_id

	select
		@instrument = a.name
	from
		instruments a,
		contracts b
	where
		a.instrument_id = b.instrument_id
	and
		b.contract_id = @contract_id

	exec
		r_volasof
			@contract_id,
			@as_of_date,
			@vol output

	if @vol = NULL
		select
			@vol = @eurusd_vol

	exec
		r_priceasof
			@contract_id,
			@as_of_date,
			@price output

	select
		@weighted_delta = (@vol / @eurusd_vol) * @delta

	update
		#deltas
	set
		vol = @vol,
		weighted_delta = @weighted_delta,
		price = @price
	where
		contract_id = @contract_id

	exec
		r_contractproduct
			@contract_id,
			@product_id output
	exec
		r_contractcurrency
			@contract_id,
			@currency_id output

	exec
		x_contractmultiplier
			@contract_id,
			@multiplier output


	if @instrument = "Forward"
		select
			@product_qty = @weighted_delta * @multiplier
	else
		select
			@product_qty = @weighted_delta * @multiplier * @price

	select
		@currency_qty = @weighted_delta * -1.0 * @price * @multiplier

	if @weighted_delta != NULL
	begin
		if @instrument = "Forward"
		begin
			update
				#products
			set
				quantity = quantity + @product_qty
			where
				product_id = @product_id
			if @@rowcount != 1
				insert into
					#products
				values(
					@product_id,
					@product_qty,
					@product_id,
					NULL)
		end
		else
		begin
			update
				#products
			set
				quantity = quantity + @product_qty
			where
				product_id = @product_id
			if @@rowcount != 1
				insert into
					#products
				values(
					@product_id,
					@product_qty,
					@currency_id,
					NULL)
		end

		update
			#products
		set
			quantity = quantity + @currency_qty
		where
			product_id = @currency_id
		if @@rowcount != 1
			insert into
				#products
			values(
				@currency_id,
				@currency_qty,
				@currency_id,
				NULL)
	end

	select
		@contracts = count(*)
	from
		#deltas
	where
		contract_id > @contract_id

end

create table
	#product_output(
		product_id int,
		net_shorts float NULL,
		net_longs float NULL,
		usd_equiv float NULL)

select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"

select
	@product_id = 0
select
	@products = count(*)
from
	#products
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#products
	where
		product_id > @product_id

	select
		@delta = NULL,
		@usd_equiv = NULL,
		@currency_id = NULL


	select
		@delta = quantity,
		@currency_id = currency_id
	from
		#products
	where
		product_id = @product_id

	if @currency_id = @usd_product_id
		select
			@usd_equiv = @delta
	else
		exec
			r_dollaramount
				@currency_id,
				@delta,
				@as_of_date,
				@usd_equiv output

	update
		#products
	set
		usd_equiv = @usd_equiv
	where
		product_id = @product_id

	if @usd_equiv <= 0
		insert into
			#product_output
		values(
			@product_id,
			@delta,
			NULL,
			@usd_equiv)
	else
		insert into
			#product_output
		values(
			@product_id,
			NULL,
			@delta,
			@usd_equiv) 

	select
		@products = count(*)
	from
		#products
	where
		product_id > @product_id
end

select
	a.symbol,
	delta = convert(char(30), convert(numeric(30,4), b.delta / @factor)), 
	option_delta = convert(char(30), convert(numeric(30,4), b.option_delta / @factor)),
	total_delta = convert(char(30), convert(numeric(30,4), b.total_delta / @factor)),
	vol = convert(char(30), convert(numeric(30,4), b.vol)),
	weighted_delta = convert(char(30), convert(numeric(30,4), b.weighted_delta / @factor)),
	price = convert(char(30), convert(numeric(30,4), b.price)),
	set_vol = "SET VOL"
from
	contracts a,
	#deltas b
where
	a.contract_id = b.contract_id
order by
	a.symbol 

if @asset_class = "Currency"
begin 
	select
		@total_usd_equiv = sum(abs(usd_equiv)) / 2.0
	from
		#products
end
else
begin 
	select
		@total_usd_equiv = sum(usd_equiv)
	from
		#products a,
		products b
	where
		a.product_id = b.product_id
	and
		b.product_type_id = @product_type_id	
end 
	
create table
	#nets_output(
		product char(60),
		net_shorts char(30) NULL,
		net_longs char(30) NULL,
		usd_equiv char(70) NULL,
		ordering int)
		
insert into
	#nets_output
select
	product = a.symbol,
	net_shorts = convert(char(30), convert(numeric(30,4), b.net_shorts/@factor)),
	net_longs = convert(char(30), convert(numeric(30,4), b.net_longs/@factor)),
	usd_equiv = convert(char(30), convert(numeric(30,4), b.usd_equiv/1000000)),
	ordering = 0
from
	products a,
	#product_output b
where
	a.product_id = b.product_id
and
	a.product_type_id = @product_type_id
order by
	b.net_longs, a.symbol
	
insert into
	#nets_output
values(
	"<b><font size=2>" + rtrim(@asset_class) + " Total</font></b>",
	NULL,
	NULL,
	"<b><font size=2>" + convert(char(30), convert(numeric(30,4), @total_usd_equiv/1000000)) + "</font></b>",
	100)

select
	product,
	net_shorts,
	net_longs,
	usd_equiv
from
	#nets_output
order
	by ordering, net_longs desc
