	where
		internal_account_id > @internal_account_id

	select
		@internal_balance = NULL,
		@int_pl = NULL,
		@int_pl_date = NULL,
		@int_cash_activity = NULL,
		@int_fees = NULL,
		@int_adjustments = NULL,
		@int_interest = NULL,
		@int_other = NULL

	exec
		t_intaccountsum
			@internal_account_id,
			@internal_balance output,
			@int_pl output,
			@int_pl_date output,
			@int_cash_activity output,
			@int_fees output,
			@int_adjustments output,
			@int_interest output,
			@int_other output

	insert into
