create table
	#ext_accounts(
		external_account_id int)
insert into
	#ext_accounts
select
	a.external_account_id
from
	fund_external_accounts a,
	external_accounts b /* ,
	runs c,
	user_runs d */
where
	fund_id = @fund_id
and
	a.external_account_id = b.external_account_id
/* and
	b.symbol = c.name
and
	c.run_id = d.run_id
and
	d.tico_account_id = @tico_account_id */

create table
	#external_accounts(
		account char(100),
		account_type varchar(50), 
		cash_activity float,
		fees float,
		adjustments float,
		interest float,
		other float,
		p_l float,
		most_recent_pl datetime NULL,
		balance float)

select
	@external_account_id = 0
select
	@external_accounts = count(external_account_id)
from
	#ext_accounts
where
	external_account_id > @external_account_id


		
while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		#ext_accounts
	where
		external_account_id > @external_account_id

	select
		@external_balance = NULL

	select
		@external_balance = NULL,
		@ext_pl = NULL,
		@ext_pl_date = NULL,
		@ext_cash_activity = NULL,
		@ext_fees = NULL,
		@ext_adjustments = NULL,
		@ext_interest = NULL,
		@ext_other = NULL,
		@account_type = NULL


	select
		@account_type = a.name
	from
		external_account_types a,
		external_accounts b
	where
		a.external_account_type_id = b.external_account_type_id
	and
		b.external_account_id = @external_account_id
		
	exec
		t_extaccountsum
			@external_account_id,
			@external_balance output,
			@ext_pl output,
			@ext_pl_date output,
			@ext_cash_activity output,
			@ext_fees output,
			@ext_adjustments output,
			@ext_interest output,
			@ext_other output

	insert into
		#external_accounts
	select
		symbol,
		@account_type,
		@ext_cash_activity,
		@ext_fees,	
		@ext_adjustments,
		@ext_interest,
		@ext_other,
		@ext_pl,
		@ext_pl_date,
		@external_balance
	from
		external_accounts
	where
		external_account_id = @external_account_id

	select
		@external_accounts = count(external_account_id)
	from
		#ext_accounts
	where
		external_account_id > @external_account_id
	
end


select
	@external_balance = sum(balance)
from
	#external_accounts

