	a.internal_account_id
from
	fund_internal_accounts a,
	internal_accounts b,
	runs c,
	user_runs d
where
	fund_id = @fund_id
and
	a.internal_account_id = b.internal_account_id
and
	b.symbol = c.name
and
	c.run_id = d.run_id
and
	d.tico_account_id = @tico_account_id



