
drop procedure
	ag_accounttransactions
go

create procedure
	ag_accounttransactions
		@login varchar(50),
		@run_name varchar(50)=NULL,
		@account varchar(50)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@evaluation_ccy varchar(50)=NULL,
		@transaction_id int=NULL
as

declare @fund_id int
declare @run_id int
declare @ordering int
declare @ids int
declare @id int
declare @oid int
declare @oids int
declare @sql varchar(255)
declare @transaction_type_id int
declare @tico_label varchar(50)
declare @final_select varchar(255)
declare @amount float
declare @update_sql varchar(255)
declare @evaluation_currency_id int
declare @missing_conversion_rates int
declare @begin_balance float
declare @end_balance float
declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @transaction_date datetime


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"end_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"begin_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"amount",
	"Range Transaction History",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"edit_tran",
	"Edit Ledger Entry",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"equiv",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"amount",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = product_id
from
	products
where
	symbol = @evaluation_ccy
if @evaluation_currency_id = NULL
begin
	select
		@evaluation_currency_id = evaluation_currency_id
	from
		funds
	where
		fund_id = @fund_id
	if @evaluation_currency_id = NULL
	begin
		select
			status = "Error",
			message = "Evalution Currency not found"
		return
	end
end


if @run_name = NULL
begin
	select
		@run_name = name
	from
		funds
	where
		fund_id = @fund_id
end


if @begin_date = NULL
begin
	select
		@begin_date = max(price_date)
	from
		bo_spot_settles
	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output
	select
		@begin_date = convert(datetime, convert(date, @begin_date))
end
if @end_date = NULL
begin
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output
end


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end
create table
	#external_accounts(
		external_account_id int)

insert into
	#external_accounts
select
	external_account_id
from
	external_accounts
where
	symbol = @account


create table
	#account_transactions(
		account_transaction_id int,
		entered_by int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		currency_id int,
		amount float,
		note varchar(255) NULL,
		equiv float NULL)
insert into
	#account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount,
		note)
select
	a.account_transaction_id,
	a.entered_by,
	a.external_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.currency_id,
	a.amount,
	a.note
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date


create table
	#begin_balances(
		external_account_id int,
		currency_id int,
		begin_balance float,
		equiv float NULL)
insert into
	#begin_balances(
		external_account_id,
		currency_id,
		begin_balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date < @begin_date
group by
	a.external_account_id,
	a.currency_id

create table
	#end_balances(
		external_account_id int,
		currency_id int,
		end_balance float,
		equiv float NULL)
insert into
	#end_balances(
		external_account_id,
		currency_id,
		end_balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date <= @end_date
group by
	a.external_account_id,
	a.currency_id


/***********************/
update
	#begin_balances
set
	equiv = begin_balance
where
	currency_id = @evaluation_currency_id

update
	#begin_balances
set
	a.equiv = a.begin_balance * c.price
from
	#begin_balances a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @begin_date)

update
	#begin_balances
set
	a.equiv = a.begin_balance * (1.0 / c.price)
from
	#begin_balances a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @begin_date)
/***********************/


/***********************/
update
	#end_balances
set
	equiv = end_balance
where
	currency_id = @evaluation_currency_id

update
	#end_balances
set
	a.equiv = a.end_balance * c.price
from
	#end_balances a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#end_balances
set
	a.equiv = a.end_balance * (1.0 / c.price)
from
	#end_balances a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.currency_id
and
	b.product_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
/***********************/

/***********************/
update
	#account_transactions
set
	equiv = amount
where
	currency_id = @evaluation_currency_id

update
	#account_transactions
set
	a.equiv = a.amount * c.price
from
	#account_transactions a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)

update
	#account_transactions
set
	a.equiv = a.amount * (1.0 / c.price)
from
	#account_transactions a,
	forwards b,
	bo_spot_settles c
where
	a.currency_id = b.currency_id
and
	b.product_id = @evaluation_currency_id 
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
/***********************/




select
	@begin_balance = sum(equiv)
from
	#begin_balances

select
	@end_balance = sum(equiv)
from
	#end_balances


create table
	#output(
		id int identity,
		style varchar(250) NULL,
		edit_tran varchar(50) NULL,
		transaction_id int NULL,
		transaction_date datetime NULL,
		entered_by varchar(50) NULL,
		account varchar(50) NULL,
		transaction_type varchar(50) NULL,
		currency varchar(50) NULL,
		amount float NULL,
		note varchar(255) NULL,
		equiv float NULL)
insert into
	#output(
		account,
		style,
		transaction_date,
		transaction_type,
		equiv)
values(
	@account,
	@total_style,
	@begin_date,
	"Begin Balance",
	@begin_balance)

insert into
	#output(
		transaction_id,
		transaction_date,
		entered_by,
		account,
		transaction_type,
		currency,
		amount,
		note,
		equiv)
select
	a.account_transaction_id,
	a.transaction_date,
	b.login,
	c.symbol,
	d.name,
	e.symbol,
	a.amount,
	a.note,
	a.equiv
from
	#account_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d,
	products e
where
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	a.currency_id = e.product_id
order by
	a.transaction_date


insert into
	#output(
		account,
		style,
		transaction_date,
		transaction_type,
		equiv)
values(
	@account,
	@total_style,
	@end_date,
	"End Balance",
	@end_balance)

update
	#output
set
	edit_tran = "EDIT",
	style = @style
where
	transaction_id != NULL

if @transaction_id != NULL
begin
	update
		#output
	set
		style = @selected_style
	where
		transaction_id = @transaction_id

	select
		@transaction_date = transaction_date
	from
		#account_transactions
	where
		account_transaction_id = @transaction_id
end

select
	section = "Transaction History",
	/* style = "background:#FFFFFF;border: 1px solid white", */
	style,
	account,
	entered_by,
	edit_tran,
	transaction_id,
	transaction_date,
	transaction_type,
	amount,
	currency,
	equiv,
	note,
	begin_date = @begin_date,
	end_date = @end_date
from
	#output
order by
	id

exec
	ag_accountsettlementsfordate
		@login = @login,
		@account = @account,
		@transaction_date = @transaction_date,
		@transaction_id = @transaction_id,
		@begin_date = @begin_date,
		@end_date = @end_date



go
