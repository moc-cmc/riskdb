
if object_id("r_viewgroupfills") != NULL
    drop procedure
        r_viewgroupfills
go

create procedure
	r_viewgroupfills
		@login varchar(50),
		@trade_date datetime=NULL,
        @symbol varchar(50),
        @value_date datetime,
        @external_account varchar(50),
        @trader varchar(50),
        @quantity numeric(30,4),
        @deal_id int = NULL
as

declare @begin_date datetime
declare @end_date datetime

declare @cur_id int
declare @cur_deal_id int
declare @cur_deal_type varchar(50)
declare @cur_trade_id int
declare @cur_external_account varchar(50)
declare @cur_external_account_type varchar(25)
declare @cur_aggregation_style varchar(25)
declare @cur_trader varchar(50)
declare @cur_counterparty varchar(50)
declare @cur_broker varchar(50)
declare @cur_contract varchar(50)
declare @cur_quantity numeric(30,4)
declare @cur_price float
declare @cur_status varchar(25)

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#meta (
		meta_type char(50),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL
    )

insert into
	#meta
values (
	"Column Link",
	"overview",
	"Assign Trades",
	NULL
)
--Adaptive Server has expanded all '*' elements in the following statement


select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta
delete from #meta

select
    overview = "< Back to Assign Trades",
    trade_date = convert(varchar(10), @trade_date, 101),
    symbol = @symbol,
    value_date = convert(varchar(10), @value_date, 101),
    external_account = @external_account,
    trader = @trader,
    deal_id = @deal_id

go
