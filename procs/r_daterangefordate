
if object_id("r_daterangefordate") != NULL
    drop procedure
        r_daterangefordate
go
 
create procedure
	r_daterangefordate
		@date datetime=NULL,
		@begin_date datetime output,
		@end_date datetime output
as

declare @begin_day_string char(25)
declare @end_day_string char(25)

if @date = NULL
        select
                @date = getdate()
        if datepart(hour, @date) >= 17
                exec
                        r_nextbusinessday
                                @date,
                                @date output

        select
                @begin_day_string = convert(char(2), datepart(month, @date
)) + "/" +
                        convert(char(2), datepart(day, @date)) + "/" +
                        convert(char(4), datepart(year, @date))
        select
                @begin_date = convert(datetime, @begin_day_string)

        exec
                r_prevbusinessday
                        @begin_date,
                        @begin_date output

        select
                @begin_date = dateadd(hour, 17, @begin_date)

        exec
                r_nextbusinessday
                        @begin_date,
                        @end_date output

	select
        	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
                        	convert(char(2), datepart(day, @end_date)) + "/" +
                        	convert(char(4), datepart(year, @end_date)) + " 17:00"
        	select
                	@end_date = convert(datetime, @end_day_string)
	


go
