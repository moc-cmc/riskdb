drop procedure
	r_deletesuppressionsymbol
go

create procedure
	r_deletesuppressionsymbol
		@login varchar(50),
		@source varchar(50),
		@symbol varchar(50)

as

declare @source_id int
declare @dupe varchar(1)
declare @style varchar(250)
declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

select * from #meta



select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

select
	@source_id = source_id
from
	sources
where
	name = @source

if @source_id = NULL
begin
	select
		error = "Source not found",
		source = @source
	return
end

delete from
	suppression_symbols
where
	source_id = @source_id
and
	symbol = @symbol
if @@rowcount = 1
begin
	select
		style = @total_style,
		msg = "Suppression symbol has been removed for source",
		source = @source,
		symbol = @symbol
end
else
begin
	select
		style = @error_style,
		error = "Suppression symbol not found for source",
		source = @source,
		symbol = @symbol
		
end

exec
	r_suppressionsymbols
		@login

go


