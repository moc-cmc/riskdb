
if object_id("r_deleterunfilter") != NULL
    drop procedure
        r_deleterunfilter
go
 
create procedure
	r_deleterunfilter
		@login char(30),
		@run_name varchar(200),
		@filter_type varchar(100),
		@filter_value varchar(200)
as

declare @run_id int
declare @filter_id int
declare @message char(255)

select
	@run_id = run_id
from
	runs
where
	name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run_name = @run_name
	return
end

select
	@message = "<b><font color='00FFFF'>Removed " + rtrim(@filter_type) + " filter " + rtrim(@filter_value) + " from run " + rtrim(@run_name) + "</font></b>"


if @filter_type = "External Account"
begin
	select
		@filter_id = external_account_id
	from
		external_accounts
	where
		symbol = @filter_value
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem finding external account",
			external_account = @filter_value
		return
	end

	begin tran
		delete

		from
			run_external_accounts
		where
			run_id = @run_id
		and
			external_account_id = @filter_id
		if @@rowcount != 1
		begin
			select
				id = -1,
				error = "Problem deleting external account filter",
				run_name = @run_name,
				external_account = @filter_value
			rollback tran
			return
		end
	commit tran
	select
		id = 0,
		msg = "Successfully deleted external account filter",
		run_name = @run_name,
		external_account = @filter_value

	exec
		r_sendmessage
			@login,
			"Elysium Front Office",
			@message
end

if @filter_type = "Internal Account"
begin
