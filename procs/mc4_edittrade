
if object_id("mc4_edittrade") != NULL
    drop procedure
        mc4_edittrade
go

create procedure
    mc4_edittrade
        @login char(75),
        @trade_id int,
        @deal_id int = NULL,
        @identifier varchar(100) = NULL,
        @trade_date datetime = NULL,
        @trade_type varchar(25) = NULL,
        @contract varchar(50) = NULL,
        @value_date datetime = NULL,
        @fixing_date datetime = NULL,
        @quantity float = NULL,
        @price float = NULL,
        @internal_account varchar(100) = NULL,
        @external_account varchar(50) = NULL,
        @trader varchar(25) = NULL,
        @counterparty varchar(100) = NULL,
        @broker varchar(25) = NULL,
        @strategy varchar(100) = NULL,
        @pct_price numeric(30,6) = NULL,
        @spot_reference float = NULL,
        @sales_code varchar(25) = NULL,
        @status varchar(100) = NULL,
        @premium float = NULL,
        @premium_currency varchar(10) = NULL,
        @prem_settle_date datetime = NULL,
	@option_settle_date datetime = NULL

as

declare @user_id int

declare @orig_deal_id int
declare @orig_identifier varchar(100)
declare @orig_trade_date datetime
declare @orig_trade_type_id int
declare @orig_contract_id int
declare @orig_value_date datetime
declare @orig_fixing_date datetime
declare @orig_quantity numeric(30,4)
declare @orig_price float
declare @orig_internal_account_id int
declare @orig_external_account_id int
declare @orig_trader_id int
declare @orig_counterparty_id int
declare @orig_broker_id int
declare @orig_strategy_id int
declare @orig_pct_price numeric(30,6)
declare @orig_spot_reference float
declare @orig_sales_code_id int
declare @orig_status_id int
declare @orig_prime_broker_id int
declare @orig_premium float
declare @orig_premium_currency_id int
declare @orig_prem_settle_date datetime
declare @orig_option_settle_date datetime
declare @premium_currency_id int
declare @account_transaction_id int
declare @new_prime_broker_id int
declare @orig_ext_account_name varchar(50)
declare @cpty_ext_acct_id int
declare @is_fund_agency_cpty char(1)
declare @is_broker_trader char(1)

declare @trade_type_id int
declare @contract_id int
declare @internal_account_id int
declare @external_account_id int
declare @trader_id int
declare @counterparty_id int
declare @broker_id int
declare @strategy_id int
declare @sales_code_id int
declare @status_id int

declare @price_style varchar(50)
declare @send_edit char(1)
declare @account_status_id int
declare @readonly_status_id int

declare @pend_affirm_status_id int
declare @affirm_status_id int

select
	@send_edit = "N"

select
	@pend_affirm_status_id = status_id
from
	statuses
where
	name = "Pending Affirmation"

select
	@affirm_status_id = status_id
from
	statuses
where
	name = "Affirmed"

select
    @user_id = account_id,
    @account_status_id = status_id
from
    tico_accounts
where
    login = @login
if @@rowcount = 0
begin
    select
        status = "Error",
        message = "Login not found",
        login = @login
    return
end

select
	@readonly_status_id = status_id
from
	statuses
where
	name = "Read Only"

if @account_status_id = @readonly_status_id
begin
	select
		status = "Error",
		message = "Can not edit trade. Login status is Read Only"
	return
end


/* MARK: SELECT original values */
select
    @orig_deal_id = deal_id,
    @orig_trade_date = trade_date,
    @orig_trade_type_id = trade_type_id,
    @orig_contract_id = contract_id,
    @orig_value_date = value_date,
    @orig_fixing_date = fixing_date,
    @orig_quantity = quantity,
    @orig_price = price,
    @orig_internal_account_id = internal_account_id,
    @orig_external_account_id = external_account_id,
    @orig_trader_id = trader_id,
    @orig_counterparty_id = counterparty_id,
    @orig_broker_id = broker_id,
    @orig_strategy_id = strategy_id,
    @orig_pct_price = pct_price,
    @orig_spot_reference = spot_reference,
    @orig_sales_code_id = sales_code_id,
    @orig_status_id = status_id
from
    trades
where
    trade_id = @trade_id
if @@rowcount = 0
begin
    select
        status = "Error",
        message = "Trade not found",
        trade_id = @trade_id
    return
end

if @orig_quantity = 0
begin
	select
		status = "Error",
		message = "Trade has already been cancelled. Can not un-cancel a trade. Must rebook if necessary"
	return
end



if @trade_type = NULL
begin
	select
		@trade_type = name
	from
		trade_types
	where
		trade_type_id = @orig_trade_type_id
end

select
	@orig_prime_broker_id = prime_broker_id
from
	external_account_prime_brokers
where
	external_account_id = @orig_external_account_id
if @orig_prime_broker_id = NULL
begin
	select
		status = "Error",
		message = "Prime broker not initialized on trade. No ext acct prime broker record. Can not edit trade. Contact support@elysiumtechgroup.com and provide this error message"
	return
end

select
	@orig_ext_account_name = symbol
from
	external_accounts
where
	external_account_id = @orig_external_account_id
if @orig_ext_account_name like "%UNALLOC" and @quantity != 0
begin
	select
		status = "Error",
		message = "Error -- Can not edit the account of an unallocated trade. Revert changes and then use the 'Allocate Block' button"
	return
end

select
	@is_fund_agency_cpty = "Y"
from
	fund_agency_counterparties
where
	counterparty_id = @orig_counterparty_id


/* MARK: CHECK that this trade date is not being moved back prior to an already committed date */
declare @max_commit_date datetime

select 
	@max_commit_date = max(commit_date) 
from 
	daily_commits a, 
	commit_statuses b 
where 
	a.commit_status_id = b.commit_status_id 
and 
	b.name in("Commit Complete", "Commit Pending")


/* MARK: CHECK that this trade is not already committed*/
if (@trade_date <= convert(datetime, convert(varchar(8),  @max_commit_date, 112)+" 17:00"))
begin
	select
		status = "Error",
		message = "The trade date that was selected is already committed. Can not edit a trade to an already committed date",
		trade_date = @trade_date
	return
end

if (@orig_trade_date <= convert(datetime, convert(varchar(8),  @max_commit_date, 112)+" 17:00"))
begin
	select
		status = "Error",
		message = "This trade is already committed. Can not edit a committed trade",
		trade_date = @trade_date
	return
end

/* MARK: CHECK @trade_type */
if @trade_type != NULL
begin
    select
        @trade_type_id = trade_type_id
    from
        trade_types
    where
        name = @trade_type
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Trade type not found",
            trade_type = @trade_type
        return
    end
end

/* MARK: CHECK @contract */
if @contract != NULL
begin
    select
        @contract_id = contract_id
    from
        contracts
    where
        symbol = @contract
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Contract not found",
            contract = @contract
        return
    end
end

/* MARK: CHECK @internal_account */
if @internal_account != NULL
begin
    select
        @internal_account_id = internal_account_id
    from
        internal_accounts
    where
        symbol = @internal_account
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Internal account not found",
            internal_account = @internal_account
        return
    end
end

/* MARK: CHECK @external_account */
if @external_account != NULL
begin
    select
        @external_account_id = external_account_id
    from
        external_accounts
    where
        symbol = @external_account
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "External account not found",
            external_account = @external_account
        return
    end
    select
	@new_prime_broker_id = prime_broker_id
    from
	external_account_prime_brokers
    where
	external_account_id = @external_account_id

	/* If a user changes an external account, we need to change the trader on the trade too 
           for example, ext acct could have been BOAC ANZ, and trader would be BOAC ANZ. However
           if trade was allocated, the trader will not be the same as the external account (it would be the broker name),
           so only do this this if the original trader was not an UNLLOC broker trader */
	select
		@is_broker_trader = "Y"
	from
		traders a,
		external_accounts b
	where
		a.external_account_id = b.external_account_id
	and
		b.symbol like "%UNALLOC"
	and
		a.trader_id = @orig_trader_id
    if @is_broker_trader != "Y"
    begin
	select
		@trader = @external_account
    end
end

	
/* MARK: CHECK @trader */
if @trader != NULL
begin
    select
        @trader_id = trader_id
    from
        traders
    where
        symbol = @trader
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Trader not found - "+rtrim(@trader),
            trader = @trader
        return
    end
end

/* MARK: CHECK @counterparty */
if @counterparty != NULL
begin
    select
        @counterparty_id = counterparty_id,
	@cpty_ext_acct_id = external_account_id
    from
        counterparties
    where
        name = @counterparty
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Counterparty not found",
            counterparty = @counterparty
        return
    end
    select
	@new_prime_broker_id = prime_broker_id
    from 
	external_account_prime_brokers
     where
	external_account_id = @cpty_ext_acct_id
end

/* MARK: CHECK @broker */
if @broker != NULL
begin
    select
        @broker_id = broker_id
    from
        brokers
    where
        symbol = @broker
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Broker not found",
            broker = @broker
        return
    end
end

/* MARK: CHECK @strategy */
if @strategy != NULL
begin
    select
        @strategy_id = strategy_id
    from
        strategies
    where
        name = @strategy
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Strategy not found",
            strategy = @strategy
        return
    end
end

/* MARK: CHECK @sales_code */
if @sales_code != NULL
begin
    select
        @sales_code_id = sales_code_id
    from
        sales_codes
    where
        name = @sales_code
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Sales code not found",
            sales_code = @sales_code
        return
    end
end

/* MARK: CHECK @status */
if @status != NULL
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name = @status
    if @@rowcount = 0
    begin
        select
            status = "Error",
            message = "Status not found",
            name = @status
        return
    end
end

/* MARK: DEFAULT values */
if @new_prime_broker_id != NULL
begin
	if @new_prime_broker_id != @orig_prime_broker_id
	begin
		select
			status = "OK",
			message = "Can not change account across prime brokers. Must cancel and rebook"
		return
	end
end
if @deal_id = NULL
    select
        @deal_id = @orig_deal_id
if @trade_date = NULL
    select
        @trade_date = @orig_trade_date
if @trade_type_id = NULL
    select
        @trade_type_id = @orig_trade_type_id
if @contract_id = NULL
    select
        @contract_id = @orig_contract_id
if @value_date = NULL
    select
        @value_date = @orig_value_date
if @fixing_date = NULL
    select
        @fixing_date = @orig_fixing_date
if @quantity = NULL
    select
        @quantity = @orig_quantity
if @price = NULL
    select
        @price = @orig_price
if @internal_account_id = NULL
    select
        @internal_account_id = @orig_internal_account_id
if @external_account_id = NULL
    select
        @external_account_id = @orig_external_account_id
if @trader_id = NULL
    select
        @trader_id = @orig_trader_id
if @counterparty_id = NULL
begin
    select
        @counterparty_id = @orig_counterparty_id
end
else
begin
	if @is_fund_agency_cpty = "Y"
	begin
		select
			status="Error",
			message="Can not edit the counterparty on a client trade"
		return
	end
end
if @broker_id = NULL
    select
        @broker_id = @orig_broker_id
if @strategy_id = NULL
    select
        @strategy_id = @orig_strategy_id
if @pct_price = NULL
    select
        @pct_price = @orig_pct_price
if @spot_reference = NULL
    select
        @spot_reference = @orig_spot_reference
if @sales_code_id = NULL
    select
        @sales_code_id = @orig_sales_code_id
if @status_id = NULL
    select
        @status_id = @orig_status_id



if @trade_type in("Option", "Exotic")
begin
	select
		@account_transaction_id = c.account_transaction_id,
		@orig_premium = c.amount,
		@orig_premium_currency_id = c.currency_id,
		@orig_prem_settle_date = c.transaction_date
	from
		trades a,
		account_transaction_trades b,
		account_transactions c
	where
		a.trade_id = b.trade_id
	and
		b.account_transaction_id = c.account_transaction_id
	and
		a.trade_id = @trade_id	
	select
		@premium_currency_id = product_id
	from
		products
	where
		symbol = @premium_currency

	
end

if @premium = NULL
    select
	@premium = @orig_premium
if @premium_currency_id = NULL
    select
	@premium_currency_id = @orig_premium_currency_id
if @prem_settle_date = NULL
    select
        @prem_settle_date = @orig_prem_settle_date

/* MARK: CHECK modified */
if  @orig_deal_id = @deal_id and
    @orig_trade_date = @trade_date and
    @orig_trade_type_id = @trade_type_id and
    @orig_contract_id = @contract_id and
    @orig_value_date = @value_date and
    @orig_fixing_date = @fixing_date and
    @orig_quantity = @quantity and
    @orig_price = @price and
    @orig_internal_account_id = @internal_account_id and
    @orig_external_account_id = @external_account_id and
    @orig_trader_id = @trader_id and
    @orig_counterparty_id = @counterparty_id and
    @orig_broker_id = @broker_id and
    @orig_strategy_id = @strategy_id and
    @orig_pct_price = @pct_price and
    @orig_spot_reference = @spot_reference and
    @orig_sales_code_id = @sales_code_id and
    @orig_status_id = @status_id
begin
    /* DEBUG
    select 
	trade_type = @trade_type,
	orig_premium_currency_id = @orig_premium_currency_id,
	orig_premium = @orig_premium,
	orig_prem_settle_date = @orig_prem_settle_date,
	premium_currency_id = @premium_currency_id,
	premium = @premium,
	prem_settle_date = @prem_settle_date
    */

    if @trade_type = "Option" or @trade_type = "Exotic"
    begin
        if @orig_premium_currency_id = @premium_currency_id and
           @orig_premium = @premium and
           @orig_prem_settle_date = @prem_settle_date 
        begin
            select
                status = "OK",
                message = "No change in trade details. Trade not modified"
            return
        end
    end
    else
    begin
        select
            status = "OK",
            message = "No change in trade details. Trade not modified"
        return
    end
end


/* MARK: CHECK modified something that should send */
if  
    @orig_trade_date != @trade_date or
    @orig_trade_type_id != @trade_type_id or
    @orig_contract_id != @contract_id or
    @orig_value_date != @value_date or
    @orig_fixing_date != @fixing_date or
    @orig_quantity != @quantity or
    @orig_price != @price or
    @orig_internal_account_id != @internal_account_id or
    @orig_external_account_id != @external_account_id or
    @orig_trader_id != @trader_id or
    @orig_counterparty_id != @counterparty_id or
    @orig_broker_id != @broker_id or
    @orig_pct_price != @pct_price or
    @orig_premium_currency_id != @premium_currency_id or
    @orig_premium != @premium or
    @orig_prem_settle_date != @prem_settle_date 
begin
    select
        @send_edit = "Y"

end


/* Regulatory requirements for affirmation require we set to pending again on edit of trade details 
 * if the trade was already affirmed */
if @orig_status_id = @affirm_status_id and @pend_affirm_status_id != NULL and @affirm_status_id != NULL
begin
	select
		@status_id = @pend_affirm_status_id
end

select
	@trade_type = name
from
	trade_types
where
	trade_type_id = @orig_trade_type_id

if @trade_type in("Option", "Exotic")
begin
	if  @orig_contract_id != @contract_id 
        begin
		select
			status = "Error",
			message = "Can not edit the contract of an Option. Need to cancel rebook to change option contract details"
		return
	end
	if (@quantity = 0)
	begin	
		select
			@premium = 0
	end
        else if (sign(@quantity) != sign(@orig_quantity)) /* if we change quantity direction*/
        begin
		if sign(@premium) = sign(@orig_premium) /* and we did not change the direction on the premium*/
		begin
			/* then update the premium to follow suit of quantity */
			if sign(@quantity) = -1 
			begin
				if sign(@premium) = -1
				begin
					select
						@premium = @premium * -1
				end
			end
			else
			begin
				if sign(@premium) = 1
				begin
					select
						@premium = @premium * -1
				end
			end
		end
		else /* and we did change the premium direction*/
		begin
			/* then check to see the changes are correct */
			if sign(@quantity) = -1 and sign(@premium) = -1
			begin
				select
					status = "Error",
					message = "Modified both quantity and premium but direction on premium does not match direction on quantity"
				return
			end
			if sign(@quantity) = 1 and sign(@premium) = 1
			begin
				select
					status = "Error",
					message = "Modified both quantity and premium but direction on premium does not match direction on quantity"
				return
			end
		end
		
	end
	else /* if we did not edit quantity */
	begin
                if sign(@premium) = sign(@orig_premium) /* and we did not change the direction on the premium*/
                begin
                        /* then update the premium to follow suit of quantity */
                        if sign(@quantity) = -1
                        begin
                                if sign(@premium) = -1
                                begin
                                        select
                                                @premium = @premium * -1
                                end
                        end
                        else
                        begin
                                if sign(@premium) = 1
                                begin
                                        select
                                                @premium = @premium * -1
                                end
                        end
                end
                else /* and we did change the premium direction*/
                begin
                        /* then check to see the changes are correct */
                        if sign(@quantity) = -1 and sign(@premium) = -1
                        begin
                                select
                                        status = "Error",
                                        message = "Modified premium direction but direction on premium does not match direction on quantity"
                                return
                        end
                        if sign(@quantity) = 1 and sign(@premium) = 1
                        begin
                                select
                                        status = "Error",
                                        message = "Modified premium direction but direction on premium does not match direction on quantity"
                                return
                        end
                end
	end
end

begin tran

    exec
        r_inserttradeedit
            @trade_id = @trade_id

    update
        trades
    set
        deal_id = @deal_id,
        trade_date = @trade_date,
        trade_type_id = @trade_type_id,
        contract_id = @contract_id,
        value_date = @value_date,
        fixing_date = @fixing_date,
        quantity = @quantity,
        price = @price,
        internal_account_id = @internal_account_id,
        external_account_id = @external_account_id,
        trader_id = @trader_id,
        counterparty_id = @counterparty_id,
        broker_id = @broker_id,
        strategy_id = @strategy_id,
        pct_price = @pct_price,
        spot_reference = @spot_reference,
        sales_code_id = @sales_code_id,
        user_id = @user_id,
        status_id = @status_id
    where
        trade_id = @trade_id
    if @@rowcount = 1
    begin
	if @trade_type in("Option", "Exotic")
	begin
		if (@quantity = 0)
		begin	
			select
				@premium = 0
		end
		update 
			account_transactions
		set
			amount = @premium,
			currency_id = @premium_currency_id,
			transaction_date = @prem_settle_date
		where
			account_transaction_id= @account_transaction_id
                if @@rowcount != 1
		begin
			select
        			status = "Error",
        			message = "Could not update premium on option trade"
                        rollback
			return
		end
                if @value_date != @orig_value_date
		begin
			update 
				option_settledates
			set
				settledate = @value_date
			where
				contract_id = @contract_id
                	if @@rowcount != 1
                	begin
                        	select
                                	status = "Error",
                                	message = "Could not update settle date on option"
                        	rollback
                        	return
                	end

		end
	end
	if @send_edit = "Y"
        begin
		if (@quantity = 0)
		begin
			exec
				r_updatetradenotification @trade_id, "Cancelled"
		end
		else
		begin
		
			exec
				r_updatetradenotification @trade_id, "Edit" 
		end
    	end
    end	

commit tran

go
