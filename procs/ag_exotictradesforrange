create or replace procedure
	ag_exotictradesforrange
		@login varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL


as

declare @tico_account_id int
declare @ignore_date datetime

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

create table
	#meta(
			  meta_type char(200),
			  name char(50) NULL,
			  action char(100) NULL,
			  value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


if @begin_date = NULL
	select
		@begin_date = convert(datetime, convert(date, getdate()))


if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output
end
else
begin
        exec
		r_daterangefordate
		        @begin_date,
		        @begin_date output,
		        @ignore_date output
	
        exec
		r_daterangefordate
		        @end_date,
		        @ignore_date output,
		        @end_date output
end

create table
	#trades(
		trade_id int,
		deal_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		trade_type_detailed varchar(25) NULL,
		deal_type_id int NULL,
		deal_type varchar(25) NULL,
		internal_account_id int,
		internal_account varchar(30) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(15) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
		agency_vs_counterparty varchar(40) NULL,
		fund_agency_trade char(1) NULL,
		fund_agency_buy_sell varchar(8) NULL,
		client_buy_sell varchar(4) NULL,
		broker_id int,
		broker varchar(25) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		ext_account_pb varchar(25) NULL,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
		counter_ccy varchar(10) NULL,
		quantity float NULL,
		abs_qty float NULL,
		abs_counter_qty float NULL,
		abs_far_counter_qty float NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date varchar(15) NULL,
		fixing_date varchar(15) NULL,
		db_price float,
		std_price float NULL,
		markup_price float NULL,
		spot_reference float NULL,
		sales_code_id int,
		sales_code varchar(15) NULL,
		strategy_id int,
		strategy varchar(30) NULL,
		identifier varchar(100) NULL,
		trade_status_id int,
		trade_status varchar(20) NULL,
		/*- Option info -*/
		option_premium float NULL,
		option_premium_ccy_id int NULL,
		option_premium_ccy varchar(5) NULL,
		premium_settle_date datetime NULL,
		option_settle_date datetime NULL,
		optcon_exercise_style_id int NULL,
		optcon_exercise_style varchar(10) NULL,
		optcon_strike float NULL,
		optcon_put_call varchar(4) NULL,
		option_expiration_id int NULL,
		optexp_symbol varchar(30) NULL,
		optexp_expiration datetime NULL,
		optexp_timezone_id int NULL,
		optexp_time_zone varchar(30) NULL,
		optexp_tz_symbol varchar(30) NULL,
		optexp_tz_expiration_time varchar(10) NULL,
		optexp_tz_display_value varchar(10) NULL,
		optexp_tz_status int NULL,
		option_id int NULL,
		opt_underlying_contract_id int NULL,
		opt_underlying_contract varchar(10) NULL,
		opt_exchange_id int NULL,
		opt_exchange varchar(20) NULL,
		opt_def_exercise_style_id int NULL,
		opt_def_exercise_style varchar(10) NULL,
		opt_quantity float NULL,
		opt_tick_size float NULL,
		/*- Exotic Info -*/
		e_timing_id int NULL,
		e_timing varchar(12) NULL,
		e_po_ccy_id int NULL, /* payout currency */
		e_po_ccy varchar(3) NULL, /* payout currency */
		e_po_amt float NULL, /* payout amount */
		e_bt_id int NULL, /* barrier type */
		e_bt varchar(15) NULL, /* barrier type */
		e_btc varchar(15) NULL, /* barrier type */
		e_b float NULL, /* barrier */
		e_lb float NULL, /* lower_barrier */
		e_ub float NULL, /* upper_barrier */
		e_inst_id int NULL, /* instrument type id */
		e_inst varchar (20) NULL, /* instrument type */
		e_ud char(1) NULL, /* up or down */
		e_ws datetime NULL, /* up window start */
		e_we datetime NULL, /* up window end */
		note varchar(255) NULL
		)

/*
| Insert *_ids into #trades that need to be notified 
*/
insert into
	#trades
(
	trade_id,
	deal_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	trader_id,
	counterparty_id,
	fund_agency_trade,
	contract_id,
	broker_id,
	quantity,
	trade_date,
	value_date,
	fixing_date,
	db_price,
	std_price,
	spot_reference,
	sales_code_id,
	strategy_id,
	identifier,
	trade_status_id
)
select 
	trade_id = a.trade_id,
	deal_id = a.deal_id,
	trade_type_id = a.trade_type_id,
	internal_account_id = a.internal_account_id,
	external_account_id = a.external_account_id,
	trader_id = a.trader_id,
	counterparty_id = a.counterparty_id,
        fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	quantity = a.quantity,
	trade_date = a.trade_date,
	value_date = convert(varchar(12), a.value_date, 112),
	fixing_date = convert(varchar(12), a.fixing_date, 112),
	db_price = a.price,
	std_price = a.price,
	spot_reference = a.spot_reference,
	sales_code_id = a.sales_code_id,
	strategy_id = a.strategy_id,
	identifier = a.identifier,
	trade_status_id = a.status_id
from
	trades a,
	contracts b,
	exotic_contracts c
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date


/*
| Query internal_accounts
*/

update
	#trades
set
	internal_account = b.symbol
from
	#trades a,
	internal_accounts b
where
	a.internal_account_id = b.internal_account_id


/*
| Query external_accounts
*/

update 
        #trades
set
        external_account = b.symbol,
	external_account_type_id = b.external_account_type_id
from
        #trades a,
        external_accounts b
where
        a.external_account_id = b.external_account_id

update
	#trades 
set
	external_account_type = b.name
from
	#trades a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id


	
/*
| Query traders
*/
update
	#trades
set
	trader = b.symbol
from
        #trades a,
        traders b
where
        a.trader_id = b.trader_id


/*
| Query counterparties
*/

update
	#trades
set
	counterparty = b.name,
	agency_vs_counterparty = b.name
from
	#trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#trades
set
	fund_agency_trade = "Y",
	agency_vs_counterparty = a.external_account
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id


/*
| Query brokers
*/

update
	#trades
set
	broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id


/*
| Query strategies
*/

update 
	#trades
set
	strategy = b.name
from
	#trades a,
	strategies b
where
	a.strategy_id = b.strategy_id

/* strategy_symbols does not exist */

/*
| Query strategies
*/

update
        #trades
set
        sales_code = b.name
from
        #trades a,
        sales_codes b
where
        a.sales_code_id = b.sales_code_id


update
        #trades
set
	trade_status = b.name
from
        #trades a,
        statuses b
where
        a.trade_status_id = b.status_id


update
	#trades
set
	prime_broker_id = d.prime_broker_id,
	prime_broker = c.name
from
	#trades a,
	external_account_prime_brokers b,
	prime_brokers d,
	sources c
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = d.prime_broker_id
and
	c.source_id = d.source_id


/*
| Set trading day to EST 17:00-17:00 market standard
*/
update
	#trades
set
	trade_day = case
		when a.trade_date >= convert(char(8), a.trade_date, 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 112))
		else
			convert(char(12), a.trade_date, 112)
	end
from
	#trades a


/*
| Query option details
*/
update
	#trades
set
	optcon_exercise_style_id = b.exercise_style_id,
	optcon_exercise_style = c.name,
	optcon_strike = b.strike,
	optcon_put_call = b.put_call,
	option_expiration_id = b.option_expiration_id
from
	#trades a,
	option_contracts b,
	exercise_styles c
where
        a.contract_id = b.contract_id
and
	b.exercise_style_id = c.exercise_style_id

/* exotic */
update
        #trades
set
        optcon_exercise_style_id = b.exercise_style_id,
        optcon_exercise_style = c.name,
        optcon_strike = b.strike,
        optcon_put_call = b.put_call,
        option_expiration_id = b.option_expiration_id,
	e_timing_id = b.timing_id,
	e_po_ccy_id = b.payout_ccy_id,
	e_bt_id = b.barrier_type_id,
	e_b = b.barrier,
	e_lb = b.lower_barrier,
	e_ub = b.upper_barrier,
	e_inst_id = d.exotic_instrument_id,
	e_inst = d.name,
	e_ws = b.window_start,
	e_we = b.window_end
from
        #trades a,
        exotic_contracts b,
        exercise_styles c,
	exotic_instruments d
where
        a.contract_id = b.contract_id
and
	b.exercise_style_id = c.exercise_style_id
and
	b.exotic_instrument_id  = d.exotic_instrument_id

update
	#trades 
set
	e_po_amt = b.payout_amount,
	note = b.note
from
	#trades a,
	trade_attributes b
where
	a.trade_id = b.trade_id

update
	#trades
set
	e_bt = b.barrier,
	e_btc = b.subtype
from
	#trades a,
	barrier_types b
where
	a.e_bt_id = b.barrier_type_id


update 
	#trades
set
	e_ud = "D"
from
	#trades a,
	barrier_types b
where
	a.e_bt_id = b.barrier_type_id
and
	b.barrier in("Down and In", "Down and Out")

update
        #trades
set
        e_ud = "U"
from
        #trades a,
        barrier_types b
where
        a.e_bt_id = b.barrier_type_id
and
        b.barrier in("Up and Out", "Up and In")

update 
        #trades
set
        e_ud = case 
		when a.spot_reference > a.e_b then "D" 
		when a.spot_reference < a.e_b then "U"
		else ""
	end
from
        #trades a,
        barrier_types b
where
        a.e_bt_id = b.barrier_type_id
and
        b.barrier in("OT", "NT")

update
	#trades
set
	e_ub = e_b
where
	e_ud = "U"

update
        #trades
set
        e_lb = NULL
where
        e_ud = "U"

update
        #trades
set
        e_lb = e_b
where
        e_ud = "D"

update
        #trades
set
        e_ub = NULL
where
        e_ud = "D"

update
	#trades
set
	e_po_ccy = b.symbol
from
	#trades a,
	products b
where
	a.e_po_ccy_id = b.product_id

update
	#trades 
set
	e_timing = b.timing
from
	#trades a,
	timings b
where
	a.e_timing_id = b.timing_id

update
	#trades
set
	e_b = e_lb
where
	e_inst = "Double Barrier"

update 
	#trades
set
	a.e_b = a.e_lb
from
        #trades a,
        barrier_types b
where
        a.e_bt_id = b.barrier_type_id
and
        b.barrier in("DOT", "DNT")

update 
	#trades
set
	quantity = 0
where
	e_po_ccy_id != NULL

/* end exotic except for window barriers which is further below */

update
	#trades
set
	option_id = b.option_id,
	optexp_symbol = b.symbol,
	optexp_expiration = b.expiration,
	optexp_timezone_id = b.timezone_id
from
        #trades a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id

update 
	#trades
set
	optexp_time_zone = b.timezone,
	optexp_tz_symbol = b.symbol,
	optexp_tz_expiration_time = b.expiration_time,
	optexp_tz_display_value = b.display_value,
	optexp_tz_status = b.status
from
	#trades a,
	timezones b
where
	a.optexp_timezone_id = b.timezone_id

update
	#trades
set
	opt_underlying_contract_id = b.underlying_contract_id,
	opt_exchange_id = b.exchange_id,
	opt_exchange = c.name,
	opt_def_exercise_style_id = b.def_exercise_style_id,
	opt_def_exercise_style = d.name,
	opt_quantity = b.quantity,
	opt_tick_size = b.tick_size
from
	#trades a,
	options b,
	exchanges c,
	exercise_styles d
where
	a.option_id = b.option_id
and
	b.exchange_id = c.exchange_id
and
	b.def_exercise_style_id = d.exercise_style_id
	
update
        #trades
set
        traded_ccy = g.symbol,
        counter_ccy = f.symbol
from
        #trades a,
        contracts b,
        forwards e,
        products f,
        products g
where
        a.opt_underlying_contract_id = b.contract_id
and
        b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id



update
	#trades
set
	option_premium = b.amount,
	option_premium_ccy_id = b.currency_id,
	premium_settle_date = b.transaction_date
from
	#trades a,
	account_transactions b,
	account_transaction_trades c
where
	a.trade_id = c.trade_id
and
	c.account_transaction_id = b.account_transaction_id

update
	#trades
set
	option_premium_ccy = b.symbol
from
	#trades a,
	products b
where
	a.option_premium_ccy_id = b.product_id

update
	#trades
set
	option_settle_date = b.settledate
from
	#trades a,
	option_settledates b
where
	a.contract_id = b.contract_id


update
        #trades
set
        e_bt = rtrim(e_bt)+"W"
where
        e_bt in("Down and In", "Down and Out", "Up and Out", "Up and In", "DKO", "DKI")
and
        e_ws != NULL
and
        e_we != NULL
and
        convert(date, e_ws) != convert(date, e_we)
and
        (
        convert(date, e_ws) != convert(date, trade_day)
or       
         convert(date, e_we) != convert(date, optexp_expiration)
        )

select
	* 
from
	#meta

select
	section = "Exotic Trades",
	trade_id,
	deal_id,
        trade_day = rtrim(convert(varchar(10), trade_day, 112)),
	prime_broker,
        vs_counterparty=agency_vs_counterparty,
	/*external_account,
	counterparty,
        */
	cl_or_lp=case when fund_agency_trade = "Y" then "LP" else "CL" end,
	traded_ccy,
	counter_ccy,
	strike=optcon_strike,
	put_call=optcon_put_call,
	quantity,
	premium=option_premium,
	premium_ccy = option_premium_ccy,
	premium_date=rtrim(convert(varchar(10), premium_settle_date, 112)),
	expiration_date=rtrim(convert(varchar(10), optexp_expiration, 112)),
	settle_date=rtrim(convert(varchar(10), option_settle_date, 112)),
	time_zone=optexp_time_zone,
	fixing_date,
	exercise=optcon_exercise_style,
	timing=e_timing,
	payout_ccy=e_po_ccy, 
	payout_amt=e_po_amt, 
	instrument = e_inst,  
	barrier_type=e_bt,     /* barrier type    */
	barrier_class=e_btc,     /* barrier type    */
	barrier=e_b,      /* barrier         */
	l_barrier = e_lb,     /* lower_barrier   */
	u_barrier = e_ub,     /* upper_barrier   */
	spot_reference,
	e_ud,     /* up or down barrier */
	window_start = e_ws,
	window_end = e_we,
	note = note
from
        #trades
where
	quantity != 0
order by
        deal_id, 
        trade_id


select
        section = "Cancels",
        trade_id,
        deal_id,
        trade_day = rtrim(convert(varchar(10), trade_day, 112)),
        prime_broker,
        vs_counterparty=agency_vs_counterparty,
        /*external_account,
        counterparty,
        */
        cl_or_lp=case when fund_agency_trade = "Y" then "LP" else "CL" end,
        traded_ccy,
        counter_ccy,
        strike=optcon_strike,
        put_call=optcon_put_call,
        quantity,
        premium=option_premium,
        premium_ccy = option_premium_ccy,
        premium_date=rtrim(convert(varchar(10), premium_settle_date, 112)),
        expiration_date=rtrim(convert(varchar(10), optexp_expiration, 112)),
        settle_date=rtrim(convert(varchar(10), option_settle_date, 112)),
        time_zone=optexp_time_zone,
        fixing_date,
        exercise=optcon_exercise_style,
        timing=e_timing,
        payout_ccy=e_po_ccy,
        payout_amt=e_po_amt,
        instrument = e_inst,
        barrier_type=e_bt,     /* barrier type    */
        barrier_class=e_btc,     /* barrier type    */
        barrier=e_b,      /* barrier         */
        l_barrier = e_lb,     /* lower_barrier   */
        u_barrier = e_ub,     /* upper_barrier   */
        spot_reference,
        e_ud,     /* up or down barrier */
        window_start = e_ws,
        window_end = e_we,
        note = note
from
        #trades
where
        quantity = 0
order by
	deal_id,
        trade_id


go
