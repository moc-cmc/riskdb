use
	risk_ram
go

drop procedure
	r_importpulsenewedge
go

create procedure
	r_importpulsenewedge
		@login varchar(50),
		@business_date varchar(100)=NULL,
		@trade_date varchar(100)=NULL,
		@firm varchar(100)=NULL,
		@office varchar(100)=NULL,
		@account varchar(100)=NULL,
		@ex_code varchar(100)=NULL,
		@fut_code varchar(100)=NULL,
		@symbol varchar(100)=NULL,
		@contract_description varchar(100)=NULL,
		@matdate varchar(100)=NULL,
		@put_call varchar(100)=NULL,
		@strike varchar(100)=NULL,
		@price varchar(100)=NULL,
		@long_qty varchar(100)=NULL,
		@short_qty varchar(100)=NULL,
		@closing_price varchar(100)=NULL,
		@currency varchar(100)=NULL,
		@ote varchar(100)=NULL,
		@ps_premium varchar(100)=NULL,
		@fn_date varchar(100)=NULL,
		@lt_date varchar(100)=NULL,
		@expiration_date varchar(100)=NULL,
		@source varchar(100)=NULL,
		@dataport_timestamp varchar(100)=NULL,
		@row_count int,
		@row_index int,
		@session_id varchar(100)

as

declare @contract_id int
declare @newedge_source_id int
declare @mpt_symbol varchar(50)
declare @external_account_id int
declare @external_account varchar(50)
declare @quantity int
declare @as_of_date datetime
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @ids int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
	  
insert into 
	#meta 
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta


if @row_index = 0
begin
	delete

	from
		session_positions
	where
		session_id = @session_id
end


select
	@as_of_date = convert(datetime, @business_date)


select
	@quantity = convert(int, @long_qty) - convert(int, @short_qty)

select
	@newedge_source_id = source_id
from
	sources
where
	name = "NewEdge"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "NewEdge source not found"
end

select
	@external_account_id = external_account_id
from
	external_account_symbols
where
	source_id = @newedge_source_id
and
	symbol = @account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "External account not found",
		account = @account
	return
end
	
select
	@external_account = symbol
from
	external_accounts
where
	external_account_id = @external_account_id

select
	@contract_id = contract_id
from
	contract_symbols
where
	symbol = @contract_description
and
	source_id = @newedge_source_id
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		contract = @contract_description
	return
end


select
	@mpt_symbol = symbol
from
	contracts
where
	contract_id = @contract_id
	
update
	session_positions
set
	quantity = quantity + @quantity
where
	session_id = @session_id
and
	contract_id = @contract_id
and
	as_of_date = @as_of_date
and
	external_account_id = @external_account_id
if @@rowcount = 0
begin
	insert into
		session_positions
	values(
		@session_id,
		@as_of_date,
		@external_account_id,
		@contract_id,
		@quantity)
	
end


if @row_count = @row_index + 1
begin
	create table
		#match(
			id int identity,
			external_account_id int,
			contract_id int,
			newedge_quantity int,
			mpt_quantity int NULL,
			style varchar(250) NULL)

	exec
		r_daterangefordate
			@as_of_date,
			@begin_date output,
			@end_date output

	insert into
		#match(
			external_account_id,
			contract_id,
			newedge_quantity,
			style)
	select
		external_account_id,
		contract_id,
		quantity,
		style = "background:#FFFFFF;border: 1px solid white"
	from
		session_positions
	where
		session_id = @session_id
	and
		as_of_date = @as_of_date

	delete

	from
		session_positions
	where
		session_id = @session_id


	select
		@id = 0
	select
		@ids = count(*)
	from
		#match
	where
		id > @id

	while @ids > 0
	begin
		select
			@id = min(id)
		from
			#match
		where
			id > @id

		select
			@external_account_id = external_account_id,
			@contract_id = contract_id
		from
			#match
		where
			id = @id


		select
			@quantity = NULL
		select
			@quantity = sum(quantity)
		from
			trades
		where
			contract_id = @contract_id
		and
			external_account_id = @external_account_id
		and
			trade_date < @end_date

		update
			#match
		set
			mpt_quantity = @quantity
		where
			id = @id


		select
			@ids = count(*)
		from
			#match
		where
			id > @id
	end

	update
		#match
	set
		style = "background:#FFCCCC;border: 1px solid white"
	where
		mpt_quantity = NULL

	update
		#match
	set
		style = "background:#FFCCCC;border: 1px solid white"
	where
		newedge_quantity != mpt_quantity

	select
		c.style,
		as_of_date = @as_of_date,
		account = a.symbol,
		contract = b.symbol,
		c.newedge_quantity,
		c.mpt_quantity
	from
		external_accounts a,
		contracts b,
		#match c
	where
		a.external_account_id = c.external_account_id
	and
		b.contract_id= c.contract_id
	order by
		a.symbol,
		b.symbol
		

end



go

