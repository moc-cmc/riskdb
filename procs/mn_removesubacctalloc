use
	risk_atglobal
go

drop procedure
	mn_removesubacctalloc
go

create procedure
	mn_removesubacctalloc
		@login varchar(50),
		@master_allocation varchar(50),
		@version int,
		@account varchar(50),
		@allocation float
as

declare @sub_account_id int
declare @status varchar(50)


select
	@sub_account_id = a.sub_account_id,
	@status = e.name
from
	sub_accounts a,
	ma_versions b,
	master_allocations c,
	external_accounts d,
	statuses e
where
	a.ma_version_id = b.ma_version_id
and
	b.status_id = e.status_id
and
	b.master_allocation_id = c.master_allocation_id
and
	a.external_account_id = d.external_account_id
and
	d.symbol = @account
and
	c.name = @master_allocation
and
	b.version = @version

if @sub_account_id = NULL
begin
	select
		status = "Error",
		message = "Sub account not found",
		sub_account = @account
	return
end

if @status != "Queued"
begin
	select
		status = "Error",
		message = "Edit failed. Only Queued status allocations can be updated"
	return
end


delete

from
	sub_accounts
where
	sub_account_id = @sub_account_id


exec
	mn_inspectsubaccounts
		@login,
		@master_allocation,
		@version

go
