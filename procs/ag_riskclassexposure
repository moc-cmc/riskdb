create table
	#account_exposure(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		reporting_domain_id int NULL,
		reporting_domain varchar(100) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(50) NULL,
		long_equiv float NULL,
		short_equiv float NULL,
		net float NULL)

insert into
	#account_exposure(
		style,
		external_account_id,
		account,
		reporting_domain_id,
		reporting_domain,
		prime_broker_id,
		prime_broker,
		long_equiv,
		short_equiv,
		net)
select
	style = @style,
	a.external_account_id,
	b.symbol,
	a.reporting_domain_id,
	c.name,
	a.prime_broker_id,
	d.name,
	long_equiv = 0.0,
	short_equiv = 0.0,
	net = 0.0
from
	#accounts a,
	external_accounts b,
	reporting_domains c,
	#pbs d
where
	a.external_account_id = b.external_account_id
and
	a.reporting_domain_id = c.reporting_domain_id
and
	a.prime_broker_id = d.prime_broker_id
order by
	b.symbol,
	d.name

