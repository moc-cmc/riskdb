create table
	#trades(
		trade_id int,
		trade_date datetime,
		amount numeric(30,4),
		price float,
		counter_amount numeric(30,4),
		contract_id int,
		product_id int,
		currency_id int,
		value_date datetime,
		external_account_id int,
		reporting_domain_id int NULL,
		prime_broker_id int NULL,
		amount_equiv float NULL,
		counter_amount_equiv float NULL)

insert into
	#trades(
		trade_id,
		trade_date,
		amount,
		price,
		counter_amount,
		contract_id,
		product_id,
		currency_id,
		value_date,
		external_account_id)
select
	a.trade_id,
	a.trade_date,
	a.quantity,
	a.price,
	a.quantity * a.price * -1.0,
	a.contract_id,
	h.product_id,
	h.currency_id,	
	a.value_date,
	a.external_account_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	forwards h
where
	a.contract_id = h.contract_id
and
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

update
	#trades
set
	a.reporting_domain_id = b.reporting_domain_id
from
	#trades a,
	reporting_domains b
where
	b.name = "Uncategorized"

update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	distinct(product_id)
from
	#trades
insert into
	#conversion_rates(
		product_id)
select
	distinct(currency_id)
from
	#trades
where
	currency_id not in(select product_id from #conversion_rates)

update
	#conversion_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL


update
	#trades
set
	a.amount_equiv = a.amount * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#trades
set
	a.counter_amount_equiv = a.counter_amount * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id


