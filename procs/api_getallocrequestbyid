create or replace procedure
	api_getallocrequestbyid
		@allocation_request_id int

as

declare @open_request char(1)

select
	@open_request = "Y"
from
	allocation_requests a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name in("New")
and
	a.allocation_request_id = @allocation_request_id

if @open_request != "Y"
begin
	select
		status = "Error", 
		message = "Problem finding open request from id",
		allocation_request_id = @allocation_request_id
	return
end

select
	allocation_request_id = a.allocation_request_id,
	external_account_id = c.external_account_id,
	external_account_symbol = c.symbol,
	external_account_name = c.name,
	product_id = d.product_id,
	product_symbol = d.symbol
from
	allocation_requests a,
	fo_sub_accounts b,
	external_accounts c,
	products d
where
	a.fo_sub_account_id = b.fo_sub_account_id
and
	b.external_account_id = c.external_account_id
and
	a.product_id = d.product_id
and
	a.allocation_request_id = @allocation_request_id

go
