drop procedure
	ag_addclientfxsettlement
go

create procedure
	ag_addclientfxsettlement
		@login varchar(50),
		@account varchar(50),
		@currency varchar(50),
		@balance numeric(30,2),
		@value_date datetime,
		@display varchar(1)
as


declare @fund_id int
declare @external_account_id int
declare @tico_account_id int
declare @transaction_type_id int
declare @currency_id int
declare @prime_broker varchar(50)
declare @account_transaction_id int
declare @settled_status_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@settled_status_id = status_id
from
	statuses
where
	name = "Settle FX Settlement"

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "FX Settlement type not found"
	return
end

select
	@currency_id = product_id
from
	products
where
	symbol = @currency
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Currency not found",
		currency = @currency
	return
end

create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50))
insert into
	#external_accounts
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.fund_id = @fund_id

select
	@external_account_id = external_account_id
from
	#external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

select
	@prime_broker = a.name
from
	sources a,
	prime_brokers b,
	external_account_prime_brokers c
where
	a.source_id = b.source_id
and
	b.prime_broker_id = c.prime_broker_id
and
	c.external_account_id = @external_account_id

exec
	j_nextkey
		"account_transactions",
		@account_transaction_id output

insert into
	account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount)
values(
	@account_transaction_id,
	@tico_account_id,
	@external_account_id,
	@transaction_type_id,
	@value_date,
	@currency_id,
	@balance)


insert into
	transaction_logs(
                settled_by,
                external_account_id,
                status_id,
		currency_id,
                amount,
                settle_date,
                timestamp)
values(
	@tico_account_id,
	@external_account_id,
	@settled_status_id,
	@currency_id,
	@balance,
	@value_date,
	getdate())
	



if @display != "N"
begin
	exec
		ag_clientsettlements
		@login,
		@value_date,
		@prime_broker
end

go
