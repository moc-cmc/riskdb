drop procedure
	ag_importspectrumcashmoves
go

create procedure
	ag_importspectrumcashmoves
		@login varchar(50),
		@trans_date varchar(50)=NULL,
		@transaction_number varchar(50)=NULL,
		@vostro_type varchar(50)=NULL,
		@customer varchar(50)=NULL,
		@direction varchar(50)=NULL,
		@cur varchar(50)=NULL,
		@face_amount varchar(50)=NULL,
		@value_date varchar(50)=NULL,
		@purpose varchar(50)=NULL,
		@portfolio varchar(50)=NULL,
		@trader varchar(50)=NULL,
		@ext_ref varchar(50)=NULL,
		@liq_provider varchar(50)=NULL,
		@row_index int,
		@row_count int

as

declare @source varchar(50)
declare @tico_account_id int
declare @source_id int
declare @external_account_id int
declare @product_id int
declare @quantity numeric(30,4)
declare @converted_quantity numeric(30,4)
declare @val_date datetime
declare @account_transaction_id int
declare @closed_transaction_id int
declare @transaction_type_id int
declare @closed_identifier varchar(200)
declare @identifier varchar(200)
declare @fund_id int
declare @evaluation_currency_id int
declare @conversion_rate float


select
	@source = "Spectrum"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end


if @trans_date = NULL
	return
if @trans_date = "VOSTRO TRANSACTION"
	return
if @trans_date = "TRANS DATE"
	return

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Unable to find evaluation currency for fund"
	return
end


select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end


select
	@external_account_id = external_account_id
from
	external_account_symbols
where
	source_id = @source_id
and
	symbol = @customer
if @external_account_id = NULL
begin
	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @customer
	if @external_account_id = NULL
	begin
		select
			status = "Error",
			message = "External account not found",
			external_account = @customer
		return
	end
end


select
	@product_id = product_id
from
	product_symbols
where
	source_id = @source_id
and
	symbol = @cur
if @product_id = NULL
begin
	select
		@product_id = product_id
	from
		products
	where
		symbol = @cur
	if @product_id = NULL
	begin
		select
			status = "Error",
			message = "Product not found",
			product = @cur
		return
	end
end

select
	@quantity = convert(numeric(30,4), @face_amount)

if @direction = "Credit"
	select
		@quantity = @quantity * -1.0
 	
select
	@val_date = convert(datetime, @value_date)

if @row_index = 0
begin
	delete

	from
		source_ladder
	where
		source_id = @source_id
	and
		convert(date, value_date) = convert(date, @value_date)
end


if @vostro_type != "CONV"
begin
	select
		status = "Error",
		message = "Encountered non CONV transaction",
		transaction_number = @transaction_number
	return
end

insert into
	source_ladder(
		source_id,
		external_account_id,
		product_id,
		value_date,
		source_balance)
values(
	@source_id,
	@external_account_id,
	@product_id,
	@value_date,
	@quantity)

select
	@closed_identifier = rtrim(@source) + "-" + rtrim(@transaction_number) + "-" + convert(varchar(11), @val_date) + "-" + rtrim(@cur),
	@identifier = rtrim(@source) + "-" + rtrim(@transaction_number) + "-" + convert(varchar(11), @val_date)

if @product_id = @evaluation_currency_id 
begin
	select
		@conversion_rate = 1.0
end
else
begin
	select
		@conversion_rate = a.price
	from
		bo_spot_settles a,
		forwards b
	where
		a.contract_id = b.contract_id
	and
		b.product_id = @product_id
	and
		b.currency_id = @evaluation_currency_id
	and
		convert(date, a.price_date) = convert(date, @value_date)
	if @conversion_rate = NULL
	begin
		select
			@conversion_rate = 1.0 / a.price
		from
			bo_spot_settles a,
			forwards b
		where
			a.contract_id = b.contract_id
		and
			b.product_id = @evaluation_currency_id
		and
			b.currency_id = @product_id
		and
			convert(date, a.price_date) = convert(date, @value_date)
		if @conversion_rate = NULL
		begin
			select
				status = "Error",
				message = "Conversion rate for residual not found",
				identifier = @identifier,
				product_id = @product_id,
				cur = @cur,
				evaluation_currency_id = @evaluation_currency_id
			return
		end
	end
end
	

select
	@converted_quantity = @quantity * @conversion_rate

if @product_id = @evaluation_currency_id
begin
	select
		@account_transaction_id = account_transaction_id
	from
		account_transactions
	where
		note = @identifier
	if @account_transaction_id != NULL
	begin
		select
			status = "Dupe",
			message = "Account transaction already booked",
			identifier = @identifier
	end
	else
	begin
		exec
			j_nextkey
				"account_transactions",
				@account_transaction_id output
		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount,
				note)
		values(
			@account_transaction_id,
			@tico_account_id,
			@external_account_id,
			@transaction_type_id,
			@val_date,
			@evaluation_currency_id,
			@converted_quantity,
			@identifier)
	end
end


if @product_id != @evaluation_currency_id
begin
	select
		@closed_transaction_id = account_transaction_id
	from
		closed_account_transactions
	where
		note = @closed_identifier
	if @closed_transaction_id != NULL
	begin
		select
			status = "Dupe",
			message = "Closed Account transaction already booked",
			identifier = @closed_identifier
	end
	else
	begin
		exec
			j_nextkey
				"account_transactions",
				@closed_transaction_id output
		insert into
			closed_account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount,
				note)
		values(
			@closed_transaction_id,
			@tico_account_id,
			@external_account_id,
			@transaction_type_id,
			@val_date,
			@product_id,
			@quantity,
			@closed_identifier)
	end
end


/*
if @row_index = @row_count - 1
	exec
		ag_reconsourceladder
			@login,
			@val_date
*/



go

