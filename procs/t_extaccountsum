
if object_id("t_extaccountsum") != NULL
    drop procedure
        t_extaccountsum
go

create procedure
	t_extaccountsum
		@external_account_id int,
		@total_balance float output,
		@pl float output,
		@pl_date datetime output,
		@cash_activity float output,
		@fees float output,
		@adjustments float output,
		@interest float output,
		@other float output
as

declare @pl_trans_type_id int
declare @depo_trans_type_id int
declare @with_trans_type_id int
declare @fee_trans_type_id int
declare @adj_trans_type_id int
declare @interest_trans_type_id int


exec
	j_transactiontype
		"Deposit",
		@depo_trans_type_id output
exec
	j_transactiontype
		"Withdrawal",
		@with_trans_type_id output
exec
	j_transactiontype
		"FX Settlement",
		@pl_trans_type_id output
exec
	j_transactiontype
		"Fees/Commissions/Brokerage",
		@fee_trans_type_id output
exec
	j_transactiontype
		"Adjustment",
		@adj_trans_type_id output
exec
	j_transactiontype
		"Interest",
		@interest_trans_type_id output

select
	@total_balance = NULL,
	@pl = NULL,
	@cash_activity = NULL,
	@fees = NULL,
	@adjustments = NULL,
	@interest = NULL

select
	@total_balance = sum(amount)
from
	account_transactions
where
	external_account_id = @external_account_id
if @total_balance = NULL
	select
		@total_balance = 0

select
	@pl = sum(amount)
from
	account_transactions
where
	transaction_type_id = @pl_trans_type_id
and
	external_account_id = @external_account_id
if @pl = NULL
	select
		@pl = 0

select
	@pl_date = max(transaction_date)
from
	account_transactions
where
	transaction_type_id = @pl_trans_type_id
and
	external_account_id = @external_account_id

select
	@cash_activity = sum(amount)
from
	account_transactions
where
	transaction_type_id in(@depo_trans_type_id, @with_trans_type_id)
and
	external_account_id = @external_account_id
if @cash_activity = NULL
	select
		@cash_activity = 0

select
	@fees = sum(amount)
from
	account_transactions
where
	transaction_type_id = @fee_trans_type_id
and
	external_account_id = @external_account_id
if @fees = NULL
	select
		@fees = 0

select
	@adjustments = sum(amount)
from
	account_transactions
where
	transaction_type_id = @adj_trans_type_id
and
	external_account_id = @external_account_id
if @adjustments = NULL
	select
		@adjustments = 0

select
	@interest = sum(amount)
from
	account_transactions
where
	transaction_type_id = @interest_trans_type_id
and
	external_account_id = @external_account_id
if @interest = NULL
	select
		@interest = 0

select
	@other = @total_balance - @pl - @cash_activity - @fees - @adjustments - @interest

go
