create or replace procedure
	mc4_clientwithdrawalreq
		@login varchar(50),
		@product varchar(50),
		@amount float,
		@for_date datetime,
		@from_account varchar(50),
		@to_account varchar(50)
as

declare @ledger_request_id int

exec
	api_clientwithdrawalreq
		@login = @login,
		@product = @product,
		@amount = @amount,
		@for_date = @for_date,
		@from_account = @from_account,
		@to_account = @to_account,
		@ledger_request_id = @ledger_request_id output


if @ledger_request_id != NULL
begin
	select
		status = "Success",
		message = "Withdrawal request entered for product and account",
		product = @product,
		from_account = @from_account,
		amount = @amount,
		ledger_request_id = @ledger_request_id
end


go
