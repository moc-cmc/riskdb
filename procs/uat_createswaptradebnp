use
	risk_qson
go

drop procedure
	uat_createswaptradebnp
go

create procedure
	uat_createswaptradebnp
		@login varchar(50),
		@symbol varchar(50),
		@price numeric(30,8)
as

declare @near_trade_id int
declare @far_trade_id int
declare @deal_id int
declare @quantity numeric(30,4)
declare @quan int
declare @near_value_date datetime
declare @far_value_date datetime
declare @now datetime
declare @begin_date datetime
declare @end_date datetime
declare @status_id int
declare @connection_id int
declare @tico_account_id int
declare @source_id int
declare @swap_symbol_id int
declare @swap_symbol varchar(100)
declare @product_id int
declare @currency_id int
declare @non_deliverable int
declare @near_fixing_date datetime
declare @far_fixing_date datetime
declare @near_identifier varchar(100)
declare @far_identifier varchar(100)
declare @far_price numeric(30,8)
declare @upper float
declare @lower float
declare @random float
declare @spot_reference numeric(30,8)
declare @traders int
declare @counterparties int
declare @trader varchar(50)
declare @counterparty varchar(50)
declare @trader_id int
declare @counterparty_id int


select
	@now = getdate()

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end
select
	@near_identifier = newid() + ".c",
	@far_identifier = newid() + ".c"

select
	@product_id = a.product_id,
	@currency_id = a.currency_id
from
	forwards a,
	contracts b
where
	a.contract_id = b.contract_id
and
	b.symbol = @symbol

select
	@non_deliverable = count(*)
from
	nondeliverable_ccys
where
	product_id in(@product_id, @currency_id)


	

select
	@status_id = status_id
from
	statuses
where
	name = "Active"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Active status not found"
	return
end

select
	@connection_id = connection_id
from
	connection_tico_accounts
where
	tico_account_id = @tico_account_id
if @connection_id = NULL
begin
	select
		status = "Error",
		message = "No connection found for login"
	return
end

select
	@source_id = source_id
from
	connections
where
	connection_id = @connection_id
if @source_id = NULL
begin
	select
		status = "Error",
		message = "No source found for connection"
	return
end


exec
	r_daterangefordate
		@now,
		@begin_date output,
		@end_date output

select
	@near_value_date = convert(datetime, convert(date, @end_date))

if @non_deliverable > 0
select
	@near_value_date = dateadd(week, 2, convert(datetime, convert(date, @end_date)))

exec
	r_nextbusinessday
		@near_value_date,
		@near_value_date output

if @symbol not in("USDCAD", "CADUSD")
	exec
		r_nextbusinessday
			@near_value_date,
			@near_value_date output
	
exec
	r_nextbusinessday
		@near_value_date,
		@far_value_date output


select near_value_date = @near_value_date, far_value_date = @far_value_date
/* MARKR */



if @non_deliverable > 0
begin
	exec
		r_prevbusinessday
			@near_value_date,
			@near_fixing_date output
	exec
		r_prevbusinessday
			@far_value_date,
			@far_fixing_date output
end

select
	@quan = convert(int, rand() * 20.0)


if @quan <= 8
	select
		@quantity = 100000.00
if @quan > 8 and @quan <= 14
	select
		@quantity = 500000.00
if @quantity = NULL
	select
		@quantity = 1000000.00

select
	@quan = convert(int, rand() * 10.0)

if @quan >= 5
	select
		@quantity = @quantity * -1.0

select
	@lower = -.01,
	@upper = .01

if @symbol like "%JPY%"
begin
	select
		@far_price = @price + (ROUND(((@upper - @lower) * RAND() + @lower), 3))
end
else
begin
	select
                @far_price = @price + (ROUND(((@upper - @lower) * RAND() + @lower), 4))
end

if rand() > .75
begin
	select
		@spot_reference = NULL
end
else
begin
	select
		@spot_reference = @price
end


create table
        #traders(
                trader_id int identity,
                symbol varchar(50))
insert into
        #traders(
                symbol)
select
        a.symbol
from
        traders a
where
	a.symbol in("BNP EDGEW", "BNP EQUITI", "BNP EQUITISUB")

select
        @traders = count(*)
from
        #traders

select
        @trader_id = convert(int, rand() * @traders)

select
        @trader = symbol
from
        #traders
where
        trader_id = @trader_id

if @trader = NULL
        select
                @trader = symbol
	from
		#traders
	where
		trader_id in(select max(trader_id) from #traders)


create table
        #counterparties(
                counterparty_id int identity,
                name varchar(50))
insert into
        #counterparties(
                name)
select
        a.name
from
        counterparties a
where
        a.name in("BNP-XTX-BNPPB", "BNP-XENFIN-RBSLDN", "BNP-UBS ZUR", "BNP-RBS LDN")

select
        @counterparties = count(*)
from
        #counterparties

select
        @counterparty_id = convert(int, rand() * @counterparties)

select
        @counterparty = name
from
        #counterparties
where
        counterparty_id = @counterparty_id

if @counterparty = NULL
        select
                @counterparty = name
        from
                #counterparties
        where
                counterparty_id in(select max(counterparty_id) from #counterparties)


exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Swap",
		@deal_type = "Client Swap",
		@trade_type = "Swap Near",
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @near_value_date,
		@fixing_date = @near_fixing_date,
		@price = @price,
		@trade_date = @now,	
		@identifier = @near_identifier,
		@spot_reference = @spot_reference,
		@trader = @trader,
		@counterparty = @counterparty

select
	@quantity = @quantity * -1.0	

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @far_trade_id output,
		@deal_id = @deal_id,
		@tally_type = "Swap",
		@deal_type = "Client Swap",
		@trade_type = "Swap Far",
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @far_value_date,
		@fixing_date = @far_fixing_date,
		@price = @far_price,
		@trade_date = @now,
		@identifier = @far_identifier,
		@spot_reference = @spot_reference,
		@trader = @trader,
		@counterparty = @counterparty

/******/

/* Create and assign client swap symbol */
exec
	j_nextkey
		"swap_symbols",
		@swap_symbol_id output
select
	@swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".C"

insert into
	swap_symbols(
    		swap_symbol_id,
    		symbol,
    		timestamp)
values(
	@swap_symbol_id,
	@swap_symbol,
	getdate())

/* Tie both legs to the swap symbol */
insert into 
	swap_symbol_trades(
		swap_symbol_id,
		trade_id)
values(
	@swap_symbol_id,
	@near_trade_id)

insert into 
	swap_symbol_trades(
	swap_symbol_id,
	trade_id)
values(
	@swap_symbol_id,
	@far_trade_id)

/******/

insert into
	trade_notifications(
		source_id,
		trade_id,
		status_id,
		capture_date)
values(
	@source_id,
	@near_trade_id,
	@status_id,
	@now)


insert into
	trade_notifications(
		source_id,
		trade_id,
		status_id,
		capture_date)
values(
	@source_id,
	@far_trade_id,
	@status_id,
	@now)



exec
	uat_blotterbnp
		@login = @login

go

