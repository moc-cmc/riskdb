drop procedure
	ag_setchannelstatus
go

create procedure
	ag_setchannelstatus
		@login varchar(50),
		@channel varchar(100),
		@activity_status varchar(50)
as


declare @channel_id int
declare @activity_status_id int


select
	@channel_id = channel_id
from
	channels
where
	name = @channel
if @channel_id = NULL
begin
	select
		status = "Error",
		message = "Channel not found",
		channel = @channel
	return
end

select
	@activity_status_id = activity_status_id
from
	activity_statuses
where
	name = @activity_status
if @activity_status_id = NULL
begin
	select
		status = "Error",
		message = "Activity status not found",
		activity_status = @activity_status
	return
end

update
	channels
set
	activity_status_id = @activity_status_id
where
	channel_id = @channel_id


exec
	ag_messageshome
		@login = @login,
		@channel = @channel

go
