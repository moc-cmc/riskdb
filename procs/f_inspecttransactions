
if object_id("f_inspecttransactions") != NULL
    drop procedure
        f_inspecttransactions
go

create procedure
	f_inspecttransactions
		@portfolio char(100),
		@date datetime
as

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)
/* insert into
	#links
values(
	"Column Link",
	"portfolio",
	"Set Posting Dates",
	"suppressAutoexecute=YES")

select * from #links */

select 
	portfolio = @portfolio,
	transaction_id = a.int_account_transaction_id,
	entered_by = b.login,
	internal_account = c.symbol,
	transaction_type = d.name,
	amount = convert(char(30), convert(numeric(30,2), a.amount)),
	note = a.note
from
	int_account_transactions a,
	tico_accounts b,
	internal_accounts c,
	transaction_types d,
	portfolios e,
	portfolio_accounts f
where
	a.entered_by = b.account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	datepart(day, @date) = datepart(day, a.transaction_date)
and
	datepart(month, @date) = datepart(month, a.transaction_date)
and
	datepart(year, @date) = datepart(year, a.transaction_date)
and
	c.internal_account_id = f.internal_account_id
and
	f.portfolio_id = e.portfolio_id
and
	e.name = @portfolio


go
