
drop procedure
	r_edituserpassword
go

create procedure r_edituserpassword @login varchar(25), 
				    @login_name varchar(25),
				    @old_password varchar(20),
				    @new_password varchar(20)
as

declare @local_account_id int
declare @passchange char(1)
declare @passlen int
declare @message varchar(250)
declare @isValid char(1) 
declare @password varchar(20)

/* remove leading or trailing spaces */

select
	@password =  rtrim(ltrim(@new_password))


exec r_checknewpassword @login, @password, @message output, @isValid output

if(@isValid = "N")
begin
	select
		status="Error",
		msg=@message,
		password=@password

	exec r_managelogins @login

	return

end

select 
	@local_account_id=account_id
from
	tico_accounts
where
	login=@login_name

if @@rowcount < 1
begin
	select
		status="Error",
		msg="Login name does not exist",
		login_name=@login_name

	exec r_managelogins @login

	return
end

select @passchange = "Y"

select
	@passchange="N"
from
	tico_accounts
where
	account_id=@local_account_id	
and
	password=@password	

if(@passchange = "N")
begin
	select  
		status="Error",
		msg="Password same as previous",
		password=@password

	exec r_managelogins @login
	
	return
end

declare @password_server varchar(25)
declare @tico_db varchar(50)

select
	@password_server = tico_server,
	@tico_db = tico_database
from
	funds

declare @sqlstring varchar(250)

select
	@sqlstring = "exec "+rtrim(@tico_db)+"..r_editticopassword '" + @login + "','" + + @login_name + "','" + @password + "'"

begin tran

	update
		tico_accounts
	set
		password=@password
	where
		account_id=@local_account_id

	if @@rowcount != 1
	begin
		select
			status="Error",
			msg="Password not changed",
			login_name=@login_name

		rollback tran
		
		return
	end

	if @password_server != @@servername
	begin
		exec
			sp_remotesql @password_server, @sqlstring
	end
	else
	begin
		exec(@sqlstring)
	end	

commit tran

select 
	status="Success",
	msg="Password Reset",
	login_name=@login_name

exec r_managelogins @login

go

