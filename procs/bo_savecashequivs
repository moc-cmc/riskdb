
drop procedure
	bo_savecashequivs
go

create procedure
	bo_savecashequivs
		@login varchar(50),
		@trade_date datetime=NULL
as



declare @fund_id int
declare @evaluation_currency_id int
declare @begin_date datetime
declare @end_date datetime
declare	@default_nop_type_id int


exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id,
	@default_nop_type_id = nop_type_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @trade_date = NULL
begin
	select
		status = "Error",
		message = "No trade date specified"
	return
end

exec
	r_daterangefordate
		@trade_date, 
 		@begin_date output,
		@end_date output


create table
	#external_accounts(
		id int identity,
		external_account_id int,
		symbol varchar(50),
		margin_multiplier float NULL)

insert into
	#external_accounts(
		external_account_id,
		symbol,
		margin_multiplier)
select
	a.external_account_id,
	a.symbol, 
	a.margin_multiplier
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
order by
	a.symbol


create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	a.product_id
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"


update
	#conversion_rates
set
	rate = 1.0
where 
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and 
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL


create table
	#cash_balances(
		external_account_id int,
		product_id int,
		quantity numeric(30,4))


insert into
	#cash_balances(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	currency_id,
	sum(amount)
from
	account_transactions
where
	transaction_date <= @end_date
group by
	external_account_id,
	currency_id

create table
	#net_cash_balances(
		external_account_id int,
		product_id int,
		quantity float,
		equiv float NULL)
insert into
	#net_cash_balances(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	product_id,
	sum(quantity)
from
	#cash_balances
group by
	external_account_id,
	product_id

update
	#net_cash_balances
set
	a.equiv = a.quantity * b.rate
from
	#net_cash_balances a,
	#conversion_rates b
where
	a.product_id = b.product_id


create table
	#open_equity(
		external_account_id int,
		equiv float NULL)
insert into
	#open_equity(
		external_account_id,
		equiv)
select
	external_account_id,
	sum(equiv)
from
	credit_positions
where
	convert(date, trade_date) = convert(date, @end_date)
group by
	external_account_id


create table
	#models(
		external_account_id int,
		net_nop float NULL,
		shorts float NULL,
		longs float NULL)
insert into
	#models(
		external_account_id,
		net_nop,
		shorts,
		longs)
select
	external_account_id,
	abs(sum(equiv * margin_rate)),
	sum(abs(short_equiv) * margin_rate),
	sum(long_equiv * margin_rate)
from
	credit_positions
where
	convert(date, trade_date) = convert(date, @end_date)
group by
	external_account_id

create table
	#agg_models(
		external_account_id int,
		agg_shorts float NULL,
		agg_longs float NULL)
insert into
	#agg_models(
		external_account_id,
		agg_shorts,
		agg_longs)
select
	external_account_id,
	sum(abs(short_equiv) * margin_rate),
	sum(long_equiv * margin_rate)
from
	credit_positions
where
	convert(date, trade_date) = convert(date, @end_date)
and
	product_id != @evaluation_currency_id
group by
	external_account_id


create table
	#bo_account_usages(
		external_account_id int,
		cash_equiv float NULL,
		open_equiv float NULL,
		nop_type_id int NULL,
		margin_use float NULL,
		net_nop float NULL,
		shorts float NULL,
		longs float NULL,
		agg_shorts float NULL,
		agg_longs float NULL,
		max_long_short float NULL)
insert into
	#bo_account_usages(
		external_account_id,
		cash_equiv)
select
	external_account_id,
	sum(equiv)
from
	#net_cash_balances
group by
	external_account_id

update
	#bo_account_usages
set
	nop_type_id = @default_nop_type_id

update
	#bo_account_usages
set
	a.nop_type_id = b.nop_type_id
from
	#bo_account_usages a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.nop_type_id != NULL

update
	#bo_account_usages
set
	a.open_equiv = b.equiv
from
	#bo_account_usages a,
	#open_equity b
where
	a.external_account_id = b.external_account_id


update
	#bo_account_usages
set
	a.net_nop = b.net_nop,
	a.shorts = b.shorts,
	a.longs = b.longs
from
	#bo_account_usages a,
	#models b
where
	a.external_account_id = b.external_account_id
	
update
	#bo_account_usages
set
	a.agg_shorts = b.agg_shorts,
	a.agg_longs = b.agg_longs
from
	#bo_account_usages a,
	#agg_models b
where
	a.external_account_id = b.external_account_id


update
	#bo_account_usages
set
	max_long_short = shorts
where
	abs(shorts) > abs(longs)

update
	#bo_account_usages
set
	max_long_short = longs
where
	abs(longs) >= abs(shorts)
	

update
	#bo_account_usages
set
	a.margin_use = a.net_nop
from
	#bo_account_usages a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id
and
	b.name = "Net"

update
	#bo_account_usages
set
	a.margin_use = a.shorts
from
	#bo_account_usages a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id
and
	b.name = "Shorts"

update
	#bo_account_usages
set
	a.margin_use = a.longs
from
	#bo_account_usages a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id
and
	b.name = "Longs"

update
	#bo_account_usages
set
	a.margin_use = a.agg_shorts
from
	#bo_account_usages a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id
and
	b.name = "Aggregate Shorts"

update
	#bo_account_usages
set
	a.margin_use = a.agg_longs
from
	#bo_account_usages a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id
and
	b.name = "Aggregate Longs"


update
	#bo_account_usages
set
	a.margin_use = a.max_long_short
from
	#bo_account_usages a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id
and
	b.name = "Max Longs Shorts"



insert into
	bo_account_usages(
		external_account_id,
		trade_date,
		cash_equiv,
		open_equity,
		nop_type_id,
		margin_use)
select
	external_account_id,
	trade_date = @trade_date,
	cash_equiv,
	open_equiv,
	nop_type_id,
	margin_use
from
	#bo_account_usages



go
