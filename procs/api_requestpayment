drop procedure
	api_requestpayment
go

create procedure
	api_requestpayment
		@login varchar(50),
		@payment_date datetime,
		@payer_account varchar(50),
		@payee_account varchar(50),
		@transaction_type varchar(50),
		@amount numeric(30,4),
		@product varchar(50),
		@payment_request_id int output
as

declare @fund_id int
declare @payments_account_id int
declare @payments_pb_id int

declare @payer_account_id int
declare @payer_pb_id int

declare @payee_account_id int
declare @payee_pb_id int

declare @tran1_id int
declare @tran2_id int
declare @tran3_id int

declare @transaction_type_id int
declare @product_id int
declare @status_id int
declare @tico_account_id int

declare @payment_type_id int
declare @external_payment_amount numeric(30,2)

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = @transaction_type
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Transaction type not found",
		transaction_type = @transaction_type
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "Pending"
if @status_id = NULL
begin
	select
		status = "Error",
		messaage = "Pending status not found"
	return
end

select
	@payment_type_id = transaction_type_id
from
	transaction_types
where
	name = "Expected Payment"
if @payment_type_id = NULL
begin
	exec
		j_nextkey
			"transaction_types",
			@payment_type_id output

	insert into
		transaction_types(
			transaction_type_id,
			name,
			direction)
	values(
		@payment_type_id,
		"Expected Payment",
		1)	
end


select
	@payments_account_id = payments_ext_account_id
from
	funds
where
	fund_id = @fund_id
if @payments_account_id = NULL
begin
	select
		status = "Error",
		message = "Payments account not found"
	return
end

select
	@payments_pb_id = prime_broker_id
from
	external_account_prime_brokers
where
	external_account_id = @payments_account_id
if @payments_pb_id = NULL
begin
	select
		status = "Error",
		message = "Clearing entity for payments account not found"
	return
end

select
	@payer_account_id = external_account_id
from
	external_accounts
where
	symbol = @payer_account
if @payer_account_id = NULL
begin
	select
		status = "Error",
		message = "Payer account not found",
		payer_account = @payer_account
	return
end

select
	@payer_pb_id = prime_broker_id
from
	external_account_prime_brokers
where
	external_account_id = @payer_account_id
if @payer_pb_id = NULL
begin
	select
		status = "Error",
		message = "Payer clearing entity not found",
		payer_account = @payer_account
	return
end

select
	@payee_account_id = external_account_id
from
	external_accounts
where
	symbol = @payee_account
if @payee_account_id = NULL
begin
	select
		status = "Error",
		message = "Payer account not found",
		payee_account = @payee_account
	return
end

select
	@payee_pb_id = prime_broker_id
from
	external_account_prime_brokers
where
	external_account_id = @payee_account_id
if @payee_pb_id = NULL
begin
	select
		status = "Error",
		message = "Payee clearing entity not found",
		payee_account = @payee_account
	return
end

exec
	j_nextkey
		"payment_requests",
		@payment_request_id output

exec
	j_nextkey
		"account_transactions",
		@tran1_id output

exec
	j_nextkey
		"account_transactions",
		@tran2_id output

/* select
	payee_pb_id = @payee_pb_id,
	payer_pb_id = @payer_pb_id,
	payments_pb_id = @payments_pb_id,
	payer_account = @payer_account,
	payee_account = @payee_account return MARKR */
	
if @payer_pb_id = @payments_pb_id
	select
		@external_payment_amount = @amount
if @payee_pb_id = @payments_pb_id
	select
		@external_payment_amount = @amount * -1.0

if @payee_pb_id = @payments_pb_id and @payer_pb_id = @payments_pb_id
begin
	/* 2 transactions */
	begin tran
		insert into
			payment_requests(
				payment_request_id,
				submitted_by,
				timestamp,
				payer_account_id,
				payee_account_id,
				amount,
				product_id,
				status_id)
		values(
			@payment_request_id,
			@tico_account_id,
			@payment_date,
			@payer_account_id,
			@payee_account_id,
			@amount,
			@product_id,
			@status_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to enter payment request",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end

		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@tran1_id,
			@tico_account_id,
			@payer_account_id,
			@transaction_type_id,
			@payment_date,
			@product_id,
			@amount * -1.0)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to enter payer debit",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end
	
		
		insert into
			payment_request_transactions(
				payment_request_id,
				account_transaction_id)
		values(
			@payment_request_id,
			@tran1_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add request transaction 1",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end
			

		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@tran2_id,
			@tico_account_id,
			@payee_account_id,
			@transaction_type_id,
			@payment_date,
			@product_id,
			@amount)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to enter payee credit",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end
	
		insert into
			payment_request_transactions(
				payment_request_id,
				account_transaction_id)
		values(
			@payment_request_id,
			@tran2_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add request transaction 2",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end


	commit tran
end
else
begin
	/* 3 transactions */
	exec
		j_nextkey
			"account_transactions",
			@tran3_id output

	begin tran
		insert into
			payment_requests(
				payment_request_id,
				submitted_by,
				timestamp,
				payer_account_id,
				payee_account_id,
				amount,
				product_id,
				status_id)
		values(
			@payment_request_id,
			@tico_account_id,
			@payment_date,
			@payer_account_id,
			@payee_account_id,
			@amount,
			@product_id,
			@status_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to enter payment request",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end

		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@tran1_id,
			@tico_account_id,
			@payer_account_id,
			@transaction_type_id,
			@payment_date,
			@product_id,
			@amount * -1.0)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to enter payer debit",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end
	
		
		insert into
			payment_request_transactions(
				payment_request_id,
				account_transaction_id)
		values(
			@payment_request_id,
			@tran1_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add request transaction 1",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end
			

		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@tran2_id,
			@tico_account_id,
			@payee_account_id,
			@transaction_type_id,
			@payment_date,
			@product_id,
			@amount)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to enter payee credit",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end
	
		insert into
			payment_request_transactions(
				payment_request_id,
				account_transaction_id)
		values(
			@payment_request_id,
			@tran2_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add request transaction 2",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end

		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@tran3_id,
			@tico_account_id,
			@payments_account_id,
			@payment_type_id,
			@payment_date,
			@product_id,
			@external_payment_amount)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to enter external payment",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end

		insert into
			payment_request_transactions(
				payment_request_id,
				account_transaction_id)
		values(
			@payment_request_id,
			@tran3_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add request transaction 3",
				payer_account = @payer_account,
				payee_account = @payee_account,
				amount = @amount,
				product = @product
			rollback tran
			return
		end

	commit tran
end

go

