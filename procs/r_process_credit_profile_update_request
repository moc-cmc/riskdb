create or replace procedure
	r_process_credit_profile_update_request
		@tico_account_id int,
                @credit_profile_id int,
                @credit_update_type_id int,
		@source_id int,
                @identifier varchar(100),
                @timestamp datetime=NULL,
		@nop_limit numeric(30,4)=NULL,
		@dsl_limit numeric(30,4)=NULL
as

declare @failed_status_id int
declare @success_status_id int
declare @credit_update_request_id int
declare @user_credit_profile_id int
declare @message varchar(100)
declare @credit_profile_name varchar(50)

if not exists (select account_id from tico_accounts where account_id=@tico_account_id)
begin
        select
                status = "Error",
                message = "tico_account_id not found",
                tico_account_id=@tico_account_id
        return
end

if not exists (select source_id from sources where source_id=@source_id)
begin
        select
                status = "Error",
                message = "source_id not found",
                source_id=@source_id
        return
end

if not exists (select credit_profile_id from credit_profiles where credit_profile_id=@credit_profile_id)
begin
        select                
                status = "Error",
                message = "credit_profile_id not found",
                credit_profile_id=@credit_profile_id
        return
end

if not exists (select credit_update_type_id from credit_update_types where credit_update_type_id=@credit_update_type_id)
begin
        select
                status = "Error",
                message = "credit_update_type_id not found",
                credit_update_type_id=@credit_update_type_id
        return
end

select
        @failed_status_id = status_id
from
        statuses
where
        name = "Failed"
if @failed_status_id = NULL
begin
        select
                status = "Error",
                msg = "Failed status not found",
                status_id = @failed_status_id
        return
end

select
        @success_status_id = status_id
from
        statuses
where
        name = "Success"
if @success_status_id = NULL
begin
        select
                status = "Error",
                msg = "Success status not found",
                status_id = @success_status_id
        return
end

if @timestamp = NULL
begin
        select
                @timestamp = getdate()
end

select
        @credit_profile_name = name
from
        credit_profiles
where
        credit_profile_id = @credit_profile_id


if @nop_limit = NULL and @dsl_limit = NULL
begin
        select
                @message = "Error processing credit change, no credit limit change specified"
        exec
                j_nextkey
                        "credit_update_requests",
                        @credit_update_request_id output
        insert into
                credit_update_requests(
                        credit_update_request_id,
                        credit_update_type_id,
                        status_id,
                        tico_account_id,
                        timestamp,
                        source_id,
                        identifier,
                        credit_profile_id,
                        message)
        select
                @credit_update_request_id,
                @credit_update_type_id,
                @failed_status_id,
                @tico_account_id,
                @timestamp,
                @source_id,
                @identifier,
                @credit_profile_id,
                @message

        select
                status = "Failed",
                msg = @message

        return
end

create table
        #credit_profiles(
                credit_profile_id int,
		name varchar(50),
		currency_id int,
		nop_type_id int,
		nop_limit float,
		dsl_type_id int,
		dsl_limit float,
		notice_level float,
		warning_level float,
		blocked_level float,
		edited_by int NULL,
		timestamp datetime NULL
        )


insert into
        #credit_profiles(
                credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level)

select
                credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level
from         
                credit_profiles
where
                credit_profile_id = @credit_profile_id
and
                name = @credit_profile_name

update
                #credit_profiles
set
                edited_by = @tico_account_id
where
                credit_profile_id = @credit_profile_id

update
                #credit_profiles
set
                timestamp = @timestamp
where
                credit_profile_id = @credit_profile_id


insert into 
        archive_credit_profiles(
                credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level,
                edited_by,
                timestamp
)
select
        credit_profile_id,
        name,
        currency_id,
        nop_type_id,
        nop_limit,
        dsl_type_id,
        dsl_limit,
        notice_level,
        warning_level,
        blocked_level,
        edited_by,
        timestamp 
from
        #credit_profiles
where 
        credit_profile_id = @credit_profile_id
if @@rowcount = 0
begin
        select
                @message = "Failed to update credit line"
        exec
                j_nextkey
                        "credit_update_requests",
                        @credit_update_request_id output
        insert into
                credit_update_requests(
                        credit_update_request_id,
                        credit_update_type_id,
                        status_id,
                        tico_account_id,
                        timestamp,
                        source_id,
                        identifier,
                        credit_profile_id,
                        message)
        select
                @credit_update_request_id,
                @credit_update_type_id,
                @failed_status_id,
                @tico_account_id,
                @timestamp,
                @source_id,
                @identifier,
                @credit_profile_id,
                @message

        select
                status = "Failed",
                msg = @message

        return
end


if @nop_limit != NULL
begin
        update 
                        credit_profiles
        set
                        nop_limit = @nop_limit
        where
                        credit_profile_id = @credit_profile_id
        and
                        name = @credit_profile_name
        if @@rowcount = 0
        begin
                select
                        @message = "Failed to update credit line"
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                select
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @failed_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message

                select
                        status = "Failed",
                        msg = @message

                return
        end
        else
        begin
                select
                        @message = "Updated NOP credit line to " + cast(@nop_limit as varchar)
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                select
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @success_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message

                select
                        status = "Success",
                        msg = @message
        end
end

if @dsl_limit != NULL
begin
        update 
                        credit_profiles
        set
                        dsl_limit = @dsl_limit
        where
                        credit_profile_id = @credit_profile_id
        and
                        name = @credit_profile_name
        if @@rowcount = 0
        begin
                select
                        @message = "Failed to update credit line"
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                select
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @failed_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message

                select
                        status = "Failed",
                        msg = @message

                return
        end
        else
        begin
                select
                        @message = "Updated DSL credit line to " + cast(@dsl_limit as varchar)
                exec
                        j_nextkey
                                "credit_update_requests",
                                @credit_update_request_id output
                insert into
                        credit_update_requests(
                                credit_update_request_id,
                                credit_update_type_id,
                                status_id,
                                tico_account_id,
                                timestamp,
                                source_id,
                                identifier,
                                credit_profile_id,
                                message)
                select
                        @credit_update_request_id,
                        @credit_update_type_id,
                        @success_status_id,
                        @tico_account_id,
                        @timestamp,
                        @source_id,
                        @identifier,
                        @credit_profile_id,
                        @message

                select
                        status = "Success",
                        msg = @message
        end
end

