
if object_id("r_tallyfundfutureoptions") != NULL
    drop procedure
        r_tallyfundfutureoptions
go

create procedure
	r_tallyfundfutureoptions
		@login char(25),
		@symbol char(25),
		@trader char(25),
		@broker char(100),
		@strategy char(100),
		@quantity numeric(30,5),
		@price float


as

declare @account_id int
declare @contract_id int
declare @premium_amount float
declare @multiplier float
declare @trade_quantity int
declare @remainder_quantity int
declare @trade_premium float
declare @remainder_premium float
declare @internal_account_id int
declare @external_account_id int
declare @external_account char(25)
declare @trade_id int
declare @deal_id int
declare @trade_date datetime
declare @strategy_id int
declare @trader_id int
declare @allocations int
declare @ext_future_allocation_id int
declare @allocation float
declare @broker_id int
declare @int_account_name char(25)
declare @ext_account_name char(25)
declare @note char(255)
declare @fund_id int

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)

insert into
	#links
values(
	"Column Link",
	"run_name",
	"Intraday P&L",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments from #links


exec
	r_defaultfundforlogin
		@login,
		@fund_id output
if @fund_id = NULL
begin
	select
		id = -1,
		error = "Problem finding default fund for user"
	return
end


select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin	
	select
		id = -1,
		error = "Problem finding strategy",
		strategy = @strategy
	return
end



select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding broker",
		broker = @broker
	return
end

select
	@account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select 	
		id = -1,
		error = "Problem determining current user"
	return
end

select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding trader"
	return
end


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract with symbol",
		symbol = @symbol
	return
end

exec
	x_contractmultiplier
		@contract_id,
		@multiplier output

select
	@trade_date = getdate()


begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "deals"
	select
		@deal_id = last_id
	from
		keys
	where
		relation = "deals"
commit tran

insert into
	deals
values(
	@deal_id,
	getdate())

select
	@premium_amount = @quantity * @price * @quantity

select
	@remainder_quantity = @quantity

select 
	@remainder_premium = @premium_amount
	

select
	@ext_future_allocation_id = 0
select
	@allocations = count(*)
from
	external_future_allocations
where
	fund_id = @fund_id
and
	ext_future_allocation_id > @ext_future_allocation_id

while @allocations > 0
begin
	select
		@ext_future_allocation_id = min(ext_future_allocation_id)
	from
		external_future_allocations
	where
		fund_id = @fund_id
	and
		ext_future_allocation_id > @ext_future_allocation_id

	select
		@external_account_id = external_account_id,
		@internal_account_id = internal_account_id,
		@allocation = percentage	
	from
		external_future_allocations
	where
		ext_future_allocation_id = @ext_future_allocation_id

	select
		@trade_quantity = convert(int, round(@quantity * @allocation, 0))
	select
		@remainder_quantity = @remainder_quantity - @trade_quantity

	/* select
		@trade_premium = @premium_amount * @allocation */

	select
		@trade_premium = @trade_quantity * @price * @multiplier * -1.0

	select
		@remainder_premium = @remainder_premium - @trade_premium


	begin tran
		update
			keys
		set
			last_id = last_id + 1
		where
			relation = "trades"
		select
			@trade_id = last_id
		from
			keys
		where
			relation = "trades"
	commit tran
	
	
	insert into
		trades
	values(
		@trade_id,
		@deal_id,
		@account_id,
		@internal_account_id,
		@external_account_id,
		@trade_quantity,
		@contract_id,
		@price,
		@trade_date,
		@trader_id,
		@strategy_id,
		1,
		@broker_id)
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem adding trade"
		rollback tran
		return
	end
	
	/* if @premium_amount != NULL
	begin
		select 
			@int_account_name = symbol
		from
			internal_accounts
		where
			internal_account_id = @internal_account_id
			
		select 
			@ext_account_name = symbol
		from
			external_accounts
		where
			external_account_id = @external_account_id
		
		select 
			@note = convert(char(255), @trade_id)

		exec
			s_addaccountoptpremium
				@login,
				@ext_account_name,
				@trade_date,
				@trade_premium,
				@trade_id,
				@conversion_rate

	end */
	
	select
		@allocations = count(*)
	from
		external_future_allocations
	where
		fund_id = @fund_id
	and
		ext_future_allocation_id > @ext_future_allocation_id
	
end
	
select
	@internal_account_id = NULL,
	@external_account_id = NULL

select
	@internal_account_id = remainder_int_account_id,
	@external_account_id = remainder_ext_account_id
from
	external_future_allocations
where
	ext_future_allocation_id = @ext_future_allocation_id

select
	@internal_account_id = remainder_int_account_id,
	@external_account_id = remainder_ext_account_id
from
	external_future_allocations
where
	ext_future_allocation_id = @ext_future_allocation_id
if @@rowcount != 1
begin
	select
		@internal_account_id = futures_internal_account_id,
		@external_account_id = futures_external_account_id
	from
		default_accounts
	where
		tico_account_id = @account_id

	if @internal_account_id = NULL
	begin
		select
			@internal_account_id = min(internal_account_id)
		from
			internal_accounts
	end

	if @external_account_id = NULL
	begin
		select
			@external_account_id = min(external_account_id)
		from
			external_accounts
	end



end


begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "trades"
	select
		@trade_id = last_id
	from
		keys
	where
		relation = "trades"
commit tran

insert into
	trades
values(
	@trade_id,
	@deal_id,
	@account_id,
	@internal_account_id,
	@external_account_id,
	@remainder_quantity,
	@contract_id,
	@price,
	@trade_date,
	@trader_id,
	@strategy_id,
	1,
	@broker_id)
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem adding trade"
	rollback tran
	return
end

select
	@ext_account_name = symbol
from
	external_accounts
where
	external_account_id = @external_account_id

/* select
	@remainder_premium = @remainder_quantity * @price * @multiplier * -1.0

exec
	s_addaccountoptpremium
		@login,
		@ext_account_name,
		@trade_date,
		@remainder_premium,
		@trade_id,
		@conversion_rate */

exec
	r_inspectdealtrades
		@login,
		@deal_id

exec
	r_intradayfwdpl
		@login

go
