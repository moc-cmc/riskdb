use
	risk_jeff
go

drop procedure
	ag_posteodnotifications
go

create procedure
	ag_posteodnotifications
		@login varchar(50),
		@trade_date datetime=NULL
as

declare @begin_date datetime
declare @end_date datetime

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"settle_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"confirm_settlements",
	"Confirm Settlements",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"balance_vs_clients",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta


select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


if @trade_date = NULL
	select
		@trade_date = convert(datetime, convert(date, getdate()))

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


create table
	#trades(
		section varchar(50) NULL,
		trade_id int,
		deal_id int,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		trade_date datetime NULL,
		notify_date datetime NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		value_date datetime NULL,
		quantity numeric(30,4) NULL,
		price float NULL,
		broker_id int NULL,
		broker varchar(50) NULL)

insert into
	#trades(
		section,
		trade_id,
		deal_id,
		external_account_id,
		trade_date,
		b.notify_date,
		contract_id,
		value_date,
		quantity,
		price,
		broker_id)
select
	section = "Notified after day rollover",	
	a.trade_id,
	a.deal_id,
	a.external_account_id,
	a.trade_date,
	b.notify_date,
	a.contract_id,
	a.value_date,
	a.quantity,
	a.price,
	a.broker_id
from
	trades a,
	trade_notifications b,
	sources c
where
	a.trade_id = b.trade_id
and
	b.source_id = c.source_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	b.notify_date >= @end_date
and
	c.name in(
		"Spectrum Client SpotFwd",
		"Spectrum Market SpotFwd",
		"Spectrum Client Swap",
		"Spectrum Internal SpotFwd",
		"Spectrum Market Swap")
/*****/
insert into
        #trades(
                section,
                trade_id,
                deal_id,
                external_account_id,
                trade_date,
                b.notify_date,
                contract_id,
                value_date,
                quantity,
                price,
                broker_id)
select
        section = "Notified before day rollover",
        a.trade_id,
        a.deal_id,
        a.external_account_id,
        a.trade_date,
        b.notify_date,
        a.contract_id,
        a.value_date,
        a.quantity,
        a.price,
        a.broker_id
from
        trades a,
        trade_notifications b,
        sources c
where
        a.trade_id = b.trade_id
and
        b.source_id = c.source_id
and
        a.trade_date >= @end_date
/* and
        a.trade_date < @end_date */
and
        b.notify_date < @end_date
and
        c.name in(
                "Spectrum Client SpotFwd",
                "Spectrum Market SpotFwd",
                "Spectrum Client Swap",
                "Spectrum Internal SpotFwd",
                "Spectrum Market Swap")

/*****/


update
	#trades
set
	a.external_account = b.symbol
from
	#trades a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.symbol = b.symbol
from
	#trades a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#trades
set
	a.broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id

select
	section,
	style = @style,
	trade_id,
	deal_id,
	external_account,
	broker,
	quantity,
	symbol,
	value_date = convert(varchar(11), value_date),
	price,
	trade_date,
	notify_date
from
	#trades
order by
	section,
	external_account,
	notify_date


go
