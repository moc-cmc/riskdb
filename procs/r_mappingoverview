	section = "Prime Broker Mappings",
	style,
	name,
	source_name,
	source_type,
	mapping,
	edit_prime_broker_mapping,
	delete_prime_broker_mapping,
	add_inbound_prime_broker_symbol,
	add_outbound_prime_broker_symbol	
from 
	#prime_brokers
order by
	name

select
	section = "More Mappings",
	'view_secondary'="View Secondary Symbol Mappings",
	'description'="View mappings for Broker, Contract, Credit Profile, Product, Status, Strategy, Trade Type"

