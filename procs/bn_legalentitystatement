
create or replace procedure
	bn_legalentitystatement
		@login char(100)
as


declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


create table
   #meta(
           meta_type char(200),
           name char(50) NULL,
           action char(100) NULL,
           value char(200) NULL)
insert into
   #meta
values(
   "Row Style",
   "style",
   NULL,
   NULL)

insert into
   #meta
values (
   "Column Group",
   "section",
   NULL,
   NULL)


insert into
	#meta
values(
	"Column Link",
	"daily_statement",
	"Legal Entity Daily Statement",
	NULL
)

insert into
	#meta
values(
	"Column Link",
	"monthly_statement",
	"Legal Entity Monthly Statement",
	NULL
)

/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	section = "Legal Entity Statements",
        legal_entity = a.name,
	daily_statement = "Daily Statement",
        monthly_statement = "Monthly Statement",
	style = @style
from
	legal_entities a,
	legal_entity_tico_accounts b,
	tico_accounts c
where
	a.legal_entity_id = b.legal_entity_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
if @@rowcount = 0
begin
	select
		section = "No Access",
		status = "Error",
		message = "This login has no access to view any legal entities"
	return
end
	

go 

