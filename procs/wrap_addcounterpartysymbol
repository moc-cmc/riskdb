
drop procedure
	wrap_addcounterpartysymbol
go

create procedure
	wrap_addcounterpartysymbol
				@login varchar(25),
				@name varchar(100),
				@symbol varchar(100),
				@source varchar(100)
as

exec
	api_addcounterpartysymbol
			@login=@login,
			@name=@name,
			@symbol=@symbol,
			@source=@source

exec
	r_mappingoverview
		@login=@login

return

go


