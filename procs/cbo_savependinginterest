create or replace procedure
	cbo_savependinginterest
		@login varchar(100),
		@trade_date datetime

as

declare @roll_transaction_date datetime
declare @pending_count int
declare @rolled_count int
declare @updated_count int
declare @tico_account_id int
declare @external_account_id int
declare @currency_id int
declare @transaction_type_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @ids int
declare @account_transaction_id int
declare @amount float
declare @pending_transactions int
declare @netted_transactions int

declare @interest_accrual_id int

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login
if @tico_account_id = NULL
begin
        select
                status = "Error",
                message = "Unable to resolve login"
        return
end

select
	@trade_date = convert(date, @trade_date)

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output

select
	@interest_accrual_id = transaction_type_id
from
	transaction_types
where
	name = "Interest Accrual"
if @@rowcount != 1
begin
	select
		status = "Erorr",
		message = "Could not find transaction type",
		type = "Interest Accrual"
	return
end


create table
	#pending_transactions(
		account_transaction_id int,
        	entered_by int,
        	external_account_id int,
        	transaction_type_id int,
        	transaction_date datetime,
        	currency_id int,
        	amount float,
        	create_date datetime,
        	status_id int NULL,
        	ledger_request_id int NULL,
        	note char(255) null)

insert into
	#pending_transactions
select
        account_transaction_id,
        entered_by,
        external_account_id,
        transaction_type_id,
        transaction_date,
        currency_id,
        amount,
        create_date,
        status_id,
        ledger_request_id,
        note
from
        pending_transactions
where
	transaction_type_id = @interest_accrual_id
and
        transaction_date >= @begin_date
and
        transaction_date <= @end_date


select
	@pending_transactions = count(*)
from
	#pending_transactions


begin tran
	/* delete first for downstream processing */
	delete from
		pending_transactions
	from
		pending_transactions a,
		#pending_transactions b
	where
		a.account_transaction_id = b.account_transaction_id
	if @@rowcount != @pending_transactions
	begin
		select
                        status = "Error",
                        message = "Number if inserted rows deleted from pending_transactions does not match #pending_transactions"
                rollback tran
                return
        end

	insert into
            	pending_transactions_archive(
                	account_transaction_id,
                	entered_by,
                	external_account_id,
                	transaction_type_id,
                	transaction_date,
                	currency_id,
                	amount,
                	create_date,
                	status_id,
                	ledger_request_id,
                	note,
                	archived_at)
        select
            	account_transaction_id,
            	entered_by,
            	external_account_id,
            	transaction_type_id,
            	transaction_date,
            	currency_id,
            	amount,
            	create_date,
            	status_id,
            	ledger_request_id,
            	note,
            	getdate()
        from 
            	#pending_transactions

        if @@rowcount != @pending_transactions
        begin
            	select
                	status = "Error",
                	message = "Problem sweeping pending transactions into archive"
            	rollback tran
            	return
        end
	
	insert into
                account_transactions(
                        account_transaction_id,
                        entered_by,
                        external_account_id,
                        transaction_type_id,
                        transaction_date,
                        currency_id,
                        amount,
			note)
	select
		account_transaction_id,
		@tico_account_id,
		external_account_id,
		transaction_type_id,
		@trade_date,
		currency_id,
		amount,
		note
	from
		#pending_transactions
	if @@rowcount != @pending_transactions
	begin
		select
			status = "Error",
			message = "Number if inserted rows to account_transactions does not match #pending_transactions"
		rollback tran
		return
	end

commit tran

go


