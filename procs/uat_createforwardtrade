use
	risk_qson
go

drop procedure
	uat_createforwardtrade
go

create procedure
	uat_createforwardtrade
		@login varchar(50),
		@symbol varchar(50),
		@price numeric(30,8)
as

declare @trade_id int
declare @deal_id int
declare @quantity numeric(30,4)
declare @quan int
declare @value_date datetime
declare @now datetime
declare @begin_date datetime
declare @end_date datetime
declare @status_id int
declare @connection_id int
declare @tico_account_id int
declare @source_id int
declare @non_deliverable int
declare @product_id int
declare @currency_id int
declare @fixing_date datetime
declare @identifier varchar(100)

select
	@now = getdate()

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@identifier = newid() + ".c"

select
	@status_id = status_id
from
	statuses
where
	name = "Active"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Active status not found"
	return
end

select
	@connection_id = connection_id
from
	connection_tico_accounts
where
	tico_account_id = @tico_account_id
if @connection_id = NULL
begin
	select
		status = "Error",
		message = "No connection found for login"
	return
end

select
	@source_id = source_id
from
	connections
where
	connection_id = @connection_id
if @source_id = NULL
begin
	select
		status = "Error",
		message = "No source found for connection"
	return
end

select
        @product_id = a.product_id,
        @currency_id = a.currency_id
from
        forwards a,
        contracts b
where
        a.contract_id = b.contract_id
and
        b.symbol = @symbol

select
        @non_deliverable = count(*)
from
        nondeliverable_ccys
where
        product_id in(@product_id, @currency_id)


exec
	r_daterangefordate
		@now,
		@begin_date output,
		@end_date output

select
	@value_date = dateadd(week, 4, convert(datetime, convert(date, @end_date)))

	
if @non_deliverable > 0
	exec
		r_prevbusinessday
			@value_date,
			@fixing_date output

		

select
	@quan = convert(int, rand() * 20.0)


if @quan <= 8
	select
		@quantity = 100000.00
if @quan > 8 and @quan <= 14
	select
		@quantity = 500000.00
if @quantity = NULL
	select
		@quantity = 1000000.00

select
	@quan = convert(int, rand() * 10.0)

if @quan >= 5
	select
		@quantity = @quantity * -1.0




exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Forward",
		@deal_type = "Client Forward",
		@trade_type = "Forward",
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @now,
		@fixing_date = @fixing_date,
		@identifier = @identifier



insert into
	trade_notifications(
		source_id,
		trade_id,
		status_id,
		capture_date)
values(
	@source_id,
	@trade_id,
	@status_id,
	@now)


exec
	uat_blotter
		@login = @login

go

