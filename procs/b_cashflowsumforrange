	begin_equiv = begin_product_equiv,
	end_equiv = end_product_equiv
where
	product_id = @selected_product_id

update
	#trades_output
set
	begin_equiv = begin_currency_equiv,
	end_equiv = end_currency_equiv
where
	currency_id = @selected_product_id

update
	#trades_output
set
	change_equiv = end_equiv - begin_equiv
	
select
	@begin_equiv = NULL,
	@end_equiv = NULL,
	@change_equiv = NULL

select
	@begin_equiv = sum(begin_equiv),
	@end_equiv = sum(end_equiv),
	@change_equiv = sum(change_equiv)
from
	#trades_output

if @change_equiv != NULL
	insert into
		#trades_output(
			style,
			begin_equiv,
			end_equiv,
			change_equiv)
	values(
		@subtotal_style,
		@begin_equiv,
		@end_equiv,
		@change_equiv)



