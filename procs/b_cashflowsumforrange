create table
	#trades(
		id int identity,
		trade_id int NULL,
		bo_trade_date datetime NULL,
		trade_date datetime NULL,
		external_account_id int NULL,
		instrument varchar(50) NULL,
		contract_id int NULL,
		product_id int NULL,
		currency_id int NULL,
		product_qty float NULL,
		currency_qty float NULL,
		value_date datetime NULL,
		price float NULL,
		begin_product_equiv float NULL,
		begin_currency_equiv float NULL,
		end_product_equiv float NULL,
		end_currency_equiv float NULL)


insert into
	#trades(
		trade_id,
		bo_trade_date,
		trade_date,
		external_account_id,
		contract_id,
		product_qty,
		currency_qty,
		value_date,
		price)
select
	a.trade_id,
	a.trade_date,
	a.trade_date,
	a.external_account_id,
	a.contract_id,
	a.quantity,
	a.quantity * a.price * -1.0,
	a.value_date,
	a.price
from
	trades a,
	#external_accounts b,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g,
	#counterparties h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = d.internal_account_id
and
	a.trader_id = e.trader_id
/* and
	a.contract_id = c.contract_id */
and
	a.strategy_id = f.strategy_id
and
	a.broker_id = g.broker_id
and
	a.counterparty_id = h.counterparty_id
and
	a.value_date >= @begin_date
and
	a.trade_date < @end_date

update
	#trades
set
	a.instrument = c.name
from
	#trades a,
	contracts b,
	instruments c
where
	a.contract_id = b.contract_id
and
	b.instrument_id = c.instrument_id


update
	#trades
set
	a.product_id = b.product_id,
	a.currency_id = b.currency_id
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#trades
set
	bo_trade_date = convert(datetime, convert(date, dateadd(day, 1, trade_date)))
where
	datepart(hour, trade_date) >= 17

update
	#trades
set
	bo_trade_date = dateadd(day, 1, bo_trade_date)
where
	datename(weekday, bo_trade_date) = "Saturday"

update
	#trades
set
	bo_trade_date = dateadd(day, 1, bo_trade_date)
where
	datename(weekday, bo_trade_date) = "Sunday"


create table
	#conversion_rates(
		product_id int,
		begin_date datetime,
		end_date datetime,
		begin_rate float NULL,	
		end_rate float NULL)

insert into
	#conversion_rates(
		product_id,
		begin_date,
		end_date)
select
	a.product_id,
	begin_date = @begin_date,
	end_date = @end_date
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"

update
	#conversion_rates
set
	begin_rate = 1.0,
	end_rate = 1.0
where
	product_id = @evaluation_currency_id

/*********************** begin rates ************************/
update
	#conversion_rates
set
	begin_rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @begin_date)
and
	a.begin_rate = NULL

update
	#conversion_rates
set
	begin_rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @begin_date)
and
	a.begin_rate = NULL
/*********************** begin rates ************************/

/*********************** end rates ************************/
update
	#conversion_rates
set
	end_rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.end_rate = NULL

update
	#conversion_rates
set
	end_rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.end_rate = NULL
/*********************** end rates ************************/


update
	#trades
set
	a.begin_product_equiv  = a.product_qty * b.begin_rate,
	a.end_product_equiv = a.product_qty * b.end_rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#trades
set
	a.begin_currency_equiv = a.currency_qty * b.begin_rate,
	a.end_currency_equiv = a.currency_qty * b.end_rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id

update
	#trades
set
	begin_product_equiv = 0.0,
	begin_currency_equiv = 0.0
where
	convert(datetime, convert(date, @begin_date)) < trade_date
	


