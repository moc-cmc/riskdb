		id int identity,
		style varchar(250) NULL,
		trade_id int NULL,
		trade_date datetime NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		value_date datetime NULL,
		product_id int NULL,
		dealt_ccy varchar(50) NULL,
		currency_id int NULL,
		counter_ccy varchar(50) NULL,
		dealt_amount numeric(30,4) NULL,
		counter_amount numeric(30,4) NULL,
		price numeric(30,8) NULL,
		begin_product_equiv float NULL,
		begin_currency_equiv float NULL,
		end_product_equiv float NULL,
		end_currency_equiv float NULL,
		begin_equiv float NULL,
		end_equiv float NULL,
		change_equiv float NULL)
insert into
	#trades_output(
		style,
		trade_id,
		trade_date,
		external_account_id,
		value_date,
		product_id,
		currency_id,
		dealt_amount,
		counter_amount,
		price,
		begin_product_equiv,
		begin_currency_equiv,
		end_product_equiv,
		end_currency_equiv)
select
	style = @style,
	trade_id,
	trade_date,
	external_account_id,
	value_date,
	product_id,
	currency_id,
	product_qty,
	currency_qty,
	price,
	begin_product_equiv,
	begin_currency_equiv,
	end_product_equiv,
	end_currency_equiv
from
	#trades
where
	(product_id = @selected_product_id
or
	currency_id = @selected_product_id)
and
	convert(date, value_date) = convert(date, @selected_value_date)
	
order by
	trade_date,
	trade_id
		
update
	#trades_output
set
	a.account = b.symbol
from
	#trades_output a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#trades_output
set
	a.dealt_ccy = b.symbol
from
	#trades_output a,
	products b
where
	a.product_id = b.product_id

update
	#trades_output
set
	a.counter_ccy = b.symbol
from
	#trades_output a,
	products b
where
	a.currency_id = b.product_id

