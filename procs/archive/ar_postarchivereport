
create or replace procedure
	ar_postarchivereport
		@archive_date date=NULL
as


declare @num_batches int
declare @avg_runtime int
declare @total_runtime int
declare @num_trades int
declare @num_trade_notifications int
declare @num_aggregated_trades int
declare @archive_date_id int

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @fund_name varchar(50)

select
	@fund_name = name
from
	funds

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


if @archive_date = NULL
begin
	select
		@archive_date = max(archive_date)
	from
		archive_dates a,
		archive_date_statuses b
	where
		a.archive_date_status_id = b.archive_date_status_id
	and
		b.name = "Complete"
end

select
	@archive_date_id = archive_date_id
from
	archive_dates
where
	archive_date = @archive_date

if @archive_date_id = NULL
begin
	select
		section = "Error - "+ rtrim(@fund_name),
		status = "Error",
		msg = "Could not find archive date",
		archive_date = @archive_date

	return
end

create table
	#archive_batches
(
		archive_batch_id int,
		archive_date_id int,
		start_date datetime NULL,
		end_date datetime NULL,
		runtime float NULL
)
	
insert into 
	#archive_batches
select
	archive_batch_id,
	archive_date_id,
	start_date,
	end_date,
	datediff(ms, start_date, end_date)
from
	archive_batches
where
	archive_date_id = @archive_date_id

select 
	@num_batches = @@rowcount


select
	@num_trades = count(*) 
from 
	archive_trades a, 
	#archive_batches b 
where 
	a.archive_batch_id = b.archive_batch_id


select
        @num_trade_notifications = count(*) 
from 
        archive_trade_notifications a, 
        #archive_batches b 
where 
        a.archive_batch_id = b.archive_batch_id

select
	@num_aggregated_trades = count(*)
from
	archive_aggregated_trades a,
	#archive_batches b
where
        a.archive_batch_id = b.archive_batch_id

select
	@total_runtime = sum(runtime)
from
	#archive_batches

select
	@avg_runtime = @total_runtime / @num_batches

select
	section = "Summary - "+ rtrim(@fund_name),
	archive_date = convert(char(20), @archive_date, 106),
	batches = @num_batches,
	avg_runtime = convert(varchar(10), @avg_runtime)+" ms",
	total_runtime = convert(varchar(10), @total_runtime/1000)+" seconds",
	trades= @num_trades,
	trade_notifications = @num_trade_notifications,
	aggregated_trades = @num_aggregated_trades




go 

