drop procedure ar_queuebatcharchive
go

create procedure
	ar_queuebatcharchive
		@archive_date date

as

declare @today date
declare @first_business_day date
declare @archive_date_id int
declare @max_archive_date date
declare @max_commit_date datetime
declare @pending_status_id int

select
	@today = convert(date, getdate())

exec 
	r_firstbusinessdayofmonth
		@a_date = @today,
		@first_business_day = @first_business_day output

if @archive_date >= @first_business_day
begin
	select
		status = "Error",
		message = "Can not archive trades for the current month",
		today = @today,
		first_business_day = @first_business_day
	return
end

select
	@max_archive_date = max(archive_date)
from
	archive_dates

if @max_archive_date >= @archive_date
begin
	select
		status = "Error",
		message = "Requested date is queued for archiving or already archived. Must choose to archive date greater than last archived date"
	return
end

select 
	@max_commit_date = max(commit_date) 
from 
	daily_commits a, 
	commit_statuses b 
where 
	a.commit_status_id = b.commit_status_id 
and 
	b.name in("Commit Complete")

if @archive_date > @max_commit_date
begin
	select
		status = "Error",
		message = "Can not archive an uncomitted date"
	return
end



select
	@pending_status_id = archive_date_status_id
from
	archive_date_statuses
where
	name = "Pending"
if @pending_status_id = NULL
begin
	select
		status = "Error",
		message = "'Pending' archive date status is missing"
	return
end

exec 
	j_nextkey 
		"archive_dates",
		@archive_date_id output

insert into
	archive_dates(
		archive_date_id,
		archive_date,
		archive_date_status_id,
		start_date)
values(
	@archive_date_id,
	@archive_date,
	@pending_status_id,
	getdate()
)
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem queueing archive for date",
        	archive_date_id=@archive_date_id,
        	archive_date=@archive_date,
        	pending_status=@pending_status_id
	return
end

go
