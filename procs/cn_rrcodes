
if object_id("cn_rrcodes") != NULL
    drop procedure
        cn_rrcodes
go

create procedure
	cn_rrcodes
		@login varchar(30)
as


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"set_code",
	"Set RRCODE",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	a.trader_id,
	trader = a.symbol,
	account = b.symbol,
	a.rrcode,
	set_code = "SET RRCODE"
from
	traders a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
order by
	a.symbol





