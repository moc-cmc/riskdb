drop procedure
	r_instktcreationvalue
go

create procedure
	r_instktcreationvalue
		@login varchar(50),
		@trigger_symbol varchar(50),
        	@source varchar(50),
        	@cl_create char(1) =NULL, 
        	@cl_int_account varchar(50) =NULL,
        	@cl_ext_account varchar(50) =NULL,
        	@cl_trader varchar(50) =NULL,
        	@cl_counterparty varchar(50) =NULL,
        	@cl_strategy varchar(50) =NULL,
        	@cl_inv_qty char(1) =NULL,
        	@cl_spread float =NULL,
        	@lp_create char(1) =NULL,
        	@lp_int_account varchar(50) =NULL,
        	@lp_ext_account varchar(50) =NULL,
        	@lp_trader varchar(50) =NULL,
        	@lp_counterparty varchar(50) =NULL,
        	@lp_strategy varchar(50) =NULL,
        	@lp_inv_qty char(1) =NULL,
        	@lp_spread float =NULL


as


declare @source_id int
declare @dupe varchar(1)


select
	@source_id = source_id
from
	sources
where
	name = @source


select
	@dupe = "Y"
from
	ticket_creation_values
where
	trigger_symbol = @trigger_symbol
and
	source_id = @source_id


if @dupe = "Y"
begin
	select
		msg = "Value already created",
		trigger_symbol = @trigger_symbol,
		source = @source
	return
end

insert into 
	ticket_creation_values
values(
        @trigger_symbol,
        @source_id,
        @cl_create,
        @cl_int_account,
        @cl_ext_account,
        @cl_trader ,
        @cl_counterparty,
        @cl_strategy,
        @cl_inv_qty,
        @cl_spread ,
        @lp_create,
        @lp_int_account ,
        @lp_ext_account ,
        @lp_trader ,
        @lp_counterparty,
        @lp_strategy ,
        @lp_inv_qty ,
        @lp_spread)

exec
	r_viewtktcreationvalues
		@login


go
