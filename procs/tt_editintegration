create or replace procedure
	tt_editintegration
		@login varchar(50),
		@integration_id int,
		@name varchar(50)=NULL,
		@org varchar(50)=NULL

as

declare @org_id int
declare @orig_org_id int
declare @orig_org  varchar(50)
declare @orig_name varchar(50)


select 
	@orig_name = name,
	@orig_org_id = org_id	
from
	integrations
where
	integration_id = @integration_id
if @@rowcount = 0
begin
	select
		status = "error",
		message = "Could not find integration for integration id",
		integration_id = @integration_id
	return
end

select
	@org_id = org_id
from
	orgs
where
	name = @org
if @org_id = NULL
begin
	select
		@org_id = @orig_org_id
end
		
if @name = NULL
begin
	select
		@name = @orig_name
end

/* Check if anything changed */
if @name = @orig_name and @org_id = @orig_org_id
begin
	select
		status = "ok",
		message = "No change in integration details. Integration not modified",
		integration_id = @integration_id
	return
end

begin tran
	update
		integrations
	set
		name = @name,
		org_id = @org_id
	where
		integration_id = @integration_id
	if @@rowcount != 1
	begin
		select
			status = "error",
			message = "Problem updating integration. Aborting edit",
			integration_id = @integration_id
		rollback tran
		return
	end
commit tran	
	
	
select
	status = "Success",
	message = "Successfully edited integration",
	integration_id = @integration_id,
	name = @name,
	org = @org

go
