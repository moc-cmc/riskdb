create or replace procedure
	tt_editintegration
		@login varchar(50),
		@integration_id int,
		@name varchar(50),
		@org_name varchar(50)=NULL,
		@format_swaps char(1)=NULL,
		@connection_status varchar(15)=NULL,
		@stale_threshold int=NULL,
		@monitoring_enabled varchar(1)=NULL

as

declare @org_id int
declare @orig_org_id int
declare @orig_org  varchar(50)
declare @orig_name varchar(50)
declare @orig_format_swaps char(1)
declare @connection_status_id int
declare @orig_connection_status_id int 
declare @orig_stale_threshold int
declare @orig_monitoring_enabled varchar(1)

select 
	@orig_org_id = org_id,
	@orig_format_swaps = format_swaps
from
	integrations
where
	integration_id = @integration_id
if @@rowcount = 0
begin
	select
		status = "error",
		message = "Could not find integration for integration id",
		integration_id = @integration_id
	return
end

select
	@orig_connection_status_id = connection_status_id,
        @orig_stale_threshold = stale_threshold,
        @orig_monitoring_enabled = monitoring_enabled
from
	connections
where
	name = @name
	
select
	@org_id = org_id
from
	orgs
where
	name = @org_name
if @org_id = NULL
begin
	select
		@org_id = @orig_org_id
end
	
if @format_swaps = NULL
begin
	select
		@format_swaps = @orig_format_swaps
end
	
select
	@connection_status_id=connection_status_id
from
	connection_statuses
where
	name=@connection_status

if @connection_status_id = NULL
begin
	select
		@connection_status_id=@orig_connection_status_id
end

if @stale_threshold = NULL
begin
	select
		@stale_threshold=@orig_stale_threshold
end

if @monitoring_enabled = NULL
begin
	select
		@monitoring_enabled = @orig_monitoring_enabled
end


/* Check if anything changed */
if @name = @orig_name and @org_id = @orig_org_id and @connection_status_id = @orig_connection_status_id and @stale_threshold = @orig_stale_threshold and @monitoring_enabled = @orig_monitoring_enabled
begin
	select
		status = "ok",
		message = "No change in integration details. Integration not modified",
		integration_id = @integration_id
	return
end

begin tran
	update
		integrations
	set
		org_id = @org_id,
		format_swaps = @format_swaps
	where
		integration_id = @integration_id
	if @@rowcount != 1
	begin
		select
			status = "error",
			message = "Problem updating integration. Aborting edit",
			integration_id = @integration_id
		rollback tran
		return
	end

	update
		connections
	set
		connection_status_id=@connection_status_id,
		stale_threshold=@stale_threshold,
		monitoring_enabled=@monitoring_enabled
	where
		name=@name
	if @@rowcount != 1
	begin
		select
			status="error",
			message="Problem updating connection. Aborting edit",
			connection_name=@name
		rollback tran
		return
	end
		
commit tran	
	
	
select
	status = "Success",
	message = "Successfully edited integration",
	integration_id = @integration_id,
	name = @name,
	org = @org_name

exec 
	r_manageintegrations @login

go


