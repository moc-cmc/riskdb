create or replace procedure
	api_bookhubsettlementlaser
		@login varchar(100),
		@deal_id int,
		@action varchar(50),
		@status varchar(50),
		@hub varchar(50),
		@transaction_date varchar(50),
		@account varchar(50),
		@symbol varchar(50),
		@value_date varchar(50),
		@amount varchar(50),
		@counter_amount varchar(50) = NULL,
		@trade_price varchar(50) = NULL,
		@venue varchar(50) = NULL,
		@eb varchar(50) = NULL,
		@identifier varchar(50) = NULL



as

declare @source varchar(50)
declare @source_id int
declare @trade1_id int
declare @trade2_id int
declare @book_deal_id int
declare @syssettle_transaction_id int
declare @account_transaction_id int
declare @mh_settlement_id int

declare @book_account varchar(50)
declare @book_value_date datetime
declare @book_product varchar(50)
declare @book_balance numeric(30,10)

if @status != "Matched" or @action != 'Settlement'
begin
	select
		status = "Skipped",
		message= "Only processing 'Matched' records with action 'Settlement'"
	return
end

select
	@source_id = outbound_source_id
from
	matching_engines
where
	name = "MatchHub "+rtrim(@hub)
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding matching_engine and source for hub, required for dupe handling",
		hub = "MatchHub "+rtrim(@hub)
	return
end

select
	@source = name
from
	sources
where
	source_id = @source_id
if @source = NULL
begin
	select
		status = "Error",
		message = "Problem finding source for id",
		source_id = @source_id,
		hub = "MatchHub "+rtrim(@hub)
	return
end

select
	@book_account = b.symbol
from
	external_accounts b,
	counterparties c,
	counterparty_symbols d
where
	b.external_account_id = c.external_account_id
and
	c.counterparty_id = d.counterparty_id
and
	d.symbol = @account
and
	d.source_id = @source_id
if @book_account = NULL
begin
	select
		status = "Error",
		message = "Problem finding account",
		account = @account
	return
end

select
	@book_value_date = convert(datetime, @transaction_date),
	@book_balance = dbo.f_fmtproductqty(@symbol, convert(numeric(30, 10), @amount))

	
select
	@mh_settlement_id = mh_settlement_id,
	@book_deal_id = deal_id,
	@syssettle_transaction_id = @syssettle_transaction_id,
	@account_transaction_id = account_transaction_id
from
	mh_settlements
where
	hub_deal_id = @deal_id
and
	source_id = @source_id
if @mh_settlement_id != NULL
begin
	if @book_deal_id != NULL and @account_transaction_id != NULL
	begin
		select
			status = "Dupe",
			message= "Already processed mh deal",
			hub_deal_id = @deal_id,
			source = @source,
        		action = @action,
        		transaction_status = @status,
        		hub = @hub,
        		transaction_date = @transaction_date,
        		account = @account,
	        	book_account = @book_account,
        		symbol = @symbol,
        		value_date = @value_date,
        		amount = @amount
		return
	end
	if @book_deal_id != NULL and @account_transaction_id = NULL
	begin
		select
			status = "Partial Dupe",
			message= "Already processed mh deal sysrecords, continuing to book transaction",
			hub_deal_id = @deal_id,
			source = @source,
        		action = @action,
        		transaction_status = @status,
        		hub = @hub,
        		transaction_date = @transaction_date,
        		account = @account,
	        	book_account = @book_account,
        		symbol = @symbol,
        		value_date = @value_date,
        		amount = @amount
	end
end

/* We havent booked the settlement if its not in mh_settlements */
if @book_deal_id = NULL
begin
	exec
		api_reportsyssettlement
			@login = @login,
			@account = @book_account,
			@value_date = @book_value_date,
			@product = @symbol,
			@balance = @book_balance,
			@deal_id = @book_deal_id output,
			@trade1_id = @trade1_id output,
			@trade2_id = @trade2_id output,
			@account_transaction_id = @syssettle_transaction_id output
	
	if @trade1_id != NULL and @trade2_id != NULL and @syssettle_transaction_id != NULL and @book_deal_id != NULL
	begin
		exec
			j_nextkey
				"mh_settlements",
				@mh_settlement_id output
		insert into
			mh_settlements(
        			mh_settlement_id,
        			hub_deal_id,
        			source_id,
        			entered_at, 
        			deal_id,
        			systrades_trade1_id,
        			systrades_trade2_id,
        			syssettle_transaction_id,
				account_transaction_id)
		values(
			@mh_settlement_id,
			@deal_id,
			@source_id,
			getdate(),
			@book_deal_id,
			@trade1_id,
			@trade2_id,
			@syssettle_transaction_id,
			NULL
		)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem adding mhsettlement record for dupe checking",
                		deal_id = @deal_id,
                		source = @source,
                		syssettle_trade1_id = @trade1_id,
                		syssettle_trade2_id = @trade2_id,
                		syssettle_transaction_id = @syssettle_transaction_id,
                		syssettle_deal_id = @book_deal_id,
				action = @action,
        			transaction_status = @status,
        			hub = @hub,
        			transaction_date = @transaction_date,
        			account = @account,
        			symbol = @symbol,
        			value_date = @value_date,
        			amount = @amount
			return
		end
	end
end

select
	@book_deal_id = NULL

if @mh_settlement_id != NULL and @account_transaction_id = NULL
begin
	exec
		api_paysyssettlement
			@login = @login,
			@account = @book_account,
			@transaction_date = @book_value_date,
			@product = @symbol,
			@balance = @book_balance,
			@deal_id = @book_deal_id output,
			@account_transaction_id = @account_transaction_id  output
	
	if @account_transaction_id != NULL
	begin
		begin tran
			update
				mh_settlements
			set
				account_transaction_id = @account_transaction_id
			where
				mh_settlement_id = @mh_settlement_id
			if @@rowcount != 1
			begin
				select
					status = "Error",
					message = "Problem updating mh settlement record to track dupes",
        				deal_id = @deal_id,
        				action = @action,
        				transaction_status = @status,
        				hub = @hub,
        				transaction_date = @transaction_date,
        				account = @account,
        				symbol = @symbol,
        				value_date = @value_date,
        				amount = @amount,
        				book_account = @book_account,
        				book_value_date = @book_value_date,
        				balance = @book_balance,
        				source = @source
			
				rollback tran		
				return
			end
		commit tran
	end
end


select
	status = "Success",
	messsage = "Processed record",
	deal_id = @deal_id,
	action = @action,
	transaction_status = @status,
	hub = @hub,
	transaction_date = @transaction_date,
	account = @account,
	symbol = @symbol,
	value_date = @value_date,
	amount = @amount,
	counter_amount = @counter_amount,
	trade_price = @trade_price,
	venue = @venue,
	eb = @eb,
	identifier = @identifier,
	book_account = @book_account,
	book_value_date = @book_value_date,
	balance = @book_balance,
	source = @source

return

