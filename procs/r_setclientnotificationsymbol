drop procedure
	r_setclientnotificationsymbol
go

create procedure
	r_setclientnotificationsymbol
		@login varchar(50),
		@external_account varchar(50),
		@notification_alias varchar(50)

as

declare @source varchar(50)
declare @source_id int
declare @external_account_id int
declare @mappings int


select @source = "Agency Client"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "External Account not found",
		external_account = @external_account
	return
end


if exists(select external_account_id from external_account_symbols where external_account_id = @external_account_id and source_id = @source_id)
begin
	begin tran
		update
			external_account_symbols
		set
			symbol = @notification_alias
		where
			external_account_id = @external_account_id
		and
			source_id = @source_id
		if @@rowcount != 1
		begin
			select
				error = "Error",
				message = "More than one outbount external account symbol exists for account. Alias not updated"
			rollback tran
			return
		end
	commit tran
end
else
begin
	insert into
		external_account_symbols
	values(
		@external_account_id,
		@source_id,
		@notification_alias)
end

select
	id = 1,
	message = "Successfully set notification alias for external account",
	external_account = @external_account


exec
	r_manageclientnotifications
			@login

go

