create or replace procedure
	rdb_sourcebalances
		@login varchar(50),
		@source varchar(50)=NULL,
		@timestamp datetime = NULL

as

declare @total_style varchar(250)
declare @style varchar(250)
declare @error_style varchar(250)
declare @subtotal_style varchar(250)
declare @selected_style varchar(250)
declare @selected_trade_style varchar(250)
declare @deficit_style varchar(250)
declare @client_style varchar(250)
declare @fund_id int
declare @evaluation_currency_id int
declare @evaluation_currency varchar(50)
declare @begin_date datetime
declare @end_date datetime

declare @source_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"amount",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"source",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"adjust",
	"Add Balance Recon Adjustment",
	NULL)

insert into
	#meta
values(
	"Column Format",
	"diff_equiv",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"avg_short",
	"Number",
	"#,##0.00000000;<span style=""color:red"">(#,##0.00000000)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@deficit_style = "background:#F5F3CE;color:#FF0000;border: 1px solid white",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold", 
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@selected_trade_style = "background:#F7F4C1;border: 1px solid white"

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id
if @evaluation_currency = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end


select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end

exec
	r_daterangefordate
		@timestamp,
		@begin_date output,
		@end_date output


select  
        product_id,
        rate
into
        #conversion_rates
from            
        x_conversion_rates
where           
        _login = @login
and
        _as_of_date = @end_date
and
        _product = @evaluation_currency


create table
	#output(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		source_balance float NULL,
		riskdb_balance float NULL,
		diff float NULL,
		diff_equiv float NULL,
		adjust varchar(25) NULL)

insert into
	#output(
		style,
		external_account_id,
		account,
		product_id,
		product,
		source_balance,
		riskdb_balance,
		diff,
		diff_equiv)
select
	style = @style,
	a.external_account_id,
	b.symbol,
	a.product_id,
	c.symbol,
	source_balance = sum(a.amount),
	riskdb_balance = 0.0,
	diff = 0.0,
	diff_equiv = 0.0
from
	source_balances a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
and
	a.source_id = @source_id
and
	a.timestamp = @timestamp
group by
        a.external_account_id,
        b.symbol,
        a.product_id,
        c.symbol,
        a.timestamp
order by
	b.symbol,
	c.symbol

create table
	#accounts(
		external_account_id int)
insert into
	#accounts(
		external_account_id)
select
	distinct(external_account_id)
from
	#output

create table
	#positions(
		external_account_id int,
		product_id int,
		balance float)
insert into
	#positions(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date <= @timestamp
group by
	a.external_account_id,
	a.currency_id


insert into
	#positions(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	settlements a,
	#accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date <= @timestamp
group by
	a.external_account_id,
	a.currency_id

insert into
	#positions(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	b.product_id,
	sum(a.quantity)
from
	trades a,
	forwards b,
	#accounts c
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	a.trade_date <= @timestamp
and
	convert(date, a.value_date) >= convert(date, @timestamp)
group by
	a.external_account_id,
	b.product_id

insert into
	#positions(
		external_account_id,
		product_id,
		balance)
select
	a.external_account_id,
	b.currency_id,
	sum(a.quantity * a.price * -1.0)
from
	trades a,
	forwards b,
	#accounts c
where
	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	a.trade_date <= @timestamp
and
	convert(date, a.value_date) >= convert(date, @timestamp)
group by
	a.external_account_id,
	b.currency_id

create table
	#net(
		external_account_id int,
		product_id int,
		balance float)
insert into
	#net(
		external_account_id,
		product_id,
		balance)
select
	external_account_id,
	product_id,
	sum(balance)
from
	#positions
group by
	external_account_id,
	product_id

update
	#output
set
	a.riskdb_balance = b.balance
from
	#output a,
	#net b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id


update
	#output
set
	diff = source_balance - riskdb_balance

update
	#output
set
	a.diff_equiv = a.diff * b.rate
from
	#output a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#output
set
	style = @error_style,
	adjust = "Book Adjustment"
where
	abs(diff) > 0.00000001

create table
	#contract_pos(
		id int identity,
		style varchar(250) NULL,
		external_account_id int,
		account varchar(50) NULL,
		contract_id int NULL,
		symbol varchar(50) NULL,
		position float NULL,
		riskdb_pos float NULL,
		diff float NULL,
		as_of datetime NULL,
		timestamp datetime NULL)
insert into
	#contract_pos(
		style,
		external_account_id,
		account,
		contract_id,
		symbol,
		position,
		riskdb_pos,
		diff,
		as_of,
		timestamp)
select
	style = @style,
	a.external_account_id,
	b.symbol,
	a.contract_id,
	c.symbol,
	a.amount,
	riskdb_pos = 0.0,
	diff = 0.0,
	a.as_of,
	a.timestamp
from
	source_positions a,
	external_accounts b,
	contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	a.source_id = @source_id
and
	timestamp = @timestamp

create table
	#futs(
		external_account_id int,
		contract_id int,
		position float)
insert into
	#futs(
		external_account_id,
		contract_id,
		position)
select
	external_account_id,
	contract_id,
	sum(quantity)
from
	trades
where
	trade_date <= @timestamp
group by
	external_account_id,
	contract_id

update
	#contract_pos
set
	a.riskdb_pos = b.position
from
	#contract_pos a,
	#futs b
where
	a.contract_id = b.contract_id
	
	
select
	section = "Balances",
	style,
	source = @source,
	transaction_date = convert(varchar(25), @timestamp),
	account,
	product,
	source_balance,
	riskdb_balance,
	diff,
	diff_equiv,
	amount = diff,
	adjust
from
	#output
order by
	id

select
	section = "Positions",
	style,
	source = @source,
	transaction_date = convert(varchar(25), @timestamp),
	account,
	symbol,
	source_pos = position,
	risdkb_pos = riskdb_pos,
	diff
from
	#contract_pos
	

go
