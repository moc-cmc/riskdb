
if object_id("r_contractvaluedate") != NULL
    drop procedure
        r_contractvaluedate
go
 
create procedure
	r_contractvaluedate
		@contract_id int,
		@trade_date datetime,
		@value_date datetime output
as

declare @product_id int
declare @currency_id int
declare @product_offset_days int
declare @currency_offset_days int
declare @offset_days int

select
	@product_id = product_id,
	@currency_id = currency_id
from
	forwards
where
	contract_id = @contract_id

select
	@product_offset_days = offset_days
from
	product_value_date_offsets
where
	product_id = @product_id
if @@rowcount != 1
	select
		@product_offset_days = 2

select
	@currency_offset_days = offset_days
from
	product_value_date_offsets
where
	product_id = @currency_id
if @@rowcount != 1
	select
		@currency_offset_days = 2
	
if @product_offset_days > @currency_offset_days
	select
		@offset_days = @product_offset_days
else
	select
		@offset_days = @currency_offset_days

select
	@value_date = @trade_date

while @offset_days > 0
begin
	exec
		r_nextbusinessday
			@value_date,
			@value_date output

	select
		@offset_days = @offset_days - 1
end

if datepart(hour, @trade_date) >= 17
	exec
		r_nextbusinessday
			@value_date,
			@value_date output

select
	@value_date = convert(char(2), datepart(month, @value_date)) + "/" +
		convert(char(2), datepart(day, @value_date)) + "/" +
		convert(char(4), datepart(year, @value_date))

go
