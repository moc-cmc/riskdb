	a.maturing_fx,
	perps_realized = a.cfd_realized_pl,
	a.cash,
	a.fees,
	a.settled_premium,
	a.closing_balance,
	a.unsettled_prem,
	a.open_position,
	a.open_option_pos,
	a.total_equity
from
	#net_activity a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
order by
	b.symbol,
	c.symbol

/* Show the Equity Value Summary */
create table
	#equity_summary_output
(
	id int identity,
	section varchar(50) NULL,
	style varchar(50) NULL,
	account varchar(50) NULL,
	product varchar(50) NULL,
        total_equity float NULL,
        conversion_rate float NULL,
        converted_value float NULL,
	evaluation_ccy varchar(10) NULL
)
insert into
	#equity_summary_output(
		section,
		style,
		account,
		product,
		total_equity,
		conversion_rate,
		converted_value,
		evaluation_ccy
)
select
	section = "Equity Value Summary",
	style = "background:#FFFFFF;border: 1px solid white",
	account = b.symbol,
	product = c.symbol,
	a.total_equity,
	a.conversion_rate,
	a.converted_value,
	evaluation_ccy = d.symbol
from
	#equity_value_summary a,
	external_accounts b,
	products c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
and
	a.evaluation_currency_id = d.product_id
order by
	b.symbol,
	c.symbol

insert into
	#equity_summary_output(
                section,
                style,
                account,
                converted_value,
                evaluation_ccy
)
select
        section = "Equity Value Summary",
        style = "background:#FFFFFF;border: 1px solid white",
	account = rtrim(account)+" Total",
	converted_value = sum(converted_value),
	evaluation_ccy
from
	#equity_summary_output
group by
	section,
	style,
	account,
	evaluation_ccy

select
	section,
	style,
	account,
	product,
	total_equity,
	conversion_rate,
	converted_value,
	evaluation_ccy
from
	#equity_summary_output
order by
	account,
	product

	
