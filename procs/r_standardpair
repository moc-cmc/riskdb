create or replace procedure
	r_standardpair
		@ccy1 varchar(10),
		@ccy2 varchar(10),
		@standard_contract varchar(10) output

as

declare @symbol_check1 varchar(10)
declare @symbol_check2 varchar(10)
declare @is1_inverted varchar(1)
declare @is2_inverted varchar(1)
declare @symbol1_exist char(1)
declare @symbol2_exist char(1)

select
	@symbol_check1 = rtrim(@ccy1) + rtrim(@ccy2),
	@symbol_check2 = rtrim(@ccy2) + rtrim(@ccy1)

select
	@symbol1_exist = "Y"
from
	contracts
where
	symbol = @symbol_check1
select
       	@symbol2_exist = "Y"
from
       	contracts
where
        symbol = @symbol_check2

select
	@is1_inverted = 'Y'
from
	contracts a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
and
	a.symbol = @symbol_check1

if @is1_inverted != "Y" and  @symbol1_exist = "Y"
begin
	select
		@standard_contract = @symbol_check1
	return
end

if @is1_inverted = 'Y'
begin


	select
        	@is2_inverted = 'Y'
	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
	where
        	a.contract_id = b.contract_id
	and
        	b.price_style_id = c.price_style_id
	and
        	c.name = "Inverted"
	and
        	a.symbol = @symbol_check2

	if @is2_inverted = 'Y'
	begin
		select
			status="Error",
			msg = "Both pairs are marked inverted"
		return
	end
	
	if @is2_inverted != 'Y' and @symbol2_exist = "Y"
	begin
		select
			@standard_contract = @symbol_check2
	end
end

if @is1_inverted != 'Y' and @is2_inverted != 'Y' and  @symbol2_exist != "Y" and @symbol1_exist = "Y"
begin
	select
		@standard_contract = @symbol_check1
end
if @is1_inverted != 'Y' and @is2_inverted != 'Y' and @symbol2_exist = "Y" and @symbol1_exist != "Y"
begin
	select
		@standard_contract = @symbol_check2
end

go
