create or replace procedure
	ag_risksystemoverview
		@login varchar(100)

as

declare @tico_account_id int
declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)


declare @trades_begin_date datetime
declare @trades_end_date datetime
declare @trans_begin_date datetime
declare @trans_end_date datetime
declare @begin_date datetime
declare @end_date datetime
declare @trades_count int
declare @trans_count int
declare @max_trades int
declare @system_wipe_identifier varchar(100)
declare @system_wipe_timestamp datetime


select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

create table
   #meta(
           meta_type char(200),
           name char(50) NULL,
           action char(100) NULL,
           value char(200) NULL)
insert into
   #meta
values(
   "Row Style",
   "style",
   NULL,
   NULL)

insert into
   #meta
values (
   "Column Group",
   "section",
   NULL,
   NULL)

insert into
   #meta
values (
   "Column Link",
   "wipe_system",
   "Wipe System Data",
   NULL)

select * from #meta


/* Generating a wipe ID that may or may not be used later */
select
	@system_wipe_identifier = newid(),
	@system_wipe_timestamp = getdate()


insert into 
	system_wipe_identifiers(
		tico_account_id,
		identifier,
		timestamp)
values(
	@tico_account_id,	
	@system_wipe_identifier,
	@system_wipe_timestamp
)

create table
	#stats(
		id int identity,
		fund_name varchar(100),
		fund_status varchar(50),
		total_trades int NULL,
		total_transactions int NULL,
		begin_date datetime NULL,
		end_date datetime NULL,
		wipe_system varchar(10) NULL
)

select
	@trades_begin_date = min(trade_date),
	@trades_end_date = max(trade_date),
	@trades_count = count(*)
from
	trades

select
        @trans_begin_date = min(transaction_date),
        @trans_end_date = max(transaction_date),
        @trans_count = count(*)
from    
        account_transactions

select 
	@begin_date = @trades_begin_date,
	@end_date = @trades_end_date

if @trans_begin_date < @begin_date
begin
	select
		@begin_date = @trans_begin_date
end
if @trans_end_date > @end_date
begin
	select
		@end_date = @trans_end_date
end

if @trans_count = NULL
begin
	select
		@trans_count = 0
end

if @trades_count = NULL
begin
	select
		@trades_count = 0
end

insert into
	#stats(
		fund_name,
		fund_status,
		total_trades,
		total_transactions,
		begin_date,
		end_date)
select
	a.name,
	b.name,
	@trades_count,
	@trans_count,
	@begin_date,
	@end_date
from
	funds a,
	statuses b
where
	a.status_id = b.status_id


select
	@max_trades = 2000

if @trades_count > @max_trades
begin
	select
		section = "System Check",
		message = "Can not wipe trades since there are too many trades. Contact support to change the threshold",
		max_trades = @max_trades,
		trade_count = @trades_count
end
else
begin
	update
		#stats
	set
		wipe_system = "WIPE"
	where
		fund_status = "Review"
end


select
	section = "System Stats",
	fund_name,
	fund_status,
	total_trades,
	total_transactions,
	begin_date,
	end_date,
	wipe_system,
	wipe_identifier = @system_wipe_identifier,
	style = @style
from
	#stats

select
	section = "Wipe Log",
	wiped_by = a.login,
	wiped_at = b.timestamp,
	wipe_identifier = b.system_wipe_identifier,
	begin_range = b.begin_date,
	end_range = b.end_date,
	trades_count = b.total_trades,
	total_transactions = b.total_transactions,
	style = @style
from
	tico_accounts a,
	system_wipe_logs b
where
	a.account_id = b.user_id

go
	


