
if object_id("r_contractvolinputs") != NULL
    drop procedure
        r_contractvolinputs
go

create procedure
	r_contractvolinputs
		@contract_id int,
		@as_of_date datetime
as

declare @underlying_contract_id int
declare @instrument char(100)

select
	@underlying_contract_id = a.underlying_contract_id
from
	options a,
	option_expirations b,
	option_contracts c
where
	a.option_id = b.option_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.contract_id = @contract_id

select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @underlying_contract_id


if @instrument = "Forward"	
	exec
		r_forwardoptionvolinputs
			@contract_id,
			@as_of_date
else
	exec
		r_futureoptionvolinputs
			@contract_id,
			@as_of_date 
			

go
