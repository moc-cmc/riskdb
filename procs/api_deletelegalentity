create or replace procedure 
	api_deletelegalentity
		@login varchar(100),
		@legal_entity varchar(150)

as

declare @legal_entity_id int
declare @trade_count int
declare @transaction_count int
declare @request_count int
declare @le_run_id int


select
	@legal_entity_id = legal_entity_id
from
	legal_entities 
where
	name = @legal_entity
if @legal_entity_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding legal entity",
		legal_entity = @legal_entity
	return	
end


create table 
	#external_accounts(
		external_account_id int,
		symbol varchar(100)
)

insert into
	#external_accounts
select
	b.external_account_id,
	b.symbol
from
	bo_master_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.legal_entity_id = @legal_entity_id

insert into
	#external_accounts
select
	a.external_account_id,
	c.symbol
from
	fo_sub_accounts a,
	bo_master_accounts b,
	external_accounts c
where
	a.bo_master_account_id = b.bo_master_account_id
and
	a.external_account_id = c.external_account_id
and
	b.legal_entity_id = @legal_entity_id

select
	@transaction_count = count(*)
from
	pending_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
if @transaction_count > 0
begin
	select
		status = "Error",
		message = "Transactions exist for legal entity. Can not delete"
	return
end

select
        @transaction_count = count(*)
from
        account_transactions a,
        #external_accounts b
where
        a.external_account_id = b.external_account_id
if @transaction_count > 0
begin   
        select
                status = "Error",
                message = "Transactions exist for legal entity. Can not delete"
        return
end


select
	@trade_count = count(*)
from
	trades a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
if @trade_count > 0
begin
	select
		status = "Error",
		message = "Trades exist for legal entity accounts. Can not delete"
	return
end


select
        @trade_count = count(*)
from
        trades a,
        #external_accounts b,
	traders c
where
        a.external_account_id = b.external_account_id
and
	b.external_account_id = c.external_account_id
if @trade_count > 0
begin
        select
                status = "Error",
                message = "Trades exist for legal entity account traders. Can not delete"
        return
end



select
	@request_count = count(*)
from
	allocation_requests a,
	#external_accounts b,
	fo_sub_accounts c
where
	a.fo_sub_account_id = c.fo_sub_account_id
and
	c.external_account_id = b.external_account_id
if @trade_count > 0
begin
	select
		status = "Error",
		message = "Allocation requests exist for legal entity accounts. Can not delete"
	return
end


select
        @request_count = count(*)
from
	ledger_requests a,
	#external_accounts b,
	bo_master_accounts c
where
	a.bo_master_account_id = c.bo_master_account_id
and
	c.external_account_id = b.external_account_id
if @trade_count > 0
begin
	select
		status = "Error",
		message = "Ledger Requests exist for legal entity accounts. Can not delete"
	return
end

	
select
	@le_run_id = run_id
from
	runs a,
	legal_entities b
where
	a.name = b.name
and
	b.legal_entity_id = @legal_entity_id
if @le_run_id = NULL
begin
	select
		status = "Error",
		message = "Missing run name that matches legal_entity_name"
	return
end

begin tran
	
	/* Runs - legal entity */
	delete from
		runs
	where
		run_id = @le_run_id
	
	delete from
		user_runs
	where
		run_id = @le_run_id
	
	/* Runs - accounts and traders */
	delete
		run_external_accounts
	from
		run_external_accounts a,
		#external_accounts b
	where
		a.external_account_id  = b.external_account_id 
	
	delete 	
		run_traders
	from
		run_traders a,
		#external_accounts b,
		traders c
	where
		a.trader_id = c.trader_id
	and
		c.external_account_id = b.external_account_id
	
	delete
		user_runs
	from
		user_runs a,
		runs b,
		#external_accounts c
	where
		a.run_id = b.run_id
	and
		b.name = c.symbol

	delete	
		runs
	from
		runs a,
		#external_accounts b
	where
		a.name = b.symbol
	
	/* Legal entity */	
	delete from
		legal_entities
	where
		legal_entity_id = @legal_entity_id

	delete from 
		legal_entity_tico_accounts
	where
		legal_entity_id = @legal_entity_id
	
	delete from
		outside_accounts
	where
		legal_entity_id = @legal_entity_id

	delete from
		legal_entity_approvals
	where
		legal_entity_id = @legal_entity_id

	/* Accounts and traders */
	delete
		bo_master_accounts
	from
		bo_master_accounts a,
		#external_accounts b
	where 
		a.external_account_id  = b.external_account_id

	delete
		fo_sub_accounts
	from
		bo_master_accounts a,
		#external_accounts b
	where 
		a.external_account_id  = b.external_account_id

	delete
		traders
	from
		traders a,
		#external_accounts b
	where
		a.external_account_id  = b.external_account_id

	delete
		external_accounts
	from
		external_accounts a,
		#external_accounts b
	where 
		a.external_account_id  = b.external_account_id

commit tran

	

select
	status = "Success",
	message = "Deleted legal entity",
	legal_entity = @legal_entity


go	
