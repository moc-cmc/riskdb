drop procedure
	tt_edgeinternaltally
go

create procedure
	tt_edgeinternaltally
       		@agent varchar(50),
       		@source varchar(50),
		@default_login varchar(50), 
		@granularity varchar(15)=NULL, /* Provided by FIX server config.properties & spring.xml */
		@broker varchar(50)=NULL, /* Provided by FIX server config.properties & spring.xml */
		@sender_comp varchar(50),
		@target_comp varchar(50), 
       		@order_origination_firm varchar(50),
       		@order_origination_trader varchar(50),
       		@client_id varchar(50),
       		@trade_date datetime,
       		@trading_day datetime,
       		@trade_report_id varchar(50),
       		@execution_id varchar(50),
		@trade_ref_id varchar(50),	
		@previously_reported varchar(50),
       		@order_id varchar(50),
		@order_status varchar(50),
		@exec_type varchar(50),
     		@symbol varchar(50),
       		@ccy1 varchar(10),
       		@ccy2 varchar(10),
       		@value_date datetime,
       		@side varchar(10),
       		@qty1 float,
       		@price float,
		@last_spot_rate float,
		@last_fwd_points float=NULL,
		@on_behalf_of_comp_id varchar(50),
		@deliver_to_comp_id varchar(50),
		@maker_or_taker varchar(50)


as


declare @is_fund_agency_trdr varchar(1)
declare @committed_status_id int
declare @external_account_id int
declare @external_account_type varchar(25)
declare @aggregation_style_id int
declare @aggregation_style varchar(25)
declare @substring1 varchar(50)
declare @substring2 varchar(50)

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @counterparty varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_login varchar(50)
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int

declare @lookup_cpty varchar(50)
declare @lookup_trader varchar(50)
declare @broker_id int
declare @cancel_trade_id int

declare @suppressed_deal_id int
declare @suppressed_trade_id int
declare @suppress_trade varchar(1)
declare @source_id int

declare @gmt_adjustment int


select
	@gmt_adjustment = datediff(hh, getdate(), getutcdate()) * -1

if @gmt_adjustment != 0
        select  
                 @trade_date = dateadd(hour, @gmt_adjustment, @trade_date)


select
        @suppress_trade = "N"

select
	@source_id = source_id
from
	sources
where
	name = @source


if @broker = NULL
	select
		@broker = "Edgewater Internal"

select
	@quoted_price = @price

/*
if @order_status = "CANCELED"
begin
        select
                @exec_type = "CANCELED"
end

if @order_status = "PENDING_REPLACE"
begin
        select
                @exec_type = "REPLACE"
end

if @order_status = "NEW"
begin
        select
                @exec_type = "NEW"
end

if @order_status = "PENDING_REPLACE"
begin
	/* Cancel trade and tally Replace Message */
	select
		@cancel_trade_id = trade_id
	from
		trades
	where
		broker_id = @broker_id
	and
		identifier = @trade_ref_id

	if @cancel_trade_id != NULL
	begin
		/* Cancel Trade */

		exec
			tt_canceltrade
				@cancel_trade_id
	end
end

if @order_status = "CANCELED"
begin
        /* Cancel trade and return */
        select
                @cancel_trade_id = trade_id
        from
                trades
        where
                broker_id = @broker_id
        and
                identifier = @trade_ref_id

        if @cancel_trade_id != NULL
        begin
                /* Cancel Trade */

                exec
                        tt_canceltrade
                                @cancel_trade_id
        end

	/* Ack Message */
	select
    		trade_report_id=@trade_report_id,
    		exec_type = @exec_type,
    		symbol="NA"


	return
end
*/

/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

	
	/* We are booking all tickets as MKT */
	
	select
		@lookup_trader = @sender_comp,
		@lookup_cpty = @order_origination_firm

	/*
        * LOOKUP @trader_id, @trader, @trader_login, @external_account_id
        */

        select
                @trader_id = a.trader_id,
                @trader = a.symbol,
                @trader_login = c.login,
                @external_account_id = a.external_account_id
        from
                traders a,
                trader_symbols b,
                sources ba,
                tico_accounts c
        where
                a.trader_id = b.trader_id
        and
                b.source_id = ba.source_id
        and
                a.tico_account_id = c.account_id
        and
                ba.name = @source
        and
                b.symbol = @lookup_trader

        if @trader_id = NULL or @trader_login = NULL
        begin
                select
                        @trader_id = a.trader_id,
                        @trader = a.symbol,
                        @trader_login = c.login,
                        @external_account_id = a.external_account_id
                from
                        traders a,
                        tico_accounts c
                where
                        a.tico_account_id = c.account_id
                and
                        a.symbol = @lookup_trader

                if @trader_id = NULL or @trader_login = NULL
                begin
                        select
                                status = "Error",
                                message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
                                lookup_trader = @lookup_trader
                        return
                end
        end


	/*
        * LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
        */

        select
                @lookup_cpty = @order_origination_firm
        select  
                @counterparty_id = a.counterparty_id,
                @counterparty = a.name,
                @cpty_ext_acct_id = a.external_account_id
        from
                counterparties a,
                counterparty_symbols b,
                sources ba
        where
                a.counterparty_id = b.counterparty_id
        and     
                b.source_id = ba.source_id
        and     
                ba.name = @source
        and
                b.symbol = @lookup_cpty
        if @counterparty = NULL
        begin
                select
                        @counterparty_id = a.counterparty_id,
                        @counterparty = a.name,
                        @cpty_ext_acct_id = a.external_account_id
                from
                        counterparties a
                where
                        a.name = @lookup_cpty

                if @counterparty = NULL
                begin
                        select
                                status = "Error",
                                message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
                                lookup_cpty = @lookup_cpty
                        return
                end
        end

	
	/*
 	 * OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
 	 */ 
	select
		@external_account_id = @cpty_ext_acct_id


	select
                @trade_identifier = @trade_report_id,
                @deal_exec_symbol = @trade_report_id,
                @deal_type = "Market Forward"


/*
 * VERIFY @broker exist and check for dupe
 */
select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @@rowcount != 1
begin
        select
                "error"="Error",
                "msg"="Broker not found",
                "broker"=@broker
        return
end

if exists(select trade_id from trades where broker_id = @broker_id and identifier = @trade_identifier)
begin
        select
                status="Dupe",
                msg="Trade already tallied",
                identifier=@trade_identifier,
                broker= @broker
        return
end


/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Couldn't find external_account from @external_account_id",
		external_account_id = @external_account_id
	return
end


select
	@trade_type = "Spot"

/*	
if @last_fwd_points != 0 and @last_fwd_points != NULL
begin
	select
		@trade_type = "Forward"
end
*/

if @ccy1 != NULL
begin
        select
                @substring1 = substring(@symbol, 1, 3),
                @substring2 = substring(@symbol, 4, 6)

        if @substring1 != @ccy1
        begin
                select
                        @symbol = @substring2 + @substring1,
                        @inverted = "Y"
        end

end


if @side = "SELL"
begin
    select
        @qty1 = -@qty1
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1,
                	@ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end

select
        @suppress_trade = "Y"
from
        suppression_symbols
where
        source_id = @source_id
and
        symbol = @lookup_cpty



select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_exec_symbol


if @suppress_trade = "N"
begin

	if @deal_id = NULL
	begin
		select
			msg = "Creating new deal"
		
		select
			@deal_status_id = status_id
		from
			statuses
		where
			name = "User Review"
		if @deal_status_id = NULL
		begin
			select
				status = "Error",
				message = "No status found named, 'User Review'"
			return
		end
		select
			@deal_type_id = deal_type_id
		from
			deal_types
		where
			name = @deal_type
		if @deal_type_id = NULL
		begin
			select
				status = "Error",
				message = "No deal type found for @deal_type",
				deal_type = @deal_type
			return	
		end
	
		exec
			j_nextkey
				"deals",
				@deal_id output
	
		insert into
			deals(
				deal_id,   
				deal_type_id,
				timestamp,  
				status_id  
		 		)      
			values( 
				@deal_id,
				@deal_type_id,
				getdate(),
				@deal_status_id
				)
    	
    	insert into
			deal_exec_symbols
		values(
			@deal_id,
			@deal_exec_symbol
    	)
	end
	else
	begin
		select
			msg = "Appending to existing deal"
	
		/*  Below to support management of deal_type. 
	    	This tally is currently purposed for B2B deals. This will be inserted B2B */	
		/*
        	select
                	@deal_type_id = deal_type_id
        	from
                	deal_types
        	where
                	name = 'B2B Forward'
        	if @deal_type_id = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "No deal type found for 'B2B Forward'"
                	return
        	end
	
		update
			deals
		set
			deal_type_id = @deal_type_id
		where
			deal_id = @deal_id
		*/
	end
end    	

if @suppress_trade = "Y"
begin
exec
        fxa_suppresstrade
                @login = @default_login,
                @source = @source,
                @suppressed_trade_id = @suppressed_trade_id out,
                @deal_id = @suppressed_deal_id out,
                @deal_identifier = @deal_exec_symbol,
                @tally_type = @trade_type,
                @deal_type = @deal_type,
                @trade_type = @trade_type,
                @external_account = @external_account,
                @counterparty = @counterparty,
                @quantity = @qty1,
                @symbol = @symbol,
                @value_date = @value_date,
                @price = @price,
                @trade_date = @trade_date,
                @trader = @trader,
                @broker = @broker,
                @identifier = @trade_identifier,
                @spot_reference = @price        

	if @suppressed_trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to suppress trade"
        end
        select
                status = "Suppressed",
                message = "Trade successfully suppressed",
                trade_id = @suppressed_trade_id,
                deal_id = @suppressed_deal_id,
                account = @external_account,
                symbol = @symbol,
                side = @side,
                quantity = @qty1,
                price = @price,
                val_date = @value_date

	/*
 	* Acknoweldge this trade report
 	*/

	select
    		trade_report_id=@trade_report_id,
    		exec_type = @exec_type,
    		symbol="NA"

        return
end
else
begin

	exec
		fxa_tallytrade
			@login = @trader_login,
			@source = @source,
			@trade_id = @trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @trade_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@quantity = @qty1,
			@symbol = @symbol,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @trader,
			@broker = @broker,
			@identifier = @trade_identifier,
			@spot_reference = @last_spot_rate
	
	if @trade_id = NULL
	begin
		select
			status = "Error",
			message = "Failed to tally trade"
		return
	end
	

	insert into
		trade_quoted_prices (	trade_id,
					price)
		values(
			@trade_id,
			@quoted_price
			)

	exec
		r_inserttradenotification
				@trade_id
end


/* 
 * AUTOCOMMIT
 *
 * If there is a client trade in this deal and the account type is set for
 * Autocommit, then push through this deal automatically.
 */
if @deal_id != NULL and @aggregation_style = "Autocommit"
begin

    update
        deals
    set
        status_id = @committed_status_id
    where
        deal_id = @deal_id
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    end
end
else
begin
    select
        message = "No autocommitted",
        deal_id = @deal_id,
        trade_id = @trade_id,
        aggregation_style = @aggregation_style
end

select
	status = "Tallied",
	message = "Trade successfully tallied",
    	trade_id = @trade_id,
    	deal_id = @deal_id,
	account = @external_account,
	trader = @trader,
	counterparty = @counterparty,
	symbol = @symbol,
	side = @side,
	quantity = @qty1,
	price = @price,
	val_date = @value_date

/*
 * Acknoweldge this trade report
 */


select
    trade_report_id=@trade_report_id,
    exec_type = @exec_type,
    symbol="NA"

go
