
create or replace procedure
	r_runopslink
		@login varchar(50),
		@op_task varchar(255)
as

if @op_task = "View Option Model Parameters"
begin
	exec
		r_options
	return
end

if @op_task = "Run Expiration Tool"
begin
	exec
		r_expirytimesfordate
			@login
	return

 end

if @op_task = "Option Expiration Calendar"
begin
	exec
		ag_optioncalendar
			@login
end

if @op_task = "Edit Current Prices"
begin
	exec
		r_currentprices
			@login
	return
end

if @op_task = "Edit Settle Prices"
begin
	exec
		cl_currentsettles
 	        @login,
	        NULL
end

if @op_task = "Link Unhedged Deals"
begin
        exec
                r_unhedgeddeals
                        @login,
                        NULL,
			NULL
end


if @op_task = "Assign Trades"
begin
	exec
		r_assigntrades
			@login,
 			NULL,
			NULL
end

if @op_task = "Recon Blotters"
begin
	exec
		r_reconblotters
			@login
end

if @op_task = "Manage UPI Codes"
begin
        exec
                r_manageupicodes
                        @login
end

/* 
if @op_task = "Align Settles"
begin
        exec
		r_crosscheckerlink                
                        @login
end
*/

go

