drop procedure r_fxcmreportableedit
go

create procedure
	r_fxcmreportableedit
		@login varchar(50),
		@trade_id int,
		@source varchar(50)

as

declare @source_id  int
declare @reportable char(1)
declare @notified char(1)


select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		msg = "Source not found",
		source = @source
	return
end

select
	@reportable = "Y"
from
	trades a,
	reg_reporting_ext_accounts b,
	trade_types c
where
	a.external_account_id = b.external_account_id
and
	a.trade_type_id = c.trade_type_id
and
	a.trade_id = @trade_id
and
	c.name not in("Option Exercise", "Option Closeout", "Spot")

if @reportable = "Y"
begin
	select
		@notified = "Y"
	from
		trade_notifications
	where
		source_id = @source_id
	and
		trade_id = @trade_id

	if @notified = "Y"
	begin
		exec
			r_tradeditsfortrade
				@login,
				@trade_id
	end
end

go
