	cm_chamberhome
go

create procedure
	cm_chamberhome
		@login varchar(50)
as


declare @fund_id int
declare @fund varchar(50)
declare @run_id int
declare @contract_id int
declare @contracts int
declare @most_recent datetime
declare @prev_entry datetime
declare @one_year datetime
declare @most_recent_qty numeric(30,4)
declare @prev_entry_qty numeric(30,4)
declare @one_year_qty numeric(30,4)
declare @month int
declare @day int
declare @year int
declare @indicator varchar(50)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"begin_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"run_name",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"perspective_contract",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"evaluate",
	"Evaluate Indicators",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"create_grouping",
	"New Grouping",
	NULL)

insert into
	#meta
values(
	"Column Link",
	"view_indicators",
	"Run Indicators",
	NULL)

insert into
	 #meta
values(
	 "Column Format",
	 "pct_change",
	 "Number",
	 "#,##0.00%")

insert into
	 #meta
values(
	 "Column Format",
	 "change",
	 "Number",
	 "#,##0.00")

insert into
	 #meta
values(
	 "Column Format",
	 "value",
	 "Number",
	 "#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"indicator",
	NULL,
	NULL)


select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@fund = name
from
	funds
where
	fund_id = @fund_id

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	a.name = @fund
and
	c.login = @login


if @run_id = NULL
begin
	select
		status = "Error",
		message = "No default run found"
	return
end

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#trades(
		trade_id int,
		contract_id int,
		trade_date datetime,
		external_account_id int,
		quantity numeric(30,4))

insert into
	#trades
select
	a.trade_id,
	a.contract_id,
	a.trade_date,
	a.external_account_id,
	a.quantity
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id


create table
	#categories(
		id int identity,
		indicator varchar(100) NULL,
		style varchar(200) NULL,
		description varchar(200) NULL,
		date datetime NULL,
		value float NULL,
		change float NULL,
		pct_change float NULL)
		

create table
	#output(
		id int identity,
		contract_id int,
		perspective_contract_id int NULL,
		most_recent datetime NULL,
		most_recent_qty numeric(30,4) NULL,
		prev_entry datetime NULL,
		prev_entry_qty numeric(30,4) NULL,
		one_year datetime NULL,
		one_year_qty numeric(30,4) NULL
		)
insert into
	#output(
		contract_id)
select
	distinct(contract_id)
from
	trades

update
	#output
set
	perspective_contract_id = contract_id

update
	#output
set
	a.perspective_contract_id = b.perspective_contract_id
from
	#output a,
	def_perspective_contracts b
where
	a.contract_id = b.contract_id

create table
	#pp_contracts(
		contract_id int)

insert into
	#pp_contracts(
		contract_id)
select
	distinct(perspective_contract_id)
from
	#output


create table
	#contracts(
		contract_id int)

select
	@contract_id = 0
select
	@contracts = count(*)
from
	#pp_contracts
where
	contract_id > @contract_id

while @contracts > 0
begin
	select
		@contract_id = min(contract_id)
	from
		#pp_contracts
	where
		contract_id > @contract_id


	delete

	from
		#contracts
	where
		contract_id > 0

	insert into
		#contracts
	select
		contract_id
	from
		#output
	where
		perspective_contract_id = @contract_id

	select
		@indicator = a.name
	from
		products a,
		forwards b
	where
		a.product_id = b.product_id
	and
		b.contract_id = @contract_id

	select
		@most_recent = NULL,
		@most_recent_qty = NULL,
		@prev_entry = NULL,
		@prev_entry_qty = NULL,
		@one_year = NULL,
		@one_year_qty = NULL
		

	select
		@most_recent = max(a.trade_date)
	from
		#trades a,
		#contracts b
	where
		a.contract_id = b.contract_id

	select
		@most_recent_qty = sum(quantity)
	from
		#trades a,
		#contracts b
	where
		a.contract_id = b.contract_id
	and
		a.trade_date = @most_recent

	select
		@prev_entry = max(a.trade_date)
	from
		#trades a,
		#contracts b
	where
		a.contract_id = b.contract_id
	and
		a.trade_date < @most_recent

	select
		@prev_entry_qty = sum(a.quantity)
	from
		#trades a,
		#contracts b
	where
		a.contract_id = b.contract_id
	and
		a.trade_date = @prev_entry

	select
		@day = datepart(day, @most_recent),
		@month = datepart(month, @most_recent),
		@year = datepart(year, @most_recent) - 1

	select
		@one_year = max(a.trade_date)
	from
		#trades a,
		#contracts b
	where
		a.contract_id = b.contract_id
	and
		datepart(month, a.trade_date) = @month
	and
		datepart(year, a.trade_date)  = @year

	select
		@one_year_qty = sum(a.quantity)
	from
		#trades a,
		#contracts b
	where
		a.contract_id = b.contract_id
	and
		a.trade_date = @one_year

	update
		#output
	set
		most_recent = @most_recent,
		most_recent_qty = @most_recent_qty,
		prev_entry = @prev_entry,
		prev_entry_qty = @prev_entry_qty,
		one_year = @one_year,
		one_year_qty = @one_year_qty
	where
		contract_id = @contract_id
	if @most_recent_qty = 0.0
		select
			@most_recent_qty = NULL


	insert into
		#categories(
			indicator,
			style,
			description,
			date,
			value)
	values(
		@indicator,
		"background:#FFFFFF;border: 1px solid white",
		"Most Recent Entry",
		@most_recent,
		@most_recent_qty)
		
	insert into
		#categories(
			indicator,
			style,
			description,
			date,
			value,
			change,
			pct_change)
	values(
		@indicator,
		"background:#FFFFFF;border: 1px solid white",
		"Previous Entry",
		@prev_entry,
		@prev_entry_qty,
		@most_recent_qty - @prev_entry_qty,
		(@most_recent_qty - @prev_entry_qty) / @most_recent_qty
		)
		

	insert into
		#categories(
			indicator,
			style,
			description,
			date,
			value,
			change,
			pct_change)
	values(
		@indicator,
		"background:#FFFFFF;border: 1px solid white",
		"Previous Year",
		@one_year,
		@one_year_qty,
		@most_recent_qty - @one_year_qty,
		(@most_recent_qty - @one_year_qty) / @most_recent_qty)



	select
		@contracts = count(*)
	from
		#pp_contracts
	where
		contract_id > @contract_id

end
	

