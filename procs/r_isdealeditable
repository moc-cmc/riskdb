drop procedure
	r_isdealeditable
go

create procedure
		r_isdealeditable @deal_id int as

declare @last_commit_date datetime
declare @trade_date datetime
declare @commit_transaction_type int

select
	@commit_transaction_type=transaction_type_id
from
	transaction_types
where
	name="Front Office Commit"

if(@@rowcount != 1)
begin
	return -1
end

select
	@trade_date=max(trade_date)
from
	trades
where
	deal_id=@deal_id

select
	@last_commit_date = transaction_date
from
	int_account_transactions
where
	transaction_type_id=@commit_transaction_type

if(@last_commit_date > @trade_date)
begin
	return -1
end
else
begin
	return 0
end

go


