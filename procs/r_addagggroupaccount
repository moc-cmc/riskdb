drop procedure r_addagggroupaccount
go

create procedure
	r_addagggroupaccount
		@login varchar(50),
		@agg_group varchar(50),
		@external_account varchar(50)

as

declare @agg_group_id int
declare @external_account_id int

select
	@agg_group_id = agg_group_id
from
	agg_groups
where
	name=@agg_group
if @agg_group_id = NULL
begin
	select
		error="Error",
		msg="Agg group not found", @agg_group
	return
end

select
        @external_account_id = external_account_id
from
        external_accounts
where
        symbol=@external_account
if @external_account_id = NULL
begin
        select
                error="Error",
                msg="external_account not found", @external_account
        return
end


insert into
	agg_group_accounts(
		agg_group_id,
		external_account_id)
values(
	@agg_group_id,
	@external_account_id
)
if @@rowcount != 1
begin
	select
		status = "Error adding account to aggregation group",
		agg_group = @agg_group,
		external_account = @external_account
	return
end

select
	status = "Successfully created added account to aggregation group",
	agg_group = @agg_group,
	external_account = @external_account


go

	
