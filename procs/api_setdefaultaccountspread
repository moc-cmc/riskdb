create or replace procedure
	 api_setdefaultaccountspread
		@login varchar(50),
		@contract varchar(50),
		@name varchar(50),
		@pips float=NULL

as

declare @tico_account_id int
declare @contract_id int
declare @account_spread_id int
declare @inverted char(1)
declare @product_id int
declare @currency_id int
declare @standard_contract_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @contract
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Problem determining contract"
	return
end

select
	@product_id = b.product_id,
	@currency_id = b.currency_id
from
	contracts a,
	forwards b
where
	a.contract_id = b.contract_id

select
	@inverted = "Y"
from
	contracts a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
and
	a.contract_id = @contract_id
if @inverted = "Y"
begin
	select
		status = "Error",
		message = "Can not set spread for inverted contract"
	return
end

select
	@account_spread_id = account_spread_id
from
	default_account_spreads 
where
	contract_id = @contract_id


update
	default_account_spreads
set
	contract_id = @contract_id,
	pips = @pips,
	name = @name
where
	account_spread_id = @account_spread_id
if @@rowcount = 0
begin
	exec
		j_nextkey
			"default_account_spreads",
			@account_spread_id output
	insert into
		default_account_spreads(
			account_spread_id,
			contract_id,
			pips,
			name)
	values(
		@account_spread_id,
		@contract_id,
		@pips,
		@name
	)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Error inserting row for default_account_spreads"
		return
	end
end

go
