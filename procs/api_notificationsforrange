create or replace procedure
	api_notificationsforrange
		@login varchar(50),
		@source varchar(50)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@threshold_override int=NULL

as

declare @tico_account_id int
declare @placeholder_date datetime
declare @min_trade_id int
declare @max_trade_id int
declare @swap_far_trade_type_id int

declare @total_pending int
declare @total_new int
declare @total_modify int
declare @total_cancel int
declare @total_sent int
declare @total_other int
declare @total_total int
declare @total_stale int

declare @sent_status_id int
declare @now datetime

declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @client_style varchar(200)

select
	@now = getdate()

select
   @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
   @subtotal_style = "background:#FAF7ED;border: 1px solid white;",
   @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
   @style = "background:#FFFFFF;border: 1px solid white",
   @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
   @client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status="Error",
		message="Problem finding account for login"
	return
end


if @begin_date = NULL 
begin
	select
		@begin_date = getdate()
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@placeholder_date output

	exec
		r_daterangefordate
			@end_date,
			@placeholder_date output,
			@end_date output
end

select
	@swap_far_trade_type_id = trade_type_id
from
	trade_types
where
	name = "Swap Far"
if @swap_far_trade_type_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding 'Swap Far' trade type"
	return
end


select
	@sent_status_id = status_id
from
	statuses
where
	name = "Sent"
if @sent_status_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding 'Sent' status"
	return
end

create table
	#sources(
		source_id int,
		name varchar(50)
)

if @source != NULL
begin
	insert into
		#sources
	select
		a.source_id,
		a.name
	from
		sources a,
		source_types b
	where
		a.source_type_id = b.source_type_id
	and
		b.name = "Outbound"
	and
		a.name = @source
	if @@rowcount = 0
	begin
		select
			status = "Error",
			message = "Problem finding outbound source",
			source = @source
		return
	end
end
else
begin
	insert into
		#sources
	select
		a.source_id,
		a.name
	from
		sources a,
		source_types b
	where
		a.source_type_id = b.source_type_id
	and
		b.name = "Outbound"
end

create table
	#outbound_connections(
		connection_id int,
		source_id int,
		source_name varchar(50),
		connection_name varchar(50),
		ops_name varchar(50),
		integration_name varchar(50),
		stale_threshold int NULL,
		stale_datetime datetime NULL,
		format_swaps char(1) NULL
)

insert into
	#outbound_connections(
		connection_id,
		source_id,
		source_name,
		connection_name,
		ops_name,
		integration_name,
		stale_threshold,
		stale_datetime,
		format_swaps)
select
	b.connection_id,
	a.source_id,
	a.name,
	b.name,
	b.ops_name,
	c.name,
	b.stale_threshold,
        dateadd(ss, b.stale_threshold * -1, getdate()),
	c.format_swaps
from
	#sources a,
	connections b,
	integrations c
where
	a.source_id = b.source_id
and
	b.integration_id = c.integration_id

update
	#outbound_connections
set
	stale_threshold = 600
where
	stale_threshold = NULL


if @threshold_override != NULL
begin
	update
		#outbound_connections
	set
		stale_threshold = @threshold_override
end
	
create table
	#trades(
		trade_id int,
		trade_type_id int,
		external_account_id int,
		broker_id int,
		trader_id int,
		counterparty_id int,
		status_id int,
		is_far_trade char(1) NULL,
		deal_id int,
		quantity numeric(30, 8),
		contract_id int,
		value_date datetime NULL,
		fixing_date datetime NULL,
		price float NULL,
		trade_date datetime NULL,
		identifier varchar(100) NULL
)

insert into
	#trades(
		trade_id,
		trade_type_id,
		external_account_id,
		broker_id,
		trader_id,
		counterparty_id,
		status_id,
		is_far_trade,
		deal_id,
		quantity,
		contract_id,
		value_date,
		fixing_date,
		price,
		trade_date,
		identifier)
select
	trade_id,
	trade_type_id,
	external_account_id,
	broker_id,
	trader_id,
	counterparty_id,
	status_id,
	case when trade_type_id = @swap_far_trade_type_id then "Y" else "N" end,
	deal_id,
	quantity,
	contract_id,
	value_date,
	fixing_date,
	price,
	trade_date,
	identifier
from
	trades
where
	trade_date >= @begin_date
and
	trade_date < @end_date


select
	@min_trade_id = min(trade_id),
	@max_trade_id = max(trade_id)
from
	#trades

create nonclustered index
	n_tt
on
	#trades(trade_type_id)


create table
	#notification_summary(
		id int identity,
		connection_id int,
		source_id int,
		status_id int,
		is_far_trade char(1) NULL,
		notification_count int,
		far_count int NULL,
		total_count int NULL,
		stale_count int NULL,
)


insert into
	#notification_summary(
		connection_id,
		source_id,
		status_id,
		notification_count,
		far_count,
		total_count,
		stale_count)
select
	a.connection_id,
	b.source_id,
	b.status_id,
	notification_count = count(case when a.format_swaps = "N" and c.is_far_trade = "Y" then NULL else 1 end),
	far_count = count(case when a.format_swaps = "N" and c.is_far_trade = "Y" then 1 else NULL end),
	total_count = count(*),
	stale_count = count(
			case 
				when a.format_swaps = "N" and c.is_far_trade = "Y" then NULL  /*ignore the far count */
				when b.capture_date <= a.stale_datetime and b.status_id != @sent_status_id then 1 
				else NULL
			end
	)
from
	#outbound_connections a,
	trade_notifications b,
	#trades c
where
	a.source_id = b.source_id
and
	b.trade_id = c.trade_id
and
	b.trade_id >= @min_trade_id
and
	b.trade_id <= @max_trade_id
group by
	a.connection_id,
	b.source_id, 
	b.status_id


create table
	#suspect_source_statuses(
		source_id int,
		status_id int
)

insert into
	#suspect_source_statuses(
		source_id,
		status_id)
select
	source_id,
	status_id
from
	#notification_summary
where
	stale_count > 0

create table
	#suspect_sources(
		source_id int,
		name varchar(50)
)

insert into
	#suspect_sources
select
	a.source_id,
	a.name
from
	sources a,
	#suspect_source_statuses b
where
	a.source_id = b.source_id

create table
	#suspect_notifications(
		trade_notification_id int,
		trade_id int,
		source_id int,
		status_id int,
		capture_date datetime
)

insert into
	#suspect_notifications
select
	a.trade_notification_id,
	a.trade_id,
	a.source_id,
	a.status_id,
	a.capture_date
from
	trade_notifications a,
	#suspect_source_statuses b,
	#outbound_connections c,
	#trades d
where
	a.status_id = b.status_id
and
	a.source_id = b.source_id
and
	b.source_id = c.source_id
and
	d.trade_id =  a.trade_id
and
	a.capture_date <= c.stale_datetime
and
        a.trade_id >= @min_trade_id
and
        a.trade_id <= @max_trade_id
and
(
	c.format_swaps = "Y" and d.is_far_trade = "N" and a.capture_date <= c.stale_datetime
or
	c.format_swaps = "N" and d.is_far_trade = "N" 

)



	
create table
	#summary(
		id int identity,
		ordering int NULL,
		connection_id int NULL,
		pending_count int NULL,
		new_count int NULL,
		modify_count int NULL,
		cancel_count int NULL,
		sent_count int NULL,
		other_count int NULL,
		total_count int NULL,
		stale_count int NULL
)
insert into 
	#summary(
		ordering,
		connection_id,
		pending_count) /* TODO: change this from default 0 to use trade_notifier evaluation */
select
	1,
	connection_id,
	0
from
	#outbound_connections


select
        a.connection_id as connection_id,
        sum(a.stale_count) as notification_count
into
        #stale_counts
from
        #notification_summary a
group by
        a.connection_id

select 
	a.connection_id as connection_id, 
	sum(a.notification_count) as notification_count
into 
	#new_counts
from
	#notification_summary a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Active"
group by
	a.connection_id

select 
	a.connection_id as connection_id, 
	sum(a.notification_count) as notification_count
into 
	#modify_counts
from
	#notification_summary a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Edit"
group by
	a.connection_id

select 
	a.connection_id as connection_id, 
	sum(a.notification_count) as notification_count
into 
	#cancel_counts
from
	#notification_summary a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Cancelled"
group by
	a.connection_id


select 
	a.connection_id as connection_id, 
	sum(a.notification_count) as notification_count
into 
	#sent_counts
from
	#notification_summary a,
	statuses b
where
	a.status_id = b.status_id
and
	b.name = "Sent"
group by
	a.connection_id

select 
	a.connection_id as connection_id, 
        sum(a.notification_count) as notification_count
into 
	#total_counts
from
	#notification_summary a
group by
	a.connection_id


update
        #summary
set
        stale_count = b.notification_count
from
        #summary a,
        #stale_counts b
where
        a.connection_id = b.connection_id


update
	#summary 
set
	new_count = b.notification_count
from
	#summary a,
	#new_counts b
where
	a.connection_id = b.connection_id

update
	#summary 
set
	modify_count = b.notification_count
from
	#summary a,
	#modify_counts b
where
	a.connection_id = b.connection_id

update
	#summary 
set
	cancel_count = b.notification_count
from
	#summary a,
	#cancel_counts b
where
	a.connection_id = b.connection_id

update
	#summary 
set
	sent_count = b.notification_count
from
	#summary a,
	#sent_counts b
where
	a.connection_id = b.connection_id

update
	#summary 
set
	total_count = b.notification_count
from
	#summary a,
	#total_counts b
where
	a.connection_id = b.connection_id

update
	#summary
set
	other_count = a.total_count - a.pending_count + a.new_count + a.modify_count + a.cancel_count + a.sent_count
from
	#summary a

update
	#summary
set
	pending_count = 0
where
	pending_count = NULL

update
	#summary
set
	new_count = 0
where
	new_count = NULL

update
	#summary
set
	modify_count = 0
where
	modify_count = NULL

update
	#summary
set
	cancel_count = 0
where
	cancel_count = NULL

update
	#summary
set
	sent_count = 0
where
	sent_count = NULL

update
	#summary
set
	other_count = 0
where
	other_count = NULL

update
	#summary
set
	total_count = 0
where
	total_count = NULL

update
        #summary
set
        stale_count = 0
where
        stale_count = NULL


select
	@total_pending = sum(pending_count),
	@total_new = sum(new_count),
	@total_modify = sum(modify_count),
	@total_cancel = sum(cancel_count),
	@total_sent = sum(sent_count),
	@total_other = sum(other_count),
	@total_total = sum(total_count),
	@total_stale = sum(stale_count)
from
	#summary


insert into 
	#summary(
		ordering,
		pending_count,
		new_count,
		modify_count,
		cancel_count,
		sent_count,
		other_count,
		total_count,
		stale_count)
values(
	2,
	@total_pending,
	@total_new,
	@total_modify,
	@total_cancel,
	@total_sent,
	@total_other,
	@total_total,
	@total_stale
)





select
	section = "Notification Summary",
	/*a.connection_id,*/
	source_name = case when b.source_name = null then "Total" else b.source_name end,
	b.ops_name,
	a.pending_count,
	a.new_count,
	a.modify_count,
	a.cancel_count,
	a.sent_count,
	a.other_count,
	a.total_count,
	a.stale_count,
	style = case when b.source_id = null then @total_style when a.stale_count > 0 then @error_style else @style end
from
	#summary a,
	#outbound_connections b
where
	a.connection_id *= b.connection_id   /* left outer join */
order by
	ordering DESC,
	source_name


select
	section = "Suspect Trades",
        a.trade_notification_id,
        a.trade_id,
	source = i.name,
        a.status_id,
        a.capture_date,
        b.deal_id,
	account = c.symbol,
	trader = g.symbol,
	broker = d.symbol,
	counterparty = e.name,
	status = f.name,
	contract = h.symbol,
        b.quantity,
        b.price,
        b.value_date,
        b.fixing_date,
        b.trade_date,
        b.identifier,
	resend_as = "RESEND AS",
	style = @style
from
	#suspect_notifications a,
	#trades b,
	external_accounts c,
	brokers d,
	counterparties e,
	statuses f,
	traders g,
	contracts h,
	#suspect_sources i
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.broker_id = d.broker_id
and
	b.counterparty_id = e.counterparty_id
and
	b.status_id = f.status_id
and
	b.trader_id = g.trader_id
and
	b.contract_id = h.contract_id
and
	a.source_id = i.source_id



go

	

		











