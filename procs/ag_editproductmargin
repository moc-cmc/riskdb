
drop procedure
	ag_editproductmargin
go

create procedure
	ag_editproductmargin
		@login varchar(50),
		@prime_broker varchar(50),
		@product varchar(50),
		@margin float
as

declare @product_id int
declare @prime_broker_id int
declare @tico_account_id int

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@prime_broker_id = a.prime_broker_id
from
	prime_brokers a,
	sources b
where
	a.source_id = b.source_id
and
	b.name = @prime_broker
if @prime_broker_id = NULL
begin
	select
		status = "Error",
		message = "Prime broker not found",
		prime_broker = @prime_broker
	return
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

insert into
	product_margin_edits
select
	tico_account_id = @tico_account_id,
	timestamp = getdate(),
	product_id,
	margin,
	prime_broker_id
from
	product_margins
where
	product_id = @product_id
and
	prime_broker_id = @prime_broker_id

update
	product_margins
set
	margin = @margin
where
	product_id = @product_id
and
	prime_broker_id = @prime_broker_id
if @@rowcount = 0
begin
	insert into
		product_margins(
			product_id,
			margin,
			prime_broker_id)
	values(
		@product_id,
		@margin,
		@prime_broker_id)
end


exec
	ag_margins
		@login,
		@prime_broker

go

