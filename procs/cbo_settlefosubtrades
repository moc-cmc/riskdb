create or replace procedure
	cbo_settlefosubtrades
                @login varchar(50),
                @trade_date datetime


as

declare @legal_entity varchar(100)
declare @fo_sub_account varchar(50)
declare @id int
declare @ids int

create table
	#settle_accounts(
		id int identity,
		fo_sub_account_id int,
		fo_sub_account varchar(50) NULL,
		bo_master_account_id int NULL,
		legal_entity_id int NULL,
		legal_entity varchar(50) NULL)


insert into
	#settle_accounts(
		fo_sub_account_id,
		fo_sub_account,
		bo_master_account_id)
select
	fo_sub_account_id = a.fo_sub_account_id,
	fo_sub_account = b.symbol,
	bo_master_account_id = a.bo_master_account_id
from
	fo_sub_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#settle_accounts
set
	legal_entity_id = b.legal_entity_id,
	legal_entity = b.name
from
	#settle_accounts a,
	legal_entities b,
	bo_master_accounts c
where
	a.bo_master_account_id = c.bo_master_account_id
and
	b.legal_entity_id = c.legal_entity_id
	
select
	@id = 0
select
	@ids = count(*)
from
	#settle_accounts
where
	id > @id

while @ids > 0
begin

	select
		@id = min(id)
	from
		#settle_accounts
	where
		id > @id

        select
                @legal_entity = NULL,
                @fo_sub_account = NULL

	select
		@legal_entity = legal_entity,
		@fo_sub_account = fo_sub_account
	from
		#settle_accounts
	where
		id = @id

	exec
        	bn_settlefosubtrades
                	@login=@login,
                	@legal_entity=@legal_entity,
                	@fo_sub_account=@fo_sub_account,
                	@trade_date=@trade_date,
			@show_output="N"

	select
		@ids = count(*)
	from
		#settle_accounts
	where
		id > @id
end

go	
