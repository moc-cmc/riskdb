drop procedure
	cbo_committedfees
go

create procedure
	cbo_committedfees
		@login char(100)
as

declare @enabled_product_features varchar(50)

select
        @enabled_product_features = name
from
        enabled_product_features
where
        name in("Fee Scheduling")
if @@rowcount != 1
begin
        select
                run_name = "<b>Fee Scheduling</b>" + " must be enabled to view this report. Please contact " + '<a href="mailto:sales@elysiumtechgroup.com">' + 'sales@elysiumtechgroup.com</a>'  + " for more informa
 tion regarding feature set."
        return
end


create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)


insert into
	#links
values(
	"Column Link",
	"run_name",
	"Run Committed Fees",
	NULL,
	NULL)


select * from #links

select
	run_name = a.name
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
order by
	a.name

go

