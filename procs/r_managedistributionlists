create procedure
	r_managedistributionlists
			@login varchar(50)

as

declare @dist_list_id int
declare @email_count int




create table
	#dist_lists
(
	dist_list_id int,
	name varchar(150),
	email_count int NULL
)

insert into
	#dist_lists
select
	a.dist_list_id,
	a.name,
	NULL
from
        dist_lists a

declare email_count_cursor cursor for
	select
		dist_list_id
	from
		#dist_lists
	order by dist_list_id

open email_count_cursor
fetch email_count_cursor into @dist_list_id

while (@@sqlstatus = 0)
begin
	select
		@email_count = 0

	select
		@email_count = count(*)
	from
		dist_list_emails
	where
		dist_list_id = @dist_list_id


        begin tran
		update
			#dist_lists
		set
			email_count = @email_count
		where
			dist_list_id = @dist_list_id
		if @@rowcount != 1
		begin
			select
				id = -1,
				msg = "Problem updating single row in #dist_lists"
			rollback tran
		end
	commit tran

	select @dist_list_id = NULL
	fetch email_count_cursor into @dist_list_id
end

close email_count_cursor
deallocate email_count_cursor

update 
	#dist_lists
set
	email_count = 0
where
	email_count = NULL


create table
    #meta (
        meta_type char(50),
        name char(50) NULL,
