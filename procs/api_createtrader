
create or replace procedure
	api_createtrader
		@login varchar(30),
		@trader varchar(50),
		@external_account varchar(50),
		@trader_type varchar(50),
		@trader_login varchar(50)=NULL,
		@trader_password varchar(50)=NULL,
		@sales_code varchar(50)=NULL,
		@first_name varchar(50)=NULL,
		@last_name varchar(50)=NULL,
		@email varchar(50)=NULL
as


declare @did_create_trader char(1)
declare @trader_id int
declare @tico_account_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)
declare @sales_code_id int
declare @external_account_id int
declare @external_account_type varchar(50)
declare @is_fund_agency_trader char(3)
declare @login_type varchar(50)
declare @random_password varchar(8)
declare @user_name_output varchar(25)
declare @fund_id int
declare @fund_name varchar(50)
declare @fund_agency_counterparty varchar(50)
declare @broker varchar(50)
declare @broker_id int
declare @strategy varchar(50)
declare @top_level_trader varchar(50)
declare @top_level_trader_login varchar(50)
declare	@user_name_output_id int
declare @ext_acct_run_id int
declare @blotter_view_style_id int
declare @fund_code varchar(10)
declare @etg_login_suffix varchar(10)

exec
                r_defaultfundforlogin
                        @login,
                        @fund_id output

select
	@fund_code = fund_code
from
	funds
where
	fund_id = @fund_id


select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 0
begin
	select
		status = "Dupe",
		message = "Trader already exists",
		trader = @trader
	return
end

if @trader_type not in("Client", "Desk")
begin
	select
		status = "Error",
		msg = "Must provide trader type as either 'Client' or 'Desk'"
	return
end

if @trader_password = NULL
begin
	exec
        	r_genrandompassword
                	@pass_length=8,
                	@new_pass=@random_password output

end

if @trader_type = "Desk"
begin
	select
		@login_type = "Standard"

	/* We only create a login if the first name, last name, and email have been provided */
        if @first_name != NULL and @last_name != NULL and @email != NULL
	begin
		exec
			api_createlogin
				@login=@login,
				@first_name=@first_name,
				@last_name=@last_name,
				@email=@email,
				@user_password=@random_password,
				@login_type=@login_type,
				@user_name_output=@user_name_output output
					
	end
	select 
		@is_fund_agency_trader = "Yes"

end
else /* trader_login = "Client" */
begin
	/* We know with every account there is a top level trader created with the same name. Assign that login for new top level trader */

	select
        	@top_level_trader = @external_account

	select
        	@top_level_trader_login = b.login,
		@user_name_output = b.login 
	from
        	traders a,
        	tico_accounts b
	where
        	a.tico_account_id = b.account_id
	and
        	a.symbol = @top_level_trader
	
	/* If @trader_login NULL, we know that a top level trader still needs to be created */
	if @top_level_trader_login = NULL
	begin
		/* We know this is the top level trader */
		select
			@login_type = "Client"

		exec
                        api_createlogin
                                @login=@login,
                                @first_name=@external_account,
                                @last_name=@external_account,
                                @email=@email,
                                @user_password=@random_password,
                                @login_type=@login_type,
                                @user_name_output=@user_name_output output


        	select
                	@is_fund_agency_trader = "No"

		select
			@user_name_output_id = account_id
		from
			tico_accounts
		where
			login = @user_name_output
	end
end

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @user_name_output
if @tico_account_id = NULL
begin
        /* For a group trader (ie, the first trader created in the deployment tool)
           we don't create a login, but we want to assign the tico_account_id to the
           etg login, which should be lower(fund_code)+lower(suffix) for login type
           elysium
        */
	select
		@etg_login_suffix = suffix
	from	
		login_types
	where
		name = "Elysium"
	
	if @is_fund_agency_trader = "Yes" and @trader = rtrim(lower(@fund_code))+"group"
	begin
		select
			@tico_account_id = account_id
		from
			tico_accounts
		where
			login = rtrim(lower(@fund_code))+lower(@etg_login_suffix)
		if @tico_account_id = NULL
		begin
			select
				@tico_account_id = 0
		end
	end
	else
	begin
		select 
			@tico_account_id = 0
	end
end

if @sales_code = NULL
begin
	select
		@sales_code = "None"
end

select
        @sales_code_id = sales_code_id
from
        sales_codes
where
        name = @sales_code
if @@rowcount != 1
begin
        exec
                j_nextkey
                        "sales_codes",
                        @sales_code_id output

        insert into
                sales_codes
        values(
                @sales_code_id,
                @sales_code)
end


select
	@external_account_id = a.external_account_id,
	@external_account_type = b.name
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	a.symbol = @external_account
if @@rowcount != 1
begin
	select
		status= "Error",
		message = "External account not found",
		external_account = @external_account
	return
end

/* This is a top level trader for a client account */
if @user_name_output_id != NULL
begin
	select
		@ext_acct_run_id = run_id
	from
		runs
	where
		name = @external_account	
	
	if @ext_acct_run_id != NULL
	begin
		insert into
			user_runs(
				tico_account_id,
				run_id)
		values(
			@user_name_output_id,
			@ext_acct_run_id
		)
	end
	select
		@blotter_view_style_id = blotter_view_style_id
	from
		blotter_view_styles
	where
		name = "Notification Alias View"
	if @blotter_view_style_id != NULL
	begin
		insert into
			client_login_configs(
				tico_account_id,
				run_id,
				blotter_view_style_id)
		values(
			@user_name_output_id,
			@ext_acct_run_id,
			@blotter_view_style_id)
	end
end

exec
	j_nextkey
		"traders",
		@trader_id output


insert into
	traders(
		trader_id,
		symbol,
		tico_account_id,
		default_strategy_id,
		external_account_id,
		sales_code_id)
values(
	@trader_id,
	@trader,
	@tico_account_id,
	1, /* Default strategy_id is a legacy field */
	@external_account_id,
	@sales_code_id)
if @@rowcount != 1
begin
	select
		status = "Error",
		msg = "Problem inserting trader"
	return
end


if @is_fund_agency_trader = "Yes"
begin
	insert into
		fund_agency_traders(
			fund_id,
			trader_id
	)values(
		@fund_id,
		@trader_id
	)
end

/* Add tally defaults if neccessary */

if @top_level_trader_login = NULL
begin
	
	/* Get variables for tally defaults */
	/* We know this is a top level trader or desk trader */
	
	select
        	@fund_name = name
	from
        	funds
	where
        	fund_id = @fund_id
	
	select
        	@strategy = name
	from
        	strategies
	where
        	name = "Agency"
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	message = "Strategy not found",
                	strategy = @strategy
        	return
	end
	
	select
        	@broker = symbol
	from
        	brokers
	where
        	symbol = "MPT Tally"
	if @@rowcount != 1
	begin
		select
			@broker = "MPT Tally"

		exec
			j_nextkey
				"brokers",
				@broker_id output
		insert into
			brokers(
				broker_id,
				symbol,
				source_id)
		values(
			@broker_id,
			"MPT Tally",
			0
		)
	end
	
	
	select
        	@fund_agency_counterparty = b.name
	from
        	fund_agency_counterparties a,
        	counterparties b
	where
        	a.counterparty_id = b.counterparty_id
	
	/* Add tally defaults */
        exec
                api_addtallydefaults
                        @login,
                        @user_name_output,
                        "Swap",
                        @fund_name,
                        @external_account,
                        @trader,
                        @strategy,
                        @broker,
                        @fund_agency_counterparty
end



/* This is a flush so that MPTracker Pulldowns are refreshed with new data */

select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds
where
	fund_id = @fund_id
select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string

/* End flush */

select
	@did_create_trader = "Y"
from
	traders
where
	symbol = @trader
if @did_create_trader = "Y"
begin
	select
		status = "Success",
		msg = "Trader created",
		trader = @trader
end
else
begin
	select
		status = "Error",
		msg = "Problem creating trader. Check data",
		trader = @trader
end


go 

