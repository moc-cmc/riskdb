

drop procedure
	api_editcpsymbol
go

create procedure
	api_editcpsymbol
			@login varchar(25),
			@name varchar(100),
			@source_name varchar(100),
			@mapping varchar(100),
			@new_mapping varchar(100)
as

declare @counterparty_id int
declare @source_id int

select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name=@name

if (@@rowcount !=1)
begin
	select
		status="Error",
		msg="Cannot find Counterparty",
		counterparty=@name
	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Source does not exist",
		source=@source_name
	return
end

begin tran
	update 
		counterparty_symbols
	set
		symbol=@new_mapping
	where
		counterparty_id=@counterparty_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount != 1)
	begin
		select
			status="Error",
			msg="Could not edit Counterparty Mapping",
			mapping=@mapping

		rollback tran
	
		return
	end

commit tran

select
	status="Success",
	msg="Counterparty Edited",
	name=@name

exec
	r_mappingoverview @login

return

go

