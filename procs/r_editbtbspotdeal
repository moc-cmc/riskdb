	a.deal_id=@deal_id and
	a.external_account_id=b.external_account_id and
	b.external_account_type_id=c.external_account_type_id and
	c.name="Counterparty"

if lower(convert(char(1), @client_buysell))  = "b"
begin
    select
        @client_quantity = abs(@quantity) * -1.0
end
else
begin
    select
        @client_quantity = abs(@quantity)
end

select
    @market_quantity = @client_quantity * -1.0

if(@quantity = 0)
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name="Cancelled"
end
else
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name="Edit"
end

begin tran

	update 
		trades
	set
		external_account_id=@client_external_account_id, 
		quantity=@client_quantity,
		contract_id=@contract_id,
		price=@client_price,
		trader_id=@client_trader_id
	where
		trade_id=@client_trade_id

