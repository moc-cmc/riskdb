use
	risk_finotec
go

drop procedure
	ag_addmarginoverride
go

create procedure
	ag_addmarginoverride
		@login varchar(50),
		@account varchar(50),
		@symbol varchar(50),
		@margin float,
		@as_of_date datetime
as

declare @external_account_id int
declare @contract_id int
declare @fund_id int
declare @account_margin_id int
declare @most_recent_commit datetime

	
select
	@most_recent_commit = max(reval_date)
from
	committed_daily_revals

if @as_of_date <= @most_recent_commit
begin
	select
		status = "Error",
		message = "P&L Commits before as of date, margin can not be added"
	return
end 

exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

update
	account_margins
set
	margin = @margin
where
	contract_id = @contract_id
and
	as_of_date = @as_of_date
and
	external_account_id = @external_account_id
if @@rowcount = 0
begin
	exec
		j_nextkey
			"account_margins",
			@account_margin_id output

	insert into
		account_margins
	values(
		@account_margin_id,
		@external_account_id,
		@contract_id,
		@margin,
		@as_of_date)
end


exec
	ag_margins
		@login

go


