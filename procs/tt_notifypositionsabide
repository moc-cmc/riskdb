begin
	/* set product id */
	update
        	#positions
	set
        	product_id = b.product_id,
        	currency_id = b.currency_id
	from
        	#positions a,
        	forwards b
	where
        	a.contract_id = b.contract_id

	/* get the eval ccy */	
	create table
        	#eval_ccys(
                	product_id int,
                	symbol varchar(10) NULL
	)
	insert into
        	#eval_ccys(
                	product_id)
	select
        	distinct(evaluation_currency_id)
	from
        	funds

	/* Find out what products have been traded */
	create table
		#traded_products(
			product_id int
	)
	
	insert into
		#traded_products
	select
		distinct(product_id)
	from
		#positions
	
	insert into 
		#traded_products
	select
		distinct(currency_id)
	from
		#positions
	where
		currency_id not in(select product_id from #traded_products)

	/* Get the conversion rated from traded products to eval ccy */	
	create table
		#conversion_contracts
	(
		contract_id int NULL,
		product_id int,
		currency_id int,
		inverse_contract_id int NULL,
		standard_price float NULL,
		conversion_price float NULL
	)
	
	insert into 
		#conversion_contracts(
			contract_id,
			product_id,
			currency_id
		)
	select
		a.contract_id,
		a.product_id,
		a.currency_id
	from
		forwards a,
		#traded_products b,
		#eval_ccys c
	where
		a.product_id = b.product_id
	and
		a.currency_id = c.product_id

	update
		#conversion_contracts
	set
		inverse_contract_id = a.contract_id
	from
		forwards a,
		#conversion_contracts b
	where
		a.product_id = b.currency_id
	and
		a.currency_id = b.product_id

	/* create temp table of current prices so price ticks dont affect conversion rates */
	create table
		#current_prices(
			contract_id int,
			price float
	)
	insert into
		#current_prices
	select
		contract_id,
		price
	from
		current_prices

	/* set conversion rates from current prices */	
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		#current_prices a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	#current_prices a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
		b.standard_price = NULL

	/* ensure a rate of 1.0 exists for the eval to eval conversion */
	insert into
		#conversion_contracts
	(
		product_id,
		currency_id,
		conversion_price
	)
	select
		product_id,
		product_id,
		1.0
	from
		#eval_ccys


	update 
		#positions
	set
		pd1_eq = quantity * conversion_price,
                vo_rate = conversion_price
	from
		#positions a,
		#conversion_contracts b
	where
		a.product_id = b.product_id
	
	update
        	#positions
	set
        	pd2_eq = (quantity * db_price * -1) * conversion_price
	from
        	#positions a,
        	#conversion_contracts b
	where
        	a.currency_id = b.product_id
	
	update
		#positions
	set
		vo = abs(pd1_eq)

end	

