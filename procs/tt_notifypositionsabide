/*
| Insert *_ids into #positions that need to be notified 
*/

insert into
	#positions
(	
	trade_type_id,
	internal_account_id,
	external_account_id,
	counterparty_id,
	contract_id,
	value_date,
	fixing_date,
	trader_id,
	strategy_id,
	broker_id,
	sales_code_id,
	quantity,
	trade_date,
	db_price,
	std_price,
	direction,
	abs_qty,
	abs_counter_qty,
	fund_agency_trade,
	cl_or_lp,
	trade_count
)
select 
	a.trade_type_id,
	a.internal_account_id,
	a.external_account_id,
	a.counterparty_id,
	a.contract_id,
	a.value_date,
	a.fixing_date,
	a.trader_id,
	a.strategy_id,
	a.broker_id,
	a.sales_code_id,
	sum(a.quantity),
	@trade_date,
	(sum(a.quantity * a.price)/sum(a.quantity)),
	(sum(a.quantity * a.price)/sum(a.quantity)),
	sign(quantity),
	sum(abs(quantity)),
	sum(round(abs(a.quantity) * a.price, 2)),
	"N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	"LP",
	count(*)
from
        trades a,
        trade_notifications b
where
        a.trade_id=b.trade_id
and
	b.source_id = @source_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date
group by
        trade_type_id,
        internal_account_id,
        external_account_id,
        counterparty_id,
        contract_id,
        value_date,
        fixing_date,
        trader_id,
        strategy_id,
        broker_id,
        sales_code_id,
	sign(quantity)



