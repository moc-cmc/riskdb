create procedure
	tt_notifypositionsabide
		@source varchar(50),
		@trade_date datetime=NULL,
		@query_options char(1)=NULL,
                @query_futures char(1)=NULL,
                @format_swaps char(1)=NULL,
		@format_ndf_swaps char(1)=NULL,
		@mark_to_market char(1)=NULL
		
as

declare @source_id int
declare @cancelled_count int
declare @traiana_id_prefix varchar(15)
declare @netlink_broker_id int
declare @boa_pb_id int
declare @usi_lookup varchar(15)

declare @begin_date datetime
declare @end_date datetime
declare @last_commit_date datetime


/* Report Type
   Trading capacity
   Collateralisation
   Asset class
   Compression
   Confirmation means
   Intragroup
   
*/

select
        @source_id = source_id
from
        sources
where
        name = @source
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Source not found",
                source = @source
        return
end

select
	@last_commit_date = max(a.commit_date)
from
	daily_commits a,
	commit_statuses b
where
	a.commit_status_id = b.commit_status_id
and
	b.name = "Commit Complete"


if @trade_date = NULL
begin
        /* runs on a 12pm-12pm schedule */
        select
                @trade_date = convert(date, getdate())
end

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output


if convert(date, @end_date) > convert(date, @last_commit_date)
begin
	return

	/*select 	
		error = "Error",
		msg = "Data is not committed for date, can not generate report",
		trade_date = convert(date, @trade_date)	,
		last_commit_date = @last_commit_date
	return
	*/
end

