/*
| Query trade_types
*/
update
	#positions
set
	trade_type = b.name
from
	#positions a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id

/* flagging CFD */
update
	#positions
set
	trade_type = "CFD"
from
	#positions a,
	contracts b
where
	a.contract_id = b.contract_id
and 
	b.symbol like ".%"
and
	b.contract_id not in(select contract_id from conversion_cfds)


update
	#positions
set
	trade_type = b.symbol
from
	#positions a,
	trade_type_symbols b
where
	a.trade_type_id = b.trade_type_id
and
	b.source_id = @source_id



