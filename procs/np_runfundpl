drop procedure
	np_runfundpl
go

create procedure
	np_runfundpl
		@login varchar(50),
		@date datetime=NULL
as

declare @fund varchar(50)
declare @fund_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@fund = name
from
	funds
where
	fund_id = @fund_id

if @date = NULL
	select
		@date = getdate()


exec
        np_runintradaypl
                @login,
		@fund,
		@date
		


go
