declare @closing_date datetime
declare @roll_date datetime
declare @net_dealt numeric(30,4)
declare @net_counter numeric(30,4)
declare @net_equiv numeric(30,4)
declare @lp_equiv numeric(30,4)
declare @client_equiv numeric(30,4)

