
if object_id("r_resolveinternalaccount") != NULL
    drop procedure
        r_resolveinternalaccount
go

create procedure
	r_resolveinternalaccount
        @login varchar(50) = NULL, /* caller */
        @source varchar(50) = NULL, /* on-behalf-of */
        
        @internal_account_id int = NULL out,
        
        @symbol varchar(50) = NULL out,
        @name varchar(100) = NULL out,
        @default_external_account_id int = NULL out,
        @default_external_account varchar(100) = NULL out,
        
        @create char(1) = NULL out,
        @report char(1) = NULL
as

/* messages */
declare @to varchar(50)
declare @issue varchar(250)
declare @subject varchar(250)
declare @content varchar(250)
declare @check_sql varchar(250)

declare @should_create char(1)
declare @source_id int

select
    @should_create = @create,
    @create = "N"
    
if @login = NULL or @source = NULL
begin
    if @report != "N"
        select
            status = "Error",
            message = "Login and source required",
            login = @login,
            source = @source
    raiserror 99001, "@login and @source required"
    return
end

if @internal_account_id = NULL
begin

    /* Lookup @internal_account_id by symbol */
    if @internal_account_id = NULL and @symbol != NULL
        select
            @internal_account_id = internal_account_id
        from
            internal_accounts
        where
            symbol = @symbol

    /* Lookup @internal_account_id by name */
    if @internal_account_id = NULL and @name != NULL
        select
            @internal_account_id = internal_account_id
        from
            internal_accounts
        where
            name = @name

end

if @internal_account_id = NULL
begin

    /* Resolve the @source_id from @source */
    exec
        r_resolvesource
            @login = @login,
            @source_id = @source_id out,
            @name = @source,
            @report = @report
    if @source_id = NULL
        return
        
    /* ---------------------------- MARK: Create ---------------------------- */

    if @should_create != "N" and /* has permission */ exists (
        select
            *
        from
            source_permissions
        where
            source_id = @source_id
        and
            autocreates_internal_accounts = "Y"
    )
    begin
    
        if @symbol = NULL
        begin
            
            select
                @issue = "unsupported:r_resolveinternalaccount():missing:@symbol",
                @to = "support",
                @subject = "Couldn't autocreate internal_account without a symbol",
                @content = "Internal account does not exist. r_resolveinternalaccount attempted to create the internal_account but no @symbol was provided."
            exec
                r_postmessage
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High"
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Cannot create internal account without specifying symbol",
                    internal_account = @symbol
                    
            return
        end
        
        if @name = NULL
            select
                @name = @symbol
        
        /* Find the default external account */
        if @default_external_account_id = NULL
        begin
        
            if @default_external_account_id = NULL and @default_external_account != NULL
            begin
            
                exec
                    r_resolveexternalaccount
                        @login = @login,
                        @source = @source,
                        @external_account_id = @default_external_account_id out,
                        @symbol = @default_external_account,
                        @create = "Y",
                        @report = @report
                
                if @default_external_account_id = NULL
                begin
                    select
                        @issue = "notfound:external_accounts(symbol=" + @default_external_account + "):r_resolveinternalaccount(symbol=" + @symbol + ")",
                        @to = "support",
                        @subject = "Default external account, """ + @default_external_account + """, could not be found for new internal account, """ + @symbol + """",
                        @content = "The internal account, """ + @name + """, does not exist and r_resolveinternalaccount attempted to autocreate it but could not resolve its default external account, """ + @default_external_account + """",
                        @check_sql = "if exists(select * from internal_accounts where symbol = """ + @symbol + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
                    exec
                        r_manageissue
                            @login = @login,
                            @name = @issue,
                            @to = @to,
                            @channel = "System",
                            @subject = @subject,
                            @content = @content,
                            @priority = "High",
                            @check_sql = @check_sql
                            
                    if @report != "N"
                        select
                            status = "Error",
                            message = "Couldn't add internal account without default external account",
                            internal_account = @symbol,
                            default_external_account = @default_external_account
                            
                    return
                end
                
            end
            
            /* Lookup the @default_external_account_id using the same symbol as
             * the internal account symbol */
            if @default_external_account_id = NULL
                exec
                    r_resolveexternalaccount
                        @login = @login,
                        @source = @source,
                        @external_account_id = @default_external_account_id out,
                        @symbol = @symbol,
                        @create = "Y",
                        @report = @report
            
            if @default_external_account_id = NULL
            begin
                
                select
                    @issue = "notfound:internal_accounts(symbol=" + @symbol + ")",
                    @to = "support",
                    @subject = "Cannot create internal account, """ + @symbol + """, without a default external account",
                    @content = "The internal account, """ + @name + """, does not exist and r_resolveinternalaccount attempted to autocreate it but could not resolve its default external account. Neither a @default_external_account was specified nor does an external account exist with the symbol, """ + @symbol + """",
                    @check_sql = "if exists(select * from internal_accounts where symbol = """ + @symbol + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
                exec
                    r_manageissue
                        @login = @login,
                        @name = @issue,
                        @to = @to,
                        @channel = "System",
                        @subject = @subject,
                        @content = @content,
                        @priority = "High",
                        @check_sql = @check_sql
                        
                if @report != "N"
                    select
                        status = "Error",
                        message = "Couldn't add internal account without default external account",
                        internal_account = @symbol
                        
                return
            end
            
        end
    
        /*+-------------------------------------------------------------------* 
         |                      INSERT internal_accounts                      | 
         *--------------------------------------------------------------------*/

        exec
            j_nextkey
                "internal_accounts",
                @internal_account_id out
        
        insert into
            internal_accounts (
                internal_account_id,
                symbol,
                name,
                default_external_account_id
            )
            values (
                @internal_account_id,
                @symbol,
                @name,
                @default_external_account_id
            )
        
        if @@rowcount != 1
        begin
        
            select
                @issue = "insert:internal_accounts(name=" + @name + ")",
                @to = "support",
                @subject = "Failed to create internal account",
                @content = "The internal account, """ + @name + """, does not exist and r_resolveinternalaccount attempted to autocreate it but no row was inserted with (internal_account_id: " + convert(varchar(10), @internal_account_id) + ", symbol: '" + @symbol + "', name: '" + @name + "', default_external_account_id: '" + convert(varchar(10), @default_external_account_id) + "').",
                @check_sql = "if exists(select * from internal_accounts where symbol = """ + @symbol + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
            exec
                r_manageissue
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High",
                    @check_sql = @check_sql
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Couldn't add internal account",
                    internal_account = @name
            
            return
        end
        
        select
            @create = "Y"
    
        select
            @to = "support",
            @subject = "Internal account, """ + @name + """, created",
            @content = "The internal account, """ + @name + """, was created by " + @login + " on behalf of " + @source + "."
        exec
            r_postmessage
                @login = @login,
                @to = @to,
                @channel = "General",
                @subject = @subject,
                @content = @content,
                @priority = "Low"
                
    end
    else
    begin

        select
            @issue = "notfound:internal_accounts(name=" + @name + ")",
            @to = "support",
            @subject = "Internal account, """ + @name + """, does not exist",
            @content = "The internal account, """ + @name + """, could not be found.",
            @check_sql = "if exists(select * from internal_accounts where name = """ + @name + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
        exec
            r_manageissue
                @login = @login,
                @name = @issue,
                @to = @to,
                @channel = "System",
                @subject = @subject,
                @content = @content,
                @priority = "High",
                @check_sql = @check_sql
                
        if @report != "N"
            select
                status = "Error",
                message = "Internal account not found",
                internal_account = @name
        
        return
    end
    
end
    
select
    @symbol = a.symbol,
    @name = a.name,
    @default_external_account = b.symbol,
    @default_external_account_id = b.external_account_id
from
    internal_accounts a
join
    external_accounts b
        on a.default_external_account_id = b.external_account_id
where
    a.internal_account_id = @internal_account_id

go
