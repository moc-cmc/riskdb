	risk_alumfx
go

drop procedure
	cbo_portfoliosummary
go

create procedure
	cbo_portfoliosummary
		@login varchar(50),
		@account varchar(50),
		@date datetime=NULL
as


declare @fund_id int
declare @external_account_id int
declare @tico_account_id int
declare @begin_date datetime
declare @end_date datetime
declare @first_of_month datetime
declare @first_of_next_month datetime
declare @first_biz_day datetime
declare @last_of_prev_month datetime
declare @last_biz_last_month datetime
declare @last_of_month datetime
declare @last_biz_day datetime
declare @month varchar(2)
declare @year varchar(4)
declare @datestring varchar(15)
declare @balance float
declare @open_equity float
declare @evaluation_currency_id int
declare @transaction_types int
declare @transaction_type_id int
declare @transaction_type varchar(50)
declare @amount float
declare @cash_total float

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @style varchar(250)
declare @ledger_style varchar(250)
declare @futures_style varchar(250)
declare @fwd_style varchar(250)
declare @fwd_opt_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"not_currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_fwd_price",
	"Edit Statement Fwd Price",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"counter_amount",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"dealt_amount",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"equivalent_amount",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"amount",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"ytd",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"mtd",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"daily",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values(
	"Column Format",
	"rate",
	"Number",
	 "#,##0.000000")

insert into
	#meta
values(
	"Column Format",
	"value",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@ledger_style = "background:#FFFFFF;border: 1px solid white",
	@futures_style = "background:#FFFFFF;border: 1px solid white",
	@fwd_style = "background:#FFFFFF;border: 1px solid white",
	@fwd_opt_style = "background:#FFFFFF;border: 1px solid white"

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts a,
	runs b,
	user_runs c
where
	a.symbol = b.name
and
	b.run_id = c.run_id
and
	c.tico_account_id = @tico_account_id
and
	a.symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end


if @date = NULL
	select
		@date = max(reval_date)
	from
		committed_daily_revals

select
	@month = convert(varchar(2), datepart(month, @date)),
	@year = convert(varchar(4), datepart(year, @date))

select
	@first_of_month = convert(datetime, @month + "/1/" + @year)

exec
	r_prevbusinessday
		@first_of_month,
		@last_biz_last_month output
select
	@first_of_next_month = dateadd(month, 1, @first_of_month)

select
	@last_of_prev_month = dateadd(day, -1, @first_of_month),
	@last_of_month = dateadd(day, -1, @first_of_next_month)

exec
	r_nextbusinessday
		@last_of_prev_month,
		@first_biz_day output

exec
	r_prevbusinessday
		@first_of_next_month,
		@last_biz_day output

create table
	#report(
		id int identity,
		style varchar(250) NULL,
		description varchar(50),
		value varchar(50) NULL)
insert into
	#report(
		style,
		description)
values(
	@total_style,
	@account)

insert into
	#report
values(
	@style,
	"Statement Begin Date",
	convert(varchar(11), @first_of_month, 1))
insert into
	#report
values(
	@style,
	"Statement End Date",
	convert(varchar(11), @last_of_month, 1))


create table
	#conversion_rates(
		product_id int,
		begin_rate float NULL,
		end_rate float NULL)

insert into
	#conversion_rates(
		product_id)
select
	a.product_id
from
	products a,
	product_types b
where
	a.product_type_id = b.product_type_id
and
	b.name = "Currency"

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

update
	#conversion_rates
set
	begin_rate = 1.0,
	end_rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	a.begin_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @first_biz_day)

update
	#conversion_rates
set
	a.begin_rate = (1.0 / c.price)
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = @evaluation_currency_id
and
	b.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @first_biz_day)
and
	a.begin_rate = NULL


update
	#conversion_rates
set
	a.end_rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = b.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @last_biz_day)

update
	#conversion_rates
set
	a.end_rate = (1.0 / c.price)
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	a.product_id = @evaluation_currency_id
and
	b.currency_id = b.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @last_biz_day)
and
	a.begin_rate = NULL


create table
	#transactions(
		account_transaction_id int,
		transaction_date datetime,
		transaction_type_id int,
		currency_id int,
		amount float,
		begin_equiv float NULL,
		end_equiv float NULL)

insert into
	#transactions(
		account_transaction_id,
		transaction_date,
		transaction_type_id,
		currency_id,
		amount)
select
	account_transaction_id,
	transaction_date,
	transaction_type_id,
	currency_id,
	amount
from
	account_transactions
where
	external_account_id = @external_account_id
and
	convert(date, transaction_date) <= convert(date, @last_of_month)

update
	#transactions
set
	a.begin_equiv = a.amount * b.begin_rate
from
	#transactions a,
	#conversion_rates b
where
	a.currency_id = b.product_id

update
	#transactions
set
	begin_equiv = 0.0
where
	transaction_date >= @first_of_month

update
	#transactions
set
	a.end_equiv = a.amount * b.end_rate
from
	#transactions a,
	#conversion_rates b
where
	a.currency_id = b.product_id



select
	@balance = sum(begin_equiv)
from
	#transactions
where
	transaction_date < @first_of_month
if @balance = NULL
	select
		@balance = 0.0

select
	@open_equity = sum(a.unrealized_pl_to_date * -1.0)
from
	committed_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	b.external_account_id = @external_account_id
and
	convert(date, a.reval_date) = convert(date, @last_biz_last_month)
if @open_equity = NULL
	select
		@open_equity = 0.0

insert into
	#report
values(
	@style,
	"Total Cash as of " + convert(varchar(11), @first_of_month),
	convert(varchar(30), convert(numeric(30,2), @balance)))

insert into
	#report
values(
	@style,
	"Total Open Equity as of " + convert(varchar(11), @first_of_month),
	convert(varchar(30), convert(numeric(30,2), @open_equity)))



insert into
	#report
values(
	@style,
	"Total Net Equity as of " + convert(varchar(11), @first_of_month),
	convert(varchar(30), convert(numeric(30,2), @balance + @open_equity)))

select
	@balance = sum(end_equiv)
from
	#transactions
where
	convert(date, transaction_date) <= convert(date, @last_of_month)
if @balance = NULL
	select
		@balance = 0.0

select
	@open_equity = sum(a.unrealized_pl_to_date * -1.0)
from
	committed_daily_revals a,
	trades b
where
	a.trade_id = b.trade_id
and
	b.external_account_id = @external_account_id
and
	convert(date, a.reval_date) = convert(date, @last_biz_day)
if @open_equity = NULL
	select
		@open_equity = 0.0

insert into
	#report
values(
	@style,
	"Total Cash as of " + convert(varchar(11), @last_of_month),
	convert(varchar(30), convert(numeric(30,2), @balance)))

insert into
	#report
values(
	@style,
	"Total Open Equity as of " + convert(varchar(11), @last_of_month),
	convert(varchar(30), convert(numeric(30,2), @open_equity)))

insert into
	#report
values(
	@style,
	"Total Net Equity as of " + convert(varchar(11), @last_of_month),
	convert(varchar(30), convert(numeric(30,2), @balance + @open_equity)))

create table
	#transaction_types(
		transaction_type_id int)
insert into
	#transaction_types
select
	distinct(transaction_type_id)
from
	#transactions

create table
	#cash_out(
		id int identity,
		style varchar(250) NULL,
		transaction_id varchar(50) NULL,
		transaction_date datetime NULL,
		transaction_type varchar(50) NULL,
		currency varchar(50) NULL,
		amount float NULL,
		equivalent_amount float NULL)

select
	@transaction_type_id = 0
select
	@transaction_types = count(*)
from
	#transaction_types
where
	transaction_type_id > @transaction_type_id

while @transaction_types > 0
begin
	select
		@transaction_type_id = min(transaction_type_id)
	from
		#transaction_types
	where
		transaction_type_id > @transaction_type_id

	select
		@amount = NULL

	select
		@transaction_type = name
	from
		transaction_types
	where
		transaction_type_id = @transaction_type_id

	select
		@amount = sum(end_equiv)
	from
		#transactions
	where
		transaction_type_id = @transaction_type_id
	and
		convert(date, transaction_date) >= convert(date, @first_of_month)
	insert into
		#report
	values(
		@style,
		@transaction_type + "s During Period",
		convert(varchar(30), convert(numeric(30,2), @amount)))

	insert into
		#cash_out(
			style,
			transaction_id)
	values(
		@style,
		@transaction_type)

	insert into
		#cash_out(
			style,
			transaction_id,
			transaction_date,
			transaction_type,
			currency,
			amount,
			equivalent_amount)
	select
		style = @style,
		convert(varchar(50), a.account_transaction_id),
		a.transaction_date,
		transaction_type = b.name,
		currency = c.symbol,
		a.amount,
		equivalent_amount = end_equiv
	from
		#transactions a,
		transaction_types b,
		products c
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.currency_id = c.product_id
	and
		b.name = @transaction_type
	and
		a.transaction_date >= @first_of_month
	and
		a.amount != 0.0
	order by
		a.transaction_date

	insert into
		#cash_out(
			style,
			transaction_id,
			equivalent_amount)
	values(
		@total_style,
		@transaction_type + " Total",
		@amount)

	select
		@transaction_types = count(*)
	from
		#transaction_types
	where
		transaction_type_id > @transaction_type_id
end

select
	section = rtrim(@account) + " Monthly Statement, " + datename(month, @first_of_month) + " " + datename(year, @first_of_month),
	style,
	description,
	value
from
	#report
order by
	id
	

select
	section = "Cash Transactions",
	style,
	transaction_id,
	transaction_date,
	transaction_type,
	currency,
	amount,
	equivalent_amount
from
	#cash_out
order by
	id

select
	section = "Period Trades",
	style = @style,
	trade_type = c.name,
	a.trade_id,
	a.value_date,
	dealt_ccy = e.symbol,
	dealt_amount = b.quantity,
	counter_ccy = f.symbol,
	counter_amount = b.quantity * b.price * -1.0,
	rate = b.price,
	b.trade_date
from
	committed_daily_revals a,
	trades b,
	trade_types c,
	forwards d,
	products e,
	products f
where
	a.trade_id = b.trade_id
and
	b.external_account_id = @external_account_id
and
	b.trade_type_id = c.trade_type_id
and
	b.contract_id = d.contract_id
and
	d.product_id = e.product_id
and
	d.currency_id = f.product_id
and
	convert(date, a.reval_date) = convert(date, a.bo_trade_date)
and
	a.bo_trade_date >= @first_of_month
and
	a.bo_trade_date <= @last_of_month
order by
	b.trade_date

select last_of_month = @last_of_month /*MARK */

exec
	r_showdisclaimer
		"Monthly Trading Statement"


go

