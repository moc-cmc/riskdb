create table
	#traded_contracts(
		contract_id int,
		contract_symbol varchar(50) NULL,
		trade_type_id int,
		trade_type varchar(50) NULL,
		upi_code varchar(50) NULL,
		style varchar(50) NULL)

insert into
	#traded_contracts(
		contract_id,
		trade_type_id)
select
	contract_id,
	trade_type_id
from
	trades
where
	trade_date >= @begin_date
and
	trade_date < @end_date
group by
	contract_id,
	trade_type_id

update
	#traded_contracts
set
	style = @style

update
	#traded_contracts
set
	contract_symbol = b.symbol
from
	#traded_contracts a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#traded_contracts
set
	trade_type = b.name
from
	#traded_contracts a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id

delete from
	#traded_contracts
where
	trade_type = "Spot"

update
	#traded_contracts
set
	upi_code = b.symbol
from
	#traded_contracts a,
	upi_codes b
where
	a.contract_id = b.contract_id
and
	a.trade_type_id = b.trade_type_id

update
	#traded_contracts
set
	style = @error_style
where
	upi_code = NULL

select
        manage_upi_codes = "<< Back to UPI Codes",
        style = @style

select
	contract_symbol,
	trade_type,
	upi_code,
	style,
	add_code = "Add",
	edit_code = "Edit"
	
from
	#traded_contracts
order by
	contract_symbol

go


