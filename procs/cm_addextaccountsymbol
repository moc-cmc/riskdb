
if object_id("cm_addextaccountsymbol") != NULL
    drop procedure
        cm_addextaccountsymbol
go

create procedure
	cm_addextaccountsymbol
		@login varchar(50),
		@external_account varchar(50),
		@source varchar(50),
		@mapping varchar(100)
as


declare @source_id int
declare @external_account_id int
declare @mappings int

select 
        @external_account = ltrim(rtrim(@external_account))

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "External Account not found",
		external_account = @external_account
	return
end

select
	@mappings = count(*)
from
	external_account_symbols
where
	external_account_id = @external_account_id
and
	source_id = @source_id


/* To allow more than one inbound mapping
if @mappings > 0
begin
	select
		status = "Error",
		message = "External account is already mapped for mapping source",
		external_account= @external_account,
		source = @source
	return
end
*/

insert into
	external_account_symbols
values(
	@external_account_id,
	@source_id,
	@mapping)

exec
	cm_accountmappings
		@login,
		@external_account

go
