drop procedure fxa_counterpartylimits
go

create procedure fxa_counterpartylimits @login varchar(25), @counterparty varchar(100) = NULL as

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)


insert into
        #links
values(
        "Column Link",
        "edit_limits",
        "Edit Limits",
        NULL,
        NULL)

select * from #links

if(@counterparty = NULL)
begin

	select
		"Counterparty"=a.name,
		"Currency"=b.symbol,
		"NOP Type"=c.name,
		"NOP Limit"=d.nop_limit,
		"DSL Type"=e.name,
		"DSL Limit"=d.dsl_limit,
		"Notice Level"=d.notice_level,
		"Warning Level"=d.warning_level,
		"Blocked Level"=d.blocked_level,
		edit_limits="Edit"
	from
		counterparties a,
		products b,
		nop_types c,
		counterparty_limits d,
		dsl_types e
	where
		a.counterparty_id=d.counterparty_id and
		d.currency_id=b.product_id and
		d.nop_type_id=c.nop_type_id and
		d.dsl_type_id=e.dsl_type_id

end
else
begin
	
	select
		"Counterparty"=a.name,
        "Currency"=b.symbol,
        "NOP Type"=c.name,
        "NOP Limit"=d.nop_limit,
        "DSL Type"=e.name,
        "DSL Limit"=d.dsl_limit,
        "Notice Level"=d.notice_level,
        "Warning Level"=d.warning_level,
        "Blocked Level"=d.blocked_level,
		edit_limits="Edit"
    from
        counterparties a,
        products b,
        nop_types c,
        counterparty_limits d,
        dsl_types e
    where
        a.counterparty_id=d.counterparty_id and
        d.currency_id=b.product_id and
        d.nop_type_id=c.nop_type_id and
        d.dsl_type_id=e.dsl_type_id and
		a.name=@counterparty

end

return


go


