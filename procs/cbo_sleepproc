drop procedure
	cbo_sleepproc
go

create procedure
	cbo_sleepproc @sleeptime varchar(12) = NULL
as

declare @default_sleep varchar(12)

select
	@default_sleep = "00:06:00:00" 

if(@sleeptime = NULL)
begin
	waitfor delay @default_sleep
	select "Done ", @default_sleep
end		
else
begin
	waitfor delay @sleeptime	
	select "Done ", @sleeptime	
end

go
 
