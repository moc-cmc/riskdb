create table
	#external_accounts(
		id int identity,
		external_account_id int,
		symbol varchar(50),
		margin_multiplier float NULL)

insert into
	#external_accounts(
		external_account_id,
		symbol,
		margin_multiplier)
select
	a.external_account_id,
	a.symbol, 
	a.margin_multiplier
from
	external_accounts a,
	fund_external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	a.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"
order by
	a.symbol


create table
	#trades(
		trade_id int,
		prime_broker_id int NULL,
		external_account_id int,
		margin_multiplier float NULL, 
		quantity float,
		contract_id int,
		product_id int, 
		product_qty float,
		currency_id int,
		currency_qty float,
		price float,
		value_date datetime,
		status_id int,
		margin float NULL,
		product_equiv float NULL,
		currency_equiv float NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		margin_multiplier,
		quantity,
		contract_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		price,
		value_date,
		status_id,
		margin)
select
	a.trade_id,
	a.external_account_id,
	c.margin_multiplier,
	a.quantity,
	a.contract_id,
	b.product_id,
	a.quantity,
	b.currency_id,
	a.quantity * price * -1.0,
	a.price,
	a.value_date,
	a.status_id,
	margin = 0.0
from
	trades a,
	forwards b,
	#external_accounts c,
	products d
where 
 	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	b.product_id = d.product_id
and
	a.value_date > @begin_date
and
	a.trade_date < @end_date
/* chriso: added since 
 these accounts shouldnt have margin or open equity*/
and
	c.symbol not in("FC EDGEBOA", "FC INTERNAL")

update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.currency_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	account_product_margins b
where
	a.product_id = b.product_id
and
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	account_product_margins b
where
	a.currency_id = b.product_id
and
	a.external_account_id = b.external_account_id 


update
	#trades
set
	a.quantity = a.quantity * -1.0,
	a.product_qty = a.product_qty * -1.0,
	a.currency_qty = a.currency_qty * -1.0
from
	#trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"


create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	distinct(product_id)
from
	#trades
insert into
	#conversion_rates(
		product_id)
select
	distinct(currency_id)
from
	#trades
where
	currency_id not in(select product_id from #conversion_rates)

update
	#conversion_rates
set
	rate = 1.0
where 
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and 
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = a.product_id 
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	current_prices c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	a.rate = NULL

update
	#trades
set
	a.product_equiv = a.product_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#trades
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id


create table
	#accounts(
		external_account_id int,
		cash float NULL)

create table
	#product_positions( 
		external_account_id int,
		product_id int,
		quantity float,
		margin float NULL
		)
insert into
	#product_positions(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	product_id,
	sum(product_qty)
from
	#trades
group by
	external_account_id,
	product_id

insert into
	#product_positions(
		external_account_id,
		product_id,
		quantity)
select
	external_account_id,
	currency_id,
	sum(currency_qty)
from
	#trades
group by
 	external_account_id,
	currency_id

update
	#product_positions
set
	a.margin = b.margin  * d.margin_multiplier
from
	#product_positions a,
	product_margins b,
	external_account_prime_brokers c,
	external_accounts d
where
	a.product_id = b.product_id
and
	a.external_account_id = c.external_account_id
and
	c.external_account_id = d.external_account_id
and
	b.prime_broker_id = c.prime_broker_id

select
	section = "Missing margin rates",
	style = @error_style,
	account = b.symbol,
	product = c.symbol,
	a.margin
from
	#product_positions a,
	external_accounts b,
	products c
where
	a.external_account_id = b.external_account_id
and
	a.product_id = c.product_id
and
	a.margin = NULL
	


create table
	#product_balances( 
		external_account_id int,
		product_id int,
		margin float,
		quantity float,
		prime_broker_id int NULL,
		margin_multiplier float NULL,
		margin_bucket_id int NULL
		)
insert into
	#product_balances( 
		external_account_id,
		product_id,
		margin,
		quantity)
select
	external_account_id,
	product_id,
	max(margin),
	sum(quantity)
from
	#product_positions
where
	margin != NULL
group by
	external_account_id,
	product_id


delete

from
	#product_balances
where
	quantity = 0.0

update
	#product_balances
set
	a.margin_multiplier = b.margin_multiplier
from
	#product_balances a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#product_balances
set
	a.prime_broker_id = b.prime_broker_id
from
	#product_balances a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

create table
	#bucket_positions(
		margin_bucket_id int,
		nop_model_id int NULL,
		external_account_id int,
		product_id int,
		margin float NULL,
		quantity float NULL,
		equiv float NULL,
		long_equiv float NULL,
		short_equiv float NULL,
		abs_equiv float NULL,
		nop_long float NULL,
		nop_short float NULL,
		nop_abs float NULL,
		nop float NULL,
		prime_broker_id int NULL,
		margin_multiplier float NULL,
		long_use float NULL,
		short_use float NULL,
		abs_use float NULL,
		usage float NULL)
insert into
	#bucket_positions(
		margin_bucket_id,
		external_account_id,
		product_id,
		margin,
		quantity,
		prime_broker_id,
		margin_multiplier)
select
	a.margin_bucket_id,
	b.external_account_id,
	b.product_id,
	b.margin,
	b.quantity,
	b.prime_broker_id,
	b.margin_multiplier
from
	margin_bucket_products a,
	#product_balances b
where
	a.product_id = b.product_id

update
	#bucket_positions
set
	a.nop_model_id = b.nop_model_id
from
	#bucket_positions a,
	margin_buckets b
where
	a.margin_bucket_id = b.margin_bucket_id

update
	#bucket_positions
set
	a.equiv = a.quantity * b.rate
from
	#bucket_positions a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#bucket_positions
set
	long_equiv = 0.0,
	short_equiv = 0.0,
	abs_equiv = 0.0,
	nop_long = 0.0,
	nop_short = 0.0,
	nop_abs = 0.0,
	nop = 0.0,
	long_use = 0.0,
	short_use = 0.0,
	abs_use = 0.0,
	usage = 0.0


update
	#bucket_positions
set
	long_equiv = equiv
where
	equiv >= 0.0

update
	#bucket_positions
set
	short_equiv = equiv
where
	equiv < 0.0

update
	#bucket_positions
set
	abs_equiv = abs(equiv)

update
	#bucket_positions
set
	a.nop_long = a.long_equiv * b.long_multiplier,
	a.nop_short = a.short_equiv * b.short_multiplier,
	a.nop_abs = a.abs_equiv * b.abs_multiplier
from
	#bucket_positions a,
	nop_models b
where
	a.nop_model_id = b.nop_model_id

update
	#bucket_positions
set
	a.long_use = abs(a.equiv) * a.margin * b.long_multiplier
from
	#bucket_positions a,
	nop_models b
where
	a.nop_model_id = b.nop_model_id
and
	a.equiv >= 0.0

update
	#bucket_positions
set
	a.short_use = abs(a.equiv) * a.margin * b.short_multiplier
from
	#bucket_positions a,
	nop_models b
where
	a.nop_model_id = b.nop_model_id
and
	a.equiv < 0.0

update
	#bucket_positions
set
	a.abs_use = abs(a.equiv) * a.margin * b.abs_multiplier
from
	#bucket_positions a,
	nop_models b
where
	a.nop_model_id = b.nop_model_id

update
	#bucket_positions
set
	a.long_use = abs(a.equiv) * a.margin * b.base_ccy_multiplier,
	a.short_use = abs(a.equiv) * a.margin * b.base_ccy_multiplier,
	a.abs_use = abs(a.equiv) * a.margin * b.base_ccy_multiplier
from
	#bucket_positions a,
	nop_models b
where
	a.nop_model_id = b.nop_model_id
and
	a.product_id = @evaluation_currency_id


create table
	#bucket_nets(
		margin_bucket_id int,
		nop_model_id int,
		external_account_id int,
		nop_long float NULL,
		nop_short float NULL,
		long_use float NULL,
		short_use float NULL)
insert into
	#bucket_nets(
		margin_bucket_id,
		nop_model_id,
		external_account_id,
		nop_long,
		nop_short,
		long_use,
		short_use)
select
	a.margin_bucket_id,
	a.nop_model_id,
	a.external_account_id,
	sum(a.nop_long),
	sum(a.nop_short),
	sum(a.long_use),
	sum(a.short_use)
from
	#bucket_positions a,
	nop_models b
where
	a.nop_model_id = b.nop_model_id
and
	lower(b.use_max_sum) = "y"
group by
	a.margin_bucket_id,
	a.nop_model_id,
	a.external_account_id

update
	#bucket_positions
set
	a.short_use = 0.0
from
	#bucket_positions a,
	#bucket_nets b
where
	a.margin_bucket_id = b.margin_bucket_id
and
	a.nop_model_id = b.nop_model_id
and
	a.external_account_id = b.external_account_id
and
	b.long_use >= b.short_use

update
	#bucket_positions
set
	a.long_use = 0.0
from
	#bucket_positions a,
	#bucket_nets b
where
	a.margin_bucket_id = b.margin_bucket_id
and
	a.nop_model_id = b.nop_model_id
and
	a.external_account_id = b.external_account_id
and
	b.short_use > b.long_use

update
	#bucket_positions
set
	usage = long_use + short_use + abs_use

