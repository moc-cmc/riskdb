	@id = 0
select
	@ids = count(*)
from 
	#ordered_accounts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ordered_accounts
	where
		id > @id

	select
		@external_account_id = NULL,
		@account = NULL,
		@margin_model_id = NULL,
		@equiv = NULL,
		@long_equiv = NULL,
		@short_equiv = NULL,
		@abs_equiv = NULL,
		@nop_long = NULL,
		@nop_short = NULL,
		@nop_abs = NULL,
		@nop = NULL,
		@long_use = NULL,
		@short_use = NULL,
		@abs_use = NULL,
		@usage = NULL
		
	select
		@margin_model_id = margin_model_id
	from
		margin_models
	where
		name = "Default"
	if @margin_model_id = NULL
	begin
		select
			status = "Error",
			message = "Margin Model not found"
		return
	end


	select
		@external_account_id = external_account_id,
		@account = account
	from
		#ordered_accounts
	where
		id = @id

	select
		@equiv = sum(equiv),
		@long_equiv = sum(long_equiv),
		@short_equiv = sum(short_equiv),
		@abs_equiv = sum(abs_equiv),
		@nop_long = sum(nop_long),
		@nop_short = sum(nop_short),
		@nop_abs = sum(nop_abs),
		@long_use = sum(long_use),
		@short_use = sum(short_use),
		@abs_use = sum(abs_use),
		@usage = sum(usage)
	from
		#bucket_positions
	where
		external_account_id = @external_account_id

	insert into
		#output(
			style,
			external_account_id,
			account,
			equiv,
			long_equiv,
			short_equiv,
			abs_equiv,
			nop_long,
			nop_short,
			nop_abs,
			nop,
			/* long_use,
			short_use,
			abs_use, */
			usage)
		values(
			@client_style,
			@external_account_id,
			@account,
			@equiv,
			@long_equiv,
			@short_equiv,
			@abs_equiv,
			@nop_long,
			@nop_short,
			@nop_abs,
			@nop,
			/*@long_use,
			@short_use,
			@abs_use, */
			@usage)

	truncate table
		#account_buckets

	insert into
		#account_buckets(
			margin_bucket_id,
			margin_bucket)
	select
		a.margin_bucket_id,
		b.name
	from
		margin_model_buckets a,
		margin_buckets b
	where
		a.margin_bucket_id = b.margin_bucket_id
	and
		a.margin_model_id = @margin_model_id
	order by
		a.ordering

	select
		@bucket_id = 0
	select
		@buckets = count(*)
	from
		#account_buckets
	where
		id > @bucket_id

	while @buckets > 0
	begin
		select
			@bucket_id = min(id)
		from
			#account_buckets
		where
			id > @bucket_id

		select
			@equiv = NULL,
			@nop_long = NULL,
			@nop_short = NULL,
			@nop_abs = NULL,
			@nop = NULL,
			@long_use = NULL,
			@short_use = NULL,
			@abs_use = NULL,
			@usage = NULL

		select
			@bucket = margin_bucket,
			@margin_bucket_id = margin_bucket_id
		from
			#account_buckets
		where
			id = @bucket_id

		select
			@nop_model_id = nop_model_id
		from
			margin_buckets
		where
			margin_bucket_id = @margin_bucket_id

		select
			@nop_model = name
		from
			nop_models
		where
			nop_model_id = @nop_model_id

		select
			@equiv = sum(equiv),
			@long_equiv = sum(long_equiv),
			@short_equiv = sum(short_equiv),
			@abs_equiv = sum(abs_equiv),
			@nop_long = sum(nop_long),
			@nop_short = sum(nop_short),
			@nop_abs = sum(nop_abs),
			/* REMOVE THIS @nop = sum(nop), */
			@long_use = sum(long_use),
			@short_use = sum(short_use),
			@abs_use = sum(abs_use),
			@usage = sum(usage)
		from
			#bucket_positions
		where
			external_account_id = @external_account_id
		and
			margin_bucket_id = @margin_bucket_id

		insert into
			#output(
				style,
				external_account_id,
				margin_bucket_id,
				bucket,
				nop_model_id,
				nop_model,
				equiv,
				long_equiv,
				short_equiv,
				abs_equiv,
				nop_long,
				nop_short,
				nop_abs,
				/* REMOVE THIS nop, */
				long_use,
				short_use,
				abs_use,
				usage)
		values(
			@subtotal_style,
			@external_account_id,
			@margin_bucket_id,
			@bucket,
			@nop_model_id,
			@nop_model,
			@equiv,
			@long_equiv,
			@short_equiv,
			@abs_equiv,
			@nop_long,
			@nop_short,
			@nop_abs,
			/* REMOVE THIS @nop, */
			@long_use,
			@short_use,
			@abs_use,
			@usage)

		insert into
			#output(
				style,
				external_account_id,
				nop_model_id,
				product_id,
				product,
				margin,
				balance,
				equiv,
				long_equiv,
				short_equiv,
				abs_equiv,
				nop_long,
				nop_short,
				nop_abs,
				/* REMOVE THIS nop, */
				long_use,
				short_use,
				abs_use,
				usage)
		select
			style = @style,
			a.external_account_id,
			a.nop_model_id,
			a.product_id,
			b.symbol,
			a.margin,
			a.quantity,
			a.equiv,
			a.long_equiv,
			a.short_equiv,
			a.abs_equiv,
			a.nop_long,
			a.nop_short,
			a.nop_abs,
			/* REMOVE THIS a.nop,*/
			a.long_use,
			a.short_use,
			a.abs_use,
			a.usage
		from
			#bucket_positions a,
			products b
		where
			a.product_id = b.product_id
		and
			a.external_account_id = @external_account_id
		and
			a.margin_bucket_id = @margin_bucket_id
		order by
			b.symbol
		if @@rowcount = 0
			delete

			from
				#output
			where
				external_account_id = @external_account_id
			and
				margin_bucket_id = @margin_bucket_id

		update
			#output
		set
			a.nop = abs(nop_long) + abs(nop_abs)
		from
			#output a,
			nop_models b
		where
			a.nop_model_id = b.nop_model_id
		and
			lower(b.use_max_sum) = "y"
		and
			abs(nop_long) >= abs(nop_short)
		and
			a.margin_bucket_id = @margin_bucket_id

		update
			#output
		set
			a.nop = abs(nop_short) + abs(nop_abs)
		from
			#output a,
			nop_models b
		where
			a.nop_model_id = b.nop_model_id
		and
			lower(b.use_max_sum) = "y"
		and
			abs(nop_long) < abs(nop_short)
		and
			a.margin_bucket_id = @margin_bucket_id

		update
			#output
		set
			a.nop = (abs(a.nop_long) * b.long_multiplier) + (abs(a.nop_short) * b.short_multiplier) + (abs(a.nop_abs) * b.abs_multiplier)
		from
			#output a,
			nop_models b
		where
			a.nop_model_id = b.nop_model_id
		and
			lower(b.use_max_sum) != "y"
		and
			a.margin_bucket_id = @margin_bucket_id

		
		select
			@buckets = count(*)
		from
			#account_buckets
		where
			id > @bucket_id
	end

	select
		@nop = NULL,
		@nop_long = NULL,
		@nop_short = NULL,
		@nop_abs = NULL
	select
		@nop = sum(nop),
		@nop_long = sum(nop_long),
		@nop_short = sum(nop_short),
		@nop_abs = sum(nop_abs)
	from
		#output
	where
		external_account_id = @external_account_id
	and
		style = @subtotal_style
	update
		#output 
	set
		nop = @nop,
		nop_long = NULL, /* You can't sum across buckets */
		nop_short = NULL,
		nop_abs = NULL
	where
		external_account_id = @external_account_id
	and
		style = @client_style

	
	select
		@ids = count(*)
	from
		#ordered_accounts
	where
		id > @id
end

update
	#output
set
	a.prime_broker_id = b.prime_broker_id,
	a.prime_broker = d.name
from
	#output a,
	external_account_prime_brokers b,
	prime_brokers c,
	sources d
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = c.prime_broker_id
and
	c.source_id = d.source_id


select
	section = "Bucket Key",
	style = @subtotal_style,
	margin_bucket = a.name,
	nop_model = b.name
from
	margin_buckets a,
	nop_models b
where
	a.nop_model_id = b.nop_model_id

create table
	#pb_sum(
		id int identity,
		style varchar(250) NULL,
		prime_broker varchar(50),
		usage float NULL)
insert into
	#pb_sum(
		prime_broker,
		usage)
select
	prime_broker,
	usage = sum(usage)
from
	#output
where
	style = @client_style
group by
	prime_broker
update
	#pb_sum
set
	style = @style
select
	section = "PB Summary",
	style,
	prime_broker,
	usage
from
	#pb_sum
order by
	prime_broker
	
create table
	#bucket_sum(
		id int identity,
		style varchar(250) NULL,
		bucket varchar(50) NULL,
		usage float NULL)
insert into
	#bucket_sum(
		bucket,
		usage)
select
	bucket,
	sum(usage)
from
	#output
where
	style = @subtotal_style
group by
	bucket
update
	#bucket_sum
set
	style = @style
select
	section = "Bucket Summary",
	style,
	bucket,
	usage
from
	#bucket_sum
order by
	bucket




select
	section = prime_broker,
	style,
	account,
	bucket,
	/* nop_model, */
	product,
	balance,
	nop_long,
	nop_short,
	nop_abs,
	nop,
	margin_rate = margin,
	long_use,
	short_use,
	abs_use,
	usage
from
	#output
order by
	prime_broker,
	id


