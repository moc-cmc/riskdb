create or replace procedure
	api_getfosubaccountinfobyid
		@fo_sub_account_id int

as

declare @external_account_id int
declare @symbol varchar(100)
declare @name varchar(100)

select
	@external_account_id = b.external_account_id,
	@symbol = b.symbol,
	@name = b.name
from
	fo_sub_accounts a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.fo_sub_account_id = @fo_sub_account_id
if @external_account_id = NULL
begin
	select
		status = "Error", 
		message = "Problem finding accounf from id",
		fo_sub_account_id = @fo_sub_account_id
	return
end

select
	external_account_id = @external_account_id,
	symbol = @symbol,
	name = @name


go
