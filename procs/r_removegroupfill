
if object_id("r_removegroupfill") != NULL
    drop procedure
        r_removegroupfill
go

create procedure
	r_removegroupfill
		@login varchar(50),
        @group_deal_id int,
        @deal_id int,
        @client_trade_id int = NULL,
        @market_trade_id int = NULL,
        @leg varchar(25) = NULL
as

declare @trade_id int
declare @new_deal_id int

if @group_deal_id = @deal_id
    return

if @leg = "Client" and @client_trade_id != NULL
begin

    exec
        j_nextkey
            "deals",
            @new_deal_id out
        
    insert into
        deals (
            deal_id,
            deal_type_id,
            timestamp
        )
    select
        @new_deal_id,
        a.deal_type_id,
        getdate()
    from
        deal_types a
    where
        a.name = "B2B Forward"

    update
        trades
    set
        deal_id = @new_deal_id
    where
        trade_id = @client_trade_id
        
end
else if @leg = "Counterparty" and @market_trade_id != NULL
begin

    exec
        j_nextkey
            "deals",
            @new_deal_id out
        
    insert into
        deals (
            deal_id,
            deal_type_id,
            timestamp
        )
    select
        @new_deal_id,
        a.deal_type_id,
        getdate()
    from
        deal_types a
    where
        a.name = "B2B Forward"

    update
        trades
    set
        deal_id = @new_deal_id
    where
        trade_id = @market_trade_id
        
end
else if @leg = NULL and @deal_id != NULL
begin

    select
        status = "Error",
        message = "Unsupported"
    
end

go
