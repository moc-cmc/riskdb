drop procedure
	fxa_clientnotificationlogin
go

create procedure
	fxa_clientnotificationlogin
		@external_account varchar(50)

as


declare @external_account_id int
declare @tico_account_id int
declare @client_login_config_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where 
	symbol = @external_account
if @@rowcount != 1
begin
	select
		error = "Error",
		messasge = "Problem determining external account",
		external_account = @external_account
	return
end

select
	@client_login_config_id = client_login_config_id
from
	client_transfer_details
where
	external_account_id = @external_account_id


select
	a.login
from
	tico_accounts a,
	client_login_configs b
where
	a.account_id = b.tico_account_id
and
	b.id = @client_login_config_id

go
