use
	risk_firsel
go

drop procedure
	lw_createbatchfiletrades
go

create procedure
	lw_createbatchfiletrades
		@login varchar(50),
		@identifier varchar(50),
		@model_name varchar(50),
		@starting_date datetime
as

declare @batch_file_id int
declare @queued_trade_id int
declare @deal_id int
declare @batch_file_account_id int
declare @batch_file_accounts int
declare @trade_price float
declare @strategy_id int
declare @balance float
declare @contract_id int
declare @symbol varchar(50)
declare @evaluation_currency_id int
declare @product_id int
declare @fund_id int
declare @product_type_id int
declare @product_rate_id int
declare @exchange_id int
declare @instrument_id int
declare @collection_model_id int
declare @offset_days int
declare @jurisdiction_id int
declare @strategy varchar(50)
declare @value_date datetime
declare @jurisdiction_flow_id int
declare @days int
declare @trade_date datetime
declare @deal_type_id int
declare @status_id int
declare @trade_identifier varchar(50)


exec
	r_defaultfundforlogin
		@login,
		@fund_id output
select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "Active"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Active status not found"
	return
end

select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = "Market Forward"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Market Forward deal type not found"
	return
end


select
	@collection_model_id = collection_model_id
from
	collection_models
where
	name = @model_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Collection model not found",
		collection_model = @model_name
	return
end

select
	@exchange_id = exchange_id
from
	exchanges
where
	name = @model_name
if @@rowcount != 1
begin
	exec
		j_nextkey
			"exchanges",
			@exchange_id output

	insert into
		exchanges
	values(
		@exchange_id,
		@model_name)
end

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Forward"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"instruments",
			@instrument_id output
	insert into
		instruments
	values(
		@instrument_id,
		"Forward")
end
select
	@product_type_id = product_type_id
from
	product_types
where
	name = "Debt"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"product_types",
			@product_type_id output

	insert into
		product_types
	values(
		@product_type_id,
		"Debt")
end

/* select
	@strategy_id = strategy_id
from
	strategies
where
	name = @model_name
if @@rowcount != 1
begin
	exec
		j_nextkey
			"strategies",
			@strategy_id output

	insert into
		strategies
	values(
		@strategy_id,
		@model_name)
end */

select
	@batch_file_id = batch_file_id 
from
	batch_files
where
	identifier = @identifier
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Batch file not found",
		identifier = @identifier
	return
end

select
	@starting_date = convert(datetime, convert(date, @starting_date)),
	@trade_price = 0.000001


select
	@batch_file_account_id = 0
select
	@batch_file_accounts = count(*)
from
	batch_file_accounts
where
	batch_file_id = @batch_file_id
and
	batch_file_account_id > @batch_file_account_id

while @batch_file_accounts > 0
begin
	select
		@batch_file_account_id = min(batch_file_account_id)
	from
		batch_file_accounts
	where
		batch_file_id = @batch_file_id
	and
		batch_file_account_id > @batch_file_account_id

	select
		@trade_date = @starting_date,
		@value_date = @starting_date

	select
		@deal_id = NULL

	select
		@balance = amount,
		@symbol = identifier,
		@jurisdiction_id = jurisdiction_id
	from
		batch_file_accounts
	where
		batch_file_account_id = @batch_file_account_id

	select
		@contract_id = contract_id
	from
		contracts
	where
		symbol = @symbol
	if @contract_id = NULL
	begin
		select
			@product_id = product_id
		from
			products
		where
			symbol = @symbol
		if @product_id = NULL
		begin
			exec
				j_nextkey
					"products",
					@product_id output

			insert into
				products
			values(
				@product_id,
				@product_type_id,
				@symbol,
				@symbol)
		end

		select
			@product_rate_id = max(product_rate_id)
		from
			product_rates
		where
			product_id = @product_id
		if @product_rate_id = NULL
		begin
			exec
				j_nextkey
					"product_rates",
					@product_rate_id output

			insert into
				product_rates
			values(
				@product_rate_id,
				@product_id,
				dateadd(year, -1, @starting_date))

			insert into
				product_rate_points
			values(
				@product_rate_id,
				1.0,
				0)
		end

		exec
			j_nextkey
				"contracts",
				@contract_id output

		begin tran
			insert into
				forwards
			values(
				@contract_id,
				@evaluation_currency_id,
				@product_id,
				1,
				@exchange_id)
			if @@rowcount != 1
				rollback tran

			insert into
				contracts
			values(
				@contract_id,
				@symbol,
				@instrument_id)
			if @@rowcount != 1
				rollback tran
		commit tran
	
		exec
			u_setcurrentprice
				@symbol,
				0.000001
	end


	select
		@days = 0,
		@offset_days = -1

	select
		@days = count(*)
	from
		jurisdiction_flows
	where
		collection_model_id = @collection_model_id
	and
		jurisdiction_id = @jurisdiction_id
	and
		offset_days > @offset_days


	while @days > 0
	begin
		select
			@offset_days = min(offset_days)
		from
			jurisdiction_flows
		where
			collection_model_id = @collection_model_id
		and
			jurisdiction_id = @jurisdiction_id
		and
			offset_days > @offset_days

		select
			@queued_trade_id = NULL

		select
			@jurisdiction_flow_id = id
		from
			jurisdiction_flows
		where
			collection_model_id = @collection_model_id
		and
			jurisdiction_id = @jurisdiction_id
		and
			offset_days = @offset_days
		

		select
			@strategy_id = collection_event_id
		from
			jurisdiction_flows
		where
			collection_model_id = @collection_model_id
		and
			jurisdiction_id = @jurisdiction_id
		and
			offset_days = @offset_days

		select
			@strategy = name
		from
			strategies
		where
			strategy_id = @strategy_id

			
		select
			@value_date = dateadd(day, @offset_days, @trade_date)

		select
			@trade_identifier = rtrim(@symbol) + "-" + rtrim(convert(varchar(20), @offset_days))
		exec
			fxa_tallyqueuedtrade
				@login = @login,
				@source = "MPT Manual Tally",
				@queued_trade_id = @queued_trade_id output,
				@deal_id = @deal_id output,
				@tally_type = "Forward",
				@deal_type = "Market Forward",
				@trade_type = "Forward",
				@quantity = @balance,
				@symbol = @symbol,
				@value_date = @value_date,
				@price = @trade_price,
				@trade_date = @trade_date,
				@strategy = @strategy,
				@identifier = @trade_identifier,
				@sales_code = "None"

		select
			@trade_date = @value_date


		select
			@days = count(*)
		from
			jurisdiction_flows
		where
			collection_model_id = @collection_model_id
		and
			jurisdiction_id = @jurisdiction_id
		and
			offset_days > @offset_days

	end

	update
		batch_file_accounts
	set
		deal_id = @deal_id
	where
		batch_file_id = @batch_file_id

	select
		@batch_file_accounts = count(*)
	from
		batch_file_accounts
	where
		batch_file_id = @batch_file_id
	and
		batch_file_account_id > @batch_file_account_id
end



go
