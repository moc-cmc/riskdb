
drop procedure
	ag_importspectrumtrades
go

create procedure
	ag_importspectrumtrades
		@login varchar(50), /* Always make this the first arg in any tico proc */
		@a varchar(50)=NULL,
		@b varchar(50)=NULL,
		@c varchar(50)=NULL,
		@d varchar(50)=NULL,
		@e varchar(50)=NULL,
		@f varchar(50)=NULL,
		@g varchar(50)=NULL,
		@h varchar(50)=NULL,
		@i varchar(50)=NULL,
		@j varchar(50)=NULL,
		@k varchar(50)=NULL,
		@l varchar(50)=NULL,
		@m varchar(50)=NULL,
		@n varchar(50)=NULL,
		@o varchar(50)=NULL,
		@p varchar(50)=NULL,
		@q varchar(50)=NULL,
		@r varchar(50)=NULL,
		@s varchar(50)=NULL,
		@t varchar(50)=NULL,
		@u varchar(50)=NULL,
		@row_index int, /* Put this in any import proc */
		@row_count int /* Put this in any import proc */

as

declare @trade_date datetime
declare @trans_date datetime
declare @date datetime
declare @expiry_date datetime

declare @trade_number varchar(100)
declare @transaction_number varchar(100)

declare @counterparty varchar(100)

declare @buysell varchar(5)
declare @type varchar(50)

declare @con_cur varchar(5)
declare @currency varchar(5)
declare @cur varchar(5)
declare @counter_cur varchar(5)
declare @cur2 varchar(5)

declare @con_amount float
declare @face_amount varchar(50) 

declare @counter_currency varchar(5)

declare @counter_amount float
declare @strike varchar(50) 

declare @rate float
declare @settle_date datetime

declare @terms varchar(10)
declare @expiration datetime

declare @price float
declare @trade_price varchar(50)

declare @usd_value float
declare @opt_usd_value varchar(50)

declare @purpose varchar(50)

declare @premium_amount varchar(50) 

declare @broker varchar(50)

declare @broker_fee float
declare @opt_broker_fee varchar(50)

declare @portfolio varchar(50)

declare @trader varchar(50)

declare @external_ref varchar(50)
declare @ext_ref varchar(50)

declare @liquidity_provider varchar(50)
declare @liq_provider varchar(50)

declare @day varchar(2) 
declare @month varchar(2) 
declare @year varchar(2) 

declare @trade_id int
declare @deal_id int

declare @message varchar(250)

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"old_value_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"pb_products",
	"Prime Broker Products",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"net_vs_clients",
	"Number",
	"#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

if @d = "Buy" or @d = "Sell"
begin
	select
		@day = substring(@a, 1, 2),
		@month = substring(@a, 4,2),
		@year = substring(@a, 7, 2)

	select
		@a = @month + "/" + @day + "/" + @year
	
	select
		@date = convert(datetime, @a)
	select 
		@trade_date = convert(datetime, @a)
	

	select
                @day = substring(@k, 1, 2),
                @month = substring(@k, 4,2),
                @year = substring(@k, 7, 2)

        select
                @k = @month + "/" + @day + "/" + @year
        select
                @settle_date = convert(datetime, @k)

	select
		@trade_date = convert(datetime, @a),
		@trade_number = @b,
		@counterparty = @c,
		@buysell = @d,
		@con_cur = @e,
		@con_amount = convert(float, @f),
		@counter_currency = @g,
		@counter_amount = convert(float,@h),
		@rate = convert(float, @i),
		@terms = @j,
		@settle_date = convert(datetime, @k),
		@usd_value = convert(float, @l),
		@broker = @n,
		@broker_fee = convert(float, @o),
		@portfolio = @p,
		@trader = @q,
		@external_ref = @s,
		@liquidity_provider = @t
		

	exec
		api_tallymarkettrade
			@login=login,
			@tally_type="Spot",
			@buy_sell=@buysell,
			@dealt_currency=@con_cur,
			@counter_currency=@counter_currency,
			@counterparty_account=@counterparty,
			@quantity = @con_amount,
			@price=@rate,
			@value_date = @settle_date,
			@deal_id=@deal_id output,
			@trade_id=@trade_id output
		
	select
		msg="Spot trade tallied ",
		trade_id=@trade_id
	
end

if @d = "LEP" or @d = "SEC"
begin

	select @date = convert(datetime, @a)

	select
		@trans_date = convert(datetime, @a),
		@transaction_number = @b,
		@counterparty = @c,
		@type = @d,
		@cur = @e,
		@face_amount = @f,
		@counter_cur = @g,
                @strike = @h,
		@settle_date = convert(datetime, @i),
		@expiry_date = convert(datetime, @j),
		@trade_price = @k,
		@cur2 = @l,
		@premium_amount = @m,
		@opt_usd_value = @n,
		@purpose = @o,
		@broker = @p,
		@opt_broker_fee = @q,
		@portfolio = @r,
		@trader = @s,
		@ext_ref = @t,
		@liq_provider = @u

	exec
		ag_importspectrumoptions
			@login=@login,
			@trans_date=@trans_date,
			@transaction_number=@transaction_number,
			@counterparty=@counterparty,
			@type=@type,
			@cur=@cur,
			@face_amount=@face_amount,
			@counter_cur=@counter_cur,
			@strike=@strike,
			@settle_date=@settle_date,
			@expiry_date=@expiry_date,
			@price=@trade_price,
			@cur2=@cur2,
			@premium_amount=@premium_amount,
			@usd_value=@opt_usd_value,
			@purpose=@purpose,
			@broker=@broker,
			@broker_fee=@opt_broker_fee,
			@portfolio=@portfolio,
			@trader=@trader,
			@ext_ref=@ext_ref,
			@liq_provider=@liq_provider

	select
                msg="Option trade tallied ",
                trade_id=@trade_id

end

if @row_count = @row_index + 1
begin

	select
                @message = "Spectrum trades imported for trade date " + convert(varchar(25), @date)

	exec
		api_sendchannelmessage
			@login = @login,
			@channel = "Inbound STP",
			@message_type = "Normal",
			@subject = "Spectrum Trades Imported",
			@content = @message,
			@priority = "High"


	
end



go
