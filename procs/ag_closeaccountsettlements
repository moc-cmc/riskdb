drop procedure ag_closeaccountsettlements
go

create procedure
	ag_closeaccountsettlements
		@login varchar(50),
		@account varchar(50),
		@settle_date datetime,
		@converted_amount numeric(30,2)
as


declare @tico_account_id int
declare @fx_transaction_type_id int
declare @external_account_id int
declare @closed_account_transactions int
declare @account_transactions int
declare @account_transaction_id int
declare @last_id int
declare @sb_id int
declare @product_id int
declare @amount float
declare @transaction_date datetime
declare @converted_balance float
declare @conversion_rate float
declare @net_settlement float
declare @currency_id int
declare @new_account_transaction_id int
declare @balances int
declare @converted_status_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@converted_status_id = status_id
from
	statuses
where
	name = "Convert Settlement"

select
	@fx_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "FX Settlement"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "FX Settlement transaction type not found"
	return
end


select
	@external_account_id = external_account_id,
	@currency_id = evaluation_currency_id
from
	external_accounts
where
	symbol = @account
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

select
	@balances = count(*)
from
	settlement_balances
where
	external_account_id = @external_account_id
and
	convert(date, transaction_date) = convert(date, @settle_date)
if @balances > 0
begin
	select
		status = "Error",
		message = "Settled balances already found for account and settledate",
		account = @account,
		settle_date = @settle_date
	return
end

/* Get account transactions for date*/
create table
	#account_transactions(
		account_transaction_id int,
		entered_by int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		product_id int,
		amount float,
		note varchar(255) NULL,
		currency_id int NULL,
		conversion_rate float NULL,
		converted_amount float NULL,
                inverted char(1) NULL,
                overwrite_from_pb char(1) NULL)
insert into
	#account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		product_id,
		amount,
		note,
		currency_id)
select
	a.account_transaction_id,
	a.entered_by,
	a.external_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.currency_id,
	a.amount,
	a.note,
	b.evaluation_currency_id
from
	account_transactions a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	convert(date, a.transaction_date) = convert(date, @settle_date)
and
	a.transaction_type_id = @fx_transaction_type_id
and
	b.symbol = @account

/* Get the conversion rates that will be used by looking at the settles tables */
update
        #account_transactions
set
        conversion_rate = 1.0
where
        product_id = currency_id

/* Use bo_spot_settles for a base */
update
        #account_transactions
set
        a.conversion_rate = c.price
from
        #account_transactions a,
        forwards b,
        bo_spot_settles c
where
        a.product_id = b.product_id
and
        a.currency_id = b.currency_id
and
        b.contract_id = c.contract_id
and
        convert(date, c.price_date) = convert(date, a.transaction_date)

update
        #account_transactions
set
        a.conversion_rate = 1.0 / c.price,
        a.inverted = "Y"
from
        #account_transactions a,
        forwards b,
        bo_spot_settles c
where
        a.product_id = b.currency_id
and
        a.currency_id = b.product_id
and
        b.contract_id = c.contract_id
and
        convert(date, c.price_date) = convert(date, a.transaction_date)
and
        a.conversion_rate = NULL

/* Use pb_conversion_rates to get any other */
update
        #account_transactions
set
        a.conversion_rate = c.price,
	a.overwrite_from_pb = "Y"
from
        #account_transactions a,
        forwards b,
        pb_conversion_rates c,
        external_account_prime_brokers d
where
        a.product_id = b.product_id
and
        a.currency_id = b.currency_id
and
        b.contract_id = c.contract_id
and
        convert(date, c.price_date) = convert(date, a.transaction_date)
and
	c.prime_broker_id = d.prime_broker_id
and
	a.external_account_id = d.external_account_id

update
        #account_transactions
set
        a.conversion_rate = 1.0 / c.price,
        a.overwrite_from_pb = "Y"
from
        #account_transactions a,
        forwards b,
        pb_conversion_rates c,
        external_account_prime_brokers d
where
        a.product_id = b.currency_id
and
        a.currency_id = b.product_id
and
        b.contract_id = c.contract_id
and
        convert(date, c.price_date) = convert(date, a.transaction_date)
and
        a.inverted = "Y"
and
        c.prime_broker_id = d.prime_broker_id
and
        a.external_account_id = d.external_account_id


update
        #account_transactions
set
        converted_amount = amount * conversion_rate

select
	@account_transactions = count(*)
from
	#account_transactions
	
select
	@balances = count(*)
from
	#account_transactions 

begin tran
	update
		keys
	set
		last_id = last_id + @account_transactions
	where
		relation = "settlement_balances"

	select
		@last_id = last_id
	from
		keys
	where
		relation = "settlement_balances"
commit tran

select
	@sb_id = @last_id - @account_transactions 

/* queue the settlement balances to be saved down later */
create table
	#settlement_balances(
		sb_id int,
		account_transaction_id int,
		external_account_id int,
		transaction_date datetime,
		product_id int,
		amount float,
		converted_amount float,
		conversion_rate float)


select
	@account_transaction_id = 0

while @account_transactions > 0
begin
	select
		@account_transaction_id = min(account_transaction_id)
	from
		#account_transactions
	where
		account_transaction_id > @account_transaction_id

	select
		@sb_id = @sb_id + 1
	select
		@transaction_date = NULL,
		@product_id = NULL,
		@amount = NULL,
		@converted_balance = NULL,
		@conversion_rate = NULL

	select
		@transaction_date = transaction_date,
		@product_id = product_id,
		@amount = amount,
		@converted_balance = converted_amount,
		@conversion_rate = conversion_rate
	from
		#account_transactions
	where
		account_transaction_id = @account_transaction_id
		
	insert into
		#settlement_balances
	values(
		@sb_id,
		@account_transaction_id,
		@external_account_id,
		@transaction_date,
		@product_id,
		@amount,
		@converted_balance,
		@conversion_rate)

	select
		@account_transactions = count(*)
	from
		#account_transactions
	where
		account_transaction_id > @account_transaction_id
end

select
	@net_settlement = sum(converted_amount)
from
	#settlement_balances


if abs(@net_settlement - @converted_amount) > .01
begin
	select
		status = "Balances don't match"
	return
end

exec
	j_nextkey
		"account_transactions",
		@new_account_transaction_id output

begin tran
	/* Insert into settlement balances */

	insert into
		settlement_balances
	select
		sb_id,
		account_transaction_id,
		external_account_id,
		transaction_date,
		product_id,
		amount,
		converted_amount,
		conversion_rate
	from
		#settlement_balances
	if @@rowcount != @balances
	begin
		select
			status = "Error",
			message = "Settlement balances count match fail"
		rollback tran
		return
	end

	/* Insert into closed account transactions */
	
	insert into
		closed_account_transactions
	select
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		product_id,
		amount,
		note
	from
		#account_transactions
	if @@rowcount != @balances
	begin
		select
			status = "Error",
			message = "Closed transactions count match fail"
		rollback tran
		return
	end

	/* Delete from account transactions */

	delete
		account_transactions
	from
		account_transactions a,
		#account_transactions b
	where
		a.account_transaction_id = b.account_transaction_id
	if @@rowcount != @balances
	begin
		select
			status = "Error",
			message = "Archive transaction  count match fail"
		rollback tran
		return
	end

	/* Insert the net number into account transactions */

	insert into
		account_transactions(
			account_transaction_id,
			entered_by,
			external_account_id,
			transaction_type_id,
			transaction_date,
			currency_id,
			amount,
			note)
	values(
		@new_account_transaction_id,
		@tico_account_id,
		@external_account_id,
		@fx_transaction_type_id,
		@settle_date,
		@currency_id,
		@net_settlement,
		NULL)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to book net settlement"
		rollback tran
		return
	end

commit tran

insert into
        transaction_logs(
                settled_by,
                external_account_id,
                status_id,
		currency_id,
                amount,
                settle_date,
                timestamp)
values(
        @tico_account_id,
        @external_account_id,
        @converted_status_id,
	@currency_id,
        @net_settlement,
        @settle_date,
        getdate())


exec
	ag_closesettlebalances
		@login,
		@settle_date
	
go
