create table
	#by_deal_type(
		id int identity,
		style varchar(200) NULL,
		symbol varchar(50) NULL,
		deal_type varchar(50) NULL,
		total_volume float NULL,
		total_pl float NULL)
		
select
	@perspective_contract_id = 0
select
	@perspective_contracts = count(*)
from
	#perspective_contracts
where
	perspective_contract_id > @perspective_contract_id

while @perspective_contracts > 0
begin
	select
		@perspective_contract_id = min(perspective_contract_id)
	from
		#perspective_contracts
	where
		perspective_contract_id > @perspective_contract_id


	select
		@total_perspective_pl = NULL,
		@total_perspective_volume = NULL

	select
		@total_perspective_pl = sum(client_trade_day_pl + cpty_trade_day_pl),
		@total_perspective_volume = sum(client_volume + cpty_volume)
	from
		#deals
	where
		perspective_contract_id = @perspective_contract_id
	and
		timestamp >= @start_date

	if @total_perspective_pl != NULL
	begin

		select
			@symbol = symbol
		from
			contracts
		where
			contract_id = @perspective_contract_id

		insert into
			#by_deal_type(
				style,
				symbol)
		values(
			"background:#fff;border: 1px solid white",
			@symbol)
		
		insert into
			#by_deal_type(
				deal_type,
				total_volume,
				total_pl)
		select
			c.name,
			sum(a.client_volume + a.cpty_volume),
			sum(a.client_trade_day_pl + a.cpty_trade_day_pl)
		from
			#deals a,
			deals b,
			deal_types c
		where
			a.deal_id = b.deal_id
		and
			b.deal_type_id = c.deal_type_id
		and
			a.perspective_contract_id = @perspective_contract_id
		and
			a.timestamp >= @start_date
		group by
			c.name 
	
		update
			#by_deal_type
		set
			style = "background:#fff;border: 1px solid white"
		where
			style = NULL

		insert into
			#by_deal_type(
				style,
				deal_type,
				total_volume,
				total_pl)
		values(
			"font-weight:bold;border-bottom:2px solid #999;margin-bottom:10px;color:#963;background:#fff",
			"Total",
			@total_perspective_volume,
			@total_perspective_pl)

	end

	select
		@perspective_contracts = count(*)
	from
		#perspective_contracts
	where
		perspective_contract_id > @perspective_contract_id
end


