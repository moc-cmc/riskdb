
if object_id("xcbo_agencyrunpl") != NULL
    drop procedure
	xcbo_agencyrunpl
go

create procedure
	xcbo_agencyrunpl
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@total_pl float output,
		@total_volume float output,
		@display_output varchar(10)=NULL
as


declare @now datetime
declare @start_date datetime
declare @stop_date datetime
declare @evaluation_currency_id int
declare @source_id int
declare @run_id int
declare @fund_id int
declare @total_realized_pl float
declare @fx_realized_pl float
declare @options_realized_pl float
declare @fx_unrealized_pl float
declare @options_unrealized_pl float
declare @pos_pl float
declare @pos_end_evaluation_total float
declare @trades_end_evaluation_total float
declare @trades_pl float
declare @evaluation_currency varchar(20)
declare @source varchar(30)

declare @id int
declare @contract_id int
declare @contracts int
declare @symbol varchar(50)
declare @total_begin_unrealized float
declare @total_end_unrealized float
declare @total_settled_premium float
declare @total_unsettled_premium float
declare @total_premium float
declare @total_realized float
declare @total_fwd_unrealized float
declare @total_end_fwd_unrealized float
declare @total_fwd_realized float
declare @total_opt_unrealized float
declare @total_opt_value float
declare @total_fwd_value float

declare @total_pos_pl float
declare @total_trades_pl float
declare @total_pos_volume float
declare @total_trades_volume float
declare @day_range int
declare @trades_file varchar(30)

declare @perspective_contracts int
declare @perspective_contract_id int
declare @total_perspective_pl float
declare @total_perspective_volume float

declare @deal_id int

if lower(convert(char(1), @display_output)) = "y"
	exec
		cbo_plstatementlinks
			@login
exec
	r_defaultfundforlogin
		@login,
		@fund_id output


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end


if @begin_date = NULL
	select
		@begin_date = convert(datetime, convert(char(11), max(reval_date)))
	from
		committed_daily_revals

if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output

	select
		@start_date = @begin_date,
		@stop_date = @end_date
end
else
begin
	exec
		r_daterangefordate
			@begin_date,
			@start_date output,
			@stop_date output

	exec
		r_daterangefordate
			@end_date,
			@begin_date output,
			@stop_date output
end

select
	@evaluation_currency_id = evaluation_currency_id,
	@source_id = source_id
from
	run_defaults
where
	run_id = @run_id
if @evaluation_currency_id = NULL
begin
	select
		@evaluation_currency_id = evaluation_currency_id,
		@source_id = source_id
	from
		fund_run_defaults
	where
		fund_id = @fund_id

	if @evaluation_currency_id = NULL
	begin
		select
			id = -1,
			error = "Unable to determine default run settings"
		return
	end
end


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id 
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties


select @now = getdate()

create table
	#trades(
		trade_id int,
		deal_id int,
		external_account_id int,
		broker_id int,
		sales_code_id int,
		counterparty_id int,
		trade_date datetime NULL,
		contract_id int,
		value_date datetime NULL,
		total_premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized_pl_to_date float NULL,
		end_realized_pl_to_date float NULL,
		begin_unrealized_pl_to_date float NULL,
		end_unrealized_pl_to_date float NULL,
		realized_range_pl float NULL,
		unrealized_range_pl float NULL,
		native_value float NULL,
		end_evaluation_value float NULL,
		settle_price float NULL,
		volume float NULL,
		trade_day_pl float NULL,
		trades_pl float NULL,
		position_pl float NULL,
		total_pl float NULL)


/*
 * Find any trades that existed before the range starts
 * @start_date >= bo_trade_date <= @stop_date
 */
insert into
	#trades(
		trade_id,
		deal_id,
		external_account_id,
		broker_id,
		sales_code_id,
		counterparty_id,
		trade_date,
		contract_id,
		value_date,
		begin_realized_pl_to_date,
		begin_unrealized_pl_to_date,
		volume)
select
	a.trade_id,
	b.deal_id,
	b.external_account_id,
	b.broker_id,
	b.sales_code_id,
	b.counterparty_id,
	b.trade_date,
	a.contract_id,
	a.value_date,
	a.realized_pl_to_date,
	a.unrealized_pl_to_date,
	volume = 0
from
	committed_daily_revals a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g,
	#counterparties h
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.broker_id = g.broker_id
and
	b.counterparty_id = h.counterparty_id
and
	a.bo_trade_date < @start_date
and
	a.value_date >= @start_date
and
	a.reval_date = @start_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id


/*
 * Find any trades that were done during the range
 */
insert into
	#trades(
		trade_id,
		deal_id,
		external_account_id,
		broker_id,
		sales_code_id,
		counterparty_id,
		trade_date,
		contract_id,
		value_date,
		begin_realized_pl_to_date,
		begin_unrealized_pl_to_date,
		native_value,
		end_evaluation_value,
		settle_price,
		volume)
select
	a.trade_id,
	b.deal_id,
	b.external_account_id,
	b.broker_id,
	b.sales_code_id,
	b.counterparty_id,
	b.trade_date,	
	a.contract_id,
	a.value_date,
	realized_pl_to_date = 0.0,
	unrealized_pl_to_date = 0.0,
	a.native_value,
	a.evaluation_value,
	a.close_price,
	a.evaluation_notional
from
	committed_daily_revals a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies f,
	#brokers g,
	#counterparties h
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = f.strategy_id
and
	b.broker_id = g.broker_id
and
	b.counterparty_id = h.counterparty_id
and
	a.value_date >= @start_date
and
	a.bo_trade_date >= @start_date
and
	a.bo_trade_date < @stop_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id


/*
   Find the other side of any trades by using the linked deal id. The other
   side of the run's trades may be trades that do not match the filters for
   the current run but to calculate agency p&l (the bid/ask spread) the deal
   id can be use.
*/

/*
 * Find the set of deals we're working with
 */
create table
	#unique_deals(
		deal_id int)
insert into
	#unique_deals
select
	distinct(a.deal_id)
from
	trades a,
	#trades b
where
	a.trade_id = b.trade_id

/*
 * Find any linked trades that existed before the range starts
 * @start_date >= bo_trade_date <= @stop_date
 */
select @now = getdate()
insert into
	#trades(
		trade_id,
		deal_id,
		external_account_id,
		broker_id,
		sales_code_id,
		counterparty_id,
		trade_date,
		contract_id,
		value_date,
		begin_realized_pl_to_date,
		begin_unrealized_pl_to_date)
select
	a.trade_id,
	b.deal_id,
	b.external_account_id,
	b.broker_id,
	b.sales_code_id,
	b.counterparty_id,
	b.trade_date,
	a.contract_id,
	a.value_date,
	a.realized_pl_to_date,
	a.unrealized_pl_to_date
from
	committed_daily_revals a,
	trades b,
	#unique_deals c
where
	a.trade_id = b.trade_id
and
	b.deal_id = c.deal_id
and
	a.bo_trade_date < @start_date
and
	a.value_date >= @start_date
and
	a.reval_date = @start_date
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
and
	a.trade_id not in(
		select
			trade_id
		from
			#trades)
and
	b.trade_id not in(
		select
			trade_id
		from
			#trades)

select
	message = "finished subquery",
	total_time = datediff(millisecond, @now, getdate())
	


/*
 * Find any trades that were done during the range
 */
insert into
	#trades(
		trade_id,
		deal_id,
		external_account_id,
		broker_id,
		sales_code_id,
		counterparty_id,
		trade_date,
		contract_id,
		value_date,
		begin_realized_pl_to_date,
		begin_unrealized_pl_to_date,
		native_value,
		end_evaluation_value,
		volume,
		settle_price)
select
	a.trade_id,
	b.deal_id,
	b.external_account_id,
	b.broker_id,
	b.sales_code_id,
	b.counterparty_id,
	b.trade_date,
	a.contract_id,
	a.value_date,
	realized_pl_to_date = 0.0,
	unrealized_pl_to_date = 0.0,
	a.native_value,
	a.evaluation_value,
	a.evaluation_notional,
	a.close_price
from
	committed_daily_revals a,
	trades b,
	#unique_deals c
where
	a.trade_id = b.trade_id
and
	b.deal_id = c.deal_id
and
	a.value_date >= @start_date
and
	a.bo_trade_date >= @start_date
and
	a.bo_trade_date < @stop_date
and
	convert(char(11), a.reval_date, 1) = convert(char(11), a.bo_trade_date, 1)
and
	a.source_id = @source_id
and
	a.evaluation_currency_id = @evaluation_currency_id
and
	a.trade_id not in(
		select
			trade_id
		from
			#trades)
/*
create index ti on #trades (trade_id) */


/* End of finding deal linked trades */

update
	#trades
set
	a.end_realized_pl_to_date = b.realized_pl_to_date,
	a.end_unrealized_pl_to_date = b.unrealized_pl_to_date,
	a.realized_range_pl = b.realized_pl_to_date - a.begin_realized_pl_to_date,
	a.unrealized_range_pl = b.unrealized_pl_to_date - a.begin_unrealized_pl_to_date,
	a.settle_price = b.close_price,
	a.native_value = b.native_value,
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id
and
	convert(char(11), b.reval_date, 1) = convert(char(11), b.value_date, 1)
and
	b.reval_date <= @stop_date 


update
	#trades
set
	a.end_realized_pl_to_date = b.realized_pl_to_date,
	a.end_unrealized_pl_to_date = b.unrealized_pl_to_date,
	a.realized_range_pl = b.realized_pl_to_date - a.begin_realized_pl_to_date,
	a.unrealized_range_pl = b.unrealized_pl_to_date - a.begin_unrealized_pl_to_date,
	a.settle_price = b.close_price,
	a.native_value = b.native_value,
	a.end_evaluation_value = b.evaluation_value 
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.reval_date = @stop_date
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id


update
	#trades
set
	a.native_value = b.native_value,
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	datepart(day, b.reval_date) = datepart(day, b.value_date)
and
	datepart(month, b.reval_date) = datepart(month, b.value_date)
and
	datepart(year, b.reval_date) = datepart(year, b.value_date)
and
	b.reval_date <= @stop_date


update
	#trades
set
	a.native_value = b.native_value,
	a.end_evaluation_value = b.evaluation_value
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	a.end_evaluation_value is NULL
and
	b.reval_date = @stop_date


update
	#trades
set
	a.end_unrealized_pl_to_date = 0,
	a.unrealized_range_pl = 0
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	a.unrealized_range_pl is NULL


update
	#trades
set
	a.total_premium = b.premium,
	a.premium_settle_date = b.premium_settle_date
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id
and
	b.source_id = @source_id
	
/* NEW SECTION */
update
	#trades
set
	a.trade_day_pl = b.realized_pl_to_date + b.unrealized_pl_to_date
from
	#trades a,
	committed_daily_revals b
where
	a.trade_id = b.trade_id
and
	b.source_id = @source_id
and
	b.evaluation_currency_id = @evaluation_currency_id
and
	convert(char(11), b.bo_trade_date, 1) = convert(char(11), b.reval_date, 1)

update
	#trades
set
	a.trade_day_pl = 0.0
from
	#trades a,
	trades b
where
	a.trade_id = b.trade_id
and
	b.price = 0.0

update
	#trades
set
	trades_pl = trade_day_pl
where
	trade_date >= @start_date


update
	#trades
set
	trades_pl = 0.0
where
	trades_pl = NULL
	

update
	#trades
set
	position_pl = (realized_range_pl + unrealized_range_pl)
where
	trade_date < @start_date 

update
	#trades
set
	position_pl = (end_unrealized_pl_to_date + end_realized_pl_to_date) - trade_day_pl
where
	trade_date >= @start_date

update
	#trades
set
	position_pl = 0.0
where
	position_pl = NULL


update
	#trades
set
	total_pl = trades_pl + position_pl

/* zero out the volume for any internal trades */
update
	#trades
set
	a.volume = 0.0
from
	#trades a,
	trades b,
	external_accounts c,
	external_account_types d
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	c.external_account_type_id = d.external_account_type_id
and
	d.name = "Internal"
	
select
	message = "Finished gathering and evaluating trades",
	total_time = datediff(millisecond, @now, getdate())

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

select
	@source = name
from
	sources
where
	source_id = @source_id

select
	@day_range = datediff(day, @start_date, @stop_date)

if @day_range <= 3
	select
		@trades_file = "TRADES FILE"
else
	select
		@trades_file = NULL
		


if lower(convert(char(1), @display_output)) = "y"
	select
		run_name = @run_name,
		begin_date = @start_date,
		end_date = @stop_date,
		run_date = getdate(),
		evaluation_currency = @evaluation_currency,
		evaluation_source_id = @source,
		trades_file = @trades_file

select
	@now = getdate()

create table
	#trade_revals(
		trade_id int,
		deal_id int,
		external_account_id int,
		external_account_type_id int,
		broker_id int,
		sales_code_id int,
		counterparty_id int,
		trade_date char(11),
		contract_id int,
		underlying_forward_id int NULL,
		perspective_contract_id int NULL,
		symbol varchar(50),
		quantity numeric(30,4),
		price float,
		value_date datetime,
		premium float NULL,
		premium_settle_date datetime NULL,
		begin_realized float NULL,
		end_realized float NULL,
		begin_unrealized float NULL,
		end_unrealized float NULL,
		realized_range float NULL,
		unrealized_range float NULL,
		native_value float NULL,
		ending_valuation float NULL,
		settle_price float NULL,
		volume float NULL,
		trade_day_pl float NULL,
		position_pl float NULL,
		trades_pl float NULL,
		total_pl float NULL)

insert into
	#trade_revals
select
	a.trade_id,
	a.deal_id,
	a.external_account_id,
	d.external_account_type_id,
	b.broker_id,
	b.sales_code_id,
	b.counterparty_id,
	trade_date = convert(char(11), b.trade_date, 1),
	a.contract_id,
	underlying_forward_id = NULL,
	perspective_contract_id = NULL,
	c.symbol,
	b.quantity,
	b.price,
	/* value_date = convert(char(11), (select max(d.value_date) from committed_daily_revals d where a.trade_id = d.trade_id), 1), */
	/* value_date = (select max(d.value_date) from committed_daily_revals d where a.trade_id = d.trade_id), */
	a.value_date,
	premium = a.total_premium,
	a.premium_settle_date,
	begin_realized = a.begin_realized_pl_to_date,
	end_realized = a.end_realized_pl_to_date,
	begin_unrealized = a.begin_unrealized_pl_to_date,
	end_unrealized = a.end_unrealized_pl_to_date,
	realized_range = a.realized_range_pl,
	unrealized_range = a.unrealized_range_pl,
	native_value = a.native_value,
	ending_valuation = a.end_evaluation_value,
	settle_price = a.settle_price,
	volume = a.volume,
	trade_day_pl = a.trade_day_pl,
	position_pl = a.position_pl,
	trades_pl = a.trades_pl,
	total_pl = a.total_pl
from
	#trades a,
	trades b,
	contracts c,
	external_accounts d
where
	a.trade_id = b.trade_id
and
	b.contract_id = c.contract_id
and
	b.external_account_id = d.external_account_id


update
	#trade_revals
set
	a.underlying_forward_id = a.contract_id
from
	#trade_revals a,
	forwards b
where
	a.contract_id = b.contract_id


update
	#trade_revals
set
	a.underlying_forward_id = c.forward_id
from
	#trade_revals a,
	future_contracts b,
	futures c
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id

update
	#trade_revals
set
	a.underlying_forward_id = f.forward_id
from
	#trade_revals a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
