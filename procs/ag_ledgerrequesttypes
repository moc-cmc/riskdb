use
	risk_sjmdemo
go

drop procedure
	ag_ledgerrequesttypes
go

create procedure
	ag_ledgerrequesttypes
		@login varchar(50)
as

declare @fund_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"back",
	"Client Transfers Home",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"add_ledger_request_type",
	"Add Ledger Request Type",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


select
	style = @style,
	back = "Back To Client Transfers Home",
	add_ledger_request_type = "Add Ledger Request Type"


select
	style = @style,
	request_type = a.name,
	create_pending_on = b.name,
	sweep_pending_on = c.name,
	cancel_pending_on = d.name
from
	ledger_request_types a,
	statuses b,
	statuses c,
	statuses d
where
	a.create_pending_status_id = b.status_id
and
	a.sweep_pending_status_id = c.status_id
and
	a.cancel_pending_status_id = d.status_id
order by
	a.name





go


