create or replace procedure
	r_enableuserforcognitopool
		@login varchar(50),
		@legal_entity varchar(50),
		@mfa_login varchar(50),	
		@mfa_phone_number varchar(50),
		@user_pool varchar(50),
		@mfa_type varchar(50)=NULL

as

if @mfa_type = NULL
begin
	select
		@mfa_type = "SMS"
end

exec
	api_enableuserforcognitopool
		@login=@login,
		@mfa_login = @mfa_login,
		@mfa_phone_number = @mfa_phone_number,
		@user_pool = @user_pool,
		@mfa_type = @mfa_type

	
exec
	ag_legalentitieshome
		@login=@login,
		@legal_entity=@legal_entity

	

go	

	
		
	



