
if object_id("fxa_addreporttrade") != NULL
    drop procedure
        fxa_addreporttrade
go

create procedure
	fxa_addreporttrade
        	@report_trade_id 		int 		=NULL,
        	@report_deal_id 		int 		=NULL,
        	@report_commit_id 		int 		,
        	@import_date 			datetime 	=NULL,
        	@trade_type_id 			int 		=NULL,
		@trade_type 			varchar(25) 	=NULL,
        	@external_account_type_id 	int 		=NULL,
                @external_account_type 		varchar(75) 	=NULL,
        	@external_account_id 		int 		=NULL,
                @external_account 		varchar(75) 	=NULL,
        	@counterparty_id 		int 		=NULL,
                @counterparty	 		varchar(75) 	=NULL,
        	@quantity 			numeric(30,4) 	,
        	@contract_id 			int 		=NULL,
		@contract			varchar(50)	=NULL,
        	@value_date 			datetime 	=NULL,
        	@fixing_date 			datetime 	=NULL,
        	@price 				float 		,
        	@trade_date 			datetime 	,
        	@trader_id 			int		=NULL,
		@trader				varchar(50)	=NULL,
        	@strategy_id 			int 		=NULL,
		@strategy			varchar(50)	=NULL,
        	@status_id 			int 		=NULL,
		@status				varchar(50)	=NULL,
        	@broker_id 			int 		=NULL,
		@broker				varchar(50)	=NULL,
        	@identifier		 	varchar(100) 	,
        	@pct_price 			numeric(30,6) 	=NULL,
        	@spot_reference 		float 		=NULL,
        	@reporter_identifier 		varchar(100) 	=NULL,
        	@trade_id 			int 		=NULL

as


if exists(select identifier from report_trades where identifier = @identifier)
begin
	select
		status = "Dupe",
		msg = "Report trade already exists",
		identifier = @identifier
	return
end
			
if @report_trade_id = NULL
begin	
	exec
		j_nextkey
			"report_trades",
			@report_trade_id output
	if @report_trade_id = NULL
	begin
		select
			error = "Error",
			msg = "Problem determining report trade id"
		return	
	end
end

/*
if @report_deal_id = NULL
begin
	exec
		j_nextkey
			"report_deals",
			@report_deal_id output

	if @report_deal_id = NULL
	begin
		select
			error = "Error",
			msg = "Problem determining report deal id"
		return	
	end
end
*/

if @report_commit_id = NULL
begin
	select 
		error = "Error",
		msg = "Report commit id not provided"
	return
end

if @import_date = NULL
	select
		@import_date = getdate()

if @trade_type_id = NULL
begin
	select	
		@trade_type_id = trade_type_id
	from	
		trade_types
	where
		name = @trade_type
	if @trade_type_id = NULL
	begin
		select
			error = "Error",
			msg = "Problem determining trade type from",
			trade_type = @trade_type
		return
	end
end

if @external_account_type_id = NULL
begin
        select
                @external_account_type_id = external_account_type_id
        from
                external_account_types
        where
                name = @external_account_type
        if @external_account_type_id = NULL
        begin
                select
                        error = "Error",
                        msg = "Problem determining external account type from",
                        external_account_type = @external_account_type
                return
        end
end


if @external_account_id = NULL
begin
        select
                @external_account_id = external_account_id
        from
                external_accounts
        where
                symbol = @external_account
        if @external_account_id = NULL
        begin
                select
                        error = "Error",
                        msg = "Problem determining external account from",
                        external_account = @external_account
                return
        end
end

if @counterparty_id = NULL
begin
        select
                @counterparty_id = counterparty_id
        from
                counterparties
        where
                name = @counterparty
        if @counterparty_id = NULL
        begin
                select
                        error = "Error",
                        msg = "Problem determining counterparty from",
                        counterparty = @counterparty
                return
        end
end


if @contract_id = NULL
begin
	select
		@contract_id = contract_id
	from
		contracts
	where
		symbol = @contract
	if @contract_id = NULL
	begin
		select
			error = "Error",
			msg = "Problem determining contract",
			contract = @contract
		return
	end
end


if @trader_id = NULL
begin
        select
                @trader_id = trader_id 
        from
                traders
        where
                symbol = @trader
end


if @strategy_id = NULL
begin
        select
                @strategy_id = strategy_id
        from
                strategies
        where
                name = @strategy
end


if @status_id = NULL
begin
        select
                @status_id = status_id
        from
                statuses
        where
                name = @status
        if @status_id = NULL
        begin
                select
                        error = "Error",
                        msg = "Problem determining status",
                        status = @status
                return
        end
end


if @broker_id = NULL
begin
        select
                @broker_id = broker_id
        from
                brokers
        where
                symbol = @broker
end


insert into
	report_trades(
        	report_trade_id, /* not an identitiy */
        	report_deal_id,
        	report_commit_id,
        	import_date ,
        	trade_type_id,
        	external_account_type_id,
        	external_account_id,
        	counterparty_id,
        	quantity,
        	contract_id,
        	value_date ,
        	fixing_date ,
        	price,
        	trade_date ,
        	trader_id,
        	strategy_id,
        	status_id,
        	broker_id,
        	identifier,
        	pct_price,
        	spot_reference,
        	reporter_identifier,
        	trade_id)
	values(
		@report_trade_id, /* not an identitiy */
                @report_deal_id,
                @report_commit_id,
                @import_date ,
                @trade_type_id,
                @external_account_type_id,
                @external_account_id,
                @counterparty_id,
                @quantity,
                @contract_id,
                @value_date ,
                @fixing_date ,
                @price,
                @trade_date ,
                @trader_id,
                @strategy_id,
                @status_id,
                @broker_id,
                @identifier,
                @pct_price,
                @spot_reference,
                @reporter_identifier,
                @trade_id)



go



























