
if object_id("cl_dailyperformance") != NULL
    drop procedure
        cl_dailyperformance
go
 
create procedure
	cl_dailyperformance
		@login char(30),
		@portfolio char(100),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @run_id int
declare @month char(2)
declare @year char(4)
declare @datestring char(20)
declare @first_transaction datetime
declare @most_recent_commit datetime
declare @transaction_type_id int
declare @deposit_transaction_type_id int

select
    graphs = '<div style="width:100%"><div id="graphs" style="height:200px;background:#fff;margin:0 -4px;"></div></div>'

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)

insert into
	#links
values(
	"Column Link",
	"lifetime", 
 	"Historical Performance",
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments from #links

select
	@deposit_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Deposit"
if @deposit_transaction_type_id= NULL
begin
	select
		status = "Error",
		message = "Deposit transaction type not found"
	return
end

select
	@first_transaction = min(a.transaction_date)
from
	int_account_transactions a,
	internal_accounts b
where
	a.internal_account_id = b.internal_account_id
and
	b.symbol = @portfolio
and
	a.transaction_type_id = @deposit_transaction_type_id

if @first_transaction = NULL
begin
	select
		status = "Error",
		message = "No initial deposit found"
	return
end

select
	lifetime = "RUN LIFETIME",
	portfolio = @portfolio,
	begin_date = @first_transaction

if @begin_date = NULL or @begin_date = ""
begin
	select
		@transaction_type_id = transaction_type_id
	from
		transaction_types
	where
		name = "Front Office Commit"


	select
		@most_recent_commit = max(a.transaction_date)
	from
		int_account_transactions a,
		internal_accounts b
	where 
		a.internal_account_id = b.internal_account_id
	and
		b.symbol = @portfolio
	and
		a.transaction_type_id = @transaction_type_id
	

	if @most_recent_commit = NULL
		select
			@most_recent_commit = @first_transaction
		
		 
	select
		@month = convert(char(2), datepart(month, @most_recent_commit)),
		@year = convert(char(4), datepart(year, @most_recent_commit))
	select
		@datestring = @month + "/1/" + @year
	select
		@begin_date = convert(datetime, @datestring)
end

select
	@run_id = a.run_id
from
	runs a,
 
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @portfolio
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Portfolio not found"
	return
end

exec
	f_portfoliotransactions
		@portfolio,
		"Daily",
		@begin_date,
		@end_date
        
select
    '<script type="text/javascript">jQuery("#graphs").chart(jQuery(".OutputTable").eq(2), { xaxis:{type:"date"}, series:[{x1:1,y1:10}], bind:{rowStart:2}})</script>'

go
