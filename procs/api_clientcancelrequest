use
	risk_sjmdemo
go

drop procedure
	api_clientcancelrequest
go

create procedure
	api_clientcancelrequest
		@login varchar(50),
		@ledger_request_id int,
		@from_status varchar(50),
		@to_status varchar(50),
		@edit_result varchar(100) output

as

declare @tico_account_id int
declare @admin_level int
declare @account_type varchar(50)
declare @access_level varchar(50)
declare @account varchar(50)
declare @from_status_id int
declare @to_status_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		@edit_result = "Failure"
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@from_status_id = status_id
from
	statuses
where
	name = @from_status
if @from_status_id = NULL
begin
	select
		@edit_result = "Failure"
	select
		status = "Error",
		message = "From status not found",
		from_status = @from_status
	return
end

select
	@to_status_id = status_id
from
	statuses
where
	name = @to_status
if @to_status_id = NULL
begin
	select
		@edit_result = "Failure"
	select
		status = "Error",
		message = "To status not found",
		to_status = @to_status
	return
end


select
	@account = c.symbol
from
	ledger_requests a,
	bo_master_accounts b,
	external_accounts c
where
	a.bo_master_account_id = b.bo_master_account_id
and
	b.external_account_id = c.external_account_id
and
	a.ledger_request_id = @ledger_request_id


exec
	ag_validateclientaccount
		@login = @login,
		@account = @account,
		@account_type = @account_type output,
		@access_level = @access_level output

if @access_level != "Request and Cancel"
begin
	select
		@edit_result = "Failure"
	select
		status = "Error",
		message = "Access level does not support this action"
	return
end


begin tran
	insert into
		ledger_request_edits(
			ledger_request_id, 
			requestor_id,
			status_id,
			outside_account_id,
			bo_master_account_id,
			custodial_account_id,
			ledger_request_type_id,
			product_id,
			amount,
			transaction_date,
			request_date,
			edited_by,
			timestamp)
	select
		ledger_request_id, 
		requestor_id,
		status_id,
		outside_account_id,
		bo_master_account_id,
		custodial_account_id,
		ledger_request_type_id,
		product_id,
		amount,
		transaction_date,
		request_date,
		edited_by = @tico_account_id,
		timestamp = getdate()
	from
		ledger_requests
	where
		ledger_request_id = @ledger_request_id
	and
		status_id = @from_status_id
	if @@rowcount != 1
	begin
		select
			@edit_result = "Failure"
		select
			status = "Error",
			message = "Edit failed. Unable to archive request",
			ledger_request_id = @ledger_request_id,
			from_status = @from_status,
			to_status = @to_status
		rollback tran
		return
	end

	update
		ledger_requests
	set
		status_id = @to_status_id
	where
		ledger_request_id = @ledger_request_id
	and
		status_id = @from_status_id
	if @@rowcount != 1
	begin
		select
			@edit_result = "Failure"
		select
			status = "Error",
			message = "Unable to edit ledger request",
			ledger_request_id = @ledger_request_id,
			from_status = @from_status,
			to_status = @to_status
		rollback tran
		return
	end
commit tran

select
	@edit_result = "Success"
exec
	r_processledgerrequest
		@login = @login,
		@ledger_request_id = @ledger_request_id


