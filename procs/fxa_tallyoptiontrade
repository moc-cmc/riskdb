
if object_id("fxa_tallyoptiontrade") != null
    drop procedure
        fxa_tallyoptiontrade
go

create procedure
	fxa_tallyoptiontrade
		@login char(25),
		@source varchar(50),
		@trade_date datetime,
		@identifier varchar(100)=NULL,
		@trade_id int output,
		@deal_id int output,
		@tally_type varchar(25),
		@deal_type varchar(50),
		@trade_type varchar(25),
		@internal_account varchar(50)=NULL,
		@external_account varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@trader varchar(25)=NULL,
		@quantity numeric(30,4),
		@symbol varchar(50)=NULL,
		@biproduct varchar(50)=NULL,
		@timezone varchar(25)=NULL,
		@expiration datetime=NULL,
		@option_settledate datetime=NULL,
		@strike numeric(30,4)=NULL,
		@put_call varchar(5)=NULL,
		@value_date datetime,
		@fixing_date datetime=NULL,
		@price float,
		@broker varchar(50)=NULL,
		@strategy varchar(50)=NULL,
		@sales_code varchar(25)=NULL,
		@status varchar(50)=NULL,
		@premium float=NULL,
		@premium_currency varchar(25)=NULL,
		@prem_settle_date datetime=NULL,
		@conversion_rate float,
		@pct_price float=NULL,
		@spot_reference float=NULL,
		@implied_volatility float=NULL,
        @pipping_schedule varchar(50)=NULL
as

/* DEBUGGING
select
    "params fxa_tallyoptiontrade",
    login = @login,
    source = @source,
    trade_date = @trade_date,
    identifier = @identifier,
    trade_id = @trade_id,
    deal_id = @deal_id,
    tally_type = @tally_type,
    deal_type = @deal_type,
    trade_type = @trade_type,
    internal_account = @internal_account,
    external_account = @external_account,
    counterparty = @counterparty,
    trader = @trader,
    quantity = @quantity,
    symbol = @symbol,
    biproduct = @biproduct,
    timezone = @timezone,
    expiration = @expiration,
    option_settledate = @option_settledate,
    strike = @strike,
    put_call = @put_call,
    value_date = @value_date,
    fixing_date = @fixing_date,
    price = @price,
    broker = @broker,
    strategy = @strategy,
    sales_code = @sales_code,
    status = @status,
    premium = @premium,
    premium_currency = @premium_currency,
    prem_settle_date = @prem_settle_date,
    conversion_rate = @conversion_rate,
    pct_price = @pct_price,
    spot_reference = @spot_reference,
    implied_volatility = @implied_volatility,
    pipping_schedule = @pipping_schedule
*/

declare @pips_price float
declare @contract_id int
declare @native_premium float
declare @price_style varchar(50)
declare @underlying_contract_id int
declare @true_conversion_rate float
declare @fund_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

if @premium_currency = NULL
begin
    select
        @premium_currency = a.symbol
    from
        products a,
        funds b
    where
        a.product_id = b.evaluation_currency_id
    and
        b.fund_id = @fund_id
    if @premium_currency = NULL
    begin
        select
            status = "Error",
            message = "Default premium currency not found"
        return
    end
end


select
	@underlying_contract_id = contract_id
from
	contracts
where
	symbol = @biproduct
if @underlying_contract_id = NULL
begin
	select
		status = "Error",
		message = "Biproduct not found",
		biproduct = @biproduct
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @underlying_contract_id
if @price_style = "Inverted"
	select
		@true_conversion_rate = 1.0 / @conversion_rate
else
	select
		@true_conversion_rate = @conversion_rate


select
	@native_premium = @premium * @true_conversion_rate

select
	@pips_price = @native_premium / @quantity

if @tally_type = NULL
    select
        @tally_type = "Option"
if @tally_type != "Option"
begin
    select
        status = "Error",
        message = "Tally type must be 'Option'",
        tally_type = @tally_type
    return
end

/* MARK: FIND @symbol using r_spotoptioncontract
 * Find or create the option contract */
if @symbol = NULL
begin

    if @biproduct = NULL or @timezone = NULL or @expiration = NULL or @put_call = NULL or @strike = NULL or @option_settledate = NULL
    begin
        select
            status = "Error",
            message = "Can't resolve option without biproduct, timezone, expiration, call/put, strike and settle date",
            biproduct = @biproduct,
            timezone = @timezone,
            expiration = @expiration,
            put_call = @put_call,
            strike = @strike,
            option_settledate = @option_settledate
        return
    end

    exec
        r_spotoptioncontract
            @biproduct,
            @timezone,
            @expiration,
            @put_call,
            @strike,
            @option_settledate,
            @contract_id output

    select
        @symbol = symbol
    from
        contracts
    where
        contract_id = @contract_id

end

/* DEBUGGING
select
    "exec fxa_tallytrade",
    login = @login,
    source = "MPT Manual Tally",
    trade_id = @trade_id,
    deal_id = @deal_id,
    tally_type = @tally_type,
    deal_type = "Market Option",
    trade_type = "Option",
    internal_account = @internal_account,
    external_account = @external_account,
    counterparty = @counterparty,
    quantity = @quantity,
    symbol = @symbol,
    value_date = @option_settledate,
    price = @pips_price,
    trade_date = @trade_date,
    trader = @trader,
    strategy = @strategy,
    status = @status,
    broker = @broker,
    identifier = @identifier,
    sales_code = @sales_code,
    premium = @premium,
    premium_currency = @premium_currency,
    prem_settle_date = @prem_settle_date,
    pct_price = @pct_price,
    spot_reference = @spot_reference,
    fixing_date = @fixing_date,
    pipping_schedule = @pipping_schedule
*/

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Market Option",
		@trade_type = "Option",
        @internal_account = @internal_account,
		@external_account = @external_account,
		@counterparty = @counterparty,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @option_settledate,
		@price = @pips_price,
		@trade_date = @trade_date,
        @trader = @trader,
        @strategy = @strategy,
        @status = @status,
        @broker = @broker,
		@identifier = @identifier,
		@sales_code = @sales_code,
		@premium = @premium,
		@premium_currency = @premium_currency,
		@prem_settle_date = @prem_settle_date,
        @pct_price = @pct_price,
		@spot_reference = @spot_reference,
		@fixing_date = @fixing_date,
        @pipping_schedule = @pipping_schedule

exec
    r_inserttradenotification
        @trade_id

select
	@implied_volatility = @implied_volatility / 100.00

exec
	r_initializeoptcontract
		@symbol,
		@implied_volatility

go
