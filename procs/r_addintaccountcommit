
if object_id("r_addintaccountcommit") != NULL
    drop procedure
        r_addintaccountcommit
go

create procedure
	r_addintaccountcommit
		@login char(25),
		@account char(50),
		@commit_date datetime,
		@amount float,
		@note char(255)=NULL
as

declare @account_transaction_id int
declare @account_id int
declare @commit_transaction_type_id int
declare @internal_account_id int
declare @message char(255)
declare @total int

select
	@account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end


select
	@commit_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Front Office Commit"
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Could not find the P&L Commit transaction type"
	return
end

select
	@internal_account_id = internal_account_id
from
	internal_accounts
where
	symbol = @account
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding account",
		account = @account
	return
end

select
	@total = count(*)
from
	int_account_transactions
where
	internal_account_id = @internal_account_id
and
	transaction_type_id = @commit_transaction_type_id
and
	transaction_date = @commit_date
if @total != 0
begin
	select
		id = -1,
		error = "P&L for this account and date have already been committed"
	return
end
	

begin tran
	update
		keys
	set
		last_id = last_id + 1
	where
		relation = "account_transactions"
	select
		@account_transaction_id = last_id
	from
		keys
	where
		relation = "account_transactions"
commit tran

begin tran
	insert into
		int_account_transactions
	values(
		@account_transaction_id,
		@account_id,
		@internal_account_id,
		@commit_transaction_type_id,
		@commit_date,
		@amount,
		@note)
	if @@rowcount != 1
	begin
		select
			id = -1,
			error = "Problem adding commit",
			account = @account,
			commit_date = @commit_date,
			amount = @amount
		rollback tran
		return
	end

	/* if @account != "Twenty Day"
	begin
		select
			int_account_transaction_id = @account_transaction_id
		insert into
			exposure_commit_queue
		values(
			@account_transaction_id)
	end */
commit tran

select
	id = 0,
	msg = "Successfully added commit",
	account = @account,
	commit_date = @commit_date,
	amount = @amount

