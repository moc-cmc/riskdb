
if object_id("cl_tradeallocations") != NULL
    drop procedure
        cl_tradeallocations
go

create procedure
	cl_tradeallocations
		@login char(30)
as

declare @fund_id int
declare @funds int
declare @tico_account_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount = 0
begin
	select
		id = -1,
		error = "Problem determining current user"
	return
end


select
	@fund_id = 0
select
	@funds = count(*)
from
	fund_tico_accounts
where
	fund_id > @fund_id
and
	tico_account_id = @tico_account_id


while @funds > 0
begin

	select
		@fund_id = min(fund_id)
	from
		fund_tico_accounts
	where
		fund_id > @fund_id
	and
		tico_account_id = @tico_account_id	

	exec
		r_spotallocations
			@fund_id
	exec
		r_futureallocations
			@fund_id
	select
		@funds = count(*)
	from
		fund_tico_accounts
	where
		fund_id > @fund_id
	and
		tico_account_id = @tico_account_id
end

go
