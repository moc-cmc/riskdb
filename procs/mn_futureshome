use
	risk_cc
go

drop procedure
	mn_futureshome
go

create procedure
	mn_futureshome
		@login varchar(50)
as

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"not_currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"expirations",
	"Future Contract Expirations",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"new_future",
	"Add New Future",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"total_pl",
	"Number",
	"#,##0.00")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta


select
	section = "Add Future",
	style = "background:#FFFFFF;border: 1px solid white",
	new_future = "Add new future"

select
	section = "Futures Subscriptions",
	style = "background:#FFFFFF;border: 1px solid white",
	a.name,
	a.root_symbol,
	exchange = d.name,
	currency = c.symbol,
	contract_size = a.quantity,
	expirations = "Expiration",
	edit_future = "EDIT"
from
	futures a,
	forwards b,
	products c,
	exchanges d
where
	a.forward_id = b.contract_id
and
	b.currency_id = c.product_id
and
	a.exchange_id = d.exchange_id
order by
	d.name,
	a.name



go
