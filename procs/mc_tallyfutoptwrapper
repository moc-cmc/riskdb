
if object_id("mc_tallyfutoptwrapper") != NULL
    drop procedure
        mc_tallyfutoptwrapper
go

create procedure
	mc_tallyfutoptwrapper
		@login varchar(25),
		@buy_sell varchar(5),
		@trader varchar(25),
		@expiration_symbol varchar(50),
		@strike numeric(30,4),
		@call_put varchar(10),
		@quantity numeric(30,2),
		@price float,
		@implied_volatility float
as

declare @fund_id int
declare @trade_id int
declare @trade_date datetime
declare @deal_id int
declare @external_account varchar(50)
declare @sales_code varchar(50)
declare @trade_type varchar(25)
declare @external_account_id int
declare @percentage float
declare @trade_quantity numeric(30,4)
declare @id int
declare @ids int
declare @tally_type varchar(50)
declare @value_date datetime
declare @symbol varchar(50)
declare @contract_id int
declare @total_premium float
declare @premium_currency varchar(25)
declare @premium_currency_id int
declare @premium_settle datetime
declare @strike_string varchar(50)


select
	@tally_type = "Future Option"

exec
	r_defaultfundforlogin
		@login,
		@fund_id output
if @buy_sell = "Sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @buy_sell = "Buy"
begin
	select
		@quantity = abs(@quantity)
end


create table
	#allocs(
		id int identity,
		external_account_id int,
		percentage float,
		quantity int NULL)

insert into
	#allocs(
		external_account_id,
		percentage,
		quantity)
select
	external_account_id,
	percentage,
	convert(int, @quantity * percentage)
from
	external_spot_allocations
where	
	fund_id = @fund_id


select
	@trade_quantity = sum(quantity)
from
	#allocs

select
	@trade_quantity = @quantity - @trade_quantity

select
	@external_account_id = remainder_ext_account_id
from
	external_spot_allocations
where
	fund_id = @fund_id


select
	@percentage = sum(percentage)
from
	#allocs

select
	@percentage = 1.0 - @percentage

insert into
	#allocs(
		external_account_id,
		percentage,
		quantity)
values(
	@external_account_id,
	@percentage,
	@trade_quantity)



select
	@sales_code = "None"


select
	@call_put = upper(convert(char(1), @call_put))

select
	@trade_date = getdate()

select
	@trade_type = @tally_type

select
	@strike_string = convert(varchar(50), @strike)

exec
	r_optioncontract
		@expiration_symbol,
		@strike_string,
		@call_put,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id

select
	@value_date = a.expiration
from
	option_expirations a,
	option_contracts b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.contract_id = @contract_id

exec
	r_contractcurrency
		@contract_id,
		@premium_currency_id output

select
	@premium_currency = symbol
from
	products
where
	product_id = @premium_currency_id

select
	@id = 0
select
	@ids = count(*)
from
	#allocs
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#allocs
	where
		id > @id

	select
		@external_account_id = external_account_id,
		@percentage = percentage,
		@trade_quantity = quantity
	from
		#allocs
	where
		id = @id


	select
		@external_account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	select
		@trade_id = NULL

	select
		@total_premium = @trade_quantity * @price * -1.0

	select
		@premium_settle = @trade_date

	exec
		fxa_tallytrade
			@login = @login,
			@source = "MPT Manual Tally",
			@trade_id = @trade_id output,
			@deal_id = @deal_id output,
			@tally_type = @tally_type,
			@deal_type = "Market Fut Option",
			@trade_type = @trade_type,	
			@external_account = @external_account,
			@quantity = @trade_quantity,
			@symbol = @symbol,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@sales_code = @sales_code,
			@premium = @total_premium,
			@premium_currency = @premium_currency,
			@prem_settle_date = @premium_settle
	
	select
		@ids = count(*)
	from
		#allocs
	where
		id > @id
end

select
	@implied_volatility = @implied_volatility / 100.00

exec
	r_initializeoptcontract
		@symbol,
		@implied_volatility

exec
	r_inspectdealtrades
		@login,
		@deal_id



go
