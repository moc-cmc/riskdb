create procedure
	r_valdatecashladder
		@login char(30),
		@run_name char(200),
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @run_id int
declare @begin_day_string char(20)
declare @end_day_string char(20)

declare @starting_date datetime
declare @ending_date datetime

declare @products int
declare @product_id int
declare @get_product_qty float
declare @give_product_qty float
declare @exposure float
declare @usd_equiv float
declare @usd_product_id int
declare @ladder_id int
declare @ladders int
declare @total float
declare @total_usd float

declare @total_shorts float
declare @total_longs float
declare @total_opt_shorts float
declare @total_opt_longs float

declare @contract_id int
declare @contracts int
declare @position float
declare @perspective_contract_id int
declare @delta float
declare @give_product_id int
declare @get_product_id int
declare @multiplier float
declare @price float
declare @symbol char(100)
declare @symbols int

declare @spot_longs float
declare @spot_longs_usd float
declare @option_longs float
declare @option_longs_usd float
declare @spot_shorts float
declare @spot_shorts_usd float
declare @option_shorts float
declare @option_shorts_usd float
declare @ordering int
declare @product_total_usd_equiv float
declare @net_limit_use float
declare @value_date datetime
declare @value_dates int

select
	@run_id = a.run_id
from
	user_runs a,
	tico_accounts b,
	runs c
where
	a.tico_account_id = b.account_id
and
	a.run_id = c.run_id
and
	b.login = @login
and
	c.name = @run_name
if @@rowcount != 1
begin
	select
		error = "Run not found"
	return
end

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Column Format",
	"total_shorts",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"total_longs",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"quantity",
	"Number",
	"#,###")

insert into
	#meta
values(
	"Column Format",
	"usd_equiv",
	"Number",
	"#,###")

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)



select * from #meta

select
	@starting_date = @begin_date,
	@ending_date = @end_date


create table
	#runs(
		run_id int)

insert into
	#runs
select
	run_id
from
	runs
where
	name = @run_name 

select
	@usd_product_id = product_id
from
	products
where
	symbol = "USD"
if @usd_product_id = NULL
begin
	select
		id = -1,
		error = "Problem finding USD product!!"
	return
end


if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)




