create table
	#get_products(
		product_id int,
		quantity float,
		value_date datetime)

insert into
	#get_products
select
	a.product_id,
	sum(b.quantity),
	max(b.value_date)
from
	forwards a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies g
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = g.strategy_id
and
	b.trade_date <= @end_date
and
	b.value_date >= @begin_date
group by
	a.product_id,
	b.value_date


create table
	#give_products(
		product_id int,
		quantity float,
		value_date datetime)

insert into
	#give_products
select
	a.currency_id,
	sum(b.quantity * a.quantity * b.price * -1),
	max(b.value_date)
from
	forwards a,
	trades b,
	#external_accounts c,
	#internal_accounts d,
	#traders e,
	#strategies g
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
and
	b.internal_account_id = d.internal_account_id
and
	b.trader_id = e.trader_id
and
	b.strategy_id = g.strategy_id
and
	b.trade_date <= @end_date
and
	b.value_date >= @begin_date
group by
	a.currency_id,
	b.value_date

create table
	#ladder(
		ladder_id int,
		product_id int,
		quantity float NULL,
		usd_equiv float NULL,
		value_date datetime NULL
		)

create table
	#products(
		product_id int
		)


insert into
	#products
select
	product_id
from
	#give_products
insert into
	#products
select
	product_id
from
	#get_products
where
	product_id not in(
		select
			product_id
		from
			#products)

create table
	#value_dates(
		value_date datetime)
insert into
	#value_dates
select
	distinct(value_date)
from
	#give_products
insert into
	#value_dates
select
	distinct(value_date)
from
	#get_products
where
	value_date not in(
		select
			value_date
		from
			#value_dates)

select
	@product_id = 0,
	@ladder_id = 0
select
	@products = count(*)
from
	#products
where
	product_id > @product_id

while @products > 0
begin
	select
		@product_id = min(product_id)
	from
		#products
	where
		product_id > @product_id

	select
		@value_date = "8/8/88"
	select
		@value_dates = count(*)
	from
		#value_dates
	where
		value_date > @value_date
	
	while @value_dates > 0
	begin
		select
			@value_date = min(value_date)
		from
			#value_dates
		where
			value_date > @value_date

		select
			@get_product_qty = NULL,
			@give_product_qty = NULL,
			@exposure = NULL,
			@usd_equiv = NULL
	
		select
			@get_product_qty = quantity
		from
			#get_products
		where
			product_id = @product_id
		and
			value_date = @value_date
		if @get_product_qty = NULL
			select
				@get_product_qty = 0
	
		select
			@give_product_qty = quantity
		from
			#give_products
		where
			product_id = @product_id
		and
			value_date = @value_date
		if @give_product_qty = NULL
			select
				@give_product_qty = 0
	
		select
			@exposure = @give_product_qty + @get_product_qty
	
		if @product_id = @usd_product_id
			select
				@usd_equiv = @exposure
		else
			exec
				r_dollaramount
					@product_id,
					@exposure,
					@end_date,
					@usd_equiv output
	
		select
			@ladder_id = @ladder_id + 100

		insert into
			#ladder
		values(
			@ladder_id,
			@product_id,
			@exposure,
			@usd_equiv,
			@value_date)

		select
			@value_dates = count(*)
		from
			#value_dates
		where
			value_date > @value_date
	end

	select
		@products = count(*)
	from
		#products
	where
		product_id > @product_id
end

update
	#ladder
set
	usd_equiv = quantity
where
	product_id = 1


create table
	#output(
		style varchar(100) NULL,
		ladder_id int,
		symbol char(50) NULL,
		value_date char(50) NULL,
		quantity numeric(30,2) NULL,
		usd_equiv numeric(30,2) NULL,
		val_date char(11) NULL)
        
select
	@value_date = "8/8/88"
select
	@value_dates = count(*)
from
	#ladder
where
	value_date > @value_date

while @value_dates > 0
begin
	select
		@value_date = min(value_date)
	from
		#ladder
	where
		value_date > @value_date

	insert into
		#output
	select
		style = "background:#fff",
		b.ladder_id,
		a.symbol,
		value_date = convert(char(11), b.value_date, 0),
		b.quantity,
		b.usd_equiv,
		val_date = NULL
		/* val_date = convert(char(11), b.value_date, 0) */
	from
		products a,
		#ladder b
	where
		a.product_id = b.product_id
	and
		b.value_date = @value_date
	order by
		a.symbol

	select
		@ladder_id = max(ladder_id)
	from
		#output

	select
		@ladder_id = @ladder_id + 10

	select
		@total_usd = sum(usd_equiv),
		@total = sum(quantity)
	from
		#ladder
	where
		value_date = @value_date

	insert into
		#output
	values(
		/* "background:#FFFF99;font-weight:bold", */
		"font-weight:bold;border-bottom:2px solid #999;margin-bottom:20px;color:#963;background:#fff",
		@ladder_id,
		NULL, /* "Total", */
		convert(char(11), @value_date, 0),
		NULL,
		@total_usd,
		convert(char(11), @value_date, 0))


	select
		@value_dates = count(*)
	from
		#ladder
	where
		value_date > @value_date
end


select
	@total_usd = sum(usd_equiv)
from
	#ladder
if @total_usd = NULL
	select
		@total_usd = 0.0

insert into
	#output
values(
	"background:#99FF33;font-weight:bold;font-size:3em",
	@ladder_id + 100,
	"Total",
	NULL,
	NULL,
	@total_usd,
	NULL)
	
create table
	#output_2 (
        id int identity,
		style varchar(100) NULL,
		ladder_id int,
		symbol char(50) NULL,
		value_date char(50) NULL,
		quantity numeric(30,2) NULL,
		usd_equiv numeric(30,2) NULL,
		val_date char(11) NULL
    )

insert into
    #output_2
select
    *
from
    #output
where
	usd_equiv != 0
and
	usd_equiv != NULL

select
    value_date = "<b>" + case 
        when b.value_date != NULL and a.value_date = b.value_date then
            NULL
        else
            a.value_date
    end + "</b>",
	a.style,
	a.symbol,
	a.quantity,
	a.usd_equiv
from
    #output_2 a,
    #output_2 b
where
    a.id *= b.id + 1
    
