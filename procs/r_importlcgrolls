use
	risk_alumfx
go

drop procedure
	r_importlcgrolls
go

create procedure
	r_importlcgrolls
		@login varchar(50),
		@blank varchar(100)=NULL,
		@trade_date varchar(100)=NULL,
		@value_date varchar(100)=NULL,
		@buy_sell varchar(100)=NULL,
		@ccy1 varchar(100)=NULL,
		@amount varchar(100)=NULL,
		@rate varchar(100)=NULL,
		@ccy2 varchar(100)=NULL,
		@ccy2_equivalent varchar(100)=NULL,
		@deal_no varchar(100)=NULL
as

if @value_date = "" or @value_date = NULL or @value_date = "Value Date"
	return

declare @trade_id int
declare @deal_id int
declare @source varchar(50)
declare @t_trade_date datetime
declare @t_value_date datetime
declare @t_quantity numeric(30,4)
declare @quantity varchar(50)
declare @counter_qty varchar(50)
declare @t_counter_qty numeric(30,4)
declare @t_price float
declare @trader_login varchar(50)
declare @trader_tico_account_id int
declare @fund_id int
declare @broker_id int
declare @external_account_id int
declare @account varchar(50)
declare @swap_symbol_id int
declare @symbol varchar(50)
declare @contract_id int
declare @leg varchar(2)
declare @identifier varchar(50)
declare @t_identifier varchar(50)
declare @other_leg_identifier varchar(50)
declare @source_id int
declare @closing_date datetime
declare @closing_rate float
declare @roll_date datetime
declare @roll_rate float
declare @swap_symbol varchar(50)

declare @cl_rate float
declare @rl_rate float
declare @rl_date datetime
declare @cl_date datetime



exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@source = "LCG"

select
	@source_id = source_id
from
	sources
where
	name = @source
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end

select
	@t_trade_date = convert(datetime, @trade_date),
	@t_value_date = convert(datetime, @value_date)

exec
	u_stripcommas
		@amount,
		@quantity output

select
	@t_quantity = abs(convert(numeric(30,4), @quantity))

if @buy_sell = "Sell"
	select
		@t_quantity = @t_quantity * -1.0

exec
	u_stripcommas
		@ccy2_equivalent,
		@counter_qty output

select
	@t_counter_qty = convert(numeric(30,4), @counter_qty)


if @t_quantity != 0.0
	select
		@t_price = convert(numeric(30,6), abs(@t_counter_qty / @t_quantity))

select
	@trader_login = a.login,
	@trader_tico_account_id = a.account_id
from
	tico_accounts a,
	fund_roll_traders b,
	traders c
where
	b.roll_trader_id = c.trader_id
and
	a.account_id = c.tico_account_id
and
	b.fund_id = @fund_id
if @trader_login = NULL
begin
	select
		status = "Error",
		message = "Roll trader not configured"
	return
end

select
	@broker_id = a.broker_id
from
	default_tally_accounts a,
	tally_types b
where
	a.tico_account_id = @trader_tico_account_id
and
	a.tally_type_id = b.tally_type_id
and
	b.name = "Swap"
if @broker_id = NULL
begin
	select
		status = "Error",
		message = "Broker not found"
	return
end

select
	@account = "LCG FXPB"
select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account 
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end



select
	@symbol = rtrim(@ccy1) + rtrim(@ccy2)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

select
	@leg = right(@deal_no, 2)

if @leg = "SP"
begin
	select
		@t_identifier = rtrim(@deal_no) + ".near"

	select
		@other_leg_identifier = left(@deal_no, char_length(@deal_no) - 3) + ".FW.far"
end

if @leg = "FW"
begin
	select
		@t_identifier = rtrim(@deal_no) + ".far"

	select
		@other_leg_identifier = left(@deal_no, char_length(@deal_no) - 3) + ".SP.near"
	select
		@deal_id = deal_id,
		@closing_date = value_date,
		@closing_rate = price
	from
		trades
	where
		identifier = @other_leg_identifier
	and
		broker_id = @broker_id
	select
		@roll_date = @t_value_date,
		@roll_rate = @t_price
end


/* select
	deal_id = @deal_id,
	trader_login = @trader_login,
	source = @source,
	broker_id = @broker_id,
	account = @account,
	symbol = @symbol,
	quantity = @t_quantity,
	counter_qty = @t_counter_qty,
	price = @t_price,
	identifier = @t_identifier,
	other_leg_identifier = @other_leg_identifier */



exec
	fxa_tallytrade
		@login = @trader_login,
		@source = @source,
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Swap",
		@deal_type = "Market Swap",
		@trade_type = "Swap Near",
		@symbol = @symbol,
		@quantity = @t_quantity,
		@price = @t_price,
		@trade_date = @t_trade_date,
		@value_date = @t_value_date,
		@identifier = @t_identifier,
		@external_account = @account,
		@sales_code = "None",
		@counterparty = "LCG-LCG"

select
	@swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".M"
select
	@swap_symbol_id = swap_symbol_id
from
	swap_symbols
where
	symbol = @swap_symbol
if @swap_symbol_id = NULL
begin
	exec
		j_nextkey
			"swap_symbols",
			@swap_symbol_id output

	insert into
		swap_symbols
	values(
		@swap_symbol_id,
		@swap_symbol,
		getdate())
end

update
	swap_symbol_trades
set
	trade_id = @trade_id
where
	swap_symbol_id = @swap_symbol_id
and
	trade_id = @trade_id
if @@rowcount = 0
begin
	insert into
		swap_symbol_trades
	values(
		@swap_symbol_id,
		@trade_id)
end


if @leg = "FW"
begin
	exec
		r_setextacctrollrates
			@login,
			@symbol,
			@closing_date,
			@closing_rate,
			@roll_date,
			@roll_rate,
			@trade_date
			
	update
		ext_account_biproduct_rates
	set
		closing_rate = @closing_rate,
		roll_date = @roll_date,
		roll_rate = @roll_rate,
                closing_date = @closing_date
	where
		external_account_id = @external_account_id
	and
		contract_id = @contract_id
	and
		trade_date = @t_trade_date
	if @@rowcount != 1
	begin
		insert into
			ext_account_biproduct_rates(
				external_account_id,
				contract_id,
				closing_date,
				closing_rate,
				roll_date,
				roll_rate,
				trade_date)
		values(
			@external_account_id,
			@contract_id,
			@closing_date,
			@closing_rate,
			@roll_date,
			@roll_rate,
			@t_trade_date)
	end 
end



go
