use
	risk_firsel
go

drop procedure
	lw_runcampaign
go

create procedure
	lw_runcampaign
		@login varchar(50),
		@campaign varchar(50)
as

declare @exchange_id int
declare @collection_model_id int


select
	@exchange_id = exchange_id
from
	exchanges
where
	name = @campaign


create table
	#trades(
		id int identity,
		status varchar(1),
		trade_id int,
		deal_id int,
		external_account_id int,
		quantity numeric(30,4),
		contract_id int,
		value_date datetime,
		trade_date datetime,
		strategy_id int)

insert into
	#trades(
		status,
		trade_id,
		deal_id,
		external_account_id,
		quantity,
		contract_id,
		value_date,
		trade_date,
		strategy_id)
select
	status = "Q",
	a.queued_trade_id,
	a.deal_id,
	a.external_account_id,
	a.quantity,
	a.contract_id,
	a.value_date,
	a.trade_date,
	a.strategy_id	
from
	queued_trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	b.exchange_id = @exchange_id


insert into
	#trades(
		status,
		trade_id,
		deal_id,
		external_account_id,
		quantity,
		contract_id,
		value_date,
		trade_date,
		strategy_id)
select
	status = "T",
	a.trade_id,
	a.deal_id,
	a.external_account_id,
	a.quantity,
	a.contract_id,
	a.value_date,
	a.trade_date,
	a.strategy_id	
from
	trades a,
	forwards b
where
	a.contract_id = b.contract_id
and
	b.exchange_id = @exchange_id


select * from #trades

go

