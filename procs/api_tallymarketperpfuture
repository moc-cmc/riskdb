
drop procedure
	api_tallymarketperpfuture
go

create procedure
	api_tallymarketfuture
		@login varchar(25),
		@buy_sell varchar(5),
		@symbol varchar(50),
		@quantity numeric(30,2),
		@price float,
		@deal_id int output,
		@trade_id int output
as

declare @trade_date datetime
declare @sales_code varchar(50)
declare @trade_type varchar(25)
declare @contract_id int
declare @value_date datetime

if @buy_sell = "Sell"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @buy_sell = "Buy"
begin
	select
		@quantity = abs(@quantity)
end


select
	@sales_code = "None"


select
	@trade_date = getdate()

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol=@symbol

	return
end

select
	@value_date = expiration
from
	future_contracts
where
	contract_id = @contract_id

if @value_date = NULL
begin
	select
		status = "Error",
		message = "Future contract not found",
		symbol = @symbol
	return
end

select
	@trade_type = "Future"

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Future",
		@deal_type = "Market Future",
		@trade_type = @trade_type,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @value_date,
		@price = @price,
		@trade_date = @trade_date,
		@sales_code = @sales_code


go
