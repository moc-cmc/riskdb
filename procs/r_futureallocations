
if object_id("r_futureallocations") != NULL
    drop procedure
        r_futureallocations
go

create procedure
	r_futureallocations
		@fund_id int
as

declare @remainder_alloc float
declare @remainder_external char(50)
declare @remainder_internal char(50)
declare @fund char(50)


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200),
		arguments char(255) NULL)
insert into
	#links
values(
	"Column Link",
	"edit_values",
	"Edit Future Allocation",
	"suppressAutoexecute=YES")
--Adaptive Server has expanded all '*' elements in the following statement


select #links.meta_type, #links.column, #links.link, #links.arguments from #links

create table
	#output(
		fund char(50),
		remainder_external_account char(50),
		remainder_internal_account char(50),
		external_account char(50),
		internal_account char(50),
		allocation char(30),
		edit_values char(20) NULL)

insert into
	#output
select
	fund = f.name,
	remainder_external_account = a.symbol,
	remainder_internal_account = c.symbol,
	external_account = d.symbol,
	internal_account = e.symbol,
	allocation = rtrim(convert(char(30), convert(numeric(30,4), b.percentage ))),
	edit_values = "EDIT"
from
	external_accounts a,
	external_future_allocations b,
	internal_accounts c,
	external_accounts d,
	internal_accounts e,
	funds f

where
	b.fund_id = f.fund_id
and
	b.remainder_ext_account_id = a.external_account_id
and
	b.remainder_int_account_id = c.internal_account_id
and
	b.external_account_id = d.external_account_id
and
	b.internal_account_id = e.internal_account_id
and
	b.fund_id = @fund_id


select
	@fund = min(fund),
	@remainder_external = min(remainder_external_account),
	@remainder_internal = min(remainder_internal_account),
	@remainder_alloc = 1.0 - sum(convert(float, allocation))
from
	#output

if @remainder_alloc != NULL
	insert into
		#output
	values(
		@fund,
		@remainder_external,
		@remainder_internal,
		@remainder_external,
		@remainder_internal,
		convert(char(30), convert(numeric(30,4), @remainder_alloc)),
		NULL)




--Adaptive Server has expanded all '*' elements in the following statement
select #output.fund, #output.remainder_external_account, #output.remainder_internal_account, #output.external_account, #output.internal_account, #output.allocation, #output.edit_values from #output

go
