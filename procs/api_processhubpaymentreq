create or replace procedure
	api_processhubpaymentreq
		@login varchar(100),
		@deal_id int,
		@action varchar(50),
		@status varchar(50),
		@hub varchar(50),
		@transaction_date varchar(50),
		@account varchar(50),
		@symbol varchar(50),
		@value_date varchar(50),
		@amount varchar(50),
		@counter_amount varchar(50) = NULL,
		@trade_price varchar(50) = NULL,
		@venue varchar(50) = NULL,
		@eb varchar(50) = NULL,
		@identifier varchar(50) = NULL



as

declare @source varchar(50)
declare @source_id int

declare @book_account varchar(50)
declare @book_value_date datetime
declare @book_product varchar(50)
declare @book_balance numeric(30,10)
declare @book_account_id int
declare @treasury_account_id int
declare @credit_transaction_id int
declare @debit_transaction_id int

declare @product_id int
declare @treasury_account varchar(50)
declare @credit_account varchar(50)
declare @debit_account varchar(50)
declare @book_amount numeric(30,10)
declare @abs_book_balance numeric(30, 10)	


declare @credit_identifier varchar(100)
declare @debit_identifier varchar(100)



if @status != "Matched" or @action != 'Payment Request'
begin
        select
                status = "Skipped",
                message= "Only processing 'Matched' records with action 'Payment Request'",
		deal_id = @deal_id
        return
end

select
        @source_id = outbound_source_id
from
        matching_engines
where
        name = "MatchHub "+rtrim(@hub)
if @source_id = NULL
begin
        select
                status = "Error",
                message = "Problem finding matching_engine and source for hub, required for dupe handling",
                hub = "MatchHub "+rtrim(@hub)
        return
end

select
        @source = name
from
        sources
where
        source_id = @source_id
if @source = NULL
begin
        select
                status = "Error",
                message = "Problem finding source for id",
                source_id = @source_id,
                hub = "MatchHub "+rtrim(@hub)
        return
end


select
	@credit_identifier = rtrim(convert(varchar(30), @deal_id) + ".credit"),
	@debit_identifier = rtrim(convert(varchar(30), @deal_id) + ".debit")

select
	@credit_transaction_id = account_transaction_id
from
	account_transaction_identifiers
where
	source_id = @source_id
and
	identifier = @credit_identifier

select
        @debit_transaction_id = account_transaction_id
from
        account_transaction_identifiers 
where
        source_id = @source_id 
and
        identifier = @debit_identifier

if @credit_transaction_id != NULL and @debit_transaction_id != NULL
begin
	select
		status = "Dupe",
		message = "Already processed debit and credit",
		deal_id = @deal_id,
		credit_transaction_id = @credit_transaction_id,
		debit_transaction_id = @debit_transaction_id,
        	action = @action,
        	transaction_status = @status,
        	hub = @hub,
        	transaction_date = @transaction_date,
        	account = @account,
        	symbol = @symbol,
        	value_date = @value_date,
        	amount = @amount

	return
end


select
	@product_id = product_id
from
	products
where
	symbol = @symbol
if @product_id = NULL
begin
	select	
		status = "Error",
		message = "Problem finding product",
		product = @symbol
	return
end

select
        @book_account = b.symbol,
	@book_account_id = b.external_account_id
from
        external_accounts b,
        counterparties c,
        counterparty_symbols d
where
        b.external_account_id = c.external_account_id
and
        c.counterparty_id = d.counterparty_id
and
        d.symbol = @account
and
        d.source_id = @source_id
if @book_account = NULL
begin
        select
                status = "Error",
                message = "Problem finding account",
                account = @account
        return
end

select
        @book_value_date = convert(datetime, @transaction_date),
        @book_amount = dbo.f_fmtproductqty(@symbol, convert(numeric(30, 10), @amount))

select
	@abs_book_balance = abs(@book_amount)


/* Check for digital product */
select
        @treasury_account_id = external_account_id
from
        laser_product_treas_accts
where
        product_id = @product_id
if @treasury_account_id = NULL
begin
	/* Check for fiat treasury */
	select
        	@treasury_account_id = external_account_id
	from
        	laser_fiat_treas_accts
	where
        	product_id = @product_id
	and
		client_account_id = @book_account_id
	if  @treasury_account_id = NULL
	begin
		select
			status = "Error",
			message = "Problem finding treasury account for product and client",
			product = @symbol,
			client_account = @book_account
		return
	end
end

select
	@treasury_account = symbol
from
	external_accounts
where
	external_account_id = @treasury_account_id
if @treasury_account = NULL
begin
	select
		status = "Error",
		message = "Problem finding treaasury account from id",
		treasury_account_id = @treasury_account_id,
		product = @symbol,
		client_account = @book_account
end


if @book_amount < 0
begin
	select
		@credit_account = @book_account,
		@debit_account = @treasury_account
end
if @book_amount > 0
begin
        select
                @debit_account = @book_account,
                @credit_account = @treasury_account
end
if @book_amount = 0
begin
        select
                status = "Error",
		message = "Can not process 0 amount"
end



if @credit_transaction_id = NULL
begin
	select
		status = "Attempting",
                debit_from = @debit_account,
                credit_to = @credit_account,
                transaction_type = "Transfer",
                product = @symbol,
                amount = @abs_book_balance,
                note = NULL,
                transaction_date = @book_value_date

		
	exec
		api_addtransfertransactionhub
			@login = @login,
			@debit_from = @debit_account,
			@credit_to = @credit_account,
			@transaction_type = "Transfer",
			@product = @symbol,
			@amount = @abs_book_balance,
			@note = NULL,
			@transaction_date = @book_value_date,
			@debit_transaction_id = @debit_transaction_id output,
			@credit_transaction_id = @credit_transaction_id output

	insert into
		account_transaction_identifiers(
			account_transaction_id,
			source_id,
			identifier)
	values(
		@credit_transaction_id,
		@source_id,
		@credit_identifier)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem add account_transaction_identifier",
			credit_transaction_id = @credit_transaction_id
	end
end
	


select
	status = "Success",
	messsage = "Processed record",
	deal_id = @deal_id,
	action = @action,
	transaction_status = @status,
	hub = @hub,
	transaction_date = @transaction_date,
	account = @account,
	symbol = @symbol,
	value_date = @value_date,
	amount = @amount,
	counter_amount = @counter_amount,
	trade_price = @trade_price,
	venue = @venue,
	eb = @eb,
	identifier = @identifier


return

go

