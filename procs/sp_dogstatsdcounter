drop procedure	
	sp_dogstatsdcounter
go

create procedure
	sp_dogstatsdcounter
		@metric_name varchar(200),
                @value varchar(10)=NULL,
		@tags varchar(255)=NULL,
		@sample_rate varchar(10)="1.0"

as

/* chriso: 2018-07-07 - https://docs.datadoghq.com/developers/dogstatsd/datagram_shell/#metrics */


declare @result int

if @tags = NULL
begin
	select
		@tags = "db:"+db_name()
end
else
begin
	select
		@tags = rtrim(@tags)+",db:"+db_name()
end

select
	@result = syb_sendmsg("localhost", 8125,
            rtrim(@metric_name) +":"+ rtrim(@value) +"|c|@"+ rtrim(@sample_rate) +"|#"+ rtrim(@tags)
        )


go
