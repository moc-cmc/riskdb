
if object_id("mc_fundtrades") != NULL
    drop procedure
        mc_fundtrades
go

create procedure
	mc_fundtrades
		@fund varchar(50),
		@trade_date datetime=NULL
as

declare @source varchar(50)
declare @source_id int
declare @begin_date datetime
declare @end_date datetime


if @trade_date = NULL
	select
		@trade_date = getdate()

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#trades(
		trade_id int,
		deal_id int,
		user_id int,
		trade_type_id int,
		internal_account_id int,
		external_account_id int,
		counterparty_id int,
		quantity numeric(30,4),
		contract_id int,
        value_date datetime,
        fixing_date datetime NULL,
		price float,
		trade_date datetime,
		trader_id int,
		strategy_id int,
		status_id int,
		broker_id int,
        sales_code_id int,
		identifier varchar(100),
        pct_price numeric(30,6) NULL,
        spot_reference float NULL,
		deal_symbol varchar(50) NULL)	
		
insert into
	#trades(
		trade_id,
		deal_id,
		user_id,
		trade_type_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		quantity,
		contract_id,
        value_date,
        fixing_date,
		price,
		trade_date,
		trader_id,
		strategy_id,
		status_id,
		broker_id,
        sales_code_id,
		identifier,
        pct_price,
        spot_reference)
select
	trade_id,
    deal_id,
    user_id,
    trade_type_id,
    internal_account_id,
    external_account_id,
    counterparty_id,
    quantity,
    contract_id,
    value_date,
    fixing_date,
    price,
    trade_date,
    trader_id,
    strategy_id,
    status_id,
    broker_id,
    sales_code_id,
    identifier,
    pct_price,
    spot_reference
from
	trades
where
	trade_date >= @begin_date
and
	trade_date < @end_date
and
    quantity != 0

update
	#trades
set
	deal_symbol = b.symbol
from
    #trades a,
	deal_exec_symbols b
where
	a.deal_id = b.deal_id


--Adaptive Server has expanded all '*' elements in the following statement
select #trades.trade_id, #trades.deal_id, #trades.user_id, #trades.trade_type_id, #trades.internal_account_id, #trades.external_account_id, #trades.counterparty_id, #trades.quantity, #trades.contract_id, #trades.value_date, #trades.fixing_date, #trades.price, #trades.trade_date, #trades.trader_id, #trades.strategy_id, #trades.status_id, #trades.broker_id, #trades.sales_code_id, #trades.identifier, #trades.pct_price, #trades.spot_reference, #trades.deal_symbol from #trades order by trade_date

go
