drop procedure cbo_runfullcommit
go

create procedure
	cbo_runfullcommit
		@login varchar(50),
		@trade_date datetime

as


declare @commit_session_id int

create table
	#messages
(
	id int identity,
	message varchar(100)
)

insert into #messages values("Starting commit for date: "+ convert(varchar(8), @trade_date, 112))
insert into #messages values("Generating new commit session id...")	
exec
	j_nextkey
		"sessions",
		@commit_session_id output

insert into #messages values("Generating new commit session id...COMPLETE: " + convert(varchar(10), @commit_session_id))

insert into #messages values("Revaluing trades for date...")
exec
	cbo_revaltrades
		@login,
		@trade_date
insert into #messages values("Revaluing trades for date...COMPLETE")

insert into #messages values("Calculating commits...")
exec
	cm_commitplsforday
		@login,
		@trade_date,
		@commit_session_id
insert into #messages values("Calculating commits...COMPLETE")

insert into #messages values("Save Session PLs and run post process...")
exec 
	cm_savesessionpls
		@login,
		@commit_session_id
insert into #messages values("Save Session PLs and run post process...COMPLETE")

select
	* 
from
	#messages
go
