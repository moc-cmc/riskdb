
if object_id("r_postmessage") != NULL
    drop procedure
        r_postmessage
go

create procedure
    r_postmessage
        @login varchar(25),
        @message_id int = NULL out,
        @channel varchar(50) = "Operations",
        @item_relation_id int = NULL,
        @item_id int = NULL,
        @subject varchar(250),
        @content varchar(250) = NULL,
        @properties varchar(250) = NULL,
        @priority varchar(25) = "Normal",
        @status varchar(25) = "Active"
as

/* MARK: VARIABLES */
declare @user_id int
declare @new_status_id int
declare @status_id int
declare @priority_id int
declare @priority_number int
declare @channel_id int
declare @channel_item_relation_id int
declare @now_date datetime

/* MARK: - PARAM @subject: required */
if @subject = NULL or @subject = ""
begin
    select
        status = "Error",
        message = "@subject required",
        subject = convert(varchar(50), @subject)
    return
end

/* MARK: - FIND @user_id: from @login */
select
    @user_id = account_id
from
    tico_accounts
where
    login = @login

if @user_id = null
begin
    select
        status = "Error",
        message = "No user found, '" + @login + "'",
        login = @login
    return
end

/* MARK: FIND @new_status_id: for status "New" */
select
    @new_status_id = status_id
from
    statuses 
where
    name = "New"
    
if @new_status_id = null
begin
    select
        status = "Error",
        message = "No status found named, 'New'"
    return
end

/* MARK: FIND @status_id: from @status, default to "Active" */
select
    @status_id = a.status_id
from
    statuses a
where
    ( @status = NULL and a.name = "Active" )
or
    a.name = @status
    
if @status_id = null
begin
    select
        status = "Error",
        message = "No status found named, '" + @status + "'",
        status_name = @status
    return
end

/* MARK: FIND @priority_id, @priority_number: from @priority */
select
    @priority_id = a.priority_id,
    @priority_number = a.number
from
    priorities a
where
    ( @priority = NULL and a.name = "Normal" )
or
    a.name = @priority
    
if @priority_id = null
begin
    select
        status = "Error",
        message = "No priority found named, '" + @priority + "'",
        priority = @priority
    return
end

/* MARK: FIND @channel_id: from @channel, default to "Operations" */
if @channel = NULL
    select
        @channel = "Operations"

select
    @channel_id = a.channel_id,
    @channel_item_relation_id = a.item_relation_id
from
    channels a
where
    a.name = @channel
    
if @channel_id = null
begin
    /* MARK: . . INSERT channels: autocreate the channel */
    insert into
        channels (
            name,
            item_relation_id
        )
    values (
        @channel,
        @item_relation_id
    )
    select
        @channel_id = @@identity
    
    /* MARK: . . IF/ERROR no @channel_id */
    if @channel_id = NULL
    begin
        select
            status = "Error",
            message = "No channel found named, '" + @channel + "', and could not autocreate channel",
            channel = @channel
        return
    end
end

/* MARK: IF/ERROR @item_relation_id: must match the channel if specified */
if @item_relation_id = NULL
begin
    select
        @item_relation_id = @channel_item_relation_id
end
else if @item_relation_id != @channel_item_relation_id
begin
    select
        status = "Error",
        message = "Item relation does not match the channel",
        channel = @channel,
        item_relation = object_name(@item_relation_id),
        channel_item_relation_id = object_name(@channel_item_relation_id)
    return
end

/* MARK: IF/ERROR @item_is: required if @item_relation_id is specified */
if @item_relation_id != NULL and @item_id = NULL
begin
    select
        status = "Error",
        message = "Item required for channel",
        channel = @channel,
        item_relation = object_name(@item_relation_id)
    return
end

/* MARK: - CREATE #recipients: collect recipients */
create table
    #recipients (
        message_recipient_id int
    )
    
/* MARK: INSERT #recipients: from channel_subscriptions */
insert into
    #recipients (
        message_recipient_id
    )
select
    a.message_recipient_id
from
    channel_subscriptions a,
    priorities aa,
    statuses ab,
    message_recipients b,
    statuses ba
where
    a.priority_id = aa.priority_id
and
    a.status_id = ab.status_id
and
    a.message_recipient_id = b.message_recipient_id
and
    b.status_id = ba.status_id
and
    a.channel_id = @channel_id
and (
        a.item_id = NULL
    or
        a.item_id = @item_id
    )
and
    aa.number <= @priority_number
and
    ab.name = "Active"
and
    ba.name = "Active"

/* MARK: IF/ERROR #recipients: some recipients must exist  */
if not exists( select * from #recipients )
begin
    select
        status = "Error",
        message = "No recipients found",
        channel = @channel,
        item_relation = convert(varchar(30), object_name(@item_relation_id)),
        item_id = @item_id,
        priority = @priority
    
    select
        channel = convert(varchar(45), a.name),
        item_relation = convert(varchar(25), object_name(a.item_relation_id)),
        item_id = b.item_id,
        subscription_priority = convert(varchar(10), ba.name),
        subscription_delay = b.delay,
        subscription_status = convert(varchar(10), bb.name),
        recipient_address = convert(varchar(35), c.address),
        recipient_status = convert(varchar(10), cb.name),
        delivery_method = convert(varchar(10), ca.name)
    from
        channels a,
        channel_subscriptions b,
            priorities ba,
            statuses bb,
        message_recipients c,
            delivery_methods ca,
            statuses cb
    where
        a.channel_id = b.channel_id
            and
                b.priority_id = ba.priority_id
            and
                b.status_id = bb.status_id
    and
        b.message_recipient_id = c.message_recipient_id
            and
                c.delivery_method_id = ca.delivery_method_id
            and
                c.status_id = cb.status_id
    and
        a.channel_id = @channel_id
    
    return
end
        
/* MARK: SET @now_date: to now */
select
    @now_date = getdate()

/* MARK: - INSERT messages: post the message */
insert into
    messages
values (
    @user_id,
    @now_date,
    @channel_id,
    @item_relation_id,
    @item_id,
    @subject,
    @content,
    @properties,
    @priority_id,
    @status_id
)
select
    @message_id = @@identity

/* MARK: INSERT message_receipts: for all #recipients */
insert into 
    message_receipts (
        message_id,
        message_recipient_id,
        status_id,
        status_date
    )
select distinct
    message_id = @message_id,
    message_recipient_id,
    status_id = @new_status_id,
    status_date = @now_date
from
    #recipients

/* MARK: EXEC r_checkmessages: to schedule delivery of messages */
exec
    r_checkmessages
    
go
