
if object_id("mc_tallyforwardwrapper") != NULL
    drop procedure
        mc_tallyforwardwrapper
go

create procedure
	mc_tallyforwardwrapper
		@login char(25),
		@symbol char(25),
		@broker char(100),
		@trader char(10),
		@strategy char(100),
		@buysell varchar(10),
		@quantity numeric(30,6),
		@price float,
		@spot_price float,
		@value_date datetime = NULL


as
/*
declare @strategy char(30)


select
	@strategy = a.name
from
	strategies a,
	traders b,
	tico_accounts c
where
	a.strategy_id = b.default_strategy_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
if @strategy = NULL
	select
		@strategy = "Short Term"
*/

if convert(char(1), lower(@buysell)) = "s"
begin
        select
                @quantity = abs(@quantity) * -1
end

if convert(char(1), lower(@buysell)) = "b"
begin
        select
                @quantity = abs(@quantity)
end

exec
	mc_tallyforward
		@login,
		@symbol,
		@trader,
		@broker,
		@strategy,
		/* "Short Term", */
		@quantity,
		@price,
		@spot_price,
		@value_date

go
