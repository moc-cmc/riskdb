	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"

if @trade_date = NULL
        select
                @trade_date = getdate()

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

create table
	#connections(
		connection_id int,
		source_id int)

insert into
	#connections(
		connection_id,
		source_id)
select
	a.connection_id,
	a.source_id
from
	connections a,
	connection_tico_accounts b
where
	a.connection_id = b.connection_id
and
	b.tico_account_id = @tico_account_id

create table
        #trade_notifications(
                trade_notification_id int,
                trade_id int,
                source_id int,
                status_id int)
	
select
        @active_status_id = status_id
from
        statuses
where
        name = "Active"
select
        @edit_status_id = status_id
from
        statuses
where
        name = "Edit"
select
        @cancelled_status_id = status_id
from
        statuses
where
        name = "Cancelled"

select
        @sent_status_id = status_id
from
        statuses
where
        name = "Sent"


insert into
        #trade_notifications
select
        a.trade_notification_id,
        a.trade_id,
        a.source_id,
        a.status_id
from
        trade_notifications a,
	#connections b
where
	a.source_id = b.source_id
and
	a.status_id in(@active_status_id,@cancelled_status_id,@edit_status_id)

insert into
        #trade_notifications
select top 100
        a.trade_notification_id,
        a.trade_id,
        a.source_id,
        a.status_id
from
        trade_notifications a,
        #connections b,
	trades c
where
        a.source_id = b.source_id
and
	a.trade_id = c.trade_id
and
	c.trade_date >= @begin_date
and
	c.trade_date < @end_date
and
        a.status_id in(@sent_status_id)
order by
	a.trade_id DESC


create table
	#trades(
		trade_id int,
		deal_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		deal_type_id int NULL,
		deal_type varchar(25) NULL,
		internal_account_id int,
		internal_account varchar(30) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(15) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
                agency_vs_counterparty varchar(40) NULL,
		fund_agency_trade char(1) NULL,
		fund_agency_buy_sell varchar(8) NULL,
		client_buy_sell varchar(4) NULL,
		broker_id int,
		broker varchar(25) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		ext_account_pb varchar(25) NULL,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity float NULL,
		abs_qty float NULL,
		abs_counter_qty float NULL,
                abs_far_counter_qty float NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date datetime NULL,
		fixing_date datetime NULL,
		db_price float,
		std_price float NULL,
		spot_reference float NULL,
		sales_code_id int,
		sales_code varchar(15) NULL,
		strategy_id int,
		strategy varchar(30) NULL,
		identifier varchar(100) NULL,
		deal_identifier varchar(80) NULL,
		deal_status_id int NULL,
		deal_status varchar(20) NULL,
		trade_status_id int,
		trade_status varchar(20) NULL,
		trade_notification_id int,
		notification_status_id int,
		notification_status varchar(15) NULL,
		notification_source_id int,
		notification_source varchar(25) NULL,
                source_trade_trade_id int NULL,
		source_trade_deal_id int NULL,
		swap_symbol varchar(30) NULL,
		cl_or_lp varchar(4) NULL,
		client_prime_broker varchar(50) NULL,
		is_inverted_contract char(1) NULL,
		product_id int NULL,
		currency_id int NULL,
		style varchar(50) NULL
		)

insert into
	#trades
(
	style,
	trade_id,
	deal_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	trader_id,
	counterparty_id,
	fund_agency_trade,
	contract_id,
	broker_id,
	quantity,
	trade_date,
	value_date,
	fixing_date,
	db_price,
	std_price,
	spot_reference,
	sales_code_id,
	strategy_id,
	identifier,
	trade_status_id,
	trade_notification_id,
	notification_status_id,
	notification_source_id,
	abs_qty,
	cl_or_lp,
	abs_counter_qty
)
select 
	style = @style,
	trade_id = a.trade_id,
	deal_id = a.deal_id,
	trade_type_id = a.trade_type_id,
	internal_account_id = a.internal_account_id,
	external_account_id = a.external_account_id,
	trader_id = a.trader_id,
	counterparty_id = a.counterparty_id,
        fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
	contract_id = a.contract_id,
	broker_id = a.broker_id,
	quantity = a.quantity,
	trade_date = a.trade_date,
	value_date = convert(varchar(12), a.value_date),
	fixing_date = convert(varchar(12), a.fixing_date),
	db_price = a.price,
	std_price = a.price,
	spot_reference = a.spot_reference,
	sales_code_id = a.sales_code_id,
	strategy_id = a.strategy_id,
	identifier = a.identifier,
	trade_status_id = a.status_id,
	trade_notification_id = b.trade_notification_id,
	notification_status_id = b.status_id,
	notification_source_id = b.source_id,
	abs_qty = abs(a.quantity),
	cl_or_lp = "LP",
	abs_counter_qty = round(abs(a.quantity) * a.price, 2)
from
	trades a,
	#trade_notifications b
where
	a.trade_id = b.trade_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

update
    #trades
set
    std_price = case 
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.db_price) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.db_price) * d.factor
        when c.factor != NULL then
            a.db_price * c.factor * d.factor
        else
            a.db_price * d.factor
    end
from
    #trades a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id

