declare @cpty_far_dealt_rate float

declare @client_account_type_id int
declare @cpty_account_type_id int


select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

select 
	@cpty_account_type_id = external_account_type_id
from
	external_account_types
where
	name = "Counterparty"
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Problem finding external account type",
                type = "Counterparty"
        return
end

select 
        @client_account_type_id = external_account_type_id 
from
        external_account_types
where
        name = "Client"
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Problem finding external account type",
                type = "Client"
        return
end


