select 
	product_group = "SWAP",
	action = "REPORT",
	mesage_type = "REGULAR",
	process = NULL,
	trade_ref = a.trade_id,
	entity = "CLIENT",
	portfolio = m.name,
	reporting_system = "ETG",
	reporter_ticket_number = a.deal_id,
	trader_name = b.symbol,
	counterparty = NULL,
        reporting_party = c.symbol,
	prime_broker = p.symbol,
	trade_date = convert(varchar(15), a.trade_date,110),
	product_type = "SWAP",
	direction = "",
	contract_id = d.contract_id,
	traded_currency = g.symbol,
	counter_currency = f.symbol,
	traded_amount = a.quantity,
	far_traded_amount = 0,
	dealt_rate = a.price,
	value_date = convert(varchar(15),a.value_date,110),
	far_deal_rate = 0,
	far_value_date = NULL,
	j.trade_notification_id,
	a.external_account_id,
	a.deal_id,
        client_give_up = NULL
from
	trades a,
	traders b,
	external_accounts c,
	contracts d,
	forwards e,
	products f,
	products g,
	trade_notifications j,
	statuses k,
	trade_types l,
	strategies m,
        funds n,
	fund_external_accounts o,
	prime_broker_symbols p

where
	a.trader_id=b.trader_id
and
	a.contract_id=d.contract_id
and
	a.external_account_id=c.external_account_id 
and
	d.contract_id=e.contract_id
and
	e.currency_id=f.product_id
and
	e.product_id=g.product_id
and
	a.trade_id=j.trade_id
and
	j.status_id=k.status_id
and
	a.strategy_id = m.strategy_id
and
	c.external_account_id = o.external_account_id
and
	o.fund_id = n.fund_id
and
	n.prime_broker_id = p.prime_broker_id
and
	j.source_id=@source_id
and
	k.name in ("Active", "Edit", "Cancelled")
and
	a.trade_type_id=l.trade_type_id
and
	l.name="Swap Near"

