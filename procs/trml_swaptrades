/*
|  Set NEW, MODIFY, DELETE, etc... for trades
*/
update
	#trades
set
	process=status_symbol
from
	#trades a,
	trade_notifications b,
	status_symbols c 
where
	a.trade_notification_id=b.trade_notification_id 
and
	b.status_id=c.status_id




declare valdates cursor for 
	select
		deal_id	
	from
		#trades
	order by
		deal_id	


/*select * from #trades order by trade_ref*/


open valdates
fetch valdates into @deal_ref

while @@sqlstatus = 0
begin


	select
		@client_near_value_date=value_date,
		@client_near_dealt_rate=dealt_rate
	from
		#trades a,
		external_accounts b
	where
		a.external_account_id = b.external_account_id
	and
		b.external_account_type_id = @client_account_type_id
	and
		deal_id=@deal_ref 
	and
		value_date != NULL

        select
                @client_far_value_date=far_value_date,
                @client_far_dealt_rate=far_dealt_rate
        from
                #trades a,
                external_accounts b
        where
                a.external_account_id = b.external_account_id
        and
                b.external_account_type_id = @client_account_type_id
        and
                deal_id=@deal_ref
        and
                far_value_date != NULL

	select
		@cpty_near_value_date=value_date,
		@cpty_near_dealt_rate=dealt_rate
	from
		#trades a,
		external_accounts b
	where
		a.external_account_id = b.external_account_id
	and
		b.external_account_type_id = @cpty_account_type_id
	and
		deal_id=@deal_ref 
	and
		value_date != NULL

        select
                @cpty_far_value_date=far_value_date,
                @cpty_far_dealt_rate=far_dealt_rate
        from
                #trades a,
                external_accounts b
        where
                a.external_account_id = b.external_account_id
        and
                b.external_account_type_id = @cpty_account_type_id
        and
                deal_id=@deal_ref
        and
                far_value_date != NULL


        begin tran
		update
			#trades
		set
			a.value_date=@client_near_value_date,
			a.dealt_rate=@client_near_dealt_rate,
			a.far_value_date=@client_far_value_date,
			a.far_dealt_rate=@client_far_dealt_rate
		from
			#trades a,
			external_accounts b
		where
			a.external_account_id = b.external_account_id
		and
			b.external_account_type_id = @client_account_type_id
		and
			a.deal_id=@deal_ref
	commit tran

	begin tran
		update
			#trades
		set
			a.value_date=@cpty_near_value_date,
			a.dealt_rate=@cpty_near_dealt_rate,
			a.far_value_date=@cpty_far_value_date,
			a.far_dealt_rate=@cpty_far_dealt_rate
		from
			#trades a,
			external_accounts b
		where
			a.external_account_id = b.external_account_id
		and
			b.external_account_type_id = @cpty_account_type_id
		and
			deal_id=@deal_ref
	commit tran


	fetch valdates into @deal_ref
end
close valdates
deallocate valdates


/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    dealt_rate = case
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.dealt_rate) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.dealt_rate) * d.factor
        when c.factor != NULL then
            a.dealt_rate * c.factor * d.factor
        else
            a.dealt_rate * d.factor
    end,
    far_dealt_rate = case
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.far_dealt_rate) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.far_dealt_rate) * d.factor
        else
            a.far_dealt_rate * d.factor
    end
from
    #trades a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id



/*
|  Update traiana counterparty to counterparties.name for Market Trades
|  Update traiana trader to "" for Market Trades
*/
update
	#trades
set
	trader_name = ""
from
	#trades a,
	trades b,
	external_accounts c,
	external_account_types d,
        counterparties e
where
	a.trade_ref = b.trade_id
and
    b.counterparty_id = e.counterparty_id
and
    b.external_account_id = c.external_account_id
and
    c.external_account_type_id = d.external_account_type_id
and
    d.name = "Counterparty"




update
        #trades
set
        reporting_party = c.symbol
from
        #trades a,
        trades b,
        external_account_symbols c
where
        a.trade_ref = b.trade_id
and
        b.external_account_id = c.external_account_id
and
        c.source_id = @source_id


/*
|  Update traiana counterparty to reporting_partys.symbol for Market Trades
|  for counterparties that have a reporting_partys.symbol for source
*/
update
        #trades
set
        counterparty = c.name
from
        #trades a,
        trades b,
        counterparties c
where
        a.trade_ref = b.trade_id
and
	b.counterparty_id = c.counterparty_id

update 
	#trades
set
	counterparty = c.symbol
from
	#trades a,
	trades b,
	counterparty_symbols c
where
	a.trade_ref = b.trade_id
and
	b.counterparty_id = c.counterparty_id
and
	c.source_id = @source_id


/*
|  Update traiana trader to trader_symbols.symbol for Client Trades
|  for traders that have a trader_symbols.symbol for source
*/
update
        #trades
set
        trader_name = e.symbol
from
        #trades a,
        trades b,
        external_accounts c,
        external_account_types d,
        trader_symbols e
where
        a.trade_ref = b.trade_id
and
    b.trader_id = e.trader_id
and
    b.external_account_id = c.external_account_id
and
    c.external_account_type_id = d.external_account_type_id
and
    e.source_id = @source_id
and
    d.name = "Client"



/*
|  Update traiana prime_broker to prime_broker_symbols.symbol for all trades
|  for external_accounts who have an entry in external_account_prime_brokers
*/

update
	#trades
set
	prime_broker = e.symbol
from
	#trades a,
        trades b,
        external_accounts c,
	external_account_prime_brokers d,
	prime_broker_symbols e
where
	a.trade_ref = b.trade_id
and
	b.external_account_id = c.external_account_id 
and
	c.external_account_id = d.external_account_id
and
	d.prime_broker_id = e.prime_broker_id
and
	e.source_id = @source_id

/*
|  Update traiana client_give_up to client_give_ups.symbol for Client Trades
|  for external_accounts
*/
update
        #trades
set
        client_give_up = e.symbol
from
        #trades a,
        trades b,
        external_accounts c,
        external_account_types d,
        client_give_ups e
where
        a.trade_ref = b.trade_id
and
    b.external_account_id = e.external_account_id
and
    b.external_account_id = c.external_account_id
and
    c.external_account_type_id = d.external_account_type_id
and
    e.source_id  = @source_id
and
    d.name = "Client"


