create procedure
	trml_swaptrades	
		@source varchar(50)
as

declare @source_id int
declare @deal_ref int
declare @client_near_value_date varchar(15) 
declare @client_far_value_date varchar(15) 
declare @client_near_dealt_rate float
declare @client_far_dealt_rate float
