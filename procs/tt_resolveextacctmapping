
drop procedure
	tt_resolveextacctmapping
go

create procedure
	tt_resolveextacctmapping
			@login varchar(50),
			@external_account_id int,
			@broker_id int,
			@identifier varchar(100),
			@mapping_error_id int=NULL,
			@external_account varchar(50)=NULL output,
			@external_account_type varchar(150)=NULL output,
			@aggregation_style varchar(25)=NULL output



as

declare @message varchar(100)

select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id

if @external_account = NULL
begin
       
	if(@mapping_error_id = NULL)
	begin
		select 
			message = "Couldn't find external_account from external_account_id " + str(@external_account_id)
	
		exec
			ag_sendfailedmappingmessage
				@login=@login,
				@broker_id=@broker_id,
				@identifier=@identifier,
				@message=@message
	end
	return
end

if @mapping_error_id != NULL
	exec
		ag_resolvefailedmappingmessage
				@mapping_error_id=@mapping_error_id

return

go

