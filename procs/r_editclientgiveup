drop procedure
	r_editclientgiveup
go

create procedure
        r_editclientgiveup
                @login varchar(50),
                @external_account varchar(50),
                @source varchar(50),
                @symbol varchar(50),
                @new_symbol varchar(50)

as

declare @external_account_id int
declare @source_id int

select
        @source_id = source_id
from
        sources
where
        name = @source
if @@rowcount != 1
begin
        select
                msg = "Can not find source",
                source = @source
        return
end

select
        @external_account_id = external_account_id
from
        external_accounts
where
        symbol = @external_account
if @@rowcount != 1
begin
        select
                msg = "Can not find external account",
                ext_account = @external_account
        return
end

update
        client_give_ups
set
        symbol = @new_symbol
where
        external_account_id = @external_account_id
and
        source_id = @source_id
and
        symbol = @symbol

exec
        r_accountoverview
                @login,
                @external_account
go
