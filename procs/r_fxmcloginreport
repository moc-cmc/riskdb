drop procedure r_fxmcloginreport
go

create procedure 
	r_fxmcloginreport
		@as_of_date datetime = NULL

as

declare @begin_date datetime
declare @end_date datetime
declare @total_login_attempts int
declare @total_successful_attempts int
declare @total_failed_pass_attempts int
declare @total_failed_username_attempts int
declare @fund varchar(50)

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"



if @as_of_date = NULL
	select
		@as_of_date = getdate()

exec
	r_daterangefordate
		@as_of_date,
		@begin_date output,
		@end_date output

create table
	#user_login_attempts
(
	user_login_attempt_id int,
	tico_account_id int NULL,
	login varchar(50) NULL,
	login_provided varchar(50),
	password_provided varchar(50),
	login_attempt_status_id int,
	login_attempt_status varchar(30) NULL,
	timestamp datetime,
	ip varchar(20) NULL
)

insert into
	#user_login_attempts(
		user_login_attempt_id,
		tico_account_id,
		login_provided,
		password_provided,
		login_attempt_status_id,
		timestamp,
		ip
)
select
	a.user_login_attempt_id,
	a.tico_account_id,
	a.login_provided,
	a.password_provided,
	a.login_attempt_status_id,
	a.timestamp,
	a.ip 
from
	user_login_attempts a
where
	timestamp > @begin_date 
and
	timestamp <= @end_date


update
	#user_login_attempts
set
	login_attempt_status = b.name
from
	#user_login_attempts a,
	login_attempt_statuses b
where
	a.login_attempt_status_id = b.login_attempt_status_id
	

update
	#user_login_attempts
set
	login = b.login
from
	#user_login_attempts a,
	tico_accounts b
where
	a.tico_account_id = b.account_id

select
	@fund = name
from
	funds

select
	@total_login_attempts = count(*)
from
	#user_login_attempts

select
	@total_successful_attempts = count(*)
from
	#user_login_attempts
where
	login_attempt_status = "Success"

select
	@total_failed_pass_attempts = count(*)
from
	#user_login_attempts
where
	login_attempt_status = "Failed - Invalid Password"

select
	@total_failed_username_attempts = count(*)
from
	#user_login_attempts
where
	login_attempt_status = "Failed - Invalid Username"
	
select
	section = rtrim(@fund)+" Totals",
	/*begin_date = @begin_date,
	end_date = @end_date,*/
	login_attempts = @total_login_attempts,
	successful_attempts = @total_successful_attempts,
        failed_pass_attempts = @total_failed_pass_attempts,
	failed_username_attempts = @total_failed_username_attempts,
	style = @style



select
	section = rtrim(@fund)+" Totals by Login and Status",
	login = b.login,
	login_attempt_status = a.login_attempt_status,
	attempt_count = count(*),
	style = case when login_attempt_status like "Failed%" then @error_style else @style end
from
	#user_login_attempts a,
	tico_accounts b
where
	a.tico_account_id *= b.account_id
group by
	b.login,
	a.login_attempt_status
order by
	b.login,
	a.login_attempt_status,
	count(*)
	


	
	
go	
		
	


	

