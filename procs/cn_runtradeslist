drop procedure cn_runtradeslist
go


create procedure
	cn_runtradeslist
		@login char(100)
as


declare @admin varchar(1)
declare @tico_account_id int
declare @fund_id int
declare @fund_name varchar(50)
declare @favorited_run_count int

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)


insert into
	#links
values(
	"Column Link",
	"run_name",
	"Run Trades List",
	NULL,
	NULL)


insert into
        #links
values(
        "Column Link",
        "edits",
        "Trade Edits",
        NULL,
        NULL)


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login

exec
	r_defaultfundforlogin
		@login,
		@fund_id output


create table
    #favorited_runs
(
    run_id int,
    name varchar(100)
)

create table
    #user_runs
(
    tico_account_id int,
    run_id int,
    name varchar(100)
)

insert into
    #user_runs
select
    a.tico_account_id,
    a.run_id,
    b.name
from
    user_runs a,
    runs b
where
    a.run_id = b.run_id
and
    a.tico_account_id = @tico_account_id
if @@rowcount = 0
begin
        select
                "error"="No run(s) defined for user",
                "user"=@login
        return
end


insert into
    #favorited_runs
select
    b.run_id,
    b.name
from
    user_run_favorites a,
    #user_runs b
where
    a.run_id = b.run_id
if @@rowcount = 0
begin
    insert into
        #favorited_runs
    select
        b.run_id,
        b.name
    from
        default_run_favorites a,
        #user_runs b
    where
        a.run_id = b.run_id
    and
        a.fund_id = @fund_id
end

delete from
	#favorited_runs
where
	name in("EDGEWATER", "Edgewater Markets")

select
    @favorited_run_count = count(*)
from
    #favorited_runs

select
        @admin = "Y"
from
        access_groups a,
        access_group_accounts b
where
        a.access_group_id = b.access_group_id
and
        a.name = "Admin"
and
        b.tico_account_id = @tico_account_id


if @admin =  "Y"
begin
        select
                edits = "Trade Edits"
end



if @favorited_run_count > 0
begin
    select
            run_name = name
    from
        #favorited_runs
    order by
        run_name
end





select
	run_name = a.name
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
order by
	a.name

go
