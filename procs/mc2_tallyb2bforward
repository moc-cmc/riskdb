
if object_id("mc2_tallyb2bforward") != NULL
    drop procedure
        mc2_tallyb2bforward
go

create procedure
	mc2_tallyb2bforward
		@login varchar(50),
		@tally_type varchar(25),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@counterparty varchar(50),
		@quantity numeric(30,2),
		@dealt_currency varchar(10),
		@counter_currency varchar(10),
		@client_price float,
		@client_val_date datetime,
		@market_price float,
		@market_val_date datetime,
		@client_mid float=NULL,
		@client_trade_note varchar(255)=NULL,
		@market_trade_note varchar(255)=NULL

as

declare @deal_id int

exec api_tallyb2bforward
			@login=@login,
			@tally_type=@tally_type,
			@client_user=@client_user,
			@client_buys_sells=@client_buys_sells,
			@counterparty=@counterparty,
			@quantity=@quantity,
			@dealt_currency=@dealt_currency,
			@counter_currency=@counter_currency,
			@client_price=@client_price,
			@client_val_date=@client_val_date,
			@market_price=@market_price,
			@market_val_date=@market_val_date,
			@deal_id=@deal_id output,
			@client_fixing_date=NULL,
			@market_fixing_date=NULL,
			@client_mid_mark=@client_mid,
			@client_trade_note=@client_trade_note,
			@market_trade_note=@market_trade_note

exec
	mc_inspectdealtrades
		@login,
		@deal_id

go
