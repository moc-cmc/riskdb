
if object_id("r_contractprice") != NULL
    drop procedure
        r_contractprice
go
 
create procedure
	r_contractprice
		@contract_id int,
		@as_of_date datetime,
		@price float output
as

declare @inverted_contract_id int
declare @future_type varchar(50)

declare @spot_contract_id int
declare @expiration datetime
declare @days float
declare @spot_price float
declare @give_product_rate float
declare @get_product_rate float

select
	@future_type = a.name,
	@expiration = c.expiration,
	@spot_contract_id = b.forward_id
from
	future_types a,
	futures b,
	future_contracts c
where
	a.future_type_id = b.future_type_id
and
	b.future_id = c.future_id
and
	c.contract_id = @contract_id

if @future_type = "Val Date"
begin
	exec
		r_forwardpriceasof
			@spot_contract_id,
			@as_of_date,
			@expiration,
			@days output,
			@spot_price output,
			@price output,
			@give_product_rate output,
			@get_product_rate output

	return
end


select
	@price = price
from
	prices
where
	contract_id = @contract_id
and
	price_date = (
		select
			max(price_date)
		from
			prices
		where
			contract_id = @contract_id
		and
			price_date <= @as_of_date)

if @price = NULL
	select
		@price = price
	from
		current_prices
	where
		contract_id = @contract_id

if @price = NULL
begin
	exec
		r_invertedcontract
			@contract_id,
			@inverted_contract_id output
	select
		@price = 1.0 / price
	from
		prices
	where
		contract_id = @inverted_contract_id
	and
		price_date = (
			select
				max(price_date)
			from
				prices
			where
				contract_id = @inverted_contract_id
			and
				price_date <= @as_of_date)

	if @price = NULL
		select
			@price = 1.0 / price
		from
			current_prices
		where
			contract_id = @inverted_contract_id

end

go
