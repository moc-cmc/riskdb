create or replace procedure
	ag_initpairfromproducts
		@login varchar(50),
		@product varchar(50),
		@currency varchar(50)
as


declare @product_id int
declare @currency_id int
declare @contract_id int
declare @symbol varchar(50)
declare @inverted_contract_id int
declare @inverted_symbol varchar(50)
declare @instrument_id int
declare @exchange_id int

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Forward"
if @instrument_id = NULL
begin
	select
		status = "Error",
		message = "Forward instrument not found"
	return
end

select
	@exchange_id = exchange_id
from
	exchanges
where
	name = "OTC"
if @exchange_id = NULL
begin
	select
		status = "Error",
		message = "OTC Exchange not found"
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@currency_id = product_id
from
	products
where
	symbol = @currency
if @currency_id = NULL
begin
	
 select
		status = "Error",
		message = "Currency not found",
		currency = @currency
	return
end

select
	@symbol = rtrim(@product) + rtrim(@currency),
	@inverted_symbol = rtrim(@currency) + rtrim(@product)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	exec
		j_nextkey
			"contracts",
			@contract_id output

	begin tran
		insert into
			forwards(
				contract_id,
				currency_id,
				product_id,
				quantity,
				exchange_id)
		values(
			@contract_id,
			@currency_id,
			@product_id,
			1,
			@exchange_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add forward",
				product = @product,
				currency = @currency
			rollback tran
			return
		end

		insert into 
			contracts(
				contract_id,
				symbol,
				instrument_id)
		values(
			@contract_id,
			@symbol,
			@instrument_id)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add forward contract",
				product = @product,
				currency = @currency
			rollback tran
			return
		end
	commit tran
end

