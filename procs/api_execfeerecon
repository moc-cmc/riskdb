drop procedure
	api_execfeerecon
go

create procedure
	api_execfeerecon
		@login varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@display_output varchar(10)=NULL,
		@send_message varchar(10)=NULL
as

declare @tico_account_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

declare @pending_only int
declare @pending_different int
declare @booked_only int
declare @booked_different int
declare @message varchar(250)
declare @message_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"assign",
	"Assign Request Custodial Account",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"reject",
	"Reject Client Request",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"next_action",
	"Approve Next Request Action",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"enable_user",
	"Enable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"disable_user",
	"Disable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"add_admin_user",
	"Add Approval User",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
if @end_date = NULL
	select
		@end_date = getdate()

select
	@begin_date = convert(datetime, convert(date, @begin_date)),
	@end_date = convert(datetime, convert(date, @end_date))

select
	@begin_date = dateadd(hour, -7, @begin_date),
	@end_date = dateadd(hour, 17, @end_date)


create table
	#pending_dates(
		account_transaction_id int,
		transaction_date datetime NULL,
		bo_trade_date datetime NULL)
insert into
	#pending_dates(
		account_transaction_id,
		transaction_date,
		bo_trade_date)
select
	account_transaction_id,
	transaction_date,
	convert(datetime, convert(date, transaction_date))
from
	pending_transactions_archive

update
	#pending_dates
set
	bo_trade_date = dateadd(day, 1, bo_trade_date)
where
	datepart(hour, transaction_date) >= 17
	

create table
	#pending(
		external_account_id int NULL,
		date datetime NULL,
		transaction_type_id int NULL,
		currency_id int NULL,
		amount float NULL,
		booked_amount float NULL)
insert into
	#pending(
		external_account_id,
		date,
		transaction_type_id,
		currency_id,
		amount)
select
	a.external_account_id,
	c.bo_trade_date,
	a.transaction_type_id,
	a.currency_id,
	sum(a.amount)
from
	pending_transactions_archive a,
	fee_transaction_types b,
	#pending_dates c
where
	a.account_transaction_id = c.account_transaction_id
and
	a.transaction_type_id = b.transaction_type_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date < @end_date
/*
	c.bo_trade_date >= @begin_date 
and
	c.bo_trade_date <= @end_date */
group by
	a.external_account_id,
	c.bo_trade_date,
	a.transaction_type_id,
	a.currency_id

delete
	#pending
from
	#pending a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
	b.name not in("Trade Settlement Fee", "Execution Fee")

create table
        #booked_dates(
                account_transaction_id int,
                transaction_date datetime NULL,
                bo_trade_date datetime NULL)
insert into
        #booked_dates(
                account_transaction_id,
                transaction_date,
                bo_trade_date)
select
        account_transaction_id,
        transaction_date,
        convert(datetime, convert(date, transaction_date))
from
        account_transactions

update
        #booked_dates
set
        bo_trade_date = dateadd(day, 1, bo_trade_date)
where
        datepart(hour, transaction_date) >= 17

create table
	#booked(
		external_account_id int NULL,
		date datetime NULL,
		transaction_type_id int NULL,
		currency_id int NULL,
		amount float NULL,
		pending_amount float NULL)
insert into
	#booked(
		external_account_id,
		date,
		transaction_type_id,
		currency_id,
		amount)
select
	a.external_account_id,
	c.bo_trade_date,
	a.transaction_type_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	fee_transaction_types b,
	#booked_dates c
where
	a.account_transaction_id = c.account_transaction_id
and
	a.transaction_type_id = b.transaction_type_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date < @end_date
group by
	a.external_account_id,
	c.bo_trade_date,
	a.transaction_type_id,
	a.currency_id

delete
	#booked
from
	#booked a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
and
        b.name not in("Trade Settlement Fee", "Execution Fee")

update
	#pending
set
	a.booked_amount = b.amount
from
	#pending a,
	#booked b
where
	a.external_account_id = b.external_account_id
and
	a.date = b.date
and
	a.transaction_type_id = b.transaction_type_id
and
	a.currency_id = b.currency_id



update
	#booked
set
	a.pending_amount = b.amount
from
	#booked a,
	#pending b
where
	a.external_account_id = b.external_account_id
and
	a.date = b.date
and
	a.transaction_type_id = b.transaction_type_id
and
	a.currency_id = b.currency_id



/* Select the output */

create table
	#output(
		id int identity,
		section varchar(200) NULL,
		style varchar(200) NULL,
		account varchar(50) NULL,
		date datetime NULL,
		transaction_type varchar(50) NULL,
		currency varchar(25) NULL,
		amount float NULL,
		recon_amount float NULL)
insert into
	#output(
		section,
		style,
		account,
		date,
		transaction_type,
		currency,
		amount,
		recon_amount)
select
	section = "Pending Only",
	style = @style,
	account = b.symbol,
	a.date,
	transaction_type = c.name,
	currency = d.symbol,
	a.amount,
	a.booked_amount
from
	#pending a,
	external_accounts b,
	transaction_types c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.currency_id = d.product_id
and
	a.booked_amount = NULL
order by
	b.symbol,
	a.date,
	c.name,
	d.symbol
select
	@pending_only = @@rowcount


insert into
	#output(
		section,
		style,
		account,
		date,
		transaction_type,
		currency,
		amount,
		recon_amount)
select
	section = "Pending - Different Amounts",
	style = @style,
	account = b.symbol,
	a.date,
	transaction_type = c.name,
	currency = d.symbol,
	a.amount,
	a.booked_amount
from
	#pending a,
	external_accounts b,
	transaction_types c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.currency_id = d.product_id
and
	abs(a.amount -  a.booked_amount) > .0001
and
	a.booked_amount != NULL
order by
	b.symbol,
	a.date,
	c.name,
	d.symbol
select
	@pending_different = @@rowcount


insert into
	#output(
		section,
		style,
		account,
		date,
		transaction_type,
		currency,
		amount,
		recon_amount)
select
	section = "Booked Only",
	style = @style,
	account = b.symbol,
	a.date,
	transaction_type = c.name,
	currency = d.symbol,
	a.amount,
	a.pending_amount
from
	#booked a,
	external_accounts b,
	transaction_types c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.currency_id = d.product_id
and
	a.pending_amount = NULL
order by
	b.symbol,
	a.date,
	c.name,
	d.symbol
select
	@booked_only = @@rowcount



insert into
	#output(
		section,
		style,
		account,
		date,
		transaction_type,
		currency,
		amount,
		recon_amount)
select
	section = "Booked - Different Amounts",
	style = @style,
	account = b.symbol,
	a.date,
	transaction_type = c.name,
	currency = d.symbol,
	a.amount,
	a.pending_amount
from
	#booked a,
	external_accounts b,
	transaction_types c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.currency_id = d.product_id
and
	abs(a.amount - a.pending_amount) > .00001
and
	a.pending_amount != NULL
order by
	b.symbol,
	a.date,
	c.name,
	d.symbol
select
	@booked_different = @@rowcount 

if lower(convert(varchar(1), @display_output)) = "y"
begin
	select
		section = "Summary",
		style = @style,
		begin_date = @begin_date,
		end_date = @end_date,
		pending_only = @pending_only,
		pending_different = @pending_different,
		booked_only = @booked_only,
		booked_different = @booked_different

	select
		section,
		style,
		account,
		date,
		transaction_type,
		currency,
		amount,
		recon_amount
	from
		#output
	order by
		id
end

if lower(convert(varchar(1), @send_message)) = "y"
begin
	if @pending_only + @pending_different + @booked_only + @booked_different > 0
	begin
		select
			@message = "Execution Fee Netting Mismatch. Check recon report"

		exec
    			api_sendchannelmessage
        			@login=@login,
        			@channel="Admin",
        			@message_type="Normal",
        			@subject="Pending/Committed Fee Recon",
        			@content=@message,
        			@priority="High",
        			@message_id=@message_id output
	end
end




go

