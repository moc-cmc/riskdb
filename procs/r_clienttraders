
if object_id("r_clienttraders") != NULL
    drop procedure
        r_clienttraders
go

create procedure
	r_clienttraders
as

declare @archive_column varchar(1)

select
         @archive_column = "Y"
from
        syscolumns a,
        sysobjects b
where
        a.id = b.id
and
        b.name = "external_accounts"
and
        a.name = "archived_at"

if @archive_column = "Y"
begin

	select 
		name=a.symbol 
	from 
		traders a,
		external_accounts b,
		external_account_types c
	where
		a.external_account_id = b.external_account_id and
		b.external_account_type_id = c.external_account_type_id and
		c.name="Client" and
		b.archived_at = NULL
	order 
		by a.symbol 
end
else
begin
        select
                name=a.symbol
        from
                traders a,
                external_accounts b,
                external_account_types c
        where
                a.external_account_id = b.external_account_id and
                b.external_account_type_id = c.external_account_type_id and
                c.name="Client"
        order
                by a.symbol
end

go
