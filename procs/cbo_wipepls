drop procedure cbo_wipepls
go

create procedure
	cbo_wipepls
		@login varchar(50),
		@trade_date datetime

as


declare @pl_date datetime
declare @begin_date datetime
declare @end_date datetime
declare @ia_records_removed int
declare @ea_records_removed int
declare @cp_records_removed int


select
	@pl_date = convert(date, @trade_date)

delete from
	internal_account_pls
where
	pl_date = @pl_date
select
	@ia_records_removed = @@rowcount


delete from
        external_account_pls
where
        pl_date = @pl_date
select
        @ea_records_removed = @@rowcount

delete from
        counterparty_pls
where
        pl_date = @pl_date
select
        @cp_records_removed = @@rowcount


select
	status = "OK",
	message = "Successfully removed pl records for date",
	pl_date = @pl_date,
	ia_records_removed = @ia_records_removed,
	ea_records_removed = @ea_records_removed,
	cp_records_removed = @cp_records_removed


go



