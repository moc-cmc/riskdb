drop procedure cbo_savepls
go

create procedure
	cbo_savepls
		@login varchar(50),
		@trade_date datetime

as

declare @begin_date datetime
declare @end_date datetime
declare @last_commit_date datetime
declare @cl_total_attrib_pl float
declare @lp_total_attrib_pl float
declare @total_pl float
declare @total_volume float
declare @total_trade_count int
declare @total_avg_size float
declare @total_mm_pl float
declare @fund_name varchar(50)
declare @missing_prices char(1)
declare @mtm_attrib_model_id int
declare @pl_attrib_model_id int
declare @eval_ccy_id int



select
	@trade_date = convert(date, @trade_date)
exec
	r_daterangefordate 
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#trades
(
	trade_id int,
	deal_id int,
	trade_type_id int,
 	internal_account_id int,
 	external_account_id int,
	counterparty_id int,
	contract_id int,
	trader_id int,
	strategy_id int,
	broker_id int,
	sales_code_id int,
	pb_id int NULL,
	qty numeric(30, 4),
	counter_qty numeric(30, 4),
	product_id int NULL,
	currency_id int NULL,
	pd1_eq numeric(30, 4) NULL,
	pd2_eq numeric(30, 4) NULL,
	mtm_pl numeric(30, 4) NULL,
	cl_vo numeric(30, 4) NULL,
	lp_vo numeric(30, 4) NULL,
	vo numeric(30, 4) NULL
)

insert into
	#trades(
		trade_id,
		deal_id,
		trade_type_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		contract_id,
		trader_id,
		strategy_id,
		broker_id,
		sales_code_id,
		qty,
		counter_qty)
select
	trade_id,
	deal_id,
	trade_type_id,
	internal_account_id,
	external_account_id,
	counterparty_id,
	contract_id,
	trader_id,
	strategy_id,
	broker_id,
	sales_code_id,
	quantity,
	quantity * price * -1
from
	trades
where
	trade_date >= @begin_date
and
	trade_date < @end_date
and
	quantity != 0

create nonclustered index u_did on #trades(deal_id)
create nonclustered index u_cid on #trades(counterparty_id)
create nonclustered index u_eid on #trades(external_account_id)


update
	#trades
set
	product_id = b.product_id,
	currency_id = b.currency_id
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

update 
	#trades
set
	pb_id = prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id


/* The only conversion rates that matter are those of the evaluation ccys, so only get those */
create table
        #eval_ccys(
                product_id int,
                symbol varchar(10) NULL
)
insert into
        #eval_ccys(
                product_id)
select
        distinct(evaluation_currency_id)
from
        funds

select
	@eval_ccy_id = evaluation_currency_id
from
	funds

update
        #eval_ccys
set
        symbol = a.symbol
from
        products a,
        #eval_ccys b
where
        a.product_id = b.product_id

create table
	#traded_products(
		product_id int
)

insert into
	#traded_products
select
	distinct(a.product_id)
from
	#trades a,
	forwards b
where
	a.product_id = b.product_id

insert into 
	#traded_products
select
	distinct(a.currency_id)
from
	#trades a,
	forwards b
where
	a.currency_id = b.currency_id
and
	a.currency_id not in(select product_id from #traded_products)

create table
	#conversion_contracts
(
	contract_id int NULL,
	product_id int,
	currency_id int,
	inverse_contract_id int NULL,
	standard_price float NULL,
	conversion_price float NULL
)


insert into 
	#conversion_contracts(
		contract_id,
		product_id,
		currency_id
	)
select
	a.contract_id,
	a.product_id,
	a.currency_id
from
	forwards a,
	#traded_products b,
	#eval_ccys c
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id

update
	#conversion_contracts
set
	inverse_contract_id = a.contract_id
from
	forwards a,
	#conversion_contracts b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id


update
	#conversion_contracts
set
	standard_price = a.price,
	conversion_price = a.price
from
	bo_spot_settles a,
	#conversion_contracts b
where
	a.contract_id = b.contract_id
and
	convert(date, a.price_date) = convert(date, @trade_date)

update
       	#conversion_contracts
set
       	standard_price = a.price,
	conversion_price = 1/a.price
from
       	bo_spot_settles a,
       	#conversion_contracts b
where
       	a.contract_id = b.inverse_contract_id
and
       	convert(date, a.price_date) = convert(date, @trade_date)
and
	b.standard_price = NULL

select
	@missing_prices = "Y"
from
	#conversion_contracts
where
	conversion_price = NULL
if @missing_prices = "Y"
begin
	select
		status = "Error",
		msg = "Missing conversion price. Not saving any attributed PLs"
		
	select
		contract = a.symbol,
		price_date = @trade_date,
		standard_price = b.standard_price,
		conversion_price = b.conversion_price
	from
		contracts a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	
	return

end

insert into
	#conversion_contracts
(
	product_id,
	currency_id,
	conversion_price
)
select
	product_id,
	product_id,
	1.0
from
	#eval_ccys

/* debug 
select * from #traded_products
select * from #conversion_contracts
*/

/* 
   We could use the trade_volumes table to get the volume on trades
   but for a data sanity check, lets just re-calc here for each trade
   since we need it for attribution anyway
*/

update 
	#trades
set
	pd1_eq = qty * conversion_price
from
	#trades a,
	#conversion_contracts b
where
	a.product_id = b.product_id

update
        #trades
set
        pd2_eq = counter_qty * conversion_price
from
        #trades a,
        #conversion_contracts b
where
        a.currency_id = b.product_id

update
	#trades
set
	vo = abs(pd1_eq)

update 
	#trades
set
	cl_vo = vo
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id

update 
        #trades
set
        lp_vo = vo
from
        #trades a
where
        cl_vo = NULL

update
	#trades
set
	mtm_pl = pd1_eq + pd2_eq

select 
	@total_pl = sum(mtm_pl),
	@total_volume = sum(vo) / 1000000,
	@total_trade_count = count(*)
from
	#trades

select
	@total_avg_size = @total_volume / @total_trade_count,
	@total_mm_pl = @total_pl / @total_volume

select
	@fund_name = name
from
	funds

		

create table
	#deals(
		deal_id int,
		tc int NULL,
		total_pl float NULL,
		total_vo float NULL,
		total_cl_vo float NULL,
		total_lp_vo float NULL
)

insert into
	#deals(	
		deal_id,
		tc,
		total_pl,
		total_vo,
		total_cl_vo,
		total_lp_vo
)
select
	deal_id,
	count(*),
	sum(mtm_pl),
	sum(vo),
	sum(cl_vo),
	sum(lp_vo)
from
	#trades
group by
	deal_id

/* debug
select * from #deals
*/
	

create table
	#deal_cl_attrib(
		deal_id int,
		external_account_id int,
		vo float NULL,
		cl_vo float NULL,
		lp_vo float NULL,
		pl float NULL
)

insert into
	#deal_cl_attrib(
		deal_id,
		external_account_id,
		vo,
		cl_vo,
		lp_vo)
select
	deal_id,
	external_account_id,
	sum(abs(pd1_eq)),
	sum(cl_vo),
	sum(lp_vo)
from
	#trades
group by
	deal_id,
	external_account_id

update
	#deal_cl_attrib
set
	pl = a.total_pl * (b.cl_vo / a.total_cl_vo)
from
	#deals a,
	#deal_cl_attrib b
where
	a.deal_id = b.deal_id


create table
        #deal_lp_attrib(
                deal_id int,
                counterparty_id int,
                vo float NULL,
		cl_vo float NULL,
		lp_vo float NULL,
		pl float NULL
)

insert into
        #deal_lp_attrib(
                deal_id,
                counterparty_id,
                vo,
		cl_vo,
		lp_vo)
select
        deal_id,
        counterparty_id,
	sum(abs(pd1_eq)),
	sum(cl_vo),
        sum(lp_vo)
from
        #trades
group by
        deal_id,
        counterparty_id

update
        #deal_lp_attrib
set
        pl = a.total_pl * (b.lp_vo / a.total_lp_vo)
from    
        #deals a,
        #deal_lp_attrib b
where
        a.deal_id = b.deal_id


/* We dont want NULL values for PL */
update
        #deal_lp_attrib
set
	pl = 0
where
	pl = NULL

update
        #deal_cl_attrib
set
        pl = 0
where
        pl = NULL



/* debug
select * from #deal_cl_attrib order by deal_id
select * from #deal_lp_attrib order by deal_id
*/


/* For client and lp PL attribution. We use the deal grouping notional volume */
select
	@pl_attrib_model_id = pl_attribution_model_id
from
	pl_attribution_models
where
	name = "Deal Grouping Notional Volume"
if @pl_attrib_model_id = NULL
begin
	select
		status = "Error",
		msg = "Could not find 'Deal Grouping Notional Volume' attribution model"
	return
end

/* For saving non-attribution pl. We use the mtm pl attribution model */
select
	@mtm_attrib_model_id = pl_attribution_model_id
from
	pl_attribution_models
where
	name = "Per Trade MTM"
if @pl_attrib_model_id = NULL
begin
	select
		status = "Error",
		msg = "Could not find 'Per Trade MTM' attribution model"
	return
end
/* we dont want NULL pl values so update null = 0 */

/* chriso:
   this is doing deal count, instead of a trade count. Works with b2bs but not w multiple fill deals i think
   need to check this
*/
insert into
	external_account_pls(
		external_account_id,
		pl_date,
		pl_attribution_model_id,
		product_id,
		pl,
		trade_count
)
select
	external_account_id,
	@trade_date,
	@pl_attrib_model_id,
	@eval_ccy_id,
	sum(pl),
	count(*)
from
	#deal_cl_attrib
group by
	external_account_id
	

/* Get counterparty totals from deal/cpty totals */
insert into
	counterparty_pls(
		counterparty_id,
		pl_date,
		pl_attribution_model_id,
		product_id,
		pl,
		trade_count
)
select
	counterparty_id,
	@trade_date,
	@pl_attrib_model_id,
	@eval_ccy_id,
	sum(pl),
	count(*)
from
	#deal_lp_attrib
group by
	counterparty_id
	

/* Store the total pl for the day */
insert into
	internal_account_pls(
		internal_account_id,
		pl_date,
		pl_attribution_model_id,
		product_id,
		pl,
		trade_count
)
select
	internal_account_id,
	@trade_date,
	@mtm_attrib_model_id,
	@eval_ccy_id,
	sum(mtm_pl),
	count(*)
from
	#trades
group by
	internal_account_id




	





go
