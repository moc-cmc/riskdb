drop procedure
	r_editrollspread
go

create procedure
	r_editrollspread
		@login varchar(50),
		@spread_group_name varchar(50),
		@symbol varchar(50),
		@spread float
		
as


declare @roll_spread_group_id int
declare @contract_id int

select
	@roll_spread_group_id = roll_spread_group_id
from
	roll_spread_groups
where
	name = @spread_group_name
if @roll_spread_group_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding group for name",
		name = @spread_group_name

	exec
        	r_managerollspreadgroups
                	@login

	return
end
select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding contract",
		contract = @symbol
	exec
		r_managerollspreadgroups
			@login
	return
end

update
	contract_roll_spreads
set
	spread = @spread
where
	roll_spread_group_id=@roll_spread_group_id
and
	contract_id = @contract_id
	
	
exec
	r_managerollspreadgroups
		@login,
		@spread_group_name


go
