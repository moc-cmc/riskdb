drop procedure
	api_initcollateralproduct
go

create procedure
	api_initcollateralproduct
		@login varchar(50),
		@external_account varchar(50),
		@trade_date datetime, 
		@product_id int output,
		@contract_id int output

as

declare @fund_id int
declare @currency_id int
declare @currency varchar(50)
declare @product_type_id int
declare @exchange_id int
declare @symbol varchar(50)
declare @product_rate_id int
declare @external_account_id int
declare @product varchar(50)
declare @account_transaction_id int
declare @transaction_type_id int
declare @transaction_date datetime
declare @entered_by int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @currency_id = NULL
begin
	select
		status = "Error",
		message = "Fund evaluation currency not found"
	return
end

select
	@currency = symbol
from
	products
where
	product_id = @currency_id

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "External account not found",
		external_account = @external_account
	return
end


select
	@product_type_id = product_type_id
from
	product_types
where
	name = "Collateral Balance"
if @product_type_id = NULL
begin
	exec
		j_nextkey
			"product_types",
			@product_type_id output

	insert into
		product_types(
			product_type_id,
			name)
	values(
		@product_type_id,
		"Collateral Balance")

end


select
	@exchange_id = exchange_id
from
	exchanges
where
	name = "OTC"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "OTC exchange not found"
	return
end

select
	@product = "CB" + rtrim(convert(varchar(15), @external_account_id))


select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Collateral Balance"
if @transaction_type_id = NULL
begin
	exec
		j_nextkey
			"transaction_types",
			@transaction_type_id output

	insert into
		transaction_types(
			transaction_type_id,
			name,
			direction)
	values(
		@transaction_type_id,
		"Collateral Balance",
		1)
end

select
	@transaction_date = @trade_date

select
	@entered_by = account_id
from
	tico_accounts
where
	login = @login
if @entered_by = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

update
	external_accounts
set
	collateral_product_id = @product_id
where
	external_account_id = @external_account_id

select
	@symbol = rtrim(@product) + rtrim(@currency)

exec
	j_nextkey
		"contracts",
		@contract_id output
exec
	j_nextkey
		"account_transactions",
		@account_transaction_id output
exec
	j_nextkey
		"product_rates",
		@product_rate_id output
exec
	j_nextkey
		"products",
		@product_id output

begin tran
	insert into
		products(
			product_id,
			product_type_id,
			symbol,
			name)
	values(
		@product_id,
		@product_type_id,
		@product,
		@product)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not add product",
			product = @product,
			account = @external_account
		rollback tran
		return
	end
		
	insert into
		forwards(
			contract_id,
			currency_id,
			product_id,
			quantity,
			exchange_id)
	values(
		@contract_id,
		@currency_id,
		@product_id,
		1,
		@exchange_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not add forward",
			product = @product,
			account = @external_account
		rollback tran
		return
	end
	
	insert into
		contracts(
			contract_id,
			symbol,
			instrument_id)
	values(
		@contract_id,
		@symbol,
		1)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not add contract",
			contract = @symbol,
			account = @external_account
		rollback tran
		return
	end
	
	insert into
		product_rates(
			product_rate_id,
			product_id,
			rate_date)
	values(
		@product_rate_id,
		@product_id,
		"1/1/10")
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not add product rate",
			product = @product,
			account = @external_account
		rollback tran
		return
	end

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
		@product_rate_id,
		1,
		0.0)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not add rate point",
			product = @product,
			account = @external_account
		rollback tran
		return
	end

	insert into
		account_transactions(
			account_transaction_id,
			entered_by,
			external_account_id,
			transaction_type_id,
			transaction_date,
			currency_id,
			amount)
	values(
		@account_transaction_id,
		@entered_by,
		@external_account_id,
		@transaction_type_id,
		@transaction_date,
		@product_id,
		1.0)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not add collateral balance transaction",
			product = @product,
			account = @external_account
		rollback tran
		return
	end

	update
		external_accounts
	set
		collateral_product_id = @product_id
	where
		external_account_id = @external_account_id
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Could not set collateral product for account",
			account = @external_account
		rollback tran
		return
	end

commit tran


go
