use
	risk_jeff
go

drop procedure
	ag_netlinkidentifiers
go

create procedure
	ag_netlinkidentifiers
		@login varchar(50),
		@run_name varchar(50),
		@trade_date datetime=NULL
as

declare @begin_date datetime
declare @end_date datetime
declare @run_id int

select
	@run_id = a.run_id
from
	user_runs a,
	runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	a.tico_account_id = c.account_id
and
	c.login = @login
and
	b.name = @run_name
if @run_id = NULL
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end


if @trade_date = NULL
	select
		@trade_date = convert(datetime, convert(date, getdate()))


exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#trades(
		id int identity,
		identifier varchar(100),
		trade_id int)
insert into
	#trades(
		identifier,
		trade_id)
select
	a.identifier,
	a.trade_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
order by
	a.trade_date

/* Custom for Jefferies */
insert into
        #trades(
                identifier,
                trade_id)
select
        a.identifier,
        a.trade_id
from
        trades a,
        #external_accounts b,
        #internal_accounts c,
        #traders d,
        #strategies e,
        #brokers f,
        #counterparties g,
	trade_notifications h,
	sources i
where
	a.trade_id = h.trade_id
and
	h.source_id = i.source_id
and
	i.name in(
                "Spectrum Client SpotFwd",
                "Spectrum Market SpotFwd",
                "Spectrum Client Swap",
                "Spectrum Internal SpotFwd",
                "Spectrum Market Swap")
and
        a.external_account_id = b.external_account_id
and
        a.internal_account_id = c.internal_account_id
and
        a.trader_id = d.trader_id
and
        a.strategy_id = e.strategy_id
and
        a.broker_id= f.broker_id
and
        a.counterparty_id = g.counterparty_id
and
        a.trade_date >= @end_date
and
        h.notify_date < dateadd(minute, 10, @end_date)
order by
        a.trade_date
/* End custom for Jefferies */


update
	#trades
set
	identifier = left(identifier, char_length(identifier) - 2)
where
	identifier like "%.m"

update
	#trades
set
	identifier = left(identifier, char_length(identifier) - 2)
where
	identifier like "%.c"

update
        #trades
set
        identifier = left(identifier, char_length(identifier) - 4)
where
        identifier like "%.m.f"

select
	identifier,
	trade_id
from
	#trades
order by
	id



go
