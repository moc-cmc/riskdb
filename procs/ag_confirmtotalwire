use
	risk_admis
go

drop procedure
	ag_confirmtotalwire
go

create procedure
	ag_confirmtotalwire
		@login varchar(50),
		@account varchar(50),
		@product varchar(50),
		@value_date datetime,
		@non_same_day numeric(30,4),
		@same_day_settlement numeric(30,4),
		@total numeric(30,4)
as

declare @tico_account_id int
declare @product_id int
declare @pb_wire_signoff_id int
declare @external_account_id int
declare @confirmation_type_id int
declare @non_same_type_id int
declare @same_type_id int
declare @status_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@status_id = status_id
from
	statuses
where
	name = "Pending"
if @status_id = NULL
begin
	select
		status = "Error",
		message = "Pending status not found"
	return
end

select
	@confirmation_type_id = confirmation_type_id
from
	confirmation_types
where
	name = "Total"
if @confirmation_type_id = NULL
begin
	select
		status = "Error",
		message = "Total confirmation type not found"
	return
end

select
	@same_type_id = confirmation_type_id
from
	confirmation_types
where
	name = "Same Day"
if @confirmation_type_id = NULL
begin
	select
		status = "Error",
		message = "Same Day Confirmation type not found"
	return
end

select
	@non_same_type_id = confirmation_type_id
from
	confirmation_types
where
	name = "Non Same Day"
if @confirmation_type_id = NULL
begin
	select
		status = "Error",
		message = "Non Same Day Confirmation type not found"
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @account
	return
end

	
select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

exec
	j_nextkey
		"pb_wire_signoffs",
		@pb_wire_signoff_id output


begin tran
	insert into
		pb_wire_signoffs(
			pb_wire_signoff_id,
			tico_account_id,
			timestamp,
			external_account_id,
			confirmation_type_id,
			product_id,
			value_date,
			amount,
			status_id)
	values(
		@pb_wire_signoff_id,
		@tico_account_id,
		getdate(),
		@external_account_id,
		@confirmation_type_id,
		@product_id,
		@value_date,
		@total,
		@status_id)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add wire signoff"
		rollback tran
		return
	end

	insert into
		wire_allocations(
			pb_wire_signoff_id,
			external_account_id,
			confirmation_type_id,
			amount)
	values(
		@pb_wire_signoff_id,
		@external_account_id,
		@non_same_type_id,
		@non_same_day)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add non same day wire allocation"
		rollback tran
		return
	end

	insert into
		wire_allocations(
			pb_wire_signoff_id,
			external_account_id,
			confirmation_type_id,
			amount)
	values(
		@pb_wire_signoff_id,
		@external_account_id,
		@same_type_id,
		@same_day_settlement)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to add same day wire allocation"
		rollback tran
		return
	end


commit tran

exec
	ag_confirmsettlements
		@login = @login,
		@value_date = @value_date,
		@account = NULL,
		@product = NULL





go
