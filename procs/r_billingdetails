drop procedure r_billingdetails
go

create procedure
	r_billingdetails
		@login varchar(50),
		@due_date datetime=null

as

declare @tico_account_id int
declare @has_permission char(1)
declare @current_month int
declare @current_month_string char(2)
declare @current_year int
declare @current_year_string char(4)
declare @current_day int
declare @current_day_string char(2)
declare @now datetime
declare @first_day_string varchar(25)
declare @first_day_this_month datetime
declare @last_day_prev_month datetime
declare @jan_one char(1)

select
	@jan_one = "N"

if @login not in ("bgcops", "ralec@bgcpartners.com", "cfeops", "adean2@bgcpartners.com")
begin
	select
        	status = "Under Maintenance",
        	message = "<b>Maintenance Msg</b>" + ": We apologize. The billing system is undergoing maintenance at this time. Please contact support@elysiumtechgroup.com for further information"
	return
end


select
        @tico_account_id = account_id
from
        tico_accounts
where
        login = @login

select
	@has_permission = "Y"
from
	access_groups a,
	access_group_accounts b
where
	a.access_group_id = b.access_group_id
and
	a.name = "Billing Admin"
and
	b.tico_account_id = @tico_account_id
	

if @has_permission != "Y"
begin
	select
		status = "Error",
		message = "<b>Permission Denied</b>" + " - User must be configured as 'Billing Admin' to view this report"
	return
end


/* Ensure the @due_date is set to the first day of the month when @due_date*/
if @due_date = NULL
begin
	select
		@due_date = getdate()

	select
		@current_month = datepart(mm, @due_date),
		@current_year = datepart(yy, @due_date),
		@current_day = datepart(dd, @due_date)
	
	select
		@current_year_string = convert(char(4), @current_year)
	
	if @current_month < 10
	begin
		select
			@current_month_string = "0"+rtrim(convert(char(1), @current_month))
	end
	else
	begin
		select
			@current_month_string = rtrim(convert(char(2), @current_month))
	end
	
	if @current_day < 10
	begin
		select
			@current_day_string = "0"+rtrim(convert(char(1), @current_day))
	end
	else
	begin
		select
			@current_day_string = rtrim(convert(char(2), @current_day))
	end
	
	select
		@first_day_string = @current_year_string+@current_month_string+"01"
	
	select
		@first_day_this_month = convert(date, @first_day_string)
	
	exec
		r_prevbusinessday
			@first_day_this_month, 
			@last_day_prev_month output
	
	select
		@first_day_this_month = NULL
	
	
	exec
		r_nextbusinessday 
			@last_day_prev_month,
			@first_day_this_month output
	
	if datepart(mm, @first_day_this_month) = 1 and datepart(dd, @first_day_this_month) = 1 
	begin
		exec
        		r_nextbusinessday
                		@first_day_this_month,
                		@due_date output
	end
	else
	begin
		select
			@due_date = @first_day_this_month
	end
end
	
exec
	e_billingdetails
		@login = @login,
		@due_date = @due_date

	

go

