use
	risk_firsel
go

drop procedure
	lw_importcities
go

create procedure
	lw_importcities
		@login varchar(50),
		@city varchar(200)=NULL,
		@state_code varchar(50)=NULL,
		@county varchar(200)=NULL
as


declare @state_id int
declare @source_id int
declare @city_id int
declare @county_id int
declare @total int

select
	@source_id = source_id
from
	sources
where
	name = "Firsel"
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Firsel source not found"
	return
end



select
	@state_id = state_id
from
	state_symbols
where
	source_id = @source_id
and
	symbol = @state_code
if @state_id = NULL
begin
	select
		@state_id = state_id
	from
		states
	where
		code = @state_code
	if @state_id = NULL
	begin
		select
			status = "Error",
			message = "Unable to find state",
			state_code = @state_code
		return
	end
end

select
	@city_id = a.city_id
from
	city_symbols a,
	cities b
where
	a.city_id = b.city_id
and
	b.state_id = @state_id
and
	a.source_id = @source_id
and
	a.symbol = @city
if @city_id = NULL
begin
	select
		@city_id = city_id
	from
		cities
	where
		state_id = @state_id
	and
		name = @city
	if @city_id = NULL
	begin
		exec
			j_nextkey
				"cities",
				@city_id output

		/* select
			city_id = @city_id,
			city = @city,
			state = @state_code,
			county = @county */
			

		insert into
			cities
		values(
			@city_id,
			@city,
			@state_id)
	end
end


select
	@county_id = county_id
from
	counties
where
	name = @county
and
	state_id = @state_id
if @county_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve county",
		county = @county
	return
end

select
	@total = count(*)
from
	county_cities
where
	county_id = @county_id
and
	city_id = @city_id
if @total = 0
begin
	insert into
		county_cities
	values(
		@county_id,
		@city_id)
end


select
	city = a.name,
	state = b.name,
	county = d.name
from
	cities a,
	states b,
	county_cities c,
	counties d
where
	a.state_id = b.state_id
and
	a.city_id = c.city_id
and
	c.county_id = d.county_id
and
	a.city_id = @city_id
	


go
