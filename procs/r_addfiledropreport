create or replace procedure
	r_addfiledropreport
		@login varchar(50),
		@filedrop_report varchar(100)

as

declare @filedrop_report_id int


select
	@filedrop_report_id = filedrop_report_id
from
	filedrop_reports
where
	name = @filedrop_report

if @filedrop_report_id != NULL
begin
	select
		status = "Error",
		msg = "Report already created",
		report = @filedrop_report
	return
end
else
begin
	insert into
		filedrop_reports(
			name)
	select
		@filedrop_report
end

select
	status = "Success",
	msg = "Report added",
	report = @filedrop_report

exec
	r_viewfiledropreports
		@login=@login

go		
