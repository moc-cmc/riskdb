drop procedure cn_tradelistlite
go


create procedure
	cn_tradelistlite
		@login varchar(50),
		@run_name varchar(50),
		@trade_date datetime=NULL
as

declare @run_id int
declare @begin_day_string char(20)
declare @end_day_string char(20)
declare @evaluation_currency_id int
declare @fund_id int
declare @max_commit_date datetime
declare @begin_date datetime
declare @end_date datetime

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

select
	@begin_date = @trade_date

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Format Number",
	"volume",
	NULL,
	NULL,
	"#,##0")


insert into
	#links
values(
	"Column Link",
	"edit_trade",
	"Deal Trade Inspector",
	NULL,
	NULL)


select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)

insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#trades(
		deal_id int,
		trade_id int,
		trade_date datetime,
		product_id int NULL,
		contract_id int,
		value_date datetime,
		quantity numeric(30,4),
		volume float NULL,
		trade_price float,
		trader_id int,
		broker_id int,
		external_account_id int,
		counterparty_id int,
		sales_code_id int,
		trade_type varchar(20),
		status_id int
)


insert into
	#trades
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	product_id = NULL,
	a.contract_id,
	a.value_date,
	a.quantity,
	volume = NULL,
	a.price,
	a.trader_id,
	a.broker_id,
	a.external_account_id,
	a.counterparty_id,
	a.sales_code_id,
	h.name,
	a.status_id
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	trade_types h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_type_id = h.trade_type_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date


update
	#trades
set
	a.trade_price = 1.0 / a.trade_price
from
	#trades a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
	
update
	#trades
set
	a.product_id = b.product_id
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id


select
        @max_commit_date = max(a.commit_date)
from
	daily_commits a,
	commit_statuses b
where
	b.name = "Commit Complete"

if @max_commit_date > @begin_date
begin

	update
		#trades
	set
		a.volume = b.volume
	from
		#trades a,
		trade_volumes b
	where
		a.trade_id = b.trade_id
	and
		b.product_id = @evaluation_currency_id
	/* The trade id will be the date query here */
end

select
	a.deal_id,
	a.trade_id,
	a.trade_type,
	trade_date = convert(char(11), a.trade_date, 1),
	trade_time = right(convert(char(26), a.trade_date, 9), 14),
	a.value_date,
	b.symbol,
	a.quantity,
	volume = abs(a.volume),
	a.trade_price,
	trader = c.symbol,
	broker = d.symbol,
	external_account = e.symbol,
	counterparty = g.name,
	sales_code = f.name,
	status = h.name,
	edit_trade = "EDIT"
from
	#trades a,
	contracts b,
	traders c,
	brokers d,
	external_accounts e,
	sales_codes f,
	counterparties g,
	statuses h
where
	a.contract_id = b.contract_id
and
	a.trader_id = c.trader_id
and
	a.broker_id = d.broker_id
and
	a.external_account_id = e.external_account_id
and
	a.sales_code_id = f.sales_code_id
and
	a.counterparty_id = g.counterparty_id
and
	a.status_id = h.status_id
order by
	a.deal_id,
	a.trade_id

go
