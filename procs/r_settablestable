create or replace procedure
	r_settablestable
		@name varchar(50),
		@table_type char(1)

as

declare @table_id int
declare @message varchar(50)

select
	@table_type = upper(@table_type)

if @table_type not in("E", "J", "L")
begin
	select
		status = "Error",
		message = "Must provide table type as enum 'E', journal 'J', list 'L'",
		provided = @table_type
	return
end

select
	@table_id = table_int
from
	tables
where
	name = @name
if @table_id = NULL
begin
	insert into
		tables(
			name,
			table_type)
	values(
		@name,
		@table_type
	)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			msg = "Could not insert new table",
			table_name = @name,
			table_type = @table_type
		return
	end
	else
	begin
		select
			@message = "Added table"
	end
end
else
begin			
	begin tran
		update 
			tables
		set
			name = @name,
			table_type = @table_type
		where
			table_int = @table_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				msg = "Problem updating tables table",
				table_type = @table_type,
				table_name = @name,
				table_id = @table_id
			rollback 
			return
		end
	commit tran
	select
		@message = "Updated tables table"
end

select
	status = "Success",
	msg = @message,
	table_name = @name,
	table_type = @table_type

go
	
		

