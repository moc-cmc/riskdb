create or replace procedure
	api_addletostanardlogins
		@login varchar(50),
		@legal_entity varchar(150)

as



declare @legal_entity_id int

declare @tico_account_id int

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end



select
        @legal_entity_id = a.legal_entity_id
from
        legal_entities a
where
        a.name = @legal_entity
if @legal_entity_id = NULL
begin
        select
                status = "Error",
                message = "Legal entity not found",
                legal_entity = @legal_entity
        return
end


create table
        #external_accounts(
                external_account_id int,
                symbol varchar(50) NULL,
                name varchar(100) NULL)
	
insert into
        #external_accounts(
                external_account_id,
                symbol,
		name)
select
        a.external_account_id,
        b.symbol,
	b.name
from
        bo_master_accounts a,
        external_accounts b
where
        a.external_account_id = b.external_account_id
and
        a.legal_entity_id = @legal_entity_id

insert into
        #external_accounts(
                external_account_id,
                symbol,
		name)
select
        b.external_account_id,
        b.symbol,
	b.name
from
        bo_master_accounts a,
        external_accounts b,
        fo_sub_accounts c
where
        a.bo_master_account_id = c.bo_master_account_id
and
        c.external_account_id = b.external_account_id
and
        a.legal_entity_id = @legal_entity_id


create table
	#runs(
		run_id int,
		run_name varchar(150)
)

insert into
	#runs
select
	a.run_id,
	a.name
from
	runs a
where
	name = @legal_entity
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Problem finding legal entity run",
		legal_entity = @legal_entity
	return
end


insert into 
	#runs
select
	a.run_id,
	a.name
from
	runs a,
	#external_accounts b
where
	a.name = b.symbol

/*select * from #runs*/

create table
	#users(
		tico_account_id int,
		login varchar(50)
)

insert into
	#users
select
	a.account_id,
	a.login
from
	tico_accounts a,
	tico_account_types b,
	login_types c
where
	a.account_id = b.tico_account_id
and
	b.login_type_id = c.login_type_id
and
	c.name = "Standard"
and
	a.login not in("jmaranis.sjm", "jwyman.sjmdemo")

insert into
        #users
select
        a.account_id,
        a.login
from
        tico_accounts a,
        tico_account_types b,
        login_types c
where
        a.account_id = b.tico_account_id
and
        b.login_type_id = c.login_type_id
and
        c.name = "Elysium"
and
	a.login = "sjm.etg"


create table
	#legal_entity_tico_accounts(
		legal_entity_id int,
		tico_account_id int,
		login varchar(50)
)

insert into
	#legal_entity_tico_accounts(
		legal_entity_id,
		tico_account_id,
		login)
select
	@legal_entity_id,
	tico_account_id,
	login
from
	#users

delete 
	#legal_entity_tico_accounts
from
	#legal_entity_tico_accounts a,
	legal_entity_tico_accounts b
where
	a.legal_entity_id = b.legal_entity_id
and
	a.tico_account_id = b.tico_account_id

select
	"Adding LE Tico Account",
	@legal_entity,
	login
from
	#legal_entity_tico_accounts
	
insert into
	legal_entity_tico_accounts(
		legal_entity_id,
		tico_account_id)
select
	legal_entity_id,
	tico_account_id
from
	#legal_entity_tico_accounts

	

create table
	#user_runs(
		tico_account_id int,
		run_id int,
		login varchar(50),
		run_name varchar(100)
)


insert into
	#user_runs
select
	a.tico_account_id,
	b.run_id,
	a.login,
	b.run_name
from
	#users a,
	#runs b


delete 
	#user_runs
from
	#user_runs a,
	user_runs b
where
	a.tico_account_id = b.tico_account_id
and
	a.run_id = b.run_id


select
	"Adding Run for Login",
	login,
	run_name
from
	#user_runs

insert into
	user_runs(
		tico_account_id,
		run_id)
select
	tico_account_id,
	run_id
from
	#user_runs



	

go
