create or replace procedure
	eod_fxlsettlementdetails
		@login varchar(50),
		@run_name varchar(50),
		@trade_date datetime=NULL
as


declare @source_id int
declare @cancelled_count int
declare @traiana_id_prefix varchar(15)
declare @run_id int
declare @begin_day_string varchar(50)
declare @end_day_string varchar(50)
declare @cancelling_src_status_id int
declare @cancelled_status_id int
declare @usd_product_id int
declare @evaluation_currency_id int
declare @trades_begin datetime
declare @begin_date datetime
declare @end_date datetime
	

select
	@run_id = a.run_id
from
	runs a
where
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end


if @trade_date = NULL
begin
        select
                @trade_date = getdate()
        select
                @trade_date = convert(date, @trade_date)
end

exec
        r_daterangefordate
                @trade_date,
                @begin_date output,
                @end_date output

