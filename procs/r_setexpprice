
drop procedure
	r_setexpprice
go

create procedure
	r_setexpprice
		@login varchar(50),
		@symbol varchar(50),
		@expiration_name varchar(50),
		@price float


as

declare @contract_id int

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

update
	expiration_prices
set
	price = @price
where
	contract_id = @contract_id
and
	expiration_name = @expiration_name
if @@rowcount = 0
begin
	insert into
		expiration_prices(
			expiration_name,
			contract_id,
			price)
	values(
		@expiration_name,
		@contract_id,
		@price)
end

exec
	ag_optioncalendar
		@login = @login,
		@as_of_date = NULL,
		@expiration_name = @expiration_name


go

