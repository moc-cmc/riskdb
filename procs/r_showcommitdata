create procedure
	r_showcommitdata
		@login varchar(50),
		@reval_date datetime

as 

create table
        #meta(
                meta_type char(200),
                name char(30),
                action char(200) NULL,
                value char(255) NULL
)



insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta


begin tran
	delete from
		risk_commit_aggregates
	where
		commit_status != "Committed"
commit



exec 
	r_getcommitdata
		@login,
		@reval_date

create table
	#commit_data(
		client_name varchar(50),
		bo_trade_date datetime,
		commit_status varchar(50),
		evaluation_currency varchar(50) NULL,
		spot_trades int NULL,
		spot_volume float NULL,
		forward_trades int NULL,
		forward_volume float NULL,
		forward_option_trades int NULL,
		forward_option_volume float NULL,
		exotic_trades int NULL,
		exotic_volume float NULL,
		forward_swap_trades int NULL,
		forward_swap_volume float NULL,
		style varchar(100) NULL
)

insert into
	 #commit_data
select
	        b.name,
                a.bo_trade_date,
                a.commit_status,
                a.evaluation_currency,
                a.spot_trades,
                a.spot_volume,
                a.forward_trades,
                a.forward_volume,
                a.forward_option_trades,
                a.forward_option_volume,
                a.exotic_trades,
                a.exotic_volume,
                a.forward_swap_trades,
                a.forward_swap_volume,
		NULL
from
	risk_commit_aggregates a,
        external_accounts b
where
        @reval_date = a.bo_trade_date
and
        a.external_account_id = b.external_account_id
and
        a.commit_status = "Committed"


insert into
         #commit_data
select
                b.name,
                a.bo_trade_date,
                a.commit_status,
                a.evaluation_currency,
                a.spot_trades,
                a.spot_volume,
                a.forward_trades,
                a.forward_volume,
                a.forward_option_trades,
                a.forward_option_volume,
                a.exotic_trades,
                a.exotic_volume,
                a.forward_swap_trades,
                a.forward_swap_volume,
                "color:#FF0000"
from
        risk_commit_aggregates a,
        external_accounts b
where
        @reval_date = a.bo_trade_date
and
        a.external_account_id = b.external_account_id
and
	a.commit_status != "Committed"


select
	"Client" = a.client_name,
	"Reval Date" = convert(char(11), a.bo_trade_date, 1),
	"Commit Status" = commit_status,
	"Evaluation Currency" = a.evaluation_currency,
	"Spot Trades" = a.spot_trades,
	"Spot Volume" = convert(numeric(30,2),a.spot_volume),
	"Forward Trades" = a.forward_trades, 
	"Forward Volume" = convert(numeric(30,2), a.forward_volume),       
	"Forward Option Trades" = a.forward_option_trades, 
	"Forward Option Volume" = a.forward_option_volume, 
	"Exotic Trades" = a.exotic_trades, 
	"Exotic Volume" = a.exotic_volume,      
	"Forward Swap Trades" = a.forward_swap_trades,
	"Forward Swap Volume" = convert(numeric(30,2), a.forward_swap_volume),
	a.style
from
	#commit_data a
order by
	a.client_name


select
	"Client" = "All Committed Clients",
	"Reval Date" = convert(char(11), a.bo_trade_date, 1),
	"Commit Status" = commit_status,
	"Evaluation Currency" = a.evaluation_currency,
	"Total Spot Trades" = sum(a.spot_trades),
        "Total Spot Volume" = sum(convert(numeric(30,2),a.spot_volume)),
        "Total Forward Trades" = sum(a.forward_trades),
        "Total Forward Volume" = sum(convert(numeric(30,2), a.forward_volume)),
        "Total Forward Option Trades" = sum(a.forward_option_trades),
        "Total Forward Option Volume" = sum(a.forward_option_volume),
        "Total Exotic Trades" = sum(a.exotic_trades),
        "Total Exotic Volume" = sum(a.exotic_volume),
        "Total Forward Swap Trades" = sum(a.forward_swap_trades),
        "Total Forward Swap Volume" = sum(convert(numeric(30,2), a.forward_swap_volume)),
        a.style
from
	#commit_data a
where
	commit_status = "Committed"
	
group by
	a.bo_trade_date,
	a.commit_status,
	a.evaluation_currency,
	a.style

select
	"Total Trades" = sum(a.spot_trades + a.forward_trades + a.forward_option_trades + a.exotic_trades + a.forward_swap_trades),
	"Total Volume" = sum(convert(numeric(30,2), a.spot_volume + a.forward_volume + a.forward_option_volume + a.exotic_volume + a.exotic_volume + a.forward_swap_volume))
from
	#commit_data a
group by
        a.bo_trade_date,
        a.commit_status,
        a.evaluation_currency,
        a.style

	

