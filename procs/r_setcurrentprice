use
	risk_cantor
go

drop procedure
        r_setcurrentprice
go
create procedure
	r_setcurrentprice
		@symbol char(50),
		@price float
as

declare @contract_id int

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol

if @contract_id = NULL
	return

update
	current_prices
set
	price = @price,
	timestamp = getdate()
where
	contract_id = @contract_id
if @@rowcount = 0
begin
	insert into
		current_prices
	values(
		@contract_id,
		@price,
		getdate())
end
			
go
