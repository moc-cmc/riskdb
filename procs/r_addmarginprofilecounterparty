drop procedure r_addmarginprofilecounterparty
go

create procedure
	r_addmarginprofilecounterparty
		@login varchar(50),
		@margin_profile varchar(50),
		@counterparty varchar(50)

as

declare @margin_profile_id int
declare @counterparty_id int

select
	@margin_profile_id = margin_profile_id
from
	margin_profiles
where
	name=@margin_profile
if @margin_profile_id = NULL
begin
	select
		error="Error",
		msg="Margin profile not found", @margin_profile
	return
end

select
        @counterparty_id = counterparty_id
from
        counterparties
where
        name=@counterparty
if @counterparty_id = NULL
begin
        select
                error="Error",
                msg="counterparty not found", @counterparty
        return
end


insert into
	margin_profile_counterparties(
		margin_profile_id,
		counterparty_id)
values(
	@margin_profile_id,
	@counterparty_id
)
if @@rowcount != 1
begin
	select
		status = "Error adding conterparty to margin profile",
		margin_profile = @margin_profile,
		counterparty = @counterparty
	return
end

select
	status = "Successfully created added counterparty to margin profile",
	margin_profile = @margin_profile,
	counterparty = @counterparty

exec
	r_viewmarginprofile
		@login,
		@margin_profile

go

	
