declare @has_permission char(1)
declare @tico_account_id int

select
    @has_permission = "N"

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login

select
    @has_permission = "Y"
from
    access_groups a,
    access_group_accounts b
where
    a.access_group_id = b.access_group_id
and
    a.name = "Risk Class Admin"
and
    b.tico_account_id = @tico_account_id
    

if @has_permission != "Y"
begin
    select
	status = "Error",
	message = "<b>Permission Denied</b>" + " - User must be configured as 'Risk Class Admin' to view report"
    return
