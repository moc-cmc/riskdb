use
	risk_jeff
go

drop procedure
	ag_matchfssbalance
go

create procedure
	ag_matchfssbalance
		@login varchar(50),
		@ext_account varchar(50),
		@product varchar(50),
		@trade_date datetime,
		@ledger_end_bal numeric(30,8),
		@fss_end_bal numeric(30,8)
as


declare @adjustment numeric(30,8)
declare @product_id int
declare @external_account_id int
declare @transaction_type_id int
declare @account_transaction_id int
declare @tico_account_id int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@trade_date = convert(datetime, convert(date, @trade_date))

select
	@adjustment = @fss_end_bal - @ledger_end_bal

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @ext_account
if @external_account_id = NULL
begin
	select
		status = "Error",
		message = "Ext account not found",
		ext_account = @ext_account
	return
end

select
	@transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Net Cash Activity"
if @transaction_type_id = NULL
begin
	select
		status = "Error",
		message = "Net Cash Activity transaction type not found"
	return
end

exec
	j_nextkey
		"account_transactions",
		@account_transaction_id output
begin tran
	update
		account_transactions
	set
		amount = @adjustment
	where
		currency_id = @product_id
	and
		external_account_id = @external_account_id
	and
		convert(date, transaction_date) = convert(date, @trade_date)
	if @@rowcount = 0
	begin
		insert into
			account_transactions(
				account_transaction_id,
				entered_by,
				external_account_id,
				transaction_type_id,
				transaction_date,
				currency_id,
				amount)
		values(
			@account_transaction_id,
			@tico_account_id,
			@external_account_id,
			@transaction_type_id,
			@trade_date,
			@product_id,
			@adjustment)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Unable to add adjustment record",
				product = @product,
				account = @ext_account,
				adjustment = @adjustment
			rollback tran
			return
		end
	end
commit tran

exec
	ag_fssbalancerecon
		@login = @login

go			
			
			




