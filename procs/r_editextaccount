drop procedure
	r_editextaccount
go

create procedure
	r_editextaccount
		@login varchar(50),
		@external_account varchar(50),
		@aggregation_style varchar(50),
		@new_symbol varchar(50)=NULL,
		@new_aggregation_style varchar(50)=NULL

as

declare @external_account_id int
declare @aggregation_style_id int
declare @new_aggregation_style_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account

if @new_symbol != NULL
begin
	
	update 
		external_accounts 
	set
		symbol = @new_symbol,
		name = @new_symbol
	where
		name = @external_account
	
	update
		traders
	set
		symbol = @new_symbol
	where
		symbol = @external_account
	
	update
		internal_accounts
	set	
		symbol = @new_symbol,
        	name = @new_symbol
	where
        	name = @external_account
	
	update
		runs
	set
		name = @new_symbol
	where
		name = @external_account
	
	update
		portfolios
	set
		name = @new_symbol
	where
		name = @external_account
	

	select
		msg = "Successfully edited " + @external_account + " to " + @new_symbol

end

if @new_aggregation_style != NULL
begin

	select
                @new_aggregation_style_id = aggregation_style_id
        from
                aggregation_styles
        where
                name = @new_aggregation_style

		
	update
		external_accounts
	set
		aggregation_style_id = @new_aggregation_style_id 
	where
		external_account_id = @external_account_id

	select
                msg = "Successfully edited " + @aggregation_style + " to " + @new_aggregation_style
end

	


exec
	r_accountoverview
		@login,
		@new_symbol

go


