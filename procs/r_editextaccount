drop procedure
	r_editextaccount
go

create procedure
	r_editextaccount
		@login varchar(50),
		@external_account varchar(50),
		@account_name varchar(50),
		/*@aggregation_style varchar(50),*/
		@new_symbol varchar(50)=NULL,
		@new_name varchar(50)=NULL
		/*@new_aggregation_style varchar(50)=NULL*/

as

declare @external_account_id int
declare @aggregation_style_id int
declare @new_aggregation_style_id int

select
	@external_account_id = external_account_id
from
	external_accounts
where
	symbol = @external_account

if @new_symbol = NULL 
begin
	select
		@new_symbol = @external_account
end

if @new_name = NULL
begin
	select
		@new_name = @account_name
end

if @new_symbol != NULL
begin
	if @new_name != NULL
	begin
		select
			@account_name = @new_name
	end
	
	begin tran
		update 
			external_accounts 
		set
			symbol = @new_symbol,
			name = @account_name
		where
			symbol = @external_account
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Problem finding account"
			rollback tran
			return
		end
		
		update
			traders
		set
			symbol = @new_symbol
		where
			symbol = @external_account
		if @@rowcount > 1
		begin
			select
				status = "Error",
				message = "More than one trader found"
			rollback tran
			return
		end
		
		update
			internal_accounts
		set	
			symbol = @new_symbol,
        		name = @new_symbol
		where
        		name = @external_account
		if @@rowcount > 1
		begin
			select
				status = "Error",
				message = "More than one internal account found"
			rollback tran
			return
		end
		
		update
			runs
		set
			name = @new_symbol
		where
			name = @external_account
		if @@rowcount > 1
		begin
			select
				status = "Error",
				message = "More than one run found with name"
			rollback tran
			return
		end
		
		update
			portfolios
		set
			name = @new_symbol
		where
			name = @external_account
		if @@rowcount > 1
		begin
			select
				status = "Error",
				message = "More than one portfolio found with name"
			rollback tran
			return
		end
	commit tran

	select
		msg = "Successfully edited " + @external_account + " to " + @new_symbol
end



