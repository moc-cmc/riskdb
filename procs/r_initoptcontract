use
	risk_pinepoint
go

if object_id("r_initoptcontract") != NULL
    drop procedure
        r_initoptcontract
go

create procedure
	r_initoptcontract
		@contract_id int
as

declare @contract_tv_id int
declare @product_type varchar(50)
declare @vol float
declare @product_id int
declare @trade_date datetime
declare @trade_price float

select
	@contract_tv_id = min(contract_tv_id)
from
	contract_tvs
where
	contract_id = @contract_id
if @contract_tv_id = NULL
begin
	select
		@trade_date = min(trade_date)
	from
		trades
	where
		contract_id = @contract_id
	if @trade_date = NULL
		select
			@trade_date = getdate()

	select
		@trade_price = avg(price)
	from
		trades
	where
		contract_id = @contract_id
	and
		convert(date, trade_date) = convert(date, @trade_date)


	exec
		r_contractproduct
			@contract_id,
			@product_id output

	select
		@product_type = a.name
	from
		product_types a,
		products b
	where
		a.product_type_id = b.product_type_id
	select
		@vol = .15
	if @product_type = "Equity"
		select
			@vol = .25
	if @product_type = "Currency"
		select
			@vol = .15
	if @product_type = "Commodity"
		select
			@vol = .30
	if @product_type = "Interest Rate"
		select
			@vol = .10

	select
		@trade_date = convert(datetime, convert(date, @trade_date))
	exec
		r_prevbusinessday
			@trade_date,
			@trade_date output

	exec
		j_nextkey
			"contract_tvs",
			@contract_tv_id output

	insert into
		contract_tvs(
			contract_tv_id,
			contract_id,
			tv,
			volatility,
			tv_date)
	values(
		@contract_tv_id,
		@contract_id,
		@trade_price,
		@vol,
		@trade_date)
end
					
update
	current_contract_tvs
set
	timestamp = getdate()
where
	contract_id = @contract_id
if @@rowcount = 0
begin
	insert into
		current_contract_tvs
	values(
		@contract_id,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		NULL,
		getdate())

	update
		contract_eval_methods
	set
		eval_method_id = 2
	where
		contract_id = @contract_id
	if @@rowcount = 0
		insert into
			contract_eval_methods
		values(
			@contract_id,
			2)
end

go
