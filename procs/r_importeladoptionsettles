use
	risk_elad2
go

drop procedure
	r_importeladoptionsettles
go

create procedure
	r_importeladoptionsettles
		@login varchar(50),
		@username varchar(50)=NULL,
		@deal_type varchar(50)=NULL,
		@expiry_date varchar(50)=NULL,
		@call_put varchar(50)=NULL,
		@buy_ccy varchar(50)=NULL,
		@buy_amount varchar(50)=NULL,
		@sell_ccy varchar(50)=NULL,
		@sell_amount varchar(50)=NULL,
		@strike varchar(50)=NULL,
		@prem_ccy varchar(50)=NULL,
		@premium varchar(50)=NULL,
		@market_value_prem_ccy varchar(50)=NULL,
		@market_value_usd varchar(50)=NULL,
		@p_l varchar(50)=NULL,
		@deal_no varchar(50)=NULL,
		@delivery_date varchar(50)=NULL,
		@trade_date varchar(50)=NULL,
		@enter_date varchar(50)=NULL,
		@bank varchar(50)=NULL,
		@lock_no varchar(50)=NULL,
		@delta_amount_major varchar(50)=NULL,
		@delta_amount_minor varchar(50)=NULL,
		@major_ccy varchar(50)=NULL
as


declare @deal_id int
declare @contract_id int
declare @trade_id int
declare @quantity numeric(30,4)
declare @quantity_string varchar(30)
declare @underlying varchar(50)
declare @timezone varchar(50)
declare @expiration datetime
declare @float_strike float
declare @option_settledate datetime
declare @symbol varchar(50)
declare @price float
declare @traded_date datetime
declare @prem numeric(30,2)
declare @premium_string varchar(50)
declare @buy_amount_string varchar(50)
declare @sell_amount_string varchar(50)
declare @premium_float float
declare @buy_amount_float float
declare @sell_amount_float float
declare @external_account varchar(50)
declare @source_id int
declare @product varchar(3)
declare @currency varchar(3)
declare @is_inverted char(1)
declare @standard_contract_id int
declare @conversion_price float
declare @conversion_contract_id int
declare @currency_prem_value float
declare @price_date datetime
declare @settle_price float


if @username = "Username" or @username = NULL or @username = ""
	return


exec
	u_stripcommas
		@buy_amount,
		@buy_amount_string output
exec
	u_stripcommas
		@sell_amount,
		@sell_amount_string output

exec
	u_stripcommas
		@premium,
		@premium_string output
select
	@source_id = source_id
from
	sources
where
	name = "Elad"
if @source_id = NULL
begin
	select
		status = "Error",
		message = "Elad source not found"
	return
end

select
	@external_account = b.symbol
from
	external_account_symbols a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.source_id = @source_id
and
	a.symbol = @username
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Account not found",
		account = @username
	return
end

if @major_ccy = @buy_ccy
begin
	select
		@underlying = rtrim(@buy_ccy) + rtrim(@sell_ccy),
		@product = @buy_ccy,
		@currency = @sell_ccy,
		@quantity = convert(numeric(30,4), @buy_amount_string)
end
else if @major_ccy = @sell_ccy
begin
	select
		@underlying = rtrim(@sell_ccy) + rtrim(@buy_ccy),
                @product = @sell_ccy,
                @currency = @buy_ccy,
		@quantity = convert(numeric(30,4), @sell_amount_string)
end
else
begin
	select
		"Error" = "Error",
		"msg" = "could not determine buy/sell from major ccy"
end


if lower(convert(char(1), @deal_type)) = "s" 
	select @quantity = @quantity * -1.0

select
	major_ccy = @major_ccy,
	buy_ccy = @buy_ccy,
	sell_ccy = @sell_ccy,
	underyling = @underlying /* MARKR */



select
	@timezone = "New York 10:00",
	@expiration = convert(datetime, @expiry_date),
	@float_strike = convert(numeric(30,4), @strike),
	@option_settledate = convert(datetime, @delivery_date),
	@traded_date = convert(datetime, @trade_date)

exec
	r_spotoptioncontract
		@underlying,
		@timezone,
		@expiration,
		@call_put,
		@float_strike,
		@option_settledate,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id
if @symbol = NULL
begin
	select
		status = "Error",
		message = "Contract not found"
	return
end


select
	@premium_float = convert(numeric(30,4), @premium_string)

select
	@price_date = convert(varchar(8), convert(date, getdate()), 112) +" 17:00"

exec
	r_prevbusinessday
		@price_date,
		@price_date output

if @currency = "USD"
begin
	select
		@conversion_price = 1
end
else
begin
	select
		@conversion_contract_id = contract_id,
		@standard_contract_id = contract_id
	from
		contracts
	where
		symbol = "USD"+rtrim(@currency)
	
	select
		@is_inverted = "Y"
	from
		contract_price_styles a,
		price_styles b
	where
		a.price_style_id = b.price_style_id
	and
		b.name = "Inverted"
	and
		a.contract_id = @conversion_contract_id
	
	if @is_inverted = "Y"
	begin
		select 
			@standard_contract_id = contract_id
		from
			contracts
		where
			symbol = rtrim(@currency)+"USD"
	end

	select
		@conversion_price = price
	from
		prices
	where
		price_date = @price_date
	and
		contract_id = @standard_contract_id
	
	if @is_inverted = "Y"
		select
			@conversion_price = 1/@conversion_price
end
	
if @conversion_price = NULL
begin
	select
		"Error"="error",
		"msg"="Could not determine conversion price",
		conversion_contract_id = @conversion_contract_id,
		standard_contract_id = @standard_contract_id,
		is_inverted = @is_inverted,
		price_date = @price_date,
		conversion_price = @conversion_price
	return
end

select
	@currency_prem_value = @premium_float * @conversion_price

select
	@settle_price = abs(@currency_prem_value) / abs(@quantity)

select
	"msg"="attempting to add settle",
         symbol = @symbol,
         price_date = @price_date,
         price = @settle_price

	
exec 
	r_editsettle
		@symbol = @symbol,
		@price_date = @price_date,
		@price = @settle_price
		
		

go
