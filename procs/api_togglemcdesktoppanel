drop procedure
	api_togglemcdesktoppanel
go

create procedure
	api_togglemcdesktoppanel
		@login varchar(50),
		@mc_desktop varchar(100),
		@panel varchar(100)
as

declare @mc_desktop_id int
declare @mc_panel_id int
declare @mc_desktop_panel_id int


select
	@mc_desktop_id = mc_desktop_id
from
	mc_desktops
where
	name = @mc_desktop
if @mc_desktop_id = NULL
begin
	select
		status = "Error",
		message = "MC Desktop not found",
		mc_desktop = @mc_desktop
	return
end

select
	@mc_panel_id = mc_panel_id
from
	mc_panels
where
	name = @panel
if @mc_panel_id = NULL
begin
	select
		status = "Error",
		message = "MC Panel not found",
		mc_panel = @panel
	return
end

delete

from
	mc_desktop_panels
where
	mc_panel_id = @mc_panel_id
and
	mc_desktop_id = @mc_desktop_id
if @@rowcount = 0
begin
	exec
		j_nextkey
			"mc_desktop_panels",
			@mc_desktop_panel_id output

	insert into
		mc_desktop_panels(
			mc_desktop_panel_id,
			mc_desktop_id,
			mc_panel_id)
	values(
		@mc_desktop_panel_id,
		@mc_desktop_id,
		@mc_panel_id)
end

go


