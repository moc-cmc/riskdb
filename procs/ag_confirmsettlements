create table
	#fund_external_accounts(
		fund_id int,
		external_account_id int,
		settlement_method varchar(50) NULL)
insert into
	#fund_external_accounts(
		fund_id,
		external_account_id,
		settlement_method)
select
	a.fund_id,
	a.external_account_id,
	d.name
from
	fund_external_accounts a,
	external_accounts b,
	external_account_types c,
	settlement_methods d
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	b.settlement_method_id = d.settlement_method_id
and
	d.name = "Delivery"
and
	a.fund_id = @fund_id
and
	b.external_account_id != @fund_external_account_id

