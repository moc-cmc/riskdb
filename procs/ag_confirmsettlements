		wire_account varchar(50) NULL,
		settlement varchar(15) NULL,
		broker_id int NULL,
		broker varchar(50) NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(50) NULL,
		contract_id int NULL,
		product_id int NULL,
		product varchar(50) NULL,
		currency_id int NULL,
		currency varchar(50) NULL,
		product_qty float NULL,
		currency_qty float NULL,
		value_date datetime NULL,
		price float NULL,
		prime_broker_id int NULL,
		prime_broker varchar(50) NULL)

insert into
	#trades(
		trade_id,
		trade_date,
		broker_id,
		external_account_id,
		contract_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		value_date,
		price)
select
	a.trade_id,
	a.trade_date,
	a.broker_id,
	a.external_account_id,
	a.contract_id,
	c.product_id,
	a.quantity,
	c.currency_id,
	a.quantity * a.price * -1.0,
	a.value_date,
	a.price
from
	trades a,
	#fund_external_accounts b,
	forwards c
where
	a.contract_id = c.contract_id
and
	a.external_account_id = b.external_account_id
and
	b.fund_id = @fund_id
and
	convert(date, a.value_date) = convert(date, @value_date)

/*
| Set trading day to EST 17:00-17:00 market standard
*/
update
	#trades
set
	bo_trade_date = case
		when a.trade_date > convert(char(8), a.trade_date, 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 112))
		else
			convert(char(12), a.trade_date, 112)
	end
from
	#trades a

update
	#trades
set
	a.product = b.symbol,
	a.currency = c.symbol
from
	#trades a,
	products b,
	products c
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id

update
	#trades
set
	a.external_account = b.symbol,
	a.external_account_type_id = b.external_account_type_id
from
