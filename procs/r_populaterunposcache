
if object_id("r_populaterunposcache") != NULL
    drop procedure
        r_populaterunposcache
go
create procedure
	r_populaterunposcache
		@login varchar(50),
		@run_id int,
		@as_of_date datetime
as

declare @total int
declare @resid_status_id int
declare @day varchar(4)
declare @month varchar(4)
declare @year varchar(4)
declare @datestring char(20)
declare @today datetime
declare @now datetime
declare @pl_view_style varchar(50)
declare @sorting varchar(30)



select
	@pl_view_style = a.name,
	@sorting = d.name
from
	pl_view_styles a,
	fwd_pl_preferences b,
	tico_accounts c,
	sorting_styles d
where
	a.pl_view_style_id = b.pl_view_style_id
and
	b.ti_account_id = c.account_id
and
	b.sorting_style_id = d.sorting_style_id
and
	c.login = @login
if @@rowcount = 0
	select
		@pl_view_style = "Default",
		@sorting = "By Contract"

delete

from
	run_pos_cache
where
	run_id = @run_id
and
	date = @as_of_date


select
	@resid_status_id = status_id
from
	statuses
where
	name = "Resid"
	
create table
	#contracts(
		contract_id int,
		value_date datetime)

insert into
	#contracts
select
	contract_id,
	expiration
from
	future_contracts
where
	expiration > @as_of_date


insert into
	#contracts
select
	a.contract_id,
	b.expiration
from
	option_contracts a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.expiration > @as_of_date

insert into
	#contracts
select
	a.contract_id,
	b.expiration
from
	exotic_contracts a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id
and
	b.expiration > @as_of_date
select
	@now = getdate()
select
	@day = convert(varchar(4), datepart(day, @now)),
	@month = convert(varchar(4), datepart(month, @now)),
	@year = convert(varchar(4), datepart(year, @now))

select
	@datestring = rtrim(@month) + "/" + rtrim(@day) + "/" + rtrim(@year)

	select
		@today = convert(datetime, @datestring)

insert into
	#contracts
select
	contract_id,
	@today
from
	forwards


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts

create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)
insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties


create table
	#positions(
		contract_id int,
		value_date datetime,
		quantity numeric(30,4),
		last_trade datetime,)
	
if @pl_view_style != "Agency"
begin
	insert into
		#positions
	select
		a.contract_id,
		a.value_date,
		sum(convert(numeric(30,4),a.quantity)),
		max(a.trade_date)
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
		#counterparties g
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.counterparty_id = g.counterparty_id
	and
		a.status_id != @resid_status_id
	and
		a.trade_date <= @as_of_date
	and
		a.value_date >= @as_of_date
	group by
		a.contract_id,
		a.value_date
end
else
begin
	create table
		#trades(
			trade_id int)
	insert into
		#trades
	select
		a.trade_id
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
		#counterparties g
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.counterparty_id = g.counterparty_id
	and
		a.status_id != @resid_status_id
	and
		a.trade_date <= @as_of_date
	and
		a.value_date >= @as_of_date

	create table
		#unique_deals(
			deal_id int)

	insert into
		#unique_deals
	select
		distinct(a.deal_id)
	from
		trades a,
		#trades b
	where
		a.trade_id = b.trade_id


	insert into
		#positions
	select
		a.contract_id,
		a.value_date,
		sum(convert(numeric(30,4),a.quantity)),
		max(a.trade_date)
	from
		trades a,
		#unique_deals b
	where
		a.deal_id = b.deal_id
	and
		a.status_id != @resid_status_id
	and
		a.trade_date <= @as_of_date
	and
		a.value_date >= @as_of_date
	group by
		a.contract_id,
		a.value_date
end
	

insert into
	run_pos_cache
select
	run_id = @run_id,
	date = @as_of_date,
	contract_id,
	value_date,
	quantity
from
	#positions
where
	quantity != 0


 
go
