
if object_id("cl_addaccounttransaction") != NULL
    drop procedure
        cl_addaccounttransaction
go
 
create procedure
	cl_addaccounttransaction
		@login char(25),
		@external_account char(25),
		@category char(100),
		@date datetime,
		@amount float,
		@product varchar(50)=NULL,
		@note char(255)=NULL
as

exec
	s_addaccounttransaction
		@login,
		@external_account,
		@category,
		@date,
		@amount,
		@product,
		@note

go
