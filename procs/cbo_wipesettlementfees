
drop procedure
	cbo_wipesettlementfees
go

create procedure
	cbo_wipesettlementfees
		@login varchar(50),
		@trade_date datetime

as

declare @fee_schedules int
declare @fee_schedule_id int
declare @fee_schedule varchar(200)


select
	@fee_schedule_id = 0
select
	@fee_schedules = count(a.fee_schedule_id)
from
	fee_schedules a,
	fee_schedule_types b
where
	a.fee_schedule_type_id = b.fee_schedule_type_id 
and
	b.name = "Settlement Volume"
and
	a.fee_schedule_id > @fee_schedule_id

while @fee_schedules > 0
begin
	select
		@fee_schedule_id = min(a.fee_schedule_id)
	from
		fee_schedules a,
		fee_schedule_types b
	where
		a.fee_schedule_type_id = b.fee_schedule_type_id 
	and
		b.name = "Settlement Volume"
	and
		a.fee_schedule_id > @fee_schedule_id

	select
		@fee_schedule = NULL

	select
		@fee_schedule = name
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id

	begin tran
		delete
			account_transactions
		from
			account_transactions a,
			scheduled_fee_transactions b,
			scheduled_fees c
		where
			a.account_transaction_id = b.account_transaction_id
		and
			b.scheduled_fee_id = c.scheduled_fee_id
		and
			c.fee_schedule_id = @fee_schedule_id
		and
			convert(date, c.trade_date) = convert(date, @trade_date)
		if @@rowcount != 2
		begin
			select
				status = "Error",
				msg = "Unable to wipe account transaction fees for schedule",
				fee_schedule = @fee_schedule,
				trade_date = @trade_date
			rollback tran
			return
		end


		delete
			scheduled_fee_transactions
		from
			scheduled_fee_transactions a,
			scheduled_fees b
		where
			a.scheduled_fee_id = b.scheduled_fee_id
		and
			b.fee_schedule_id = @fee_schedule_id
		and
			convert(date, b.trade_date) = convert(date, @trade_date)
		if @@rowcount != 2
		begin
			select
				status = "Error",
				msg = "Unable to wipe scheduled fee transactions fees for schedule",
				fee_schedule = @fee_schedule,
				trade_date = @trade_date
			rollback tran
			return
		end

		delete
	
		from
			scheduled_fees
		where
			fee_schedule_id = @fee_schedule_id
		and
			convert(date, trade_date) = convert(date, @trade_date)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				msg = "Unable to wipe scheduled fees for schedule",
				fee_schedule = @fee_schedule,
				trade_date = @trade_date
			rollback tran
			return
		end

	commit tran
		
		

	select
		@fee_schedules = count(a.fee_schedule_id)
	from
		fee_schedules a,
		fee_schedule_types b
	where
		a.fee_schedule_type_id = b.fee_schedule_type_id 
	and
		b.name = "Settlement Volume"
	and
		a.fee_schedule_id > @fee_schedule_id
end

go
