
if object_id("r_volasof") != NULL
    drop procedure
        r_volasof
go
 
create procedure
	r_volasof
		@contract_id int,
		@as_of_date datetime,
		@vol float output
as


select
	@vol = vol
from
	vols
where
	contract_id = @contract_id
and
	vol_date = (
		select
			max(vol_date)
		from
			vols
		where
			contract_id = @contract_id)

go
