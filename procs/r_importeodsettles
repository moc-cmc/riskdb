create or replace procedure
	r_importeodsettles
		@login varchar(50),
		@price_date varchar(50)=NULL,
		@symbol varchar(50)=NULL,
		@price varchar(50)=NULL

as

declare @book_price_date datetime
declare @book_price float
declare @ccy1 varchar(10)
declare @ccy2 varchar(10)
declare @inverted char(1)
declare @contract varchar(25)
declare @contract_id int
declare @standard_contract varchar(30)




exec
	r_validateccypair
		@login=@login,
		@symbol=@symbol,
		@ccy1=@ccy1,
		@ccy2=@ccy2,
		@contract_id = @contract_id output,
		@contract = @contract output,
		@inverted = @inverted output


select
	@book_price = convert(float, @price),
	@book_price_date = convert(datetime, @price_date)

if @inverted != "Y"	
begin
        exec
                r_editsettle
                        @contract,
                        @book_price_date,
                        @book_price
end
else
begin
	select
		status = "warning",
		message = "Not saving price for non-standard pair",
		symbol = @symbol,
		contract = @contract,
		ccy1 = @ccy1,
		ccy2 = @ccy2,
		price_date = @book_price_date,
		book_price = @book_price

	return
end

go
