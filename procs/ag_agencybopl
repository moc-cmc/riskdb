		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id


if @begin_date = NULL
begin
	if @end_date = NULL
	begin
		select
			@begin_date = convert(datetime, convert(date, getdate()))
		select
			@end_date = @begin_date
	end
	else
		select
			@begin_date = @end_date
end

if @end_date = NULL
begin
	select
		@end_date = @begin_date
end

select
	product_id,
	rate
into
	#conversion_rates
from
	x_conversion_rates 
where
	_login = @login
and
	_as_of_date = @end_date
and
	_product = @evaluation_currency

create table
	#cpty_accounts(
		external_account_id int)
insert into
	#cpty_accounts(
		external_account_id)
select
	a.external_account_id
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Counterparty"

create table
	#client_accounts(
		external_account_id int)
insert into
	#client_accounts(
		external_account_id)
select
	a.external_account_id
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
and
	b.name = "Client"

create table
	#netted_base(
		external_account_id int NULL,
		transaction_type_id int NULL,
		contract_id int NULL,
		trader_id int NULL,
		broker_id int NULL,
		counterparty_id int NULL,
		product_id int NULL,
		amount float NULL,
		equiv float NULL)
insert into
	#netted_base(
		external_account_id,
		transaction_type_id,
		contract_id,
		trader_id,
		broker_id,
		counterparty_id,
		product_id,
		amount)
select
	a.external_account_id,
	a.transaction_type_id,
	f.contract_id,
	f.trader_id,
	f.broker_id,
	f.counterparty_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	scheduled_fee_transactions b,
	scheduled_fees c,
	fee_schedules d,
	fee_schedule_types e,
	trades f,
	#client_accounts g
where
	a.external_account_id = g.external_account_id
and
	a.account_transaction_id = b.account_transaction_id
and
	b.scheduled_fee_id = c.scheduled_fee_id
and
	c.fee_schedule_id = d.fee_schedule_id
and
	d.fee_schedule_type_id = e.fee_schedule_type_id
and
	b.trade_id = f.trade_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date
and
	e.name = "Agency Pips"
group by
	a.external_account_id,
	a.transaction_type_id,
	f.contract_id,
	f.trader_id,
	f.broker_id,
	f.counterparty_id,
	a.currency_id

update
	#netted_base
set
	a.equiv = a.amount * b.rate
from
	#netted_base a,
	#conversion_rates b
where
	a.product_id = b.product_id

/****************************** LP Side **************************/

create table
	#netted_lp(
		external_account_id int NULL,
		transaction_type_id int NULL,
		contract_id int NULL,
		trader_id int NULL,
		broker_id int NULL,
		counterparty_id int NULL,
		product_id int NULL,
		amount float NULL,
		equiv float NULL)
insert into
	#netted_lp(
		external_account_id,
		transaction_type_id,
		contract_id,
		trader_id,
		broker_id,
		counterparty_id,
		product_id,
		amount)
select
	a.external_account_id,
	a.transaction_type_id,
	f.contract_id,
	f.trader_id,
	f.broker_id,
	f.counterparty_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	scheduled_fee_transactions b,
	scheduled_fees c,
	fee_schedules d,
	fee_schedule_types e,
	trades f,
	#cpty_accounts g
where
	a.external_account_id = g.external_account_id
and
	a.account_transaction_id = b.account_transaction_id
and
	b.scheduled_fee_id = c.scheduled_fee_id
and
	c.fee_schedule_id = d.fee_schedule_id
and
	d.fee_schedule_type_id = e.fee_schedule_type_id
and
	b.trade_id = f.trade_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date
and
	e.name = "Agency Pips"
group by
	a.external_account_id,
	a.transaction_type_id,
	f.contract_id,
	f.trader_id,
	f.broker_id,
	f.counterparty_id,
	a.currency_id

update
	#netted_lp
set
	a.equiv = a.amount * b.rate
from
	#netted_lp a,
	#conversion_rates b
where
	a.product_id = b.product_id

