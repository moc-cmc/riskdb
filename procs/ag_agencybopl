select
	@trading_pl = NULL,
	@fees = NULL,
	@net = NULL
select
	@trading_pl = sum(trading_pl),
	@fees = sum(fees),
	@net = sum(equiv),
	@trade_count = sum(trade_count),
	@volume = sum(volume)
from
	#contracts

insert into
	#contracts(
		style,
		trading_pl,
		fees,
		equiv,
		trade_count,
		volume)
values(
	@subtotal_style,
	@trading_pl,
	@fees,
	@net,
	@trade_count,
	@volume)

update
	#contracts
set
	avg_size = (volume * 1000000.0)  / trade_count,
	gross_per_mio = trading_pl / volume,
