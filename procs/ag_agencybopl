create table
	#fee_sum(
		id int identity,
		style varchar(250) NULL,
		transaction_type varchar(100) NULL,
		equiv float NULL)
insert into
	#fee_sum(
		transaction_type,
		equiv)
select
	transaction_type = b.name,
	sum(a.equiv)
from
	#netted_base a,
	transaction_types b
where
	a.transaction_type_id = b.transaction_type_id
group by
	b.name
order by
	b.name

update
	#fee_sum
set
	style = @style

select
	@net = sum(equiv)
from
	#fee_sum

insert into
	#fee_sum(
		style,
		equiv)
values(
	@subtotal_style,
	@net)

create table
	#accounts(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		account_type varchar(50) NULL,
		volume float NULL,
		trade_count float NULL,
		avg_size float NULL,
		trading_pl float NULL,
		gross_per_mio float NULL,
		fees float NULL,
		fees_per_mio float NULL,
		equiv float NULL,
		net_per_mio float NULL)
insert into
	#accounts(
		account,
		equiv)
select
	acct = b.symbol,
	sum(a.equiv)
from
	#netted_base a,
	external_accounts b
where
	a.external_account_id = b.external_account_id
group by
	b.symbol
order by
	b.symbol


update
	#accounts
set
	style = @style,
	trade_count = 0.0,
	volume = 0.0

update
	#accounts
set
	a.external_account_id = b.external_account_id
from
	#accounts a,
	external_accounts b
where
	a.account = b.symbol

update
	#accounts
set
	a.account_type = c.name
from
	#accounts a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
	

create table
	#account_volumes(
		external_account_id int,
		trade_count int NULL,
		volume float NULL)
insert into
	#account_volumes(
		external_account_id,
		trade_count,
		volume)
select
	external_account_id,
	sum(trade_count),
	sum(volume)
from
	account_volumes
where
	product_id = @evaluation_currency_id
and
	volume_date >= @begin_date
and
	volume_date <= @end_date
group by
	external_account_id

update
	#account_volumes
set
	volume = volume / 1000000.0
update
	#accounts 
set
	a.volume = b.volume,
	a.trade_count = b.trade_count
from
	#accounts a,
	#account_volumes b
where
	a.external_account_id = b.external_account_id
	
select
	@id = 0
select
	@ids = count(*)
from
	#accounts
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#accounts
	where
		id > @id

	select
		@trading_pl = NULL,
		@fees = NULL,
		@external_account_id = NULL

	select
		@external_account_id = external_account_id
	from
		#accounts
	where
		id = @id

	select
		@trading_pl = sum(a.equiv)
	from
		#netted_base a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.external_account_id = @external_account_id
	and
		b.name = "Pip Spread PL"
	if @trading_pl = NULL
		select
			@trading_pl = 0.0

	select
		@fees = sum(a.equiv)
	from
		#netted_base a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.external_account_id = @external_account_id
	and
		b.name != "Pip Spread PL"
	if @fees = NULL
		select
			@fees = 0.0


	update
		#accounts
	set
		trading_pl = @trading_pl,
		fees = @fees
	where
		id = @id

	select
		@ids = count(*)
	from
		#accounts
	where
		id > @id
end

select
	@trading_pl = NULL,
	@fees = NULL,
	@net = NULL
select
	@trading_pl = sum(trading_pl),
	@fees = sum(fees),
	@net = sum(equiv),
	@trade_count = sum(trade_count),
	@volume = sum(volume)
from
	#accounts

insert into
	#accounts(
		style,
		trading_pl,
		fees,
		equiv,
		trade_count,
		volume)
values(
	@subtotal_style,
	@trading_pl,
	@fees,
	@net,
	@trade_count,
	@volume)

update
	#accounts
set
	avg_size = (volume * 1000000.0)  / trade_count,
	gross_per_mio = trading_pl / volume,
	net_per_mio = equiv / volume,
	fees_per_mio = fees / volume
where
	trade_count != 0
and
	volume != 0.0

