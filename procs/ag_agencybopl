	select
		@fees = sum(a.equiv)
	from
		#netted_base a,
		transaction_types b
	where
		a.transaction_type_id = b.transaction_type_id
	and
		a.contract_id = @contract_id
	and
		b.name != "Pip Spread PL"
	if @fees = NULL
		select
