
if object_id("ctm_futures") != NULL
    drop procedure
        ctm_futures
go

create procedure
	ctm_futures
		@login varchar(30)
as

declare @db_name varchar(30)
declare @servername varchar(30)
declare @evaluation_currency varchar(30)
declare @fund_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency = a.symbol
from
	products a,
	funds b
where
	a.product_id = b.evaluation_currency_id
and
	b.fund_id = @fund_id

if @evaluation_currency = NULL
begin
	select
		status = "Error",
		message = "Evalution currency not found for login"
	return
end


select
	@db_name = db_name(),
	@servername = @@servername


exec
	CONTRACTS.contracts.dbo.ct_futures
		@login,
		@db_name,
		@servername,
		@evaluation_currency
		

go
