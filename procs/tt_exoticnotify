		@exotic_trade_id = trade_id
		/* @exotic_trade_id = @trade_id */
	from
		#exotic_attributes
	where
		id = @id

	if @value = ""
        begin
                select
                        @ids = count(*)
                from
                        #exotic_attributes
                where
                        id > @id
                continue
        end

	select
		@sql4 = convert(varchar(20), @exotic_trade_id)

	if @datatype = "string"
	begin
		select
			@sql2 = @column_name + " = '" + @value + "' "
	end

	if @datatype = "number"
	begin
		select
			@sql2 = @column_name + " = " + @value
	end

	if @datatype = "date"
	begin
		select
			@sql2 = @column_name + " = '" + @value + "' "
	end

	select
		@sql = rtrim(@sql1) + " " + rtrim(@sql2) + " " + rtrim(@sql3) + " " + rtrim(@sql4)



	exec(@sql)

	select
		@ids = count(*)
	from
		#exotic_attributes
	where
		id > @id
end



