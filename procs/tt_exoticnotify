		@id = min(id)
	from
		#exotic_attributes
	where
		id > @id

	select
		@sql = NULL,
		@sql2 = NULL,
		@sql4 = NULL,
		@column_name = NULL,
		@value = NULL,
		@datatype = NULL,
		@exotic_trade_id = NULL

