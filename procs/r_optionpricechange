
if object_id("r_optionpricechange") != NULL
    drop procedure
        r_optionpricechange
go
 
create procedure
	r_optionpricechange
		@contract_id int,
		@trade_date datetime,
		@price_change float output
as

declare @open_price float
declare @begin_value float
declare @close_price float
declare @end_value float
declare @p_l float
declare @begin_date datetime
declare @end_date datetime

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

exec
	r_optionposplfordate
		@contract_id,
		1,
		@begin_date,
		@end_date,
		@open_price output,
		@begin_value output,
		@close_price output,
		@end_value output,
		@p_l output


if @close_price != NULL
begin
	update
		current_prices
	set
		price = @close_price
	where
		contract_id = @contract_id
	if @@rowcount != 1
	begin
		insert into
			current_prices
		values(
			@contract_id,
			@close_price,
			getdate())
	end
end

select
	@price_change = @close_price - @open_price
go
