create or replace procedure
	uat_hsbctestkit
		@login varchar(50)


as 

declare @trade_date datetime
declare @trade_day datetime
declare @spot_value datetime
declare @1m_value datetime
declare @1m_settle datetime
declare @1m_expiry datetime
declare @3m_value datetime
declare @3m_settle datetime
declare @3m_expiry datetime
declare @3m_fixing datetime
declare @4m_settle datetime
declare @4m_expiry datetime
declare @4m_fixing datetime
declare @spot_premdate datetime
declare @2wk_window_end datetime


/* Anchor the trade date. */
select
	@trade_date = getdate()

select
	@trade_day = dbo.f_botradedate(@trade_date)

exec
	r_nextbusinessday
		@trade_day,
		@spot_value output

exec
	r_nextbusinessday
		@spot_value,
		@spot_value output

select
	@spot_premdate = @spot_value

/* Build forward value date tenors off of spot.  Window end will be the expiry of the trade being booked unless 2wk. */
select
	@1m_value = dateadd(day, 30,  @spot_value),
	@1m_expiry = dateadd(day, 30,  @spot_value),
	@1m_settle = dateadd(day, 30, @spot_value),
	@3m_value = dateadd(day, 90,  @spot_value),
	@3m_expiry = dateadd(day, 90,  @spot_value),
	@3m_settle = dateadd(day, 90, @spot_value),
	@4m_expiry = dateadd(day, 120,  @spot_value),
	@4m_settle = dateadd(day, 120, @spot_value),
	@2wk_window_end = dateadd(day, 14, @trade_day)


/* Adjust for any weekends to dial in tenors by moving forward to next biz day. */
if dbo.f_isbusinessday(@1m_value) = 1
	exec
		r_nextbusinessday
			@1m_value,
			@1m_value output

if dbo.f_isbusinessday(@1m_expiry) = 1
	exec
		r_nextbusinessday
			@1m_expiry,
			@1m_expiry output

if dbo.f_isbusinessday(@1m_settle) = 1
	exec
		r_nextbusinessday
			@1m_settle,
			@1m_settle output

if dbo.f_isbusinessday(@3m_value) = 1
	exec
		r_nextbusinessday
			@3m_value,
			@3m_value output

if dbo.f_isbusinessday(@3m_expiry) = 1
	exec
		r_nextbusinessday
			@3m_expiry,
			@3m_expiry output

if dbo.f_isbusinessday(@3m_settle) = 1
	exec
		r_nextbusinessday
			@3m_settle,
			@3m_settle output

if dbo.f_isbusinessday(@4m_expiry) = 1
	exec
		r_nextbusinessday
			@4m_expiry,
			@4m_expiry output

if dbo.f_isbusinessday(@4m_settle) = 1
	exec
		r_nextbusinessday
			@4m_settle,
			@4m_settle output

if dbo.f_isbusinessday(@2wk_window_end) = 1
	exec
		r_nextbusinessday
			@2wk_window_end,
			@2wk_window_end output


/* Set Option Settle Dates (+2 Expiration). */
exec
	r_nextbusinessday
		@1m_expiry,
		@1m_settle output

exec
	r_nextbusinessday
		@1m_settle,
		@1m_settle output

exec
	r_nextbusinessday
		@3m_expiry,
		@3m_settle output

exec
	r_nextbusinessday
		@3m_settle,
		@3m_settle output

exec
	r_nextbusinessday
		@4m_expiry,
		@4m_settle output

exec
	r_nextbusinessday
		@4m_settle,
		@4m_settle output


/* Set Fixing Dates (-2 Value) */
exec
	r_prevbusinessday
		@3m_value,
		@3m_fixing output

exec
	r_prevbusinessday
		@3m_fixing,
		@3m_fixing output

exec
	r_prevbusinessday
		@4m_expiry,
		@4m_fixing output
