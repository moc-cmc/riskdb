
drop procedure
        api_tallyclientroll
go

create procedure
	api_tallyclientroll
		@login char(25),
		@account varchar(50),
		@trader varchar(50),
		@trade_date datetime,
		@near_quantity numeric(30,4),
		@far_quantity numeric(30,4),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@near_date datetime = NULL,
		@near_price float,	
		@far_date datetime = NULL,
		@far_price float,
		@deal_id int output,
		@near_fixing_date datetime = NULL,		
		@far_fixing_date datetime = NULL
as

declare @tally_type varchar(20)
declare @external_account varchar(50)
declare @symbol varchar(50)
declare @near_trade_id int
declare @far_trade_id int
declare @contract_id int
declare @swap_symbol_id int
declare @swap_symbol varchar(50)


select
	@tally_type = "Swap"


select
	@symbol = rtrim(@dealt_currency) + rtrim(@counter_currency)

select
    @contract_id = contract_id
from
    contracts
where
    symbol = @symbol
if @@rowcount != 1
begin

    declare @evaluation_currency varchar(50)
    declare @fund_id int

    exec
        r_defaultfundforlogin
                @login,
                @fund_id output

    select
        @evaluation_currency = a.symbol
    from
        products a,
        funds b
    where
        a.product_id = b.evaluation_currency_id

    exec r_addbatchfwdsubscription
            @login,
            @symbol,
            @dealt_currency,
            @counter_currency,
            @evaluation_currency

    if not exists (select contract_id from contracts where symbol=@symbol)
    begin
        select
            status = "Error",
            message = "Contract not found",
            symbol=@symbol

        return
    end

end

select
	@external_account = @account


if @trade_date = NULL
	select
		@trade_date = getdate()

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @near_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Client Swap",
		@trade_type = "Swap Near",
		@external_account = @external_account,
		@quantity = @near_quantity,
		@symbol = @symbol,
		@value_date = @near_date,
		@price = @near_price,
		@trade_date = @trade_date,
		@trader = @trader,
		@fixing_date = @near_fixing_date	


exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @far_trade_id output,
		@deal_id = @deal_id output,
		@tally_type = @tally_type,
		@deal_type = "Client Swap",
		@trade_type = "Swap Far",
		@external_account = @external_account,
		@quantity = @far_quantity,
		@symbol = @symbol,
		@value_date = @far_date,
		@price = @far_price,
		@trade_date = @trade_date,
		@trader = @trader,
		@fixing_date = @far_fixing_date	

/* Create and assign client swap symbol */
exec
	j_nextkey
		"swap_symbols",
		@swap_symbol_id output
select
	@swap_symbol = rtrim(convert(varchar(50), @deal_id)) + ".C"

insert into
	swap_symbols
(
	swap_symbol_id,
	symbol,
	timestamp
)
values
(
	@swap_symbol_id,
	@swap_symbol,
	getdate()
)

/* Tie both legs to the swap symbol */
insert into 
	swap_symbol_trades
(
	swap_symbol_id,
	trade_id
)
values
(
	@swap_symbol_id,
	@near_trade_id
)
insert into 
	swap_symbol_trades
(
	swap_symbol_id,
	trade_id
)
values
(
	@swap_symbol_id,
	@far_trade_id
)

exec 
	r_inserttradenotification 
		@near_trade_id
exec 
	r_inserttradenotification
		@far_trade_id 

go
