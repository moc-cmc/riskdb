
if object_id("cm_accountmappings") != NULL
    drop procedure
        cm_accountmappings
go

create procedure
	cm_accountmappings
		@login varchar(50),
		@external_account varchar(50)
as

create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)
insert into
	#links
values(
	"Column Link",
	"del_mapping",
	"Delete External Account Mapping",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"add_mapping",
	"Add External Account Mapping",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"edit_mapping",
	"Edit External Account Mapping",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	add_mapping = "Add Mapping",
	external_account = @external_account


select
	external_account = a.symbol,
	source = b.name,
	mapping = c.symbol,
	edit_mapping = "EDIT",
	del_mapping = "DELETE"
from
	external_accounts a,
	sources b,
	external_account_symbols c
where
	a.external_account_id = c.external_account_id
and
	b.source_id = c.source_id
and
	a.symbol = @external_account
order by
	b.name,
	a.symbol


go
