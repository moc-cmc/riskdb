drop procedure r_copyrollspreadgroup
go

create procedure
	r_copyrollspreadgroup
		@login varchar(50),
		@existing_group varchar(50),
		@new_name varchar(50)
		
as


declare @n_roll_spread_group_id int
declare @e_roll_spread_group_id int

select
	@e_roll_spread_group_id = roll_spread_group_id
from
	roll_spread_groups
where
	name = @existing_group
if @e_roll_spread_group_id = NULL
begin
	select
		status = "Error",
		msg = "Problem finding group for name",
		existing_group = @existing_group

	exec
        	r_managerollspreadgroups
                	@login

	return
end

exec
	j_nextkey 
		"roll_spread_groups",
		@n_roll_spread_group_id output

insert into
	roll_spread_groups (
		roll_spread_group_id,
		name
	)
values(
	@n_roll_spread_group_id,
	@new_name
)

insert into
	contract_roll_spreads(
		roll_spread_group_id,
		contract_id,
		spread
	)
select
	@n_roll_spread_group_id,
	contract_id,
	spread
from
	contract_roll_spreads
where
	roll_spread_group_id = @e_roll_spread_group_id
	
	
exec
	r_managerollspreadgroups
		@login,
		@new_name

go
