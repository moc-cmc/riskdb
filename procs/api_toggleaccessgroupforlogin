create or replace procedure
	api_toggleaccessgroupforlogin
		@login varchar(100),
		@user_name varchar(100),
		@access_group varchar(100),
		@toggle_action varchar(25)=NULL output

as

declare @access_group_id int
declare @has_access char(1)
declare @tico_account_id int

select
   @tico_account_id = account_id
from
   tico_accounts
where
   login = @login
if @tico_account_id = NULL
begin
   select
           status="Error",
           message="Problem finding account for login"
   return
end


select
	@has_access = "Y"
from
	tico_accounts a,
	access_group_accounts b,
	access_groups c
where
	a.account_id = b.tico_account_id
and
	b.access_group_id = c.access_group_id
and
	a.login = @user_name
and
	c.name = @access_group
	


if @has_access = "Y"
begin
	exec
		api_rmaccessgroupforlogin
			@login = @login,
			@login_name = @user_name,
			@access_group = @access_group
	select
		@toggle_action = "Removed"
end
else
begin
        exec
                api_addaccessgroupforlogin
                        @login = @login,
                        @login_name = @user_name,
                        @access_group = @access_group
	select
		@toggle_action = "Added"
end

go
