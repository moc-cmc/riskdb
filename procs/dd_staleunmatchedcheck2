create or replace procedure
    dd_staleunmatchedcheck2
as

declare @start_time datetime
declare @now datetime

select
    @start_time = getdate(),
    @now = getdate()

declare @end_time datetime
declare @begin_date datetime
declare @end_date datetime
declare @tags varchar(100)
declare @threshold_seconds int
declare @unmatched_trades varchar(10)
declare @unmatched_deals varchar(10)
declare @matched_status_id int
declare @unmatched_status_id int

exec
    r_daterangefordate
        @now,
        @begin_date output,
        @end_date output

select
    @matched_status_id = match_status_id
from
    match_statuses
where
    name = "Matched"

if @@rowcount != 1
begin
    select
        status="error",
        message="Matched status missing"

    return
end

select
    @unmatched_status_id = match_status_id
from
    match_statuses
where
    name = "Unmatched"

if @@rowcount != 1
begin
    select
        status="error",
        message="Mismatched status missing"

    return
end

select
    @threshold_seconds = 480

select
    @unmatched_deals = convert(varchar(10), count(*))
from
    trades
where
    matched_deal_id = NULL
and
    trade_date > @begin_date
and
    datediff(ss, entry_date, getdate()) > @threshold_seconds

exec
    sp_dogstatsdguage
        @metric_name = "mxhub.dl.unmatched.stale",
        @value = @unmatched_deals,
        @tags = @tags

select
    @unmatched_trades = convert(varchar(10), count(*))
from
    trade_matches a,
    trades b
where
    a.trade_id = b.trade_id
and
    b.trade_date > @begin_date
and
    b.matched_deal_id != NULL
and
    a.match_status_id = @unmatched_status_id

exec
    sp_dogstatsdguage
        @metric_name = "mxhub.tr.unmatched.stale",
        @value = @unmatched_trades,
        @tags = @tags

select
    @end_time = getdate()

exec
    sp_dogstatsdtimer
        @metric_name="ase.proc.dd_staleunmatchedcheck2",
        @start_time=@start_time,
        @end_time=@end_time,
        @tags="",
        @sample_rate="1.0"

select
    status = "OK",
    message = "Outbound matchhub unmatched check complete",
    ms = convert(varchar(20), datediff(ms, @start_time, @end_time))

go

