
if object_id("r_runopslink") != NULL
    drop procedure
        r_runopslink
go

create procedure
	r_runopslink
		@login varchar(50),
		@op_task varchar(255)
as


if @op_task = "View Option Model Parameters"
begin
	exec
		r_options
	return
end

if @op_task = "Run Expiration Tool"
begin
	exec
		r_expirytimesfordate
			@login
	return
end

if @op_task = "Edit Current Prices"
begin
	exec
		r_currentprices
			@login
	return
end

if @op_task = "Volume Runs"
begin
	exec
		cn_volreport
			@login
	return
end

if @op_task = "Edit Settle Prices"
begin
	exec
		cl_currentsettles
			@login,
			NULL
end

if @op_task = "Perspective Contracts"
begin
	exec
		r_defperspectivecontracts
			@login
end

if @op_task = "Link Unhedged Deals"
begin
	exec
		r_unhedgeddeals
			@login,
			NULL,
			NULL
end

if @op_task = "Assign Trades"
begin
	exec
		r_assigntrades
			@login,
			NULL,
			NULL
end

if @op_task = "Cross Reducer"
begin
	exec
		r_reducerlink
			@login
end
if @op_task = "Manage Client Notifications"
begin
	exec
		r_manageclientnotifications
			@login
end

if @op_task = "Batch Mark Resids"
begin
	exec
		fxa_runbatchmarkresids
			@login
end

if @op_task = "FXConnect Trades"
begin
	exec
		fxa_fxconnectbatchtrades
			@login
end

if @op_task = "Align Settles"
begin
        exec
		r_crosscheckerlink                
                        @login
end



/* AGGREGATE TRADES ONLY AVAILABLE FOR CERTAIN CLIENTS */
if db_name() in("risk_cantorny", "risk_cantorny_uat")
begin
	if @op_task = "Netted Trades For Run"
	begin
		exec
			r_runnettedtradeswrapper
				@login
	end
	
end



/* CUSTOM LINKS */
if db_name() in("risk_cantorny", "risk_cantorny_uat")
begin
	if @op_task = "Manage Value Dates"
	begin
		exec
			r_manageequityvaldatecontracts
					@login
	end
end


go
