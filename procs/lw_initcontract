use
	risk_firsel
go

drop procedure
	lw_initcontract
go

create procedure
	lw_initcontract
		@login varchar(50),
		@file_name varchar(50),
		@product varchar(50),
		@currency varchar(50)=NULL,
		@contract_id int output
as


declare @asset_class varchar(50)
declare @source_id int
declare @status_id int
declare @contracts int
declare @product_id int
declare @product_type_id int
declare @total int
declare @currency_id int
declare @fund_id int
declare @exchange_id int
declare @instrument_id int
declare @quantity int
declare @product_rate_id int

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @product
if @contract_id != NULL
	return

select
	@currency_id = product_id
from
	products
where
	symbol = @currency
if @@rowcount = 0
begin
	exec
		r_defaultfundforlogin
			@login,
			@fund_id output

	select
		@currency_id = evaluation_currency_id
	from
		funds
	where
		fund_id = @fund_id

	if @currency_id = NULL
	begin
		select
			status = "Error",
			message = "Unable to resolve currency"
		return
	end
end

select
	@quantity = 1

select
	@instrument_id = instrument_id
from
	instruments
where
	name = "Forward"
if @@rowcount !=1
begin
	select
		status = "Error",
		message = "Forward instrument not found"
	return
end

select
	@exchange_id = exchange_id
from
	exchanges
where
	name = "OTC"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"exchanges",
			@exchange_id output

	insert into
		exchanges
	values(
		@exchange_id,
		"OTC")
end

select
	@asset_class = "Consumer Debt"

select
	@product_type_id = product_type_id
from
	product_types
where
	name = @asset_class
if @@rowcount != 1
begin
	exec
		j_nextkey
			"product_types",
			@product_type_id output

	insert into
		product_types
	values(
		@product_type_id,
		@asset_class)
end

select
	@status_id = status_id
from
	statuses
where
	name = "Active"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"statuses",
			@status_id output

	insert into
		statuses
	values(
		@status_id,
		"Active")
end

select
	@source_id = source_id
from
	sources
where
	name = @file_name
if @@rowcount != 1
begin
	exec
		j_nextkey
			"sources",
			@source_id output

	insert into
		sources
	values(
		@source_id,
		@file_name,
		@status_id)
end

select
	@contracts = 0

exec
	j_nextkey
		"products",
		@product_id output

/* TEST */

select
	@total = count(*)
from
	products
where
	symbol = @product
if @total != 0
begin
	select
		status = "Error",
		message = "Product symbol already exists",
		product = @product
	return
end

insert into
	products
values(
	@product_id,
	@product_type_id,
	@product,
	@product)

exec
	j_nextkey
		"product_rates",
		@product_rate_id output

insert into
	product_rates
values(
	@product_rate_id,
	@product_id,
	"1/16/1999")

insert into
	product_rate_points
values(
	@product_rate_id,
	0,
	0.0)


exec
	j_nextkey
		"contracts",
		@contract_id output

insert into
	contracts
values(
	@contract_id,
	@product,
	@instrument_id)

insert into
	forwards
values(
	@contract_id,
	@currency_id,
	@product_id,
	@quantity,
	@exchange_id)
	



go

