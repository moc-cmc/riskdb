create or replace procedure
	r_viewfiledropdestinations
		@login varchar(50),
		@filedrop_destination varchar(50)=NULL


as

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @filedrop_destination_id int

create table
        #meta(
                meta_type char(200),
                name char(50) NULL,
                action char(100) NULL,
                value char(200) NULL)

insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL)

insert into
        #meta
values(
        "Column Link",
        "add_destination",
        "Add Filedrop Destination",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "edit_destination",
        "Edit Filedrop Destination",
        NULL)

insert into
        #meta
values(
        "Column Link",
        "delete_destination",
        "Delete Filedrop Destination",
        NULL)

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
        @error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
        @total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
        @subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
        @style = "background:#FFFFFF;border: 1px solid white",
        @selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"

if @filedrop_destination != NULL
begin
	select
        	@filedrop_destination_id = filedrop_destination_id
	from
        	filedrop_destinations
	where
        	name = @filedrop_destination
	if @@rowcount != 1
	begin
        	select
                	status = "Error",
                	msg = "Could not find report",
                	destination = @filedrop_destination
        	return
	end
end


select
	style = @style,
	add_destination = "ADD DESTINATION"

create table
	#filedrop_destinations(
		section varchar(50) NULL,
		style varchar(50) NULL,
		filedrop_destination varchar(50) NULL,
		filedrop_destination_id int NULL,
		edit_destination varchar(50) NULL,
		delete_destination varchar(50) NULL)

insert into
	 #filedrop_destinations(
		section,
		style,
		filedrop_destination,
		filedrop_destination_id,
		edit_destination,
		delete_destination)
select
	section = "Destinations",
	style = @style,
	filedrop_destination = name,
	filedrop_destination_id = filedrop_destination_id,
	edit_destination = "EDIT",
	delete_destination = "DELETE"
from
	filedrop_destinations
order by
	name

if @filedrop_destination != NULL
begin
	update
		#filedrop_destinations
	set
		style = @selected_style 
	where
		filedrop_destination_id = @filedrop_destination_id
end

select
	section,
	style,
	filedrop_destination,
	edit_destination,
	delete_destination
from
	#filedrop_destinations
order by
	filedrop_destination

if @filedrop_destination != NULL
begin
	select
		section = "Configured For Destination",
		style = @style,
		run = a.name,
		report = c.name
	from
		runs a,
		run_fd_report_destinations b,
		filedrop_reports c
	where
		a.run_id = b.run_id
	and
		b.filedrop_destination_id = @filedrop_destination_id
	and
		c.filedrop_report_id = b.filedrop_report_id
	order by
		a.name,
		c.name
end

go
