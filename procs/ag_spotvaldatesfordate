drop procedure
	ag_spotvaldatesfordate
go

create or replace procedure
	ag_spotvaldatesfordate
		@login varchar(50),
		@trade_date datetime=NULL
as

declare @tico_account_id int
declare @admin_level int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @one_day datetime
declare @two_days datetime

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"trade_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"view_positions",
	"Client Rolls For Date",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"confirm_dates",
	"Confirm Roll Dates For Trade Date",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"back_to_home",
	"Roll Risk Home",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"set_date",
	"Set Spot Settle Date",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


if @trade_date = NULL
	select
		@trade_date = getdate()

select
	@trade_date = convert(datetime, convert(date, @trade_date))

if datename(weekday, @trade_date) = "Saturday"
	select
		@trade_date = dateadd(day, 2, @trade_date)

if datename(weekday, @trade_date) = "Sunday"
	select
		@trade_date = dateadd(day, 1, @trade_date)

exec
	r_nextbusinessday
		@trade_date,
		@one_day output

exec
	r_nextbusinessday
		@one_day,
		@two_days output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

create table
	#value_dates(
		id int identity,
		contract_id int NULL,
		symbol varchar(50) NULL,
		price_style varchar(50) NULL,
		trade_date datetime NULL,
		one_day datetime NULL,
		two_days datetime NULL,
		spot_date datetime NULL,
		closing_date datetime NULL,
		status varchar(50) NULL)
insert into
	#value_dates(
		contract_id)
select
	a.contract_id
from
	forwards a,
	products b,
	product_types c
where
	a.product_id = b.product_id
and
	b.product_type_id = c.product_type_id
and
	c.name = "Currency"
order by
	b.symbol
	
update
	#value_dates
set
	status = "Standard"

update
	#value_dates
set
	a.symbol = b.symbol
from
	#value_dates a,
	contracts b
where
	a.contract_id = b.contract_id

update
	#value_dates
set
	a.price_style = c.name
from
	#value_dates a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id


update
	#value_dates
set
	trade_date = @trade_date,
	one_day = @one_day,
	two_days = @two_days

update
	#value_dates
set
	closing_date = @one_day,
	spot_date = @two_days

update
	#value_dates
set
	closing_date = @trade_date,
	spot_date = @one_day
where
	symbol in("USDCAD", "CADUSD", "USDTRY", "TRYUSD", "USDRUB", "USDRUR")

delete

from
	#value_dates
where
	price_style = "Inverted"

delete

from
	#value_dates
where
	symbol = NULL

insert into
	spot_value_dates(
		contract_id,
		trade_date,
		closing_date,
		spot_date,
		includes_holiday)
select
	contract_id,
	trade_date = @trade_date,
	closing_date,	
	spot_date,
	includes_holiday = "N"
from
	#value_dates
where
	contract_id not in(
		select
			contract_id
		from
			spot_value_dates
		where
			trade_date = @trade_date)


create table
	#header(
		style varchar(250) NULL,
		back_to_home varchar(50) NULL,
		validated_by int NULL,
		user_login varchar(50) NULL,
		timestamp datetime NULL,
		trade_date datetime,
		confirm_dates varchar(25) NULL,
		view_positions varchar(25) NULL)
insert into
	#header(
		style,
		back_to_home,
		trade_date)
values(
	@style,
	"Back to Rolls Risk Home",
	@trade_date)

update
	#header
set
	a.validated_by = b.validated_by,
	a.timestamp = b.timestamp
from
	#header a,
	roll_trade_dates b
where
	a.trade_date = b.trade_date

update
	#header
set
	a.user_login = b.login
from
	#header a,
	tico_accounts b
where
	a.validated_by = b.account_id

update
	#header
set
	confirm_dates = "Confirm Dates"
where
	user_login = NULL
and
	timestamp = NULL

update
	#header
set
	view_positions = "View Positions"
where
	confirm_dates = NULL

select
	style,
	back_to_home,
	user_login,
	timestamp,
	trade_date,
	trading_date = convert(varchar(11), trade_date),
	confirm_dates,
	view_positions
from
	#header

	

select
	section = datename(weekday, a.spot_date) + " Holiday Settlements for trade date " + convert(varchar(11), a.trade_date),
	style = @style,
	a.trade_date,
	b.symbol,
	today = datename(weekday, a.trade_date),
	closing_date = convert(varchar(11), a.closing_date),
	closing_day = datename(weekday, a.closing_date),
	spot_date = convert(varchar(11), a.spot_date),
	spot_day = datename(weekday, a.spot_date),
	days_from_now = datediff(day, a.trade_date, a.spot_date),
	set_date = "Override Date For " + symbol
from
	spot_value_dates a,
	contracts b
where
	a.contract_id = b.contract_id
and
	lower(a.includes_holiday) = "y"
and
	convert(date, a.trade_date) = convert(date, @trade_date)
order by
	a.spot_date,
	b.symbol


select
	section = datename(weekday, a.spot_date) + " Standard settlements for trade date " + convert(varchar(11), a.trade_date),
	style = @style,
	a.trade_date,
	b.symbol,
	today = datename(weekday, a.trade_date),
	closing_date = convert(varchar(11), a.closing_date),
	closing_day = datename(weekday, a.closing_date),
	spot_date = convert(varchar(11), a.spot_date),
	spot_day = datename(weekday, a.spot_date),
	days_from_now = datediff(day, a.trade_date, a.spot_date),
	set_date = "Override Date For " + symbol
from
	spot_value_dates a,
	contracts b
where
	a.contract_id = b.contract_id
and
	lower(a.includes_holiday) = "n"
and
	convert(date, a.trade_date) = convert(date, @trade_date)
order by
	a.spot_date,
	b.symbol



go
