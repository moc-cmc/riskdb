
if object_id("cn_tradelist") != NULL
	drop procedure
		cn_tradelist
go

create procedure
	cn_tradelist
		@login varchar(50),
		@run_name varchar(50),
		@begin_date datetime= NULL,
		@end_date datetime=NULL
as

declare @run_id int
declare @begin_day_string char(20)
declare @end_day_string char(20)

create table
	#meta(
		meta_type char(200),
		name char(50),
		action char(100) NULL,
		value char(100) NULL)


insert into
	#meta
values(
	"Column Link",
	"edit_trade",
	"Deal Trade Inspector",
	NULL)

insert into
	#meta
values (
	"Column Format",
	"value_date",
	"Date",
	"MM/dd/yyyy")

insert into
	#meta
values (
	"Column Format",
	"fixing_date",
	"Date",
	"MM/dd/yyyy")

insert into
	#meta
values (
	"Column Format",
	"trade_price",
	"Number",
	"0.0000####")

insert into
	#meta
values (
	"Column Format",
	"premium",
	"Number",
	"0.##")

insert into
	#meta
values (
	"Column Format",
	"counter_amount",
	"Number",
	"#,##0.##")

select * from #meta

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding run with name",
		run = @run_name
	return
end

if @begin_date = NULL
	select
		@begin_date = getdate()
	if datepart(hour, @begin_date) >= 17
		exec
			r_nextbusinessday
				@begin_date,
				@begin_date output

	select
		@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
			convert(char(2), datepart(day, @begin_date)) + "/" +
			convert(char(4), datepart(year, @begin_date))
	select
		@begin_date = convert(datetime, @begin_day_string)

	exec
		r_prevbusinessday
			@begin_date,
			@begin_date output

	select
		@begin_date = dateadd(hour, 17, @begin_date)

if @end_date = NULL
	exec
		r_nextbusinessday
			@begin_date,
			@end_date output

/*	select
		@end_date = dateadd(day, 1, @begin_date) */
select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
			convert(char(2), datepart(day, @end_date)) + "/" +
			convert(char(4), datepart(year, @end_date)) + " 17:00"
	select
		@end_date = convert(datetime, @end_day_string)


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)

insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#trades(
		deal_id int,
		trade_id int,
		trade_date datetime,
		contract_id int,
		product_id int NULL,
		counter_amount float NULL,
		counter_currency_id int NULL,
		value_date datetime,
		fixing_date datetime NULL,
		quantity numeric(30,4),
		trade_price float,
		trader_id int,
		broker_id int,
		external_account_id int,
		counterparty_id int,
		sales_code_id int,
		strategy_id int,
		premium_currency varchar(50) NULL,
		premium float NULL)


insert into
	#trades
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	a.contract_id,
	product_id = NULL,
	counter_amount = NULL,
	counter_currency_id = NULL,
	a.value_date,
	a.fixing_date,
	a.quantity,
	a.price,
	a.trader_id,
	a.broker_id,
	a.external_account_id,
	a.counterparty_id,
	a.sales_code_id,
	a.strategy_id,
	premium_currency_id = NULL,
	premium = NULL
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_date >= @begin_date
and
	a.trade_date <= @end_date


/* UPDATE trades */
update
	#trades
set
	product_id = b.product_id,
	counter_amount = -a.quantity * a.trade_price,
	counter_currency_id = b.currency_id
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

update
	#trades
set
	product_id = d.product_id,
	counter_amount = -a.quantity * a.trade_price,
	counter_currency_id = d.currency_id
from
	#trades a,
	future_contracts b,
	futures c,
	forwards d
where
	a.contract_id = b.contract_id
and
	b.future_id = c.future_id
and
	c.forward_id = d.contract_id

update
	#trades
set
	product_id = e.product_id,
	counter_amount = -a.quantity * b.strike,
	counter_currency_id = e.currency_id
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	forwards e
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id

update
	#trades
set
	product_id = g.product_id,
	counter_amount = -a.quantity * b.strike,
	counter_currency_id = g.currency_id
from
	#trades a,
	option_contracts b,
	option_expirations c,
	options d,
	future_contracts e,
	futures f,
	forwards g
where
	a.contract_id = b.contract_id
and
	b.option_expiration_id = c.option_expiration_id
and
	c.option_id = d.option_id
and
	d.underlying_contract_id = e.contract_id
and
	e.future_id = f.future_id
and
	f.forward_id = g.contract_id

update
	#trades
set
	a.trade_price = 1.0 / a.trade_price
from
	#trades a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
	
update
	#trades
set
	premium = c.amount,
	premium_currency = e.symbol
from
	#trades a,
	account_transaction_trades b,
	account_transactions c,
	transaction_types d,
	products e
where
	a.trade_id = b.trade_id
and
	b.account_transaction_id = c.account_transaction_id
and
	c.transaction_type_id = d.transaction_type_id
and
	c.currency_id = e.product_id

select
	a.deal_id,
	a.trade_id,
	trade_date = convert(char(11), a.trade_date, 1),
	trade_time = right(convert(char(25), a.trade_date, 0), 13),
	a.value_date,
	a.fixing_date,
	b.symbol,
	a.quantity,
	ccy = i.symbol,
	counter_amount = a.counter_amount,
    counter_ccy = j.symbol,
	a.trade_price,
	a.premium,
	a.premium_currency,
	trader = c.symbol,
	broker = d.symbol,
	external_account = e.symbol,
	counterparty = g.name,
	sales_code = f.name,
	strategy = h.name,
	edit_trade = "EDIT"
from
	#trades a,
	contracts b,
	traders c,
	brokers d,
	external_accounts e,
	sales_codes f,
	counterparties g,
	strategies h,
	products i,
	products j
where
	a.contract_id = b.contract_id
and
	a.trader_id = c.trader_id
and
	a.broker_id = d.broker_id
and
	a.external_account_id = e.external_account_id
and
	a.sales_code_id = f.sales_code_id
and
	a.counterparty_id = g.counterparty_id
and
	a.strategy_id = h.strategy_id
and
	a.product_id = i.product_id
and
	a.counter_currency_id = j.product_id
order by
	a.deal_id,
	a.trade_id

go
