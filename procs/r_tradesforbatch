
drop procedure
	r_tradesforbatch
go

create procedure
	r_tradesforbatch
		@batch_id int
as

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)

insert into
        #links
values(
        "Format Number",
        "quantity",
        NULL,
        NULL,
        "#,##0")


insert into
	#links
values(
	"Column Link",
	"remove_trade",
	"Remove Trade From Batch",
	"suppressAutoexecute=YES",
	NULL)
	
insert into
	#links
values(
	"Column Link",
	"tally_batch_with_strategy",
	"Tally Batch With Strategy",
	"suppressAutoexecute=YES",
	NULL)

insert into
	#links
values(
	"Column Link",
	"tally_batch",
	"Tally Batched Trades",
	"suppressAutoexecute=YES",
	NULL)

select * from #links

select
	a.queued_trade_id,
	a.batch_id,
	trade_date = convert(char(22), a.trade_date, 1),
	value_date = convert(char(22), f.value_date, 1),
	quantity = a.quantity,
	symbol = b.symbol,
	price = convert(numeric(30,6), convert(char(30), a.price)),
	counterparty = g.name,
	trader = c.symbol,
	broker = d.symbol,
	external_account = e.symbol,
	underlying_price = convert(numeric(30,6), a.underlying_price),
	remove_trade = "REMOVE"
from
	queued_trades a,
	contracts b,
	traders c,
	brokers d,
	external_accounts e,
	queued_trade_value_dates f,
	counterparties g,
	trades h
where
	a.contract_id = b.contract_id
and
	a.trader_id = c.trader_id
and
	a.broker_id = d.broker_id
and
	a.external_account_id = e.external_account_id
and
	a.queued_trade_id *= f.queued_trade_id
and
	a.batch_id = @batch_id
and
	a.reference_trade_id = h.trade_id 
and
	h.counterparty_id=g.counterparty_id
order by
	b.symbol

select
	tally_batch = "TALLY THIS BATCH OF TRADES",
	/* tally_batch_with_strategy = "TALLY THIS BATCH OF TRADES WITH STRATEGY", */
	batch_id = @batch_id

go
