
if object_id("r_allcurrencycontracts") != NULL
    drop procedure
        r_allcurrencycontracts
go

create procedure 
		r_allcurrencycontracts

as

select
    a.symbol
from
    contracts a,
    forwards b,
    products c,
    product_types d
where
    a.contract_id = b.contract_id and
    b.product_id = c.product_id and
    c.product_type_id = d.product_type_id and
    d.name = "Currency"
order by
    a.symbol

go
