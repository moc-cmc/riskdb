drop procedure api_addrtnslpmapping
go

create procedure 
	api_addrtnslpmapping
		@login varchar(50),
		@counterparty varchar(50),
		@email varchar(100)=NULL,
		@trader_name varchar(50)=NULL,
		@trader_id varchar(25)=NULL,
		@trader_tcid varchar(25)=NULL



as

declare @int_rtns_cp_map_id int
declare @counterparty_id int
declare @orig_email varchar(100)
declare @orig_trader_name varchar(50)
declare @orig_trader_id varchar(25)
declare @orig_trader_tcid varchar(25)


select
	@counterparty_id = counterparty_id
from
	counterparties
where
	name = @counterparty
if @counterparty_id = NULL
begin
	select
		status = "Error",
		msg = "Problem determining counterparty",
		counterparty=@counterparty
	return
end

select
	@int_rtns_cp_map_id = int_rtns_cp_map_id
from
	int_rtns_cp_map
where
	counterparty_id = @counterparty_id

if @int_rtns_cp_map_id = NULL
begin

	/* Add new record */
	exec
		j_nextkey 
			"int_rtns_cp_map",
			@int_rtns_cp_map_id output

	insert into
		int_rtns_cp_map(
			int_rtns_cp_map_id,
			counterparty_id,
        		email,
        		trader_name,
        		trader_id,
        		trader_tcid)

	values(
		@int_rtns_cp_map_id,
		@counterparty_id,
		@email,
		@trader_name,
		@trader_id,
		@trader_tcid
	)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			msg = "Problem adding rtns mapping for account"
		return
	end
end
else
begin
	select
		@orig_email = email,
		@orig_trader_name = trader_name,
		@orig_trader_id = trader_id,
		@orig_trader_tcid = trader_tcid
	from
		int_rtns_cp_map
	where
		int_rtns_cp_map_id = @int_rtns_cp_map_id

	if @email = NULL
		select
			@email = @orig_email
	if @trader_name = NULL
		select
			@trader_name = @orig_trader_name
	if @trader_id = NULL
		select
			@trader_id = @orig_trader_id
	if @trader_tcid = NULL
		select
			@trader_tcid = @orig_trader_tcid
		
		
	/* Update info */
	update
		int_rtns_cp_map
	set
		email = @email,
		trader_name = @trader_name,
		trader_id = @trader_id,
		trader_tcid = @trader_tcid
	where
		int_rtns_cp_map_id = @int_rtns_cp_map_id
	if @@rowcount != 1
	begin
                select
                        status = "Error",
                        msg = "Problem updating rtns mapping for account"
                return
	end
end

exec
	r_managertnsmappings
		@login


go

