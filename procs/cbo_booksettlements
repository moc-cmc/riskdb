create table
	#trades(
		trade_id int NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		currency_id int NULL,
		currency varchar(50) NULL,
		product_qty float NULL,
		currency_qty float NULL,
		value_date datetime NULL,
		price float NULL,
		prime_broker_id int NULL,
		prime_broker varchar(50) NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		value_date,
		price)
select
	a.trade_id,
	a.external_account_id,
	c.product_id,
	a.quantity,
	c.currency_id,
	a.quantity * a.price * -1.0,
	a.value_date,
	a.price
from
	trades a,
	fund_external_accounts b,
	forwards c
where
	a.contract_id = c.contract_id
and
	a.external_account_id = b.external_account_id
and
	b.fund_id = @fund_id
and
	convert(date, a.value_date) = convert(date, @value_date)

/* Remove CFD product based trades from temp */
delete
	#trades
from
	#trades a,
	products b
where
	a.product_id = b.product_id
and
	b.name = rtrim(b.symbol) + " CFD"

delete
	#trades
from
	#trades a,
	products b
where
	a.currency_id = b.product_id
and
	b.name = rtrim(b.symbol) + " CFD"




