	product_id

update
	#client_balances
set
	a.product = b.symbol,
	a.account = c.symbol
from
	#client_balances a,
	products b,
	external_accounts c
where
	a.product_id = b.product_id
and
	a.external_account_id = c.external_account_id

update
	#client_balances
set
	settled_fx = 0.0,
	closed_fx = 0.0

update
	#client_balances
set
	a.settled_fx = b.amount
from
	#client_balances a,
	#account_settlements b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id

update
	#client_balances
set
	a.closed_fx = b.amount
from
	#client_balances a,
	#closed_account_settlements b
where
	a.external_account_id = b.external_account_id
and
	a.product_id = b.product_id 

update
	#client_balances
set
	settled_fx = 0.0
where
	settled_fx = NULL

update
	#client_balances
set
	closed_fx = 0.0
where
	closed_fx = NULL

update
	#client_balances
set
	net_balance = quantity - closed_fx - settled_fx

delete

from
	#client_balances
where
	abs(quantity) < 0.01

/*******************************************************/

	
exec
	j_nextkey
		"batches",
		@batch_id output

delete

from
	queued_settlements
where
	batch_id != @batch_id


/* Queue up the transactions to close the bank side balances */
insert into
	queued_settlements(
		batch_id,
		transaction_date,
		external_account_id,
		product_id,
		quantity)
select
	batch_id = @batch_id,
	transaction_date = @value_date,
	b.bo_external_account_id,
	a.product_id,
	a.net_balance
from
	#pb_balances a,
	prime_brokers b
where
	a.prime_broker_id = b.prime_broker_id
and
	a.prime_broker_id != @fund_prime_broker_id
and
	abs(net_balance) > 0.01


/* Queue up the transactions to settle client balances  */
insert into
	queued_settlements(
		batch_id,
		transaction_date,
		external_account_id,
		product_id,
		quantity)
select
	batch_id = @batch_id,
	transaction_date = @value_date,
	external_account_id,
	product_id,
	net_balance
from
	#client_balances
where
	external_account_id != @fund_external_account_id
and
	abs(net_balance) > 0.01
	

create table
	#spread_balances(
		id int identity,
		side varchar(50) NULL,
		product varchar(50) NULL,
		quantity numeric(30,2) NULL)
insert into
	#spread_balances(
		side,
		product,
		quantity)
select
	side,
	product,
	sum(quantity)
from
	#pb_balances
group by
	side,
	product
	
create table
	#summary(
		id int identity,
		style varchar(250) NULL,
		product varchar(50) NULL,
		product_name varchar(200) NULL,
		balance_vs_clearing numeric(30,2) NULL,
		balance_vs_clients numeric(30,2) NULL,
		net_balance numeric(30,2) NULL)

select
	@id = 0
select
	@ids = count(*)
from
	#spread_balances
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#spread_balances
	where
		id > @id

	select
		@product = product,
		@side = side,
		@quantity = quantity
	from
		#spread_balances
	where
		id = @id

	if @side = "Market"
	begin
		update
			#summary
		set
			balance_vs_clearing = @quantity
		where
			product = @product
		if @@rowcount = 0
		begin
			insert into
				#summary(
					style,
					product,
					balance_vs_clearing,
					balance_vs_clients)
			values(
				@style,
				@product,
				@quantity,
				0)
		end
	end

	if @side = "Client"
	begin
		update
			#summary
		set
			balance_vs_clients = @quantity
		where
			product = @product
		if @@rowcount = 0
		begin
			insert into
				#summary(
					style,
					product,
					balance_vs_clearing,
					balance_vs_clients)
			values(
				@style,
				@product,
				0,
				@quantity)
		end
	end
			

	select
		@ids = count(*)
	from
		#spread_balances
	where
		id > @id
end

update
	#summary
set
	a.product_name = b.name
from
	#summary a,
	products b
where
	a.product = b.symbol

update
	#summary
set
	net_balance = balance_vs_clearing + balance_vs_clients

create table
	#pb_output(
		id int identity,
		style varchar(250) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(100) NULL,
		external_account_id int NULL,
		external_account varchar(100) NULL,
		value_date varchar(20) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		balance numeric(30,2) NULL,
		closed_fx numeric(30,2) NULL,
		settled_fx numeric(30,2) NULL,
		net_balance numeric(30,2) NULL)
select
	@id = 0
select
	@ids = count(*)
from
	#prime_brokers
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#prime_brokers
	where
		id > @id

	select
		@pb_id = prime_broker_id
	from
		#prime_brokers
	where
		id = @id

	insert into
		#pb_output(
			style,
			prime_broker_id,
			prime_broker,
			value_date)
	select
		pb_style = @pb_style,
		prime_broker_id,
		prime_broker,
		value_date = convert(varchar(11), @value_date, 1)
	from
		#prime_brokers
	where
		id = @id


	insert into
		#pb_output(
			style,
			product_id,
			product,
			balance,
			closed_fx,
			settled_fx,
			net_balance)
	select
		style = @style,
		product_id,
		product,
		quantity,
		closed_fx,
		settled_fx,
		net_balance
	from
		#pb_balances
	where
		prime_broker_id = @pb_id
	order by
		product
			
	select
		@ids = count(*)
	from
