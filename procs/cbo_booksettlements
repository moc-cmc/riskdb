create table
        #account_transactions(
                account_transaction_id int,
                entered_by int,
                external_account_id int,
                transaction_type_id int,
                transaction_date datetime,
                currency_id int,
                amount float,
                note char(255) null
)
insert into
        #account_transactions
select
        account_transaction_id ,
        entered_by ,
        external_account_id ,
        transaction_type_id,
        transaction_date,
        currency_id ,
        amount,
        note
from
        account_transactions
where
        transaction_type_id = @transaction_type_id
and
        convert(date, transaction_date) = convert(date, @value_date)
and
	external_account_id != @settlement_account_id

/* chriso flipping account fx settlement transactions based on external_account_directions */
update
        #account_transactions
set
        a.amount = a.amount * -1
from
        #account_transactions a,
        external_account_directions b
where
        a.external_account_id = b.external_account_id
and
        b.direction = -1

create table
	#account_settlements(
		external_account_id int,
		product_id int,
		amount numeric(30,4) NULL)
insert into
	#account_settlements(
		external_account_id,
		product_id,
		amount)
select
	external_account_id,
	currency_id,
	sum(amount)
from
	#account_transactions
where
	transaction_type_id = @transaction_type_id
and
	convert(date, transaction_date) = convert(date, @value_date)
group by
	external_account_id,
	currency_id


