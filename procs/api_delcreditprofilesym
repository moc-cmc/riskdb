
drop procedure
	api_delcreditprofilesym	
go

create procedure 
	api_delcreditprofilesym	
		@login varchar(25),
		@name varchar(50),
		@source_name varchar(100),
		@mapping varchar(50)
as

declare @credit_profile_id int
declare @source_id int

select
	@credit_profile_id=credit_profile_id
from
	credit_profiles	
where
	name=@name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find credit profile",
		credit_profile=@name

	return
end

select
	@source_id=source_id
from
	sources
where
	name=@source_name

if (@@rowcount != 1)
begin
	select
		status="Error",
		msg="Could not find source",
		source=@source_name

	return
end

begin tran

	delete from
		credit_profile_symbols	
	where
		credit_profile_id=@credit_profile_id
	and
		source_id=@source_id
	and
		symbol=@mapping

	if (@@rowcount != 1)
	begin
		rollback tran

		select
			status="Error",
			msg="Could not delete Credit Profile mapping",
			name=@name

		return
	end

commit tran

select
	status="Success",
	msg="Credit Profile mapping deleted",
	name=@name

exec
	r_mappingoverview2
			@login=@login

return

go

