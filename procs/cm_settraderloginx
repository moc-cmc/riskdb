if object_id("cm_settraderlogin") != NULL
    drop procedure
        cm_settraderloginx
go

create procedure
	cm_settraderloginx
		@login varchar(50),
		@trader varchar(50),
		@user_name varchar(50)
as

declare @trader_id int
declare @tico_account_id int


select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Trader symbol not found",
		trader = @trader
	return
end


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @user_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "User name not found",
		user_name = @user_name
	return
end

update
	traders
set
	tico_account_id = @tico_account_id
where
	trader_id = @trader_id

