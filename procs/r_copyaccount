
if object_id("r_copyaccount") != NULL
    drop procedure
        r_copyaccount
go

create procedure r_copyaccount @existing_account varchar(25), @new_account varchar(25), @password varchar(20) as

declare @existing_tico_account_id	int
declare @new_tico_account_id		int

select
	@existing_tico_account_id = account_id
from
	tico_accounts
where
	login=@existing_account

if @@rowcount != 1
begin
	select
		err=-1,
		errmsg="Could not get tico account id for existing account ", @existing_account

	return
end

select
	@new_tico_account_id = NULL

exec j_nextkey "tico_accounts", @new_tico_account_id output

insert into 
	tico_accounts 
values
	(@new_tico_account_id,
	 @new_account,
	 @new_account,
	 1,
	 @new_account,
	 @new_account)

if @@rowcount != 1
begin
	select
		err=-1,
		errmsg="Could not insert new tico account record ", @new_account
	return
end

insert into
	user_runs
select
	@new_tico_account_id,
	run_id
from
	user_runs
where
	tico_account_id=@existing_tico_account_id

insert into
	default_accounts
select
	@new_tico_account_id,
    spot_internal_account_id,
    spot_external_account_id,
    futures_internal_account_id,
    futures_external_account_id,
    internal_external_account_id
from
	default_accounts
where
	tico_account_id=@existing_tico_account_id

insert into
	fund_tico_accounts
select
	fund_id,
	@new_tico_account_id,
	priority
from
	fund_tico_accounts
where
	tico_account_id=@existing_tico_account_id

select
	"New account copied from ", @existing_account

return

go
