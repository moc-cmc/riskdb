
if object_id("fxa_tallyndfclienttrade") != NULL
    drop procedure
        fxa_tallyndfclienttrade
go

create procedure
	fxa_tallyndfclienttrade	
		@login varchar(50),
		@tally_type varchar(50),
		@client_user varchar(50),
		@client_buys_sells varchar(50),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@quantity numeric(30,4),
		@price float,
		@value_date datetime,
		@fixing_date datetime

as

declare @deal_id int
declare @trade_id int

exec api_tallyclienttrade
		@login,
		@tally_type,
		@client_user,
		@client_buys_sells,
		@dealt_currency,
		@counter_currency,
		@quantity,
		@price,
		@value_date,
		@deal_id output,
		@trade_id output,
		@fixing_date

exec
	r_inserttradenotification @trade_id
		
exec
	r_inspectdealtrades
		@login,
		@deal_id


go
