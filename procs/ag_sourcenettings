select
	@id = 0
select
	@ids = count(*)
from
	#ag_trades
where
	id > @id
while @ids > 0
begin
	select
		@id = min(id)
	from
		#ag_trades
	where
		id > @id

	select
		@sat_id = NULL,
		@folder = NULL,
		@folder_id = NULL,
		@sub_folder = NULL, /* chriso */
		@sub_folder_id = NULL, /* chriso */
		@strategy_id = NULL,
		@contract_id = NULL,
		@value_date = NULL,
		@quantity = NULL,
		@price = NULL

	select
		@folder = folder,
		@sub_folder = sub_folder, /* chriso */
		@strategy_id = strategy_id,
		@contract_id = contract_id,
		@value_date = value_date,
		@quantity = quantity,
		@price = price
	from
		#ag_trades
	where
		id = @id

	select
		@folder_id = folder_id
	from
		folders
	where
		name = @folder
	if @folder_id = NULL
	begin
		exec
			j_nextkey
				"folders",
				@folder_id output

		insert into
			folders(
				folder_id,
				name)
		values(
			@folder_id,
			@folder)
	end

	/* chriso */
	select
		@sub_folder_id = folder_id
	from
		folders
	where
		name = @sub_folder
	if @sub_folder_id = NULL
	begin
		exec
			j_nextkey
				"folders",
				@sub_folder_id output

		insert into
			folders(
				folder_id,
				name)
		values(
			@sub_folder_id,
			@sub_folder)
	end


	exec
		j_nextkey
			"source_aggregate_trades",
			@sat_id output

	insert into
		source_aggregate_trades(
			sat_id,
			net_ticket_batch_id,
			source_id,
			trade_date,
			folder_id,
			sub_folder_id, /* chriso */
			strategy_id,
			contract_id,
			value_date,
			quantity,
			price)
	values(
		@sat_id,
		@net_ticket_batch_id,
		@source_id,
		@trade_date,
		@folder_id,
		@sub_folder_id, /* chriso */
		@strategy_id,
		@contract_id,
		@value_date,
		@quantity,
		@price)


	select
		@ids = count(*)
	from
		#ag_trades
	where
		id > @id
end


