/* put the trades in a temp table */
create table
	#trades(
		id int identity,
		style varchar(200) NULL,
		identifier varchar(200) NULL,
		trade_id int NULL,
		deal_id int NULL,
		trade_date datetime NULL,
		contract_id int NULL,
		product_id int NULL,
		currency_id int NULL,
		symbol varchar(50) NULL,
		value_date datetime NULL,
		counterparty_id int NULL,
		counterparty varchar(50) NULL,
		counterparty_symbol varchar(50) NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		external_account_symbol varchar(50) NULL,
		external_account_type varchar(50) NULL,
		client_give_up varchar(50) NULL, /* chriso */
		strategy_id int NULL,
		strategy varchar(50) NULL,
		quantity numeric(30,4) NULL,
		price float NULL)
insert into
	#trades(
		trade_id,
		deal_id,
		trade_date,
		contract_id,
		product_id,
		currency_id,
		value_date,
		counterparty_id,
		external_account_id,
		strategy_id,
		quantity,
		price)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	a.contract_id,
	b.product_id,
	b.currency_id,	
	a.value_date,
	a.counterparty_id,
	a.external_account_id,
	a.strategy_id,
	a.quantity,
	a.price
from
	trades a,
	forwards b,
	#external_account_symbols c
where
	a.contract_id = b.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.external_account_id = c.external_account_id
and
	abs(a.quantity) > 0.0

insert into
	#trades(
		trade_id,
		deal_id,
		trade_date,
		contract_id,
		product_id,
		currency_id,
		value_date,
		counterparty_id,
		external_account_id,
		strategy_id,
		quantity,
		price)
select
	a.trade_id,
	a.deal_id,
	a.trade_date,
	a.contract_id,
	b.product_id,
	b.currency_id,	
	a.value_date,
	a.counterparty_id,
	a.external_account_id,
	a.strategy_id,
	a.quantity,
	a.price
from
	trades a,
	forwards b,
	#counterparty_symbols c
where
	a.contract_id = b.contract_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.counterparty_id = c.counterparty_id
and
	abs(a.quantity) > 0.0


