set
	style = @style

update
	#client_longs
set
	a.identifier = rtrim(a.external_account_symbol) + rtrim(b.symbol) + convert(varchar(11), a.value_date) + rtrim(c.name) + rtrim(d.name) + "Cl"
from
	#client_longs a,
	contracts b,
	counterparties c,
	strategies d
where
	a.contract_id = b.contract_id
and
	a.counterparty_id = c.counterparty_id
and
	a.strategy_id = d.strategy_id

update
	#client_longs
set
	style = @selected_style
where
	identifier = @identifier

