		identifier varchar(200) NULL,
		counterparty_id int NULL,
		external_account_symbol varchar(50) NULL,
		client_give_up varchar(50) NULL, /* chriso */
		prime_broker_id int NULL,
		strategy_id int NULL,
		contract_id int NULL,
		value_date datetime NULL,
		tickets int NULL,
		amount numeric(30,4) NULL,
		counter_amount numeric(30,4) NULL,
		avg_price float NULL)

insert into
	#client_longs(
		counterparty_id,
		external_account_symbol,
		client_give_up, /* chriso */
		prime_broker_id,
		strategy_id,
		contract_id,
		value_date,
		tickets,
		amount,
		counter_amount,
		avg_price)
select
	a.counterparty_id,
	b.symbol,
	a.client_give_up, /* chriso */
	b.prime_broker_id,
	a.strategy_id,
	a.contract_id,
	a.value_date,
	count(a.trade_id),
	sum(a.quantity),
	sum(a.quantity * a.price * -1.0),
	sum(a.quantity * price) / sum(a.quantity)
from
	#trades a,
	#external_account_symbols b
where
	a.external_account_id = b.external_account_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	b.external_account_type = "Client"
and
	a.quantity > 0.0
group by
	a.counterparty_id,
	b.symbol,
	a.client_give_up, /* chriso */
	b.prime_broker_id,
	a.strategy_id,
	a.contract_id,
	a.value_date,
	sign(a.quantity)



update
