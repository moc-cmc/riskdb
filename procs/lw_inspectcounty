use
	risk_firsel
go

drop procedure
	lw_inspectcounty
go

create procedure
	lw_inspectcounty
		@login varchar(50),
		@county varchar(100),
		@state_code varchar(10)
as

declare @county_id int

select
	@county_id = a.county_id
from
	counties a,
	states b
where
	a.state_id = b.state_id
and
	a.name = @county
and
	b.code = @state_code


select
	*
from
	counties
where
	county_id = @county_id


select * from county_fees where county_id = @county_id


go
