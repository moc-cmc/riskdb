exec
	r_defaultfundforlogin
		@login,
		@fund_id output

exec
	br_accountslinks
		@login


if @begin_date = NULL
begin
	if @end_date = NULL
	begin
		select
			@end_date = getdate()
		exec
			r_daterangefordate
				@end_date,
				@begin_date output,
				@end_date output
	end
end

if @end_date = NULL
begin
	exec
		r_daterangefordate
			@begin_date,
			@begin_date output,
			@end_date output
end


select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end


create table
	#external_accounts(
		external_account_id int)

insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts
end


create table
	#trades(
		trade_id int)
insert into
	#trades
select
	a.trade_id
from
	trades a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date

create table
	#revals(
		trade_daily_reval_id int,
		trade_id int,
		external_account_id int,
		bo_trade_date datetime,
		unrealized_pl float,
		evaluation_notional float NULL)

insert into
	#revals
select
	a.trade_daily_reval_id,
	a.trade_id,
	b.external_account_id,
	a.bo_trade_date,
	a.unrealized_pl_to_date,
	a.evaluation_notional
from
	committed_daily_revals a,
	trades b,
	#external_accounts c
where
	a.trade_id = b.trade_id
and
	b.external_account_id = c.external_account_id
and
	convert(date, a.bo_trade_date) = convert(date, a.reval_date)
and
	a.bo_trade_date >= @begin_date
and
	a.bo_trade_date < @end_date


create table
	#net_revals(
		external_account_id int,
		unrealized_pl float,
		volume float )
insert into
	#net_revals
select
	external_account_id,
	sum(unrealized_pl),
	sum(evaluation_notional)
from
	#revals
group by
	external_account_id

create table
	#account_activity(
		id int identity,
		external_account_id int,
		transaction_type_id int,
		opening float,
		activity float,
		total float)

create table
	#account_net(
		transaction_type_id int,
		amount float)
insert into
	#account_net
select
	a.transaction_type_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
group by
	a.transaction_type_id

create table
	#begin_nets(
		external_account_id int,
		transaction_type_id int,
		amount float)
insert into
	#begin_nets
select
	a.external_account_id,
	a.transaction_type_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date < @begin_date
group by
	a.external_account_id,
	a.transaction_type_id

create table
	#end_nets(
		external_account_id int,
		transaction_type_id int,
		amount float)

insert into
	#end_nets
select
	a.external_account_id,
	a.transaction_type_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date < @end_date
group by
	a.external_account_id,
	a.transaction_type_id
		
create table
	#transaction_types(
		transaction_type_id int)
insert into
	#transaction_types
select
	distinct(transaction_type_id)
from
	#begin_nets
insert into
	#transaction_types
select
	distinct(transaction_type_id)
from
	#end_nets
where
	transaction_type_id not in(
		select
			transaction_type_id
		from
			#transaction_types)

insert into
	#account_activity(
		external_account_id,
		transaction_type_id,
		opening,
		activity,
		total)
select
	a.external_account_id,
	b.transaction_type_id,
	opening = 0.0,
	activity = 0.0,
	total = 0.0
from
	#external_accounts a,
	#transaction_types b

update
	#account_activity
set
	a.opening = b.amount
from
	#account_activity a,
	#begin_nets b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = b.transaction_type_id

update
	#account_activity
set
	a.activity = b.amount
from
	#account_activity a,
	#end_nets b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = b.transaction_type_id


update
	#account_activity
set
	total = opening + activity


create table
	#accts(
		id int identity,
		symbol varchar(100),
		external_account_id int NULL)
insert into
	#accts(
		symbol,
		external_account_id)
select
	a.symbol,
	a.external_account_id
from
	external_accounts a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
order by
	a.symbol

create table
	#output(
		id int identity,
		section varchar(200),
		style varchar(200) NULL,
		external_account_id int,
		account varchar(100) NULL,
		account_symbol varchar(100) NULL,
		balance_activity varchar(50) NULL,
		opening float NULL,
		activity float NULL,
		cash_total float NULL,
		trading_activity varchar(50) NULL,
		trading_total float NULL,
		volume float NULL,
		)
select
	@id = 0
select
	@external_accounts = count(*)
from
	#accts
where
	id > @id

while @external_accounts > 0
begin
	select
		@id = min(id)
	from
		#accts
	where
		id > @id

	select
		@external_account_id = external_account_id
	from
		#accts
	where
		id = @id

	select
		@account = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id
		
	select
		@opening_total = NULL,
		@activity_total = NULL,
		@total = NULL,
		@volume = NULL,
		@unrealized_pl = NULL
 
	insert into
		#output(
			section,
			style,
			external_account_id,
			account_symbol,
			balance_activity,
			opening,
			activity,
			cash_total)
	select
		section = "Client Activity Summary",
		style = "background:#FFFFFF;border: 1px solid white",
		a.external_account_id,
		b.symbol,
		c.name,
		a.opening,
		a.activity,
		a.total
	from
		#account_activity a,
		external_accounts b,
		transaction_types c
	where
		a.external_account_id = b.external_account_id
	and
		a.transaction_type_id = c.transaction_type_id
	and
		a.external_account_id = @external_account_id
	order by
		a.id

	select
		@min_id = min(id)
	from
		#output
	where
		external_account_id = @external_account_id

	select
		@volume = volume,
		@unrealized_pl = unrealized_pl
	from
		#net_revals
	where
		external_account_id = @external_account_id
	if @volume = NULL
		select
			@volume = 0.0
	if @unrealized_pl = NULL
		select
			@unrealized_pl = 0.0

	update
		#output
	set
		volume = @volume,
		account = "<b>" + rtrim(account_symbol) + "</b>"
	where
		id = @min_id

	
	update
		#output
	set
		trading_activity = "Trading Volume",
		trading_total = @volume
	where
		id = @min_id


	select
		@opening_total = sum(opening),
		@activity_total = sum(activity),
		@total = sum(cash_total)
	from
		#output
	where
		external_account_id = @external_account_id


	insert into
		#output(
			section,
			style,
			external_account_id,
			balance_activity,
			opening,
			activity,
			cash_total)	
	values(
		"Client Activity Summary",
		"background:#FFFFFF;border: 1px solid white",
		@external_account_id,
		"Cash Balance",
		@opening_total,
		@activity_total,
		@total)	

	insert into
		#output(
			section,
			style,
			external_account_id,
			balance_activity,
			opening,
			activity,
			cash_total)	
	values(
		"Client Activity Summary",
		"background:#FFFFFF;border: 1px solid white",
		@external_account_id,
		"Unrealized P&L",
		NULL,
		@unrealized_pl,
		@unrealized_pl)	


	select
		@equity_balance = @total + @unrealized_pl

	insert into
		#output(
			section,
			style,
			external_account_id,
			balance_activity,
			opening,
			activity,
			cash_total)
	values(
		"Client Activity Summary",
		"background:#FFFFFF;border: 1px solid white",
		@external_account_id,
		"Equity Balance",
		NULL,
		NULL,
		@equity_balance)

	insert into
		#output(
			section,
			style,
			external_account_id,
			account_symbol,
			account)
	values(
		"Client Activity Summary",
		"background:#FFFFFF;border: 1px solid white",
		@external_account_id,
		@account,
		"-")
		
	select
		@external_accounts = count(*)
	from
		#accts
	where
		id > @id
end

update
	#output
set
	style = "background:#FFFFFF;border: 1px solid white"
where
	balance_activity = "Fees/Commissions/Brokerage"


update
	#output
set
	style = "background:#FFFFFF;border: 1px solid white"
where
	balance_activity = "FX Settlement"

create table
	#summary(
		section varchar(200),
		style varchar(250) NULL,
		transaction_type varchar(50) NULL,
		total float NULL)
insert into
	#summary	
select
	section = "Summary",
	style = "background:#FFFFFF;border: 1px solid white",
	transaction_type = a.name,
	total = b.amount
from
	transaction_types a,	
	#account_net b
where
	a.transaction_type_id = b.transaction_type_id

select
	@volume = sum(volume),
	@unrealized_pl = sum(unrealized_pl)
from
	#net_revals

select
	@equity_balance = sum(cash_total) 
from
	#output
where
	balance_activity = "Equity Balance"
	

insert into
	#summary
values(
	"Summary",
	"background:#FFFFFF;border: 1px solid white",
	"Unrealized P&L",
	@unrealized_pl)

insert into
	#summary
values(
	"Summary",
	"background:#FFFFFF;border: 1px solid white",
	"Equity Balance",
	@equity_balance) 

insert into
	#summary
values(
	"Summary",
	"background:#FFFFFF;border: 1px solid white",
	"Volume",
	@volume)
