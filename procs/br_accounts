create procedure
	br_accounts
		@login varchar(50),
		@run_name varchar(50)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @fund varchar(100)
declare @fund_id int
declare @run_id int
declare @external_account_id int
declare @external_accounts float
declare @id int
declare @min_id int
declare @opening_total float
declare @activity_total float
declare @total float
declare @volume float
declare @unrealized_pl float
declare @account varchar(50)
declare @equity_balance float

if @run_name = NULL
begin
	select
		@run_name = name
	from
		funds
end
