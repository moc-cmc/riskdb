create or replace procedure
	tt_notifycollateralabide
		@source varchar(50),
		@trade_date varchar(50)=NULL,
		@query_options char(1)=NULL,
                @query_futures char(1)=NULL,
                @format_swaps char(1)=NULL,
		@format_ndf_swaps char(1)=NULL,
		@mark_to_market char(1)=NULL
		
as

declare @source_id int
declare @evaluation_currency_id int
declare @last_commit_date datetime


select
	@evaluation_currency_id = evaluation_currency_id
from
	funds

if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evalution Currency not found"
	return
end


select
        @last_commit_date = max(commit_date)
from
        daily_commits a,
        commit_statuses b
where
        a.commit_status_id = b.commit_status_id
and
        b.name = "Commit Complete"


if @trade_date = NULL
        select
                @trade_date = convert(date, getdate())

if convert(date, @trade_date) > convert(date, @last_commit_date)
begin
        return

        /*select
                error = "Error",
                msg = "Data is not committed for date, can not generate report",
                trade_date = convert(date, @trade_date) ,
                last_commit_date = @last_commit_date
        return
        */
end


select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end


create table
        #output(
                external_account_id int,
                external_account varchar(50) NULL,
                evaluation_currency_id int NULL,
                evaluation_currency varchar(10) NULL,
                fund_lei_number varchar(50) NULL,
                account_lei_number varchar(50) NULL,
                account_lei_type varchar(50) NULL,
                account_country varchar(50) NULL,
                cash_equiv float NULL,
                open_equity float NULL,
                margin_use float NULL,
		excess_collateral float NULL,
		trade_date datetime NULL,
		trade_notification_id int NULL
        )


insert into
        #output(
                external_account_id,
                cash_equiv,
                open_equity,
                margin_use,
                trade_date)
select
        a.external_account_id,
        a.cash_equiv,
        a.open_equity,
        a.margin_use,
        a.trade_date
from
        bo_account_usages a
where
        a.trade_date = @trade_date
and
        a.open_equity != NULL
group by
        a.external_account_id

update
        #output
set
        external_account = a.symbol
from
        external_accounts a,
        #output b
where
        a.external_account_id = b.external_account_id

update
	#output
set
	evaluation_currency_id = @evaluation_currency_id

update
        #output
set
        external_account = b.symbol
from
        #output a,
        external_account_symbols b
where
        a.external_account_id = b.external_account_id
and
        b.source_id = @source_id

update
        #output
set
        evaluation_currency = b.symbol
from
        #output a,
        products b
where
        a.evaluation_currency_id = b.product_id

update
        #output
set
        fund_lei_number = lei_number
from
        fund_regulatory_info

update
        #output
set
        account_lei_number = b.lei_number,
        account_country = b.branch_location,
        account_lei_type = b.lei_type
from
        #output a,
        account_regulatory_info b
where
        a.external_account_id =  b.external_account_id

