create or replace procedure
	ag_approvalhome
		@login varchar(50)
as

declare @tico_account_id int
declare @admin_level int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"assign",
	"Assign Request Custodial Account",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"reject",
	"Reject Client Request",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"next_action",
	"Approve Next Request Action",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"enable_user",
	"Enable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"disable_user",
	"Disable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"add_admin_user",
	"Add Approval User",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@admin_level = admin_level
from
	approval_users
where
	tico_account_id = @tico_account_id

if @admin_level != 0
begin
	select
		status = "Restricted Access",
		message = "Senior Admin level status required for login to access this page"
		return
end


create table
	#ledger_requests(
		id int identity,
		style varchar(250) NULL,
		ledger_request_id int,
		requestor_id int,
		requestor varchar(50) NULL,
		status_id int,
		status varchar(50) NULL,
		updated_by_id int NULL,
		updated_by varchar(50) NULL,
		outside_account_id int,
		outside_account varchar(50) NULL,
		bo_master_account_id int,
		bo_master_account varchar(50) NULL,
		custodial_account_id int NULL,
		custodial_account varchar(50) NULL,
		assign varchar(15) NULL,
		ledger_request_type_id int,
		ledger_request_type varchar(50) NULL,
		product_id int,
		product varchar(50) NULL,
		amount float,
		transaction_date datetime,
		request_date datetime,
		next_action varchar(50) NULL,
		reject varchar(50) NULL)

insert into
	#ledger_requests(
		style,
		ledger_request_id,
		requestor_id,
		status_id,
		outside_account_id,
		bo_master_account_id,
		custodial_account_id,
		ledger_request_type_id,
		product_id,
		amount,
		transaction_date,
		request_date)
select
	style = @style,
	ledger_request_id,
	requestor_id,
	status_id,
	outside_account_id,
	bo_master_account_id,
	custodial_account_id,
	ledger_request_type_id,
	product_id,
	amount,
	transaction_date,
	request_date
from
	ledger_requests
order by
	transaction_date

update
	#ledger_requests
set
	a.requestor = b.login
from
	#ledger_requests a,
	tico_accounts b
where
	a.requestor_id = b.account_id

update
	#ledger_requests
set
	a.status = b.name
from
	#ledger_requests a,
	statuses b
where
	a.status_id = b.status_id

update
	#ledger_requests
set
	a.outside_account = b.name
from
	#ledger_requests a,
	outside_accounts b
where
	a.outside_account_id = b.outside_account_id

update
	#ledger_requests
set
	a.bo_master_account = c.symbol
from
	#ledger_requests a,
	bo_master_accounts b,
	external_accounts c
where
	a.bo_master_account_id = b.bo_master_account_id
and
	b.external_account_id = c.external_account_id

update
	#ledger_requests
set
	a.custodial_account = b.symbol
from
	#ledger_requests a,
	external_accounts b
where
	a.custodial_account_id = b.external_account_id

update
	#ledger_requests
set
	a.ledger_request_type = b.name
from
	#ledger_requests a,
	ledger_request_types b
where
	a.ledger_request_type_id = b.ledger_request_type_id

update
	#ledger_requests
set
	a.product = b.symbol
from
	#ledger_requests a,
	products b
where
	a.product_id = b.product_id

create table
	#last_updates(
		ledger_request_id int,
		timestamp datetime,
		edited_by int NULL)
insert into
	#last_updates(
		ledger_request_id,
		timestamp)
select
	a.ledger_request_id,
	max(timestamp)
from
	#ledger_requests a,
	ledger_request_edits b
where
	a.ledger_request_id = b.ledger_request_id
group by
	a.ledger_request_id

update
	#last_updates
set
	a.edited_by = b.edited_by
from
	#last_updates a,
	ledger_request_edits b
where
	a.ledger_request_id = b.ledger_request_id
and
	a.timestamp = b.timestamp

update
	#ledger_requests
set
	a.updated_by_id = b.edited_by
from
	#ledger_requests a,
	#last_updates b
where
	a.ledger_request_id = b.ledger_request_id

update
	#ledger_requests
set
	a.updated_by = b.login
from
	#ledger_requests a,
	tico_accounts b
where
	a.updated_by_id = b.account_id

update
	#ledger_requests
set
	reject = "Reject"
where
	status not in("Cancelled", "Complete", "Rejected", "Approved")

/* update
	#ledger_requests
set
	next_action = "Acknowledged"
where
	status = "New" */
	

update
	#ledger_requests
set
	next_action = "Approved"
where
	status = "Acknowledged"
and
	updated_by != @login 

update
	#ledger_requests
set
	next_action = "Acknowledged"
where
	status = "New"
and
	ledger_request_type = "Deposit"

update
	#ledger_requests
set
	assign = "Assign"
where
	status = "New"
and
	ledger_request_type = "Withdrawal"
and
	custodial_account =  "UNASSIGNED CUSTODY"

select
	section = "Open Requests",
	style,
	ledger_request_id,
	requestor,
	status,
	updated_by,
	next_action,
	reject,
	outside_account,
	bo_master_account,
	custodial_account,
	assign,
	ledger_request_type,
	product,
	amount,
	transaction_date = convert(varchar(11), transaction_date),
	request_date
from
	#ledger_requests
where
	status not in("Approved", "Rejected", "Cancelled")
order by
	ledger_request_id desc


select
	section = "Closed Requests",
	style,
	ledger_request_id,
	requestor,
	status,
	updated_by,
	next_action,
	reject,
	outside_account,
	bo_master_account,
	custodial_account,
	assign,
	ledger_request_type,
	product,
	amount,
	transaction_date = convert(varchar(11), transaction_date),
	request_date
from
	#ledger_requests
where
	status in("Approved", "Rejected", "Cancelled")
order by
	ledger_request_id desc


go
