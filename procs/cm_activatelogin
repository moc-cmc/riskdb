
if object_id("cm_activatelogin") != NULL
    drop procedure
        cm_activatelogin
go

create procedure
	cm_activatelogin
		@login varchar(30),
		@user_name varchar(30)
as

declare @status varchar(30)
declare @tico_account_id int
declare @tico_server varchar(50)
declare @tico_database varchar(50)
declare @sql_string varchar(250)
declare @active_status_id int

select
	@tico_server = tico_server,
	@tico_database = tico_database
from
	funds


select
	@tico_account_id = a.account_id,
	@status = b.name
from
	tico_accounts a,
	statuses b
where
	a.status_id = b.status_id
and
	a.login = @user_name
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "user name not found",
		user_name = @user_name
	return
end
	
if @status != "New"
begin
	select
		status = "Error",
		message = "This account cannot be activated. It is not new"
	return
end

select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
if @active_status_id = NULL
begin
	exec
		j_nextkey
			"statuses",
			@active_status_id output
	insert into
		statuses
	values(
		@active_status_id,
		"Active")
end

update
	tico_accounts
set
	status_id = @active_status_id
where
	account_id = @tico_account_id


select
        @sql_string = "exec " + rtrim(@tico_database) + "..ti_activatelogin '" + rtrim(@user_name) + "'"

exec
	sp_remotesql
		@tico_server,
		@sql_string

exec
	cm_fundaccounts
		@login
go
