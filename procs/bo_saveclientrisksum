
drop procedure
	bo_saveclientrisksum
go

create procedure
	bo_saveclientrisksum
		@login varchar(50),
		@trade_date datetime=NULL
as



declare @fund_id int
declare @evaluation_currency_id int
declare @begin_date datetime
declare @end_date datetime
declare @default_nop_type_id int

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id,
	@default_nop_type_id = nop_type_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end

if @trade_date = NULL
begin
	select
		status = "Error",
		message = "Trade date not provided"
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


create table
	#external_accounts(
		id int identity,
		external_account_id int,
		symbol varchar(50),
		margin_multiplier float NULL)

insert into
	#external_accounts(
		external_account_id,
		symbol,
		margin_multiplier)
select
	a.external_account_id,
	a.symbol,
 
	a.margin_multiplier
from
	external_accounts a,
	fund_external_accounts b
where
	a.external_account_id = b.external_account_id
order by
	a.symbol


create table
	#trades(
		trade_id int,
		prime_broker_id int NULL,
		external_account_id int,
		margin_multiplier float NULL,
		quantity float,
		contract_id int,
		product_id int, 
		product_qty float,
		currency_id int,
		currency_qty float,
		price float,
		value_date datetime,
		status_id int,
		margin float NULL,
		product_equiv float NULL,
		currency_equiv float NULL,
		external_account_type_id int NULL)

insert into
	#trades(
		trade_id,
		external_account_id,
		margin_multiplier,
		quantity,
		contract_id,
		product_id,
		product_qty,
		currency_id,
		currency_qty,
		price,
		value_date,
		status_id,
		margin)
select
	a.trade_id,
	a.external_account_id,
	c.margin_multiplier,
	a.quantity,
	a.contract_id,
	b.product_id,
	a.quantity,
	b.currency_id,
	a.quantity * price * -1.0,
	a.price,
	a.value_date,
	a.status_id,
	margin = 0.0
from
	trades a,
	forwards b,
	#external_accounts c,
	products d
where

 	a.contract_id = b.contract_id
and
	a.external_account_id = c.external_account_id
and
	b.product_id = d.product_id
and
	a.value_date > @end_date
and
	a.trade_date < @end_date

update
	#trades
set
	a.external_account_type_id = b.external_account_type_id
from
	#trades a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.prime_broker_id = b.prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin

update
	#trades
set
	a.margin = b.margin * a.margin_multiplier
from
	#trades a,
	product_margins b
where
	a.currency_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id
and
	b.margin > a.margin


update
	#trades
set
	a.quantity = a.quantity * -1.0,
	a.product_qty = a.product_qty * -1.0,
	a.currency_qty = a.currency_qty * -1.0
from
	#trades a,
	external_accounts b,
	external_account_types c
where
	a.external_account_id = b.external_account_id
and
	b.external_account_type_id = c.external_account_type_id
and
	c.name = "Client"


create table
	#conversion_rates(
		product_id int,
		rate float NULL)
insert into
	#conversion_rates(
		product_id)
select
	distinct(product_id)
from
	#trades
insert into
	#conversion_rates(
		product_id)
select
	distinct(currency_id)
from
	#trades
where
	currency_id not in(select product_id from #conversion_rates)

update
	#conversion_rates
set
	rate = 1.0
where
	product_id = @evaluation_currency_id

update
	#conversion_rates
set
	rate = c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	b.product_id = a.product_id
and
	b.currency_id = @evaluation_currency_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and 
	a.rate = NULL

update
	#conversion_rates
set
	rate = 1.0 / c.price
from
	#conversion_rates a,
	forwards b,
	bo_spot_settles c
where
	b.product_id = @evaluation_currency_id
and
	b.currency_id = a.product_id
and
	b.contract_id = c.contract_id
and
	convert(date, c.price_date) = convert(date, @end_date)
and
	a.rate = NULL

update
	#trades
set
	a.product_equiv = a.product_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#trades
set
	a.currency_equiv = a.currency_qty * b.rate
from
	#trades a,
	#conversion_rates b
where
	a.currency_id = b.product_id


create table
	#product_positions( 
		external_account_id int,
		product_id int,
		margin float,
		quantity float
		)
insert into
	#product_positions
select
	external_account_id,
	product_id,
	margin,	
	sum(product_qty)
from
	#trades
group by
	external_account_id,
	product_id,
	margin

insert into
	#product_positions
select
	external_account_id,
	currency_id,
	margin,
	sum(currency_qty)
from
	#trades
group by
	external_account_id,
	currency_id,
	margin

delete

from
	#product_positions
where
	quantity = 0.0


create table
	#net_positions(
		external_account_id int,
		product_id int,
		product varchar(50) NULL,
		margin float,
		quantity float, 
 		equiv float NULL,
		long_equiv float NULL,
		nop_long float NULL,
		short_equiv float NULL,
		nop_short float NULL
		)
insert into
	#net_positions(
		external_account_id,
		product_id,
		margin,
		quantity)
select
	external_account_id,
	product_id,
	margin,
	sum(quantity)
from
	#product_positions
group by
	external_account_id,
	product_id,
	margin

update
	#net_positions
set
	long_equiv = 0.0,
	short_equiv = 0.0

update
	#net_positions
set
	a.equiv = a.quantity * b.rate
from
	#net_positions a,
	#conversion_rates b
where
	a.product_id = b.product_id

update
	#net_positions
set
	long_equiv = equiv
where
	equiv > 0.0

update
	#net_positions
set
	short_equiv = equiv 
where
	equiv < 0.0

update
	#net_positions
set
	nop_long = long_equiv * margin,
	nop_short = abs(short_equiv) * margin

update
	#net_positions
set
	a.product = b.symbol
from
	#net_positions a,
	products b
where
	a.product_id = b.product_id



insert into
	credit_positions(
		external_account_id,
		product_id,
		balance,
		equiv,
		margin_rate,
		long_equiv,
		short_equiv,
		trade_date)
select
	external_account_id,
	product_id,
	quantity,
	equiv,
	margin,
	long_equiv,
	short_equiv,
	trade_date = @end_date
from
	#net_positions 




go
