
if object_id("r_editpbconversionrate") != NULL
    drop procedure
        r_editpbconversionrate
go

create procedure
	r_editpbconversionrate
		@prime_broker varchar(50),
		@symbol varchar(50),
		@price_date datetime,
		@price float
as

declare @contract_id int
declare @prime_broker_id int
declare @instrument varchar(50)
declare @pb_conversion_rate_id int
declare @price_style char(30)

select
	@price_date = convert(char(2), datepart(month, @price_date)) + "/" +
			convert(char(2), datepart(day, @price_date)) + "/" +
			convert(char(4), datepart(year, @price_date))

select
	@price_date = dateadd(hour, 17, @price_date)

select
	@contract_id = a.contract_id,
	@instrument = b.name
from
	contracts a,
	instruments b
where
	a.symbol = @symbol
and
	b.instrument_id = a.instrument_id
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding contract with symbol",	
		sybmol = @symbol
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id  = b.price_style_id
and
	b.contract_id = @contract_id
if @price_style = "Inverted"
begin
	/* We do not ever want to save a price for inverted contract */
        return
end

select
        @prime_broker_id = a.prime_broker_id
from
        prime_brokers a,
        sources b
where
        a.source_id = b.source_id
and
        b.name = @prime_broker
if @prime_broker_id = NULL
begin
        select
                status = "Error",
                message = "Prime Broker not found",
                prime_broker = @prime_broker
        return
end

select
	@pb_conversion_rate_id = pb_conversion_rate_id
from
	pb_conversion_rates
where
	price_date = @price_date
and
	contract_id = @contract_id
and
	prime_broker_id = @prime_broker_id
if @pb_conversion_rate_id != NULL
begin
	begin tran
		update
			pb_conversion_rates
		set
			price = @price
		where
			pb_conversion_rate_id = @pb_conversion_rate_id
		if @@rowcount != 1
		begin
			select
				id = -1,
				error = "Problem editing price"
			rollback tran
			return
		end
	commit tran
	select
		id = 0,
		msg = "Successfully edited pb conversion rate",
		pb = @prime_broker,
		symbol = @symbol,
		price_date = @price_date,
		price = @price
end
else
begin
	exec 
		j_nextkey 
			"pb_conversion_rates",
			@pb_conversion_rate_id output
	insert into
		pb_conversion_rates(
			pb_conversion_rate_id, 
			contract_id,
			prime_broker_id,
			price_date,
			price)
	values(
		@pb_conversion_rate_id,
		@contract_id,
		@prime_broker_id,
		@price_date,
		@price
	)
	if @@rowcount = 1
	begin
        	select
                	id = 0,
                	msg = "Successfully added pb conversion rate",
                	pb = @prime_broker,
                	symbol = @symbol,
                	price_date = @price_date,
                	price = @price
	end
end

go
