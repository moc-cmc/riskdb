use
	risk_admis

go

drop procedure
	ag_implyintrates
go

create procedure
	ag_implyintrates
		@login varchar(50),
		@price_date datetime,
		@contract varchar(50),
		@spot_rate float,
		@fwd_date1 datetime=NULL,
		@fwd_price1 float=NULL,
		@fwd_date2 datetime=NULL,
		@fwd_price2 float=NULL,
		@fwd_date3 datetime=NULL,
		@fwd_price3 float=NULL
as 


declare @fund_id int
declare @contract_id int
declare @price_style varchar(50)
declare @product_id int
declare @currency_id int
declare @evaluation_currency_id int
declare @inverted_contract_id int
declare @inverted_contract varchar(50)
declare @rate_date datetime
declare @product varchar(50)

declare @rate1 float
declare @rate2 float
declare @rate3 float
declare @days1 float
declare @days2 float
declare @days3 float

declare @product_rate_id int


/* call r_editesettle with the spot rate  at the end of this proc */

exec
	r_defaultfundforlogin
		@login = @login,
		@fund_id = @fund_id output


select
	@rate_date = convert(datetime, convert(date, @price_date))
select
	@rate_date = dateadd(hour, 17, @rate_date)

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @evaluation_currency_id = NULL
begin
	select
		status = "Error",
		message = "Evaluation currency not found"
	return
end


select
	@contract_id = contract_id
from
	contracts
where
	symbol = @contract
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		contract = @contract
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id

if @price_style = "Inverted"
begin
	select
		@spot_rate = 1.0 / @spot_rate,
		@fwd_price1 = 1.0 / @fwd_price1,
		@fwd_price2 = 1.0 / @fwd_price2,
		@fwd_price3 = 1.0 / @fwd_price3
end


select
	@product_id = product_id,
	@currency_id = currency_id
from
	forwards
where
	contract_id = @contract_id


if @currency_id = @evaluation_currency_id
begin
	exec
		x_impliedratefromforward
			@login = @login,
			@as_of = @price_date,
			@symbol = @contract,
			@spot_price = @spot_rate,
			@forward_date = @fwd_date1,
			@forward_price = @fwd_price1,
			@get_product_id = @product_id output,
			@get_product_rate = @rate1 output,
			@days = @days1 output


	exec
		x_impliedratefromforward
			@login = @login,
			@as_of = @price_date,
			@symbol = @contract,
			@spot_price = @spot_rate,
			@forward_date = @fwd_date2,
			@forward_price = @fwd_price2,
			@get_product_id = @product_id output,
			@get_product_rate = @rate2 output,
			@days = @days2 output


	exec
		x_impliedratefromforward
			@login = @login,
			@as_of = @price_date,
			@symbol = @contract,
			@spot_price = @spot_rate,
			@forward_date = @fwd_date3,
			@forward_price = @fwd_price3,
			@get_product_id = @product_id output,
			@get_product_rate = @rate3 output,
			@days = @days3 output

end

/*******************************************************/

if @product_id = @evaluation_currency_id
begin
	exec
		r_invertedcontract
			@contract_id = @contract_id,
			@inverted_contract_id = @inverted_contract_id output

	select
		@inverted_contract = symbol
	from
		contracts
	where
		contract_id = @inverted_contract_id


	select
		@spot_rate = 1.0 / @spot_rate,
		@fwd_price1 = 1.0 / @fwd_price1,
		@fwd_price2 = 1.0 / @fwd_price2,
		@fwd_price3 = 1.0 / @fwd_price3

	exec
		x_impliedratefromforward
			@login = @login,
			@as_of = @price_date,
			@symbol = @inverted_contract,
			@spot_price = @spot_rate,
			@forward_date = @fwd_date1,
			@forward_price = @fwd_price1,
			@get_product_id = @product_id output,
			@get_product_rate = @rate1 output,
			@days = @days1 output


	exec
		x_impliedratefromforward
			@login = @login,
			@as_of = @price_date,
			@symbol = @inverted_contract,
			@spot_price = @spot_rate,
			@forward_date = @fwd_date2,
			@forward_price = @fwd_price2,
			@get_product_id = @product_id output,
			@get_product_rate = @rate2 output,
			@days = @days2 output


	exec
		x_impliedratefromforward
			@login = @login,
			@as_of = @price_date,
			@symbol = @inverted_contract,
			@spot_price = @spot_rate,
			@forward_date = @fwd_date3,
			@forward_price = @fwd_price3,
			@get_product_id = @product_id output,
			@get_product_rate = @rate3 output,
			@days = @days3 output

end



/*******************************************************/

select
	@product = symbol
from
	products
where
	product_id = @product_id


select
	@product_rate_id = product_rate_id
from
	product_rates
where
	product_id = @product_id
and
	convert(date, rate_date) = convert(date, @rate_date)
if @product_rate_id != NULL
begin
	select
		status = "Dupe",
		message = "Rate curve already exists for product and date",
		product = @product,
		date = @rate_date
	return
end
		
exec
	j_nextkey
		"product_rates",
		@product_rate_id output

begin tran
	insert into
		product_rates(
			product_rate_id,
			product_id,
			rate_date)
	values(
		@product_rate_id,
		@product_id,
		@rate_date)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding product rate",
			product = @product,
			rate_date = @rate_date
		rollback tran
		return
	end

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
		@product_rate_id,
		@days1,
		@rate1)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding rate curve",
			product = @product,
			rate_date = @rate_date,
			days = @days1
		rollback tran
		return
	end

	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
		@product_rate_id,
		@days2,
		@rate2)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding rate curve",
			product = @product,
			rate_date = @rate_date,
			days = @days2
		rollback tran
		return
	end


	insert into
		product_rate_points(
			product_rate_id,
			days,
			rate)
	values(
		@product_rate_id,
		@days3,
		@rate3)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Problem adding rate curve",
			product = @product,
			rate_date = @rate_date,
			days = @days3
		rollback tran
		return
	end

commit tran

/* Debug  
select
	message = "Rate curve saved",
	product = @product,
	rate_date = @rate_date,
	days1 = @days1,
	rate1 = @rate1,
	days2 = @days2,
	rate2 = @rate2,
	days3 = @days3,
	rate3 = @rate3 
*/





