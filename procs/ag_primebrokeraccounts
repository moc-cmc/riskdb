
drop procedure
	ag_primebrokeraccounts
go

create procedure
	ag_primebrokeraccounts
		@login varchar(50),
		@prime_broker varchar(50)
as

declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"margin_schedule",
	"Margin Schedule",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"edit_multiplier",
	"Edit Margin Multiplier",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


select * from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


select
	style = @style,
	margin_schedule = "Return to Margin Schedule"

select
	section = @prime_broker,
	style = @style,
	account = a.symbol,
	multiplier = a.margin_multiplier,
	edit_multiplier = "EDIT"
from
	external_accounts a,
	external_account_prime_brokers b,
	prime_brokers c,
	sources d
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = c.prime_broker_id
and
	c.source_id = d.source_id
and
	d.name = @prime_broker
order by
	a.symbol


go
	

