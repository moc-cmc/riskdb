drop procedure
	ag_pbproductbalancetrades
go

create procedure
	ag_pbproductbalancetrades
		@login varchar(50),
		@account varchar(50),
		@symbol varchar(50),
		@value_date datetime
as

declare  @prime_broker varchar(50)

select
	@prime_broker = a.name
from
	sources a,
	prime_brokers b,
	external_accounts c
where
	a.source_id = b.source_id
and
	b.bo_external_account_id = c.external_account_id
and
	c.symbol = @account


create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"currency",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Format",
	"quantity",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	"#,##0.00000")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

insert into
        #meta
values (
        "Column Link",
        "back",
        "Settlement Recon",
        "login=" + @login + "&valueDate=" + convert(varchar(10), @value_date, 101) + "&primeBroker="+ @prime_broker)


select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

declare @external_account_id int
declare @prime_broker_id int


select
	style = "background:#FFFFFF;border: 1px solid white",
	back = "<< Back to Settlement Recon"

select
        @prime_broker_id = a.prime_broker_id
from
        prime_brokers a,
	external_accounts b
where
	a.bo_external_account_id = b.external_account_id
and
	b.name = @account
if @@rowcount = 0
begin
        select
                status = "Error",
                message = "Prime broker not found",
                prime_broker = @account
        return
end

