create table
        #pb_accounts(
                external_account_id int,
		name varchar(50))

insert into
        #pb_accounts
select
        a.external_account_id,
	a.name
from
        external_accounts a,
        external_account_prime_brokers b
where
        a.external_account_id = b.external_account_id
and
        b.prime_broker_id = @prime_broker_id

		
create table
	#contracts(
		contract_id int)
insert into
	#contracts
select
	a.contract_id
from
	forwards a,
	products b
where
	a.product_id = b.product_id
and
	b.symbol = @symbol

insert into
	#contracts
select
	a.contract_id
from
	forwards a,
	products b
where
	a.currency_id = b.product_id
and
	b.symbol = @symbol


create table
	#trades(
		trade_id int)
insert into
	#trades
select
	a.trade_id
from
	trades a,	
	#pb_accounts b,
	#contracts c
where
	a.external_account_id = b.external_account_id
and
	a.contract_id = c.contract_id
and
	convert(date, a.value_date) = convert(date, @value_date)

select
	section = "Maturing trades",
	style = "background:#FFFFFF;border: 1px solid white",
	a.trade_id,
	a.deal_id,
	a.trade_date, 
	trade_type = b.name,
	account = c.name,
	counterparty = d.name,
	a.quantity,
	e.symbol,
	a.value_date,
	a.price,
	trader = f.symbol,
	status = g.name
from
	trades a,
	trade_types b,
	#pb_accounts c,
	counterparties d,
	contracts e,
	traders f,
	statuses g,
	#trades h
where
	a.contract_id = e.contract_id
and
	a.trade_type_id = b.trade_type_id
and
	a.external_account_id = c.external_account_id
and
	a.counterparty_id = d.counterparty_id
and
	a.trader_id = f.trader_id
and
	a.status_id = g.status_id
and
	a.trade_id = h.trade_id
order by
	convert(date, a.trade_date),
	e.symbol


go

