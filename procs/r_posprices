
if object_id("r_posprices") != NULL
    drop procedure
        r_posprices
go
 
create procedure
	r_posprices
		@contract_id int,
		@begin_date datetime,
		@end_date datetime,
		@begin_price float output,
		@end_price float output
as

declare @begin_price_date datetime
declare @timestamp datetime
	
select
	@begin_price_date = max(price_date)
from
	prices
where
	price_date < @begin_date
and
	contract_id = @contract_id

select
	@begin_price = price
from
	prices
where
	contract_id = @contract_id
and
	price_date = @begin_price_date

select
	@timestamp = timestamp
from
	current_prices
where
	contract_id = @contract_id

select
	@end_price = price
from
	prices
where
	contract_id = @contract_id
and
	price_date = @end_date

if @end_price = NULL
begin
	if @end_date > @timestamp
		select
			@end_price = price
		from
			current_prices
		where
			contract_id = @contract_id
	else
		select
			@end_price = a.price
		from
			prices a,
			price_types b
		where
			a.price_type_id = b.price_type_id
		and
			b.name = "Close"
		and
			a.contract_id = @contract_id
		and
			a.price_date = (select
					max(a.price_date)
				from
					prices a,
					price_types b
				where
					a.price_type_id = b.price_type_id
				and
					b.name = "Close"
				and
					a.contract_id = @contract_id)
end
			
go
