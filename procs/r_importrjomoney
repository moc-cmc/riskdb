use
	risk_rcm
go

drop procedure
	r_importrjomoney
go

create procedure
	r_importrjomoney
		@login varchar(50), 	/* FIRM */
		@mfirm varchar(5), 	/* FIRM */
		@moffic varchar(10), 	/* OFFICE NUMBER */
		@mrr varchar(5),	/* SALESPERSON */
		@macct varchar(10), 	/* ACCOUNT NUMBER */
		@mclass varchar(5), 	/* ACCOUNT CLASS CODE */
		@msubcl varchar(5),	/* SUB-CLASS CODE */
		@matype varchar(5),	/* ACCOUNT TYPE */
		@mcurat varchar(5),	/* ACCOUNT TYPE CURRENCY SYMBOL */
		@mna1 varchar(200),	/* CUSTOMER NAME AND ADDRESS LINE 1 */
		@mdlact varchar(20),	/* DATE OF LAST ACTIVITY */
		@mrel10 varchar(5),	/* RELATED OFFICE NO. 1 */
		@mrel1a varchar(10),	/* RELATED ACCT. NO. 1 */
		@mbal	varchar(25),	/* ACCOUNT BALANCE */
		@mlmv varchar(25),	/* SECURITIES ON DEPOSIT */
		@mlov varchar(25),	/* LONG OPTION MARKET VALUE */
		@msov varchar(25),	/* SHORT OPTION MARKET VALUE */
		@mtc varchar(25),	/* TOTAL OUTSTANDING MARGIN CALLS */
		@mwf varchar(25),	/* WITHDRAWABLE FUNDS */
		@mfir varchar(25),	/* FUTURES-INITIAL MARGIN REQT */
		@mfmr varchar(25),	/* FUTURES-MAINTENANCE MARGIN REQT */
		@mme varchar(25),	/* MARGIN EXCESS/DEFICIT */
		@mote varchar(25),	/* FUTURES OPEN TRADE EQUITY */
		@mmtdc varchar(25),	/* MONT-TO-DATE COMMISSION */
		@meir varchar(25),	/* EQUITIES-INIT MARGIN REQT */
		@memr varchar(25),	/* EQUITIES-MAINT MARGIN REQT */
		@mcvtfb varchar(25),	/* CONVERSION RATE TO FIRM BASE CCY */
		@mlqval varchar(25),	/* LIQUIDATING VALUE */
		@munupl varchar(25),	/* UNSETTLED UNREALIZED P&L (FX) */
		@mtar varchar(25),	/* TOTAL ACCOUNT REQUIREMENTS */
		@mte varchar(25),	/* TOTAL EQUITY */
		@mtcc varchar(25),	/* TOTAL CURRENT CALLS */
		@mprbal varchar(25),	/* PREVIOUS ACCOUNT BALANCE */
		@mprote varchar(25),	/* PREVIOUS OPEN TRADE EQUITY */
		@mprte varchar(25),	/* PREVIOUS TOATL EQUITY */
		@mprlqv varchar(25)	/* PREVIOUS LIQUIDATING VALUE */,
		@row_date datetime=NULL,
		@row_count int,
		@row_index int
as


declare @trade_date datetime
declare @id int
declare @external_account_id int
declare @initial_margin float
declare @total_maint_margin float
declare @margin_excess float
declare @rjo_source_id int
declare @begin_balance float
declare @end_balance float
declare @transaction_type_id int
declare @account_transaction_id int
declare @fund_id int
declare @currency_id int
declare @tico_account_id int
declare @identifier varchar(50)
declare @deposits float
declare @withdrawals float
declare @interest float
declare @other_cash_activity float
declare @balance_adjustment float
declare @adjusted_balance float
declare @option_value float

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unknown login"
	return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id



if @row_date = NULL
begin
	select
		status = "Error",
		message = "Report date is not specified"
	return
end

select
	@trade_date = convert(datetime, convert(date, @row_date))


select
	@identifier = rtrim(convert(varchar(50), @trade_date, 1) ) + "-" + convert(varchar(50), @row_index)

select
	@rjo_source_id = source_id
from
	sources
where
	name = "RJO"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"sources",
			@rjo_source_id output

	insert into
		sources
	values(
		@rjo_source_id,
		"RJO",
		3)
	return
end

select
	@external_account_id = external_account_id
from
	external_account_symbols
where
	symbol = @macct
and
	source_id = @rjo_source_id
if @external_account_id = NULL
begin
	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @macct
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Account not found",
			account = @macct
		return
	end
end

select
	@id = id
from
	external_margin_transactions
where
	source_id = @rjo_source_id
and
	identifier = @identifier
if @id != NULL
begin
	select
		status = "Dupe",
		message = "Cash record already imported",
		identifier = @identifier
end
else
begin
	
	select
		@begin_balance = convert(float, @mprbal),
		@end_balance = convert(float, @mbal),
		@initial_margin = convert(float, @mfir),
		@total_maint_margin = convert(float, @mfmr),
		@margin_excess = convert(float, @mme),
		@deposits = 0.0,
		@withdrawals = 0.0,
		@interest = 0.0,
		@other_cash_activity = 0.0,
		@option_value = convert(float, @mlov) + convert(float, @msov)
		
	/* select
		@id = NULL
	exec
		j_nextkey
			"external_margin_transactions",
			@id output
	
	select
		@balance_adjustment = sum(amount)
	from
		account_transactions
	where
		external_account_id = @external_account_id
	and
		transaction_date <= @trade_date
	if @balance_adjustment = NULL
		select
			@balance_adjustment = 0.0
	
	select
		@adjusted_balance = @end_balance - @balance_adjustment
	
	if @adjusted_balance != 0
	begin
		select
			@transaction_type_id = NULL
		select
			@transaction_type_id = transaction_type_id
		from
			transaction_types
		where
			name = "Adjustment"
		if @transaction_type_id = NULL
		begin
			exec
				j_nextkey
					"transaction_types",
					@transaction_type_id output
		
			insert into
				transaction_types
			values(
				@transaction_type_id,
				"Adjustment",
				1)
		end
	
		select
			@account_transaction_id = NULL
		exec
			j_nextkey
				"account_transactions",
				@account_transaction_id output
		insert into
			account_transactions
		values(
			@account_transaction_id,
			@tico_account_id,
			@external_account_id,
			@transaction_type_id,
			@trade_date,
			@adjusted_balance,
			NULL,
			@currency_id)
	end TEST */
	
	
	/* insert into
		external_margin_transactions
	values(
		@id,
		@rjo_source_id,
		@identifier,
		@external_account_id,
		@trade_date,
		@initial_margin,
		@total_maint_margin,
		@margin_excess,
		@begin_balance,
		@end_balance,
		@option_value,
		@deposits + @withdrawals) TEST */
	
	
	
	select
		end_balance = @end_balance,
		initial_margin = @initial_margin,
		total_maint_margin = @total_maint_margin,
		margin_excess = @margin_excess
end
		
if @row_count = @row_index + 1
	select
		msg = "Found Last Line"
select
	@id = NULL
select
	@id = id
from
	rjo_cash_file
where
	identifier = @identifier
if @id != NULL
begin
	select
		id = @id,
		recorde_dupe = "record is saved already"
	return
end
else
insert into
	rjo_cash_file(
		trade_date,
		external_account_id,
		identifier,
		mfirm,
		moffic,
		mrr,
		macct,
		mclass,
		msubcl,
		matype,
		mcurat,
		mna1,
		mdlact,
		mrel10,
		mrel1a,
		mbal,
		mlmv,
		mlov,
		msov,
		mtc,
		mwf,
		mfir,
		mfmr,
		mme,
		mote,
		mmtdc,
		meir,
		memr,
		mcvtfb,
		mlqval,
		munupl,
		mtar,
		mte,
		mtcc,
		mprbal,
		mprote,
		mprte,
		mprlqv)
values(
	@trade_date,
	@external_account_id,
	@identifier,
	@mfirm,
	@moffic,
	@mrr,
	@macct,
	@mclass,
	@msubcl,
	@matype,
	@mcurat,
	@mna1,
	@mdlact,
	@mrel10,
	@mrel1a,
	@mbal,
	@mlmv,
	@mlov,
	@msov,
	@mtc,
	@mwf,
	@mfir,
	@mfmr,
	@mme,
	@mote,
	@mmtdc,
	@meir,
	@memr,
	@mcvtfb,
	@mlqval,
	@munupl,
	@mtar,
	@mte,
	@mtcc,
	@mprbal,
	@mprote,
	@mprte,
	@mprlqv)

go
