create table
	#report(
		id int identity,
		section varchar(200) NULL,
		style varchar(200) NULL,
		external_account_id int NULL,
		symbol varchar(200),
		reporting_type varchar(50) NULL,
		begin_balance float NULL,
		deposits float NULL,
		withdrawals float NULL,
		fees float NULL,
		fx_settlement float NULL,
		unrealized_pl float NULL,
		trading_volume float NULL,
		other float NULL,
		end_balance float NULL,
		change float NULL,
		total_equity float NULL)
insert into
	#report(
		section,
		style,
		external_account_id,
		symbol)
select
	section = "Accounts",
	style = "background:#FFFFFF;border: 1px solid white",
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
order by
	a.symbol

update
	#report
set
	begin_balance = 0.0,
	deposits = 0.0,
	withdrawals = 0.0,
	fees = 0.0,
	fx_settlement = 0.0,
	unrealized_pl = 0.0,
	trading_volume = 0.0,
	other = 0.0,
	end_balance = 0.0,
	change = 0.0,
	total_equity = 0.0


update
	#report
set
	reporting_type = "Uncategorized"

update
	#report
set
	a.reporting_type = c.name
from
	#report a,
	account_reporting_domains b,
	reporting_domains c
where
	a.external_account_id = b.external_account_id
and
	b.reporting_domain_id = c.reporting_domain_id
	
update
	#report
set
	a.begin_balance = b.equiv
from
	#report a,
	#begin_nets b
where
	a.external_account_id = b.external_account_id

update
	#report
set
	a.end_balance = b.equiv
from
	#report a,
	#end_nets b
where
	a.external_account_id = b.external_account_id

update
	#report
set
	a.deposits = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Deposit"

update
	#report
set
	a.withdrawals = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Withdrawal"

update
	#report
set
	a.fees = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Fees/Commissions/Brokerage"

update
	#report
set
	a.fx_settlement = b.equiv
from
	#report a,
	#net_trans b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "FX Settlemenet"

update
	#report
set
	other = end_balance - (begin_balance + deposits + withdrawals + fees + fx_settlement),
	total_equity = end_balance + unrealized_pl

update
	#report
set
	a.trading_volume = b.equiv
from
	#report a,
	#net_snapshots b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Trading Volume"

update
	#report
set
	a.unrealized_pl = b.value
from
	#report a,
	#account_snapshots b,
	transaction_types c
where
	a.external_account_id = b.external_account_id
and
	b.transaction_type_id = c.transaction_type_id
and
	c.name = "Unrealized P&L"
and
	convert(date, b.snapshot_date) = convert(date, @end_date)

create table
	#by_reporting_type(
		id int identity,
		section varchar(200) NULL,
		style varchar(200) NULL,
		account_category varchar(50) NULL,
		begin_balance float NULL,
		deposits float NULL,
		withdrawals float NULL,
		fees float NULL,
		fx_settlement float NULL,
		unrealized_pl float NULL,
		trading_volume float NULL,
		other float NULL,
		end_balance float NULL,
		change float NULL,
		total_equity float NULL)
insert into
	#by_reporting_type(
		account_category,
		begin_balance,
		deposits,
		withdrawals,
		fees,
		fx_settlement,
		unrealized_pl,
		trading_volume,
		other,
		end_balance,
		change,
		total_equity)
select
	reporting_type,
	sum(begin_balance),
	sum(deposits),
	sum(withdrawals),
	sum(fees),
	sum(fx_settlement),
	sum(unrealized_pl),
	sum(trading_volume),
	sum(other),
	sum(end_balance),
	sum(change),
	sum(total_equity)
from
	#report
group by
	reporting_type

update
	#by_reporting_type
set
	section = "Totals By Account Category",
	style = "background:#FFFFFF;border: 1px solid white"


select
	section = "Account Summary Run",
	style = "background:#FFFFFF;border: 1px solid white",
	run_name = @run_name,
	begin_date = @begin_date,
	end_date = @end_date

select
	section,
	style,
	account = symbol,
	reporting_type,
	account_type = reporting_type,
	begin_balance,
	deposits,
	withdrawals,
	fees,
	fx_settlement,
	other,
	cash_balance = end_balance,
	unrealized_pl,
	total_equity,
	trading_volume
from
	#report
order by
	id

select
	section,
	style,
	account_category,
	begin_balance,
	deposits,
	withdrawals,
	fees,
	fx_settlement,
	unrealized_pl,
	trading_volume,
	other,
	cash_balance = end_balance,
	unrealized_pl,
	total_equity,
	trading_volume
from
	#by_reporting_type
order by
	id


