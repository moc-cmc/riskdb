create table
	#account_snapshots(
		account_snapshot_id int,
		external_account_id int,
		transaction_type_id int,
		value float,
		currency_id int,
		snapshot_date datetime,
		note varchar(200) NULL,
		equiv float NULL)
insert into
	#account_snapshots(
		account_snapshot_id,
		external_account_id,
		transaction_type_id,
		value,
		currency_id,
		snapshot_date,
		note)
select
	a.account_snapshot_id,
	a.external_account_id,
	a.transaction_type_id,
	a.value,
	a.currency_id,
	a.snapshot_date,
	a.note
from
	account_snapshots a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.snapshot_date >= @begin_date
and
	a.snapshot_date <= @end_date
	

create table
	#account_transactions(
		account_transaction_id int,
		entered_by int,
		external_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		currency_id int,
		amount float,
		note varchar(255) NULL,
		equiv float NULL)
insert into
	#account_transactions(
		account_transaction_id,
		entered_by,
		external_account_id,
		transaction_type_id,
		transaction_date,
		currency_id,
		amount,
		note)
select
	a.account_transaction_id,
	a.entered_by,
	a.external_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.currency_id,
	a.amount,
	a.note
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date >= @begin_date
and
	a.transaction_date <= @end_date


create table
	#begin_balances(
		external_account_id int,
		currency_id int,
		begin_balance float,
		equiv float NULL)
insert into
	#begin_balances(
		external_account_id,
		currency_id,
		begin_balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date < @begin_date
group by
	a.external_account_id,
	a.currency_id

create table
	#end_balances(
		external_account_id int,
		currency_id int,
		end_balance float,
		equiv float NULL)
insert into
	#end_balances(
		external_account_id,
		currency_id,
		end_balance)
select
	a.external_account_id,
	a.currency_id,
	sum(a.amount)
from
	account_transactions a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_date <= @end_date
group by
	a.external_account_id,
	a.currency_id


