		strategy_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		strategy_id != NULL
	if @@rowcount = 0
		insert into
			#strategies(
				strategy_id)
		select
			strategy_id
		from
			strategies

	insert into
		#external_accounts(
			external_account_id)
	select
		external_account_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		external_account_id != NULL
	if @@rowcount = 0
		insert into 
			#external_accounts(
				external_account_id)
