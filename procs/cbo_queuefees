	insert into
		#counterparties(
			counterparty_id)
	select
		counterparty_id
	from
		fee_schedules
	where
		fee_schedule_id = @fee_schedule_id
	and
		counterparty_id != NULL
	if @@rowcount = 0
		insert into
			#counterparties(
				counterparty_id)
		select
			counterparty_id
		from
			counterparties

        insert into
                #trade_types(
                        trade_type_id)
        select
                trade_type_id
        from
                fee_schedules
        where
                fee_schedule_id = @fee_schedule_id
        and
                trade_type_id != NULL
        if @@rowcount = 0
                insert into
                        #trade_types(
                                trade_type_id)
                select 
                        trade_type_id
                from
                        trade_types

        insert into
                #statuses(
                        status_id)
        select
                status_id
        from
                fee_schedules
        where
                fee_schedule_id = @fee_schedule_id
        and
                status_id != NULL
        if @@rowcount = 0
                insert into
                        #statuses(
                                status_id)
                select 
                        status_id
                from
                        statuses
                where
			name != "Resid"


	truncate table
		#ids

	insert into
		#ids(
			trade_id)
	select
		b.trade_id
	from
		trades b,
		#traders d,
		#strategies e,
		#external_accounts f,
		#internal_accounts g,
		#brokers h,
		#counterparties i,
		#trade_types j,
		#statuses k
	where
		b.trader_id = d.trader_id
	and
		b.strategy_id = e.strategy_id
	and
		b.external_account_id = f.external_account_id
	and
		b.internal_account_id = g.internal_account_id
	and
		b.broker_id = h.broker_id
	and
		b.counterparty_id = i.counterparty_id
	and
		b.trade_type_id = j.trade_type_id
	and
		b.status_id = k.status_id
	and
		b.trade_date >= @begin_date
	and
		b.trade_date < @end_date
		

	update
		#ids
	set
		a.volume = b.volume
	from
		#ids a,
		trade_volumes b
	where
		a.trade_id = b.trade_id
	and
		convert(date, b.volume_date) = convert(date, @end_date)
	and
		b.product_id = @evaluation_currency_id

	select
		@volume = NULL,
		@tickets = NULL

