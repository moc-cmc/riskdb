insert into
	#fee_schedules(
		style,
		fee_schedule_id,
		fee_type_id,
		name,
		debit_acct_id,
		credit_acct_id,
		description,
		schedule,
		rate,
		currency,
		activity_date)
select
	style = @style,
	a.fee_schedule_id,
	a.fee_type_id,
	a.name,
	a.book_to_ext_account_id,
	a.credit_ext_account_id,
	a.description,
	schedule = b.name,
	a.fee_price,
	currency = c.symbol,
	activity_date = @trade_date	
from
	fee_schedules a,
	fee_schedule_types b,
	products c
where
	a.fee_schedule_type_id = b.fee_schedule_type_id
and
	a.fee_product_id = c.product_id
order by
	a.name

update
	#fee_schedules
set
	a.prime_broker_id = b.prime_broker_id
from
	#fee_schedules a,
	external_account_prime_brokers b
where
	a.debit_acct_id = b.external_account_id

update
	#fee_schedules
set
	a.recon_account = c.symbol
from
	#fee_schedules a,
	prime_brokers b,
	external_accounts c
where
	a.prime_broker_id = b.prime_broker_id
and
	b.bo_external_account_id = c.external_account_id

update
	#fee_schedules
set
