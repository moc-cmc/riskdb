create table
	#transaction_types(
		transaction_type_id int)
insert into
	#transaction_types(
		transaction_type_id)
select
	distinct(a.transaction_type_id)
from
	transaction_types a,
	#fee_schedules b
where
	/* not using name of fee schedule for transaction type */
	/* a.name = b.name*/
        a.transaction_type_id = b.fee_type_id

create table
	#booked_fees(
		id int identity,
		style varchar(250) NULL,
		account_transaction_id int NULL,
		external_account varchar(50) NULL,
		transaction_type varchar(50) NULL,
		transaction_date datetime NULL,
		currency varchar(50) NULL,
		amount float NULL,
		note varchar(250) NULL)
insert into
	#booked_fees(
		style,
		account_transaction_id,
		external_account,
		transaction_type,
		transaction_date,
		currency,
		amount,
		note)
select
	style = @style,
	a.account_transaction_id,
	external_account = b.symbol,
	transaction_type = c.name,
	a.transaction_date,
	currency = d.symbol,
	a.amount,
	a.note
from
	account_transactions a,
	external_accounts b,
	transaction_types c,
	products d,
	#transaction_types e
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.transaction_type_id = e.transaction_type_id
and
	c.transaction_type_id = e.transaction_type_id
and
	a.currency_id = d.product_id
and
	convert(date, a.transaction_date) = convert(date, @end_date)
order by
	c.name,
	d.symbol
	
	
update
	#fee_schedules
set
	fee = (volume / 1000000) * rate
where
	schedule = "Volume"

update
	#fee_schedules
set
	fee = tickets * rate
where
	schedule = "Ticket Count"

select
	@volume = NULL,
	@tickets = NULL
select
	@volume = sum(volume),
	@tickets = sum(tickets)
from
	#fee_schedules

select
	@id = 0
select
	@ids = count(*)
from
	#fee_schedules
where
	id > @id

delete

from
	queued_fees
where
	tico_account_id = @tico_account_id
and
	convert(date, transaction_date) = convert(date, @end_date)

select
	@transaction_date = convert(date,  @end_date)

while @ids > 0
begin
	select
		@id = min(id)
	from
		#fee_schedules
	where
		id > @id

	select
		@queued_fee_id = NULL,
		@external_account_id = NULL,
		@currency_id = NULL,
		@amount = NULL,
		@transaction_type_id = NULL,
		@credit_account = NULL

	exec
		j_nextkey
			"queued_fees",
			@queued_fee_id output
	select
		@external_account_id = a.debit_acct_id,
		@amount = a.fee * -1.0,
		@currency_id = b.product_id,
		@transaction_type_id = c.transaction_type_id
	from
		#fee_schedules a,
		products b,
		transaction_types c
	where
		a.currency = b.symbol
	and
		/* not using fee schedule nme as the transaction_type */
		/* a.name = c.name */
		a.fee_type_id = c.transaction_type_id
	and
		id = @id
	
	if abs(@amount) >= 0.01
	begin
		insert into
			queued_fees(
				queued_fee_id,
				tico_account_id,
				transaction_date,
				transaction_type_id,
				external_account_id,
				currency_id,
				amount)
		values(
			@queued_fee_id,
			@tico_account_id,
			@transaction_date,
			@transaction_type_id,
			@external_account_id,
			@currency_id,
			@amount)
	end

	select
		@credit_account = credit_to
	from
		#fee_schedules
	where
		id = @id

	if @credit_account != NULL
	begin
		select
			@queued_fee_id = NULL,
			@external_account_id = NULL

		exec
			j_nextkey
				"queued_fees",
				@queued_fee_id output
		select
			@external_account_id = external_account_id
		from
			external_accounts
		where
			symbol = @credit_account

		select
			@amount = abs(@amount)

		if abs(@amount) >= 0.01
		begin
			insert into
				queued_fees(
					queued_fee_id,
					tico_account_id,
					transaction_date,
					transaction_type_id,
					external_account_id,
					currency_id,
					amount)
			values(
				@queued_fee_id,
				@tico_account_id,
				@transaction_date,
				@transaction_type_id,
				@external_account_id,
				@currency_id,
				@amount)
		end
	end


	select
		@ids = count(*)
	from
		#fee_schedules
	where
		id > @id
end

update
	queued_fees
set
	a.account_transaction_id = b.account_transaction_id,
	a.booked_amount = b.amount
from
	queued_fees a,
	account_transactions b
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = b.transaction_type_id
and
	convert(date, a.transaction_date) = convert(date, b.transaction_date)
and
	a.tico_account_id = @tico_account_id

update
	queued_fees
set
	match_status = "New"
where
	account_transaction_id = NULL

update
	queued_fees
set
	match_status = "Booked and Matched"
where
	round(amount, 2) = round(booked_amount, 2)

update
	queued_fees
set
	match_status = "Mismatch",
	style = @error_style
where
	round(amount, 2) != round(booked_amount, 2)
and
	account_transaction_id != NULL


