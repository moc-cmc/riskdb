	select
		@tickets = count(trade_id)
	from
		#ids
	if @tickets = NULL
		select
			@tickets = 0.0

	update
		#fee_schedules
	set
		volume = @volume,
		tickets = @tickets
	where
		fee_schedule_id = @fee_schedule_id

	select
		@ids = count(*)
	from
		#fee_schedules
	where
		id > @id
