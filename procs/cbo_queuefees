select
	section = "Queued Fees",
	style = @style,
	account = b.symbol,
	a.transaction_date,
	transaction_type = c.name,
	a.amount,
	currency = d.symbol,
	a.account_transaction_id,
	a.booked_amount,
	a.match_status
from
	queued_fees a,
	external_accounts b,
	transaction_types c,
	products d
where
	a.external_account_id = b.external_account_id
and
	a.transaction_type_id = c.transaction_type_id
and
	a.currency_id = d.product_id
and
	tico_account_id = @tico_account_id
and
	convert(date, transaction_date) = convert(date, @end_date)
and
	a.match_status = "New"
if @@rowcount > 0
	select
		book_fees = "Book Queued Fees",
		transaction_date = @trade_date

-- end comment out of fee dislay*/




go

