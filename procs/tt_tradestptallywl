drop procedure tt_tradestptallywl
go

create procedure
	tt_tradestptallywl
       		@source varchar(50),
		@broker varchar(50)=NULL,
		@default_login varchar(50), 
		@sender_comp varchar(50),
		@target_comp varchar(50),
		@sender_sub varchar(50),
		@target_sub varchar(50),
		@on_behalf_of_comp varchar(50),
		@client_id varchar(50),
		@account varchar(50),
		@trade_date datetime,
		@trading_day datetime,
		@order_status varchar(10)=NULL,
		@order_id varchar(100),
		@execution_id varchar(100),
		@secondary_exec_id varchar(100),
		@symbol varchar(50),
		@currency varchar(10),
		@value_date datetime,
		@far_value_date datetime=NULL,
		@side varchar(10),
		@quantity numeric(30, 4),
		@price float,
		@last_spot_rate float=NULL,
		@last_forward_points float=NULL



as

declare @suppress_trade char(1)
declare @committed_status_id int
declare @external_account_id int
declare @external_account_type varchar(25)
declare @aggregation_style_id int
declare @aggregation_style varchar(25)
declare @fund_agency_trader varchar(1)

declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @counterparty varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int
declare @clvcl_counterparty varchar(50)

declare @lookup_cpty varchar(50)
declare @lookup_trdr varchar(50)
declare @broker_id int
declare @source_id int
declare @client_or_market char(1)
declare @user varchar(50)
declare @user_account_id int 
declare @sales_code_id int

declare @is_obo_trade char(1)


declare @tallied_trade_id int
declare @tallied_cpty_id int

declare @ccy1 char(3)
declare @cancel_trade_id int
declare @cancel_identifier varchar(50)

declare @trade_status varchar(50)
declare @cr_deal_exec_symbol varchar(100)
declare @cr_deal_id int
declare @cr_deal_status_id int
declare @cr_deal_type_id int
declare @cancel_ref varchar(100)

select @ccy1 = @currency

declare @trigger_symbol varchar(50)
declare @cl_create char(1)
declare @lp_create char(1)

declare @auto_b2b_deal_status_id int
declare @auto_b2b_deal_type_id int
declare @auto_b2b_deal_id int


if @broker = NULL
        select
                @broker = "Markit "+@sender_sub

/*
 * VERIFY @broker exist and check for dupe
 */
select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @@rowcount != 1
begin
        select
                "error"="Error",
                "msg"="Broker not found",
                "broker"=@broker
        return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
        select
                "error"="Error",
                "msg"="Source not found",
                "source"=@source
        return
end

	


select
       	@lookup_cpty = @client_id,
       	@lookup_trdr = @account,
       	@deal_type = "Market Forward",
       	@deal_exec_symbol = rtrim(@order_id)+convert(char(8), @trading_day, 112),
	@trade_identifier = rtrim(@broker) + rtrim(@execution_id)



select
	@suppress_trade = "N"

	
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end


select 
	@counterparty = b.name,
	@counterparty_id = b.counterparty_id
from
	counterparty_symbols a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id 
and
	a.source_id = @source_id
and
	a.symbol = @lookup_cpty
if @counterparty = NULL
begin
	select
		@counterparty = name,
		@counterparty_id = counterparty_id
	from
		counterparties
	where
		name = @lookup_cpty
	if @counterparty = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find counterparty for market trade with @lookup_cpty, '" + @lookup_cpty + "'",	
			lookup_cpty = @lookup_cpty
		return
	end
end

select
	@trader_id = a.trader_id,
	@trader = a.symbol,
	@user_account_id = a.tico_account_id,
	@sales_code_id = a.sales_code_id
from
	traders a,
	trader_symbols b
where
	a.trader_id = b.trader_id
and
	b.source_id = @source_id
and
	b.symbol = @lookup_trdr

if @trader = NULL
begin
	select
		@trader_id = a.trader_id,
		@trader = a.symbol,
		@user_account_id = a.tico_account_id,
		@sales_code_id = a.sales_code_id
	from
		traders a
	where
		a.symbol = @lookup_trdr
	if @trader = NULL
	begin
		select
			status = "Error",
			message = "Couldn't find trader and user for @lookup_trdr, '" + @lookup_trdr + "'",
			lookup_trdr = @lookup_trdr,
			trader = @trader
		return
	end
end

select
	@user = login
from
	tico_accounts
where
	account_id = @user_account_id
if @user = NULL
begin
	select 
		status = "Error",
		message = "Problem determining login from trader",
		trader = @trader
	return
end


select
	@client_or_market = "C"
from
	fund_agency_counterparties
where
	counterparty_id = @counterparty_id

if @client_or_market != "C"
	select
		@client_or_market = "M"


if @client_or_market = "M"
begin
	/*
        * CHECK FOR SUPPRESSION
        */
        select
                @suppress_trade = "Y"
        from
                suppression_symbols
        where
                source_id = @source_id
        and
                symbol = @lookup_cpty

	/*
        * CHECK to see if this requires a manufactured B2B
        */

        select
                @cl_create = cl_create,
                @lp_create = lp_create
        from
                ticket_creation_values
        where
                trigger_symbol = @lookup_cpty
        and
                source_id = @source_id
        if @@rowcount != 0
        begin
                select
                        @trigger_symbol = @lookup_cpty
        end

	
	select
		@external_account = a.symbol,
		@external_account_id = a.external_account_id
	from
		external_accounts a,
		counterparties b
	where
		a.external_account_id = b.external_account_id
	and
		b.name = @counterparty
	if @external_account = NULL
	begin
        	select
                    		status = "Error",
                      		message = "Couldn't find market account for @external_account from @counterparty, '" + @counterparty + "'",
                      		trader = @counterparty
              		return
	end
end
else if @client_or_market = "C"
begin
	 /*
        * CHECK FOR SUPPRESSION
        */

        select
                @suppress_trade = "Y"
        from
                suppression_symbols
        where
                source_id = @source_id
        and
                symbol = @lookup_trdr

	/* Set deal to B2B since it has a client trade */
	 select
                @deal_type = "B2B Forward"

	/*
        * CHECK to see if this requires a manufactured B2B
        */

        select
                @cl_create = cl_create,
                @lp_create = lp_create
        from
                ticket_creation_values
        where
                trigger_symbol = @lookup_trdr
        and
                source_id = @source_id
        if @@rowcount != 0
        begin
                select
                        @trigger_symbol = @lookup_trdr
        end


	select
		@external_account = a.symbol,
		@external_account_id = a.external_account_id
	from
		external_accounts a,
		traders b
	where
		a.external_account_id = b.external_account_id
	and
		b.trader_id = @trader_id
	if @external_account = NULL
	begin
	        select
                     	status = "Error",
                       	message = "Couldn't find client account for @external_account from @trader, '" + @trader + "'",
                       	trader = @trader
               	return
	end
end
else
begin
        select
                status = "Error",
                message = "Couldn't detemine client or market",
		client_or_market = @client_or_market,
		client_id = @client_id,
		account = @account
        return
end



/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Couldn't find external_account from @external_account_id",
		external_account_id = @external_account_id
	return
end


select
	@trade_type = "Spot"
	
if @last_forward_points != 0 and @last_forward_points != NULL
begin
	select
		@trade_type = "Forward"
end

if @side = "SELL"
begin
	select
		@quantity = -@quantity
end

if @client_or_market = "C"
begin
    select
        @quantity = -@quantity
end


select
        lookup_cpty = @lookup_cpty,
        lookup_trdr = @lookup_trdr,
	client_or_mkt = @client_or_market


declare @ccy1_determined char(3)
declare @ccy2_determined char(3)

select
        @ccy1_determined = substring(@symbol, 1, 3),
        @ccy2_determined = substring(@symbol, 4, 6)


/*
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 */
if @ccy1 != NULL and @ccy2_determined = @ccy1 
begin
    select
        @symbol = @ccy2_determined + @ccy1_determined,
        @inverted = "Y"
end

if not exists(select contract_id from contracts where symbol = @symbol)
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int
	declare @true_ccy1 char(3)
	declare @true_ccy2 char(3)

	/* re-determine ccy1 & ccy2 because we may have changed the sybol above */ 
	select
        	@true_ccy1 = substring(@symbol, 1, 3),
        	@true_ccy2 = substring(@symbol, 4, 6)


        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @true_ccy1,
                	@true_ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end


if @deal_id = NULL
begin
	select
		@deal_id = deal_id
	from
		deal_exec_symbols
	where
		symbol = @deal_exec_symbol
end

if @deal_id = NULL
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    )
end
else
begin
	select
		msg = "Appending to existing deal"
end
	
/*	
if @trade_status = NULL
begin
	select
		@trade_status = "User Review"
end
*/

if @suppress_trade = "Y" 
begin
	select "Suppressing trade"
end
else
begin
	exec
		fxa_tallytrade
			@login = @user,
			@source = @source,
			@trade_id = @trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @trade_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@quantity = @quantity,
			@symbol = @symbol,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @trader,
			@broker = @broker,
			@identifier = @trade_identifier,
			@spot_reference = @last_spot_rate,
			@status = @trade_status

	if @trade_id = NULL
	begin
		select
			status = "Error",
			message = "Failed to tally trade"
		return
	end

	exec
		r_inserttradenotification
					@trade_id
end

if @cl_create = "Y" or @lp_create = "Y"
begin
	if @cl_create = "Y"
	begin
		declare @t2_cl_ext_account varchar(50)
		declare @t2_cl_trader varchar(50)
		declare @t2_cl_counterparty varchar(50)
		declare @t2_cl_trade_id int
		declare @t2_cl_identifier varchar(100)
		declare @t2_cl_quantity numeric(30, 4)
		declare @t2_cl_inv_qty char(1)
			
		select
			@t2_cl_ext_account = cl_ext_account,
			@t2_cl_trader = cl_trader,
			@t2_cl_counterparty = cl_counterparty,
			@t2_cl_inv_qty = cl_inv_qty
		from
			ticket_creation_values
		where
	        	trigger_symbol = @trigger_symbol

		select
			@t2_cl_identifier = rtrim(@trade_identifier)+".t2cl_autob2b",
                       	@t2_cl_quantity = @quantity

			
		if @t2_cl_inv_qty = "Y"
		begin
			select
				@t2_cl_quantity = -@quantity 
		end

		exec
			fxa_tallytrade
				@login = @user,
				@source = @source,
				@trade_id = @t2_cl_trade_id out,
				@deal_id = @deal_id out,
				@tally_type = @trade_type,
				@deal_type = @deal_type,
				@trade_type = @trade_type,
				@external_account = @t2_cl_ext_account,
				@counterparty = @t2_cl_counterparty,
				@quantity = @t2_cl_quantity,
				@symbol = @symbol,
				@value_date = @value_date,
				@price = @price,
				@trade_date = @trade_date,
				@trader = @t2_cl_trader,
				@broker = @broker,
				@identifier = @t2_cl_identifier,
				@spot_reference = @last_spot_rate


		if @t2_cl_trade_id = NULL
		begin
    			select
       				status = "Error",
       				message = "Failed to tally trade"
    			return
		end
	

		exec
   				r_inserttradenotification
       				@t2_cl_trade_id

		select
       			status = "Tallied",
       			message = "Trade successfully tallied",
       			trade_id = @t2_cl_trade_id,
       			deal_id = @deal_id,
       			account = @t2_cl_ext_account,
       			symbol = @symbol,
       			quantity = @t2_cl_quantity,
       			price = @price,
       			val_date = @value_date
 
		

	end
	if @lp_create = "Y"
	begin
        	declare @t2_lp_ext_account varchar(50)
               	declare @t2_lp_trader varchar(50)
               	declare @t2_lp_counterparty varchar(50)
               	declare @t2_lp_trade_id int
               	declare @t2_lp_identifier varchar(100)
               	declare @t2_lp_quantity numeric(30, 4)
		declare @t2_lp_inv_qty char(1)
                declare @t2_deal_id int

               	select
                       	@t2_lp_ext_account = lp_ext_account,
                       	@t2_lp_trader = lp_trader,
                       	@t2_lp_counterparty = lp_counterparty,
			@t2_lp_inv_qty = lp_inv_qty
               	from
                       	ticket_creation_values
               	where
                       	trigger_symbol = @trigger_symbol

               	select
                       	@t2_lp_identifier = rtrim(@trade_identifier)+".t2lp_autob2b",
			@t2_lp_quantity = @quantity

               	if @t2_lp_inv_qty = "Y"
               	begin
                       	select
                               	@t2_lp_quantity = -@quantity
               	end
		
		if @cl_create = "Y"
		begin
			select
				@t2_deal_id = @auto_b2b_deal_id
		end
		else
		begin
			select
				@t2_deal_id = @deal_id
		end
               	exec
                       	fxa_tallytrade
                               	@login = @user,
                               	@source = @source,
                               	@trade_id = @t2_lp_trade_id out,
                               	@deal_id = @t2_deal_id out,
                               	@tally_type = @trade_type,
                               	@deal_type = @deal_type,
                               	@trade_type = @trade_type,
                               	@external_account = @t2_lp_ext_account,
                               	@counterparty = @t2_lp_counterparty,
                               	@quantity = @t2_lp_quantity,
                               	@symbol = @symbol,
                               	@value_date = @value_date,
                               	@price = @price,
                               	@trade_date = @trade_date,
                               	@trader = @t2_lp_trader,
                               	@broker = @broker,
                               	@identifier = @t2_lp_identifier,
                               	@spot_reference = @last_spot_rate


               	if @t2_lp_trade_id = NULL
               	begin
                       	select
                               	status = "Error",
                               	message = "Failed to tally trade"
                       	return
               	end


               	exec
                       	r_inserttradenotification
                               	@t2_lp_trade_id

               	select
                       	status = "Tallied",
                       	message = "Trade successfully tallied",
                       	trade_id = @t2_lp_trade_id,
                       	deal_id = @t2_deal_id,
                       	account = @t2_lp_ext_account,
                       	symbol = @symbol,
                       	quantity = @t2_lp_quantity,
                       	price = @price,
                       	val_date = @value_date
	
	end
end



/* 
 * AUTOCOMMIT
 *
 * If there is a client trade in this deal and the account type is set for
 * Autocommit, then push through this deal automatically.
 */
if @deal_id != NULL and @client_or_market = "C" and @aggregation_style = "Autocommit"
begin

    update
        deals
    set
        status_id = @committed_status_id
    where
        deal_id = @deal_id
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    end
end
else
begin
    select
        message = "No autocommitted",
        deal_id = @deal_id,
        trade_id = @trade_id,
        aggregation_style = @aggregation_style
end

select
	status = "Tallied",
	message = "Trade successfully tallied",
    	trade_id = @trade_id,
    	deal_id = @deal_id,
	account = @external_account,
	trader = @trader,
	counterparty = @counterparty,
	symbol = @symbol,
	side = @side,
	quantity = @quantity,
	price = @price,
	val_date = @value_date,
	trade_status = @trade_status

go
