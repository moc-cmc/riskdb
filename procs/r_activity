
drop procedure r_activity
go

create procedure
	r_activity
		@login varchar(50),
		@run_name varchar(50)=NULL,
		@trade_date datetime=NULL

as

declare @thirty_days_ago datetime
declare @begin_date datetime
declare @end_date datetime
declare @last_commit_date datetime
declare @cl_total_attrib_pl float
declare @lp_total_attrib_pl float
declare @error_style varchar(200)
declare @total_style varchar(200)
declare @style varchar(200)
declare @selected_style varchar(200)
declare @subtotal_style varchar(200)
declare @total_pl float
declare @total_volume float
declare @total_trade_count int
declare @total_avg_size float
declare @total_mm_pl float
declare @fund_name varchar(50)
declare @using_ticking_price char(1)
declare @run_id int
declare @fund_id int

declare @debug char(1)
select
	@debug = "N"



create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)


insert into
	#meta
values(
	"Column Format",
	"volume",
	"Number",
	 "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

/* MARKR insert into
        #meta
values(
        "Column Format",
        "trend_volume",
        "Number",
	"#,##0.00%") */

insert into
        #meta
values(
        "Column Format",
        "trend_volume",
        "Number",
	"#,##0.00%;<span style=""color:red"">(#,##0.00%)</span>")

insert into
        #meta
values(
        "Column Format",
        "vs_avg_pl",
        "Number",
	"#,##0.00%;<span style=""color:red"">(#,##0.00%)</span>")


insert into
        #meta
values(
        "Column Format",
        "avg_pl",
        "Number",
         "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
        #meta
values(
        "Column Format",
        "pl",
        "Number",
         "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
        #meta
values(
        "Column Format",
        "mm_pl",
        "Number",
         "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")

insert into
        #meta
values(
        "Column Format",
        "avg_size",
        "Number",
         "#,##0.00;<span style=""color:red"">(#,##0.00)</span>")



select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@fund_name = name
from
	funds
where
	fund_id = @fund_id

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	/*@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",*/
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


/* Find the last commit that is done*/
select
       @last_commit_date = max(commit_date)
from
       daily_commits a,
       commit_statuses b
where
       a.commit_status_id = b.commit_status_id
and
       b.name in("Commit Complete")
if @last_commit_date = NULL
begin
	select
		@last_commit_date = "January 01, 1970"
end

if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

select
	@trade_date = convert(date, @trade_date)

exec
	r_daterangefordate 
		@trade_date,
		@begin_date output,
		@end_date output

select
	@thirty_days_ago = dateadd(day, -30, @begin_date)

select
	@run_id = a.run_id
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		section = "Error",
		error = "Problem finding run with name",
		run = @run_name,
		style = @error_style
	return
end


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies
end

create table
	#external_accounts(
		external_account_id int,
		pb_id int NULL)
insert into
	#external_accounts(
		external_account_id
)
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
        	#external_accounts(
			external_account_id
		)
	select
        	external_account_id
	from
        	external_accounts
end

update 
	#external_accounts
set
	a.pb_id = b.prime_broker_id
from
	#external_accounts a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select
	internal_account_id
from
	run_internal_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#internal_accounts
	select
		internal_account_id
	from
		internal_accounts
create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

create table
	#counterparties(
		counterparty_id int)

insert into
	#counterparties
select
	counterparty_id
from
	run_counterparties
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#counterparties
	select
		counterparty_id
	from
		counterparties

create table
	#trade_types
(
	trade_type_id int,
	name varchar(25)
)
insert into
	#trade_types
select
	trade_type_id,
	name
from
	trade_types
where
	name not in("Option", "Option Closeout", "Option Exercise")


/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Inserting into #trades"


create table
	#trades
(
	trade_id int,
	deal_id int,
	trade_type_id int,
 	external_account_id int,
	counterparty_id int,
	contract_id int,
	trader_id int,
	strategy_id int,
	broker_id int,
	sales_code_id int,
	pb_id int NULL,
	qty numeric(30, 4),
	counter_qty numeric(30, 4),
	product_id int NULL,
	currency_id int NULL,
	pd1_eq numeric(30, 4) NULL,
	pd2_eq numeric(30, 4) NULL,
	mtm_pl numeric(30, 4) NULL,
	cl_vo numeric(30, 4) NULL,
	lp_vo numeric(30, 4) NULL,
	vo numeric(30, 4) NULL
)

insert into
	#trades(
		trade_id,
		deal_id,
		trade_type_id,
		external_account_id,
		counterparty_id,
		contract_id,
		trader_id,
		strategy_id,
		broker_id,
		sales_code_id,
		pb_id,
		qty,
		counter_qty)
select
	a.trade_id,
	a.deal_id,
	a.trade_type_id,
	a.external_account_id,
	a.counterparty_id,
	a.contract_id,
	a.trader_id,
	a.strategy_id,
	a.broker_id,
	a.sales_code_id,
	b.pb_id,
	a.quantity,
	a.quantity * a.price * -1
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	#counterparties g,
	#trade_types h
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id= f.broker_id
and
	a.counterparty_id = g.counterparty_id
and
	a.trade_type_id = h.trade_type_id
and
	a.trade_date >= @begin_date
and
	a.trade_date < @end_date
and
	a.quantity != 0


/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Building indexes on #trades"

create nonclustered index u_did on #trades(deal_id)
create nonclustered index u_cid on #trades(counterparty_id)
create nonclustered index u_eid on #trades(external_account_id)

/* chriso: If the fund name is the run name, then we have all trades in here, no need to pull in additional deal trades */
if @fund_name != @run_name
begin
        create nonclustered index u_tid on #trades(trade_id)

	/* debug */
	if @debug = "Y"
		select 	starting=getdate(), msg = "Inserting into #deal_trades because fund name doesnt equal run name"

	create table
		#deal_trades(
        		trade_id int,
        		deal_id int,
        		trade_type_id int,
        		external_account_id int,
        		counterparty_id int,
        		contract_id int,
        		trader_id int,
        		strategy_id int,
        		broker_id int,
        		sales_code_id int,
        		quantity numeric(30, 2),
			price float
	)
	insert into
		#deal_trades
	select
        	b.trade_id,
        	b.deal_id,
        	b.trade_type_id,
        	b.external_account_id,
        	b.counterparty_id,
        	b.contract_id,
        	b.trader_id,
        	b.strategy_id,
        	b.broker_id,
        	b.sales_code_id,
        	b.quantity,
		b.price
	from
		#trades a,
		trades b
	where
		a.deal_id = b.deal_id
	and
        	b.trade_date >= @begin_date
	and
        	b.trade_date < @end_date
	
	/* debug */
	if @debug = "Y"
		select 	starting=getdate(), msg = "Deleting #deal_trades that are in #trades"

	delete
		#deal_trades
	from
		#deal_trades a,
		#trades b
	where
		a.trade_id = b.trade_id

	/* debug */
	select count(*) from #deal_trades
	
	/* debug */
        if @debug = "Y"
		select 	starting=getdate(), msg = "Inserting into #trades from #deal_trades"
		
	insert into
        	#trades(
                	trade_id,
                	deal_id,
                	trade_type_id,
                	external_account_id,
                	counterparty_id,
                	contract_id,
                	trader_id,
                	strategy_id,
                	broker_id,
                	sales_code_id,
                	qty,
                	counter_qty)
	select
        	trade_id,
        	deal_id,
        	trade_type_id,
        	external_account_id,
        	counterparty_id,
        	contract_id,
        	trader_id,
        	strategy_id,
        	broker_id,
        	sales_code_id,
        	quantity,
        	quantity * price * -1
	from
		#deal_trades
	
end	
		
	
	
/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Setting product_id, currency_id on #trades"

update
	#trades
set
	product_id = b.product_id,
	currency_id = b.currency_id
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

/* debug 
if @debug = "Y"
	select starting=getdate(), msg = "Setting pb_id on #trades"

update 
	#trades
set
	pb_id = prime_broker_id
from
	#trades a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id
*/


/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Getting eval ccys"

/* The only conversion rates that matter are those of the evaluation ccys, so only get those */
create table
        #eval_ccys(
                product_id int,
                symbol varchar(10) NULL
)
insert into
        #eval_ccys(
                product_id)
select
        distinct(evaluation_currency_id)
from
        funds

update
        #eval_ccys
set
        symbol = a.symbol
from
        products a,
        #eval_ccys b
where
        a.product_id = b.product_id

create table
	#traded_products(
		product_id int
)

insert into
	#traded_products
select
	distinct(product_id)
from
	#trades

insert into 
	#traded_products
select
	distinct(currency_id)
from
	#trades
where
	currency_id not in(select product_id from #traded_products)

/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Getting rates for conversion"

create table
	#conversion_contracts
(
	contract_id int NULL,
	product_id int,
	currency_id int,
	inverse_contract_id int NULL,
	standard_price float NULL,
	conversion_price float NULL
)


insert into 
	#conversion_contracts(
		contract_id,
		product_id,
		currency_id
	)
select
	a.contract_id,
	a.product_id,
	a.currency_id
from
	forwards a,
	#traded_products b,
	#eval_ccys c
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id

update
	#conversion_contracts
set
	inverse_contract_id = a.contract_id
from
	forwards a,
	#conversion_contracts b
where
	a.product_id = b.currency_id
and
	a.currency_id = b.product_id


/* bo_spot_settles should never contain a price for an inverted contract */
if @trade_date > @last_commit_date /* use front office prices */
begin
	select
		@using_ticking_price = "Y"

	/* create temp table of current prices so price ticks dont affect conversion rates */
	create table
		#current_prices(
			contract_id int,
			price float
	)
	insert into
		#current_prices
	select
		contract_id,
		price
	from
		current_prices
	
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		#current_prices a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	#current_prices a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
		b.standard_price = NULL
end
else /* use back office prices */
begin
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		bo_spot_settles a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	and
		convert(date, a.price_date) = convert(date, @trade_date)
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	bo_spot_settles a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
        	convert(date, a.price_date) = convert(date, @trade_date)
	and
		b.standard_price = NULL
end
insert into
	#conversion_contracts
(
	product_id,
	currency_id,
	conversion_price
)
select
	product_id,
	product_id,
	1.0
from
	#eval_ccys

/* Check if any conversion rates are missing, select error section using @error_style row and return */
/* not yet implemented */

/* debug 
select * from #traded_products
select * from #conversion_contracts
*/

/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Calculating PL and volume"

update 
	#trades
set
	pd1_eq = qty * conversion_price
from
	#trades a,
	#conversion_contracts b
where
	a.product_id = b.product_id

update
        #trades
set
        pd2_eq = counter_qty * conversion_price
from
        #trades a,
        #conversion_contracts b
where
        a.currency_id = b.product_id

update
	#trades
set
	vo = abs(pd1_eq)

update 
	#trades
set
	cl_vo = vo
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id

update 
        #trades
set
        lp_vo = vo
from
        #trades a
where
        cl_vo = NULL

update
	#trades
set
	mtm_pl = pd1_eq + pd2_eq

/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Calculating totals"

select 
	@total_pl = sum(mtm_pl),
	@total_volume = sum(vo) / 1000000,
	@total_trade_count = count(*)
from
	#trades

select
	@total_avg_size = @total_volume / @total_trade_count,
	@total_mm_pl = @total_pl / @total_volume

		

/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Calculating deal PL"

create table
	#deals(
		deal_id int,
		tc int NULL,
		total_pl float NULL,
		total_vo float NULL,
		total_cl_vo float NULL,
		total_lp_vo float NULL
)

insert into
	#deals(	
		deal_id,
		tc,
		total_pl,
		total_vo,
		total_cl_vo,
		total_lp_vo
)
select
	deal_id,
	count(*),
	sum(mtm_pl),
	sum(vo),
	sum(cl_vo),
	sum(lp_vo)
from
	#trades
group by
	deal_id

/* debug
select * from #deals
*/
	

/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Calculating client attribution"

create table
	#deal_cl_attrib(
		deal_id int,
		external_account_id int,
		vo float NULL,
		cl_vo float NULL,
		lp_vo float NULL,
		pl float NULL
)

insert into
	#deal_cl_attrib(
		deal_id,
		external_account_id,
		vo,
		cl_vo,
		lp_vo)
select
	deal_id,
	external_account_id,
	sum(abs(pd1_eq)),
	sum(cl_vo),
	sum(lp_vo)
from
	#trades
group by
	deal_id,
	external_account_id

update
	#deal_cl_attrib
set
	pl = a.total_pl * (b.cl_vo / a.total_cl_vo)
from
	#deals a,
	#deal_cl_attrib b
where
	a.deal_id = b.deal_id


/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Calculating PL attribution"

create table
        #deal_lp_attrib(
                deal_id int,
                counterparty_id int,
                vo float NULL,
		cl_vo float NULL,
		lp_vo float NULL,
		pl float NULL
)

insert into
        #deal_lp_attrib(
                deal_id,
                counterparty_id,
                vo,
		cl_vo,
		lp_vo)
select
        deal_id,
        counterparty_id,
	sum(abs(pd1_eq)),
	sum(cl_vo),
        sum(lp_vo)
from
        #trades
group by
        deal_id,
        counterparty_id

update
        #deal_lp_attrib
set
        pl = a.total_pl * (b.lp_vo / a.total_lp_vo)
from    
        #deals a,
        #deal_lp_attrib b
where
        a.deal_id = b.deal_id

/* debug
select * from #deal_cl_attrib order by deal_id
select * from #deal_lp_attrib order by deal_id
*/

/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Calculating client averages"

create table
	#cl_avgs(
		external_account_id int,
		trade_count int NULL,
		pl float NULL)
insert into
	#cl_avgs(
		external_account_id,
		trade_count,
		pl)
select
	external_account_id,
	avg(trade_count),
	avg(pl)
from
	external_account_pls
where
	pl_date >= @thirty_days_ago
and
	pl_date <= @end_date
group by
	external_account_id
	
create table
	#cl_volume_avgs(
		external_account_id int,
		volume float NULL)
insert into
	#cl_volume_avgs(
		external_account_id,
		volume)
select
	external_account_id,
	avg(volume) / 1000000
from
	account_volumes
where
	volume_date >= @thirty_days_ago
and
	volume_date <= @end_date
group by
	external_account_id




/* debug */
if @debug = "Y"
	select starting=getdate(), msg = "Calculating client attrib totals"
create table
	#cl_attrib(
		ordering float NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		trade_count int NULL,
		avg_size float NULL,
		volume float NULL,
		trend_volume float NULL,
		pl float NULL,
		avg_pl float NULL,
		vs_avg_pl float NULL,
		mm_pl float NULL,
		style varchar(100) NULL
)

create table
        #lp_attrib(
		ordering float NULL,
                counterparty_id int NULL,
                counterparty varchar(50) NULL,
                trade_count int NULL,
                avg_size float NULL,
                volume float NULL,
                pl float NULL,
                mm_pl float NULL,
		style varchar(100) NULL
)

/* Get client totals from deal/ext acct totals */
insert into
	#cl_attrib(
		ordering,
		external_account_id,
		trade_count,
		volume,
		pl,
		style)
select
	1, /* ordering, non total */
	external_account_id,
	count(*),
	sum(vo) /1000000.0 ,
	sum(pl),
	@style
from
	#deal_cl_attrib
group by
	external_account_id
	

update
	#cl_attrib
set
	a.vs_avg_pl = ((abs(a.pl -b.pl)) / abs(b.pl)) * sign(a.pl - b.pl),
	a.avg_pl = b.pl
from
	#cl_attrib a,
	#cl_avgs b
where
	a.external_account_id = b.external_account_id
and
	b.pl != 0.0

update
	#cl_attrib
set
	a.trend_volume = a.volume / b.volume
from
	#cl_attrib a,
	#cl_volume_avgs	b
where
	a.external_account_id = b.external_account_id
and
	a.volume != 0.0


update
	#cl_attrib
set
	avg_size = volume / trade_count,
	mm_pl = pl / volume

update 
	#cl_attrib
set
