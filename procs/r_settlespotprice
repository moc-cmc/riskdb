
if object_id("r_settlespotprice") != NULL
    drop procedure
        r_settlespotprice
go

create procedure
	r_settlespotprice
		@symbol char(50),
		@price float = NULL
as

declare @contract_id int
declare @price_id int
declare @price_date datetime
declare @date datetime
declare @day char(2)
declare @month char(2)
declare @year char(4)
declare @datestring char(22)
declare @inverted int
declare @instrument char(20)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol

if @@rowcount < 1
begin
	select
		id = 0,
		msg = "Contract not found"
	return
end


if @price = 0 or @price = NULL
begin
	select 
		@price = b.price 
	from 
		contracts a, 
		current_prices b 
	where 
		a.contract_id = b.contract_id and
		a.symbol = @symbol		
end

if @@rowcount < 1
begin
	select
		id = 0,
		msg = "No current price"
	return
end



select
	@day = convert(char(2), datepart(day, getdate())),	
	@month = convert(char(2), datepart(month, getdate())),	
	@year = convert(char(4), datepart(year, getdate()))
select
	@datestring = @month + "/" + @day + "/" + @year + " 17:00"
select
	@price_date = convert(datetime, @datestring)

select
	@instrument = a.name
from
	instruments a,
	contracts b
where
	a.instrument_id = b.instrument_id
and
	b.contract_id = @contract_id
	
select
	@price_id = price_id
from
	prices
where
	contract_id = @contract_id
and
	price_date = @price_date

if @@rowcount = 0
	begin
		begin tran
			update
				keys
			set
				last_id = last_id + 1
			where
				relation = "prices"
			select
				@price_id = last_id
			from
				keys
			where
				relation = "prices"
		commit tran

		insert into
			prices
		values(
			@price_id,
			1,
			@contract_id,
				@price_date,
				2,
				@price)
		insert into 
			theos_queue 
		values(
			@price_id)

	end

else
	begin
		select
			id = 0,
			msg = "Settle price already exists"
		return
	end
	
go
