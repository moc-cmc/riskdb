drop procedure
	r_fxmccreditview
go

create procedure
	r_fxmccreditview
		@login varchar(50),
		@external_account varchar(50)=NULL
as

declare @external_account_id int
declare @nop_limit float
declare @dsl_limit float
declare @net_equiv float
declare @longs_equiv float
declare @shorts_equiv float
declare @nop_type varchar(50)
declare @value_date datetime
declare @dsl_type varchar(50)
declare @evaluation_currency_id int
declare @evaluation_currency varchar(50)
declare @fund_id int

declare @search_string varchar(50)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)

insert into
	#meta
values(
	"Column Link",
	"edit_limits",
	"Edit Ext Account Limits",
	NULL)

insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Format",
	"usage",
	"Number",
	"#,##0.00%")

insert into
	#meta
values(
	"Column Format",
	"value",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"equiv",
	"Number",
	"#,##0.00")

insert into
	#meta
values(
	"Column Format",
	"amount",
	"Number",
	"#,##0.00")


select * from #meta

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Could not find evaluation currency"
	return
end

select
	@evaluation_currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

if @external_account = NULL
begin
	select
		@search_string = "%"
end
else
begin
	select
		@search_string = "%" + rtrim(@external_account) + "%"

	select
		@external_account_id = external_account_id
	from
		external_accounts
	where
		symbol = @external_account
end



select
	ext_account = b.symbol,
	currency = c.symbol,
	nop_type = d.name,
	a.nop_limit,
	dsl_type = e.name,
	a.dsl_limit,
	a.notice_level,
	a.warning_level,
	a.blocked_level,
	edit_limits = "EDIT"
from
	ext_account_limits a,
	external_accounts b,
	products c,
	nop_types d,
	dsl_types e
where
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
and
	a.nop_type_id = d.nop_type_id
and
	a.dsl_type_id = e.dsl_type_id
and	
	b.symbol = @external_account

select
	@nop_limit = a.nop_limit,
	@nop_type = b.name, 
	@dsl_limit = a.dsl_limit,
	@dsl_type = c.name
from
	ext_account_limits a,
	nop_types b,
	dsl_types c
where
	a.external_account_id = @external_account_id
and
	a.nop_type_id = b.nop_type_id
and
	a.dsl_type_id = c.dsl_type_id
		
	
create table
	#credit(
		id int identity,
		style varchar(200) NULL,
		calculation varchar(50) NULL,
		calc_method varchar(50) NULL,
		value float NULL,
		value_date datetime NULL,
		limit float NULL,
		usage float NULL)


if @external_account != NULL
begin

	select
		@net_equiv = sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @external_account
	and
		product != @evaluation_currency

	select
		@longs_equiv = sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		equiv > 0
	and
		ext_account = @external_account

	select
		@shorts_equiv = sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		equiv < 0
	and
		ext_account = @external_account

		
	insert into
		#credit(
			calculation,
			calc_method,
			value,
			limit)
	values(
		"NOP",
		"Net",
		@net_equiv,
		@nop_limit)

	insert into
		#credit(
			calculation,
			calc_method,
			value,
			limit)
	values(
		"NOP",
		"Longs",
		@longs_equiv,
		@nop_limit)

	insert into
		#credit(
			calculation,
			calc_method,
			value,
			limit)
	values(
		"NOP",
		"Shorts",
		@shorts_equiv,
		@nop_limit)

	create table
		#dsl(
			value_date datetime,
			dsl float)

	insert into
		#dsl
	select
		value_date,
		sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		ext_account = @external_account
	and
		product != @evaluation_currency
	group by
		value_date
	
	select
		@net_equiv = max(dsl)
	from
		#dsl

	select
		@value_date = value_date
	from
		#dsl
	where
		dsl = @net_equiv

	insert into
		#credit(
			calculation,
			calc_method,
			value,
			value_date,
			limit)
	values(
		"DSL",
		"Net",
		@net_equiv,
		@value_date,
		@dsl_limit)

	truncate table #dsl

	insert into
		#dsl
	select
		value_date,
		sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		equiv > 0
	and
		ext_account = @external_account
	group by
		value_date

	select
		@longs_equiv = max(dsl)
	from
		#dsl

	select
		@value_date = value_date
	from
		#dsl
	where
		dsl = @longs_equiv

	insert into
		#credit(
			calculation,
			calc_method,
			value,
			value_date,
			limit)
	values(
		"DSL",
		"Longs",
		@longs_equiv,
		@value_date,
		@dsl_limit)

	truncate table #dsl

	insert into
		#dsl
	select
		value_date,
		sum(abs(equiv))
	from
		ext_account_ladder_details
	where
		equiv < 0
	and
		ext_account = @external_account
	group by
		value_date

	select
		@shorts_equiv = max(dsl)
	from
		#dsl

	select
		@value_date = value_date
	from
		#dsl
	where
		dsl = @shorts_equiv

	insert into
		#credit(
			calculation,
			calc_method,
			value,
			value_date,
			limit)
	values(
		"DSL",
		"Shorts",
		@shorts_equiv,
		@value_date,
		@dsl_limit)

	update
		#credit
	set
		usage = value / limit
	where
		limit != 0

	update
		#credit
	set
		style = "background:#fff;border: 1px solid white"

	update
		#credit
	set
		style = "background:#FFFFCC;border: 1px solid white"
	where
		calc_method = @dsl_type
	and
		calculation = "DSL"

	update
		#credit
	set
		style = "background:#FFFFCC;border: 1px solid white"
	where
		calc_method = @nop_type
	and
		calculation = "NOP"

end

select
	style,
	calculation,
	calc_method,
	value,
	value_date,
	limit,
	usage
from
	#credit
order by
	id

	
select
	ext_account,
	product,
	val_date = convert(char(11), value_date, 1),
	amount,
	equiv,
	implied_rate = case
		when
			equiv != 0
		then
			abs(amount) / abs(equiv)
		else
			NULL
	end
from
	ext_account_ladder_details
where
	ext_account like @search_string
order by
	value_date,
	product

select
	a.archive_date,
	archived_by = f.login,
	ext_account = b.symbol,
	currency = c.symbol,
	nop_type = d.name,
	a.nop_limit,
	dsl_type = e.name,
	a.dsl_limit,
	a.notice_level,
	a.warning_level,
	a.blocked_level
from
	ext_account_limit_edits a,
	external_accounts b,
	products c,
	nop_types d,
	dsl_types e,
	tico_accounts f
where
	a.tico_account_id = f.account_id
and
	a.external_account_id = b.external_account_id
and
	a.currency_id = c.product_id
and
	a.nop_type_id = d.nop_type_id
and
	a.dsl_type_id = e.dsl_type_id
and
	b.symbol = @external_account



go
