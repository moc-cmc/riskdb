drop procedure
	r_expandcreditprofile
go

create procedure	
	r_expandcreditprofile
		@login varchar(50)

as

declare @is_admin varchar(1)
declare @admin_id int
declare @tico_account_id int

create table
        #meta(
                meta_type char(200),
                name char(30),
                action char(200) NULL,
                value char(255) NULL
)

insert into
        #meta
values(
        "Column Link",
        "view_profile",
        "View Credit Profile",
        NULL
)


insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "back",
        "Manage Credit Profiles",
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "add_profile",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "expand",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Hidden",
        "credit_profile",
        NULL,
        NULL
)


select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login

select
	@admin_id = access_group_id
from
	access_groups
where
	name = "Admin"

select
	@is_admin = "Y"
from
	access_group_accounts
where
	tico_account_id = @tico_account_id
and
	access_group_id = @admin_id


/* CHECK TO SEE IF THIS REPORT IS ENABLED */
if @is_admin != "Y"
begin
        select
                section = "Access Not Permitted",
                message = "<b>Access Not Permitted</b>" + " must be an 'Admin' user to view this report. Please contact your internal ETG Business Relationship Manager to set you up with access"
        return
end


select
	back = "<< Back"

create table
	#credit_profiles(
		credit_profile_id int,
		credit_profile varchar(50) NULL,
		name varchar(50) NULL,
		currency_id int NULL,
		currency varchar(10) NULL,
		nop_type_id int NULL,
		nop_type varchar(25) NULL,
		nop_limit float NULL,
		dsl_type_id int NULL,
		dsl_type varchar(25) NULL,
		dsl_limit float NULL,
		notice_level float NULL,
		warning_level float NULL,
		blocked_level float NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		counterparty_id int NULL,
		counterparty varchar(50) NULL,
		style varchar(50) NULL,
		view_profile varchar(25) NULL)

insert into
	#credit_profiles(
		credit_profile_id,
                name,
                currency_id,
                nop_type_id,
                nop_limit,
                dsl_type_id,
                dsl_limit,
                notice_level,
                warning_level,
                blocked_level,
		style,
		view_profile)
select
	credit_profile_id,
        name,
        currency_id,
        nop_type_id,
        nop_limit,
        dsl_type_id,
        dsl_limit,
        notice_level,
        warning_level,
        blocked_level,
	style =  "font-weight:bold;background:#FFFFFF;border: 1px solid white",
	view_profile = "VIEW"
from
	credit_profiles

insert into
	#credit_profiles(
		credit_profile_id,
		external_account_id)
select
	credit_profile_id,
	external_account_id
from
	credit_profile_accounts

insert into
	 #credit_profiles(
                credit_profile_id,
		counterparty_id)
select
	credit_profile_id,
	counterparty_id
from
	credit_profile_counterparties

update
	#credit_profiles
set
	credit_profile = b.name
from
	#credit_profiles a,
	credit_profiles b
where
	a.credit_profile_id = b.credit_profile_id

update
	#credit_profiles
set
	currency = b.symbol
from
	#credit_profiles a,
	products b
where
	a.currency_id = b.product_id

update
	#credit_profiles
set
	nop_type = b.name
from
	#credit_profiles a,
	nop_types b
where
	a.nop_type_id = b.nop_type_id

update
        #credit_profiles
set
	dsl_type = b.name
from
	#credit_profiles a,
	dsl_types b
where
	a.dsl_type_id = b.dsl_type_id	

update
	#credit_profiles
set
	external_account = b.symbol /*,
	style =  "font-weight:bold;background:#FFFFFF;border: 1px solid white" */
from
	#credit_profiles a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#credit_profiles
set
	counterparty = b.name /*,
	style =  "font-weight:bold;background:#FFFFFF;border: 1px solid white" */
from
	#credit_profiles a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#credit_profiles
set
	style = "color:#3D3D3D;background:#FFFFFF"
where
	name = NULL

select
        credit_profile,
	name,
        account = external_account,
        counterparty,
        currency,
        nop_type,
        nop_limit,
        dsl_type,
        dsl_limit,
        notice_level,
        warning_level,
        blocked_level,
	style,
	view_profile
from
	#credit_profiles
order by
	credit_profile ASC,
	name DESC
	
	
go
