
if object_id("cm_editstrategy") != NULL
    drop procedure
        cm_editstrategy
go

create procedure
	cm_editstrategy
		@login varchar(30),
		@strategy varchar(30),
		@new_name varchar(30)
as

declare @strategy_id int
declare @tico_server varchar(100)
declare @tico_database varchar(100)
declare @sql_string varchar(200)


select
	@strategy_id = strategy_id
from
	strategies
where
	name = @new_name
if @strategy_id != NULL
begin
	select
		status = "Error",
		message = "New strategy name already exists",
		new_name = @new_name
	return
end

update
	strategies
set
	name = @new_name
where
	name = @strategy


select
        @tico_server = tico_server,
        @tico_database = tico_database
from
        funds


select
	@sql_string = "exec " + rtrim(@tico_database) + "..flush"

exec sp_remotesql @tico_server, @sql_string


exec
	cm_strategies
		@login

go
