
if object_id("r_intradaypl") != NULL
    drop procedure
        r_intradaypl
go

create procedure
	r_intradaypl
		@login char(100)
as

create table
        #links(
                meta_type char(200),
                column char(30),
                link char(200) NULL,
                arguments char(255) NULL,
                format char(20) NULL)

insert into
	#links
values(
	"Column Link",
	"trade_to_mark",
	"Trade to Mark",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"run_name",
	"Current P&L Run",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

select
	run_name = a.name /* ,
	trade_to_mark = "TM - " + rtrim(convert(varchar(50), a.name)) */
from
	runs a,
	user_runs b,
	tico_accounts c
where
	a.run_id = b.run_id
and
	b.tico_account_id = c.account_id
and
	c.login = @login
order by
	name

go
