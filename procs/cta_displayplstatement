use
	risk_rcm
go

drop procedure
	cta_displayplstatement
go

create procedure
	cta_displayplstatement
		@pl_statement_id int

as

declare @external_account_id int
declare @external_accounts int
declare @internal_account_id int
declare @account_name char(50)
declare @activity int
declare	@total_pos_pl float
Declare	@total_trades_pl float
declare @total_fx_pl float
declare @total_pl float
declare @total_lv_change float
declare @total_cash_activity float
declare @total_fees float
declare @total_brokerage float
declare @total_comm_amount float
declare @commit_string char(20)
declare @uncommit_string char(20)
declare @status char(30)
declare @open_lv float
declare @close_lv float
declare @trade_date datetime
declare @prev_trade_date datetime
declare @cash_activity float


create table
	#links(
		meta_type char(200),
		column char(30),
		link char(200) NULL,
		arguments char(255) NULL,
		format char(20) NULL)

insert into
	#links
values(
	"Column Link",
	"contract",
	"Contract Inspector",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"uncommit_pl",
	"Uncommit P&L Statement",
	NULL,
	NULL)

insert into
	#links
values(
	"Column Link",
	"commit_pl",
	"Commit P&L Statement",
	NULL,
	NULL)

insert into
	#links
values(
	"Format Number",
	"net_pl",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"fx_pl",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"lv_change",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"close_base_value",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"open_base_value",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"total_pl",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"pos_pl",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"trades_pl",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"native_pl",
	NULL,
	NULL,
	"#,##0.00")

insert into
	#links
values(
	"Format Number",
	"p_l",
	NULL,
	NULL,
	"#,##0.00")

select * from #links


create table
	#lv_changes(
		account char(50),
		open_lv float NULL,
		close_lv float NULL)

create table
	#output(
		account char(50),
		trades_pl float NULL,
		pos_pl float NULL,
		fx_pl float NULL,
		total_pl float NULL,
		lv_change float NULL,
		cash_activity float NULL,
		fees float NULL,
		brokerage float NULL,
		comm_amount float NULL)

create table
	#pos_output(
		account char(50),
		contract char(50) NULL,
		size int NULL,
		currency char(10) NULL,
		quantity int NULL,
		open_price float NULL,
		close_price float NULL,
		native_pl float NULL,
		p_l float NULL)

create table
	#trade_output(
		account char(50),
		trade_id int NULL,
		contract char(50) NULL,
		size int NULL,
		currency char(10) NULL,
		quantity int NULL,
		price float NULL,
		close_price float NULL,
		native_pl float NULL,
		p_l float NULL,
		brokerage float NULL,
		fees float NULL,
		comm_amount float NULL)

select
	@internal_account_id = internal_account_id
from
	pl_statements
where
	pl_statement_id = @pl_statement_id

select
	@trade_date = a.trade_date
from
	trading_days a,
	pl_statements b
where
	a.trading_day_id = b.trading_day_id
and
	b.pl_statement_id = @pl_statement_id

select
	@prev_trade_date = max(a.trade_date)
from
	trading_days a,
	pl_statements b
where
	a.trading_day_id = b.trading_day_id
and
	b.internal_account_id = @internal_account_id
and
	a.trade_date < @trade_date
	


select
	@external_account_id = 0
select
	@external_accounts = count(*)
from
	external_accounts
where
	internal_account_id = @internal_account_id
and
	external_account_id > @external_account_id

while @external_accounts > 0
begin
	select
		@external_account_id = min(external_account_id)
	from
		external_accounts
	where
		internal_account_id = @internal_account_id
	and
		external_account_id > @external_account_id

	select
		@account_name = symbol
	from
		external_accounts
	where
		external_account_id = @external_account_id

	select
		@open_lv = NULL,
		@close_lv = NULL,
		@cash_activity = NULL

	select
		/* @open_lv = liquidating_val */
		@open_lv = total_equity
	from
		external_report_monies
	where
		external_account = @account_name
	and
		account_type = "9Z"
	and
		date = @prev_trade_date

	select
		/* @close_lv = liquidating_val */
		@close_lv = total_equity
	from
		external_report_monies
	where
		external_account = @account_name
	and
		account_type = "9Z"
	and
		date = @trade_date

	insert into
		#lv_changes
	values(
		@account_name,
		@open_lv,
		@close_lv)

	select
		@cash_activity = sum(net)
	from
		external_report_cash_entries
	where
		jrnl_date = @trade_date
	and
		external_account = @account_name
	if @cash_activity = NULL
		select
			@cash_activity = 0.0

	select
		@activity = 0
	select
		@activity = count(*)
	from
		pl_statement_trades
	where
		pl_statement_id = @pl_statement_id
	and
		external_account_id = @external_account_id

	select
		@activity = @activity + count(*)
	from
		pl_statement_positions
	where
		pl_statement_id = @pl_statement_id
	and
		external_account_id = @external_account_id

	select
		@activity = @activity + count(*)
	from
		pl_statements_fx
	where
		pl_statement_id = @pl_statement_id
	and
		external_account_id = @external_account_id

	select
		@total_pos_pl = NULL,
		@total_trades_pl = NULL,
		@total_fees = NULL,
		@total_brokerage = NULL,
		@total_comm_amount = NULL

	if @activity > 0
	begin
		select
			@total_pos_pl = NULL

		select
			@total_pos_pl = sum(p_l)
		from
			pl_statement_positions
		where
			pl_statement_id = @pl_statement_id
		and
			external_account_id = @external_account_id
		if @total_pos_pl = NULL
			select
				@total_pos_pl = 0.0


		select
			@total_trades_pl = NULL
		select
			@total_trades_pl = sum(p_l),
			@total_fees = sum(fees),
			@total_brokerage = sum(brokerage),
			@total_comm_amount = sum(comm_amount)
		from
			pl_statement_trades
		where
			pl_statement_id = @pl_statement_id
		and
			external_account_id = @external_account_id
		if @total_trades_pl = NULL
			select
				@total_trades_pl = 0.0
		if @total_fees = NULL
			select
				@total_fees = 0.0
		if @total_brokerage = NULL
			select
				@total_brokerage = 0.0
		if @total_comm_amount = NULL
			select
				@total_comm_amount = 0.0

		select
			@total_fx_pl = NULL
		select
			@total_fx_pl = sum(p_l)
		from
			pl_statements_fx
		where
			pl_statement_id = @pl_statement_id
		and
			external_account_id = @external_account_id
		if @total_fx_pl = NULL
			select
				@total_fx_pl = 0.0

		insert into
			#output
		select
			account = symbol,
			trades_pl = @total_trades_pl,
			position_pl = @total_pos_pl,
			fx_pl = @total_fx_pl,
			total_pl = @total_pos_pl + @total_trades_pl + @total_fx_pl,
			lv_change = @close_lv - @open_lv,
			cash_activity = @cash_activity,
			fees = @total_fees,
			brokerage = @total_brokerage,
			comm_amount = @total_comm_amount
		from
			external_accounts
		where
			external_account_id = @external_account_id


		insert into
			#pos_output
		select
			account = b.symbol,
			contract = c.symbol,
			a.size,
			currency = d.symbol,
			a.quantity,
			a.open_price,
			a.close_price,
			a.native_pl,
			a.p_l
		from
			pl_statement_positions a,
			external_accounts b,
			contracts c,
			products d
		where
			a.pl_statement_id = @pl_statement_id
		and
			a.external_account_id = @external_account_id
		and
			a.external_account_id = b.external_account_id
		and
			a.contract_id = c.contract_id
		and
			a.currency_id = d.product_id

	
		insert into
			#pos_output(
				account,
				p_l)
		values(
			"<b>" + rtrim(@account_name) + " Pos-Total</b>",
			@total_pos_pl)

		insert into
			#trade_output
		select
			account = b.symbol,
			a.trade_id,
			contract = c.symbol,
			a.size,
			currency = d.symbol,
			a.quantity,
			a.price,
			a.close_price,
			a.native_pl,
			a.p_l,
			a.brokerage,
			a.fees,
			a.comm_amount
		from
			pl_statement_trades a,
			external_accounts b,
			contracts c,
			products d
		where
			a.pl_statement_id = @pl_statement_id
		and
			a.external_account_id = @external_account_id
		and
			a.external_account_id = b.external_account_id
		and	
			a.contract_id = c.contract_id
		and
			a.currency_id = d.product_id
			
		insert into
			#trade_output(
				account,
				p_l)
		values(
			"<b>" + rtrim(@account_name) + " Trades-Total</b>",
			@total_trades_pl)
	end

	select
		@external_accounts = count(*)
	from
		external_accounts
	where
		internal_account_id = @internal_account_id
	and
		external_account_id > @external_account_id
end


select
	@total_trades_pl = sum(trades_pl),
	@total_pos_pl = sum(pos_pl),
	@total_fx_pl = sum(fx_pl),
	@total_pl = sum(total_pl),
	@total_lv_change = sum(lv_change),
	@total_cash_activity = sum(cash_activity),
	@total_brokerage = sum(brokerage),
	@total_fees = sum(fees),
	@total_comm_amount = sum(comm_amount)
from
	#output

insert into
	#output
values(
	"<b>Total Trading P&L</b>",
	@total_trades_pl,	
	@total_pos_pl,
	@total_fx_pl,
	@total_pl,
	@total_lv_change,
	@total_cash_activity,
	@total_fees,
	@total_brokerage,
	@total_comm_amount)

insert into
	#pos_output(
		account,
		p_l)
values(
	"<b>Total Positions P&L</b>",
	@total_pos_pl)

insert into
	#trade_output(
		account,
		p_l)
values(
	"<b>Total Trades P&L</b>",
	@total_trades_pl)


select
	@status = a.name
from
	statuses a,
	pl_statements b
where
	a.status_id = b.status_id
and
	b.pl_statement_id = @pl_statement_id

if @status = "Review"
	select
		@commit_string = "COMMIT"
else
	select
		@commit_string = ""

if @status = "Committed"
	select
		@uncommit_string = "UNCOMMIT"
else
	select
		@uncommit_string = ""

select
	client = c.symbol,
	pl_statement_id = @pl_statement_id,
	trade_date = a.trade_date,
	status = d.name,
	commit_pl = @commit_string,
	uncommit_pl = @uncommit_string
from
	trading_days a,
	pl_statements b,
	internal_accounts c,
	statuses d
where
	a.trading_day_id = b.trading_day_id
and
	b.internal_account_id = c.internal_account_id
and
	b.status_id = d.status_id
and
	b.pl_statement_id = @pl_statement_id

select
	account = a.symbol,
	currency = b.symbol,
	c.opening_balance,
	c.open_base_value,
	c.close_base_value,
	c.p_l
from
	external_accounts a,
	products b,
	pl_statements_fx c
where
	a.external_account_id = c.external_account_id
and
	c.product_id = b.product_id
and
	c.pl_statement_id = @pl_statement_id

select * from #pos_output
select * from #trade_output

select
	account,
	trades_pl,
	pos_pl,
	fx_pl,
	total_pl,
	cash_activity,
	fees,
	brokerage,
	comm_amount,
	net_pl = total_pl + cash_activity + fees + brokerage,
	lv_change
from
	#output


go

