
drop procedure
	ag_setfeeconversionrate
go

create procedure
	ag_setfeeconversionrate
		@login varchar(50),
		@pair varchar(50),
		@trade_date datetime,
		@price float
as

declare @contract_id int
declare @price_style varchar(50)
declare @fee_conversion_rate_id int

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @pair
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		pair = @pair
	return
end

select
	@trade_date = convert(datetime, dateadd(hour, 17, convert(date, @trade_date)))

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id

if @price_style = "Inverted"
	select
		@price = 1.0 / @price



select
	@fee_conversion_rate_id = fee_conversion_rate_id
from
	fee_conversion_rates
where
	contract_id = @contract_id
and
	convert(date, trade_date) = convert(date, @trade_date)
if @fee_conversion_rate_id != NULL
begin
	begin tran
		update
			fee_conversion_rates
		set
			price = @price
		where
			fee_conversion_rate_id = @fee_conversion_rate_id
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Could not update conversion rate for pair and date",
				pair = @pair,
				trade_date = @trade_date
			rollback tran
			return
		end
	commit tran
end
else
begin
	exec
		j_nextkey
			"fee_conversion_rates",
			@fee_conversion_rate_id output

	begin tran

		insert into
			fee_conversion_rates(
				fee_conversion_rate_id,
				contract_id,
				trade_date,
				price)
		values(
			@fee_conversion_rate_id,
			@contract_id,
			@trade_date,
			@price)
		if @@rowcount != 1
		begin
			select
				status = "Error",
				message = "Could not add conversion rate for pair and date",
				pair = @pair,
				trade_date = @trade_date
			rollback tran
			return
		end
	commit tran

end


exec
	ag_feesummary
		@login = @login,
		@begin_date = @trade_date,
		@end_date = NULL


go
