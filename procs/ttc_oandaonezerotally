create or replace procedure
	tt_onezerotally
		@login varchar(50)=NULL,
		@source varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@sender_comp_id varchar(50)=NULL,
		@sending_time datetime=NULL,
		@target_comp_id varchar(50)=NULL,
		@currency varchar(50)=NULL,
		@exec_id varchar(50)=NULL,
		@last_px float=NULL,
		@last_qty numeric(30,4)=NULL,
		@symbol varchar(50)=NULL,
		@transact_time datetime=NULL,
		@settl_date datetime=NULL,
		@trade_date datetime=NULL,
		@settl_currency varchar(50)=NULL,
		@previously_reported varchar(50)=NULL,
		@trade_report_id varchar(50)=NULL,
		@trade_link_id varchar(50)=NULL,
		@trd_type varchar(50)=NULL,
		@trd_sub_type varchar(50)=NULL,
		@side varchar(50)=NULL,
		@order_id varchar(50)=NULL,
		@cl_ord_id varchar(50)=NULL,
		@exec_firm varchar(50)=NULL,
		@clearing_firm varchar(50)=NULL,
		@client_id varchar(50)=NULL,
		@account varchar(50)=NULL,
		@check_sum varchar(50)=NULL

as

declare @sales_code_id int
declare @trade_type varchar(50)
declare @source_id int
declare @committed_status_id int
declare @broker_id int
declare @trader_id int
declare @lookup_trader varchar(50)
declare @counterparty varchar(50)
declare @counterparty_id int
declare @lookup_cpty varchar(50)
declare @external_account varchar(50)
declare @external_account_id int
declare @suppress_trade varchar(50)
declare @cpty_ext_acct_id int
declare @trade_identifier varchar(50)
declare @fixing_date datetime
declare @trader varchar(50)
declare @external_account_type varchar(50)
declare @trader_login varchar(50)
declare @deal_exec_symbol varchar(50)
declare @deal_id int
declare @deal_status_id int
declare @deal_type_id int
declare @deal_type varchar(50)
declare @aggregation_style varchar(50)
declare @user_account_id int
declare @suppressed_trade_id int
declare @trade_id int

/*
 * LOOKUP @source_id
 */
select
        @source_id = source_id
from
        sources
where
        name = @source
if @@rowcount != 1
begin
        select
                status = "Error",
                message = "Source not found",
                source = @source
        return
end

/*
 * LOOKUP @committed_status_id
 */
select
	@committed_status_id = status_id
from
	statuses
where
	name = "Committed"

if @committed_status_id = NULL
begin
	select
    		status = "Error",
        	message = "No status named, 'Committed'"
    	return
end

/*
 * LOOKUP @broker_id
 */
select
        @broker_id = broker_id
from
        brokers
where
        symbol = @broker
if @@rowcount != 1
begin
        select
                error="Error",
                msg="Broker not found",
                broker=@broker
        return
end


if @trd_sub_type = "1"   /* This is a client trade */
begin
	/* LOOKUP CLIENT DETAILS */

        select
                @lookup_trader = @account,
                @lookup_cpty = @exec_firm

        select
                @trade_identifier = @trade_report_id + ".c",
                @deal_type = "Client Forward",
		@trade_type = "Spot",
                @last_qty = @last_qty * -1 /* Flip qty because ticket is from perpective of client. So client BUY is really agency/fund SELL */


        select
                @suppress_trade = "Y"
        from
                suppression_symbols
        where
                source_id = @source_id
        and
                symbol = @lookup_trader


        select
                @trader_id = a.trader_id,
                @trader = a.symbol,
                @user_account_id = a.tico_account_id,
                @sales_code_id = a.sales_code_id,
                @external_account_id = a.external_account_id
        from
                traders a,
                trader_symbols b
        where
                a.trader_id = b.trader_id
        and
                b.source_id = @source_id
        and
                b.symbol = @lookup_trader
        if @@rowcount != 1
        begin
                select
                        @trader_id = a.trader_id,
                        @trader = a.symbol,
                        @user_account_id = a.tico_account_id,
                        @sales_code_id = a.sales_code_id,
                        @external_account_id = a.external_account_id
                from
                        traders a
                where
                        a.symbol = @lookup_trader
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
                                lookup_trader = @lookup_trader
                        return
                end
        end

	 /*
        * LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
        */

        select
                @counterparty_id = a.counterparty_id,
                @counterparty = a.name,
                @cpty_ext_acct_id = a.external_account_id
        from
                counterparties a,
                counterparty_symbols b
        where
                a.counterparty_id = b.counterparty_id
        and
                b.source_id = @source_id
        and
                b.symbol = @lookup_cpty
        if @counterparty = NULL
        begin
                select
                        @counterparty_id = a.counterparty_id,
                        @counterparty = a.name,
                        @cpty_ext_acct_id = a.external_account_id
                from
                        counterparties a
                where
                        a.name = @lookup_cpty

                if @counterparty = NULL
                begin
                        select
                                status = "Error",
                                message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
                                lookup_cpty = @lookup_cpty
                        return
                end
        end

        /*
        * LOOKUP @external_account, @external_account_type based on @external_account_id
        */
        select
                @external_account = a.symbol,
                @external_account_type = b.name,
                @aggregation_style = c.name
        from
                external_accounts a,
                external_account_types b,
                aggregation_styles c
        where
                a.external_account_type_id = b.external_account_type_id
        and
                a.aggregation_style_id = c.aggregation_style_id
        and
                a.external_account_id = @external_account_id
        if @external_account = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find external_account from @external_account_id",
                        external_account_id = @external_account_id
                return
        end
end

if @trd_sub_type = "2"   /* This is a market trade */
begin
	/* LOOKUP LP DETAILS */

        select
                @lookup_trader = @exec_firm,
                @lookup_cpty = rtrim(@account)+"-"+rtrim(@clearing_firm)

        select
                @trade_identifier = @trade_report_id + ".m",
                @deal_type = "Market Forward",
		@trade_type = "Spot"


        select
                @suppress_trade = "Y"
        from
                suppression_symbols
        where
                source_id = @source_id
        and
                symbol = @lookup_cpty


        select
                @trader_id = a.trader_id,
                @trader = a.symbol,
                @user_account_id = a.tico_account_id,
                @sales_code_id = a.sales_code_id,
                @external_account_id = a.external_account_id
        from
                traders a,
                trader_symbols b
        where
                a.trader_id = b.trader_id
        and
                b.source_id = @source_id
        and
                b.symbol = @lookup_trader
        if @@rowcount != 1
        begin
                select
                        @trader_id = a.trader_id,
                        @trader = a.symbol,
                        @user_account_id = a.tico_account_id,
                        @sales_code_id = a.sales_code_id,
                        @external_account_id = a.external_account_id
                from
                        traders a
                where
                        a.symbol = @lookup_trader
                if @@rowcount != 1
                begin
                        select
                                status = "Error",
                                message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
                                lookup_trader = @lookup_trader
                        return
                end
        end

        /*
        * LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
        */

        select
                @counterparty_id = a.counterparty_id,
                @counterparty = a.name,
                @cpty_ext_acct_id = a.external_account_id
        from
                counterparties a,
                counterparty_symbols b
        where
                a.counterparty_id = b.counterparty_id
        and
                b.source_id = @source_id
        and
                b.symbol = @lookup_cpty
        if @counterparty = NULL
        begin
                select
                        @counterparty_id = a.counterparty_id,
                        @counterparty = a.name,
                        @cpty_ext_acct_id = a.external_account_id
                from
                        counterparties a
                where
                        a.name = @lookup_cpty

                if @counterparty = NULL
                begin
                        select
                                status = "Error",
                                message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
                                lookup_cpty = @lookup_cpty
                        return
                end
        end

        /*     
        * OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
        */    
        select
                @external_account_id = @cpty_ext_acct_id

        /*
        * LOOKUP @external_account, @external_account_type based on @external_account_id
        */
        select
                @external_account = a.symbol,
                @external_account_type = b.name,
                @aggregation_style = c.name
        from   
                external_accounts a,
                external_account_types b,
                aggregation_styles c
        where
                a.external_account_type_id = b.external_account_type_id
        and    
                a.aggregation_style_id = c.aggregation_style_id
        and
                a.external_account_id = @external_account_id
        if @external_account = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find external_account from @external_account_id",
                        external_account_id = @external_account_id
                return
        end
end

/* Determine @login from @user_account_id */
select
        @trader_login = login
from
        tico_accounts
where
        account_id = @user_account_id


/* Check for Dupe */
if exists(select trade_id from trades where broker_id = @broker_id and identifier = @trade_identifier )
begin
        select
                status="Dupe",
                msg="Trade already tallied",
                identifier=@trade_identifier,
                broker= @broker
        return
end

/* Flip side based on @side */
if @side = "SELL"
begin
    select
        @last_qty = @last_qty * -1
end


/* Set @symbol - @currency is always ccy1. @settl_currency is always ccy2 */
select
	@symbol = @currency + @settl_currency


if not exists(select contract_id from contracts where symbol = @symbol)
begin
        select
                message = "Contract not found",
                contract = @symbol,
                action = "Fetching contract from contracts db with r_addbatchfwdsubscription"


        declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
                r_defaultfundforlogin
                        @login,
                        @fund_id output

        select
                @evaluation_currency = a.symbol
        from
                products a,
                funds b
        where
                a.product_id = b.evaluation_currency_id
        and
                b.fund_id=@fund_id
 
        exec r_addbatchfwdsubscription
                        @login,
                        @symbol,
                        @currency,
                        @settl_currency,
                        @evaluation_currency

        /* @waitfor_delay = "HH:MM:SS.00"*/
        declare @waitfor_delay char(11)
        select
                @waitfor_delay = "00:00:03.00"
        /* sleep for 1 second */

        select
                action = "Sleeping @waitfor_delay and checking for contract again",
                waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
        select "Contract Successfully Created"
end


/*  Get Deal Information - @trade_link_id is tag used to link deals */
select
        @deal_exec_symbol = @trade_link_id

select
	@deal_id = deal_id
from
	deal_aliases
where
	source_id = @source_id
and
	alias = @deal_exec_symbol

if @deal_id = NULL
begin
        select
                msg = "Creating new deal"

        select
                @deal_status_id = status_id
        from
                statuses
        where
                name = "User Review"
        if @deal_status_id = NULL
        begin
                select
                        status = "Error",
                        message = "No status found named, 'User Review'"
                return
        end
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = @deal_type
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for @deal_type",
                        deal_type = @deal_type
                return
        end

        exec
                j_nextkey
                        "deals",
                        @deal_id output

        insert into
                deals(
                        deal_id,
                        deal_type_id,
                        timestamp,
                        status_id
                        )
                values(
                        @deal_id,
                        @deal_type_id,
                        getdate(),
                        @deal_status_id
                        )

    insert into
                deal_exec_symbols
        values(
                @deal_id,
                @deal_exec_symbol
    )
end
else
begin
        select
                msg = "Appending to existing deal"
end

if @suppress_trade = "Y"
begin
        exec
                fxa_suppresstrade
                        @login = @trader_login,
                        @source = @source,
                        @suppressed_trade_id = @suppressed_trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @trade_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @external_account,
                        @counterparty = @counterparty,
                        @quantity = @last_qty,
                        @symbol = @symbol,
                        @value_date = @settl_date,
                        @fixing_date = @fixing_date,
                        @price = @last_px,
                        @trade_date = @transact_time,
                        @trader = @trader,
                        @broker = @broker,
                        @identifier = @trade_identifier,
                        @spot_reference = @last_px

            if @suppressed_trade_id = NULL
            begin
                    select
                            status = "Error",
                            message = "Failed to suppress trade"
            end
end
else
begin   
        exec
                fxa_tallytrade
                        @login = @trader_login,
                        @source = @source,
                        @trade_id = @trade_id out,
                        @deal_id = @deal_id out,
                        @tally_type = @trade_type,
                        @deal_type = @deal_type,
                        @trade_type = @trade_type,
                        @external_account = @external_account,
                        @counterparty = @counterparty,
                        @quantity = @last_qty,
                        @symbol = @symbol,
                        @value_date = @settl_date,
                        @fixing_date = @fixing_date,
                        @price = @last_px,
                        @trade_date = @transact_time,
                        @trader = @trader,
                        @broker = @broker,
                        @identifier = @trade_identifier,
                        @spot_reference = @last_px

        if @trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to tally trade"
                return
        end


        insert into
                trade_quoted_prices (   trade_id,
                                        price)
                values(
                        @trade_id,
                        @last_px
                        )

        exec
                r_inserttradenotification
                        @trade_id
end



/*
 * AUTOCOMMIT
 *
 * If there is a client trade in this deal and the account type is set for
 * Autocommit, then push through this deal automatically.
 */
if @deal_id != NULL and @aggregation_style = "Autocommit"
begin

    update
        deals
    set
        status_id = @committed_status_id
    where
        deal_id = @deal_id
    if @@rowcount != 1
    begin
        select
            status = "Error",
            message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    end
end
else
begin
    select
        message = "No autocommitted",
        deal_id = @deal_id,
        trade_id = @trade_id,
        aggregation_style = @aggregation_style
end

if @suppressed_trade_id != NULL
begin
        select
                trade_status = "Suppressed",
                message = "Trade Suppressed",
                trade_id = @suppressed_trade_id,
                deal_id = @deal_id,
                external_account = @external_account,
                counterparty = @counterparty,
		trader = @trader,
                symbol = @symbol,
                quantity = @last_qty,
                price = @last_px,
                val_date = @settl_date
end

if @trade_id != NULL
begin
          select
                trade_status = "Tallied",
                message = "Trade successfully tallied",
                trade_id = @trade_id,
                deal_id = @deal_id,
                external_account = @external_account,
                counterparty = @counterparty,
		trader = @trader,
                symbol = @symbol,
                quantity = @last_qty,
                price = @last_px,
                val_date = @settl_date
end


go


