create or replace procedure
	mc4_addriskserverrun
		@login varchar(50),
		@run varchar(50)

as

declare @tico_account_id int
declare @run_id int
declare @run_id_lookup int

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login

if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Problem finding account for login."
	return
end

select
	@run_id = run_id
from
	runs
where
	name = @run

if @run_id = NULL
begin
	select
  
	   status = "Error",
		run = @run,
		message = "Problem finding run."
	return
end

select
	@run_id_lookup = run_id
from
	risk_server_runs
where
	run_id = @run_id
if @run_id_lookup != NULL
begin
	select
		status = "Success",
		run = @run,
		message = "Run is already in Mission Control"
	return
end

insert into
	risk_server_runs(
		run_id) 
	values(
		@run_id)
if @@rowcount != 1
begin
	select
		status = "Error",
		run = @run,
		message = "Problem adding run."
	return
end

select
	status = "Success",
	message = "Successfully added run",
	run = @run

go
