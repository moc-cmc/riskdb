
if object_id("r_resolvefund") != NULL
    drop procedure
        r_resolvefund
go


create procedure
	r_resolvefund
        @login varchar(50),
        @source varchar(50),
        
        @fund_id int = null out,
        
        @name varchar(100) = null out,
        
        @create char(1) = NULL out,
        @report char(1) = NULL
as

/* messages */
declare @to varchar(50)
declare @issue varchar(250)
declare @subject varchar(250)
declare @content varchar(250)
declare @check_sql varchar(250)

declare @should_create char(1)
declare @source_id int

select
    @should_create = @create,
    @create = "N"

if @login = NULL or @source = NULL
begin
    if @report != "N"
        select
            status = "Error",
            message = "Login and source required",
            login = @login,
            source = @source
    raiserror 99001, "@login and @source required"
    return
end

if @fund_id = NULL
begin

    /* Lookup @fund_id through funds.name */
    if @fund_id = NULL and @name != NULL
        select
            @fund_id = a.fund_id
        from
            funds a
        where
            a.name = @name
    
end
            
if @fund_id = NULL
begin
        
    /* Resolve the @source_id from @source */
    exec
        r_resolvesource
            @login = @login,
            @source_id = @source_id out,
            @name = @source,
            @report = @report
    if @source_id = NULL
        return
        
    /* ---------------------------- MARK: Create ---------------------------- */

    if @should_create != "N" and /* has permission */ exists (
        select
            *
        from
            source_permissions
        where
            source_id = @source_id
        and
            autocreates_funds = "Y"
    )
    begin
    
        if @name = NULL
        begin
            
            select
                @issue = "unsupported:r_resolvefund():missing:@name",
                @to = "support",
                @subject = "Couldn't autocreate fund without a name",
                @content = "Fund does not exist. r_resolvefund attempted to create the fund but no @name was provided."
            exec
                r_postmessage
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High"
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Cannot create fund without specifying name",
                    fund = @name
                    
            return
        end
    
        /*+-------------------------------------------------------------------* 
         |                           INSERT funds                           | 
         *--------------------------------------------------------------------*/

        exec
            j_nextkey
                "funds",
                @fund_id out
        
        insert into
            funds (
                fund_id,
                name
            )
            values (
                @fund_id,
                @name
            )
        
        if @@rowcount != 1
        begin
        
            select
                @issue = "insert:funds(name=" + @name + ")",
                @to = "support",
                @subject = "Failed to create fund",
                @content = "The fund, """ + @name + """, does not exist and r_resolvefund attempted to autocreate it but no row was inserted with (fund_id: " + convert(varchar(10), @fund_id) + ", name: '" + @name + "').",
                @check_sql = "if exists(select * from funds where name = """ + @name + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
            exec
                r_manageissue
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High",
                    @check_sql = @check_sql
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Couldn't add fund",
                    fund = @name
            
            return
        end
        
        select
            @create = "Y"
    
        select
            @to = "support",
            @subject = "Fund, """ + @name + """, created",
            @content = "The fund, """ + @name + """, was created by " + @login + " on behalf of " + @source + "."
        exec
            r_postmessage
                @login = @login,
                @to = @to,
                @channel = "General",
                @subject = @subject,
                @content = @content,
                @priority = "Low"
                
    end
    else
    begin

        select
            @issue = "notfound:funds(name=" + @name + ")",
            @to = "support",
            @subject = "Fund, """ + @name + """, does not exist",
            @content = "The fund, """ + @name + """, could not be found.",
            @check_sql = "if exists(select * from funds where name = """ + @name + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
        exec
            r_manageissue
                @login = @login,
                @name = @issue,
                @to = @to,
                @channel = "System",
                @subject = @subject,
                @content = @content,
                @priority = "High",
                @check_sql = @check_sql
                
        if @report != "N"
            select
                status = "Error",
                message = "Fund not found",
                fund = @name
        
        return
    end
    
end

select
    @name = a.name
from
    funds a
where
    a.fund_id = @fund_id

go
