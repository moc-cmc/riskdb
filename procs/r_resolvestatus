
if object_id("r_resolvestatus") != NULL
    drop procedure
        r_resolvestatus
go

create proc
	r_resolvestatus
        @login varchar(50),
        @source varchar(50),
        
        @status_id int = NULL out,
        
        @name varchar(50) = NULL out,
        
        @create char(1) = NULL out,
        @report char(1) = NULL
as

/* messages */
declare @to varchar(50)
declare @issue varchar(250)
declare @subject varchar(250)
declare @content varchar(250)
declare @check_sql varchar(250)

declare @should_create char(1)
declare @source_id int

select
    @should_create = @create,
    @create = "N"
 
if @login = NULL or @source = NULL
begin
    if @report != "N"
        select
            status = "Error",
            message = "Login and source required",
            login = @login,
            source = @source
    raiserror 99001, "@login and @source required"
    return
end

/* Lookup @status_id for @name */
select
    @status_id = status_id
from
    statuses
where
    name = @name
    
if @status_id = NULL
begin

    /* Resolve the @source_id from @source */
    exec
        r_resolvesource
            @login = @login,
            @source_id = @source_id out,
            @name = @source,
            @report = @report
    if @source_id = NULL
        return
        
    if @should_create = "Y" and /* has permission */ exists (
        select
            *
        from
            source_permissions
        where
            source_id = @source_id
        and
            autocreates_statuses = "Y"
    )
    begin
    
        if @name = NULL
        begin
            
            select
                @issue = "unsupported:r_resolvestatus():missing:@name",
                @to = "support",
                @subject = "Couldn't autocreate status without a name",
                @content = "User does not exist. r_resolvestatus attempted to create the status but no @name was provided."
            exec
                r_postmessage
                    @login = @login,
                    @name = @issue,
                    @to = @to,
                    @channel = "System",
                    @subject = @subject,
                    @content = @content,
                    @priority = "High"
                    
            if @report != "N"
                select
                    status = "Error",
                    message = "Cannot create status without specifying name",
                    name = @name
                    
            return
        end
        
        exec
            j_nextkey
                "statuses",
                @status_id out
        
        insert into
            statuses (
                status_id,
                name
            )
            values (
                @status_id,
                @name
            )
        
        if @@rowcount != 1
        begin
            raiserror 98020, "Failed to create status"
            return
        end
        
        select
            @create = "Y"
    
        select
            @to = "support",
            @subject = "Status, """ + @name + """, created",
            @content = "The status, """ + @name + """, was created by " + @login + " on behalf of " + @source + "."
        exec
            r_postmessage
                @login = @login,
                @to = @to,
                @channel = "General",
                @subject = @subject,
                @content = @content,
                @priority = "Low"
                
    end
    else
    begin

        select
            @issue = "notfound:statuses(name=" + @name + ")",
            @to = "support",
            @subject = "Status, """ + @name + """, not supported",
            @content = "The status, """ + @name + """, could not be found.",
            @check_sql = "if exists(select * from statuses where name = """ + @name + """) exec r_manageissue @issue_id=#{id}, @status = 'Resolved'"
        exec
            r_manageissue
                @login = @login,
                @name = @issue,
                @to = @to,
                @channel = "General",
                @subject = @subject,
                @content = @content,
                @priority = "High",
                @check_sql = @check_sql
                
        if @report != "N"
            select
                status = "Error",
                message = "Status not found",
                name = @name
                
        return
    end
end

select
    @name = name
from
    statuses
where
    status_id = @status_id

go
