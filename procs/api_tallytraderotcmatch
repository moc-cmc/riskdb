create or replace procedure
	api_tallytraderotcmatch
		@login varchar(50),
		@otc_match_id int=NULL output,
		@trade_date datetime=NULL,
		@i_buy_sell varchar(50),
		@account varchar(50)=NULL,
		@trader varchar(50),
		@counterparty_trader varchar(50),
		@dealt_currency varchar(50),
		@counter_currency varchar(50),
		@dealt_amount float,
		@price float,
		@value_date datetime=NULL

as

declare @counterparty_firm varchar(100)
declare @seller_firm varchar(100)
declare @buyer_firm varchar(100)
declare @requestor_id int
declare @request_date datetime
declare @buyer_status_id int
declare @seller_status_id int

declare @legal_entity_id int
declare @buyer_account_id int
declare @buyer_trader_id int
declare @buyer_legal_entity_id int

declare @seller_account_id int
declare @seller_trader_id int
declare @seller_legal_entity_id int

declare @product_id int
declare @currency_id int
declare @contract_id int

declare @price_style varchar(50)
declare @buyer_trade_id int
declare @seller_trade_id int

declare @begin_date datetime
declare @end_date datetime




if @trade_date = NULL
begin
	select
		@trade_date = getdate()
end

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


select 
	@value_date = convert(date, @end_date)



select
	@requestor_id = account_id
from
	tico_accounts
where
	login = @login
if @requestor_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end


select
	@product_id = product_id
from
	products
where
	symbol = @dealt_currency
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Dealt currency not found",
		dealt_currency = @dealt_currency
	return
end


select
	@currency_id = product_id
from
	products
where
	symbol = @counter_currency
if @currency_id = NULL
begin
	select
		status = "Error",
		message = "Counter currency not found",
		counter_currency = @counter_currency
	return
end


select
	@contract_id = contract_id
from
	forwards
where
	product_id = @product_id
and
	currency_id = @currency_id
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "No contract found for currency and counter currency",
		currency = @dealt_currency,
		counter_currency = @counter_currency
	return
end

select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	a.price_style_id = b.price_style_id
and
	b.contract_id = @contract_id

if @price_style = "Inverted"
	select
		@price = 1.0 / @price





select
	@request_date = getdate()

select
	@buyer_status_id = status_id
from
	statuses
where
	name = "New"
if @buyer_status_id = NULL
begin
	select
		status = "Error",
		message = "New status not found"
	return
end

select
	@seller_status_id = status_id
from
	statuses
where
	name = "New"
if @seller_status_id = NULL
begin
	select
		status = "Error",
		message = "New status not found"
	return
end

select
	@legal_entity_id = legal_entity_id
from
	legal_entity_tico_accounts
where
	tico_account_id = @requestor_id
if @legal_entity_id = NULL
begin
	select
		status = "Error",
		message = "Unable to determine user legal entity"
	return
end


create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50))
insert into
	#external_accounts(
		external_account_id,
		symbol)
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	fo_sub_accounts b,
	bo_master_accounts c
where
	a.external_account_id = b.external_account_id
and
	b.bo_master_account_id = c.bo_master_account_id
and
	c.legal_entity_id = @legal_entity_id


create table
	#traders(
		trader_id int,
		symbol varchar(50))
insert into
	#traders(
		trader_id,
		symbol)
select
	a.trader_id,
	a.symbol
from
	traders a,
	legal_entity_tico_accounts b
where
	a.tico_account_id = b.tico_account_id
and
	b.legal_entity_id = @legal_entity_id


if @i_buy_sell = "I Buy"
begin
	/*select
		@buyer_account_id = external_account_id
	from
		#external_accounts
	where
		symbol = @account
	if @buyer_account_id = NULL
	begin
		select
			status = "Error",
			message = "Account not found",
			account = @account
		return
	end
			*/

	select
		@buyer_legal_entity_id = @legal_entity_id


	select
		@buyer_trader_id = trader_id
	from
		#traders
	where
		symbol = @trader
	if @buyer_trader_id = NULL
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end


	select
		@seller_account_id = NULL


	/* check fo_sub_accounts first, then bo_master */
	select
		@seller_firm = a.name
	from
		legal_entities a,
		bo_master_accounts b,
		fo_sub_accounts c,
		external_accounts d,
		traders e
	where
		a.legal_entity_id = b.legal_entity_id
	and
		b.bo_master_account_id = c.bo_master_account_id
	and
		c.external_account_id = d.external_account_id
	and
		d.external_account_id = e.external_account_id
	and
		e.symbol = @counterparty_trader
	if @seller_firm = NULL
	begin
		select
			@seller_firm = a.name
		from
			legal_entities a,
			bo_master_accounts b,
			external_accounts c,
			traders d
		where
			a.legal_entity_id = b.legal_entity_id
		and
			b.external_account_id = c.external_account_id
		and
			c.external_account_id = d.external_account_id
		and
			d.symbol = @counterparty_trader
		if @seller_firm = NULL
		begin
			select
				status = "Error",
				message = "Problem finding legal entity for seller trader"
			return
		end
	end

	select
		@seller_legal_entity_id = legal_entity_id
	from
		legal_entities
	where
		/*name = @counterparty_firm*/
		name = @seller_firm
	if @seller_legal_entity_id = NULL
	begin
		select
			status = "Error",
			message = "Counterparty legal entity not found",
			/*counterparty_firm = @counterparty_firm*/
		        name = @seller_firm
		return
	end

	select
		@seller_trader_id = trader_id
	from
		traders a,
		legal_entity_tico_accounts b
	where
		a.tico_account_id = b.tico_account_id
	and
		b.legal_entity_id = @seller_legal_entity_id
	and
		symbol = @counterparty_trader
	if @seller_trader_id = NULL
	begin
		select
			status = "Error",
			message = "Counterparty trader not found",
			counterparty_trader = @counterparty_trader
		return
	end
end

if @i_buy_sell = "I Sell"
begin
/*
	select
		@seller_account_id = external_account_id
	from
		#external_accounts
	where
		symbol = @account
	if @seller_account_id = NULL
	begin
		select
			status = "Error",
			message = "Account not found",
			account = @account
		return
	end

*/
			

	select
		@seller_legal_entity_id = @legal_entity_id


	select
		@seller_trader_id = trader_id
	from
		#traders
	where
		symbol = @trader
	if @seller_trader_id = NULL
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end


	select
		@buyer_account_id = NULL

	select
        	@buyer_firm = a.name
	from
        	legal_entities a,
        	bo_master_accounts b,
        	fo_sub_accounts c,
        	external_accounts d,
        	traders e
	where
        	a.legal_entity_id = b.legal_entity_id
	and
		b.bo_master_account_id = c.bo_master_account_id
	and
        	c.external_account_id = d.external_account_id
	and
        	d.external_account_id = e.external_account_id
	and
        	e.symbol = @counterparty_trader
	if @buyer_firm = NULL
	begin
        	select
                	@buyer_firm = a.name
        	from
                	legal_entities a,
                	bo_master_accounts b,
                	external_accounts c,
                	traders d
        	where
                	a.legal_entity_id = b.legal_entity_id
        	and
                	b.external_account_id = c.external_account_id
        	and
                	c.external_account_id = d.external_account_id   
        	and
                	d.symbol = @counterparty_trader
        	if @buyer_firm = NULL
        	begin
                	select
                        	status = "Error",
                        	message = "Problem finding legal entity for buyeur trader"
                	return
        	end
	end


	select
		@buyer_legal_entity_id = legal_entity_id
	from
		legal_entities
	where
		/*name = @counterparty_firm*/
		name = @buyer_firm
	if @buyer_legal_entity_id = NULL
	begin
		select
			status = "Error",
			message = "Counterparty legal entity not found",
			/*counterparty_firm = @counterparty_firm*/
                        buyer_firm = @buyer_firm
		return
	end

	select
		@buyer_trader_id = trader_id
	from
		traders a,
		legal_entity_tico_accounts b
	where
		a.tico_account_id = b.tico_account_id
	and
		b.legal_entity_id = @buyer_legal_entity_id
	and
		symbol = @counterparty_trader
	if @buyer_trader_id = NULL
	begin
		select
			status = "Error",
			message = "Counterparty trader not found",
			counterparty_trader = @counterparty_trader
		return
	end

end




/* THIS WILL BE REMOVED WHEN WE FIGURE OUT WHAT THEY WANT WITH ACCOUNTS */
select
	@buyer_account_id = d.external_account_id
from
	legal_entities a,
	bo_master_accounts b,
	fo_sub_accounts c,
	external_accounts d
where
	a.legal_entity_id = b.legal_entity_id
and
	b.bo_master_account_id = c.bo_master_account_id
and
	c.external_account_id = d.external_account_id
and
	a.legal_entity_id = @buyer_legal_entity_id

select
        @seller_account_id = d.external_account_id
from
        legal_entities a,
        bo_master_accounts b,
        fo_sub_accounts c,
        external_accounts d
where
        a.legal_entity_id = b.legal_entity_id
and
        b.bo_master_account_id = c.bo_master_account_id
and
        c.external_account_id = d.external_account_id
and
        a.legal_entity_id = @seller_legal_entity_id



exec
	j_nextkey
		"otc_matches",
		@otc_match_id output

begin tran
	insert into
		otc_matches(
			otc_match_id,
			requestor_id,
			request_date,
			trade_date,
			buyer_account_id,
			buyer_trader_id,
			buyer_legal_entity_id,
			buyer_status_id,
			buyer_trade_id,
			seller_account_id,
			seller_trader_id,
			seller_legal_entity_id,
			seller_status_id,
			seller_trade_id,
			contract_id,
			quantity,
			price,
			value_date)
	values(
		@otc_match_id,
		@requestor_id,
		@request_date,
		@trade_date,
		@buyer_account_id,
		@buyer_trader_id,
		@buyer_legal_entity_id,
		@buyer_status_id,
		@buyer_trade_id,
		@seller_account_id,
		@seller_trader_id,
		@seller_legal_entity_id,
		@seller_status_id,
		@seller_trade_id,
		@contract_id,
		@dealt_amount,
		@price,
		@value_date)
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Unable to enter OTC match",
			account = @account,
			trader = @trader,
			counterparty_firm = @counterparty_firm,
			counterparty_trader = @counterparty_trader,
			dealt_currency = @dealt_currency,
			counter_currency = @counter_currency,
			dealt_amount = @dealt_amount,
			price = @price,
			value_date = @value_date
		rollback tran
		return
	end
commit tran



	


go
		
