
if object_id("mc2_tallyclientoption") != NULL
    drop procedure
        mc2_tallyclientoption
go

create procedure
	mc2_tallyclientoption
		@login char(25),
		@client_user char(25),
		@client_buys_sells char(25),
		@quantity numeric(30,4),
		@biproduct varchar(50),
		@timezone varchar(25),
		@expiration datetime,
		@option_settledate datetime=NULL,	
		@strike float,
		@call_put char(1),
		@implied_volatility float,
		@spot_reference float,
		@price float,
		@price_format varchar(15),
		@total_premium float=NULL,
		@premium_currency varchar(25)=NULL,
		@premium_settledate datetime=NULL

as

declare @external_account varchar(50)
declare @pips_price float
declare @pct_price float
declare @contract_id int
declare @symbol varchar(50)
declare @trade_id int
declare @deal_id int
declare @trade_date datetime

select
	@trade_date = getdate()

if @call_put in('c','C', '0', 'CALL')
        select
                @call_put = 'C'

if @call_put in('p', 'P', '1', 'PUT')
        select
                @call_put = 'P'

select
	@external_account = a.symbol
from
	external_accounts a,
	traders b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @client_user
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Could not found account for client user",
		client_user = @client_user
	return
end

if @price_format = "Pct"
begin
	select
		@pips_price = (@price / 100.00) * @spot_reference,
		@pct_price = @price / 100.00
end
else
begin
	select
		@pips_price = @price,
		@pct_price = NULL
end

	
if @client_buys_sells = "Client Buys"
begin
	select
		@quantity = abs(@quantity) * -1.0
end
if @client_buys_sells = "Client Sells"
begin
	select
		@quantity = abs(@quantity)
end

exec
	r_spotoptioncontract
		@biproduct,
		@timezone,
		@expiration,
		@call_put,
		@strike,
		@option_settledate,
		@contract_id output

select
	@symbol = symbol
from
	contracts
where
	contract_id = @contract_id


exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Option",
		@deal_type = "Client Option",
		@trade_type = "Option",
		@external_account = @external_account,
		@quantity = @quantity,
		@symbol = @symbol,
		@value_date = @option_settledate,
		@price = @pips_price,
		@trade_date = @trade_date,
		@trader = @client_user,
		@premium = @total_premium,
		@premium_currency = @premium_currency,
		@prem_settle_date = @premium_settledate,
		@pct_price = @pct_price,
		@spot_reference = @spot_reference

exec r_inserttradenotification @trade_id

select
	@implied_volatility = @implied_volatility / 100.00

exec
	r_initializeoptcontract
		@symbol,
		@implied_volatility


exec
	mc_inspectdealtrades
		@login,
		@deal_id


go
