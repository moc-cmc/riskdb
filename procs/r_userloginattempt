drop procedure 
	r_userloginattempt
go

create procedure
	r_userloginattempt
		@tico_account_id int=NULL,
		@login_provided varchar(50),
		@password_provided varchar(50),
		@login_status varchar(30),
		@ip varchar(20)=NULL

as

declare @user_login_attempt_id int
declare @login_attempt_status_id int

select
	@login_attempt_status_id = login_attempt_status_id
from
	login_attempt_statuses
where
	name = @login_status
if @login_attempt_status_id = NULL
	select
		@login_attempt_status_id = 0

exec
	j_nextkey
		"user_login_attempts",
		@user_login_attempt_id output

insert into
	user_login_attempts(
		user_login_attempt_id,
		tico_account_id,
		login_provided,
		password_provided,
		login_attempt_status_id,
		timestamp,
		ip)
values(
	@user_login_attempt_id,
	@tico_account_id,
	@login_provided,
	@password_provided,
	@login_attempt_status_id,
	getdate(),
	@ip
)


		
go
