use
	risk_firsel
go

drop procedure
	lw_importfiletrades
go

create procedure
	lw_importfiletrades
		@login varchar(50),
		@file_name varchar(50),
		@symbol varchar(50),
		@start_date datetime,
		@balance float,
		@trade_price float,
		@maturity_date datetime,
		@strategy varchar(50)

as

declare @trade_id int
declare @deal_id int
declare @strategy_id int

select
	@strategy_id = strategy_id
from
	strategies
where
	name = @strategy
if @@rowcount != 1
begin
	exec
		j_nextkey
			"strategies",
			@strategy_id output
	insert into
		strategies
	values(
		@strategy_id,
		@strategy)
end

select
	@maturity_date = convert(datetime, convert(date, @maturity_date))

exec
	fxa_tallytrade
		@login = @login,
		@source = "MPT Manual Tally",
		@trade_id = @trade_id output,
		@deal_id = @deal_id output,
		@tally_type = "Forward",
		@deal_type = "Market Forward",
		@trade_type = "Forward",
		@quantity = @balance,
		@symbol = @symbol,
		@value_date = @maturity_date,
		@price = @trade_price,
		@trade_date = @start_date,
		@strategy = @strategy,
		@identifier = @symbol,
		@sales_code = "None"

exec
	r_editsettle
		@symbol,
		@start_date,
		0.000001

go
		
		
		
