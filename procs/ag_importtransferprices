use
	risk_edgewater
go

drop procedure
	ag_importtransferprices
go

create procedure
	ag_importtransferprices
		@login varchar(50),
		@trade_date varchar(50)=NULL,
		@contract varchar(50)=NULL,
		@value_date varchar(50)=NULL,
		@price varchar(50)=NULL,
		@row_count int,
		@row_index int

as


declare @id int
declare @contract_id int
declare @vdate datetime
declare @tdate datetime
declare @float_price float

if lower(@trade_date) like "%rade%"
	return 

select
	@tdate = convert(datetime, @trade_date),
	@vdate = convert(datetime, @value_date),
	@float_price = convert(float, @price)


select
	@tdate = convert(datetime, convert(date, @tdate))

select
	@tdate = dateadd(hour, 17, @tdate)

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @contract
if @contract_id = NULL
begin
	select
		status = "Error",
		message = "Contract not found",
		contract = @contract
	return
end


select
	contract = @contract

update
	transfer_prices
set
	price = @float_price
where
	contract_id = @contract_id
and
	convert(date, date) = convert(date, @tdate)
and
	convert(date, value_date) = convert(date, @vdate)
if @@rowcount = 0
begin
	exec
		j_nextkey
			"transfer_prices",
			@id output

	insert into
		transfer_prices(
			id,
			contract_id,
			value_date,
			date,
			price)
	values(
		@id,
		@contract_id,
		@vdate,
		@tdate,
		@float_price)

end




go
