drop procedure
	mn_activatemaversion
go

create procedure
	mn_activatemaversion
		@login varchar(50),
		@master_allocation varchar(50),
		@version int
as

declare @master_allocation_id int
declare @ma_version_id int
declare @status varchar(50)
declare @active_ma_versions int
declare @active_status_id int

select
	@master_allocation_id = master_allocation_id
from
	master_allocations
where
	name = @master_allocation
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Master allocation not found",
		master_allocation = @master_allocation
	return
end

select
	@ma_version_id = ma_version_id
from
	ma_versions
where
	master_allocation_id = @master_allocation_id
and
	version = @version
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Version not found",
		master_allocation = @master_allocation,
		version = @version
	return
end

select
	@status = a.name
from
	statuses a,
	ma_versions b
where
	a.status_id = b.status_id
and
	b.ma_version_id = @ma_version_id

select
	@active_ma_versions = 0

select
	@active_ma_versions = count(a.ma_version_id)
from
	ma_versions a,
	statuses b
where
	a.status_id = b.status_id
and
	a.master_allocation_id = @master_allocation_id
and
	b.name = "Active"

if @active_ma_versions != 0
begin
	select
		status = "Error",
		message = "Active version already exist. Please archive active versions before attempting to activate"
	return
end


if @status != "Queued"
begin
	select
		status = "Error",
		message = "Only queued versions can be activated"
	return
end


select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"statuses",
			@active_status_id output

	insert into
		statuses
	values(
		@active_status_id,
		"Active")
end

update
	ma_versions
set
	status_id = @active_status_id,
	deployment_date = getdate()
where
	ma_version_id = @ma_version_id


exec
	mn_inspectsubaccounts
		@login,
		@master_allocation,
		@version


go

