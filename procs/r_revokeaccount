
drop procedure
	r_revokeaccount
go

create procedure
	r_revokeaccount
		@account_name char(50),
		@run_name char(50)

as

declare @account_id int
declare @run_id int

select
	@account_id = account_id
from	
	tico_accounts
where
	login = @account_name
if @@rowcount != 1
begin
        select
                status = -1,
                error = "Problem deterimining login"
        return
end

select 
	@run_id = run_id
from	
	runs
where
	name = @run_name
if @@rowcount != 1
begin
        select

                status = -1,
                error = "Problem deterimining run",
		run = @run_name
        return
end


begin tran

	if exists (select run_id from user_run_favorites where tico_account_id=@account_id and run_id=@run_id)
	begin
		delete from
			user_run_favorites
		where
			tico_account_id=@account_id
		and
			run_id=@run_id

		if @@rowcount != 1
		begin
			select
				status = -1,
				error = "Problem deleting from user_run_favorites"

			rollback tran
			return
		end
	end
	
	delete from
		user_runs
	where
		tico_account_id = @account_id
	and
		run_id = @run_id
	
	if @@rowcount != 1
	begin
		select
        		status = -1,
     			error = "Problem deleting run from user_runs"
        	
		rollback tran
		return
	end

commit tran

go


