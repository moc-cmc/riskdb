use risk_faros
go

drop procedure fxa_tallytrade
go


create procedure
	fxa_tallytrade
		@login char(25),
		@source varchar(50),
		@trade_id int output,
		@deal_id int output,
		@tally_type varchar(25),
		@deal_type varchar(50),
		@trade_type varchar(25),
		@internal_account varchar(50)=NULL,
		@external_account varchar(50)=NULL,
		@counterparty varchar(50)=NULL,
		@quantity numeric(30,4),
		@symbol varchar(50),
		@value_date datetime,
		@price float,
		@trade_date datetime,
		@trader varchar(25)=NULL,
		@strategy varchar(50)=NULL,
		@status varchar(50)=NULL,
		@broker varchar(50)=NULL,
		@identifier varchar(100)=NULL,
		@sales_code varchar(25)=NULL,
		@premium float=NULL,
		@premium_currency varchar(25)=NULL,
		@prem_settle_date datetime=NULL,
		@pct_price float=NULL,
		@spot_reference float=NULL,
		@fixing_date datetime=NULL,
		@mid_mark float=NULL,
		@trade_note varchar(255)=NULL

as

declare @source_id int
declare @tico_account_id int
declare @fund_id int
declare @tally_type_id int
declare @deal_type_id int
declare @trade_type_id int
declare @internal_account_id int
declare @external_account_id int
declare @counterparty_id int
declare @contract_id int 
declare @trader_id int
declare @strategy_id int
declare @broker_id int
declare @status_id int
declare @deal_status_id int
declare @price_style varchar(40)
declare @premium_currency_id int
declare @premium_transaction_type_id int
declare @account_transaction_id int
declare @quantity_sign float
declare @trades int
declare @sales_code_id int
declare @default_sales_code_id int
declare @client_user_id int
declare @aggregation_style varchar(25)
declare @aggregation_style_id int

declare @allocation_mode_id int
declare @allocation_mode varchar(30)
declare @ext_acct_type varchar(25)
declare @ext_acct_type_id int
declare @apply_allocations char(1)
declare @master_allocation_id int
declare @sub_account_id int

declare @orig_trade_qty numeric(30, 4)
declare @orig_prem_qty numeric(30, 6)
declare @tally_sub_acct_identifier varchar(100)
declare @tally_sub_acct_trade_id int
declare @tally_sub_acct_qty numeric(30, 2)
declare @tally_sub_acct_prem numeric(30, 2)
declare @tally_sub_acct_id int
declare @tally_sub_acct_alloc float
declare @alloc_status_id int
declare @tally_sub_account_trader_id int
declare @working_status_id int

declare @fund_agency_trader_id int

select
    @deal_status_id = status_id
from
    statuses
where
    name = "User Review"

if @deal_status_id = NULL
begin
    select
        status = "Error",
        message = "No status found named, 'User Review'"
    return
end

exec
	r_defaultfundforlogin
		@login,
		@fund_id output

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Unable to resolve login, '" + @login + "'",
        login = @login
	return
end

select
	@tally_type_id = tally_type_id
from
	tally_types
where
	name = @tally_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Tally type not found",
		tally_type = @tally_type
	return
end


select
	@deal_type_id = deal_type_id
from
	deal_types
where
	name = @deal_type
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Deal type not found",
		deal_type = @deal_type
	return
end

select
	@trade_type_id = trade_type_id
from
	trade_types
where
	name = @trade_type
if @@rowcount != 1
begin
	insert into
		trade_types(
			name)
	values(
		@trade_type)
	select
		@trade_type_id = @@identity
end


if @trader != NULL
begin
	select
		@client_user_id = tico_account_id,
		@trader_id = trader_id,
		@default_sales_code_id = sales_code_id
	from
		traders
	where
		symbol = @trader
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end
	select
		@fund_agency_trader_id = a.trader_id
	from
		traders a,
		fund_agency_traders b
	where
		a.trader_id = b.trader_id
end

if @client_user_id = NULL
	select
		@client_user_id = @tico_account_id

select
	@internal_account_id = internal_account_id,
	@external_account_id = external_account_id,
	@trader_id = trader_id,
	@strategy_id = strategy_id,
	@broker_id = broker_id,
	@status_id = status_id,
	@counterparty_id = counterparty_id
from
	default_tally_accounts
where
	tico_account_id = @client_user_id
and
	tally_type_id = @tally_type_id
if @@rowcount = 0
begin
	select
		status = "Error",
		message = "Trader has no tally defaults"
	return
end

if @fund_agency_trader_id != NULL
begin
	select
		@strategy_id = strategy_id
	from
		default_tally_accounts
	where
		tico_account_id = @tico_account_id
	and
		tally_type_id = @tally_type_id
	if @@rowcount = 0
	begin
		select
			status = "Error",
			message = "Trader has no tally defaults, cannot overwrite strategy for client trade"
		return
	end
end

if @broker != NULL
begin
	select
		@broker_id = broker_id
	from
		brokers
	where
		symbol = @broker
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Broker not found",
			broker = @broker
		return
	end
end

if @identifier != NULL
begin
	if @trade_id = NULL
	begin
		select
			@trade_id = trade_id
		from
			trades
		where
			identifier = @identifier
		and
			broker_id = @broker_id

		if @trade_id != NULL
		begin
			select
				status = "Dupe",
				messsage = "Trade is already tallied",
				identifier = @identifier,
				trade_id = @trade_id
			return
		end
	end
end
	

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source not found",
		source = @source
	return
end

if @strategy != NULL
begin
	select
		@strategy_id = strategy_id
	from
		strategies
	where
		name = @strategy
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Strategy not found",
			strategy = @strategy
		return
	end
end

if @trader != NULL
begin
	select
		@trader_id = trader_id,
		@default_sales_code_id = sales_code_id
	from
		traders
	where
		symbol = @trader
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Trader not found",
			trader = @trader
		return
	end
end

if @sales_code != NULL
begin
	select
		@sales_code_id = sales_code_id
	from
		sales_codes
	where
		name = @sales_code
	if @@rowcount != 1
	begin
		exec
			j_nextkey
				"sales_codes",
				@sales_code_id output
		insert into
			sales_codes
		values(
			@sales_code_id,
			@sales_code)
	end
end
else
begin
	select
		@sales_code_id = @default_sales_code_id
end

if @counterparty != NULL
begin
	select
		@counterparty_id = counterparty_id
	from
		counterparties
	where
		name = @counterparty
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Counterparty not found",
			counterparty = @counterparty
		return
	end
end

if @external_account != NULL
begin
	select
		@external_account_id = external_account_id,
		@aggregation_style_id = aggregation_style_id,
		@ext_acct_type_id = external_account_type_id
	from
		external_accounts
	where
		symbol = @external_account
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "External account not found",
			external_account = @external_account
		return
	end
end
if @ext_acct_type_id = NULL
begin
	select
		@ext_acct_type_id = external_account_type_id
	from
		external_accounts
	where
		external_account_id = @external_account_id

end



select
	@ext_acct_type = name
from
	external_account_types
where
	external_account_type_id = @ext_acct_type_id

if @ext_acct_type = "Master"
begin
	create table
		#master_sub_accounts
	(
		sub_account_id int,
		external_account_id int,
		allocation float
	)

	select
		@master_allocation_id = master_allocation_id,
		@allocation_mode_id = allocation_mode_id
	from
		master_allocations
	where
		external_account_id = @external_account_id

	insert into
		#master_sub_accounts
	select
		sub_account_id,
		external_account_id,
		allocation
	from
		sub_accounts
	where
		master_allocation_id = @master_allocation_id
	if @@rowcount > 0
	begin
		select
			@apply_allocations = "Y"
	end

end


if @internal_account != NULL
begin
	select
		@internal_account_id = internal_account_id
	from
		internal_accounts
	where
		symbol = @internal_account
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Internal account not found",
			internal_account = @internal_account
		return
	end
end

/* Check the aggregation style. If the aggregation style is not "None", then
 * override the @status_id of the trade to "Unaggregated". This can be
 * overridden by the @status parameter. */
select
    @aggregation_style = name
from
    aggregation_styles
where
    aggregation_style_id = @aggregation_style_id
    
if @aggregation_style != "None"
begin
    select
        @status_id = status_id
    from
        statuses
    where
        name = "Unaggregated"
    
    if @status_id = NULL
    begin
		select
			status = "Error",
			message = "Status, 'Unaggregated', not found",
			status_name = "Unaggregated"
		return
    end
end

if @status != NULL
begin
	select
		@status_id = status_id
	from
		statuses
	where
		name = @status
	if @@rowcount != 1
	begin
		select
			status = "Error",
			message = "Status not found",
			status_name = @status
		return
	end
end

select
	@contract_id = contract_id
from
	contracts
where
	symbol = @symbol
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Contract not found",
		symbol = @symbol
	return
end

if @deal_type = "Option"
	exec
		r_contractvaluedate
			@contract_id,
			@trade_date,
			@value_date output


select
	@price_style = a.name
from
	price_styles a,
	contract_price_styles b
where
	b.contract_id = @contract_id
and
	b.price_style_id = a.price_style_id

if @price_style = "Inverted"
	select
		@price = 1.0 / @price





if @trade_id = NULL
begin
    exec
        j_nextkey
            "trades",
            @trade_id output
    
    if @identifier = NULL
        select
            @identifier = rtrim(@source) + " " + rtrim(convert(varchar(20), @trade_id))

end

if @deal_id = NULL
begin

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals (
            deal_id,
            deal_type_id,
            timestamp,
            status_id
        )
	values(
        @deal_id,
		@deal_type_id,
		getdate(),
        @deal_status_id
    )
    
end

select
	@premium_transaction_type_id = transaction_type_id
from
	transaction_types
where
	name = "Option Premium"
if @@rowcount != 1
begin
	exec
		j_nextkey
			"transaction_types",
			@premium_transaction_type_id output

	insert into
		transaction_types
	values(
		@premium_transaction_type_id,
		"Option Premium",
		1)
end

if @premium != NULL
begin
	select
		@premium_currency_id = product_id
	from
		products
	where
		symbol = @premium_currency
	if @premium_currency_id = NULL
	begin
		select
			@premium_currency_id = evaluation_currency_id
		from
			funds
		where
			fund_id = @fund_id
		if @premium_currency_id = NULL
		begin
			select
				status = "Error",
				message = "Unable to resolve premium currency"
			return
		end
	end

	exec
		j_nextkey
			"account_transactions",
			@account_transaction_id output

	select
		@quantity_sign = sign(@quantity)

	select
		@premium = abs(@premium) * @quantity_sign * -1.0
end


/* Tally all of the sub account trades and adjust the @quantity of top level trade */

if @apply_allocations = 'Y'
begin
	select
		@alloc_status_id = status_id
	from
		statuses
	where
		name = "Review"

	select
		@orig_trade_qty = @quantity,
		@orig_prem_qty = @premium

	insert into
		orig_deal_alloc_qty
	(
		deal_id,
		qty
	)
	values(
		@deal_id,
		@orig_trade_qty
	)

	declare sub_account_cursor cursor for
		select
			external_account_id,
			allocation
		from
			#master_sub_accounts
		where
			allocation != 0
		order by
			sub_account_id
	for read only
	
	open sub_account_cursor
	fetch sub_account_cursor into @tally_sub_acct_id, @tally_sub_acct_alloc
	
	while @@sqlstatus = 0 
	begin
		select 
			@tally_sub_acct_qty = 0
		select
			@tally_sub_acct_qty = @orig_trade_qty * @tally_sub_acct_alloc,
			@tally_sub_acct_prem = @orig_prem_qty * @tally_sub_acct_alloc,
			@tally_sub_acct_identifier = rtrim(@identifier) +"-"+convert(varchar(10), @tally_sub_acct_id)

		/* The master acct is the remainder account so reduce qty and prem for each sub alloc */
		select
			@quantity = @quantity - @tally_sub_acct_qty,
			@premium = @premium + @tally_sub_acct_prem
		/*
		select
                        @tally_sub_account_trader_id = a.trader_id
                from
                        traders a,
                        sub_accounts b
                where
                        a.external_account_id = b.external_account_id
                and
                        b.sub_account_id = @tally_sub_acct_id	
		*/

		select 
			@tally_sub_acct_trade_id = NULL


    		exec
        		j_nextkey
            			"trades",
            			@tally_sub_acct_trade_id output
	
		insert into
			queued_alloc_trades (
            			trade_id,
            			deal_id,
            			user_id,
            			trade_type_id,
            			internal_account_id,
            			external_account_id,
				master_external_account_id,
            			counterparty_id,
            			quantity,
            			contract_id,
            			value_date,
            			fixing_date,
            			price,
				mid_mark,
            			trade_date,
            			trader_id,
            			strategy_id,
            			status_id,
            			broker_id,
            			sales_code_id,
            			identifier,
            			pct_price,
            			spot_reference,
                        	premium_settle_date,
                        	premium_currency_id,
                        	premium)
		values(
        		@tally_sub_acct_trade_id,
			@deal_id,
			@tico_account_id,
			@trade_type_id,
			@internal_account_id,
			@tally_sub_acct_id,  /* allocation external_account */	
			@external_account_id, /* master external_account */
			@counterparty_id,
			@tally_sub_acct_qty, /* allocation qty */
			@contract_id,
			@value_date,
			@fixing_date,
			@price,
			@mid_mark,
			@trade_date,
			@trader_id,
			@strategy_id,
			@alloc_status_id,
			@broker_id,
			@sales_code_id,
			@tally_sub_acct_identifier, /* allocation identifier */
			@pct_price,
			@spot_reference,
                        @prem_settle_date,
                        @premium_currency_id,
                        @tally_sub_acct_prem)
    		if @@rowcount != 1
    		begin
				select
					status = "Error",
					message = "Failed to tally trade",
					status_name = "Unaggregated",
            				trade_id = @tally_sub_acct_trade_id,
            				deal_id = @deal_id,
            				trade_type_id = @trade_type_id,
            				internal_account_id = @internal_account_id,
            				external_account_id = @tally_sub_acct_id,  /* allocation external_account */
            				counterparty_id = @counterparty_id,
            				quantity = @tally_sub_acct_qty, /* allocation qty */
            				contract_id = @contract_id,
            				value_date = @value_date,
            				fixing_date = @fixing_date,
            				price = @price,
            				trade_date = @trade_date,
            				trader_id = @trade_id,
            				strategy_id = @strategy_id,
            				status_id = @alloc_status_id,
            				broker_id = @broker_id,
            				sales_code_id = @sales_code_id,
            				identifier = @tally_sub_acct_identifier, /* allocation identifier */
            				pct_price = @pct_price,
            				spot_reference = @spot_reference,
		                        prem_settl = @prem_settle_date,
                		        prem = @tally_sub_acct_prem

    		end
		
	
		fetch sub_account_cursor into @tally_sub_acct_id, @tally_sub_acct_alloc	
	end
	
	close sub_account_cursor
	deallocate sub_account_cursor

	select
		@working_status_id = status_id
	from
		statuses
	where
		name = "Working"

	if @allocation_mode_id = 3
	begin
		update 
			queued_alloc_trades
		set
			status_id = @working_status_id
		where
			deal_id = @deal_id
	
		exec
			fxa_tallyqueuedalloctrades
				@deal_id
	end
	


	/* Tally remainder trade if appicable */
	if @quantity != 0 and @allocation_mode_id != 3
	begin
		insert into
			queued_alloc_trades (
            			trade_id,
            			deal_id,
            			user_id,
            			trade_type_id,
            			internal_account_id,
            			external_account_id,
				master_external_account_id,
            			counterparty_id,
            			quantity,
            			contract_id,
            			value_date,
            			fixing_date,
            			price,
				mid_mark,
            			trade_date,
            			trader_id,
            			strategy_id,
            			status_id,
            			broker_id,
            			sales_code_id,
            			identifier,
            			pct_price,
            			spot_reference
        			)
			values(
        			@trade_id,
				@deal_id,
				@tico_account_id,
				@trade_type_id,
				@internal_account_id,
				@external_account_id,
				@external_account_id,
				@counterparty_id,
				@quantity,
				@contract_id,
				@value_date,
				@fixing_date,
				@price,
				@mid_mark,
				@trade_date,
				@trader_id,
				@strategy_id,
				@alloc_status_id,
				@broker_id,
				@sales_code_id,
				@identifier,
				@pct_price,
				@spot_reference)
        
    		if @@rowcount != 1
    		begin
				select
					status = "Error",
					message = "Failed to tally remainder trade",
					status_name = "Unaggregated",
            				trade_id = @trade_id,
            				deal_id = @deal_id,
            				trade_type_id = @trade_type_id,
            				internal_account_id = @internal_account_id,
            				external_account_id = @external_account_id,
            				counterparty_id = @counterparty_id,
            				quantity = @quantity,
            				contract_id = @contract_id,
            				value_date = @value_date,
            				fixing_date = @fixing_date,
            				price = @price,
            				trade_date = @trade_date,
            				trader_id = @trade_id,
            				strategy_id = @strategy_id,
            				status_id = @status_id,
            				broker_id = @broker_id,
            				sales_code_id = @sales_code_id,
            				identifier = @identifier,
            				pct_price = @pct_price,
            				spot_reference = @spot_reference
	        		return
    		end
	end
	
	select
		@quantity = @orig_trade_qty 
end

		
begin
	begin tran
		insert into
			trades (
            			trade_id,
            			deal_id,
            			user_id,
            			trade_type_id,
            			internal_account_id,
            			external_account_id,
            			counterparty_id,
            			quantity,
            			contract_id,
            			value_date,
            			fixing_date,
            			price,
            			trade_date,
            			trader_id,
            			strategy_id,
            			status_id,
            			broker_id,
            			sales_code_id,
            			identifier,
            			pct_price,
            			spot_reference
        			)
		values(
        		@trade_id,
			@deal_id,
			@tico_account_id,
			@trade_type_id,
			@internal_account_id,
			@external_account_id,
			@counterparty_id,
			@quantity,
			@contract_id,
			@value_date,
			@fixing_date,
			@price,
			@trade_date,
			@trader_id,
			@strategy_id,
			@status_id,
			@broker_id,
			@sales_code_id,
			@identifier,
			@pct_price,
			@spot_reference)
        	
    	if @@rowcount != 1
    	begin
        	rollback
			select
				status = "Error",
				message = "Failed to tally trade",
				status_name = "Unaggregated",
            			trade_id = @trade_id,
            			deal_id = @deal_id,
            			trade_type_id = @trade_type_id,
            			internal_account_id = @internal_account_id,
            			external_account_id = @external_account_id,
            			counterparty_id = @counterparty_id,
            			quantity = @quantity,
            			contract_id = @contract_id,
            			value_date = @value_date,
            			fixing_date = @fixing_date,
            			price = @price,
            			trade_date = @trade_date,
            			trader_id = @trade_id,
            			strategy_id = @strategy_id,
            			status_id = @status_id,
            			broker_id = @broker_id,
            			sales_code_id = @sales_code_id,
            			identifier = @identifier,
            			pct_price = @pct_price,
            			spot_reference = @spot_reference
        	return
    	end

        /* chriso: support for additional attributes for trades */
        insert into
		trade_attributes(
			trade_id,
			mid_mark,
			note
		)
	values(
		@trade_id,
		@mid_mark,
		@trade_note
	)
        if @@rowcount != 1
        begin
                rollback
                        select
                                status = "Error",
                                message = "Failed to add additional trade attributes",
				trade_id = @trade_id,
				mid_mark = @mid_mark,
				note = @trade_note
		return
	end

			
	
	/*	
    	insert into
		current_trade_identifiers
			(
				trade_id,
				broker_id,
				identifier
			)
    	values(
			@trade_id,
			@broker_id,
			@identifier
		)
	*/
	
        	
    	if @premium != NULL
	begin
				
			insert into
				account_transactions (
            		account_transaction_id,
                	entered_by,
                	external_account_id,
                	transaction_type_id,
                	transaction_date,
                	currency_id,
                	amount,
                	note
            	)
			values(
				@account_transaction_id,
				@tico_account_id,
				@external_account_id,
				@premium_transaction_type_id,
				@prem_settle_date,
       			     	@premium_currency_id,
				@premium,
				NULL)
	
			insert into
				account_transaction_trades (
            		account_transaction_id,
                	trade_id,
                	conversion_rate
            	)
			values(
				@account_transaction_id,
				@trade_id,
				1)
        	
	end
    	
    	/*
    	insert into
        	trade_matches (
            	trade_id
        	)
    	values (
        	@trade_id
    		)
    	if @@rowcount != 1
    	begin
        	rollback
        	select
            	status = "Error",
            	message = "Failed to insert into trade matches. Rolling back trade."
        	return
    	end
     	*/
	
	commit tran
end

go
