
if object_id("fxmc_fundtrades") != NULL
    drop procedure
        fxmc_fundtrades
go

create procedure
	fxmc_fundtrades
		@login varchar(50),
		@fund_name varchar(50)=NULL,
		@trade_date datetime=NULL,
		@since_trade_id int=NULL,
		@since_report_trade_id int=NULL
as


declare @begin_date datetime
declare @end_date datetime

if @since_trade_id = NULL
	select
		@since_trade_id = 0

if @since_report_trade_id = NULL
	select
		@since_report_trade_id = 0

if @trade_date = NULL
	select
		@trade_date = getdate()

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output

create table
	#report_commit_pbs(
		report_commit_id int,
		prime_broker_id int NULL)
insert into
	#report_commit_pbs(
		report_commit_id,
		prime_broker_id)
select
	a.report_commit_id,
	d.prime_broker_id
from
	report_commits a,
	fund_reports b,
	external_reports c,
	prime_brokers d
where
	a.fund_report_id = b.fund_report_id
and
	b.external_report_id = c.external_report_id
and
	c.source_id = d.source_id
and
	convert(char(11), a.trade_date, 1) = convert(char(11), @trade_date, 1)

create table
	#output(
		prime_broker_id int NULL,
		deal_id int NULL,
		deal_type_id int NULL,
		deal_status_id int NULL,
		trade_id int NULL,
		report_trade_id int NULL,
		trade_type_id int NULL,
		trade_date datetime NULL,
        user_id int NULL,
		internal_account_id int NULL,
		external_account_id int NULL,
		external_account_type_id int NULL,
		counterparty_id int NULL,
		contract_id int NULL,
		value_date datetime NULL,
		fixing_date datetime NULL,
		quantity numeric(30,4) NULL,
		price float NULL,
		trader_id int NULL,
		strategy_id int NULL,
		status_id int NULL,
		recon_status_id int NULL,
		broker_id int NULL,
		identifier varchar(50) NULL)

/* 
 * Calculate the #ext_trades (external only), #int_trades (internal only) and
 * #matches (internal/external matched) trade_id and report_trade_ids.
 */
    
/* 
 * FIND #ext_trades: All report_trades that fit within our time range and since
 * @since_report_trade_id. 
 */

create table
    #ext_trades (
        report_trade_id int
    )

insert into
    #ext_trades
select
    report_trade_id
from
    report_trades
where
    trade_date >= @begin_date
and
    trade_date < @end_date
and
    report_trade_id > @since_report_trade_id

/* 
 * FIND #int_trades: All trades that fit within our time range and since
 * @since_trade_id.
 */

create table
    #int_trades (
        trade_id int
    )

insert into
    #int_trades
select
    trade_id
from
    trades
where
    trade_date >= @begin_date
and
    trade_date < @end_date
and
    trade_id > @since_trade_id

/* 
 * FIND #int_trades: All matches for the day. Remove any matches from today that
 * are before our @since_trade_id and @since_report_trade_id
 */

create table
    #matches (
        report_trade_id int,
        trade_id int,
        status_id int
    )

insert into
    #matches
select
    a.report_trade_id,
    a.trade_id,
    a.status_id
from
    trade_matches a,
    trades b
where
    a.trade_id = b.trade_id
and
    b.trade_date >= @begin_date
and
    b.trade_date < @end_date
and (
        a.report_trade_id > @since_report_trade_id
    or
        a.trade_id > @since_trade_id
    )

/* 
 * DELETE #ext_trades: that are in our matches list to convert this into an
 * external only list
 */

delete
    #ext_trades
from
    #ext_trades a,
    #matches b
where
    a.report_trade_id = b.report_trade_id

/* 
 * DELETE #int_trades: that are in our matches list to convert this into an
 * internal_only list.
 */

delete
    #int_trades
from
    #int_trades a,
    #matches b
where
    a.trade_id = b.trade_id

/* 
 * INSERT #output: External only trades from #ext_trades -> report_trades
 */
insert into
	#output(
		prime_broker_id,
		report_trade_id,
		trade_date,
		external_account_id,
		external_account_type_id,
		counterparty_id,
		contract_id,
		value_date,
		fixing_date,
		quantity,
		price,
		trader_id,
		strategy_id,
		status_id,
		broker_id,
		identifier)
select
	c.prime_broker_id,
	b.report_trade_id,
	b.trade_date,
	b.external_account_id,
	b.external_account_type_id,
	b.counterparty_id,
	b.contract_id,
	b.value_date,
	b.fixing_date,
	b.quantity,
	b.price,
	b.trader_id,
	b.strategy_id,
	b.status_id,
	b.broker_id,
	b.reporter_identifier
from
    #ext_trades a,
    report_trades b,
    #report_commit_pbs c
where
    a.report_trade_id = b.report_trade_id
and
	b.report_commit_id = c.report_commit_id

/*
 * INSERT #output: Internal only trades from #int_trades -> trades
 */
insert into
	#output(
		deal_id,
		trade_id,
		trade_date,
        user_id,
        trade_type_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		contract_id,
		value_date,
		fixing_date,
		quantity,
		price,
		trader_id,
		strategy_id,
		status_id,
		broker_id,
		identifier)
select
	b.deal_id,
	b.trade_id,
	b.trade_date,
    b.user_id,
    b.trade_type_id,
	b.internal_account_id,
	b.external_account_id,
	b.counterparty_id,
	b.contract_id,
	b.value_date,
	b.fixing_date,
	b.quantity,
	b.price,
	b.trader_id,
	b.strategy_id,
	b.status_id,
	b.broker_id,
	b.identifier
from
    #int_trades a,
	trades b
where
    a.trade_id = b.trade_id

/*
 * INSERT #output: Matched trades from #matches -> trades
 */
insert into
	#output(
		deal_id,
		trade_id,
        report_trade_id,
		trade_date,
        user_id,
        trade_type_id,
		internal_account_id,
		external_account_id,
		counterparty_id,
		contract_id,
		value_date,
		fixing_date,
		quantity,
		price,
		trader_id,
		strategy_id,
		status_id,
		broker_id,
		identifier,
        recon_status_id)
select
	b.deal_id,
	b.trade_id,
    c.report_trade_id,
	b.trade_date,
    b.user_id,
    b.trade_type_id,
	b.internal_account_id,
	b.external_account_id,
	b.counterparty_id,
	b.contract_id,
	b.value_date,
	b.fixing_date,
	b.quantity,
	b.price,
	b.trader_id,
	b.strategy_id,
	b.status_id,
	b.broker_id,
	b.identifier,
    a.status_id
from
    #matches a,
	trades b,
    report_trades c
where
    a.trade_id = b.trade_id
and
    a.report_trade_id = c.report_trade_id

update
	#output
set
	a.deal_type_id = b.deal_type_id,
    a.deal_status_id = b.status_id
from
	#output a,
	deals b
where
	a.deal_id = b.deal_id
		
update
	#output
set
	a.external_account_type_id = b.external_account_type_id
from
	#output a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#output
set
	a.prime_broker_id = b.prime_broker_id
from
	#output a,
	external_account_prime_brokers b
where
	a.external_account_id = b.external_account_id

select
    *
from
    #output
order by
    trade_id

go
	

