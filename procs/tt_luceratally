drop procedure
	tt_luceratally
go

create procedure
        tt_luceratally
                @agent varchar(50),
                @source varchar(50),
                @default_login varchar(50),
		@identifier_prefix varchar(50),
                @sender_comp varchar(50),
                @target_comp varchar(50),
                @account varchar(50), 
                @exec_broker varchar(50)=NULL,
                @transaction_time datetime,
                @trade_date datetime,
                @trading_day datetime,
                @execution_id varchar(100),
                @order_id varchar(100),
                @client_order_id varchar(100),
		@cfs_entity varchar(50),
		@cfs_entity_type varchar(50), /* 'L' for LP or 'C' for Client */
                @cfs_trade_link varchar(50),
		@cfs_trade_date varchar(50),
		@cfs_strategy varchar(50)=NULL,
		@cfs_grouping_id varchar(50)=NULL,
                @symbol varchar(50),
                @ccy1 varchar(10),
                @ccy2 varchar(10),
                @value_date datetime,
                @side varchar(10),
                @qty1 numeric(30, 4),
                @qty2 numeric(30, 4),
                @price float,
                @ord_qty1 float=NULL,
                @ord_qty2 float=NULL,
                @leaves_qty float=NULL,
                @cum_qty float=NULL,
                @last_qty float=NULL,
                @avg_price float=NULL,
                @last_price float


as

/*
select
	agent=@agent,
	source=@source,
	default_login=@default_login,
	identifier_prefix=@identifier_prefix,
	sender_comp=@sender_comp,
	target_comp=@target_comp,
	account=@account,
	exec_broker=@exec_broker,
	transaction_time=@transaction_time,
	trade_date=@trade_date,
	trading_day=@trading_day,
	execution_id=@execution_id,
	order_id=@order_id,
	client_order_id=@client_order_id,
	cfs_entity=@cfs_entity,
	cfs_entity_type=@cfs_entity_type,
	cfs_trade_link=@cfs_trade_link,
	symbol=@symbol,
	ccy1=@ccy1,
	ccy2=@ccy2,
	value_date=@value_date,
	side=@side,
	qty1=@qty1,
	qty2=@qty2,
	price=@price,
	ord_qty1=@ord_qty1,
	ord_qty2=@ord_qty2,
	leaves_qty=@leaves_qty,
	cum_qty=@cum_qty,
	last_qty=@last_qty,
	avg_price=@avg_price,
	last_price=@last_price
*/


declare @committed_status_id int
declare @dont_tally_salescode_id int
declare @trade_type varchar(25)
declare @deal_type varchar(25)
declare @broker varchar(25)
declare @counterparty varchar(25)
declare @external_account varchar(25)
declare @trader varchar(25)
declare @aggregation_style varchar(25)
declare @external_account_type varchar(25)
declare @trade_id int
declare @deal_id int
declare @quoted_price float
declare @inverted char(1)
declare @trade_identifier varchar(100)
declare @deal_exec_symbol varchar(100)
declare @trade_type_id int
declare @deal_type_id int
declare @deal_status_id int
declare @trader_login varchar(50)
declare @trader_id int
declare @cpty_ext_acct_id int
declare @counterparty_id int
declare @external_account_id int
declare @last_spot_rate float

declare @clientormarket char(1)
declare @lookup_cpty varchar(50)
declare @lookup_trader varchar(50)

declare @tally_status varchar(15)
declare @tally_status_message varchar(25)


declare @substring1 varchar(3)
declare @substring2 varchar(3)

declare @suppress_trade char(1)
declare @suppressed_trade_id int
declare @suppressed_deal_id int
declare @source_id int
declare @contract_id int

declare @trigger_symbol varchar(50)
declare @cl_create char(1)
declare @lp_create char(1)



declare @auto_b2b_deal_status_id int
declare @auto_b2b_deal_type_id int
declare @auto_b2b_deal_id int

declare @original_exec_id varchar(100)

select
	@original_exec_id = @execution_id

select
	@broker = "Lucera",
	@trade_type = "Spot",
	@quoted_price = @price,
	@last_spot_rate = @price,
	@execution_id = @execution_id+"-"+rtrim(@cfs_trade_link)


/*
 * LOOKUP @committed_status_id
 */
select
    @committed_status_id = status_id
from
    statuses
where
    name = "Committed"

if @committed_status_id = NULL
begin
    select
        status = "Error",
        message = "No status named, 'Committed'"
    return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin	
	select
		error = "ERROR",
		msg = "source not found - " + @source
	return
end


/*
 * MARK ticket at client or market trade
 */
if @cfs_entity_type = "C"
begin
	select
		@clientormarket = "C",
		@lookup_trader = @cfs_entity,
		@lookup_cpty = @sender_comp
        
end
else if  @cfs_entity_type = "L"
begin
	select
		@clientormarket = "M",
		@lookup_cpty = @cfs_entity,
		@lookup_trader = @sender_comp
	
end
else
begin
	select
		error = "ERROR",
		msg = "Problem determining client or market from tag 10004 @cfs_entity_type",
		cfs_entity_type = @cfs_entity_type
	return
end


	


/*
 * LOOKUP @trader_id, @trader, @trader_login, @external_account_id 
 */ 
declare @trader_login_id int

select
	@trader_id = a.trader_id,
	@trader = a.symbol,
	@trader_login_id = a.tico_account_id,
	@external_account_id = a.external_account_id
from
        traders a,
        trader_symbols b
where    
        a.trader_id = b.trader_id
and
        b.source_id = @source_id
and
        b.symbol = @lookup_trader
if @trader_id = NULL
begin
    select
            @trader_id = a.trader_id,
            @trader = a.symbol,
            @trader_login_id = a.tico_account_id,
            @external_account_id = a.external_account_id
    from
            traders a
    where    
            a.symbol = @lookup_trader
    if @trader_id = NULL
    begin
	select
            status = "Error",
            message = "Couldn't find trader and user for @lookup_trader, '" + @lookup_trader + "'",
            lookup_trader = @lookup_trader
        return
    end		
end

        select
                @trader_login = login
        from
                tico_accounts
        where
                account_id = @trader_login_id
        if @trader_login = NULL
        begin
                select
                        status = "Error",
                        message = "Problem determining login from trader",
                        trader = @trader,
                        lookup_trader = @lookup_trader
                return
        end


select 
	@suppress_trade = "N"

select
	@suppress_trade = "Y"
from
	suppression_symbols
where
	source_id = @source_id 
and
	symbol = @lookup_trader


/*
* CHECK to see if this requires a manufactured B2B
*/
select 
	@cl_create = cl_create,
	@lp_create = lp_create
from 
	ticket_creation_values 
where 
	trigger_symbol = @lookup_trader
and
 	source_id = @source_id
if @@rowcount != 0
begin
       	select
               	@trigger_symbol = @lookup_trader
end


/*
 * LOOKUP @counterparty_id, @counterparty_symbol, @cpty_ext_acct_id from @lookup_cpty
 */

select
	@counterparty_id = a.counterparty_id,
	@counterparty = a.name,
	@cpty_ext_acct_id = a.external_account_id
from
        counterparties a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id
and
        b.symbol = @lookup_cpty
if @counterparty = NULL
begin
        select
                @counterparty_id = a.counterparty_id,
		@counterparty = a.name,
		@cpty_ext_acct_id = a.external_account_id
        from
                counterparties a
        where
                a.name = @lookup_cpty
        if @counterparty = NULL
        begin
                select
                        status = "Error",
                        message = "Couldn't find counterparty for @lookup_cpty, '" + @lookup_cpty + "'",
			lookup_cpty = @lookup_cpty
                return
        end
end

if @side = "SELL"
begin
    select
        @qty1 = -@qty1
end


/* 
 * DETERMINE other values based of client or market
 */

if @clientormarket = "C"  /* CLIENT */
begin
	select
		@trade_identifier = rtrim(@identifier_prefix) + @execution_id +".c",
		@deal_exec_symbol = rtrim(@identifier_prefix) + @cfs_grouping_id, 
                @deal_type = "B2B Forward",
		@qty1 = -@qty1 /* Flip qty because ticket is from perpective of client. So client BUY is really agency/fund SELL */
end
if @clientormarket = "M"  /* COUNTERPARTY */
begin
        select
                @trade_identifier = rtrim(@identifier_prefix) + @original_exec_id + ".m",
		@deal_exec_symbol = rtrim(@identifier_prefix) + @cfs_grouping_id, 
                @deal_type = "B2B Forward"
		/* @qty1 = -@qty1 /* Flip qty because ticket is from perpective of client. So client BUY is really agency/fund SELL */  */
		
	
	/*
 	 * OVERWRITE @external_account_id from @cpty_ext_acct_id if this is a street trade
 	 */ 
	select
		@external_account_id = @cpty_ext_acct_id
end


/*
 * LOOKUP @external_account, @external_account_type based on @external_account_id
 */
select
    @external_account = a.symbol,
    @external_account_type = b.name,
    @aggregation_style = c.name
from
    external_accounts a,
    external_account_types b,
    aggregation_styles c
where
    a.external_account_type_id = b.external_account_type_id
and
    a.aggregation_style_id = c.aggregation_style_id
and
    a.external_account_id = @external_account_id
if @external_account = NULL
begin
	select
		status = "Error",
		message = "Couldn't find external_account from @external_account_id",
		external_account_id = @external_account_id
	return
end



/* 
 * If the dealt currency is CCY2 (eg. dealt JPY for symbol USDJPY), then look up
 * the CCY2CCY1 symbol (eg. JPYUSD). Price and quantity are in terms of this.
 *
 *New Code to support SFX change on 3/09/12.  WD
 */

if @ccy1 != NULL and @ccy2 != NULL and @symbol = @ccy2 + @ccy1
begin
    select
        @symbol = @ccy1 + @ccy2,
	@inverted = "Y"
end


if @ccy1 != NULL and @ccy2 = NULL
begin
	select
		@substring1 = substring(@symbol, 1, 3),
		@substring2 = substring(@symbol, 4, 6)
	
	if @substring1 != @ccy1
	begin
		select
			@symbol = @substring2 + @substring1,
			@inverted = "Y"
	end
	
end



select
        @contract_id = contract_id
from
        contracts
where
        symbol = @symbol

if @contract_id = NULL
begin
	select
		message = "Contract not found",
		contract = @symbol,
		action = "Fetching contract from contracts db with r_addbatchfwdsubscription"
	
	
	declare @evaluation_currency varchar(50)
        declare @fund_id int

        exec
        	r_defaultfundforlogin
                	@default_login,
                	@fund_id output

        select
        	@evaluation_currency = a.symbol
        from
        	products a,
        	funds b
        where
        	a.product_id = b.evaluation_currency_id 
	and
		b.fund_id=@fund_id
  
        exec r_addbatchfwdsubscription
                        @default_login,
                        @symbol,
                        @ccy1,
                	@ccy2,
                        @evaluation_currency 

        /* @waitfor_delay = "HH:MM:SS.00"*/
	declare @waitfor_delay char(11)
	select
		@waitfor_delay = "00:00:03.00"
        /* sleep for 3 second */

	select 
		action = "Sleeping @waitfor_delay and checking for contract again",
		waitfor_delay = @waitfor_delay

        waitfor delay @waitfor_delay

        if not exists (select contract_id from contracts where symbol=@symbol)
        begin
                select
                        status = "Error",
                        message = "Contract not found",
                        symbol=@symbol
                return
        end
	select "Contract Successfully Created"
end


/* 
* INSERT contract_price_styles if this contract is inverted and we don't have
* any contract price styles set up yet.
*/
if @inverted = "Y" and not exists(
 	select
        	c.*
    	from
        	contracts a,
        	contract_price_styles b,
        	price_styles c
    	where
        	a.contract_id = b.contract_id
    	and
        	b.price_style_id = c.price_style_id
    	and
        	a.symbol = @symbol
    	and
        	c.name = "Inverted"
	)
begin
    		
    	insert into
       		contract_price_styles (
           		contract_id,
           		price_style_id,
           		factor
       		)
    	select
       		a.contract_id,
       		b.price_style_id,
       		1.0
    	from
       		contracts a,
       		price_styles b
   	where
       		a.symbol = @symbol
	and
       		b.name = "Inverted"
   	
end


select
	@deal_id = deal_id
from
	deal_exec_symbols
where
	symbol = @deal_exec_symbol

if @deal_id = NULL and @suppress_trade = "N"
begin
	select
		msg = "Creating new deal"
	
	select
		@deal_status_id = status_id
	from
		statuses
	where
		name = "User Review"
	if @deal_status_id = NULL
	begin
		select
			status = "Error",
			message = "No status found named, 'User Review'"
		return
	end
	select
		@deal_type_id = deal_type_id
	from
		deal_types
	where
		name = @deal_type
	if @deal_type_id = NULL
	begin
		select
			status = "Error",
			message = "No deal type found for @deal_type",
			deal_type = @deal_type
		return	
	end

	exec
		j_nextkey
			"deals",
			@deal_id output

	insert into
		deals(
			deal_id,   
			deal_type_id,
			timestamp,  
			status_id  
		 	)      
		values( 
			@deal_id,
			@deal_type_id,
			getdate(),
			@deal_status_id
			)
    
    insert into
		deal_exec_symbols
	values(
		@deal_id,
		@deal_exec_symbol
    )
end
else if @deal_id != NULL and @suppress_trade = "N"
begin
	select
		msg = "Appending to existing deal"

	/*  Below to support management of deal_type. 
	    This tally is currently purposed for B2B deals. This will be inserted B2B */	
	/*
        select
                @deal_type_id = deal_type_id
        from
                deal_types
        where
                name = @deal_type
        if @deal_type_id = NULL
        begin
                select
                        status = "Error",
                        message = "No deal type found for",
			deal_type = @deal_type
                return
        end

	update
		deals
	set
		deal_type_id = @deal_type_id
	where
		deal_id = @deal_id
	*/
end

if @suppress_trade = "Y"
begin
exec
	fxa_suppresstrade	
                @login = @default_login,
                @source = @source,
                @suppressed_trade_id = @suppressed_trade_id out,
                @deal_id = @suppressed_deal_id out,
		@deal_identifier = @deal_exec_symbol,
                @tally_type = @trade_type,
                @deal_type = @deal_type,
                @trade_type = @trade_type,
                @external_account = @external_account,
                @counterparty = @counterparty,
                @quantity = @qty1,
                @symbol = @symbol,
                @value_date = @value_date,
                @price = @price,
                @trade_date = @trade_date,
                @trader = @trader,
                @broker = @broker,
      		@identifier = @trade_identifier,
                @spot_reference = @last_spot_rate
	if @suppressed_trade_id = NULL
        begin
                select
                        status = "Error",
                        message = "Failed to suppress trade"
        end
        select
                status = "Suppressed",
                message = "Trade successfully suppressed",
                trade_id = @suppressed_trade_id,
                deal_id = @suppressed_deal_id,
                account = @external_account,
                symbol = @symbol,
                quantity = @qty1,
                price = @price,
                val_date = @value_date
        return
end

else		
begin
	exec
		fxa_tallytrade
			@login = @trader_login,
			@source = @source,
			@trade_id = @trade_id out,
			@deal_id = @deal_id out,
			@tally_type = @trade_type,
			@deal_type = @deal_type,
			@trade_type = @trade_type,
			@external_account = @external_account,
			@counterparty = @counterparty,
			@quantity = @qty1,
			@symbol = @symbol,
			@value_date = @value_date,
			@price = @price,
			@trade_date = @trade_date,
			@trader = @trader,
			@broker = @broker,
			@identifier = @trade_identifier,
			@spot_reference = @last_spot_rate,
			@strategy=@cfs_strategy

end

if @trade_id = NULL
begin
	select
		status = "Error",
		message = "Failed to tally trade"
	select
		@tally_status = "Failed",
		@tally_status_message = "Failed to tally trade"
end
else
begin


	insert into
		trade_quoted_prices (	trade_id,
					price)
		values(
			@trade_id,
			@quoted_price
			)

	declare @bd datetime
	declare @ed datetime

	select @bd = getdate()

	exec
		r_inserttradenotification
					@trade_id

	select @ed = getdate()
	select "msg"="r_inserttn runtime", "ss"=datediff(ss, @bd, @ed), "ms"=datediff(ms, @bd, @ed)



	/* Generally, we should not be creating new tickets if we are suppressing the trade above*/
	if @cl_create = "Y" or @lp_create = "Y"
	begin
		if @cl_create = "Y"
		begin
			declare @t2_cl_ext_account varchar(50)
			declare @t2_cl_trader varchar(50)
			declare @t2_cl_counterparty varchar(50)
			declare @t2_cl_trade_id int
			declare @t2_cl_identifier varchar(100)
			declare @t2_cl_quantity numeric(30, 4)
			declare @t2_cl_inv_qty char(1)
				
			select
				@t2_cl_ext_account = cl_ext_account,
				@t2_cl_trader = cl_trader,
				@t2_cl_counterparty = cl_counterparty,
				@t2_cl_inv_qty = cl_inv_qty
			from
				ticket_creation_values
			where
	        		trigger_symbol = @trigger_symbol
	
			select
				@t2_cl_identifier = rtrim(@trade_identifier)+".t2cl_autob2b",
                       		@t2_cl_quantity = @qty1
	
				
			if @t2_cl_inv_qty = "Y"
			begin
				select
					@t2_cl_quantity = -@qty1 
			end
	
			exec
				fxa_tallytrade
					@login = @trader_login,
					@source = @source,
					@trade_id = @t2_cl_trade_id out,
					@deal_id = @deal_id out,
					@tally_type = @trade_type,
					@deal_type = @deal_type,
					@trade_type = @trade_type,
					@external_account = @t2_cl_ext_account,
					@counterparty = @t2_cl_counterparty,
					@quantity = @t2_cl_quantity,
					@symbol = @symbol,
					@value_date = @value_date,
					@price = @price,
					@trade_date = @trade_date,
					@trader = @t2_cl_trader,
					@broker = @broker,
					@identifier = @t2_cl_identifier,
					@spot_reference = @last_spot_rate
	
	
			if @t2_cl_trade_id = NULL
			begin
    				select
       					status = "Error",
       					message = "Failed to tally trade"
    				return
			end
		
	
			exec
   					r_inserttradenotification
       					@t2_cl_trade_id
	
			select
       				status = "Tallied",
       				message = "Trade successfully tallied",
       				trade_id = @t2_cl_trade_id,
       				deal_id = @deal_id,
       				account = @t2_cl_ext_account,
       				symbol = @symbol,
       				quantity = @t2_cl_quantity,
       				price = @price,
       				val_date = @value_date
 	
			
	
		end
		if @lp_create = "Y"
		begin
        		declare @t2_lp_ext_account varchar(50)
               		declare @t2_lp_trader varchar(50)
               		declare @t2_lp_counterparty varchar(50)
               		declare @t2_lp_trade_id int
               		declare @t2_lp_identifier varchar(100)
               		declare @t2_lp_quantity numeric(30, 4)
			declare @t2_lp_inv_qty char(1)
                	declare @t2_deal_id int
	
               		select
                       		@t2_lp_ext_account = lp_ext_account,
                       		@t2_lp_trader = lp_trader,
                       		@t2_lp_counterparty = lp_counterparty,
				@t2_lp_inv_qty = lp_inv_qty
               		from
                       		ticket_creation_values
               		where
                       		trigger_symbol = @trigger_symbol
	
               		select
                       		@t2_lp_identifier = rtrim(@trade_identifier)+".t2lp_autob2b",
				@t2_lp_quantity = @qty1
	
               		if @t2_lp_inv_qty = "Y"
               		begin
                       		select
                               		@t2_lp_quantity = -@qty1
               		end
			
			if @cl_create = "Y"
			begin
				select
					@t2_deal_id = @auto_b2b_deal_id
			end
			else
			begin
				select
					@t2_deal_id = @deal_id
			end
               		exec
                       		fxa_tallytrade
                               		@login = @trader_login,
                               		@source = @source,
                               		@trade_id = @t2_lp_trade_id out,
                               		@deal_id = @t2_deal_id out,
                               		@tally_type = @trade_type,
                               		@deal_type = @deal_type,
                               		@trade_type = @trade_type,
                               		@external_account = @t2_lp_ext_account,
                               		@counterparty = @t2_lp_counterparty,
                               		@quantity = @t2_lp_quantity,
                               		@symbol = @symbol,
                               		@value_date = @value_date,
                               		@price = @price,
                               		@trade_date = @trade_date,
                               		@trader = @t2_lp_trader,
                               		@broker = @broker,
                               		@identifier = @t2_lp_identifier,
                               		@spot_reference = @last_spot_rate
	
	
               		if @t2_lp_trade_id = NULL
               		begin
                       		select
                               		status = "Error",
                               		message = "Failed to tally trade"
                       		return
               		end
	
	
               		exec
                       		r_inserttradenotification
                               		@t2_lp_trade_id
	
               		select
                       		status = "Tallied",
                       		message = "Trade successfully tallied",
                       		trade_id = @t2_lp_trade_id,
                       		deal_id = @t2_deal_id,
                       		account = @t2_lp_ext_account,
                       		symbol = @symbol,
                       		quantity = @t2_lp_quantity,
                       		price = @price,
                       		val_date = @value_date
	
		end
	end
	

	/* 
 	* AUTOCOMMIT
 	*
 	* If there is a client trade in this deal and the account type is set for
 	* Autocommit, then push through this deal automatically.
 	*/
	if @deal_id != NULL and @clientormarket="C" and @aggregation_style = "Autocommit"
	begin
	
    	update
        	deals
    	set
        	status_id = @committed_status_id
    	where
        	deal_id = @deal_id
    	if @@rowcount != 1
    	begin
        	select
            	status = "Error",
            	message = "Failed to autocommit deal, " + convert(varchar(10), @committed_status_id) + ", for external account, '" + @external_account + "', an aggregation style, '" + @aggregation_style + "'"
    	end
	end
	else
	begin
    	select
        	message = "No autocommitted",
        	deal_id = @deal_id,
        	trade_id = @trade_id,
        	aggregation_style = @aggregation_style
	end

	 select
                @tally_status = "Tallied",
                @tally_status_message = "Trade successfully tallied"

end

select
	status = @tally_status,
	message = @tally_status_message,
    	trade_id = @trade_id,
    	deal_id = @deal_id,
	account = @external_account,
	counterparty = @counterparty,
	trader = @trader,
	symbol = @symbol,
	quantity = @qty1,
	price = @price,
	val_date = @value_date

exec 
	r_clientmarketalloc
		@deal_id

