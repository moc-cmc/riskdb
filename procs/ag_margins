
create or replace procedure
	ag_margins
		@login varchar(50),
		@prime_broker varchar(50)=NULL

as


declare @fund_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"account_overrides",
	"Account Margin Overrides",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"margin_schedule",
	"Margin Schedule",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"edit_margin",
	"Edit Product Margin",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"accounts",
	"Prime Broker Accounts",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)
--Adaptive Server has expanded all '*' elements in the following statement



select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"



exec
	r_defaultfundforlogin
		@login,
		@fund_id output


create table
	#prime_brokers(
		style varchar(250) NULL,
		prime_broker_id int,
		prime_broker varchar(50) NULL,
		accounts int NULL)
insert into
	#prime_brokers(
		prime_broker_id,
		accounts)
select
	prime_broker_id,
	count(external_account_id)
from
	external_account_prime_brokers
group by
	prime_broker_id

update
	#prime_brokers
set
	a.prime_broker = c.name
from
	#prime_brokers a,
	prime_brokers b,
	sources c
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = c.source_id

update
	#prime_brokers
set
	style = @style


update
	#prime_brokers
set
	style = @selected_style
where
	prime_broker = @prime_broker


select
	style = @style,
	account_overrides = "Override margin schedule for account"

select
	section = "Prime Brokers",
	style,
	prime_broker,
	margin_schedule = "Schedule",
	accounts
from
	#prime_brokers
order by
	prime_broker


select
	section = "Products",
	style = @style,
	prime_broker = d.name,
	product = b.symbol,
	a.margin,
	edit_margin = "EDIT"
from
	product_margins a,
	products b,
	prime_brokers c,
	sources d
where
	a.product_id = b.product_id
and
	a.prime_broker_id = c.prime_broker_id
and
	c.source_id = d.source_id
and
	d.name = @prime_broker
order by
	d.name,
	b.symbol

go
