use
	risk_sjm_dev
go

drop procedure
	ag_addallocationrequest
go

create procedure
	ag_addallocationrequest
		@login varchar(50),
		@sub_account varchar(50),
		@product varchar(50),
		@amount float
as

declare @new_status_id int
declare @allocation_request_id int
declare @tico_account_id int
declare @fo_sub_account_id int
declare @product_id int


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

create table
	#external_accounts(
		external_account_id int,
		symbol varchar(50))
insert into
	#external_accounts(
		external_account_id,
		symbol)
select
	a.external_account_id,
	a.symbol
from
	external_accounts a,
	fo_sub_accounts b,
	bo_master_accounts c,
	legal_entity_tico_accounts d
where
	a.external_account_id = b.external_account_id
and
	b.bo_master_account_id = c.bo_master_account_id
and
	c.legal_entity_id = d.legal_entity_id
and
	d.tico_account_id = @tico_account_id

select
	@fo_sub_account_id = a.fo_sub_account_id
from
	fo_sub_accounts a,
	#external_accounts b
where
	a.external_account_id = b.external_account_id
and
	b.symbol = @sub_account
if @fo_sub_account_id = NULL
begin
	select
		status = "Sub account not found",
		sub_account = @sub_account
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

select
	@new_status_id = status_id
from
	statuses
where
	name = "New"
if @new_status_id = NULL
begin
	select
		status = "Error",
		mesage = "Problem finding New status"
	return
end

exec
	j_nextkey
		"allocation_requests",
		@allocation_request_id output

insert into
	allocation_requests(
		allocation_request_id,
		requestor_id,
		status_id,
		fo_sub_account_id,
		product_id,
		amount,
		request_date)
values(
	@allocation_request_id,
	@tico_account_id,
	@new_status_id,
	@fo_sub_account_id,
	@product_id,
	@amount,
	getdate())


exec
	ag_tradingaccountallocshome
		@login = @login

go
