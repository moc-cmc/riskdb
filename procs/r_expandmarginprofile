drop procedure
	r_expandmarginprofile
go

create procedure	
	r_expandmarginprofile
		@login varchar(50)

as

declare @is_admin varchar(1)
declare @admin_id int
declare @tico_account_id int

create table
        #meta(
                meta_type char(200),
                name char(30),
                action char(200) NULL,
                value char(255) NULL
)

insert into
        #meta
values(
        "Column Link",
        "view_profile",
        "View Margin Profile",
        NULL
)


insert into
        #meta
values(
        "Row Style",
        "style",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "back",
        "Manage Margin Profiles",
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "add_profile",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Link",
        "expand",
        NULL,
        NULL
)

insert into
        #meta
values(
        "Column Hidden",
        "margin_profile",
        NULL,
        NULL
)


select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login

select
	@admin_id = access_group_id
from
	access_groups
where
	name = "Admin"

select
	@is_admin = "Y"
from
	access_group_accounts
where
	tico_account_id = @tico_account_id
and
	access_group_id = @admin_id


/* CHECK TO SEE IF THIS REPORT IS ENABLED */
if @is_admin != "Y"
begin
        select
                section = "Access Not Permitted",
                message = "<b>Access Not Permitted</b>" + " must be an 'Admin' user to view this report. Please contact your internal ETG Business Relationship Manager to set you up with access"
        return
end


select
	back = "<< Back"

create table
	#margin_profiles(
		margin_profile_id int,
		margin_profile varchar(50) NULL,
		name varchar(50) NULL,
		currency_id int NULL,
		currency varchar(10) NULL,
		margin_model_id int NULL,
		margin_model varchar(50) NULL,
		notice_level float NULL,
		warning_level float NULL,
		blocked_level float NULL,
		multiplier float NULL,
		external_account_id int NULL,
		external_account varchar(50) NULL,
		counterparty_id int NULL,
		counterparty varchar(50) NULL,
		style varchar(50) NULL,
		view_profile varchar(25) NULL)

insert into
	#margin_profiles(
		margin_profile_id,
                name,
                currency_id,
		margin_model_id,
                notice_level,
                warning_level,
                blocked_level,
		multiplier,
		style,
		view_profile)
select
	margin_profile_id,
        name,
        currency_id,
	margin_model_id,
        notice_level,
        warning_level,
        blocked_level,
	multiplier,
	style =  "font-weight:bold;background:#FFFFFF;border: 1px solid white",
	view_profile = "VIEW"
from
	margin_profiles

insert into
	#margin_profiles(
		margin_profile_id,
		external_account_id)
select
	margin_profile_id,
	external_account_id
from
	margin_profile_accounts

insert into
	 #margin_profiles(
                margin_profile_id,
		counterparty_id)
select
	margin_profile_id,
	counterparty_id
from
	margin_profile_counterparties

update
	#margin_profiles
set
	margin_profile = b.name
from
	#margin_profiles a,
	margin_profiles b
where
	a.margin_profile_id = b.margin_profile_id

update
	#margin_profiles
set
	currency = b.symbol
from
	#margin_profiles a,
	products b
where
	a.currency_id = b.product_id

update
	#margin_profiles
set
	margin_model = b.name
from
	#margin_profiles a,
	margin_models b
where
	a.margin_model_id = b.margin_model_id


update
	#margin_profiles
set
	external_account = b.symbol /*,
	style =  "font-weight:bold;background:#FFFFFF;border: 1px solid white" */
from
	#margin_profiles a,
	external_accounts b
where
	a.external_account_id = b.external_account_id

update
	#margin_profiles
set
	counterparty = b.name /*,
	style =  "font-weight:bold;background:#FFFFFF;border: 1px solid white" */
from
	#margin_profiles a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
	#margin_profiles
set
	style = "color:#3D3D3D;background:#FFFFFF"
where
	name = NULL

select
        margin_profile,
	name,
        account = external_account,
        counterparty,
        currency,
	margin_model,
        notice_level,
        warning_level,
        blocked_level,
	multiplier,
	style,
	view_profile
from
	#margin_profiles
order by
	margin_profile ASC,
	name DESC
	
	
go
