drop procedure
	ag_queuedinterestmoves
go

create procedure
	ag_queuedinterestmoves
		@login varchar(50),
		@batch_id int

as

declare @total_style varchar(250)
declare @selected_style varchar(200)
declare @subtotal_style varchar(250)
declare @error_style varchar(250)
declare @style varchar(250)
declare @pb_style varchar(250)
declare @client_style varchar(250)

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"old_value_date",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"tally_queued",
	"Tally Queued Interest Transactions",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"create_swap",
	"UAT Create Swap Trade",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"create_spot",
	"UAT Create Spot Trade",
	NULL) 

insert into
	#meta
values(
	"Column Format",
	"price",
	"Number",
	"#,##0.000000;<span style=""color:red"">(#,##0.00)</span>")

insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

select * from #meta

select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold",
	@pb_style = "background:#F2F2E4;border: 1px solid white;font-weight:bold",
	@client_style = "background:#E4E4F2;border: 1px solid white;font-weight:bold"


select
	style = @style,
	a.queued_transaction_id,
	entered_by = b.login,
	account = c.symbol,
	transaction_type = d.name,
	a.transaction_date,
	currency = e.symbol,
	a.amount,
	a.note,
	a.balance,
	a.rate,
	a.days
from
	queued_transactions a,
	tico_accounts b,
	external_accounts c,
	transaction_types d,
	products e
where
	a.entered_by = b.account_id
and
	a.external_account_id = c.external_account_id
and
	a.transaction_type_id = d.transaction_type_id
and
	a.currency_id = e.product_id
and
	a.batch_id = @batch_id

select
	tally_queued = "Tally Queued Interest Rates",
	batch_id = @batch_id

go
