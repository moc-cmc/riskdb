
drop procedure
	api_setupticoclient
go

create procedure
	api_setupticoclient
		@login varchar(25),
		@server varchar(25),
		@uri varchar(100),
		@dbname varchar(15),
		@fund_name varchar(25),
		@theme varchar(100) = NULL
as

declare @group_id int
declare @group_connection_id int
declare @status_id int
declare @connection_info_id int
declare @connection_url varchar(100)
declare @markr_account_id int
declare @clientsetup_account_id int

if exists (select name from groups where name=@fund_name)
begin
	select
		status="Success",
		msg="Group Exists set up complete",
		fund_name=@fund_name

	return
end

select
	@status_id = status_id
from
	statuses
where
	name="Active"

if @@rowcount != 1
begin
	select 
		status="Error",
		msg="Status does not exist",
		status_name="Active"

	return
end

select
	@connection_info_id = connection_info_id
from
	connection_info
where
	name="RISK"

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Connection does not exist",
		connection="RISK"

	return
end

select
	@markr_account_id = account_id
from
	accounts
where
	login="markr"

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Login does not exist",
		login="markr"

	return
end

select 
	@clientsetup_account_id = account_id
from
	accounts
where
	login="clientsetup"

if @@rowcount != 1
begin
	select
		status="Error",
		msg="Login does not exist",
		login="clientsetup"
	return
end

if @theme = NULL
begin
	select
		@theme="ETG"
end

exec j_nextkey "groups", @group_id output
exec j_nextkey "group_connections", @group_connection_id output

select
	@connection_url = "jdbc:sybase:Tds:" + rtrim(@uri) + ":5000/" + rtrim(@dbname) + "?APPLICATIONNAME=TicoAgency"
begin tran

	insert into
		groups(
			group_id,
			name,
			title,
			status_id,
			default_theme)
	values
		(@group_id,
	 	@fund_name,
	 	@fund_name,
	 	@status_id,
	 	@theme)

	if @@rowcount != 1
	begin
		select
			status="Error",
			msg="Could not insert Group record",
			name=@fund_name
		
		rollback tran	
		return
	end

	insert into
		group_connections(
			group_connection_id,
			group_id,
			connection_info_id,
			server_name,
			database_name,
			login,
			password,
			connection_url)
	values
			(@group_connection_id,
	 		@group_id,
	 		@connection_info_id,
	 		@server,
	 		@dbname,
	 		'sa', 
	 		'b0ga$$',
	 		@connection_url)

	if @@rowcount != 1		
	begin
		select
			status="Error",
			msg="Could not insert Group Connection record",
			name=@fund_name
		
		rollback tran
		return
	end

	insert into
		group_accounts(
			group_id,
			account_id)
	values
		(@group_id,
		 @markr_account_id)

	if @@rowcount != 1
	begin
		select
			status="Error",
			msg="Could not insert login markr into group accounts",
			account_id=@markr_account_id	

		rollback tran
		return
	end

	insert into
		group_accounts(
			group_id,
			account_id)
	values
		(@group_id,
		 @clientsetup_account_id)

	if @@rowcount != 1
	begin
		select
			status="Error",
			msg="Could not insert login clientsetup into group accounts",
			account_id=@clientsetup_account_id

		rollback tran
		return
	end
	
commit tran

select
	status="Success",
	msg="Tico setup complete",
	fund_name=@fund_name	

return

go

