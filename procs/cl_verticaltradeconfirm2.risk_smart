
create or replace procedure
	cl_verticaltradeconfirm2
		@login varchar(30),
		@run_name varchar(50),
		@begin_date datetime=NULL,
		@end_date datetime=NULL,
		@trade_id int=NULL
as



declare @cancelled_count int
declare @traiana_id_prefix varchar(15)
declare @netlink_broker_id int
declare @boa_pb_id int
declare @usi_lookup varchar(15)

declare @run_id int
declare @tico_account_id int
declare @source_id int
declare @source varchar(50)
declare @date datetime
declare @trade_date datetime
declare @trade_type_id int
declare @trade_type varchar(50)
declare @exotic_instrument varchar(50)

declare @format_swaps varchar(1)
declare @query_options varchar(1)
declare @query_futures varchar(1)
declare @mark_to_market varchar(1)

declare @display_rate varchar(30)
declare @current_rate varchar(30)


select
	@format_swaps = "N",
	@query_options = "Y"

select
	@source = "Agency Client"

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		id = -1,
		error = "login not found"
	return
end

select
	@run_id = a.run_id
from
	user_runs a,
	runs b
where
	a.run_id = b.run_id
and
	b.name = @run_name
and
	a.tico_account_id = @tico_account_id
if @run_id = NULL
begin
	select
		id = -1,
		error = "No run configured for user"
	return
end


exec
    r_normalizedaterange
        @begin_date out,
        @end_date out

create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#traders
	select
		trader_id
	from
		traders

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts

create table
	#internal_accounts(
		internal_account_id int)
insert into
	#internal_accounts
select  
	internal_account_id
from    
	run_internal_accounts
where   
	run_id = @run_id 
if @@rowcount = 0
	insert into
		#internal_accounts
	select  
		internal_account_id
	from    
		internal_accounts

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#strategies
	select
		strategy_id
	from
		strategies


create table
	#brokers(
		broker_id int)
insert into
	#brokers
select
	broker_id
from
	run_brokers
where
	run_id = @run_id
if @@rowcount = 0
	insert into
		#brokers
	select
		broker_id
	from
		brokers

select
	@source_id = source_id
from
	sources
where
	name = "Agency Client"

create table
	#trades(
		trade_id int,
		deal_id int,
		trade_type_id int,
		trade_type varchar(25) NULL,
		deal_type_id int NULL,
		deal_type varchar(25) NULL,
		internal_account_id int,
		internal_account varchar(50) NULL,
		external_account_id int,
		external_account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(15) NULL,
		trader_id int,
		trader varchar(50) NULL,
		counterparty_id int,
		counterparty varchar(50) NULL,
                agency_vs_counterparty varchar(40) NULL,
		fund_agency_trade char(1) NULL,
		fund_agency_buy_sell varchar(8) NULL,
		client_buy_sell varchar(4) NULL,
		broker_id int,
		broker varchar(25) NULL,
		prime_broker_id int NULL,
		prime_broker varchar(30) NULL,
		ext_account_pb varchar(25) NULL,
		contract_id int,
		std_contract varchar(50) NULL,
		traded_ccy varchar(10) NULL,
                counter_ccy varchar(10) NULL,
		quantity float NULL,
		abs_qty float NULL,
		abs_counter_qty float NULL,
                abs_far_counter_qty float NULL,
		trade_date datetime,
		trade_day datetime NULL,
		value_date varchar(15) NULL,
		fixing_date varchar(15) NULL,
		db_price float,
		std_price float NULL,
		spot_reference float NULL,
		sales_code_id int,
		sales_code varchar(25) NULL,
		strategy_id int,
		strategy varchar(30) NULL,
		identifier varchar(100) NULL,
		deal_identifier varchar(80) NULL,
		deal_status_id int NULL,
		deal_status varchar(20) NULL,
		trade_status_id int,
		trade_status varchar(20) NULL,
		trade_notification_id int,
		notification_status_id int,
		notification_status varchar(25) NULL,
		notification_source_id int,
		notification_source varchar(40) NULL,
                source_trade_trade_id int NULL,
		source_trade_deal_id int NULL,
                trm_entity varchar(6) NULL,
		trm_product varchar(5) NULL,
		trm_fx_ndf varchar(10) NULL,
		trm_product_type varchar(10) NULL,
		trm_opt_delivery varchar(10) NULL,
		allocation varchar(30) NULL,
		/*- Futures info -*/
                fut_expiration datetime NULL,
                future_id int NULL,
                fut_forward_id int NULL,
                fut_contract varchar(15) NULL,
                fut_symbol varchar(25) NULL,
		fut_root_symbol varchar(4) NULL,
		fut_exchange_id int NULL,
		fut_exchange varchar(20) NULL,
		fut_contract_size float NULL,
		fut_tick_size float NULL,
		/*- Option info -*/
		option_premium float NULL,
		option_premium_percent float NULL,
		option_premium_ccy_id int NULL,
		option_premium_ccy varchar(5) NULL,
                premium_settle_date datetime NULL,
		option_settle_date datetime NULL,
		optcon_exercise_style_id int NULL,
		optcon_exercise_style varchar(10) NULL,
		optcon_strike numeric(30, 6) NULL,
		optcon_put_call varchar(4) NULL,
                option_expiration_id int NULL,
		optexp_symbol varchar(30) NULL,
		optexp_expiration datetime NULL,
		optexp_timezone_id int NULL,
		optexp_time_zone varchar(30) NULL,
		optexp_tz_symbol varchar(30) NULL,
		optexp_tz_expiration_time varchar(10) NULL,
		optexp_tz_display_value varchar(10) NULL,
		optexp_tz_status int NULL,
		option_id int NULL,
		opt_underlying_contract_id int NULL,
		opt_underlying_contract varchar(50) NULL,
		opt_exchange_id int NULL,
		opt_exchange varchar(25) NULL,
		opt_def_exercise_style_id int NULL,
		opt_def_exercise_style varchar(10) NULL,
		opt_quantity float NULL,
		opt_tick_size float NULL,
		/*- Exotic Info -*/
		e_timing_id int NULL,
                e_timing varchar(12) NULL,
                e_po_ccy_id int NULL, /* payout currency */
		e_po_ccy varchar(3) NULL, /* payout currency */
		e_po_amt float NULL, /* payout amount */
		e_bt_id int NULL, /* barrier type */
		e_bt varchar(12) NULL, /* barrier type */
		e_b float NULL, /* barrier */
		e_lb float NULL, /* lower_barrier */
		e_ub float NULL, /* upper_barrier */
                e_inst_id int NULL, /* instrument type id */
                e_inst varchar (20) NULL, /* instrument type */
                e_ud char(1) NULL, /* up or down */
                /*  n/a */
		/*- Swap Info -*/
		far_quantity float NULL,
		far_price float NULL,
		far_value_date datetime NULL,
		far_fixing_date datetime NULL,
		far_trade_notification_id int NULL,
                abs_far_qty float NULL,
		swap_symbol varchar(30) NULL,
		cl_or_lp varchar(4) NULL,
		old_qty_if_deleted float NULL,
                client_prime_broker varchar(20) NULL,
		trm_msg varchar(7) NULL,
		tr_usi varchar(25) NULL,
		far_tr_usi varchar(25) NULL,
                is_ndf char(1) NULL,
		is_inverted_contract char(1) NULL,
                product_id int NULL,
		currency_id int NULL,
                pd1_eq float NULL,
		pd2_eq float NULL,
		vo float NULL,
                vo_rate float NULL
		)


create nonclustered index 
	tmp_tid
on
	#trades(trade_id)


create table
	#trade_notifications(
		trade_notification_id int,
		trade_id int,
		source_id int,
		status_id int
		)

create nonclustered index
        tn_tid
on
        #trade_notifications(trade_id)


declare @active_status_id int
declare @edit_status_id int
declare @cancelled_status_id int
declare @cancelling_src_status_id int

select
	@active_status_id = status_id
from
	statuses
where
	name = "Active"
select
        @edit_status_id = status_id
from
        statuses 
where
        name = "Edit"
select
        @cancelled_status_id = status_id
from
        statuses 
where
        name = "Cancelled"


/*
| Insert into #trade_notifications anything with status_id "Active", "Edit", "Cancelled"
*/
insert into
	#trade_notifications
select
	trade_notification_id,
	trade_id,
	source_id,
	status_id
from
	trade_notifications
where
	status_id in(@active_status_id, @edit_status_id, @cancelled_status_id)
and
	source_id = @source_id


/*
| Insert *_ids into #trades that need to be notified if trade_id = NULL
*/
if @trade_id = NULL
begin
	insert into
		#trades(
			trade_id,
			deal_id,
			trade_type_id,
			internal_account_id,
			external_account_id,
			trader_id,
			counterparty_id,
			fund_agency_trade,
			contract_id,
			broker_id,
			quantity,
			trade_date,
			value_date,
			fixing_date,
			db_price,
			std_price,
			spot_reference,
			sales_code_id,
			strategy_id,
			identifier,
			trade_status_id,
			trade_notification_id,
			notification_status_id,
			notification_source_id,
			notification_source,
			abs_qty,
			cl_or_lp,
			abs_counter_qty)
	select 
		trade_id = a.trade_id,
		deal_id = a.deal_id,
		trade_type_id = a.trade_type_id,
		internal_account_id = a.internal_account_id,
		external_account_id = a.external_account_id,
		trader_id = a.trader_id,
		counterparty_id = a.counterparty_id,
        	fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
		contract_id = a.contract_id,
		broker_id = a.broker_id,
		quantity = a.quantity,
		trade_date = a.trade_date,
		value_date = convert(varchar(12), a.value_date, 112),
		fixing_date = convert(varchar(12), a.fixing_date, 112),
		db_price = a.price,
		std_price = a.price,
		spot_reference = a.spot_reference,
		sales_code_id = a.sales_code_id,
		strategy_id = a.strategy_id,
		identifier = a.identifier,
		trade_status_id = a.status_id,
		trade_notification_id = h.trade_notification_id,
		notification_status_id = h.status_id,
		notification_source_id = @source_id,
		notification_source = @source,
		abs_qty = abs(a.quantity),
		cl_or_lp = "LP",
		abs_counter_qty = round(abs(a.quantity) * a.price, 2)
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        	#trade_notifications h
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.trade_id = h.trade_id
	and
		a.trade_date >= @begin_date
	and
		a.trade_date < @end_date
end
else   /* Identical to above query with @trade_id qualifier*/
begin
	insert into
		#trades(
			trade_id,
			deal_id,
			trade_type_id,
			internal_account_id,
			external_account_id,
			trader_id,
			counterparty_id,
			fund_agency_trade,
			contract_id,
			broker_id,
			quantity,
			trade_date,
			value_date,
			fixing_date,
			db_price,
			std_price,
			spot_reference,
			sales_code_id,
			strategy_id,
			identifier,
			trade_status_id,
			trade_notification_id,
			notification_status_id,
			notification_source_id,
			notification_source,
			abs_qty,
			cl_or_lp,
			abs_counter_qty)
	select 
		trade_id = a.trade_id,
		deal_id = a.deal_id,
		trade_type_id = a.trade_type_id,
		internal_account_id = a.internal_account_id,
		external_account_id = a.external_account_id,
		trader_id = a.trader_id,
		counterparty_id = a.counterparty_id,
        	fund_agency_trade = "N", /* defaults to 'N', updated to 'Y' if fund_agency trade */
		contract_id = a.contract_id,
		broker_id = a.broker_id,
		quantity = a.quantity,
		trade_date = a.trade_date,
		value_date = convert(varchar(12), a.value_date, 112),
		fixing_date = convert(varchar(12), a.fixing_date, 112),
		db_price = a.price,
		std_price = a.price,
		spot_reference = a.spot_reference,
		sales_code_id = a.sales_code_id,
		strategy_id = a.strategy_id,
		identifier = a.identifier,
		trade_status_id = a.status_id,
		trade_notification_id = h.trade_notification_id,
		notification_status_id = h.status_id,
		notification_source_id = @source_id,
		notification_source = @source,
		abs_qty = abs(a.quantity),
		cl_or_lp = "LP",
		abs_counter_qty = round(abs(a.quantity) * a.price, 2)
	from
		trades a,
		#external_accounts b,
		#internal_accounts c,
		#traders d,
		#strategies e,
		#brokers f,
        	#trade_notifications h
	where
		a.external_account_id = b.external_account_id
	and
		a.internal_account_id = c.internal_account_id
	and
		a.trader_id = d.trader_id
	and
		a.strategy_id = e.strategy_id
	and
		a.broker_id = f.broker_id
	and
		a.trade_id = h.trade_id
	and
		a.trade_id = @trade_id
end


/*	
create table 
	#trade_edits
(
	trade_id int,
	quantity numeric(30, 2),
        price float,
	timestamp datetime
)
insert into
	#trade_edits
select
	b.trade_id,
	b.quantity,
	b.price,
	b.timestamp
from
	#trades a,
	trade_edits b
where
	a.trade_id = b.trade_id
and
	a.notification_status_id = @cancelled_status_id
if @@rowcount > 0
begin
	/* chriso: on cancel, this allows us to get the qty prior to edit. there may have been multiple edits
		   to avoid a loop, doing the below subquery */
	update
		#trades
	set
		quantity = b.quantity,
		abs_qty = abs(b.quantity),
		abs_counter_qty = abs(b.quantity) * b.price
	from
		#trades a,
		#trade_edits b
	where
		a.trade_id = b.trade_id
	and
		b.timestamp = (select max(c.timestamp) from #trade_edits c where c.trade_id = b.trade_id)
end
*/

/*
|  Adjust display prices to standard rate for all pairs
*/
update
    #trades
set
    std_price = case 
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.db_price) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.db_price) * d.factor
        when c.factor != NULL then
            a.db_price * c.factor * d.factor
        else
            a.db_price * d.factor
    end
from
    #trades a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id

if @format_swaps = "Y"
begin

	create table
		#swap_symbol_trades(
			trade_id int,
			swap_symbol varchar(50))
	insert into
		#swap_symbol_trades
	select
		a.trade_id,
		c.symbol
	from
		#trades a,
		swap_symbol_trades b,
		swap_symbols c
	where
		a.trade_id = b.trade_id
	and
		b.swap_symbol_id = c.swap_symbol_id

        /* chriso: citibank can not process NDF swaps, so if a swap has a fixing date, dont handle as a formatted swap
	if @format_ndf_swaps = "N"
        begin
		create table
			#remove_swaps(
				swap_symbol varchar(50)
			)
		insert into
			#remove_swaps
		select
			a.swap_symbol 
		from
			#swap_symbol_trades a,
			#trades b
		where
			a.trade_id = b.trade_id
		and
			b.fixing_date != NULL

		/* Join on swap symbol to ensure both legs are removed if 1 does not have a fixing date */
		delete from
			#swap_symbol_trades
		where
			swap_symbol in(select swap_symbol from #remove_swaps)
		
	end
	*/

	create table
        	#near_swap_trades(
                	trade_id int,
                	swap_symbol varchar(50))
	create table
        	#far_swap_trades(
                	trade_id int,
                	swap_symbol varchar(50),
                	far_quantity float,
			far_price float,
			far_value_date datetime,
			far_fixing_date datetime NULL,
			trade_notification_id int NULL,
			near_trade_id int NULL,
			far_tr_usi varchar(25) NULL,
			external_account_id int,
			far_db_price float)
	insert into
        	#near_swap_trades
	select
        	a.trade_id,
        	c.symbol
	from
        	#trades a,
        	#swap_symbol_trades b,
        	swap_symbols c,
        	trade_types d
	where
        	a.trade_id = b.trade_id
	and
        	b.swap_symbol = c.symbol
	and
		a.trade_type_id = d.trade_type_id
	and
        	d.name = "Swap Near"

	
	insert into
        	#far_swap_trades
	select
        	a.trade_id,
        	c.symbol,
		a.abs_qty,
		a.std_price,
		a.value_date,
		a.fixing_date,
		a.trade_notification_id,
		NULL,
		NULL,
		a.external_account_id,
		a.db_price
	from
        	#trades a,
        	#swap_symbol_trades b,
        	swap_symbols c,
		trade_types d
	where
        	a.trade_id = b.trade_id
	and
        	b.swap_symbol = c.symbol
	and
		a.trade_type_id = d.trade_type_id
	and
        	d.name = "Swap Far"

        update
		#far_swap_trades
	set
		far_tr_usi = rtrim(@usi_lookup)+rtrim(convert(varchar(15), a.trade_id))
	from
		#far_swap_trades a,
		reg_reporting_ext_accounts b
	where
		a.external_account_id = b.external_account_id

	update
		#far_swap_trades
	set
		near_trade_id = a.trade_id
	from
		#near_swap_trades a,
		#far_swap_trades b
	where
		a.swap_symbol = b.swap_symbol
	
	update
        	#trades
	set
        	far_quantity = a.far_quantity,
        	far_price = a.far_price,
        	far_value_date = a.far_value_date,
        	far_fixing_date = a.far_fixing_date,
		far_trade_notification_id = a.trade_notification_id,
		far_tr_usi = a.far_tr_usi,
        	abs_far_qty = abs(a.far_quantity),
                abs_far_counter_qty = round((abs(a.far_quantity) * a.far_db_price), 2)
	from
        	#far_swap_trades a,
        	#trades c
	where
        	a.near_trade_id = c.trade_id
	
	
	delete from
        	#trades
	from
        	#trades a,
        	#far_swap_trades b
	where
        	a.trade_id = b.trade_id

	/* TRML Spec says no fixing date to report on swaps */
	if @source like "%Traiana FTP%"
	begin
        	update
			#trades
		set
			fixing_date = NULL,
			far_fixing_date = NULL
		from
			#trades a,
			#swap_symbol_trades b
		where
			a.trade_id = b.trade_id
	end

end
	
/*
| Query deals
*/

update
	#trades
set
	deal_type_id = b.deal_type_id,
	deal_status_id = b.status_id
from
	#trades a,
	deals b
where
	a.deal_id =  b.deal_id

update
	#trades
set
	deal_identifier = b.symbol
from
	#trades a,
	deal_exec_symbols b
where
	a.deal_id =  b.deal_id

update
	#trades
set
	deal_type = b.name
from
	#trades a,
	deal_types b
where
	a.deal_type_id = b.deal_type_id

/*
| Query trade_types
*/
update
	#trades
set
	trade_type = b.name
from
	#trades a,
	trade_types b
where
	a.trade_type_id = b.trade_type_id


update
	#trades
set
	trade_type = b.symbol
from
	#trades a,
	trade_type_symbols b
where
	a.trade_type_id = b.trade_type_id
and
	b.source_id = @source_id


/*
| Query internal_accounts
*/

update
	#trades
set
	internal_account = b.symbol
from
	#trades a,
	internal_accounts b
where
	a.internal_account_id = b.internal_account_id


/*
| Query external_accounts
*/

update 
        #trades
set
        external_account = b.symbol,
	allocation = b.symbol,
	external_account_type_id = b.external_account_type_id
from
        #trades a,
        external_accounts b
where
        a.external_account_id = b.external_account_id

update
	#trades 
set
	external_account_type = b.name
from
	#trades a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id

update
	#trades
set
	external_account = b.symbol
from
	#trades a,
	external_account_symbols b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id

update
	#trades
set
	ext_account_pb = b.symbol
from
	#trades a,
	client_give_ups b
where
	a.external_account_id = b.external_account_id
and
	b.source_id = @source_id

update
        #trades
set
        client_prime_broker = e.symbol
from
        #trades a,
        client_give_ups  e
where
        a.external_account_id = e.external_account_id
and
        e.source_id = @source_id

update
        #trades
set
        client_prime_broker = e.symbol
from
        #trades a,
        counterparty_give_ups  e
where
        a.counterparty_id = e.counterparty_id
and
        e.source_id = @source_id
and
        client_prime_broker = NULL

	
/*
| Query traders
*/
update
	#trades
set
	trader = b.symbol
from
        #trades a,
        traders b
where
        a.trader_id = b.trader_id

update
        #trades
set
        trader = b.symbol
from
        #trades a,
        trader_symbols b
where
        a.trader_id = b.trader_id
and
        b.source_id = @source_id

/*
| Query counterparties
*/

update
	#trades
set
	counterparty = b.name,
	agency_vs_counterparty = b.name
from
	#trades a,
	counterparties b
where
	a.counterparty_id = b.counterparty_id

update
        #trades
set
        counterparty = b.symbol,
	agency_vs_counterparty = b.symbol
from
        #trades a,
        counterparty_symbols b
where
        a.counterparty_id = b.counterparty_id
and
        b.source_id = @source_id

update
	#trades
set
	fund_agency_trade = "Y",
	cl_or_lp = "CL",
	agency_vs_counterparty = a.external_account
from
	#trades a,
	fund_agency_counterparties b
where
	a.counterparty_id = b.counterparty_id


update
	#trades 
set
	allocation = b.symbol
from
	#trades a,
	external_accounts b,
	client_mkt_accounts c
where
	a.external_account_id = c.cl_external_account_id
and
	b.external_account_id = c.mkt_external_account_id


update
	#trades
set
	fund_agency_buy_sell = "SELL",
        client_buy_sell = "BUY"
where
	quantity < 0

update
        #trades
set
        fund_agency_buy_sell = "BUY",
	client_buy_sell = "SELL"
where
        quantity > 0

/*
| Query brokers
*/

update
	#trades
set
	broker = b.symbol
from
	#trades a,
	brokers b
where
	a.broker_id = b.broker_id

update
        #trades
set
        broker = b.symbol
from
        #trades a,
        broker_symbols b
where
        a.broker_id = b.broker_id
and
        b.source_id = @source_id

/*
| Query strategies
*/

update 
	#trades
set
	strategy = b.name
from
	#trades a,
	strategies b
where
	a.strategy_id = b.strategy_id

/* strategy_symbols does not exist */


/*
|  Query contracts, dealt ccy, counter ccy
*/
update 
	#trades
set
	std_contract = b.symbol,
        traded_ccy = g.symbol,
        counter_ccy = f.symbol
from
	#trades a,
	contracts b,
	forwards e,
	products f,
	products g
where
	a.contract_id = b.contract_id
and
	b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#trades
set
	std_contract = rtrim(a.counter_ccy)+rtrim(a.traded_ccy)
from
	#trades a,
	contracts b,
	contract_price_styles c,
	price_styles d
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.price_style_id = d.price_style_id
and
	d.name = "Inverted"

update
	#trades
set
	std_contract = b.symbol
from
	#trades a,
	contracts b,
	instruments c
where
	a.contract_id =b.contract_id
and
	b.instrument_id = c.instrument_id
and
	c.name in("Option", "Exotic")

/*
| Query statuses
*/
update
	#trades
set
	deal_status = b.name
from
	#trades a,
	statuses b
where
	a.deal_status_id = b.status_id

update
        #trades
set
	trade_status = b.name
from
        #trades a,
        statuses b
where
        a.trade_status_id = b.status_id

update
	#trades
set
	notification_status = b.name
from
	#trades a,
	statuses b
where
	a.notification_status_id = b.status_id

update
	#trades
set
	notification_status = b.status_symbol
from
	#trades a,
	status_symbols b
where
	a.notification_status_id = b.status_id

update
	#trades
set
	prime_broker_id = d.prime_broker_id,
	prime_broker = c.name
from
	#trades a,
	external_account_prime_brokers b,
	prime_brokers d,
	sources c
where
	a.external_account_id = b.external_account_id
and
	b.prime_broker_id = d.prime_broker_id
and
	c.source_id = d.source_id

update
	#trades
set
	prime_broker = b.symbol
from
	#trades a,
	prime_broker_symbols b
where
	a.prime_broker_id = b.prime_broker_id
and
	b.source_id = @source_id


/*
| Set trading day to EST 17:00-17:00 market standard
*/
update
	#trades
set
	trade_day = case
		when a.trade_date > convert(char(8), a.trade_date, 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 112))
		else
			convert(char(12), a.trade_date, 112)
	end
from
	#trades a

/*
| If this was originally a db to db trade, grab information about previous source_db
*/
update
	#trades
set
	source_trade_trade_id = source_trade_id,
	source_trade_deal_id = source_deal_id
from
	#trades a,
	source_trade_details b
where
	a.trade_id = b.trade_id
and
	a.notification_status_id = @cancelling_src_status_id


if @query_futures in("Y", "O") /* Y for YES, O for ONLY */
begin
/* 
| Query futures information 
*/
update
	#trades
set
	future_id = b.future_id,
	fut_expiration = b.expiration,
	fut_contract = c.symbol
from
	#trades a,
	future_contracts b,
	contracts c
where
	a.contract_id = b.contract_id
and
	a.contract_id = c.contract_id

update 
	#trades
set
	fut_forward_id = b.forward_id,
	fut_symbol = b.name,
	fut_root_symbol = b.root_symbol,
	fut_exchange_id = b.exchange_id,
	fut_exchange = c.name,
	fut_contract_size = b.quantity,
	fut_tick_size = b.tick_size
from
	#trades a,
	futures b,
	exchanges c
where
	a.future_id = b.future_id
and
	b.exchange_id = c.exchange_id
end

if @query_futures = "O"  /* O for ONLY, ONLY query futures, remove all other trades */
begin
        delete from
                #trades
        where
                trade_type not in("Future")
end
else if @query_futures = "N"
begin
        delete from
                #trades
        where
                trade_type in("Future")
end


if @query_options in("Y", "O") /* Y for YES, O for ONLY */
begin
/*
| Query option details
*/
update
	#trades
set
	optcon_exercise_style_id = b.exercise_style_id,
	optcon_exercise_style = c.name,
	optcon_strike = b.strike,
	optcon_put_call = b.put_call,
	option_expiration_id = b.option_expiration_id
from
	#trades a,
	option_contracts b,
	exercise_styles c
where
        a.contract_id = b.contract_id
and
	b.exercise_style_id = c.exercise_style_id

/* exotic */
update
        #trades
set
        optcon_exercise_style_id = b.exercise_style_id,
        optcon_exercise_style = c.name,
        optcon_strike = b.strike,
        optcon_put_call = b.put_call,
        option_expiration_id = b.option_expiration_id,
	e_timing_id = b.timing_id,
	e_po_ccy_id = b.payout_ccy_id,
	e_po_amt = b.payout_amount,
	e_bt_id = b.barrier_type_id,
	e_b = b.barrier,
	e_lb = b.lower_barrier,
	e_ub = b.upper_barrier,
	e_inst_id = d.exotic_instrument_id,
	e_inst = d.name
from
        #trades a,
        exotic_contracts b,
        exercise_styles c,
	exotic_instruments d
where
        a.contract_id = b.contract_id
and
	b.exercise_style_id = c.exercise_style_id
and
	b.exotic_instrument_id  = d.exotic_instrument_id

update
	#trades
set
	e_bt = b.barrier
from
	#trades a,
	barrier_types b
where
	a.e_bt_id = b.barrier_type_id

update 
	#trades
set
	e_ud = "D"
from
	#trades a,
	barrier_types b
where
	a.e_bt_id = b.barrier_type_id
and
	b.barrier in("Down and In", "Down and Out")

update
        #trades
set
        e_ud = "U"
from
        #trades a,
        barrier_types b
where
        a.e_bt_id = b.barrier_type_id
and
        b.barrier in("Up and Out", "Up and In")

update 
        #trades
set
        e_ud = case 
		when a.spot_reference > a.e_b then "D" 
		when a.spot_reference < a.e_b then "U"
		else ""
	end
from
        #trades a,
        barrier_types b
where
        a.e_bt_id = b.barrier_type_id
and
        b.barrier in("OT", "NT")


update
	#trades
set
	e_po_ccy = b.symbol
from
	#trades a,
	products b
where
	a.e_po_ccy_id = b.product_id

update
	#trades 
set
	e_timing = b.timing
from
	#trades a,
	timings b
where
	a.e_timing_id = b.timing_id

update
	#trades
set
	e_b = e_lb
where
	e_inst = "Double Barrier"

update 
	#trades
set
	a.e_b = a.e_lb
from
        #trades a,
        barrier_types b
where
        a.e_bt_id = b.barrier_type_id
and
        b.barrier in("DOT", "DNT")
		

update 
	#trades
set
	quantity = 0
where
	e_po_ccy_id != NULL

/* end exotic */

update
	#trades
set
	option_id = b.option_id,
	optexp_symbol = b.symbol,
	optexp_expiration = b.expiration,
	optexp_timezone_id = b.timezone_id
from
        #trades a,
	option_expirations b
where
	a.option_expiration_id = b.option_expiration_id

update 
	#trades
set
	optexp_time_zone = b.timezone,
	optexp_tz_symbol = b.symbol,
	optexp_tz_expiration_time = b.expiration_time,
	optexp_tz_display_value = b.display_value,
	optexp_tz_status = b.status
from
	#trades a,
	timezones b
where
	a.optexp_timezone_id = b.timezone_id

update
	#trades
set
	opt_underlying_contract_id = b.underlying_contract_id,
	opt_exchange_id = b.exchange_id,
	opt_exchange = c.name,
	opt_def_exercise_style_id = b.def_exercise_style_id,
	opt_def_exercise_style = d.name,
	opt_quantity = b.quantity,
	opt_tick_size = b.tick_size
from
	#trades a,
	options b,
	exchanges c,
	exercise_styles d
where
	a.option_id = b.option_id
and
	b.exchange_id = c.exchange_id
and
	b.def_exercise_style_id = d.exercise_style_id

update
        #trades
set
        opt_underlying_contract = b.symbol
from
        #trades a,
        contracts b
where
        a.opt_underlying_contract_id = b.contract_id
	
update
        #trades
set
        traded_ccy = g.symbol,
        counter_ccy = f.symbol
from
        #trades a,
        contracts b,
        forwards e,
        products f,
        products g
where
        a.opt_underlying_contract_id = b.contract_id
and
        b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

update
	#trades
set
	is_inverted_contract = "Y"
from
	#trades a,
	contracts b,
        contract_price_styles c,
        price_styles d
where
	convert(varchar(3), a.traded_ccy)+convert(varchar(3), a.counter_ccy) = b.symbol
and
        b.contract_id = c.contract_id
and
        c.price_style_id = d.price_style_id
and
        d.name = "Inverted"

update
	#trades
set
	abs_counter_qty = round((abs(quantity) * optcon_strike), 2)
where
	trade_type = "Option"

update
	#trades
set
	abs_counter_qty = round((abs(quantity) * (1/optcon_strike)), 2)
where
	trade_type = "Option"
and
	is_inverted_contract = "Y"
and
	optcon_strike not in(NULL, 0)

update
	#trades
set
	option_premium = b.amount,
	option_premium_ccy_id = b.currency_id,
	premium_settle_date = b.transaction_date
from
	#trades a,
	account_transactions b,
	account_transaction_trades c
where
	a.trade_id = c.trade_id
and
	c.account_transaction_id = b.account_transaction_id

update
	#trades
set
	option_premium_ccy = b.symbol
from
	#trades a,
	products b
where
	a.option_premium_ccy_id = b.product_id

update
	#trades
set
	option_settle_date = b.settledate
from
	#trades a,
	option_settledates b
where
	a.contract_id = b.contract_id

update
	#trades
set 
	trm_opt_delivery = "PHYSICAL"

update 
	#trades
set
	trm_opt_delivery = "CASH"
where
	fixing_date != NULL

update
	#trades
set
	optcon_put_call = "CALL"
where
	optcon_put_call = "C"

update
	#trades
set
	optcon_put_call = "PUT"
where
	optcon_put_call = "P"

update
	#trades
set
	option_premium_percent = round(abs(option_premium)/abs(abs_qty), 6) * 100
from
	#trades
where
	option_premium_ccy = traded_ccy
and
	abs_qty != 0

end /* end option lookups */

if @query_options = "O"  /* O for ONLY, ONLY query options, remove all other trades */
begin
	delete from
		#trades
	where
		trade_type not in("Option")
end
else if @query_options = "N"
begin
        delete from
                #trades
        where
                trade_type in("Option")
end


if @mark_to_market = "Y"
begin
	/* set product id */
	update
        	#trades
	set
        	product_id = b.product_id,
        	currency_id = b.currency_id
	from
        	#trades a,
        	forwards b
	where
        	a.contract_id = b.contract_id

	/* get the eval ccy */	
	create table
        	#eval_ccys(
                	product_id int,
                	symbol varchar(10) NULL
	)
	insert into
        	#eval_ccys(
                	product_id)
	select
        	distinct(evaluation_currency_id)
	from
        	funds

	/* Find out what products have been traded */
	create table
		#traded_products(
			product_id int
	)
	
	insert into
		#traded_products
	select
		distinct(product_id)
	from
		#trades
	
	insert into 
		#traded_products
	select
		distinct(currency_id)
	from
		#trades
	where
		currency_id not in(select product_id from #traded_products)

	/* Get the conversion rated from traded products to eval ccy */	
	create table
		#conversion_contracts
	(
		contract_id int NULL,
		product_id int,
		currency_id int,
		inverse_contract_id int NULL,
		standard_price float NULL,
		conversion_price float NULL
	)
	
	insert into 
		#conversion_contracts(
			contract_id,
			product_id,
			currency_id
		)
	select
		a.contract_id,
		a.product_id,
		a.currency_id
	from
		forwards a,
		#traded_products b,
		#eval_ccys c
	where
		a.product_id = b.product_id
	and
		a.currency_id = c.product_id

	update
		#conversion_contracts
	set
		inverse_contract_id = a.contract_id
	from
		forwards a,
		#conversion_contracts b
	where
		a.product_id = b.currency_id
	and
		a.currency_id = b.product_id

	/* create temp table of current prices so price ticks dont affect conversion rates */
	create table
		#current_prices(
			contract_id int,
			price float
	)
	insert into
		#current_prices
	select
		contract_id,
		price
	from
		current_prices

	/* set conversion rates from current prices */	
	update
		#conversion_contracts
	set
		standard_price = a.price,
		conversion_price = a.price
	from
		#current_prices a,
		#conversion_contracts b
	where
		a.contract_id = b.contract_id
	
	update
        	#conversion_contracts
	set
        	standard_price = a.price,
		conversion_price = 1/a.price
	from
        	#current_prices a,
        	#conversion_contracts b
	where
        	a.contract_id = b.inverse_contract_id
	and
		b.standard_price = NULL

	/* ensure a rate of 1.0 exists for the eval to eval conversion */
	insert into
		#conversion_contracts
	(
		product_id,
		currency_id,
		conversion_price
	)
	select
		product_id,
		product_id,
		1.0
	from
		#eval_ccys


	update 
		#trades
	set
		pd1_eq = quantity * conversion_price,
                vo_rate = conversion_price
	from
		#trades a,
		#conversion_contracts b
	where
		a.product_id = b.product_id
	
	update
        	#trades
	set
        	pd2_eq = (quantity * db_price * -1) * conversion_price
	from
        	#trades a,
        	#conversion_contracts b
	where
        	a.currency_id = b.product_id
	
	update
		#trades
	set
		vo = abs(pd1_eq)

end	

if @trade_id != NULL 
begin
	select
		@trade_type = trade_type,
		@exotic_instrument = e_inst
	from
		#trades
	where
		trade_id = @trade_id
end


create table
         #output(
                 attributes varchar(50) NULL,
                 trade_values text NULL)

if @trade_id != NULL and @trade_type = "Option" and @exotic_instrument = NULL
begin

	insert into #output select "trade date", convert(varchar(11), trade_date) from #trades
        insert into #output select "counterparty", "SmartMoney" from #trades
        insert into #output select "counterparty PB", prime_broker from #trades
        insert into #output select "client", agency_vs_counterparty from #trades
        insert into #output select "client buy/sell", client_buy_sell from #trades
        insert into #output select "currency pair", opt_underlying_contract from #trades
        insert into #output select "put/call", optcon_put_call + " " + rtrim(substring(opt_underlying_contract, 1, 3)) from #trades
        insert into #output select "quantity", convert(varchar, cast(abs(quantity) AS money), 1) from #trades
        insert into #output select "strike", convert(varchar(50), optcon_strike) from #trades
        insert into #output select "expiry", convert(varchar(11), optexp_expiration) from #trades
        insert into #output select "delivery", convert(varchar(11), option_settle_date) from #trades
        insert into #output select "expiry cut", optexp_time_zone from #trades
        insert into #output select "premium cur", option_premium_ccy from #trades
        insert into #output select "premium percent", convert(varchar, cast(abs(option_premium_percent) AS numeric(32,4)), 1) + "%" from #trades
        insert into #output select "premium", convert(varchar, cast(abs(option_premium) AS money), 1) from #trades
        insert into #output select "premium val date", convert(varchar(11), premium_settle_date) from #trades
	insert into #output select "trade id", convert(varchar(50), trade_id) from #trades
	

	/* leaving the below section, probably will have to come back at some point 

	insert into #output select "trade date", convert(varchar(11), trade_date) from #trades
	/*insert into #output select "client", agency_vs_counterparty from #trades */
	/*insert into #output select "client buy/sell", client_buy_sell from #trades */
	insert into #output select "client buy/sell", agency_vs_counterparty + " " + client_buy_sell from #trades
	insert into #output select "put/call", optcon_put_call from #trades
	insert into #output select "underlying", opt_underlying_contract from #trades
	insert into #output select "quantity", convert(varchar, cast(abs(quantity) AS money), 1) from #trades
	insert into #output select "traded ccy", rtrim(substring(opt_underlying_contract, 1, 3)) from #trades
	insert into #output select "strike", convert(varchar(50), optcon_strike) from #trades
	insert into #output select "expiration", convert(varchar(11), optexp_expiration) from #trades
	insert into #output select "settle date", convert(varchar(11), option_settle_date) from #trades
	insert into #output select "time zone", optexp_time_zone from #trades
	insert into #output select "premium", convert(varchar, cast(abs(option_premium) AS money), 1) from #trades
	insert into #output select "premium ccy", option_premium_ccy from #trades
	insert into #output select "premium val date", convert(varchar(11), premium_settle_date) from #trades
	insert into #output select "give up to", prime_broker from #trades
	insert into #output select "trade id", convert(varchar(50), trade_id) from #trades
	*/

	select
		attributes,
		trade_values
	from 
		#output
end

if @trade_id != NULL and @trade_type = "Option" and @exotic_instrument != NULL
begin
	insert into #output select "trade id", convert(varchar(50), trade_id) from #trades
        insert into #output select "trade date", convert(varchar(11), trade_date) from #trades
        insert into #output select "prime broker", prime_broker from #trades
        insert into #output select "client", agency_vs_counterparty from #trades
        insert into #output select "buy/sell", client_buy_sell from #trades
        insert into #output select "put/call", rtrim(substring(opt_underlying_contract, 1, 3))+ " "+ optcon_put_call from #trades
        insert into #output select "underlying", opt_underlying_contract from #trades
        insert into #output select "quantity", convert(varchar, cast(abs(quantity) AS money), 1) from #trades
        insert into #output select "strike", convert(varchar(50), optcon_strike) from #trades
        insert into #output select "expiration", convert(varchar(11), optexp_expiration) from #trades
        insert into #output select "time zone", optexp_time_zone from #trades
        insert into #output select "settle date", convert(varchar(11), option_settle_date) from #trades
        insert into #output select "premium", convert(varchar, cast(abs(option_premium) AS money), 1) from #trades
        insert into #output select "premium ccy", option_premium_ccy from #trades
        insert into #output select "premium val date", convert(varchar(11), premium_settle_date) from #trades
	insert into #output select "timing", convert(varchar(50), e_timing) from #trades
	insert into #output select "payout currency", e_po_ccy from #trades 
	insert into #output select "payout amount", convert(varchar, cast(abs(e_po_amt) AS money),1) from #trades
	insert into #output select "barrier type", e_bt from #trades
	insert into #output select "barrier",  convert(varchar, cast(e_b AS numeric(30,6)),1) from #trades where e_lb = NULL or e_ub = NULL
	insert into #output select "lower barrier", convert(varchar, cast(e_lb AS numeric(30,6)),1) from #trades where e_ub != NULL and e_lb != NULL
	insert into #output select "upper barrier", convert(varchar, cast(e_ub AS numeric(30,6)),1) from #trades where e_ub != NULL and e_lb != NULL
	insert into #output select "instrument type", e_inst from #trades
	/* insert into #output select "up/down barrier", convert(varchar(50), e_ud) from #trades */

        select
                attributes,
                trade_values
        from
                #output

end

if @trade_id != NULL and @trade_type in("Spot", "Forward") 
begin

	select @current_rate = convert(varchar(30), convert(numeric(30, 8), std_price)) from #trades where trade_id = @trade_id

        exec
                u_striptrailingzeros
                        @current_rate,
                        @display_rate output

    insert into #output select "price", @display_rate
	insert into #output select "trade date", convert(varchar(11), trade_date) from #trades
    insert into #output select "traded with", prime_broker from #trades
	insert into #output select "counterparty", agency_vs_counterparty from #trades
	insert into #output select "side", client_buy_sell + " " + traded_ccy from #trades
    insert into #output select "currency pair", rtrim(convert(char(3), traded_ccy))+"/"+rtrim(convert(char(3), counter_ccy))  from #trades
    insert into #output select "amount", convert(varchar, cast(abs(quantity) AS money), 1) from #trades
	insert into #output select "contra amount", convert(varchar, cast(abs_counter_qty AS money), 1) from #trades
	insert into #output select "price", @display_rate
    insert into #output select "value date", convert(varchar(11), cast(value_date as datetime)) from #trades
	insert into #output select "trade id", convert(varchar(50), trade_id) from #trades
	insert into #output select "agent", "SmartMoney" from #trades

	/*   Going to leave this entire section for now, i think what is in their REQ is wrong and we will come back to this 

	insert into #output select "trade date", convert(varchar(11), trade_date) from #trades
	/* insert into #output select "client", agency_vs_counterparty from #trades */
	/*insert into #output select "client buy/sell", client_buy_sell from #trades */
	insert into #output select "client buy/sell", agency_vs_counterparty + " " + client_buy_sell from #trades
	insert into #output select "currency pair", rtrim(convert(char(3), traded_ccy))+"/"+rtrim(convert(char(3), counter_ccy))  from #trades
	insert into #output select "dealt currency", traded_ccy from #trades
	insert into #output select "dealt amount", convert(varchar, cast(abs(quantity) AS money), 1) from #trades
	insert into #output select "contra currency", counter_ccy from #trades
	insert into #output select "contra amount", convert(varchar, cast(abs_counter_qty AS money), 1) from #trades
        insert into #output select "price", convert(varchar(50), std_price) from #trades
	insert into #output select "value date", convert(varchar(11), cast(value_date as datetime)) from #trades
	insert into #output select "give up to", prime_broker from #trades
	insert into #output select "trade id", convert(varchar(50), trade_id) from #trades
	*/ 

	select
		attributes,
		trade_values
	from
        	#output
end

