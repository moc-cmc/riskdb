
if object_id("r_simulatereconcile") != NULL
    drop procedure
        r_simulatereconcile
go

create procedure
    r_simulatereconcile
        @login varchar(50)
as

declare @fund varchar(50)
declare @report varchar(50)
declare @begin_date datetime
declare @end_date datetime
declare @trade_date datetime
declare @report_commit_id int

declare @report_interval int
declare @match_interval int

declare @sql varchar(250)

select
    @report_interval = 10,
    @match_interval = 30

create table
    #messages (
        id int identity,
        message varchar(125)
    )

exec
    r_daterangefordate
        NULL,
        @begin_date out,
        @end_date out
        
select
    @trade_date = convert(datetime, convert(date, @end_date))

select
    @fund = b.name,
    @report = c.name
from
    fund_reports a,
    funds b,
    external_reports c
where
    a.fund_id = b.fund_id
and
    a.external_report_id = c.external_report_id

if @@rowcount != 1
begin
    select
        status = "Error",
        message = "Expected a single fund reports",
        fund_report_count = @@rowcount,
        fund = @fund,
        report = @report
    return
end

exec
    r_reportcommitfordate
        @fund,
        @report,
        @trade_date,
        @report_commit_id out

if @report_commit_id = NULL
begin
    select
        status = "Error",
        message = "No report commit found",
        fund = @fund,
        report = @report
    return
end

insert into
    #messages (
        message
    )
select
    "Simulating reconcile for fund, '" + @fund + "', report, '" + @report + "', commit, " + convert(varchar(10), @report_commit_id) + ", trade date, " + convert(varchar(10), @trade_date, 101)

/*
 * COPY #trades: All of today's trades
 */
create table
    #trades (
        trade_id int,
        trade_date datetime,
        report_trade_id int NULL,
        import_date datetime NULL,
        lifecycle_status varchar(25) NULL,
        matching_status varchar(25) NULL
    )

insert into
    #trades (
        trade_id,
        trade_date
    )
select
    trade_id,
    trade_date
from
    trades
where
    trade_date >= @begin_date
and
    trade_date < @end_date

insert into
    #messages (
        message
    )
select
    "Found " + convert(varchar(10), @@rowcount) + " internal trades"

/*
 * UPDATE #trades: Mark all of the trades that have been matched
 */
update
    #trades
set
    report_trade_id = c.report_trade_id,
    import_date = c.import_date,
    lifecycle_status = c.lifecycle_status,
    matching_status = c.matching_status
from
    #trades a,
    report_trade_matches b,
    report_trades c
where
    a.trade_id = b.trade_id
and
    b.report_trade_id = c.report_trade_id
    
insert into
    #messages (
        message
    )
select
    "Found " + convert(varchar(10), @@rowcount) + " matched trades"

/*
 * UPDATE report_trades: 
 */
update
    report_trades
set
    lifecycle_status = "Done",
    matching_status = "Matched"
from
    report_trades a,
    #trades b
where
    a.report_trade_id = b.report_trade_id
and (
        b.lifecycle_status != "Done"
    or
        a.matching_status != "Matched"
    )
and
    datediff(second, b.import_date, getdate()) >= @match_interval

insert into
    #messages (
        message
    )
select
    "Marked " + convert(varchar(10), @@rowcount) + " report trades as done and matched"

insert into
    report_trades (
        report_commit_id,
        import_date,
        identifier,
        client_identifier,
        activity_date,
        activity,
        external_account_id,
        trade_date,
        nominal_contract_symbol,
        ccy_1,
        ccy_1_quantity,
        ccy_2,
        ccy_2_quantity,
        nominal_price,
        value_date,
        status_id,
        strategy_id,
        broker_id,
        broker_identifier,
        spoke_bank,
        indicators,
        description,
        lifecycle_status,
        matching_status,
        approval_status,
        allocation_status,
        processing_status
    )
select
    @report_commit_id,
    import_date = getdate(),
    identifier = "mpt" + convert(varchar(15), b.trade_id),
    client_identifier = b.identifier,
    activity_date = getdate(),
    activity = "New",
    external_account_id = b.external_account_id,
    trade_date = @trade_date,
    nominal_contract_symbol = c.symbol,
    ccy_1 = ca.symbol,
    ccy_1_quantity = b.quantity,
    ccy_2 = cb.symbol,
    ccy_2_quantity = - b.quantity * b.price,
    nominal_price = b.price,
    b.value_date,
    b.status_id,
    b.strategy_id,
    b.broker_id,
    broker_identifier = b.identifier,
    spoke_bank = NULL,
    indicators = NULL,
    description = NULL,
    lifecycle_status = "Active",
    matching_status = "Unmatched",
    approval_status = "",
    allocation_status = "",
    processing_status = ""
from
    #trades a,
    trades b,
    contract_details c,
    products ca,
    products cb
where
    a.trade_id = b.trade_id
and
    b.contract_id = c.contract_id
and
    c.product_id = ca.product_id
and
    c.currency_id = cb.product_id
and
    a.report_trade_id = NULL
and
    datediff(second, b.trade_date, getdate()) >= @report_interval
and
    b.identifier not in (
        select
            broker_identifier
        from
            report_trades
        where
            report_commit_id = @report_commit_id
    )
order by
    a.trade_id

insert into
    #messages (
        message
    )
select
    "Generated " + convert(varchar(10), @@rowcount) + " new report trades"

/*
 * EXEC r_autoreconcilereport: Reconcile the generated reports
 */
exec
    r_autoreconcilereport
        @login = @login,
        @fund = @fund,
        @external_report = @report,
        @trade_date = @trade_date,
        @action = "Match",
        @mismatch_strength = 0.0001,
        @reconcile_strength = 0.9999
        
create table
    #futures_trades (
        trade_id int,
        report_trade_id int NULL,
        symbol varchar(100),
        quantity numeric(30,4),
        price float
    )

/*
 * Match Futures trades
 */
insert into
    #futures_trades (
        trade_id,
        symbol,
        quantity,
        price
    )
select
    b.trade_id,
    c.symbol,
    b.quantity,
    b.price
from
    #trades a,
    trades b,
    contract_details c,
    instruments d,
where
    a.trade_id = b.trade_id
and
    b.contract_id = c.contract_id
and
    c.instrument_id = d.instrument_id
and
    d.name = "Future"

update
    #futures_trades
set
    
from
    #futures_trades a,
    report_trades b
where
    a.report


select
    *
from
    #messages
    

select
    @sql = "exec r_simulatereconcile '" + @login + "'"

exec
    r_managetimer
        @name = "r_simulatereconcile",
        @iterations = -1 /* indefinite */,
        @interval = 10 /* seconds */,
        @sql = @sql

go
