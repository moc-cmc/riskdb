drop procedure r_savecfdsettles
go

create procedure
	r_savecfdsettles
		@login varchar(50),
		@settle_date datetime=NULL

as

declare @contract_id int
declare @price float
declare @price_id int
declare @date datetime
declare @day char(2)
declare @month char(2)
declare @year char(4)
declare @datestring char(22)
declare @symbol varchar(50) 


if @settle_date != NULL
begin
        select
                @settle_date = convert(char(2), datepart(month, @settle_date)) + "/" +
                convert(char(2), datepart(day, @settle_date)) + "/" +
                convert(char(4), datepart(year, @settle_date))

        select
                @settle_date = dateadd(hour, 17, @settle_date)
end

if @settle_date = NULL
begin
	select
		@day = convert(char(2), datepart(day, getdate())),	
		@month = convert(char(2), datepart(month, getdate())),	
		@year = convert(char(4), datepart(year, getdate()))
	select
		@datestring = @month + "/" + @day + "/" + @year + " 17:00"
	select
		@settle_date = convert(datetime, @datestring)
end

create table
	#contract_prices(
		id int identity,
		contract_id int,
		symbol varchar(50),
		price float
)

insert into
	#contract_prices
select
	b.contract_id,
	b.symbol,
	a.price
from
	current_prices a,
	contracts b,
	forwards c,
	products d,
	product_types e
where
	a.contract_id = b.contract_id
and
	b.contract_id = c.contract_id
and
	c.product_id = d.product_id
and 
	d.product_type_id = e.product_type_id
and
	e.name = "CFD"
and
	b.contract_id not in(select contract_id from conversion_cfds)


declare @id int
declare @ids int

select
        @id = 0
select
        @ids = count(*)
from
        #contract_prices
where
        id > @id

while @ids > 0
begin
        select  
                @id = min(id)
        from
                #contract_prices
        where
                id > @id

        select
		@price = NULL,
		@contract_id = NULL,
		@symbol = NULL

	select
		@contract_id = contract_id,
		@symbol = symbol,
		@price = price
        from
                #contract_prices
        where
                id = @id

	
	exec 
		ag_editcfdsettle
			@login = @login,
			@symbol = @symbol,
			@settle_date = @settle_date,
			@settle_price = @price,
			@show_output = "N"
	

        select
                @ids = count(*)
        from
                #contract_prices
        where
                id > @id
end


go
