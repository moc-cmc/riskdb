drop procedure
        ag_settlementfees
go

create procedure
        ag_settlementfees
                @login varchar(50),
                @fee_schedule varchar(200),
                @trade_date datetime

as


declare @fund_id int
declare @fee_schedule_id int
declare @begin_date datetime
declare @end_date datetime
declare @evaluation_currency_id int
declare @fee_price numeric(30,8)
declare @debit_account varchar(50)
declare @credit_account varchar(50)
declare @quantity float
declare @amount numeric(30,8)
declare @scheduled_fee_id int
declare @currency varchar(50)
declare @min_ticket_size float


exec
	r_defaultfundforlogin
		@login,
		@fund_id output
select
	@evaluation_currency_id = evaluation_currency_id
from
	funds
where
	fund_id = @fund_id

select
	@currency = symbol
from
	products
where
	product_id = @evaluation_currency_id

exec
	r_daterangefordate
		@trade_date,
		@begin_date output,
		@end_date output


select
	@fee_schedule_id = a.fee_schedule_id,
	@fee_price = a.fee_price,
	@credit_account = b.symbol,
	@debit_account = c.symbol,
	@min_ticket_size = min_ticket_size
from
	fee_schedules a,
	external_accounts b,
	external_accounts c
where
	a.credit_ext_account_id = b.external_account_id
and
	a.book_to_ext_account_id = c.external_account_id
and
	a.name = @fee_schedule
if @fee_schedule_id = NULL
begin
	select
		status = "Error",
		message = "Fee schedule not found",
		fee_schedule = @fee_schedule
	return
end

create table
	#traders(
		trader_id int)
create table
	#strategies(
		strategy_id int)
create table
	#external_accounts(
		external_account_id int)
create table
	#internal_accounts(
		internal_account_id int)
create table
	#brokers(
		broker_id int)
create table
	#counterparties(
		counterparty_id int)
create table
	#trade_types(
		trade_type_id int)
create table
	#statuses(
		status_id int)

insert into
	#traders(
		trader_id)
select
	trader_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	trader_id != NULL
if @@rowcount = 0
begin
	insert into
		#traders(
			trader_id)
	select
		trader_id
	from
		traders

	delete
		#traders
	from
		#traders a,
		fund_roll_traders b
	where
		a.trader_id = b.roll_trader_id
	and
		b.fund_id = @fund_id
end

insert into
	#strategies(
		strategy_id)
select
	strategy_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	strategy_id != NULL
if @@rowcount = 0
	insert into
		#strategies(
			strategy_id)
	select
		strategy_id
	from
		strategies

insert into
	#external_accounts(
		external_account_id)
select
	external_account_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	external_account_id != NULL
if @@rowcount = 0
	insert into 
		#external_accounts(
			external_account_id)
	select
		external_account_id
	from
		external_accounts

insert into
	#internal_accounts(
		internal_account_id)
select
	internal_account_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	internal_account_id != NULL
if @@rowcount = 0
	insert into
		#internal_accounts(
			internal_account_id)
	select
		internal_account_id
	from
		internal_accounts

insert into
	#brokers(
		broker_id)
select
	broker_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	broker_id != NULL
if @@rowcount = 0
	insert into
		#brokers(
			broker_id)
	select
		broker_id
	from
		brokers

insert into
	#counterparties(
		counterparty_id)
select
	counterparty_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	counterparty_id != NULL
if @@rowcount = 0
	insert into
		#counterparties(
			counterparty_id)
	select
		counterparty_id
	from
		counterparties

insert into
	#trade_types(
		trade_type_id)
select
	trade_type_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	trade_type_id != NULL
if @@rowcount = 0
	insert into
		#trade_types(
			trade_type_id)
	select 
		trade_type_id
	from
		trade_types

insert into
	#statuses(
		status_id)
select
	status_id
from
	fee_schedules
where
	fee_schedule_id = @fee_schedule_id
and
	status_id != NULL
if @@rowcount = 0
	insert into
		#statuses(
			status_id)
	select 
		status_id
	from
		statuses
	where
		name != "Resid"


create table
	#trades(
		fee_schedule_id int,
		trade_id int,
		product_id int,
		product_multiplier numeric(30,4) NULL,
		product_qty numeric(30,4),
		currency_id int,
		currency_multiplier numeric(30,4) NULL,
		currency_qty numeric(30,4),
		volume float NULL,
		multiplier float NULL,
		fee_price float NULL,
		fee float NULL)

insert into
	#trades(
		fee_schedule_id,
		trade_id,
		product_id,
		product_multiplier,
		product_qty,
		currency_id,
		currency_multiplier,
		currency_qty,
		multiplier,
		fee_price)
select
	fee_schedule_id = @fee_schedule_id,
	b.trade_id,
	l.product_id,
	product_multiplier = 1.0,
	b.quantity,
	l.currency_id,
	currency_multiplier = 1.0,
	b.quantity * b.price * -1.0,
	multiplier = 1.0,
	fee_price = @fee_price
from
	trades b,
	#traders d,
	#strategies e,
	#external_accounts f,
	#internal_accounts g,
	#brokers h,
	#counterparties i,
	#trade_types j,
	#statuses k,
	forwards l
where
	b.contract_id = l.contract_id
and
	b.trader_id = d.trader_id
and
	b.strategy_id = e.strategy_id
and
	b.external_account_id = f.external_account_id
and
	b.internal_account_id = g.internal_account_id
and
	b.broker_id = h.broker_id
and
	b.counterparty_id = i.counterparty_id
and
	b.trade_type_id = j.trade_type_id
and
	b.status_id = k.status_id
and
	b.trade_date >= @begin_date
and
	b.trade_date < @end_date

update
	#trades
set
	a.volume = b.volume
from
	#trades a,
	trade_volumes b
where
	a.trade_id = b.trade_id
and
	b.product_id = @evaluation_currency_id

if @min_ticket_size != NULL
begin
	update
		#trades
	set
		volume = @min_ticket_size
	where
		volume < @min_ticket_size

	update
		#trades
	set
		a.volume = b.min_size
	from
		#trades a,
		fee_schedule_products b
	where
		a.product_id = b.product_id
	and
		b.fee_schedule_id = @fee_schedule_id
	and
		b.min_size > a.volume

	update
		#trades
	set
		a.volume = b.min_size
	from
		#trades a,
		fee_schedule_products b
	where
		a.currency_id = b.product_id
	and
		b.fee_schedule_id = @fee_schedule_id
	and
		b.min_size > a.volume
end


update
	#trades
set
	a.product_multiplier = a.multiplier * b.multiplier
from
	#trades a,
	fee_schedule_products b
where
	a.product_id = b.product_id
and
	a.fee_schedule_id = b.fee_schedule_id


update
	#trades
set
	a.currency_multiplier = a.multiplier * b.multiplier
from
	#trades a,
	fee_schedule_products b
where
	a.currency_id = b.product_id
and
	a.fee_schedule_id = b.fee_schedule_id

update
	#trades
set
	multiplier = product_multiplier
where
	product_multiplier >= currency_multiplier

update
	#trades
set
	multiplier = currency_multiplier
where
	currency_multiplier > product_multiplier

update
	#trades
set
	volume = volume / 1000000.00

update
	#trades
set
	fee = volume * fee_price * multiplier

select
	@quantity = sum(fee)
from
	#trades

select
	@amount = convert(numeric(30,4), @quantity) 

/* select
	a.trade_id,
	dealt_ccy = b.symbol,
	counter_ccy = c.symbol,
	quantity = a.product_qty,
	rate = multiplier * fee_price,
	volume = convert(numeric(30,4), volume * 1000000),
	fee = convert(numeric(30,2), fee)
from
	#trades a,
	products b,
	products c
where
	a.product_id = b.product_id
and
	a.currency_id = c.product_id 

select
	login = @login,
	fee_schedule = @fee_schedule,
	transaction_date = @trade_date,
	debit_account = @debit_account,
	credit_account = @credit_account,
	amount = @amount,
	quantity = @quantity,
	currency = @currency */

exec
	ag_tallyfeeschedfee
		@login = @login,
		@fee_schedule = @fee_schedule,
		@transaction_date = @trade_date,
		@debit_account = @debit_account,
		@credit_account = @credit_account,
		@currency = @currency,
		@amount = @amount,
		@scheduled_fee_id = @scheduled_fee_id output



go
