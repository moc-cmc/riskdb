create or replace procedure
	ag_dailyrateshome
		@login varchar(50),
		@product varchar(50),
		@as_of datetime=NULL
as


declare @tico_account_id int
declare @error_style varchar(250)
declare @total_style varchar(250)
declare @subtotal_style varchar(250)
declare @style varchar(250)
declare @selected_style varchar(250)
declare @product_id int

create table
	#meta(
		meta_type char(200),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL)
insert into
	#meta
values(
	"Row Style",
	"style",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Hidden",
	"reporting_type",
	NULL,
	NULL)

insert into
	#meta
values(
	"Column Link",
	"set_rate",
	"Add Account Daily Rate",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"reject",
	"Reject Client Request",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"next_action",
	"Approve Next Request Action",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"enable_user",
	"Enable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"disable_user",
	"Disable Approval User",
	NULL) 

insert into
	#meta
values(
	"Column Link",
	"add_admin_user",
	"Add Approval User",
	NULL) 

insert into
	 #meta
values(
	 "Column Format",
	 "margin",
	 "Number",
	"#,##0.00%")


insert into
	#meta
values (
	"Column Group",
	"section",
	NULL,
	NULL)

/* Adaptive Server has expanded all '*' elements in the following statement */ select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta



select
	@error_style = "background:#FAE6E6;border: 1px solid white;font-weight:bold",
	@total_style = "background:#F5F3CE;border: 1px solid white;font-weight:bold",
	@subtotal_style = "background:#FAF7ED;border: 1px solid white;font-weight:bold",
	@style = "background:#FFFFFF;border: 1px solid white",
	@selected_style = "background:#FFF942;border: 1px solid white;font-weight:bold"


if @as_of = NULL
	select
		@as_of = getdate()

select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @tico_account_id = NULL
begin
	select
		status = "Error",
		message = "Unable to resolve login"
	return
end

select
	@product_id = product_id
from
	products
where
	symbol = @product
if @product_id = NULL
begin
	select
		status = "Error",
		message = "Product not found",
		product = @product
	return
end

create table
	#current_rates(
		external_account_id int,
		rate_date datetime)
insert into
	#current_rates(
		external_account_id,
		rate_date)
select
	external_account_id,
	max(rate_date)
from
	external_account_daily_rates
where
	product_id = @product_id
and
	rate_date <= @as_of
group by
	external_account_id

create table
	#output(
		id int identity,
		style varchar(250) NULL,
		external_account_id int NULL,
		account varchar(50) NULL,
		external_account_type_id int NULL,
		external_account_type varchar(50) NULL,
		product_id int NULL,
		product varchar(50) NULL,
		rate_date datetime NULL,
		rate float NULL,
		payment_days_offset int NULL)

insert into
	#output(
		style,
		external_account_id,
		account,
		external_account_type_id,
		external_account_type,
		product_id,
		product)
select
	style = @style,
	a.external_account_id,
	a.symbol,
	a.external_account_type_id,
	b.name,
	product_id = @product_id,
	product = @product
from
	external_accounts a,
	external_account_types b
where
	a.external_account_type_id = b.external_account_type_id
order by
	b.name,
	a.symbol
	
		
update
	#output
set
	a.rate_date = b.rate_date
from
	#output a,
	#current_rates b
where
	a.external_account_id = b.external_account_id
		

update
	#output
set
	a.rate = b.rate,
	a.payment_days_offset = b.payment_days_offset
from
	#output a,
	external_account_daily_rates b
where
	a.product_id = b.product_id
and
	a.external_account_id = b.external_account_id
and
	a.rate_date = b.rate_date

update
	#output
set
	external_account_type = "Hide"
where
	external_account_type = "Client"
and
	external_account_id not in(
		select
			external_account_id
		from
			bo_master_accounts)


select
	section = external_account_type,
	style,
	account,
	product,
	rate_date,
	rate,
	payment_days_offset,
	set_rate = "Set Rate"
from
	#output
where
	external_account_type in("Client", "Custody", "Custody MMF")
order by
	external_account_type,
	id
go 
