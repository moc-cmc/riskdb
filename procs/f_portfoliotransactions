--Adaptive Server has expanded all '*' elements in the following statement



select #links.meta_type, #links.column, #links.link, #links.arguments, #links.format from #links

if @begin_date = NULL
	select
		@begin_date = min(a.transaction_date)
	from
		int_account_transactions a,
		portfolio_accounts b
	where
		a.internal_account_id = b.internal_account_id
	and
		b.portfolio_id = @portfolio_id


if @end_date = NULL
	select
		@end_date = max(a.transaction_date)
	from
		int_account_transactions a,
		portfolio_accounts b
	where
		a.internal_account_id = b.internal_account_id
	and
		b.portfolio_id = @portfolio_id

select
	@begin_day_string = convert(char(2), datepart(month, @begin_date)) + "/" +
		convert(char(2), datepart(day, @begin_date)) + "/" +
		convert(char(4), datepart(year, @begin_date))
select
	@begin_date = convert(datetime, @begin_day_string)


select
	@end_day_string = convert(char(2), datepart(month, @end_date)) + "/" +
		convert(char(2), datepart(day, @end_date)) + "/" +
		convert(char(4), datepart(year, @end_date))
select
	@end_date = convert(datetime, @end_day_string)

create table
	#transactions(
		transaction_id int,
		entered_by int,
		internal_account_id int,
		transaction_type_id int,
		transaction_date datetime,
		amount float,
		note char(255) NULL)
insert into
	#transactions
select
	a.int_account_transaction_id,
	a.entered_by,
	a.internal_account_id,
	a.transaction_type_id,
	a.transaction_date,
	a.amount,
	a.note
from
	int_account_transactions a,
	portfolio_accounts b,
	portfolios c
where
	a.internal_account_id = b.internal_account_id
and
	b.portfolio_id = c.portfolio_id
and
	c.name = @portfolio


select
	@last_day = max(transaction_date)
from
	#transactions
where
	transaction_date <= @end_date


create table
	#months(
		month_id int,
		month_name char(25) NULL,
		month int,
		year int,
		last_date datetime NULL,
		init_cap float NULL,
		investor_profit float NULL,
		end_cap  float NULL,
		net_roc  float NULL,
		net_nav float NULL)
		

create table
	#days(
		date datetime,
		deposit_withdrawal float,
		mgmt float,
		incentive float,
		interest float,
		other float,
		pl float,
		total float,
		exposure float,
		running_total float,
		oc float NULL,
		ec float NULL,
		net_asset_value float,
		prev_net_asset_value float)

exec
	j_transactiontype
		"Deposit",
		@depo_trans_type_id output
exec
	j_transactiontype
		"Withdrawal",
		@with_trans_type_id output
exec
	j_transactiontype
		"Front Office Commit",
		@pl_trans_type_id output
exec
	j_transactiontype
		"Management Fee",
		@mgmt_fee_trans_type_id output
exec
	j_transactiontype
		"Incentive Fee",
		@incentive_trans_type_id output
exec
	j_transactiontype
		"Interest",
		@interest_trans_type_id output

select
	@opening_capital = sum(a.amount)
from
	int_account_transactions a,
	portfolio_accounts b
where
	a.internal_account_id = b.internal_account_id
and
	b.portfolio_id = @portfolio_id
and
	a.transaction_date < @begin_date
if @opening_capital = NULL
	select
		@opening_capital = 0 


/* and
	a.transaction_type_id != @pl_trans_type_id  */
if @opening_capital = NULL
	select
		@opening_capital = 0

select /* T1 */
	@end_capital = @opening_capital

select  
	@total_balance = sum(amount)
from    
	#transactions

/* select
	@total_balance = @opening_capital + @total_balance */

/* select
	balance = convert(char(30), convert(numeric(30,2), @total_balance)) */
select
	@running_balance = @opening_capital

select
	@day = @begin_date,
	@end_capital = 0,
	@net_asset_value = 1000.00,
	@prev_net_asset_value = 1000.00

if @end_date >= "12/31/02"
	if @end_date < "1/1/03"
	begin
		select
			@end_date = "1/2/03 23:59"
	end


while @day <= @end_date 
begin
	/* select
		@day = min(transaction_date)
	from
		#transactions
	where
		transaction_date > @day */

	exec
		f_date
			@day,
			@day output


	select
		@month = datepart(month, @day),
		@year = datepart(year, @day),
		@month_name = datename(month, @day)


	select
		@month_id = month_id
	from
		#months
	where
		month = @month
	and
		year = @year
	if @@rowcount != 1
	begin
		select
			@month_id = max(month_id)
		from
			#months
		if @month_id = NULL
		begin
			select
				@month_id = 0
		end

		select
			@month_id = @month_id + 1

		insert into
			#months
		values(
			@month_id,
			@month_name,
			@month,
			@year,
			NULL,
			NULL,
			NULL,
			NULL,
			NULL,
			NULL)	

	end

	/* HACK HACK */
	if @end_date >= "1/2/03" and @end_date < "1/3/03"
		delete

		from
			#months
		where
			month = 1
		and
			year = 2003
			

	if datepart(month, dateadd(day, 1, @day)) != @month
		update
			#months
		set
			last_date = @day
		where
			month_id = @month_id

	if dateadd(day, 1, @day) > @last_day
		update
			#months
		set
			last_date = @day
		where
			month_id = @month_id


	select
		@amount = NULL,
		@pl = NULL,
		@cash_activity = NULL,
		@mgmt_fees = NULL,
		@incentive = NULL,
		@interest = NULL,
		@exposure = NULL,
		@other = NULL

	select
		@exposure = sum(limit_use)
	from
		int_account_exposure
	where
		transaction_date >= @day
	and
		transaction_date < dateadd(day, 1, @day)
	if @exposure = NULL
		select
			@exposure = 0

	select
		@exposure = @exposure / 1000000.0

	select
		@amount = sum(amount)
	from
		#transactions
	where
		transaction_date >= @day
	and
		transaction_date < dateadd(day, 1, @day)
	if @amount = NULL
		select
			@amount = 0

	select
		@pl = sum(amount)
	from
		#transactions
	where
		transaction_type_id = @pl_trans_type_id
	and
		transaction_date >= @day
	and
		transaction_date < dateadd(day, 1, @day)
	if @pl = NULL
		select
			@pl = 0


	select
		@cash_activity = sum(amount)
	from
		#transactions
	where
		transaction_type_id in(@depo_trans_type_id, @with_trans_type_id)
	and
		transaction_date >= @day
	and
		transaction_date < dateadd(day, 1, @day)
	if @cash_activity = NULL
		select
			@cash_activity = 0

	select
		@mgmt_fees = sum(amount)
	from
		#transactions
	where
		transaction_type_id = @mgmt_fee_trans_type_id
	and
		transaction_date >= @day
	and
		transaction_date < dateadd(day, 1, @day)
	if @mgmt_fees = NULL
		select
			@mgmt_fees = 0

	select
		@interest = sum(amount)
	from
		#transactions
	where
		transaction_type_id = @interest_trans_type_id
	and
		transaction_date >= @day
	and
		transaction_date < dateadd(day, 1, @day)
	if @interest = NULL
		select
			@interest = 0

	select
		@incentive = sum(amount)
	from
		#transactions
	where
		transaction_type_id = @incentive_trans_type_id
	and
		transaction_date >= @day
	and
		transaction_date < dateadd(day, 1, @day)
	if @incentive = NULL
		select
			@incentive = 0

	select
		@other = @amount - @pl - @cash_activity - @mgmt_fees - @interest- @incentive

	select
		@opening_capital = sum(a.amount)
	from
		int_account_transactions a,
		portfolio_accounts b
	where
		a.internal_account_id = b.internal_account_id
	and
		b.portfolio_id = @portfolio_id
	and
		a.transaction_date < @day
	if @opening_capital = NULL
		select
			@opening_capital = 0

	select
		@opening_capital = @opening_capital + @cash_activity
		/* @opening_capital = @opening_capital + @amount - @pl  */

	select
		@end_capital = @opening_capital + @amount - @cash_activity


	select
		@prev_net_asset_value = @net_asset_value

	if @opening_capital != 0.0
		select
			@net_asset_value = @net_asset_value * (@end_capital / @opening_capital)
	if @net_asset_value = NULL
		select
			@net_asset_value = 1000

	select
		@running_balance = @running_balance + @amount


	insert into
		#days
	values(
		@day,
		@cash_activity,
		@mgmt_fees,
		@incentive,
		@interest,
		@other,
		@pl,
		@amount,
		@exposure,
		@running_balance,
		@opening_capital,
		@end_capital,
		@net_asset_value,
		@prev_net_asset_value)


	select
		@day = dateadd(day, 1, @day)
end

if @breakdown = "Daily"
begin
select
	portfolio = @portfolio,
	date = convert(char(11), date, 1),
	cash_activity = convert(char(30), convert(numeric(30,2), deposit_withdrawal)),
	mgt = convert(char(30), convert(numeric(30,2), mgmt)),
	incentive = convert(char(30), convert(numeric(30,2), incentive)),
	interest = convert(char(30), convert(numeric(30,2), interest)),
	other = convert(char(30), convert(numeric(30,2), other)),
	p_l = convert(char(30), convert(numeric(30,2), pl)),
	total = convert(char(30), convert(numeric(30,2), total)),
	balance = convert(char(30), convert(numeric(30,2), running_total)),
	/* opening_capital = convert(char(30), convert(numeric(30,2), oc)),
	end_capital = convert(char(30), convert(numeric(30,2), ec)),  */
	net_asset_value = convert(char(30), convert(numeric(30,2), net_asset_value)),
	day_net_roc = convert(char(30), convert(numeric(30,2), 100 * ((net_asset_value / prev_net_asset_value) - 1)))
	/* exposure = convert(char(30), convert(numeric(30,2), exposure)) */
	
from
	#days	
order by
	convert(datetime, date)
end

create table
	#output(
		category char(100),
		value char(100))

select
	@total_pl = sum(pl),
	@total_cash = sum(deposit_withdrawal),
	@total_fees = sum(mgmt),
	@total_incentive = sum(incentive),
	@total_interest = sum(interest),
	@total_other = sum(other)
	/* @total_total = sum(total)*/
from
	#days

select
	@total_total = running_total
from
	#days
where
	date = (select max(date) from #days)

select
	@gross_pl = @total_pl + @total_fees + @total_incentive + @total_interest + @total_other
/* from
	#transactions
where
	transaction_type_id not in(@depo_trans_type_id, @with_trans_type_id)
and
