values(
	"Total Other Fees/Expenses",
	convert(char(30), convert(numeric(30,2), @total_other)))

insert into
	#output
values(
	"Investor P&L",
	convert(char(30), convert(numeric(30,2), @gross_pl)))

insert into
	#output
values(
	"Ending Balance",
	convert(char(30), convert(numeric(30,2), @total_total)))


select
	@month_id = 0
select
	@months = count(*)
from
	#months
where
	month_id > @month_id

while @months > 0
begin
	select
		@month_id = min(month_id)
	from
		#months
	where
		month_id > @month_id

	select
		@month = month,
		@year = year
	from
		#months
	where
		month_id = @month_id

	select
		@month_begin_day = min(date),
		@month_end_day = max(date)
	from
		#days
	where
		datepart(month, date) = @month
	and
		datepart(year, date) = @year

	if @month = 12
	begin
		if @year = 2002
		begin
			select
				@month_end_day = "1/2/03 23:59:59"
			update
				#months
			set
				last_date = "1/2/03"
			where
				month = 12
			and
				year = 2002	
		end
	end

	if @month = 1
	begin
		if @year = 2003
			if @portfolio = "WMIND"
			begin
				select msg = "T1"
				select
					@month_begin_day = "1/3/03"
			end
	end

	/* select
		@month_init_cap = sum(a.amount)
	from
		int_account_transactions a,
		portfolio_accounts b
	where
		a.internal_account_id = b.internal_account_id
	and
		b.portfolio_id = @portfolio_id
	and
		a.transaction_date < @month_begin_day */
	

	select
		@month_init_cap = running_total - pl - other - interest - incentive - mgmt
	from
		#days
	where
		date = @month_begin_day


	/* HACKY --- Need to address init capital for 1st month */
	if @month_init_cap = NULL
	select
		@month_init_cap = running_total
	from
		#days
	where
		date = (
			select
				max(date)
			from
				#days
			where
				date <= @month_begin_day)


	/* if @month_begin_day > @begin_date */
	if
		datepart(day, @month_begin_day) > datepart(day, @begin_date)
	and
		datepart(month, @month_begin_day) > datepart(month, @begin_date)
	and
		datepart(year, @month_begin_day) > datepart(year, @begin_date)
	begin
		select
			@month_init_cap = @month_init_cap + deposit_withdrawal
		from
			#days
		where
			date = @month_begin_day
	end
		

	select
		@month_net_prof = sum(mgmt) + sum(incentive) + sum(interest) + sum(other) + sum(pl)
	from
		#days
	where
		date >= @month_begin_day
	and
		date <= @month_end_day

	select
		@month_begin_net_nav = net_asset_value
	from
		#days
	where
		date = (
			select
				max(date)
			from
				#days
			where
				date < @month_begin_day)
	if @month_begin_net_nav = NULL
		select
			@month_begin_net_nav = 1000

	select
		@month_end_cap = running_total,
		@month_end_net_nav = net_asset_value
	from
		#days
	where
		date = (
			select
				max(date)
			from
				#days
			where
				date <= @month_end_day)
		


	select
		@month_net_roc = (@month_end_net_nav - @month_begin_net_nav) / @month_begin_net_nav
		/* @month_net_roc = @month_net_prof / @month_init_cap */
	

	update
		#months
	set
		init_cap = @month_init_cap,
		investor_profit = @month_net_prof,
		end_cap = @month_end_cap,
		net_roc = @month_net_roc,
		net_nav = @month_end_net_nav
	where
		month_id = @month_id


	select
		@months = count(*)
	from
		#months
	where
		month_id > @month_id

end

select
	date = convert(char(11), last_date, 0), 
	/* month = month_name,
	year, */
	init_cap = convert(char(30), convert(numeric(30,2), init_cap)),
	investor_profit = convert(char(30), convert(numeric(30,2), investor_profit)),
	end_cap = convert(char(30), convert(numeric(30,2), end_cap)),
	net_roc = convert(char(30), convert(numeric(30,2), net_roc * 100)),
	net_nav = convert(char(30), convert(numeric(30,2), net_nav))
from
	#months
order by
	convert(datetime, last_date)


if @breakdown = "Daily"
	
--Adaptive Server has expanded all '*' elements in the following statement
select #output.category, #output.value from #output

go
