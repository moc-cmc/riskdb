create procedure
	f_portfoliotransactions
		@portfolio char(100),
		@breakdown char(100)=NULL,
		@begin_date datetime=NULL,
		@end_date datetime=NULL
as

declare @begin_day_string char(25)
declare @end_day_string char(25)
declare @portfolio_id int
declare @total_balance float
declare @running_balance float
declare @pl_trans_type_id int
declare @pl float
declare @cash_activity float
declare @depo_trans_type_id int
declare @with_trans_type_id int
declare @mgmt_fees float
declare @mgmt_fee_trans_type_id int
declare @incentive float
declare @incentive_trans_type_id int
declare @interest float
declare @interest_trans_type_id int
declare @other float
declare @day datetime
declare @amount float
declare @end_capital float
declare @net_asset_value float
declare @prev_net_asset_value float
declare @opening_capital float
declare @exposure float

declare @gross_pl float
declare @total_pl float
declare @total_cash float
declare @total_fees float
declare @total_incentive float
declare @total_interest float
declare @total_other float
declare @total_total float
declare @value float

declare @months int
declare @month_id int
declare @month int
declare @last_day datetime
declare @year int
declare @month_name char(25)
declare @month_init_cap float
declare @month_net_prof float
declare @month_end_cap float
declare @month_net_roc float
declare @month_end_net_nav float
declare @month_begin_net_nav float
declare @month_begin_day datetime
declare @month_end_day datetime

select
	@portfolio_id = portfolio_id
from
	portfolios
where
	name = @portfolio
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Problem finding portfolio with name",
		portfolio = @portfolio
	return
end

if @breakdown = NULL
select
	@breakdown = "Daily"

create table
	#links(
