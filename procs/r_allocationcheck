	from
		brokers	


create table
	#positions(
		id int identity,
		contract_id int,
		symbol varchar(50) NULL,
		value_date datetime,
		net_position numeric(30,4),
		last_trade_date datetime)
insert into
	#positions(
		contract_id,
		value_date,
		net_position,
		last_trade_date)
select
	a.contract_id,
	a.value_date,
	sum(convert(numeric(30,2),a.quantity)),
	max(a.trade_date)
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.trade_date < @end_date
and
	a.value_date >= @begin_date
group by
	a.contract_id,
	a.value_date


insert into
	#positions(
		contract_id,
		value_date,
		net_position,
		last_trade_date)
select
	a.contract_id,
	h.expiration,
	sum(convert(numeric(30,2),a.quantity)),
	max(a.trade_date)
from
	trades a,
	#external_accounts b,
	#internal_accounts c,
	#traders d,
	#strategies e,
	#brokers f,
	option_contracts g,
	option_expirations h
	
where
	a.external_account_id = b.external_account_id
and
	a.internal_account_id = c.internal_account_id
and
	a.trader_id = d.trader_id
and
	a.strategy_id = e.strategy_id
and
	a.broker_id = f.broker_id
and
	a.contract_id = g.contract_id
and
	g.option_expiration_id = h.option_expiration_id
and	     
	a.trade_date < @end_date
and	     
	h.expiration >= @begin_date
group by
	a.contract_id,
	h.expiration


delete

from
	#positions
where
	net_position = 0


update
	#positions
set
	a.symbol = b.symbol
from
	#positions a,
	contracts b
where
	a.contract_id = b.contract_id

create table
	#ordered_positions(
		id int identity,
		contract_id int,
		symbol varchar(50),
		value_date datetime,
		net_position numeric(30,4),
		last_trade_date datetime)
insert into
	#ordered_positions(
		contract_id,
		symbol,
		value_date,
		net_position,
		last_trade_date)
select
	contract_id,
	symbol,
	value_date,
	net_position,
	last_trade_date
from
	#positions
order by
	symbol


create table
	#output(
		id int identity,
		contract_id int,
		value_date datetime,
		external_account_id int,
		quantity numeric(30,4),
		percentage float NULL)
		
select
	@id = 0
select
	@ids = count(*)
from
	#ordered_positions
where
	id > @id

while @ids > 0
begin
	select
		@id = min(id)
	from
		#ordered_positions
	where
		id > @id

	select
		@contract_id = contract_id,
		@value_date = value_date,
		@net_position = net_position
	from
		#ordered_positions
	where
		id = @id

	select
		@instrument = a.name
	from
		instruments a,
		contracts b
	where
		a.instrument_id = b.instrument_id
	and
		b.contract_id = @contract_id


	if @instrument = "Forward"
	begin
		insert into
			#output(
				contract_id,
				value_date,
				external_account_id,
				quantity)
		select
			a.contract_id,
			a.value_date,
			a.external_account_id,
			sum(a.quantity)
		from
			trades a,
			#external_accounts b,
			#internal_accounts c,
			#traders d,
			#strategies e,
			#brokers f
		where
			a.external_account_id = b.external_account_id
		and
			a.internal_account_id = c.internal_account_id
		and
			a.trader_id = d.trader_id
		and
			a.strategy_id = e.strategy_id
		and
			a.broker_id = f.broker_id
		and
			a.contract_id = @contract_id
		and
			a.value_date = @value_date
		and
			a.trade_date < @end_date
		group by
			a.contract_id,
			a.value_date,
			a.external_account_id
		order by
			a.external_account_id
	end
	else
	begin
		insert into
			#output(
				contract_id,
				value_date,
				external_account_id,
				quantity)
		select
			a.contract_id,
			value_date = @value_date,
			a.external_account_id,
			sum(a.quantity)
		from
			trades a,
			#external_accounts b,
			#internal_accounts c,
			#traders d,
			#strategies e,
			#brokers f
		where
			a.external_account_id = b.external_account_id
		and
			a.internal_account_id = c.internal_account_id
		and
			a.trader_id = d.trader_id
		and
			a.strategy_id = e.strategy_id
		and
			a.broker_id = f.broker_id
		and
			a.contract_id = @contract_id
		and
			a.trade_date < @end_date
		group by
			a.contract_id,
			a.external_account_id
		order by
			a.external_account_id
	end 

	insert into
		#output(
			contract_id,
			value_date,
			external_account_id,
			quantity)
	values(
		@contract_id,
		@value_date,
		0,
		@net_position)


	update
		#output
	set
		percentage = quantity / @net_position
	where
		contract_id = @contract_id
	and
		value_date = @value_date

	select
		@ids = count(*)
	from
		#ordered_positions
	where
		id > @id
end

create table
	#output_external_accounts(
		external_account_id int,
		symbol varchar(50))
insert into
	#output_external_accounts
select
	external_account_id,
	symbol
from
	external_accounts

insert into
	#output_external_accounts
values(
	0,
	"<b>Total</b>")

create table
	#final_output(
		id int identity,
		symbol varchar(50) NULL,
		value_date char(11) NULL,
		account varchar(50),
		quantity numeric(30,4),
		percentage float)

insert into
	#final_output
select
	a.symbol,
	value_date = convert(char(11), b.value_date, 1),
	account = c.symbol,
	b.quantity,
	b.percentage
from
	contracts a,
	#output b,
	#output_external_accounts c
where
	a.contract_id = b.contract_id
and
	b.external_account_id = c.external_account_id
order by
	b.id
	
update
	#final_output
set
	symbol = NULL,
	value_date = NULL
where
	account = "<b>Total</b>"

select
	symbol,
	value_date,
	account,
	quantity,
	percentage
from
	#final_output
order by
	id


