use
	risk_harbor
go

drop procedure
	r_allocationcheck
go

create procedure
	r_allocationcheck
		@login varchar(30),
		@run_name varchar(50),
		@as_of_date datetime=NULL
as


declare @run_id int
declare @tico_account_id int
declare @begin_date datetime
declare @end_date datetime
declare @id int
declare @ids int
declare @net_position numeric(30,4)
declare @contract_id int

declare @account varchar(50)
declare @value_date datetime
declare @account_position numeric(30,4)
declare @instrument varchar(50)

if @as_of_date = NULL
begin
	select
		@as_of_date = getdate()
end

exec
	r_daterangefordate
		@as_of_date,
		@begin_date output,
		@end_date output


select
	@tico_account_id = account_id
from
	tico_accounts
where
	login = @login
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Login not found"
	return
end

select
	@run_id = a.run_id
from
	runs a,
	user_runs b
where
	a.run_id = b.run_id
and
	b.tico_account_id = @tico_account_id
and
	a.name = @run_name
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Run not found",
		run_name = @run_name
	return
end


create table
	#traders(
		trader_id int)
insert into
	#traders
select
	trader_id
from
	run_traders
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#traders
	select
		trader_id
	from
		traders	
end

create table
	#strategies(
		strategy_id int)
insert into
	#strategies
select
	strategy_id
from
	run_strategies
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#strategies
	select
		strategy_id
	from
		strategies	
end

create table
	#external_accounts(
		external_account_id int)
insert into
	#external_accounts
select
	external_account_id
from
	run_external_accounts
where
	run_id = @run_id
if @@rowcount = 0
begin
	insert into
		#external_accounts
	select
		external_account_id
	from
		external_accounts	
end

