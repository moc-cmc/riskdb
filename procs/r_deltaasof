
if object_id("r_deltaasof") != NULL
    drop procedure
        r_deltaasof
go
 
create procedure
	r_deltaasof
		@contract_id int,
		@as_of_date datetime,
		@delta float output
as

declare @timestamp datetime
	
select
	@delta = delta
from
	contract_tvs
where
	contract_id = @contract_id
and
	tv_date = @as_of_date

if @delta = NULL
begin
	select
		@timestamp = timestamp
	from
		current_contract_tvs
	where
		contract_id = @contract_id

	if @as_of_date > dateadd(hour, -7, @timestamp)
	begin
		select
			@delta = delta
		from
			current_contract_tvs
		where
			contract_id = @contract_id
	end
end

if @delta = NULL
begin
	select
		@delta = delta
	from
		contract_tvs
	where
		contract_id = @contract_id
	and
		tv_date = (select
				max(tv_date)
			from
				contract_tvs
			where
				contract_id = @contract_id
			and
				tv_date <= @as_of_date)
end
			

if @delta = NULL
begin
	select
		@delta = delta
	from
		current_contract_tvs
	where
		contract_id = @contract_id
end

go
