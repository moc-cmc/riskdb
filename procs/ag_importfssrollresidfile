create or replace procedure
	ag_importfssrollresidfile
		@login varchar(50),
		@tnum varchar(50)=NULL,
		@snum varchar(50)=NULL,
		@prod_type varchar(50)=NULL,
		@cparty varchar(50)=NULL,
		@bs char(1)=NULL,
		@cur varchar(3)=NULL,
		@cou_cur varchar(3)=NULL,
		@amount varchar(50)=NULL,
		@price varchar(50)=NULL,
		@tdate varchar(50)=NULL,
		@mat_date varchar(50)=NULL,
		@bank varchar(50)=NULL,
		@trader varchar(50)=NULL

as

declare @tally_amount numeric(30, 4)
declare @tally_price float
declare @quantity numeric(30, 4)
declare @trade_date datetime
declare @value_date datetime
declare @mature_date datetime
declare @fixing_date datetime
declare @last_spot_rate float
declare @ccy1 varchar(50)
declare @ccy2 varchar(50)
declare @side varchar(10)

declare @platform_identifier varchar(100)
declare @default_login varchar(50)
declare @source varchar(50)
declare @broker varchar(50)
declare @source_id int
declare @broker_id int
declare @trade_identifier varchar(100)
declare @trade_id int
declare @trade_type varchar(50)
declare @tally_type varchar(50)
declare @tally_status varchar(10)
declare @tally_message varchar(25)
declare @external_account varchar(50)
declare @counterparty varchar(50)
declare @cpty_external_account_id int
declare @external_account_type varchar(50)
declare @suppress_trade varchar(50)
declare @ack_required varchar(50)
declare @trade_report_id varchar(50)
declare @aggregation_style varchar(50)
declare @suppression_lookup varchar(50)
declare @contract_id int
declare @trader_id int
declare @trader_login varchar(50)
declare @trader_lookup varchar(50)
declare @trader_mapping_error_id int
declare @trader_external_account_id int
declare @counterparty_id int
declare @counterparty_lookup varchar(50)
declare @cpty_mapping_error_id int
declare @external_account_id int
declare @deal_id int
declare @deal_exec_symbol varchar(100)
declare @deal_type varchar(50)
declare @deal_status varchar(50)
declare @contract varchar(20)
declare @inverted varchar(50)
declare @symbol varchar(50)
declare @swap_symbol varchar(50)
declare @swap_symbol_id int
declare @swap_near_id int
declare @swap_far_id int
declare @is_int_roll char(1)
declare @tallied_swap_leg_id int
declare @tallied_leg_val_date datetime 
declare @client_or_market char(1)
declare @is_spot_trade char(1)
declare @strategy varchar(50)
declare @status varchar(50)

declare @fund_agency_lookup varchar(10)
declare @is_fund_agency varchar(10)
declare @waitfor_delay varchar(20)


/* --------------------------------------------------------------------------
 * STEP: Set broker_id and source_id
 * There should always be a broker and source specified. These are
 * static, so don't even error check since the trade will fail.
 */

select
        @source = "Spectrum In",
        @broker = "Spectrum"

select
	@broker_id = broker_id
from
	brokers
where
	symbol = @broker

select
	@source_id = source_id
from
	sources
where
	name = @source

select
        @swap_near_id = trade_type_id
from
        trade_types
where
        name = "Swap Near"

select
        @swap_far_id = trade_type_id
from
        trade_types
where
        name = "Swap Far"

/* --------------------------------------------------------------------------

 * STEP: Initial MAP proc parameters to common tally params
 * It may be that additional parameters are mapped further down in the
 * stored procedure based on the result of @client_or_market
 */

/*
select
        @fund_agency_lookup = @trader
*/

/* --------------------------------------------------------------------------
 * STEP: Eval client or market
 * Determine if the trade is a client trade or if the trade is a market trade
 * some platforms provide an explicit tag. evaluate that tag here and set
 * @client_or_market to either "C" or "M". Raise an error message if you can't
 * determine. If no tag (or combination of tags) are provided, then set the
 * the @client_or_market_lookup and check to see if it maps to a fund agency
 * counterparty by calling tt_isfundagency.
 * This logic usually differs platform by platform
 *
 */

/*
exec
        tt_isfundagency
                @source_id=@source_id,
                @mapping=@fund_agency_lookup,
                @is_fund_agency=@is_fund_agency output
select
        @client_or_market = "M"

if @is_fund_agency = "Y"
        select
                @client_or_market = "C"
*/

/* --------------------------------------------------------------------------
 * STEP: Convert parameters to appropriate datatypes
 */

select
	@tally_amount = abs(convert(numeric(30, 4), @amount)),
	@tally_price = convert(float, @price),
	@trade_date = convert(datetime, @tdate),
	@mature_date = convert(datetime, @mat_date)

/* --------------------------------------------------------------------------
 * STEP: Map proc parameters to common tally variable name
 * This mapping allows us to use common variable names in all tallies. It also
 * helps with debugging, as you can look here to see what is mapped
 */

/* completely custom lookup to figure out client or market. file also includes blank counterparties **
   that we will set as INT-MF **
*/

if @cparty = NULL
begin
        select
                @cparty = "INT-MF"
end

select
        @client_or_market = "M"
from
        counterparty_symbols
where
        source_id = @source_id
and
        symbol = @cparty

select
        @client_or_market = "C"
from
        trader_symbols
where
        source_id = @source_id
and
        symbol = @cparty

if @client_or_market = NULL
begin
        select
                error = -1,
                msg = "cparty not mapped",
                cparty = @cparty
        return
end

if @cparty = "INT ROLL"
begin
	select
		@strategy = rtrim(@trader)	
end

select
	@platform_identifier = rtrim(@tnum)+"-"+rtrim(@snum),
        @deal_exec_symbol = rtrim(@tnum)

if @client_or_market = "C"
begin
	if @prod_type = "SPOT"
        begin
                select
                        @status = "User Review"
        end
        else
        begin
                select
                        @status = "Pending Affirmation"
        end

        select
                @trader_lookup = rtrim(@cparty),
                @counterparty_lookup = rtrim(@source)
end
	

else /* @client_or_market = "M" */
begin
	select
        	@trader_lookup = rtrim(@source),
        	@counterparty_lookup = rtrim(@cparty),
		@strategy = rtrim(@trader)

	select
        	@status = "User Review"
end


select
        @swap_symbol = rtrim(@tnum)+rtrim(@trader)+"."+@client_or_market

select
        @quantity = @tally_amount,
        @value_date = @mature_date,
        @ccy1 = @cur,
        @ccy2 = @cou_cur,
        @default_login=@login,
        @side=@bs

/* --------------------------------------------------------------------------
 * STEP: Dupe check on the identifier
 */

exec
	tt_isdupe
		@broker_id=@broker_id,
		@identifier=@platform_identifier,
		@trade_id=@trade_id output

if @trade_id != NULL
begin
	/* tt_isdupe would throw error message, just return */
	return
end

/* --------------------------------------------------------------------------
 * STEP: Lookup trader and counterparty symbols
 *
 * ag_pendingmappingerrors determines if there is currently a mapping error for a
 * trade. If there is, then @mapping_error_id wont be NULL. The tt_resolve* procs
 * will onlu send a message about the failed mapping if there is not an existing
 * mapping error. 
 */

exec
        ag_pendingmappingerrors
                @login = @default_login,
                @broker_id = @broker_id,
                @identifier = @platform_identifier,
                @trader_mapping_error_id = @trader_mapping_error_id output,
                @cpty_mapping_error_id = @cpty_mapping_error_id output

exec
        tt_resolvetradermapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@platform_identifier,
                @mapping_error_id=@trader_mapping_error_id,
                @mapping=@trader_lookup,
                @trader_id=@trader_id output,
                @trader=@trader output,
                @trader_login=@trader_login output,
                @external_account_id=@trader_external_account_id output

exec
        tt_resolvecptymapping
                @login=@default_login,
                @source_id=@source_id,
                @source=@source,
                @broker_id=@broker_id,
                @identifier=@platform_identifier,
                @mapping_error_id=@cpty_mapping_error_id,
                @mapping = @counterparty_lookup,
                @counterparty_id=@counterparty_id output,
                @counterparty=@counterparty output,
                @cpty_external_account_id=@cpty_external_account_id output

if @trader_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "trader mapping error trade not processed"
        return
end

if @counterparty_id = NULL
begin
        select
                status = "Error",
                error = "Error",
                message = "counterparty mapping error trade not processed"
        return
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from the trader or counterparty,
 *
 * On a client trade, the external account is determined by the trader
 * On a market trade, the external account is determined by the counterparty
 */

if @client_or_market = "C"
begin
    select
        @external_account_id = @trader_external_account_id
end
else /* @client_or_market = "M" */
begin
    select
        @external_account_id = @cpty_external_account_id
end

/* --------------------------------------------------------------------------
 * STEP: Lookup external account from mapped symbol 
 * 
 * If a symbol exists, then overwrite whatever was determined by the counterparty or trader.
 * Since a mapping is not required, send @mapping_error_id = 0 so that we do not send a message
 */

select
        @external_account = a.symbol,
        @external_account_type = b.name,
        @aggregation_style = c.name
from
        external_accounts a,
        external_account_types b,
        aggregation_styles c
where
        a.external_account_type_id = b.external_account_type_id
and
        a.aggregation_style_id = c.aggregation_style_id
and
        a.external_account_id = @external_account_id


/* --------------------------------------------------------------------------
 * STEP: Check for suppression 
 *
 */

select
        @suppress_trade = "Y"
from
        suppression_symbols
where
        source_id = @source_id
and
        symbol = @suppression_lookup

if @suppress_trade = "Y"
begin
        select
                status = "Suppressing trade",
                platform_identifier = @platform_identifier,
                source = @source,
                suppression_lookup = @suppression_lookup

        if @ack_required = "Y"
        begin
                select
                        trade_report_id=@trade_report_id,
                        symbol="NA"
        end

        /* We may store this data later on, but for now we will return out of tally */
        return
end

/* --------------------------------------------------------------------------
 * STEP: Manage trade types and deal_types
 *
 */

if @client_or_market = "C"
begin
	select
		@deal_type = "Client Swap"
end
else
begin
	select
                @deal_type = "Market Swap"
end

select 
	@tally_type = "Swap"

if @prod_type = "SPOT" and @cparty = "INT ROLL"
begin
        select
                @trade_type = "Swap Near",
                @tally_type = "Swap",
                @is_int_roll = "Y"
end

if @prod_type = "SWAPNEAR"
begin
	select
		@trade_type = "Swap Near"
end

if @prod_type = "SWAPFAR"
begin
	select
		@trade_type = "Swap Far"
end

if @prod_type = "SPOT" and @cparty != "INT ROLL"
begin
        select
                @deal_type = "Market Forward",
                @tally_type = "Spot",
                @trade_type = "Spot",
                @is_spot_trade = "Y"

end

if @prod_type = "FORWARD" and @client_or_market = "C"
begin
        select
                @deal_type = "Client Forward",
                @tally_type = "Forward",
                @trade_type = "Forward"
end

if @prod_type = "FORWARD" and @client_or_market = "M"
begin
        select
                @deal_type = "Market Forward",
                @tally_type = "Forward",
                @trade_type = "Forward"
end


/* --------------------------------------------------------------------------
 * STEP: Create the deal or get the deal_id for grouping
 * 
 * Default all trades right now to assume a 'B2B *' deal type
 */

exec
    tt_resolvedeal
        @deal_exec_symbol = @deal_exec_symbol,
        @deal_id = @deal_id output,
        @deal_type = @deal_type output,
        @deal_status = @deal_status output

if @deal_id = NULL
begin
    exec
        tt_newdeal
            @deal_type = @deal_type,
            @deal_status = @deal_status,
            @deal_exec_symbol = @deal_exec_symbol,
            @deal_id = @deal_id output
end

/* --------------------------------------------------------------------------
 * STEP: Determine Swap Symbol and what leg of swap to tally
 *
 */

if @is_spot_trade != "Y"
begin
        /* Check to see if this is the first leg being tallied */
        select
                @tallied_swap_leg_id = b.trade_id,
                @swap_symbol_id = a.swap_symbol_id
        from
                swap_symbols a,
                swap_symbol_trades b
        where
                a.swap_symbol_id = b.swap_symbol_id
        and     
                a.symbol = @swap_symbol

        if @@rowcount >= 2
        begin
                select
                        status="Error",
                        message="Two or more swap trade ids found when determining swap leg",
                        tallied_swap_leg_id=@tallied_swap_leg_id
                return
        end

        if @is_int_roll = "Y"
        begin
        	/* if tallied_swap_leg_id != NULL we know this is the 2nd Leg */
        	if @swap_symbol_id != NULL
        	begin   
                	select  
                        	@tallied_leg_val_date = value_date
                	from    
                        	trades
                	where   
                        	trade_id = @tallied_swap_leg_id

                	if @tallied_leg_val_date < @value_date
                	begin
                        	select 
                                	@trade_type = "Swap Far"
                	end

                	else /* previously tallied leg has a value date greater than value date passed in */
                        begin
                
                		select
                			status="Updating previously tallied leg to be far leg"            

                		begin
                		begin tran
                        		update
                                		trades
                        		set 
                                		trade_type_id = @swap_far_id
                        		where 
                                		trade_id = @tallied_swap_leg_id
                		commit tran
                		end

                		select
					swap_far_id=@swap_far_id,
                        		tallied_swap_leg_id=@tallied_swap_leg_id,
                        		trade_type_id=(select trade_type_id from trades where trade_id = @tallied_swap_leg_id)
                        end

        	end
	end
end

/* --------------------------------------------------------------------------
 * STEP: Determine the contract
 *
 */

exec
    r_validateccypair
        @login=@default_login,
        @symbol=@symbol,
        @ccy1=@ccy1,
        @ccy2=@ccy2,
        @contract_id = @contract_id output,
        @contract = @contract output,
        @inverted = @inverted output

/* --------------------------------------------------------------------------
 * STEP: Adjust the perspective of the trade and set the quantity
 *
 */

if @client_or_market = "C"
begin
    if @side = "B"
        select
            @quantity = @quantity 
    if @side = "S"
        select
            @quantity = @quantity * -1
end
else /* if @client_or_market = "M" */
begin
    if @side = "S"
        select
            @quantity = @quantity * -1
    if @side = "B"
        select
            @quantity = @quantity

end


/* --------------------------------------------------------------------------
 * STEP: Tally the trade
 *
 * chriso: this tally is part of a process where we get all the trades at once
 * Adding a small waitfor delay because of MC blotter issues. This does not
 * address the root cause of the mc issue, but can help with message timing
 * and trades hitting the blotter[
 */

select
	@waitfor_delay = "00:00:00.100"

waitfor delay @waitfor_delay

exec
    fxa_tallytrade
        @login = @trader_login,
        @source = @source,
        @trade_id = @trade_id out,
        @deal_id = @deal_id out,
        @tally_type = @tally_type,
        @deal_type = @deal_type,
        @trade_type = @trade_type,
        @external_account = @external_account,
        @counterparty = @counterparty,
        @quantity = @quantity,
        @symbol = @contract,
        @value_date = @value_date,
        @fixing_date = @fixing_date,
        @price = @tally_price,
        @trade_date = @trade_date,
        @trader = @trader,
        @broker = @broker,
	@strategy = @strategy,
        @identifier = @platform_identifier,
        @spot_reference = @last_spot_rate,
	@status = @status

if @trade_id = NULL
begin
    select
        @tally_status = "Error",
        @tally_message = "Problem tallying trade"
end
else
begin
    select
        @tally_status = "Success",
        @tally_message = "Tallied trade"
end

select 
    trade_status = @tally_status,
    message = @tally_message,
    trade_id = @trade_id,
    login = @trader_login,
    source = @source,
    deal_id = @deal_id,
    tally_type = @tally_type,
    deal_type = @deal_type,
    trade_type = @trade_type,
    external_account = @external_account,
    counterparty = @counterparty,
    quantity = @quantity,
    symbol = @contract,
    value_date = @value_date,
    fixing_date = @fixing_date,
    price = @tally_price,
    trade_date = @trade_date,
    trader = @trader,
    broker = @broker,
    strategy = @strategy,
    identifier = @platform_identifier,
    spot_reference = @last_spot_rate,
    swap_symbol = @swap_symbol,
    status = @status

if @tally_status = "Error"
begin
    return
end

/* --------------------------------------------------------------------------
 * STEP: update swap symbols and swap_symbol_trades
 *
*/

if @is_spot_trade != "Y"
begin
	/* Create and assign market swap symbol */
	if  @swap_symbol_id = NULL
	begin  
		exec
			j_nextkey
				"swap_symbols",
				@swap_symbol_id output

		begin tran
			insert into
				swap_symbols
			(
				swap_symbol_id,
				symbol,
				timestamp
			)
			values
			(
				@swap_symbol_id,
				@swap_symbol,
				getdate()
			)
			if @@rowcount !=1
                        begin
                                select
                                        stauts = "Error",
                                        msg = "Problem handling swap symbol insert"
                                rollback tran
				return
                        end

			insert into 
				swap_symbol_trades
			(
				swap_symbol_id,
				trade_id
			)	
			values
			(
				@swap_symbol_id,
				@trade_id
			)
			if @@rowcount != 1
                        begin
                                select
                                        status = "Error",
                                        msg = "Problem handling swap symbol trades insert"
                                rollback tran
				return
					
                        end
                commit tran
	end
	else
	begin
        	insert into
                	swap_symbol_trades
        	(
                	swap_symbol_id,
                	trade_id
        	)
        	values
        	(
                	@swap_symbol_id,
                	@trade_id
        	)
        	if @@rowcount != 1
        	begin
                	select
                        	status = "Error",
                        	msg = "Problem handling swap symbol trades insert"
        	end
	end
end

/* --------------------------------------------------------------------------
 * STEP: Send trade notifications
 *
 */

exec
        r_inserttradenotification
                @trade_id = @trade_id
go
