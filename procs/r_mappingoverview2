        source_type varchar(50) NULL,
        mapping varchar(50) NULL,
       	edit_contract_mapping varchar(10) NULL,
	delete_contract_mapping varchar(10) NULL,
	add_inbound_contract_symbol varchar(10) NULL,
	add_outbound_contract_symbol varchar(10) NULL,
	style varchar(200) NULL
