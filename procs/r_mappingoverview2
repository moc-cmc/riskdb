declare broker_cursor cursor for
	select
		broker_id
	from
		brokers
	order by
		broker_id

open broker_cursor
fetch broker_cursor into @broker_id

while @@sqlstatus = 0
begin

	insert
		#brokers (
			broker_id,
			name,
			source_name,
			source_type,
			mapping,
			style )

	select
		a.broker_id,
		a.symbol,
		c.name,
		c.source_type,
		b.symbol,
		@style
	from
		brokers a,
		broker_symbols b,
		#sources c
	where
		a.broker_id=@broker_id
	and
		a.broker_id=b.broker_id
	and
		b.source_id=c.source_id

	if (@@rowcount = 0)
	begin
		insert into
			#brokers (
				broker_id,
				name,
				style )
		select
			broker_id,
			symbol,
			@grey_style
		from
			brokers
		where
			broker_id=@broker_id

	end

	fetch broker_cursor into @broker_id

end

close broker_cursor
deallocate broker_cursor
	
