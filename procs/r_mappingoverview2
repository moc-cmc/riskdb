create table
	#sources
(
	source_id int,
	name varchar(50),
	source_type_id int,
	source_type varchar(50)
)

select
	@source_id = source_id
from
	sources
where
	name = @source

if @source_id = NULL
begin
	insert into
		#sources
	select
		a.source_id,
		a.name,
		a.source_type_id,
		b.name
	from
		sources a,
		source_types b
	where
		a.source_type_id = b.source_type_id
end
else
begin
	insert into
		#sources
	select
		a.source_id,
		a.name,
		a.source_type_id,
		b.name
	from
		sources a,
		source_types b
	where
		a.source_type_id = b.source_type_id
	and
		a.source_id = @source_id
end
	

create table
	#brokers
(
	broker_id int,
	name varchar(50) NULL, /* going to select symbol here. but using name since it makes later queries easier */
 	source_id int NULL,
	source_name varchar(50) NULL,
	source_type varchar(50) NULL,
	mapping varchar(50) NULL,
	edit_broker_mapping varchar(10) NULL,
	delete_broker_mapping varchar(10) NULL,
	add_inbound_broker_symbol varchar(10) NULL,
	add_outbound_broker_symbol varchar(10) NULL,
	style varchar(200) NULL
)

