
if object_id("cm_mappingoverview") != NULL
    drop procedure
        cm_mappingoverview
go

create procedure
    cm_mappingoverview
        @login varchar(50),
        @broker varchar(50),
        @source varchar(50)
as

declare @in_source_id int
declare @out_source_id int

create table
	#meta (
		meta_type char(50),
		name char(50) NULL,
		action char(100) NULL,
		value char(200) NULL
    )

/*
 * CALC all sources and brokers.source_id 
 */
create table
    #sources (
        source_id int,
        source varchar(50),
        broker_id int NULL,
        broker varchar(50) NULL
    )

insert into
    #sources (
        source_id,
        source
    )
select
    source_id,
    name
from
    sources
order by
    name

update
    #sources
set
    broker_id = b.broker_id,
    broker = b.symbol
from
    #sources a,
    brokers b
where
    a.source_id = b.source_id

insert into #meta values("Column Link", "trader", "Edit Trader", NULL)
--Adaptive Server has expanded all '*' elements in the following statement

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta
delete #meta
 
/*
 * SHOW traders: with mappings
 */
select
    id = a.trader_id,
    trader = a.symbol,
    symbol = case when ba.name != null then rtrim(ba.name) + " -> " + b.symbol else "<span style=""color:#999;font-style:italic"">None</span>" end,
    external_account = "(" + case ca.name when "Counterparty" then "M" else convert(varchar(1), ca.name) end + ") " + c.symbol,
/* FEATURE external_accounts.aggregation_style_id */
    aggregation_style = cb.name, /**/
    'user' = d.login,
    sales_code = e.name
from
    traders a
left outer join
    trader_symbols b
        on a.trader_id = b.trader_id
    left outer join
        sources ba
            on b.source_id = ba.source_id
join
    external_accounts c
        on a.external_account_id = c.external_account_id
    join
        external_account_types ca
            on c.external_account_type_id = ca.external_account_type_id
/* FEATURE external_accounts.aggregation_style_id */
    join
        aggregation_styles cb
            on c.aggregation_style_id = cb.aggregation_style_id /**/
join
    tico_accounts d
        on a.tico_account_id = d.account_id
join
    sales_codes e
        on a.sales_code_id = e.sales_code_id
order by
    ca.name,
    external_account,
    trader,
    d.login

insert into #meta values("Column Link", "counterparty", "Edit Counterparty", NULL)
insert into #meta values("Column Link", "symbol", "Counterparty Mappings", NULL)
--Adaptive Server has expanded all '*' elements in the following statement

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta
delete #meta
 
/*
 * SHOW counterparties: with mappings
 */
select
    id = a.counterparty_id,
    counterparty = a.name,
    symbol = case when ba.name != null then rtrim(ba.name) + " -> " + b.symbol else "<span style=""color:#69c;font-style:italic"">None</span>" end,
    external_account = "(" + case ca.name when "Counterparty" then "M" else convert(varchar(1), ca.name) end + ") " + c.symbol,
/* FEATURE external_accounts.aggregation_style_id */
    aggregation_style = cb.name /**/
from
    counterparties a
left outer join
    counterparty_symbols b
        on a.counterparty_id = b.counterparty_id
    left outer join
        sources ba
            on b.source_id = ba.source_id
join external_accounts c
    on a.external_account_id = c.external_account_id
    join
        external_account_types ca
            on c.external_account_type_id = ca.external_account_type_id
/* FEATURE external_accounts.aggregation_style_id */
    join
        aggregation_styles cb
            on c.aggregation_style_id = cb.aggregation_style_id /**/
order by
    a.name,
    ca.name,
    c.symbol
    
insert into #meta values("Column Link", "external_account", "Account Mappings", NULL)
insert into #meta values("Column Link", "symbol", "Account Mappings", NULL)
--Adaptive Server has expanded all '*' elements in the following statement

select #meta.meta_type, #meta.name, #meta.action, #meta.value from #meta
delete #meta
 
/*
 * SHOW external_accounts: with mappings
 */
select
    id = a.external_account_id,
    external_account = "(" + case aa.name when "Counterparty" then "M" else convert(varchar(1), aa.name) end + ") " + a.symbol,
    name = a.name,
/* FEATURE external_accounts.aggregation_style_id */
    aggregation_style = ab.name, /**/
    symbol = case when ba.name != null then rtrim(ba.name) + " -> " + b.symbol else "<span style=""color:#69c;font-style:italic"">None</span>" end
from
    external_accounts a
    join
        external_account_types aa
            on a.external_account_type_id = aa.external_account_type_id
/* FEATURE external_accounts.aggregation_style_id */
    join
        aggregation_styles ab
            on a.aggregation_style_id = ab.aggregation_style_id /**/
left outer join
    external_account_symbols b
        on a.external_account_id = b.external_account_id
    left outer join
        sources ba
            on b.source_id = ba.source_id
order by
    aa.name

/*
 * SHOW trade_notifiers: with mappings
 */

select
    id = case when b.trade_notifier_id != NULL then convert(varchar(10), b.trade_notifier_id) else "" end,
    notifier_source = case when ba.name != NULL then ba.name else "* Not mapped *" end,
    broker = case when bb.symbol != null then bb.symbol else "*" end,
    external_account = case when a.symbol != null then a.symbol else "*" end,
/* FEATURE trade_notifiers.status_id */
    status = case when bc.name != null then bc.name else "*" end, /**/
    notification_status = case when bd.name != NULL then bd.name else "" end
from
    external_accounts a
left outer join
    trade_notifiers b
        on a.external_account_id = b.external_account_id
    left outer join
        sources ba
            on b.source_id = ba.source_id
    left outer join
        brokers bb
            on b.broker_id = bb.broker_id
/* FEATURE trade_notifiers.status_id */
    left outer join
        statuses bc
            on b.status_id = bc.status_id /**/
    left outer join
        statuses bd
            on b.notification_status_id = bd.status_id
order by
    ba.name,
    bb.symbol,
    a.symbol
    

/*
/*
 * Display a list of brokers
 */

if @broker = NULL
    select
        @broker = "All"

if @source = NULL
    select
        @source = "All"

insert into #meta values("Column Link", "broker", "Mapping Overview", "source=" + @source)
select * from #meta
delete #meta

create table
    #select_brokers (
        broker varchar(50)
    )

insert into
    #select_brokers
values (
    "All"
)

insert into
    #select_brokers
select
    broker = symbol
from
    brokers
order by
    symbol
    
select
    broker
from
    #select_brokers

insert into #meta values("Column Link", "source", "Mapping Overview", "broker=" + @broker)
select * from #meta
delete #meta

create table
    #select_sources (
        source varchar(50)
    )

insert into
    #select_sources
values (
    "All"
)

insert into
    #select_sources
select
    source = name
from
    sources
order by
    name
    
select
    source
from
    #select_sources


/*
 * CALC #in_map
 */
create table
    #in_map (
        id int identity,
        section varchar(25),
        name_id int,
        name varchar(50),
        source_id int,
        symbol varchar(25) NULL
    )
    
insert into
    #in_map
select
    section = "Traders",
    a.trader_id,
    name = a.symbol,
    ba.source,
    symbol = case when b.symbol != NULL then b.symbol else a.symbol end
from
    traders a,
    trader_symbols b,
    #sources ba
where
    a.trader_id *= b.trader_id
and
    b.source_id *= ba.source_id
and
    ba.broker_id != NULL
and (
        @broker = "All"
    or 
        ba.broker = @broker
    )
order by
    a.symbol

insert into
    #in_map
select
    section = "Counterparties",
    a.counterparty_id,
    name = a.name,
    ba.source,
    symbol = case when b.symbol != NULL then b.symbol else a.name end
from
    counterparties a,
    counterparty_symbols b,
    #sources ba
where
    a.counterparty_id *= b.counterparty_id
and
    b.source_id *= ba.source_id
and
    ba.broker_id != NULL
and (
        @broker = "All"
    or 
        ba.broker = @broker
    )
order by
    a.name

insert into
    #in_map
select
    section = "Accounts",
    a.external_account_id,
    name = a.symbol,
    ba.source,
    symbol = case when b.symbol != NULL then b.symbol else a.symbol end
from
    external_accounts a,
    external_account_symbols b,
    #sources ba
where
    a.external_account_id *= b.external_account_id
and
    b.source_id *= ba.source_id
and
    ba.broker_id != NULL
and (
        @broker = "All"
    or 
        ba.broker = @broker
    )
order by
    a.symbol

/*
 * CALC #out_map
 */
create table
    #out_map (
        id int identity,
        section varchar(25),
        name_id int,
        name varchar(50),
        source_id int,
        symbol varchar(25) NULL
    )
    
insert into
    #out_map
select
    section = "Traders",
    a.trader_id,
    name = a.symbol,
    ba.source,
    symbol = case when b.symbol != NULL then b.symbol else a.symbol end
from
    traders a,
    trader_symbols b,
    #sources ba
where
    a.trader_id *= b.trader_id
and
    b.source_id *= ba.source_id
and
    ba.broker_id = NULL
and (
        @source = "All"
    or 
        ba.source = @source
    )
order by
    a.symbol

insert into
    #out_map
select
    section = "Counterparties",
    a.counterparty_id,
    name = a.name,
    ba.source,
    symbol = case when b.symbol != NULL then b.symbol else a.name end
from
    counterparties a,
    counterparty_symbols b,
    #sources ba
where
    a.counterparty_id *= b.counterparty_id
and
    b.source_id *= ba.source_id
and
    ba.broker_id = NULL
and (
        @source = "All"
    or 
        ba.source = @source
    )
order by
    a.name

insert into
    #out_map
select
    section = "Accounts",
    a.external_account_id,
    name = a.symbol,
    ba.source,
    symbol = case when b.symbol != NULL then b.symbol else a.symbol end
from
    external_accounts a,
    external_account_symbols b,
    #sources ba
where
    a.external_account_id *= b.external_account_id
and
    b.source_id *= ba.source_id
and
    ba.broker_id = NULL
and (
        @source = "All"
    or 
        ba.source = @source
    )
order by
    a.symbol

insert #meta values("Column Group", "section", NULL, NULL)
insert #meta values("Column Hidden", "nameID", NULL, NULL)

select * from #meta
delete from #meta

select
    *
from
    #in_map

select
    *
from
    #out_map

create table
    #map (
        id int identity,
        section varchar(25),
        name_id int,
        name varchar(50),
        in_source varchar(25) NULL,
        in_symbol varchar(25) NULL,
        out_source varchar(25) NULL,
        out_symbol varchar(25) NULL
    )

insert into
    #map (
        section,
        name_id,
        name,
        in_source,
        in_symbol
    )
select
    section,
    name_id,
    name,
    source,
    symbol
from
    #in_map



