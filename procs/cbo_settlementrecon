create table
        #prime_brokers(
                prime_broker_id int,
                name varchar(50) NULL)

if @prime_broker != NULL
begin
	select
		@prime_broker_id = a.prime_broker_id,
		@bo_external_account_id = a.bo_external_account_id
	from
		prime_brokers a,
		sources b
	where
		a.source_id = b.source_id
	and
		b.name = @prime_broker
	if @@rowcount = 0
	begin
		select
			status = "Error",
			message = "Prime broker not found",
			prime_broker = @prime_broker
		return
	end

	insert into
        	#prime_brokers
	select
        	b.prime_broker_id,
        	a.name
	from
        	sources a,
        	prime_brokers b
	where
        	a.source_id = b.source_id
	and
        	b.prime_broker_id = @prime_broker_id
end
else
begin
	insert into
        	#prime_brokers
	select
        	b.prime_broker_id,
        	a.name
	from
        	sources a,
        	prime_brokers b
	where
        	a.source_id = b.source_id
	and
		bo_external_account_id != NULL
end



