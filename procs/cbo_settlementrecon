create table
        #balances(
                external_account_id int NULL,
		prime_broker_id int NULL,
		prime_broker varchar(50) NULL,
		bo_ext_account_id int NULL,
		bo_ext_account varchar(50) NULL,
                product_id int,
		product varchar(50) NULL,
                balance float,
		resid_balance float NULL,
		total_balance float NULL,
                settled_fx float NULL,
                unsettled_fx float NULL,
                settle varchar(50) NULL,
		unsettle varchar(50) NULL,
		account_transaction_id int NULL,
		eval_ccy_id int NULL,
		style varchar(50) NULL)

insert into
        #balances(
		prime_broker_id,
                product_id,
                balance)
select
	prime_broker_id,
        product_id,
        balance
from
        #net_pb_balances
group by
	prime_broker_id,
	product_id


update
	#balances
set
	resid_balance = b.balance
from
	#balances a,
	#net_pb_balances_resids b
where
	a.product_id = b.product_id
and
	a.prime_broker_id = b.prime_broker_id

update
	#balances
set
	bo_ext_account_id = a.bo_external_account_id
from
	prime_brokers a,
	#balances c
where
	a.prime_broker_id = c.prime_broker_id

update
	#balances
set
	bo_ext_account = a.symbol
from
	external_accounts a,
	#balances b
where
	a.external_account_id = b.bo_ext_account_id

update
	#balances
set
	prime_broker = a.name
from
	sources a,
	prime_brokers b,
	#balances c
where
	a.source_id = b.source_id
and
	b.prime_broker_id = c.prime_broker_id

update
	#balances
set
	product = a.symbol
from
	products a,
	#balances b
where
	a.product_id = b.product_id
	

update
	#balances
set
	eval_ccy_id = @evaluation_currency_id

update
	#balances
set
	resid_balance = 0
where
	resid_balance = NULL

update
	#balances
set
	total_balance = resid_balance + balance

update
        #balances
set
        settled_fx = 0.0

update
        #balances
set
        a.settled_fx = b.amount,
	a.account_transaction_id = b.account_transaction_id
from
        #balances a,
        account_transactions b,
        transaction_types c
where
        a.product_id = b.currency_id
and
        a.bo_ext_account_id = b.external_account_id
and
        b.transaction_type_id = c.transaction_type_id
and
        c.name like "%Settlement"
and
        b.note = NULL
and
        convert(date, b.transaction_date) = convert(date, @value_date)

update
        #balances
set
        unsettled_fx = total_balance - settled_fx

update
        #balances
set
        a.settle = "SETTLE"
from
        #balances a,
        external_accounts b
where
        a.bo_ext_account_id = b.external_account_id
and
        a.product_id = b.evaluation_currency_id
and
        abs(a.unsettled_fx) >= 0.01

update
	#balances
set
	style = "background:#FFFFFF;border: 1px solid white"

update
	#balances
set
	style= "background:#FFFFCC"
where
	eval_ccy_id = product_id

update
	#balances
set
	unsettle = "UNSETTLE"
where
	account_transaction_id != NULL
	


select
        style = "background:#FFFFFF;border: 1px solid white",
	previous_date = "<< Previous Date",
        prime_broker = @prime_broker,
        closing_date = @value_date,
	next_date = "Next Date  >>"


select
        section = "Maturing Balances by PB for " + convert(varchar(15), @value_date, 107),
        /* style = "background:#FFFFFF;border: 1px solid white", */
        account = c.bo_ext_account,
        symbol = c.product,
        trades_balance =  convert(numeric(30,2), c.balance),
	resid_balance = convert(numeric(30,2), c.resid_balance), 
	net_balance = convert(numeric(30,2), c.total_balance),
	balance = convert(numeric(30,2), c.total_balance),
        settled_balance = convert(numeric(30,2), c.settled_fx),
        unsettled_balance = convert(numeric(30,2), c.unsettled_fx),
        c.settle,	
	c.unsettle,
	account_transaction = c.account_transaction_id,
        value_date = @value_date,
        currency = c.product,
	style
from
        #balances c
group by
	c.bo_ext_account,
	c.product
order by
	c.bo_ext_account,
        c.product


create table
	#trades(
		deal_id int,
		trade_id int,
		trade_date datetime,
		product_id int NULL,
		contract_id int,
		value_date datetime,
		quantity numeric(30,4),
		volume float NULL,
		trade_price float,
		trader_id int,
		broker_id int,
		external_account_id int,
		counterparty_id int,
		sales_code_id int,
		trade_type varchar(20)
)


insert into
	#trades
select
	a.deal_id,
	a.trade_id,
	a.trade_date,
	product_id = NULL,
	a.contract_id,
	a.value_date,
	a.quantity,
	volume = NULL,
	a.price,
	a.trader_id,
	a.broker_id,
	a.external_account_id,
	a.counterparty_id,
	a.sales_code_id,
	h.name
from
	trades a,
	trade_types h
where
	a.trade_type_id = h.trade_type_id
and	
        convert(date, a.value_date) = convert(date, @value_date)
and
	a.status_id = @resid_status_id


update
	#trades
set
	a.trade_price = 1.0 / a.trade_price
from
	#trades a,
	contract_price_styles b,
	price_styles c
where
	a.contract_id = b.contract_id
and
	b.price_style_id = c.price_style_id
and
	c.name = "Inverted"
	
update
	#trades
set
	a.product_id = b.product_id
from
	#trades a,
	forwards b
where
	a.contract_id = b.contract_id

