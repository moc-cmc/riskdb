create table
	#cpty_positions(
		id int identity,
		external_account_id int,
		status_id int,
		product_id int,
		currency_id int,
		contract_id int,
		dealt_amount float,
		counter_amount float)

insert into
	#cpty_positions(
		external_account_id,
		status_id,
		contract_id,
		product_id,
		currency_id,
		dealt_amount,
		counter_amount)
select
	a.external_account_id,
	a.status_id,
	a.contract_id,
	b.product_id,
	b.currency_id,
	a.quantity,
	a.quantity * a.price * -1.0
from
	trades a,
	forwards b,
	#trades1 c
where
	a.trade_id = c.trade_id
and
	a.contract_id = b.contract_id



create table
        #cpty_product_nets(
                external_account_id int,
                product_id int,
                status_id int,
                quantity numeric(30,4))

insert into
        #cpty_product_nets
select          
        external_account_id,
        product_id,
        status_id,
        sum(dealt_amount)
from    
        #cpty_positions
group by
        external_account_id,
        product_id,
        status_id

insert into
        #cpty_product_nets
select
        external_account_id,
        currency_id,
	status_id,
        sum(counter_amount)
from
        #cpty_positions
group by
        external_account_id,
        currency_id,
	status_id


