select
	section = "Residual Trades",
	style = "background:#FFFFFF;border: 1px solid white",
	a.deal_id,
	a.trade_id,
	a.trade_type,
	trade_date = convert(char(11), a.trade_date, 1),
	a.value_date,
	b.symbol,
	a.quantity,
	a.trade_price,
	trader = c.symbol,
	broker = d.symbol,
	external_account = e.symbol,
	counterparty = g.name,
	sales_code = f.name
from
	#trades a,
	contracts b,
	traders c,
	brokers d,
	external_accounts e,
	sales_codes f,
	counterparties g
where
	a.contract_id = b.contract_id
and
	a.trader_id = c.trader_id
and
	a.broker_id = d.broker_id
and
	a.external_account_id = e.external_account_id
and
	a.sales_code_id = f.sales_code_id
and
	a.counterparty_id = g.counterparty_id
order by
	a.deal_id,
	a.trade_id

