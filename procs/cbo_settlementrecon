	#net_pb_balances
select
	a.prime_broker_id,
	b.product_id,
	sum(b.balance)
from
	external_account_prime_brokers a,
	#net_cpty_balances b
where
	a.external_account_id = b.external_account_id
group by
	a.prime_broker_id,
	b.product_id

