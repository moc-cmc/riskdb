create procedure
	cbo_settlementrecon
		@login varchar(50),
		@value_date datetime=NULL,
		@prime_broker varchar(50)=NULL
as


declare @fund_id int
declare @fund varchar(100)
declare @roll_trader_id int
declare @prime_broker_id int
declare @transaction_type_id int
declare @bo_external_account_id int
declare @resid_status_id int
declare @evaluation_currency_id int
declare @begin_date datetime
declare @end_date datetime
declare @max_commit_date datetime
declare @previous_value_date datetime
declare @next_value_date datetime
declare @weekday int

if @value_date = NULL
begin
        select
                @value_date = getdate()
	select
		@weekday = datepart(weekday, @value_date)
        if @weekday = 7 /* saturday */
	begin
		exec 
			r_prevbusinessday
				@value_date,
				@value_date output
	end
	select
		@value_date =  convert(varchar(15), @value_date, 110)
end


exec
	r_prevbusinessday
		@value_date,
		@previous_value_date output

exec
	r_nextbusinessday
		@value_date,
		@next_value_date output

