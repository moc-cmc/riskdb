create table
        #net_cpty_balances(
		external_account_id int,
                product_id int NULL,
                balance float NULL)
insert into
        #net_cpty_balances(
		external_account_id,
                product_id,
                balance)
select
	c.external_account_id,
        c.product_id,
        sum(c.quantity)
from
        #cpty_product_nets c
where
	c.status_id != @resid_status_id
group by
	c.external_account_id,
        c.product_id,
	c.quantity


create table
        #net_cpty_balances_resids(
		external_account_id int,
                product_id int NULL,
                balance float NULL)

