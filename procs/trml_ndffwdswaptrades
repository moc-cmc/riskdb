drop procedure
	trml_ndffwdswaptrades
go

create procedure
	trml_ndffwdswaptrades
		@source varchar(50)
as

declare @source_id int
declare @client_account_type_id int
declare @cpty_account_type_id int


select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		id = -1,
		error = "Source not found",
		source = @source
	return
end

select 
	@cpty_account_type_id = external_account_type_id
from
	external_account_types
where
	name = "Counterparty"
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Problem finding external account type",
                type = "Counterparty"
        return
end

select 
        @client_account_type_id = external_account_type_id 
from
        external_account_types
where
        name = "Client"
if @@rowcount != 1
begin
        select
                id = -1,
                error = "Problem finding external account type",
                type = "Client"
        return
end


create table
	#trades(
	        trade_id int,
                external_account_id int,
                trader_id int,
                counterparty_id int,
                strategy_id int,
                contract_id int,
		trade_type_id int,
                external_account_type_id int NULL,
		product_group varchar(10),
		action varchar(10),
		message_type varchar(10),
		process varchar(10) NULL,
		trade_ref int,
		entity varchar(10),
		portfolio varchar(50) NULL,
		reporting_system varchar(5),
		reporter_ticket_number int,
		trader_name varchar(50) NULL,
		counterparty varchar(50) NULL,
                reporting_party varchar(50) NULL,
		prime_broker varchar(50) NULL,
		trade_date datetime,
		product_type varchar(10) NULL,
		traded_currency varchar(10) NULL,
		counter_currency varchar(10) NULL,
		traded_amount numeric(30,4),
		counter_amount numeric(30,4),
		dealt_rate float,
		value_date varchar(15),
		fixing_date varchar(15),
		trade_notification_id int,
                client_give_up varchar(25) NULL)

create nonclustered index
        tmp_tid
on
        #trades(trade_id)

create table
        #trade_notifications(
                trade_notification_id int,
                trade_id int,
                source_id int,
                status_id int
                )

create nonclustered index
        tn_tid
on
        #trade_notifications(trade_id)


declare @active_status_id int
declare @edit_status_id int
declare @cancelled_status_id int
declare @spot_trade_type_id int
declare @forward_trade_type_id int
declare @swap_near_trade_type_id int
declare @swap_far_trade_type_id int


select
        @active_status_id = status_id
from
        statuses
where
        name = "Active"
select
        @edit_status_id = status_id
from
        statuses
where
        name = "Edit"
select
        @cancelled_status_id = status_id
from
        statuses
where
        name = "Cancelled"

select
        @spot_trade_type_id = trade_type_id
from
        trade_types
where
        name = "Spot"

select
        @forward_trade_type_id = trade_type_id
from
        trade_types
where
        name = "Forward"

select  
        @swap_near_trade_type_id = trade_type_id
from    
        trade_types
where   
        name = "Swap Near"
select  
        @swap_far_trade_type_id = trade_type_id
from
        trade_types
where
        name = "Swap Far"



/*
| Insert into #trade_notifications anything with status_id "Active", "Edit", "Cancelled"
*/
insert into
        #trade_notifications
select
        trade_notification_id,
        trade_id,
        source_id,
        status_id
from
        trade_notifications
where
        status_id in(@active_status_id, @edit_status_id, @cancelled_status_id)




/*
| Insert into #trades setting the counterparty to the external_account 
*/
insert into
	#trades
select 
	trade_id = a.trade_id,
        external_account_id = a.external_account_id,
        trader_id = a.trader_id,
        counterparty_id = a.counterparty_id,
        strategy_id = a.strategy_id,
        contract_id = a.contract_id,
	trade_type_id = a.trade_type_id,
        external_account_type_id = NULL,
	product_group = "NDF",
	action = "REPORT",
	mesage_type = "REGULAR",
	process = NULL,
	trade_ref = a.trade_id,
	entity = "CLIENT",
	portfolio = NULL,
	reporting_system = "ETG",
	reporter_ticket_number = a.trade_id,
	trader_name = NULL,
	counterparty = NULL,
        reporting_party = NULL, 
	prime_broker = NULL,
	trade_date = case
		when a.trade_date > convert(char(8), getdate(), 112) +' 17:00' then
			dateadd(day, 1, convert(char(15), a.trade_date, 110))
		else
			convert(char(12), a.trade_date, 110)
	end,
	product_type = "NDF",
	traded_currency = NULL,
	counter_currency = NULL,
	traded_amount = a.quantity,
        counter_amount = a.quantity * a.price,
	dealt_rate = a.price,
	value_date = convert(varchar(15),a.value_date,110),
	fixing_date = convert(varchar(15),a.fixing_date,110),
	j.trade_notification_id,
	client_give_up = NULL
from
	trades a,
	#trade_notifications j
where
	a.trade_id=j.trade_id
and
	j.source_id = @source_id
and
	a.fixing_date != NULL
and
	a.trade_type_id in(	@spot_trade_type_id,
				@forward_trade_type_id,
                         	@swap_near_trade_type_id,
                         	@swap_far_trade_type_id)



delete from
	#trades
where
	dealt_rate = 0


/*
|  Adjust display prices to standard rate for all pairs
*/

update
    #trades
set
    dealt_rate = case 
        when d.name = "Inverted" and c.factor != NULL then
            (1 / a.dealt_rate) * c.factor * d.factor
        when d.name = "Inverted" then
            (1 / a.dealt_rate) * d.factor
        when c.factor != NULL then
            a.dealt_rate * c.factor * d.factor
        else
            a.dealt_rate * d.factor
    end
from
    #trades a,
    contracts b,
    contract_price_styles c,
    price_styles d
where
    a.contract_id = b.contract_id
and
    b.contract_id = c.contract_id
and
    c.price_style_id = d.price_style_id


/*
|  contracts, dealt ccy, counter ccy
*/
update
        #trades
set
        traded_currency = g.symbol,
        counter_currency = f.symbol
from
        #trades a,
        contracts b,
        forwards e,
        products f,
        products g
where
        a.contract_id = b.contract_id
and
        b.contract_id=e.contract_id
and
        e.currency_id=f.product_id
and
        e.product_id=g.product_id

/*
|  Set portfolio from strategy
*/
update
        #trades
set
        portfolio = c.name
from
        #trades a,
        strategies c
where
        a.strategy_id = c.strategy_id

/*
|  Set trader_name from traders
*/
update
        #trades
set
        trader_name = b.symbol
from
        #trades a,
        traders b
where
        a.trader_id = b.trader_id

/*
|  Set counterparty, ext account type from external_accounts
*/
update
        #trades
set
        counterparty = b.symbol,
        external_account_type_id = b.external_account_type_id
from
        #trades a,
        external_accounts b
where
        a.external_account_id = b.external_account_id



/*
|  Set NEW, MODIFY, DELETE, etc... for trades
*/
update
	#trades
set
	process=status_symbol
from
	#trades a,
	trade_notifications b,
	status_symbols c 
where
	a.trade_notification_id=b.trade_notification_id 
and
	b.status_id=c.status_id



/*
|  Update traiana counterparty to counterparties.name for Market Trades
|  Update traiana trader to "" for Market Trades
*/
update
	#trades
set
	trader_name = ""
from
	#trades b,
	external_accounts c,
	external_account_types d,
        counterparties e
where
    b.counterparty_id = e.counterparty_id
and
    b.external_account_id = c.external_account_id
and
    c.external_account_type_id = d.external_account_type_id
and
    d.name = "Counterparty"




update
        #trades
set
        reporting_party = c.symbol
from
        #trades b,
        external_account_symbols c
where
        b.external_account_id = c.external_account_id
and
        c.source_id = @source_id


/*
|  Update traiana counterparty to reporting_partys.symbol for Market Trades
|  for counterparties that have a reporting_partys.symbol for source
*/
update
        #trades
set
        counterparty = c.name
from
        #trades b,
        counterparties c
where
	b.counterparty_id = c.counterparty_id

update 
	#trades
set
	counterparty = c.symbol
from
	#trades b,
	counterparty_symbols c
where
	b.counterparty_id = c.counterparty_id
and
	c.source_id = @source_id


/*
|  Update traiana trader to trader_symbols.symbol for Client Trades
|  for traders that have a trader_symbols.symbol for source
*/
update
        #trades
set
        trader_name = e.symbol
from
        #trades b,
        external_accounts c,
        external_account_types d,
        trader_symbols e
where
    b.trader_id = e.trader_id
and
    b.external_account_id = c.external_account_id
and
    c.external_account_type_id = d.external_account_type_id
and
    e.source_id = @source_id
and
    d.name = "Client"


/*
|  Update traiana client_give_up to client_give_ups.symbol for Client Trades
|  for external_accounts
*/
update
        #trades
set
        client_give_up = e.symbol
from
        #trades b,
        external_accounts c,
        external_account_types d,
        client_give_ups e
where
    b.external_account_id = e.external_account_id
and
    b.external_account_id = c.external_account_id
and
    c.external_account_type_id = d.external_account_type_id
and
    e.source_id  = @source_id
and
    d.name in("Client", "Managed", "Master")




/*
|  Update traiana prime_broker to prime_broker_symbols.symbol for all trades
|  for external_accounts who have an entry in external_account_prime_brokers
*/

update
	#trades
set
	prime_broker = e.symbol
from
	#trades b,
        external_accounts c,
	external_account_prime_brokers d,
	prime_broker_symbols e
where
	b.external_account_id = c.external_account_id 
and
	c.external_account_id = d.external_account_id
and
	d.prime_broker_id = e.prime_broker_id
and
	e.source_id = @source_id
	


/* 
	Counterparty rollover time support shelved

/*-----------------------------------------------------------------------,
| Trade Date determination for Client & Market trades                    |
| Summary:                                                               |
| Some counterparties will have different rollover times. There is a     |
| table in the db, counterparty_rollover_times, which contains a time    |
| string that a counterpary rolls over at. If a countterparty has a      | 
| rollover time other than 17:00 EST, this table will be populated with  |
| the time string of the rollover time. If a counterparty does not have  | 
| an entry in the counterparty_rollover_times table, the rollover time   |
| will default to 17:00.                                                 |
|                                                                        |
'-----------------------------------------------------------------------*/

update
	#trades
set
	a.trade_date = 
		case
			when a.trade_date > convert(char(8), getdate(), 112) +' '+ rtrim(d.time) then
				dateadd(day, 1, convert(char(15), a.trade_date, 110))
			else
				convert(char(12), a.trade_date, 110)
		end
from
	#trades b,
	counterparties c,
	counterparty_rollover_times d
where
	b.counterparty_id = c.counterparty_id
and
	c.counterparty_id = d.counterparty_id
*/



select
	product_group,
	action,
	message_type,
	process,
	trade_ref,
	entity,
	portfolio,
	reporting_system,
	reporter_ticket_number,
	trader_name,
	counterparty,
        reporting_party,
	prime_broker,
	trade_date = convert(char(10), trade_date, 110),
	product_type,
	traded_currency,
	counter_currency,
	traded_amount=traded_amount,
	counter_amount=counter_amount,
	dealt_rate,
	value_date,
	fixing_date,
	trade_notification_id,
	client_give_up
from
	#trades
where
	counterparty != NULL
order by 
	trade_ref

go

