
if object_id("cm_edittradermapping") != NULL
    drop procedure
        cm_edittradermapping
go

create procedure
	cm_edittradermapping
		@login varchar(50),
		@trader varchar(50),
		@source varchar(50),
		@mapping varchar(50),
		@new_mapping varchar(50)
as


declare @trader_id int
declare @source_id int


select
	@trader_id = trader_id
from
	traders
where
	symbol = @trader
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Trader not found",
		trader = @trader
	return
end

select
	@source_id = source_id
from
	sources
where
	name = @source
if @@rowcount != 1
begin
	select
		status = "Error",
		message = "Source name not found",
		source_name = @source
	return
end

update
	trader_symbols
set
	symbol = @new_mapping
where
	trader_id = @trader_id
and
	source_id = @source_id
and
	symbol = @mapping

exec
	cm_tradermappings
		@login,
		@trader

go
